new file mode 100644
index 0000000..2f1d204
--- /dev/null
+++ b/crates/slot-ui/src/lynx_toast.rs
@@ -0,0 +1,28 @@
+use crate::Toast;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum LynxToast {
+    NeedsBios,
+    UnknownBios,
+}
+
+impl LynxToast {
+    pub const ALL: [LynxToast; 2] = [LynxToast::NeedsBios, LynxToast::UnknownBios];
+
+    pub fn index(self) -> usize {
+        Self::ALL.iter().position(|t| *t == self).unwrap_or(0)
+    }
+
+    pub fn text(self) -> &'static str {
+        match self {
+            LynxToast::NeedsBios => "Lynx needs BIOS/lynxboot.img",
+            LynxToast::UnknownBios => "lynxboot.img is not the known dump",
+        }
+    }
+}
+
+impl Toast {
+    pub fn lynx_index(l: LynxToast) -> usize {
+        Toast::disc_index(crate::DiscToast::ALL[0]) + crate::DiscToast::ALL.len() + l.index()
+    }
+}
