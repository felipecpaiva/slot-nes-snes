diff --git a/crates/slot/src/app/lynx_bios.rs b/crates/slot/src/app/lynx_bios.rs
new file mode 100644
index 0000000..0636820
--- /dev/null
+++ b/crates/slot/src/app/lynx_bios.rs
@@ -0,0 +1,35 @@
+use slot_store::lynx::{bios, Bios};
+use slot_store::Platform;
+use slot_ui::{LynxToast, Toast};
+
+use super::App;
+
+impl App {
+    pub(super) fn lynx_bios_allows(&mut self, platform: Platform) -> bool {
+        if platform != Platform::Lynx {
+            return true;
+        }
+        let Some(root) = self.root.as_deref() else {
+            return true;
+        };
+        match bios(&crate::root::bios_dir(root)) {
+            Bios::Known => true,
+            Bios::Unknown => {
+                if !self.lynx_bios_warned {
+                    self.lynx_bios_warned = true;
+                    eprintln!("slot: lynx: BIOS/lynxboot.img is not the known dump, launching");
+                    self.hud
+                        .toast(Toast::Lynx(LynxToast::UnknownBios), self.now());
+                }
+                true
+            }
+            Bios::Missing => {
+                eprintln!("slot: lynx: no usable BIOS/lynxboot.img, not launching");
+                self.hud
+                    .toast(Toast::Lynx(LynxToast::NeedsBios), self.now());
+                self.refuse();
+                false
+            }
+        }
+    }
+}
diff --git a/crates/slot/tests/lynx_bios.rs b/crates/slot/tests/lynx_bios.rs
new file mode 100644
index 0000000..89b1967
--- /dev/null
+++ b/crates/slot/tests/lynx_bios.rs
@@ -0,0 +1,171 @@
+mod common;
+mod lynx_common;
+
+use std::path::Path;
+
+use common::tmp_root_with_carts;
+use lynx_common::{lynx_bios, put_bios};
+use slot::app::{App, Phase};
+use slot_input::{Action, Btn};
+use slot_store::lynx::{bios, bios_of, crc32, Bios};
+use slot_store::{write_slot_state, Platform, SlotState};
+use slot_ui::{LynxToast, Toast};
+use tempfile::TempDir;
+
+fn card(bios: Option<&[u8]>) -> TempDir {
+    let d = tmp_root_with_carts(&[]);
+    let dir = d.path().join("Games/Lynx");
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut rom = vec![0u8; 64 + 128 * 1024];
+    rom[..4].copy_from_slice(b"LYNX");
+    rom[8] = 1;
+    std::fs::write(dir.join("Klax.lnx"), &rom).unwrap();
+    std::fs::write(dir.join("Lexis.lnx"), &rom).unwrap();
+    put_bios(d.path(), bios);
+    d
+}
+
+fn boot_on(root: &Path, cart: Option<&str>) -> App {
+    write_slot_state(
+        root,
+        &SlotState {
+            clock_set: true,
+            cart: cart.map(str::to_string),
+            cart_platform: cart.map(|_| Platform::Lynx),
+            ..SlotState::default()
+        },
+    )
+    .expect("write slot.state");
+    App::boot(root)
+}
+
+fn insert(a: &mut App) {
+    a.apply(Action::GbaDown(Btn::A));
+    a.apply(Action::GbaUp(Btn::A));
+    for _ in 0..10 {
+        a.update(1.0 / 60.0);
+    }
+}
+
+fn inserting(a: &App) -> bool {
+    matches!(a.phase(), Phase::Inserting { .. } | Phase::Playing { .. })
+}
+
+#[test]
+fn the_check_reads_missing_short_long_and_unknown_files() {
+    let d = tempfile::tempdir().unwrap();
+    assert_eq!(bios(d.path()), Bios::Missing);
+    for (bytes, want) in [
+        (vec![], Bios::Missing),
+        (vec![0u8; 256], Bios::Missing),
+        (vec![0u8; 513], Bios::Missing),
+        (vec![0u8; 512], Bios::Unknown),
+    ] {
+        std::fs::write(d.path().join("lynxboot.img"), &bytes).unwrap();
+        assert_eq!(bios(d.path()), want, "{} bytes", bytes.len());
+    }
+}
+
+#[test]
+fn the_check_hashes_with_the_standard_crc32() {
+    assert_eq!(crc32(b"123456789"), 0xcbf4_3926);
+    assert_eq!(crc32(b""), 0);
+}
+
+#[test]
+fn the_maintainers_own_bios_is_the_known_dump() {
+    let Some(b) = lynx_bios() else {
+        return;
+    };
+    assert_eq!(bios_of(&b), Bios::Known);
+}
+
+#[test]
+fn with_no_bios_a_lynx_cart_stays_on_the_shelf_with_a_toast() {
+    let d = card(None);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Lynx(LynxToast::NeedsBios)));
+    assert_eq!(
+        Toast::Lynx(LynxToast::NeedsBios).text(),
+        "Lynx needs BIOS/lynxboot.img"
+    );
+}
+
+#[test]
+fn a_zero_byte_placeholder_counts_as_no_bios() {
+    let d = card(Some(&[]));
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Lynx(LynxToast::NeedsBios)));
+}
+
+#[test]
+fn a_lynx_game_resumed_at_boot_is_checked_too() {
+    let d = card(Some(&[0u8; 256]));
+    let a = boot_on(d.path(), Some("Klax"));
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Lynx(LynxToast::NeedsBios)));
+}
+
+#[test]
+fn an_unknown_bios_launches_and_says_so_once_a_session() {
+    let d = card(Some(&[0u8; 512]));
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Lynx(LynxToast::UnknownBios)));
+    a.apply(Action::Eject);
+    for _ in 0..600 {
+        a.tick_ms(10_000);
+        a.update(1.0 / 60.0);
+    }
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), None, "the unknown-dump toast came back");
+    let written = std::fs::read_to_string(d.path().join("Config/slot.state")).unwrap_or_default();
+    let again = boot_on(d.path(), Some("Klax"));
+    let after = std::fs::read_to_string(d.path().join("Config/slot.state")).unwrap_or_default();
+    let carts: Vec<String> = again
+        .carts()
+        .map(|c| format!("{:?}/{}", c.platform, c.stem))
+        .collect();
+    let config: Vec<String> = std::fs::read_dir(d.path().join("Config"))
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_string_lossy().into_owned())
+        .collect();
+    assert!(
+        inserting(&again),
+        "{:?} DIAG before={:?} after={:?} carts={carts:?} config={config:?} toast={:?}",
+        again.phase(),
+        written.lines().take(3).collect::<Vec<_>>(),
+        after.lines().take(3).collect::<Vec<_>>(),
+        again.toast()
+    );
+    assert_eq!(again.toast(), Some(Toast::Lynx(LynxToast::UnknownBios)));
+}
+
+#[test]
+fn the_lynx_toasts_upload_in_their_own_place() {
+    let every = Toast::every();
+    for l in LynxToast::ALL {
+        let t = Toast::Lynx(l);
+        assert_eq!(every.get(t.index()), Some(&t), "{l:?}");
+    }
+}
+
+#[test]
+fn a_known_bios_launches_with_no_toast() {
+    let Some(b) = lynx_bios() else {
+        return;
+    };
+    let d = card(Some(&b));
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), None);
+}
