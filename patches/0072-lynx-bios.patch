diff --git a/crates/slot-store/src/lynx.rs b/crates/slot-store/src/lynx.rs
index e68b87f..3641883 100644
--- a/crates/slot-store/src/lynx.rs
+++ b/crates/slot-store/src/lynx.rs
@@ -71,3 +71,37 @@ fn warn_odd_size(rom: &Path) {
         );
     }
 }
+
+pub const BIOS_FILE: &str = "lynxboot.img";
+const BIOS_BYTES: usize = 512;
+const BIOS_CRC32: u32 = 0x0d97_3c9d;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum Bios {
+    Missing,
+    Unknown,
+    Known,
+}
+
+pub fn bios(bios_dir: &Path) -> Bios {
+    match std::fs::read(bios_dir.join(BIOS_FILE)) {
+        Ok(bytes) => bios_of(&bytes),
+        Err(_) => Bios::Missing,
+    }
+}
+
+pub fn bios_of(bytes: &[u8]) -> Bios {
+    match (bytes.len(), crc32(bytes)) {
+        (BIOS_BYTES, BIOS_CRC32) => Bios::Known,
+        (BIOS_BYTES, _) => Bios::Unknown,
+        _ => Bios::Missing,
+    }
+}
+
+pub fn crc32(data: &[u8]) -> u32 {
+    !data.iter().fold(!0u32, |crc, &b| {
+        (0..8).fold(crc ^ u32::from(b), |c, _| {
+            (c >> 1) ^ (0xedb8_8320 & (c & 1).wrapping_neg())
+        })
+    })
+}
