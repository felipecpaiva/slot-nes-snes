diff --git a/crates/slot-store/src/platform_policy.rs b/crates/slot-store/src/platform_policy.rs
new file mode 100644
index 0000000..8b08306
--- /dev/null
+++ b/crates/slot-store/src/platform_policy.rs
@@ -0,0 +1,25 @@
+use crate::core::Core;
+use crate::platform::Platform;
+
+impl Platform {
+    pub fn has_gb_palettes(self) -> bool {
+        match self {
+            Platform::Gba | Platform::Gbav => false,
+            Platform::Gb | Platform::Gbc => true,
+        }
+    }
+
+    pub fn owns_shoulders(self) -> bool {
+        match self {
+            Platform::Gba | Platform::Gbav => false,
+            Platform::Gb | Platform::Gbc => true,
+        }
+    }
+
+    pub fn picker_cores(self) -> Option<(Core, Core)> {
+        match self {
+            Platform::Gba | Platform::Gbav => Some((Core::Mgba, Core::Gpsp)),
+            Platform::Gb | Platform::Gbc => Some((Core::Mgba, Core::Gambatte)),
+        }
+    }
+}
