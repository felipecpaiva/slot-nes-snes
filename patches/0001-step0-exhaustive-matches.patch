+++ b/crates/slot-store/src/core.rs
@@ -44,7 +44,10 @@ impl Core {
     pub fn runs(self, platform: Platform) -> bool {
         match self {
             Core::Mgba => true,
-            Core::Gpsp => platform == Platform::Gba,
+            Core::Gpsp => match platform {
+                Platform::Gba => true,
+                Platform::Gb | Platform::Gbc => false,
+            },
         }
     }
 
