diff --git a/crates/slot-store/src/core.rs b/crates/slot-store/src/core.rs
index 4d219cb..a75a936 100644
--- a/crates/slot-store/src/core.rs
+++ b/crates/slot-store/src/core.rs
@@ -61,8 +61,14 @@ impl Core {
             #[cfg(feature = "nds")]
             _ if platform == Platform::Nds => self == Core::Dsperate,
             Core::Mgba => true,
-            Core::Gpsp => platform.hardware() == Platform::Gba,
-            Core::Gambatte => matches!(platform, Platform::Gb | Platform::Gbc),
+            Core::Gpsp => match platform {
+                Platform::Gba | Platform::Gbav => true,
+                Platform::Gb | Platform::Gbc => false,
+            },
+            Core::Gambatte => match platform {
+                Platform::Gb | Platform::Gbc => true,
+                Platform::Gba | Platform::Gbav => false,
+            },
             #[cfg(feature = "nds")]
             Core::Dsperate => false,
         }
diff --git a/crates/slot-store/src/lib.rs b/crates/slot-store/src/lib.rs
