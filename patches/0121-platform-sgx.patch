diff --git a/crates/slot-store/tests/sgx_platform.rs b/crates/slot-store/tests/sgx_platform.rs
new file mode 100644
index 0000000..dc12976
--- /dev/null
+++ b/crates/slot-store/tests/sgx_platform.rs
@@ -0,0 +1,180 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Cart, Core,
+    GameButton, Platform, RetroShader, SegaShaders, Shader, SlotState, SGX_SHADER_FILE,
+};
+
+fn put(root: &Path, dir: &str, name: &str) {
+    let dir = root.join("Games").join(dir);
+    std::fs::create_dir_all(&dir).expect("create dir");
+    std::fs::write(dir.join(name), [0u8; 0x2000]).expect("write");
+}
+
+fn on(root: &Path, platform: Platform) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == platform)
+        .collect()
+}
+
+#[test]
+fn the_supergrafx_follows_cps2_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES[20], Platform::Sgx);
+    assert_eq!(Platform::SHELVES[19], Platform::Cps2);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::Sgx.dir_name(), "SGX");
+    assert_eq!(Platform::Sgx.name(), "NEC PC Engine SuperGrafx");
+}
+
+#[test]
+fn a_sgx_or_pce_file_lands_on_the_supergrafx_shelf_with_its_stem_as_title() {
+    let d = tmp_root();
+    put(d.path(), "SGX", "Daimakaimura (Japan) (En).sgx");
+    put(
+        d.path(),
+        "SGX",
+        "Darius Plus (Japan) (En) (SG Enhanced).PCE",
+    );
+    put(d.path(), "SGX", "._Battle Ace (Japan) (En).sgx");
+    put(d.path(), "SGX", "Notes.txt");
+    let mut carts = on(d.path(), Platform::Sgx);
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(
+        stems,
+        [
+            "Daimakaimura (Japan) (En)",
+            "Darius Plus (Japan) (En) (SG Enhanced)"
+        ]
+    );
+    for c in &mut carts {
+        c.read_header();
+        assert!(c.title.is_empty(), "{} took a header title", c.stem);
+    }
+}
+
+#[test]
+fn a_pce_card_on_the_tg16_shelf_stays_a_turbografx_card_and_a_sgx_file_there_is_skipped() {
+    let d = tmp_root();
+    put(d.path(), "TG16", "Bonk's Adventure (USA).pce");
+    put(d.path(), "TG16", "Aldynes (Japan).sgx");
+    let stems: Vec<String> = on(d.path(), Platform::Tg16)
+        .into_iter()
+        .map(|c| c.stem)
+        .collect();
+    assert_eq!(stems, ["Bonk's Adventure (USA)"]);
+    assert!(on(d.path(), Platform::Sgx).is_empty());
+}
+
+#[test]
+fn the_supergrafx_runs_on_beetle_supergrafx_alone_on_the_360_by_240_canvas() {
+    assert_eq!(Core::default_for(Platform::Sgx), Core::MednafenSupergrafx);
+    assert_eq!(Core::EVERY[17], Core::MednafenSupergrafx);
+    assert_eq!(Core::MednafenSupergrafx.as_str(), "mednafen_supergrafx");
+    assert_eq!(Core::MednafenSupergrafx.option_prefix(), "sgx");
+    assert_eq!(
+        Core::parse("mednafen_supergrafx"),
+        Some(Core::MednafenSupergrafx)
+    );
+    assert_eq!(Core::MednafenSupergrafx.text(), "Beetle SuperGrafx");
+    assert_eq!(Core::MednafenSupergrafx.canvas(Platform::Sgx), (360, 240));
+    assert_eq!(
+        Core::MednafenSupergrafx.pair(),
+        (Core::MednafenSupergrafx, Core::MednafenSupergrafx)
+    );
+    assert!(!Core::MednafenSupergrafx.has_colour_correction());
+    assert_eq!(Platform::Sgx.picker_cores(), None);
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Sgx),
+            core == Core::MednafenSupergrafx,
+            "{core:?}"
+        );
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::MednafenSupergrafx.runs(platform),
+            platform == Platform::Sgx,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn the_supergrafx_plays_and_draws_like_the_turbografx() {
+    let (s, t) = (Platform::Sgx, Platform::Tg16);
+    assert_eq!(s.owns_shoulders(), t.owns_shoulders());
+    assert_eq!(s.owns_triggers(), t.owns_triggers());
+    assert_eq!(s.passes_xy_through(), t.passes_xy_through());
+    assert_eq!(s.turbo_on_xy(), t.turbo_on_xy());
+    assert_eq!(s.select_x_toggles_picture(), t.select_x_toggles_picture());
+    assert_eq!(s.stretch_crops_height(), t.stretch_crops_height());
+    assert_eq!(s.overscan(), (0, 8));
+    assert_eq!(s.follows_frame_width(), t.follows_frame_width());
+    assert_eq!(s.picture(), (256, 240));
+    assert_eq!(s.shader_choices(), &Shader::RETRO);
+    assert!(s.rewinds());
+    assert!(!s.has_gb_palettes());
+    assert!(!s.fills_canvas());
+    assert!(!s.swaps_discs());
+    assert!(!s.flashes_on_unload());
+    assert!(!s.is_arcade());
+    assert_eq!(s.actual_scale(), None);
+    assert_eq!(GameButton::of(s), GameButton::of(t));
+}
+
+#[test]
+fn a_supergrafx_game_resumes_as_a_supergrafx_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Daimakaimura (Japan) (En)".into()),
+        cart_platform: Some(Platform::Sgx),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=sgx"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn pce_still_names_no_platform_so_the_durability_test_keeps_its_meaning() {
+    let d = tmp_root();
+    std::fs::create_dir_all(d.path().join("Config")).unwrap();
+    std::fs::write(
+        d.path().join("Config/slot.state"),
+        "cart=Daimakaimura\ncart_platform=pce\n",
+    )
+    .unwrap();
+    assert_eq!(read_slot_state(d.path()).cart_platform, None);
+}
+
+#[test]
+fn the_supergrafx_shader_lives_in_its_own_file_and_leaves_the_others_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        sgx: Shader::Retro(RetroShader::CrtPi),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(SGX_SHADER_FILE)).expect("read"),
+        "sgx=crt-pi\n"
+    );
+    assert!(!d.path().join("Config/tg16_shader.txt").exists());
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+}
+
+#[test]
+fn an_unknown_supergrafx_shader_reads_as_off() {
+    let d = tmp_root();
+    std::fs::create_dir_all(d.path().join("Config")).unwrap();
+    std::fs::write(d.path().join("Config").join(SGX_SHADER_FILE), "sgx=lcd3x\n").unwrap();
+    assert_eq!(read_sega_shaders(d.path()).sgx, Shader::Off);
+}
