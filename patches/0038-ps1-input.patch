diff --git a/crates/slot-input/src/gesture/ps1.rs b/crates/slot-input/src/gesture/ps1.rs
new file mode 100644
index 0000000..e1866f9
--- /dev/null
+++ b/crates/slot-input/src/gesture/ps1.rs
@@ -0,0 +1,26 @@
+use super::{Action, Gestures, Release};
+use crate::{Btn, Millis};
+
+impl Gestures {
+    pub fn set_triggers_to_game(&mut self, on: bool) {
+        self.triggers_to_game = on;
+    }
+
+    pub(super) fn trigger_to_game(&self, b: Btn) -> bool {
+        self.triggers_to_game && matches!(b, Btn::L2 | Btn::R2)
+    }
+
+    pub(super) fn ps1_down(&mut self, b: Btn, now: Millis) -> Option<Vec<Action>> {
+        if !self.triggers_to_game || b != Btn::R2 || !self.chording(now) {
+            return None;
+        }
+        self.mark_chorded();
+        self.held.push((b, Release::Nothing));
+        if self.ff_on {
+            return Some(self.ff_clear());
+        }
+        self.ff_on = true;
+        self.ff_latched = true;
+        Some(vec![Action::FfStart])
+    }
+}
diff --git a/crates/slot-input/tests/ps1_gesture.rs b/crates/slot-input/tests/ps1_gesture.rs
new file mode 100644
index 0000000..7a6326a
--- /dev/null
+++ b/crates/slot-input/tests/ps1_gesture.rs
@@ -0,0 +1,127 @@
+use slot_input::{Action, Btn, Chord, Gestures, Mod, RawEvent, SELECT_CHORD_MS};
+
+fn default_shortcuts() -> Vec<(Chord, Action)> {
+    let select = |button| Chord {
+        modifier: Some(Mod::Select),
+        button,
+    };
+    let plain = |button| Chord {
+        modifier: None,
+        button,
+    };
+    vec![
+        (select(Btn::R1), Action::SaveState),
+        (select(Btn::L1), Action::LoadState),
+        (select(Btn::Y), Action::ColourCorrectionToggle),
+        (select(Btn::L2), Action::PalettePrev),
+        (select(Btn::R2), Action::PaletteNext),
+        (select(Btn::A), Action::ShaderNext),
+        (select(Btn::B), Action::ShaderPrev),
+        (plain(Btn::R2), Action::FfStart),
+        (plain(Btn::L2), Action::RewindStart),
+    ]
+}
+
+fn playing() -> Gestures {
+    let mut g = Gestures::new();
+    g.set_shortcuts(default_shortcuts());
+    g.set_playing(true);
+    g
+}
+
+fn select_with(g: &mut Gestures, b: Btn) -> Vec<Action> {
+    let mut out = g.feed(RawEvent::Down(Btn::Select), 1000);
+    out.extend(g.feed(RawEvent::Down(b), 1020));
+    out.extend(g.feed(RawEvent::Up(b), 1100));
+    out.extend(g.feed(RawEvent::Up(Btn::Select), 1120));
+    out.extend(g.tick(2000));
+    out
+}
+
+#[test]
+fn select_l2_still_steps_the_palette_back_everywhere_else() {
+    assert_eq!(select_with(&mut playing(), Btn::L2), [Action::PalettePrev]);
+}
+
+fn press(g: &mut Gestures, b: Btn, at: u64) -> Vec<Action> {
+    let mut out = g.feed(RawEvent::Down(b), at);
+    out.extend(g.feed(RawEvent::Up(b), at + 50));
+    out
+}
+
+fn ps1_with_triggers() -> Gestures {
+    let mut g = playing();
+    g.set_triggers_to_game(true);
+    g
+}
+
+#[test]
+fn every_shoulder_and_trigger_reaches_the_ps1_game() {
+    let mut g = ps1_with_triggers();
+    for b in [Btn::L1, Btn::R1, Btn::L2, Btn::R2] {
+        assert_eq!(
+            press(&mut g, b, 1000),
+            [Action::GbaDown(b), Action::GbaUp(b)],
+            "{b:?}"
+        );
+    }
+}
+
+#[test]
+fn l2_and_r2_still_rewind_and_fast_forward_on_gba() {
+    let mut g = playing();
+    assert_eq!(
+        press(&mut g, Btn::L2, 1000),
+        [Action::RewindStart, Action::RewindStop]
+    );
+    assert_eq!(
+        press(&mut g, Btn::R2, 2000),
+        [Action::FfStart, Action::FfStop]
+    );
+}
+
+#[test]
+fn select_r2_toggles_fast_forward_on_ps1_and_never_reaches_the_game() {
+    let mut g = ps1_with_triggers();
+    assert_eq!(select_with(&mut g, Btn::R2), [Action::FfStart]);
+    assert!(g.ff_latched());
+    let mut off = g.feed(RawEvent::Down(Btn::Select), 3000);
+    off.extend(g.feed(RawEvent::Down(Btn::R2), 3020));
+    off.extend(g.feed(RawEvent::Up(Btn::R2), 3100));
+    off.extend(g.feed(RawEvent::Up(Btn::Select), 3120));
+    off.extend(g.tick(4000));
+    assert_eq!(off, [Action::FfStop]);
+}
+
+#[test]
+fn letting_go_of_select_before_r2_still_keeps_r2_from_the_game() {
+    let mut g = ps1_with_triggers();
+    let mut out = g.feed(RawEvent::Down(Btn::Select), 1000);
+    out.extend(g.feed(RawEvent::Down(Btn::R2), 1020));
+    out.extend(g.feed(RawEvent::Up(Btn::Select), 1100));
+    out.extend(g.feed(RawEvent::Up(Btn::R2), 1120));
+    out.extend(g.tick(2000));
+    assert_eq!(out, [Action::FfStart]);
+}
+
+#[test]
+fn the_ps1_fast_forward_stops_when_the_game_goes() {
+    let mut g = ps1_with_triggers();
+    select_with(&mut g, Btn::R2);
+    assert_eq!(g.drop_ff_latch(), [Action::FfStop]);
+}
+
+#[test]
+fn select_alone_reaches_the_ps1_game_once_the_chord_window_closes() {
+    let mut g = ps1_with_triggers();
+    assert!(g.feed(RawEvent::Down(Btn::Select), 1000).is_empty());
+    assert!(g.tick(1000 + SELECT_CHORD_MS - 1).is_empty());
+    assert_eq!(
+        g.tick(1000 + SELECT_CHORD_MS),
+        [Action::GbaDown(Btn::Select)]
+    );
+    assert_eq!(
+        g.feed(RawEvent::Up(Btn::Select), 2000),
+        [Action::GbaUp(Btn::Select)]
+    );
+}
