diff --git a/crates/slot/tests/ps1_input.rs b/crates/slot/tests/ps1_input.rs
new file mode 100644
index 0000000..8131d9e
--- /dev/null
+++ b/crates/slot/tests/ps1_input.rs
@@ -0,0 +1,146 @@
+mod common;
+mod core_common;
+mod ps1_common;
+mod real_seat;
+
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use ps1_common::{disc, pcsx_rearmed};
+use slot::app::Phase;
+use slot::input::Pad;
+use slot::session::Session;
+use slot::video_mode::VideoMode;
+use slot_input::{Action, Btn, RawEvent};
+use slot_retro::{ButtonMask, TurboMode};
+use slot_store::{Controls, Platform};
+
+const STEM: &str = "Tekken";
+
+fn playing() -> Option<(tempfile::TempDir, Session)> {
+    let dylib = pcsx_rearmed()?;
+    let discs = tempfile::tempdir().expect("tempdir");
+    let cue = disc(discs.path(), STEM);
+    let root = real_seat::rooted(Platform::Ps1, STEM, &cue, &dylib);
+    std::fs::copy(
+        discs.path().join(format!("{STEM}.bin")),
+        root.path().join("Games/PS1").join(format!("{STEM}.bin")),
+    )
+    .expect("copy bin");
+    disc(&root.path().join("Games/PS1"), "Zzz");
+    let session = real_seat::play(root.path(), true);
+    Some((root, session))
+}
+
+fn input_of(session: &Session) -> u16 {
+    session.emu().expect("no core in the slot").input().0
+}
+
+#[test]
+fn the_ps1_face_buttons_go_to_the_core_by_position() {
+    for (btn, bit, pad) in [
+        (Btn::B, ButtonMask::B, "Cross"),
+        (Btn::A, ButtonMask::A, "Circle"),
+        (Btn::Y, ButtonMask::Y, "Square"),
+        (Btn::X, ButtonMask::X, "Triangle"),
+    ] {
+        let mut p = Pad::default();
+        p.apply(Action::GbaDown(btn));
+        assert_eq!(
+            p.mask_for(&Controls::default(), Platform::Ps1).0,
+            bit,
+            "{pad}"
+        );
+    }
+}
+
+#[test]
+fn l2_and_r2_are_the_libretro_ids_12_and_13() {
+    for (btn, id) in [(Btn::L2, 12), (Btn::R2, 13)] {
+        let mut p = Pad::default();
+        p.apply(Action::GbaDown(btn));
+        assert_eq!(
+            p.mask_for(&Controls::default(), Platform::Ps1).0,
+            1 << id,
+            "{btn:?}"
+        );
+        p.apply(Action::GbaUp(btn));
+        assert_eq!(
+            p.mask_for(&Controls::default(), Platform::Ps1).0,
+            0,
+            "{btn:?}"
+        );
+    }
+}
+
+#[test]
+fn only_ps1_hands_the_triggers_to_the_game_and_its_turbo_passes_through() {
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            platform.owns_triggers(),
+            platform != Platform::Ps1,
+            "{platform:?}"
+        );
+    }
+    assert!(!Platform::Ps1.owns_shoulders());
+    assert_eq!(
+        TurboMode::from_flags(Platform::Ps1.passes_xy_through(), true),
+        TurboMode::PassThrough
+    );
+}
+
+#[test]
+fn l1_r1_l2_and_r2_reach_the_ps1_core() {
+    let _g = core_lock();
+    let Some((_root, mut session)) = playing() else {
+        return;
+    };
+    for (btn, bit) in [
+        (Btn::L1, ButtonMask::L),
+        (Btn::R1, ButtonMask::R),
+        (Btn::L2, ButtonMask::L2),
+        (Btn::R2, ButtonMask::R2),
+    ] {
+        session.feed([RawEvent::Down(btn)], 5000);
+        assert_eq!(input_of(&session), bit, "{btn:?} held");
+        session.feed([RawEvent::Up(btn)], 5100);
+        assert_eq!(input_of(&session), 0, "{btn:?} let go");
+    }
+}
+
+#[test]
+fn select_x_flips_the_ps1_picture_and_never_reaches_the_game() {
+    let _g = core_lock();
+    let Some((root, mut session)) = playing() else {
+        return;
+    };
+    assert!(session.app().source_rect()[0] < 0.0, "Actual has its bars");
+    session.feed([RawEvent::Down(Btn::Select)], 5000);
+    session.feed([RawEvent::Down(Btn::X)], 5016);
+    assert_eq!(input_of(&session), 0);
+    session.feed([RawEvent::Up(Btn::X)], 5100);
+    session.feed([RawEvent::Up(Btn::Select)], 5116);
+    assert_eq!(session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(
+        slot::platform_video::video_mode_for(root.path(), STEM, Platform::Ps1),
+        VideoMode::Stretch
+    );
+}
+
+#[test]
+fn an_l2_held_through_the_eject_is_let_go_before_the_game_is_saved() {
+    let _g = core_lock();
+    let Some((_root, mut session)) = playing() else {
+        return;
+    };
+    session.feed([RawEvent::Down(Btn::L2)], 5000);
+    assert_eq!(input_of(&session), ButtonMask::L2);
+    session.feed([RawEvent::Down(Btn::Menu)], 5100);
+    session.feed([], 6200);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !matches!(session.app().phase(), Phase::Ejecting { .. }) {
+        assert!(Instant::now() < deadline, "holding Menu did not eject");
+        session.update(1.0 / 60.0);
+    }
+    assert_eq!(input_of(&session), 0);
+}
