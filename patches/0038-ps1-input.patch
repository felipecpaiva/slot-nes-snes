diff --git a/crates/slot-store/src/platform_policy.rs b/crates/slot-store/src/platform_policy.rs
index 1896363..6215838 100644
--- a/crates/slot-store/src/platform_policy.rs
+++ b/crates/slot-store/src/platform_policy.rs
@@ -160,4 +160,18 @@ impl Platform {
             | Platform::Md => false,
         }
     }
+
+    pub fn owns_triggers(self) -> bool {
+        match self {
+            Platform::Ps1 => false,
+            Platform::Gba
+            | Platform::Gb
+            | Platform::Gbc
+            | Platform::Nes
+            | Platform::Snes
+            | Platform::Gg
+            | Platform::Sms
+            | Platform::Md => true,
+        }
+    }
 }
