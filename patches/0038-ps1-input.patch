     if platform.passes_xy_through() {
         raw.extend([(Btn::X, ButtonMask::X), (Btn::Y, ButtonMask::Y)]);
     }
+    if !platform.owns_triggers() {
+        raw.extend([(Btn::L2, ButtonMask::L2), (Btn::R2, ButtonMask::R2)]);
+    }
     raw
 }
 
