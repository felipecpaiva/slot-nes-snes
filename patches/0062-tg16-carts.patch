diff --git a/crates/slot-ui/tests/tg16_hucard.rs b/crates/slot-ui/tests/tg16_hucard.rs
new file mode 100644
index 0000000..868a0aa
--- /dev/null
+++ b/crates/slot-ui/tests/tg16_hucard.rs
@@ -0,0 +1,108 @@
+use std::path::{Path, PathBuf};
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    cart_box, cart_face, plastic_in, retro_label_rect, retro_shell_of, retro_strip_rect,
+    seated_box, RetroShell, SegaShell, HUCARD_WHITE,
+};
+
+fn hucard(label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform: Platform::Tg16,
+        stem: "Bonk's Adventure (USA)".into(),
+        rom: "Games/TG16/Bonk's Adventure (USA).pce".into(),
+        label,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn magenta_label(dir: &Path) -> PathBuf {
+    let path = dir.join("label.png");
+    let file = std::fs::File::create(&path).expect("create label");
+    let mut e = png::Encoder::new(file, 8, 8);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    let px: Vec<u8> = (0..64).flat_map(|_| [255, 0, 255, 255]).collect();
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    path
+}
+
+fn px_rect(rect: (f32, f32, f32, f32)) -> (u32, u32, u32, u32) {
+    let (w, h) = cart_box(Platform::Tg16);
+    let at = |f: f32, of: u32| (f * of as f32).round() as u32;
+    (at(rect.0, w), at(rect.1, h), at(rect.2, w), at(rect.3, h))
+}
+
+fn pixel(rgba: &[u8], w: u32, x: u32, y: u32) -> [u8; 3] {
+    let i = ((y * w + x) * 4) as usize;
+    [rgba[i], rgba[i + 1], rgba[i + 2]]
+}
+
+#[test]
+fn every_turbografx_game_wears_the_hucard_whatever_its_outline_word() {
+    assert_eq!(retro_shell_of(&hucard(None)), Some(RetroShell::Hucard));
+    let mut sega_word = hucard(None);
+    sega_word.shell = Some(ShellChoice {
+        outline: Outline::SegaCard,
+        colour: [0x20; 3],
+        finish: ShellFinish::Solid,
+    });
+    assert_eq!(retro_shell_of(&sega_word), Some(RetroShell::Hucard));
+}
+
+#[test]
+fn the_hucard_is_a_white_credit_card_the_size_of_the_sega_card() {
+    assert_eq!(plastic_in(&hucard(None), RetroShell::Hucard), HUCARD_WHITE);
+    assert_eq!(cart_box(Platform::Tg16), cart_box(Platform::Sms));
+    assert_eq!(seated_box(Platform::Tg16), seated_box(Platform::Sms));
+    assert_eq!(RetroShell::Hucard.name(), "hucard");
+    assert!(RetroShell::ALL.contains(&RetroShell::Hucard));
+    assert_ne!(RetroShell::Hucard, RetroShell::Sega(SegaShell::SegaCard));
+}
+
+#[test]
+fn the_hucard_label_is_square_and_sits_below_the_middle() {
+    let (_, y, w, h) = px_rect(retro_label_rect(RetroShell::Hucard));
+    assert!(w.abs_diff(h) <= 1, "{w}x{h}");
+    let (_, ch) = cart_box(Platform::Tg16);
+    assert!((y + h / 2) * 2 > ch, "label centre {} of {ch}", y + h / 2);
+}
+
+#[test]
+fn the_hucard_contacts_are_gold_under_the_label_and_the_body_is_white() {
+    let face = cart_face(&hucard(None));
+    let strip = retro_strip_rect(RetroShell::Hucard).expect("no contact strip");
+    let (sx, sy, sw, sh) = px_rect(strip);
+    let (lx, ly, _, lh) = px_rect(retro_label_rect(RetroShell::Hucard));
+    assert!(sy > ly + lh, "the contacts are not under the label");
+    let [r, g, b] = pixel(&face.rgba, face.w, sx + sw / 2 + 1, sy + sh / 2);
+    assert!(
+        r > g && g > b && r - b > 60,
+        "contact {r},{g},{b} is not gold"
+    );
+    let [r, g, b] = pixel(&face.rgba, face.w, lx + 2, ly - 4);
+    assert!(
+        r > 150 && g > 150 && b > 150,
+        "body {r},{g},{b} is not white"
+    );
+}
+
+#[test]
+fn the_hucard_draws_its_label_art_and_a_generated_label_without_one() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let with = cart_face(&hucard(Some(magenta_label(d.path()))));
+    let without = cart_face(&hucard(None));
+    let (lx, ly, lw, lh) = px_rect(retro_label_rect(RetroShell::Hucard));
+    let centre = (lx + lw / 2, ly + lh / 2);
+    assert_eq!(pixel(&with.rgba, with.w, centre.0, centre.1), [255, 0, 255]);
+    assert_ne!(
+        pixel(&without.rgba, without.w, centre.0, centre.1),
+        [255, 0, 255]
+    );
+    assert_ne!(with.rgba, without.rgba);
+}
