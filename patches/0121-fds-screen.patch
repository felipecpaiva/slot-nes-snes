@@ -0,0 +1,123 @@
+mod common;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::video_mode::{source_rect, VideoMode};
+use slot_input::{Action, Btn};
+use slot_store::{read_sega_shaders, read_slot_state, Core, Platform, Shader, FDS_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_a_disk() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(
+        root.path()
+            .join("Games/FDS/Nazo no Murasamejou (Japan).fds"),
+        [0u8; 16],
+    )
+    .expect("write disk");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_fds(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenFds.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenFds));
+    press(app, Btn::A);
+}
+
+#[test]
+fn the_disk_system_follows_cps2_with_the_nes_rows_but_no_pal_speed() {
+    assert_eq!(QuickRow::SCREEN[21], QuickRow::ScreenFds);
+    assert_eq!(QuickRow::ScreenFds.label(), "FDS");
+    assert!(QuickRow::ScreenFds.opens());
+    assert_eq!(QuickRow::ScreenFds.child(), Some(QuickRow::FdsShader));
+    assert_eq!(
+        QuickRow::SCREEN_FDS.map(QuickRow::label),
+        ["Shader", "Picture"]
+    );
+    assert_eq!(
+        QuickRow::SCREEN_NES.map(QuickRow::label),
+        ["Shader", "Picture", "PAL Speed"]
+    );
+    for row in QuickRow::SCREEN_FDS {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenFds));
+    }
+}
+
+#[test]
+fn the_disk_system_row_shows_only_on_a_card_with_disks() {
+    let (_root, mut app) = card_with_a_disk();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenFds));
+    assert!(app.hidden_rows().contains(&QuickRow::ScreenNes));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    let without = boot(root.path());
+    assert!(without.hidden_rows().contains(&QuickRow::ScreenFds));
+    open_fds(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::FdsShader));
+}
+
+#[test]
+fn the_picture_starts_on_the_nes_crop_and_has_its_own_line_in_picture_txt() {
+    assert_eq!(default_video_mode(Platform::Fds), VideoMode::Crop);
+    assert_eq!(
+        picture_choices(Platform::Fds),
+        picture_choices(Platform::Nes)
+    );
+    let canvas = Core::Fceumm.canvas(Platform::Fds);
+    for mode in picture_choices(Platform::Fds) {
+        assert_eq!(
+            source_rect(Platform::Fds, (256, 240), canvas, *mode),
+            source_rect(Platform::Nes, (256, 240), canvas, *mode),
+            "{mode:?}"
+        );
+    }
+    let (root, mut app) = card_with_a_disk();
+    open_fds(&mut app);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::FdsPicture));
+    assert_eq!(
+        app.quick_value(QuickRow::FdsPicture),
+        Some(QuickValue::Crop)
+    );
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_eq!(
+        system_picture(root.path(), Platform::Fds),
+        VideoMode::Stretch
+    );
+    assert_eq!(system_picture(root.path(), Platform::Nes), VideoMode::Crop);
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "fds = stretch\n"
+    );
+}
+
+#[test]
+fn the_disk_system_shader_walks_the_retro_list_into_its_own_file_and_leaves_the_nes_alone() {
+    let (root, mut app) = card_with_a_disk();
+    open_fds(&mut app);
+    assert_eq!(app.quick_value(QuickRow::FdsShader), Some(QuickValue::Off));
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(read_sega_shaders(root.path()).fds);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(FDS_SHADER_FILE).exists());
+    assert_eq!(read_slot_state(root.path()).shader_nes, Shader::Off);
+}
