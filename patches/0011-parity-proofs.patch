+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use slot::app::Phase;
+use slot::audio::{AudioSink, StubSink};
+use slot::core::dylib_name;
+use slot::session::Session;
+use slot_input::{Btn, RawEvent};
+use slot_store::{Core, Platform};
+use tempfile::TempDir;
+
+use crate::common;
+
+pub fn rooted(platform: Platform, stem: &str, rom: &Path, dylib: &Path) -> TempDir {
+    let core = Core::default_for(platform);
+    let root = common::tmp_root_with_real_carts(&[]);
+    let cart = root
+        .path()
+        .join("Games")
+        .join(platform.dir_name())
+        .join(format!("{stem}.{}", platform.extensions()[0]));
+    std::fs::copy(rom, cart).expect("copy cart");
+    std::os::unix::fs::symlink(
+        std::fs::canonicalize(dylib).expect("core path"),
+        root.path().join("System").join(dylib_name(core)),
+    )
+    .expect("link core");
+    common::clocked(root.path());
+    root
+}
+
+pub fn play(root: &Path, insert: bool) -> Session {
+    let mut sink = StubSink::draining();
+    sink.open(32_768).expect("the stub refused to open");
+    let mut session = Session::boot_with(root.to_path_buf(), Box::new(sink));
+    if insert {
+        session.feed([RawEvent::Down(Btn::A)], 16);
+        session.feed([RawEvent::Up(Btn::A)], 32);
+    }
+    let deadline = Instant::now() + Duration::from_secs(20);
+    while !matches!(session.app().phase(), Phase::Playing { .. }) {
+        assert!(Instant::now() < deadline, "the cart never seated");
+        session.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    while session.frames_published() < 10 {
+        assert!(Instant::now() < deadline, "the core never drew");
+        session.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    session
+}
