diff --git a/crates/slot/tests/nes_eject_save.rs b/crates/slot/tests/nes_eject_save.rs
new file mode 100644
index 0000000..aff4a58
--- /dev/null
+++ b/crates/slot/tests/nes_eject_save.rs
@@ -0,0 +1,112 @@
+mod common;
+mod core_common;
+mod nes_common;
+mod real_seat;
+mod snes_common;
+
+use std::path::{Path, PathBuf};
+
+use common::core_lock;
+use core_common::require_core;
+use nes_common::{fceumm, nes_rom};
+use slot::app::Phase;
+use slot::persist::Snapshot;
+use slot::session::Session;
+use slot_input::{Btn, RawEvent};
+use slot_store::{read_slot_state, write_slot_state, Platform};
+use snes_common::{snes_rom, Map};
+
+const STEM: &str = "Zelda";
+
+fn battery_carts() -> Vec<(Platform, PathBuf, PathBuf)> {
+    let mut carts = Vec::new();
+    if let Some(dylib) = fceumm() {
+        carts.push((Platform::Nes, nes_rom("nes_eject.nes", true), dylib));
+    }
+    if let Some(dylib) = require_core("snes9x") {
+        for (name, map) in [
+            ("snes_eject_lo.sfc", Map::Lo),
+            ("snes_eject_hi.sfc", Map::Hi),
+        ] {
+            carts.push((Platform::Snes, snes_rom(name, map, false, 8), dylib.clone()));
+        }
+    }
+    carts
+}
+
+fn with_a_second_cart(platform: Platform, rom: &Path, dylib: &Path) -> tempfile::TempDir {
+    let root = real_seat::rooted(platform, STEM, rom, dylib);
+    let spare = format!("Zzz.{}", platform.extensions()[0]);
+    std::fs::copy(
+        rom,
+        root.path()
+            .join("Games")
+            .join(platform.dir_name())
+            .join(spare),
+    )
+    .expect("copy spare cart");
+    root
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+fn sav(root: &Path, platform: Platform) -> PathBuf {
+    root.join("Saves")
+        .join(platform.dir_name())
+        .join(format!("{STEM}.sav"))
+}
+
+#[test]
+fn ejecting_a_battery_cart_writes_its_sav_under_saves_for_its_platform() {
+    let _g = core_lock();
+    for (platform, rom, dylib) in battery_carts() {
+        let root = with_a_second_cart(platform, &rom, &dylib);
+        let mut session = real_seat::play(root.path(), true);
+        let ram = session
+            .emu()
+            .expect("no core")
+            .snapshot()
+            .save_ram()
+            .expect("the core has no save ram");
+        assert!(!ram.is_empty(), "{platform:?} save ram is empty");
+        assert!(!sav(root.path(), platform).exists());
+        eject(&mut session);
+        assert_eq!(
+            std::fs::read(sav(root.path(), platform)).expect("no .sav after eject"),
+            ram,
+            "{platform:?}"
+        );
+        assert_eq!(read_slot_state(root.path()).cart, None);
+    }
+}
+
+#[test]
+fn a_sav_on_the_card_is_loaded_into_the_core_when_the_cart_goes_back_in() {
+    let _g = core_lock();
+    for (platform, rom, dylib) in battery_carts() {
+        let root = with_a_second_cart(platform, &rom, &dylib);
+        let mut state = read_slot_state(root.path());
+        state.eject_save = false;
+        write_slot_state(root.path(), &state).expect("write slot.state");
+        let mut first = real_seat::play(root.path(), true);
+        eject(&mut first);
+        let written = std::fs::read(sav(root.path(), platform)).expect("no .sav after eject");
+        drop(first);
+        let marked = vec![0xa5u8; written.len()];
+        std::fs::write(sav(root.path(), platform), &marked).expect("write .sav");
+        let second = real_seat::play(root.path(), true);
+        assert_eq!(
+            second.emu().expect("no core").snapshot().save_ram(),
+            Some(marked),
+            "{platform:?}"
+        );
+    }
+}
diff --git a/crates/slot/tests/nes_quick_menu.rs b/crates/slot/tests/nes_quick_menu.rs
new file mode 100644
index 0000000..667dda2
--- /dev/null
+++ b/crates/slot/tests/nes_quick_menu.rs
@@ -0,0 +1,276 @@
+mod common;
+mod core_common;
+mod nes_common;
+mod snes_common;
+
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use common::{boot, core_lock, tmp_root_with_real_carts};
+use core_common::require_core;
+use nes_common::{fceumm, nes_rom};
+use slot::app::{App, Phase};
+use slot::audio::{AudioSink, StubSink};
+use slot::core::open_core_for;
+use slot::emu::{CoreState, EmuHandle, Speed};
+use slot_input::{Action, Btn};
+use slot_retro::{AvInfo, ButtonMask, CoreError, Link, RetroCore, Rumble};
+use slot_store::{read_slot_state, Core, Platform, FF_SPEEDS, FF_SPEED_DEFAULT};
+use slot_ui::{QuickRow, QuickValue};
+use snes_common::{snes_rom, Map};
+use tempfile::TempDir;
+
+struct Tapped {
+    inner: Box<dyn RetroCore>,
+    ran: Arc<AtomicU64>,
+    inputs: Arc<Mutex<Vec<u16>>>,
+}
+
+impl RetroCore for Tapped {
+    fn load(&mut self, rom: &Path) -> Result<(), CoreError> {
+        self.inner.load(rom)
+    }
+    fn run_frame(&mut self, input: ButtonMask) {
+        self.inputs.lock().expect("inputs").push(input.0);
+        self.ran.fetch_add(1, Ordering::Relaxed);
+        self.inner.run_frame(input);
+    }
+    fn set_option(&mut self, key: &str, value: &str) {
+        self.inner.set_option(key, value);
+    }
+    fn set_frame_skip(&mut self, skip: bool) {
+        self.inner.set_frame_skip(skip);
+    }
+    fn video_xrgb8888(&self) -> &[u8] {
+        self.inner.video_xrgb8888()
+    }
+    fn take_audio(&mut self) -> Vec<i16> {
+        self.inner.take_audio()
+    }
+    fn serialize(&mut self) -> Result<Vec<u8>, CoreError> {
+        self.inner.serialize()
+    }
+    fn unserialize(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.unserialize(data)
+    }
+    fn save_ram(&self) -> Option<Vec<u8>> {
+        self.inner.save_ram()
+    }
+    fn load_save_ram(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.load_save_ram(data)
+    }
+    fn av_info(&self) -> AvInfo {
+        self.inner.av_info()
+    }
+    fn rumble(&self) -> Rumble {
+        self.inner.rumble()
+    }
+    fn net(&self) -> Link {
+        self.inner.net()
+    }
+    fn canvas(&self) -> (u32, u32) {
+        self.inner.canvas()
+    }
+    fn take_av_change(&mut self) -> Option<AvInfo> {
+        self.inner.take_av_change()
+    }
+}
+
+fn shelves() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&[]);
+    for platform in [Platform::Nes, Platform::Snes] {
+        let cart = root
+            .path()
+            .join("Games")
+            .join(platform.dir_name())
+            .join(format!("Zelda.{}", platform.extensions()[0]));
+        std::fs::write(cart, vec![0u8; 0x200]).expect("write cart");
+    }
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn on_shelf(platform: Platform) -> (TempDir, App) {
+    let (root, mut app) = shelves();
+    for _ in 0..2 {
+        if app.shelf_platform_name() == Some(platform.name()) {
+            break;
+        }
+        press(&mut app, Btn::R1);
+    }
+    assert_eq!(app.shelf_platform_name(), Some(platform.name()));
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_at(app: &mut App, row: QuickRow) {
+    app.apply(Action::QuickMenu);
+    let parent = row.parent();
+    for _ in 0..parent.unwrap_or(row).position() {
+        press(app, Btn::Down);
+    }
+    if parent.is_some() {
+        press(app, Btn::A);
+        for _ in 0..row.position() {
+            press(app, Btn::Down);
+        }
+    }
+    assert_eq!(app.quick_menu(), Some(row), "the bar never reached {row:?}");
+}
+
+#[test]
+fn the_quick_menu_opens_and_walks_the_same_rows_on_the_nes_and_snes_shelves() {
+    for platform in [Platform::Nes, Platform::Snes] {
+        let (_root, mut app) = on_shelf(platform);
+        app.apply(Action::QuickMenu);
+        for want in QuickRow::MAIN {
+            assert_eq!(app.quick_menu(), Some(want), "{platform:?}");
+            press(&mut app, Btn::Down);
+        }
+        press(&mut app, Btn::Down);
+        press(&mut app, Btn::A);
+        for want in QuickRow::GAME {
+            assert_eq!(app.quick_menu(), Some(want), "{platform:?}");
+            press(&mut app, Btn::Down);
+        }
+        press(&mut app, Btn::B);
+        assert_eq!(app.quick_menu(), Some(QuickRow::Game), "{platform:?}");
+        press(&mut app, Btn::B);
+        assert!(matches!(app.phase(), Phase::Shelf), "{platform:?}");
+    }
+}
+
+#[test]
+fn the_rewind_row_turns_rewind_off_and_on_and_the_card_remembers_it() {
+    for platform in [Platform::Nes, Platform::Snes] {
+        let (root, mut app) = on_shelf(platform);
+        open_at(&mut app, QuickRow::Rewind);
+        assert_eq!(app.quick_value(QuickRow::Rewind), Some(QuickValue::On));
+        press(&mut app, Btn::Right);
+        assert_eq!(app.quick_value(QuickRow::Rewind), Some(QuickValue::Off));
+        assert!(!app.may_rewind(), "{platform:?} still rewinds");
+        assert!(!read_slot_state(root.path()).rewind, "{platform:?}");
+        press(&mut app, Btn::Left);
+        assert!(app.may_rewind(), "{platform:?}");
+        assert!(read_slot_state(root.path()).rewind, "{platform:?}");
+    }
+}
+
+#[test]
+fn the_fast_forward_row_steps_the_speed_and_the_card_remembers_it() {
+    for platform in [Platform::Nes, Platform::Snes] {
+        let (root, mut app) = on_shelf(platform);
+        open_at(&mut app, QuickRow::FastForward);
+        assert_eq!(app.ff_speed(), FF_SPEED_DEFAULT);
+        press(&mut app, Btn::Right);
+        let at = FF_SPEEDS
+            .iter()
+            .position(|s| *s == FF_SPEED_DEFAULT)
+            .expect("default speed");
+        let next = FF_SPEEDS[(at + 1) % FF_SPEEDS.len()];
+        assert_eq!(app.ff_speed(), next, "{platform:?}");
+        assert_eq!(read_slot_state(root.path()).ff_speed, next, "{platform:?}");
+    }
+}
+
+#[test]
+fn the_turbo_row_flips_its_setting_on_the_nes_and_snes_shelves() {
+    for platform in [Platform::Nes, Platform::Snes] {
+        let (root, mut app) = on_shelf(platform);
+        open_at(&mut app, QuickRow::Turbo);
+        assert!(app.turbo());
+        press(&mut app, Btn::Right);
+        assert_eq!(app.quick_value(QuickRow::Turbo), Some(QuickValue::Off));
+        assert!(!app.turbo(), "{platform:?}");
+        assert!(!read_slot_state(root.path()).turbo, "{platform:?}");
+    }
+}
+
+fn recorded(
+    platform: Platform,
+    turbo: bool,
+    which: Core,
+    dylib: PathBuf,
+    rom: PathBuf,
+) -> Vec<u16> {
+    let root = tmp_root_with_real_carts(&[]);
+    let (ran, inputs) = (
+        Arc::new(AtomicU64::new(0)),
+        Arc::new(Mutex::new(Vec::new())),
+    );
+    let core = Tapped {
+        inner: open_core_for(root.path(), which, "auto", false, &[dylib]),
+        ran: ran.clone(),
+        inputs: inputs.clone(),
+    };
+    let mut sink = StubSink::draining();
+    sink.open(32_768).expect("the stub refused to open");
+    let emu = EmuHandle::spawn(Box::new(core), rom, sink.ring(), None, None);
+    emu.set_speed(Speed::Normal);
+    emu.set_pass_through(platform.passes_xy_through());
+    emu.set_turbo(turbo);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while emu.state() == CoreState::Loading {
+        assert!(Instant::now() < deadline, "the core never loaded");
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    emu.set_input(held());
+    let from = ran.load(Ordering::Relaxed) + 5;
+    while ran.load(Ordering::Relaxed) < from + 30 {
+        assert!(Instant::now() < deadline, "the core never ran");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let seen = inputs.lock().expect("inputs");
+    seen[from as usize..].to_vec()
+}
+
+fn held() -> ButtonMask {
+    ButtonMask(ButtonMask::X | ButtonMask::Y | ButtonMask::START)
+}
+
+#[test]
+fn the_turbo_setting_changes_nothing_that_reaches_the_snes_core() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("snes9x") else {
+        return;
+    };
+    for (turbo, map) in [(true, Map::Lo), (false, Map::Hi), (false, Map::Lo)] {
+        let rom = snes_rom("snes_turbo.sfc", map, false, 0);
+        let seen = recorded(Platform::Snes, turbo, Core::Snes9x, dylib.clone(), rom);
+        assert!(
+            seen.iter().all(|m| *m == held().0),
+            "turbo {turbo}: the core was handed something else: {seen:?}"
+        );
+    }
+}
+
+#[test]
+fn the_turbo_setting_does_change_what_reaches_the_nes_core() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let rom = nes_rom("nes_turbo.nes", false);
+    let on = recorded(
+        Platform::Nes,
+        true,
+        Core::Fceumm,
+        dylib.clone(),
+        rom.clone(),
+    );
+    let off = recorded(Platform::Nes, false, Core::Fceumm, dylib, rom);
+    assert!(
+        on.iter().any(|m| m & ButtonMask::A != 0) && on.iter().any(|m| m & ButtonMask::A == 0),
+        "turbo never pulsed A: {on:?}"
+    );
+    assert!(
+        off.iter().all(|m| *m == ButtonMask::START),
+        "turbo off still sent X, Y or A: {off:?}"
+    );
+}
