@@ -0,0 +1,66 @@
+mod common;
+mod core_common;
+mod nes_common;
+mod real_seat;
+
+use common::core_lock;
+use nes_common::{fceumm, nes_rom};
+use slot::app::{App, Phase};
+use slot_store::{read_slot_state, write_slot_state, Core, Platform};
+
+const STEM: &str = "Mario";
+
+fn remembering(root: &std::path::Path, platform: Option<Platform>) {
+    let mut state = read_slot_state(root);
+    state.cart = Some(STEM.into());
+    state.cart_platform = platform;
+    write_slot_state(root, &state).expect("write slot.state");
+}
+
+#[test]
+fn a_nes_cart_in_slot_state_boots_into_the_nes_cart_on_fceumm() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let root = real_seat::rooted(
+        Platform::Nes,
+        STEM,
+        &nes_rom("nes_resume.nes", false),
+        &dylib,
+    );
+    std::fs::write(root.path().join("Games/GBA/Mario.gba"), common::gba_rom()).expect("write cart");
+    remembering(root.path(), Some(Platform::Nes));
+    let session = real_seat::play(root.path(), false);
+    let seated = session.app().seated_cart().expect("no cart in the slot");
+    assert_eq!(
+        (seated.platform, seated.stem.as_str()),
+        (Platform::Nes, STEM)
+    );
+    assert_eq!(session.app().core(), Core::Fceumm);
+    assert!(session.has_core(), "the NES cart booted with no core");
+}
+
+#[test]
+fn the_remembered_platform_picks_between_two_carts_with_the_same_name() {
+    let root = common::tmp_root_with_real_carts(&[STEM]);
+    std::fs::copy(
+        nes_rom("nes_resume_twin.nes", false),
+        root.path().join("Games/NES/Mario.nes"),
+    )
+    .expect("copy cart");
+    common::clocked(root.path());
+    for platform in [Platform::Nes, Platform::Gba] {
+        remembering(root.path(), Some(platform));
+        let app = App::boot(root.path());
+        assert!(
+            matches!(app.phase(), Phase::Inserting { .. }),
+            "{platform:?}"
+        );
+        assert_eq!(
+            app.seated_cart().map(|c| c.platform),
+            Some(platform),
+            "slot.state named {platform:?}"
+        );
+    }
+}
diff --git a/crates/slot/tests/nes_states.rs b/crates/slot/tests/nes_states.rs
new file mode 100644
index 0000000..266ddab
--- /dev/null
+++ b/crates/slot/tests/nes_states.rs
@@ -0,0 +1,150 @@
+mod common;
+mod core_common;
+mod nes_common;
+mod real_seat;
+mod snes_common;
+
+use std::path::PathBuf;
+use std::time::Duration;
+
+use common::core_lock;
+use core_common::require_core;
+use nes_common::{fceumm, nes_rom};
+use slot::emu::EmuHandle;
+use slot::persist::Snapshot;
+use slot::session::Session;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_store::{Core, Platform, StateRing};
+use snes_common::{snes_rom_red, Map};
+
+const STEM: &str = "Zelda";
+const PRESENT: Duration = Duration::from_nanos(16_666_667);
+const NES_BACKDROP_RGB: [u8; 3] = [0xd0, 0x20, 0x20];
+const SNES_BACKDROP_RGB: [u8; 3] = [0xff, 0xc7, 0x39];
+
+fn battery_carts() -> Vec<(Platform, Core, PathBuf, PathBuf)> {
+    let mut carts = Vec::new();
+    if let Some(dylib) = fceumm() {
+        carts.push((
+            Platform::Nes,
+            Core::Fceumm,
+            nes_rom("nes_states.nes", true),
+            dylib,
+        ));
+    }
+    if let Some(dylib) = require_core("snes9x") {
+        for (name, map) in [
+            ("snes_states_lo.sfc", Map::Lo),
+            ("snes_states_hi.sfc", Map::Hi),
+        ] {
+            carts.push((
+                Platform::Snes,
+                Core::Snes9x,
+                snes_rom_red(name, map, false, 8),
+                dylib.clone(),
+            ));
+        }
+    }
+    carts
+}
+
+fn chord(session: &mut Session, now: &mut Millis, btn: Btn) {
+    for ev in [
+        RawEvent::Down(Btn::Select),
+        RawEvent::Down(btn),
+        RawEvent::Up(btn),
+        RawEvent::Up(Btn::Select),
+    ] {
+        *now += 20;
+        session.feed([ev], *now);
+    }
+    session.update(1.0 / 60.0);
+}
+
+fn ring(root: &std::path::Path, platform: Platform, core: Core) -> StateRing {
+    StateRing::new(root, platform, core, STEM)
+}
+
+fn decode(png_bytes: &[u8]) -> (Vec<u8>, u32, u32) {
+    let mut reader = png::Decoder::new(png_bytes).read_info().expect("read info");
+    let mut buf = vec![0u8; reader.output_buffer_size()];
+    let info = reader.next_frame(&mut buf).expect("decode");
+    buf.truncate(info.buffer_size());
+    (buf, info.width, info.height)
+}
+
+fn step(session: &Session, frames: u32) {
+    for _ in 0..frames {
+        assert!(session.step_emulator(PRESENT, Duration::from_secs(2)));
+    }
+}
+
+fn driven(session: &mut Session) {
+    session.set_driven(true);
+    for _ in 0..400 {
+        session.update(1.0 / 60.0);
+        if session.emu().is_some_and(EmuHandle::locked) {
+            return;
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    panic!("the emulator never took the clock");
+}
+
+#[test]
+fn select_and_r1_write_a_state_and_a_full_canvas_polaroid_under_the_platform_dir() {
+    let _g = core_lock();
+    for (platform, core, rom, dylib) in battery_carts() {
+        let root = real_seat::rooted(platform, STEM, &rom, &dylib);
+        let mut session = real_seat::play(root.path(), true);
+        let mut now = 100;
+        chord(&mut session, &mut now, Btn::R1);
+        let entries = ring(root.path(), platform, core).list().expect("list");
+        assert_eq!(entries.len(), 1, "{platform:?}");
+        let under = root.path().join("States").join(platform.dir_name());
+        assert!(
+            entries[0].state.starts_with(&under),
+            "{:?}",
+            entries[0].state
+        );
+        assert!(
+            entries[0].thumb.starts_with(&under),
+            "{:?}",
+            entries[0].thumb
+        );
+        let (rgb, w, h) = decode(&std::fs::read(&entries[0].thumb).expect("polaroid"));
+        assert_eq!((w, h), (360, 240), "{platform:?}");
+        assert_eq!(&rgb[..3], [0, 0, 0], "{platform:?} corner is cropped");
+        let centre = (120 * 360 + 180) * 3;
+        let backdrop = match platform {
+            Platform::Nes => NES_BACKDROP_RGB,
+            _ => SNES_BACKDROP_RGB,
+        };
+        assert_eq!(rgb[centre..centre + 3], backdrop, "{platform:?}");
+    }
+}
+
+#[test]
+fn select_and_l1_put_the_core_back_where_select_and_r1_saved_it() {
+    let _g = core_lock();
+    for (platform, core, rom, dylib) in battery_carts() {
+        let root = real_seat::rooted(platform, STEM, &rom, &dylib);
+        let mut session = real_seat::play(root.path(), true);
+        driven(&mut session);
+        step(&session, 30);
+        let snapshot = session.emu().expect("no core").snapshot();
+        let saved = snapshot.state().expect("no state");
+        let mut now = 100;
+        chord(&mut session, &mut now, Btn::R1);
+        let entries = ring(root.path(), platform, core).list().expect("list");
+        assert_eq!(
+            std::fs::read(&entries[0].state).expect("state file"),
+            saved,
+            "{platform:?}"
+        );
+        step(&session, 30);
+        assert_ne!(snapshot.state().expect("no state"), saved, "{platform:?}");
+        chord(&mut session, &mut now, Btn::L1);
+        assert_eq!(snapshot.state().expect("no state"), saved, "{platform:?}");
+    }
+}
