index 0000000..6b53595
--- /dev/null
+++ b/crates/slot-store/src/arcade.rs
@@ -0,0 +1,113 @@
+use std::path::Path;
+
+use crate::platform::Platform;
+use crate::scan::Cart;
+
+const SETS: &str = include_str!("arcade_sets.tsv");
+
+pub const NEOGEO_BIOS_FILE: &str = "neogeo.zip";
+pub const NEOGEO_BIOS_CRCS: [u32; 4] = [0x91b6_4be3, 0x9441_6d67, 0xc2ea_0cfd, 0x5a86_cff2];
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub struct Set {
+    pub name: &'static str,
+    pub parent: Option<&'static str>,
+    pub title: &'static str,
+    pub vertical: bool,
+}
+
+pub fn set(platform: Platform, stem: &str) -> Option<Set> {
+    SETS.lines().find_map(|line| {
+        let mut cols = line.split('\t');
+        let (board, name, parent, flags, title) = (
+            cols.next()?,
+            cols.next()?,
+            cols.next()?,
+            cols.next()?,
+            cols.next()?,
+        );
+        (board == platform.dir_name() && name.eq_ignore_ascii_case(stem)).then_some(Set {
+            name,
+            parent: (parent != "-").then_some(parent),
+            title,
+            vertical: flags.contains('v'),
+        })
+    })
+}
+
+pub fn admits(platform: Platform, rom: &Path) -> bool {
+    let stem = rom.file_stem().and_then(|s| s.to_str()).unwrap_or_default();
+    if set(platform, stem).is_some() {
+        return true;
+    }
+    eprintln!(
+        "slot: scan: {}: not a {} set FBNeo runs, left off the shelf",
+        rom.display(),
+        platform.dir_name()
+    );
+    false
+}
+
+pub fn title(platform: Platform, stem: &str) -> String {
+    set(platform, stem).map_or_else(String::new, |s| s.title.to_string())
+}
+
+pub fn vertical(platform: Platform, stem: &str) -> bool {
+    set(platform, stem).is_some_and(|s| s.vertical)
+}
+
+pub fn zip_crcs(bytes: &[u8]) -> Option<Vec<u32>> {
+    let le16 = |at: usize| -> Option<usize> {
+        Some(u16::from_le_bytes(bytes.get(at..at + 2)?.try_into().ok()?) as usize)
+    };
+    let le32 = |at: usize| -> Option<u32> {
+        Some(u32::from_le_bytes(bytes.get(at..at + 4)?.try_into().ok()?))
+    };
+    let end = (0..bytes.len().saturating_sub(21))
+        .rev()
+        .take(0x10000 + 22)
+        .find(|&at| le32(at) == Some(0x0605_4b50))?;
+    let count = le16(end + 10)?;
+    let mut at = le32(end + 16)? as usize;
+    let mut crcs = Vec::with_capacity(count);
+    for _ in 0..count {
+        if le32(at)? != 0x0201_4b50 {
+            return None;
+        }
+        crcs.push(le32(at + 16)?);
+        at += 46 + le16(at + 28)? + le16(at + 30)? + le16(at + 32)?;
+    }
+    Some(crcs)
+}
+
+pub fn has_neogeo_bios(bios_dir: &Path) -> bool {
+    let Ok(bytes) = std::fs::read(bios_dir.join(NEOGEO_BIOS_FILE)) else {
+        return false;
+    };
+    let Some(crcs) = zip_crcs(&bytes) else {
+        eprintln!("slot: neogeo: BIOS/{NEOGEO_BIOS_FILE} is not a zip slot can read");
+        return false;
+    };
+    let missing: Vec<String> = NEOGEO_BIOS_CRCS
+        .iter()
+        .filter(|c| !crcs.contains(c))
+        .map(|c| format!("{c:08x}"))
+        .collect();
+    if !missing.is_empty() {
+        eprintln!(
+            "slot: neogeo: BIOS/{NEOGEO_BIOS_FILE} lacks crc32 {}",
+            missing.join(" ")
+        );
+    }
+    missing.is_empty()
+}
+
+impl Cart {
+    pub fn shelf_name(&self) -> &str {
+        if self.platform.is_arcade() && !self.title.is_empty() {
+            &self.title
+        } else {
+            &self.stem
+        }
+    }
+}
