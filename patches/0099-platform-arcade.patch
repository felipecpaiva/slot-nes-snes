diff --git a/crates/slot-store/tests/arcade_platform.rs b/crates/slot-store/tests/arcade_platform.rs
new file mode 100644
index 0000000..98543cb
--- /dev/null
+++ b/crates/slot-store/tests/arcade_platform.rs
@@ -0,0 +1,195 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::arcade::{has_neogeo_bios, set, zip_crcs, NEOGEO_BIOS_CRCS};
+use slot_store::{
+    read_sega_shaders, scan, sort_key, write_sega_shaders, Cart, Core, Platform, RetroShader,
+    SegaShaders, Shader, CPS1_SHADER_FILE, CPS2_SHADER_FILE, NEOGEO_SHADER_FILE,
+};
+
+fn put(root: &Path, shelf: &str, name: &str) {
+    let dir = root.join("Games").join(shelf);
+    std::fs::create_dir_all(&dir).expect("create dir");
+    std::fs::write(dir.join(name), b"PK\x05\x06").expect("write");
+}
+
+fn shelf(root: &Path, platform: Platform) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == platform)
+        .collect()
+}
+
+fn stems(carts: &[Cart]) -> Vec<&str> {
+    carts.iter().map(|c| c.stem.as_str()).collect()
+}
+
+#[test]
+fn neo_geo_cps1_and_cps2_are_the_last_three_shelves_on_fbneo() {
+    assert_eq!(
+        Platform::SHELVES[Platform::SHELVES.len() - 3..],
+        [Platform::NeoGeo, Platform::Cps1, Platform::Cps2]
+    );
+    assert_eq!(Platform::ALL.len(), 3);
+    for (p, dir) in [
+        (Platform::NeoGeo, "NEOGEO"),
+        (Platform::Cps1, "CPS1"),
+        (Platform::Cps2, "CPS2"),
+    ] {
+        assert_eq!(p.dir_name(), dir);
+        assert_eq!(p.extensions(), &["zip"]);
+        assert_eq!(Core::default_for(p), Core::Fbneo);
+        assert!(Core::Fbneo.runs(p));
+        assert!(p.is_arcade());
+        assert_eq!(p.picker_cores(), None);
+        assert!(!p.owns_shoulders(), "six-button games need L1 and R1");
+        assert!(p.passes_xy_through());
+        assert!(p.rewinds());
+        assert_eq!(p.shader_choices(), &Shader::RETRO);
+    }
+    assert!(!Platform::Md.is_arcade());
+    assert_eq!(Core::parse("fbneo"), Some(Core::Fbneo));
+}
+
+#[test]
+fn a_set_lists_only_on_the_shelf_of_its_board() {
+    let d = tmp_root();
+    put(d.path(), "NEOGEO", "mslug.zip");
+    put(d.path(), "NEOGEO", "ffight.zip");
+    put(d.path(), "CPS1", "ffight.zip");
+    put(d.path(), "CPS1", "ddtod.zip");
+    put(d.path(), "CPS2", "ddtod.zip");
+    put(d.path(), "CPS2", "notaset.zip");
+    put(d.path(), "CPS2", "ssf2t.7z");
+    assert_eq!(stems(&shelf(d.path(), Platform::NeoGeo)), ["mslug"]);
+    assert_eq!(stems(&shelf(d.path(), Platform::Cps1)), ["ffight"]);
+    assert_eq!(stems(&shelf(d.path(), Platform::Cps2)), ["ddtod"]);
+}
+
+#[test]
+fn the_neo_geo_bios_set_is_never_a_game() {
+    let d = tmp_root();
+    put(d.path(), "NEOGEO", "neogeo.zip");
+    put(d.path(), "NEOGEO", "kof98.zip");
+    assert_eq!(stems(&shelf(d.path(), Platform::NeoGeo)), ["kof98"]);
+}
+
+#[test]
+fn a_set_is_named_by_its_full_title_and_sorted_by_it() {
+    let d = tmp_root();
+    put(d.path(), "CPS1", "ghouls.zip");
+    put(d.path(), "CPS1", "1941.zip");
+    put(d.path(), "CPS1", "ffight.zip");
+    let carts = shelf(d.path(), Platform::Cps1);
+    let names: Vec<&str> = carts.iter().map(Cart::shelf_name).collect();
+    assert_eq!(
+        names,
+        [
+            "1941: Counter Attack (World 900227)",
+            "Final Fight (World, set 1)",
+            "Ghouls'n Ghosts (World)",
+        ]
+    );
+    assert!(sort_key(names[1]) < sort_key(names[2]));
+}
+
+#[test]
+fn the_set_table_knows_parents_clones_and_which_boards_are_vertical() {
+    let one = set(Platform::Cps1, "1941").expect("1941");
+    assert!(one.vertical);
+    assert_eq!(one.parent, None);
+    let clone = set(Platform::Cps1, "1941j").expect("1941j");
+    assert_eq!(clone.parent, Some("1941"));
+    assert!(!set(Platform::Cps2, "ssf2t").expect("ssf2t").vertical);
+    assert!(set(Platform::Cps2, "19xx").expect("19xx").vertical);
+    assert_eq!(
+        set(Platform::NeoGeo, "MSLUG").map(|s| s.name),
+        Some("mslug")
+    );
+    assert_eq!(set(Platform::Cps1, "mslug"), None);
+}
+
+fn stored_zip(members: &[(&str, u32)]) -> Vec<u8> {
+    let mut out = Vec::new();
+    let mut central = Vec::new();
+    for (name, crc) in members {
+        let at = out.len() as u32;
+        out.extend(0x0403_4b50u32.to_le_bytes());
+        out.extend([20, 0, 0, 0, 0, 0, 0, 0, 0, 0]);
+        out.extend(crc.to_le_bytes());
+        out.extend([0u8; 8]);
+        out.extend((name.len() as u16).to_le_bytes());
+        out.extend([0, 0]);
+        out.extend(name.as_bytes());
+        central.extend(0x0201_4b50u32.to_le_bytes());
+        central.extend([20, 0, 20, 0, 0, 0, 0, 0, 0, 0, 0, 0]);
+        central.extend(crc.to_le_bytes());
+        central.extend([0u8; 8]);
+        central.extend((name.len() as u16).to_le_bytes());
+        central.extend([0u8; 12]);
+        central.extend(at.to_le_bytes());
+        central.extend(name.as_bytes());
+    }
+    let dir_at = out.len() as u32;
+    let n = members.len() as u16;
+    out.extend(&central);
+    out.extend(0x0605_4b50u32.to_le_bytes());
+    out.extend([0u8; 4]);
+    out.extend(n.to_le_bytes());
+    out.extend(n.to_le_bytes());
+    out.extend((central.len() as u32).to_le_bytes());
+    out.extend(dir_at.to_le_bytes());
+    out.extend([0u8; 2]);
+    out
+}
+
+#[test]
+fn the_zip_directory_gives_each_members_crc() {
+    let z = stored_zip(&[("a.bin", 0x1234_5678), ("b.bin", 0xdead_beef)]);
+    assert_eq!(zip_crcs(&z), Some(vec![0x1234_5678, 0xdead_beef]));
+    assert_eq!(zip_crcs(b"not a zip"), None);
+}
+
+#[test]
+fn the_neo_geo_bios_counts_only_with_the_four_files_fbneo_boots_by_crc_under_any_name() {
+    let d = tmp_root();
+    let bios = d.path().join("BIOS");
+    std::fs::create_dir_all(&bios).unwrap();
+    assert!(!has_neogeo_bios(&bios), "missing");
+    let renamed: Vec<(&str, u32)> = ["asia-s3.rom", "sm1.sm1", "sfix.sfix", "000-lo.lo"]
+        .into_iter()
+        .zip(NEOGEO_BIOS_CRCS)
+        .collect();
+    std::fs::write(bios.join("neogeo.zip"), stored_zip(&renamed)).unwrap();
+    assert!(has_neogeo_bios(&bios));
+    std::fs::write(bios.join("neogeo.zip"), stored_zip(&renamed[..3])).unwrap();
+    assert!(!has_neogeo_bios(&bios), "no 000-lo.lo");
+    std::fs::write(bios.join("neogeo.zip"), b"garbage").unwrap();
+    assert!(!has_neogeo_bios(&bios), "not a zip");
+}
+
+#[test]
+fn each_arcade_shelf_keeps_its_shader_in_its_own_file() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        neogeo: Shader::Retro(RetroShader::CrtPi),
+        cps1: Shader::Retro(RetroShader::Line),
+        cps2: Shader::Off,
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    let config = d.path().join("Config");
+    assert_eq!(
+        std::fs::read_to_string(config.join(NEOGEO_SHADER_FILE)).unwrap(),
+        "neogeo=crt-pi\n"
+    );
+    assert_eq!(
+        std::fs::read_to_string(config.join(CPS1_SHADER_FILE)).unwrap(),
+        "cps1=line\n"
+    );
+    assert!(!config.join(CPS2_SHADER_FILE).exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+}
