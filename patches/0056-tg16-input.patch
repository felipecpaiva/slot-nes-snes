 crates/slot/src/input/raw_buttons.rs     |   2 +-
 crates/slot/tests/tg16_input.rs          | 124 +++++++++++++++++++++++
 3 files changed, 140 insertions(+), 1 deletion(-)
 create mode 100644 crates/slot/tests/tg16_input.rs

