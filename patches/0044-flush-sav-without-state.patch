 crates/slot/src/lib.rs                   |  1 +
 crates/slot/src/no_state.rs              |  7 +++
 crates/slot/tests/flush_without_state.rs | 59 ++++++++++++++++++++++++
 4 files changed, 76 insertions(+), 12 deletions(-)
 create mode 100644 crates/slot/src/no_state.rs
 create mode 100644 crates/slot/tests/flush_without_state.rs

