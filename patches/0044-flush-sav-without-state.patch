diff --git a/crates/slot/src/no_state.rs b/crates/slot/src/no_state.rs
new file mode 100644
index 0000000..a4a394e
--- /dev/null
+++ b/crates/slot/src/no_state.rs
@@ -0,0 +1,7 @@
+use crate::persist::Snapshot;
+
+pub fn save_ram_alone(snapshot: &dyn Snapshot, verb: &str) -> (Option<Vec<u8>>, Option<Vec<u8>>) {
+    eprintln!("slot: {verb}: the core gave up no state, writing the save ram alone");
+    let sav = snapshot.save_ram().filter(|_| snapshot.save_ram_trusted());
+    (None, sav)
+}
diff --git a/crates/slot/tests/flush_without_state.rs b/crates/slot/tests/flush_without_state.rs
new file mode 100644
index 0000000..48624a4
--- /dev/null
+++ b/crates/slot/tests/flush_without_state.rs
@@ -0,0 +1,59 @@
+mod common;
+
+use common::{app_playing_with, tmp_root_with_carts};
+use slot::persist;
+use slot::persist::Snapshot;
+use slot_input::Action;
+use slot_store::Platform;
+
+struct NoState;
+
+impl Snapshot for NoState {
+    fn state(&self) -> Option<Vec<u8>> {
+        None
+    }
+
+    fn save_ram(&self) -> Option<Vec<u8>> {
+        Some(vec![7u8; 32])
+    }
+
+    fn thumb(&self) -> Option<Vec<u8>> {
+        None
+    }
+
+    fn load(&self, _state: Vec<u8>) {}
+}
+
+#[test]
+fn a_doze_writes_the_save_ram_even_when_the_core_gives_no_state() {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    let mut a = app_playing_with(d.path(), "Emerald", Box::new(NoState));
+    a.apply(Action::PowerTap);
+    assert_eq!(
+        persist::read_sav(d.path(), Platform::Gba, "Emerald"),
+        Some(vec![7u8; 32])
+    );
+}
+
+#[test]
+fn an_eject_writes_the_save_ram_even_when_the_core_gives_no_state() {
+    let d = tmp_root_with_carts(&["Emerald", "Fusion"]);
+    let mut a = app_playing_with(d.path(), "Emerald", Box::new(NoState));
+    a.apply(Action::Eject);
+    assert_eq!(
+        persist::read_sav(d.path(), Platform::Gba, "Emerald"),
+        Some(vec![7u8; 32])
+    );
+}
+
+#[test]
+fn an_autosave_writes_the_save_ram_even_when_the_core_gives_no_state() {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    let mut a = app_playing_with(d.path(), "Emerald", Box::new(NoState));
+    a.tick_ms(60_000);
+    a.settle_saves();
+    assert_eq!(
+        persist::read_sav(d.path(), Platform::Gba, "Emerald"),
+        Some(vec![7u8; 32])
+    );
+}
