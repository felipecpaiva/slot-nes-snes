+      <path d="M 90.00 10.85 A 0.65 0.65 0 0 1 90.65 10.20 L 149.35 10.20 A 0.65 0.65 0 0 1 150.00 10.85 L 150.00 10.85 A 0.65 0.65 0 0 1 149.35 11.50 L 90.65 11.50 A 0.65 0.65 0 0 1 90.00 10.85 Z"/>
