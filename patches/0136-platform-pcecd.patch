+fn a_booted_card_has_the_pc_engine_cd_folders() {
+    let (root, _app) = card_with_a_cd();
+    for dir in ["Games/PCECD", "Saves/PCECD", "States/PCECD", "Labels/PCECD"] {
+        assert!(slot::root::DIRS.contains(&dir), "{dir}");
+        assert!(root.path().join(dir).is_dir(), "{dir}");
