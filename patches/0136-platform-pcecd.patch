@@ -0,0 +1,166 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Cart, Core,
+    GameButton, Platform, RetroShader, SegaShaders, Shader, SlotState, PCECD_SHADER_FILE,
+};
+
+fn put(root: &Path, dir: &str, name: &str) {
+    let dir = root.join("Games").join(dir);
+    std::fs::create_dir_all(&dir).expect("create dir");
+    std::fs::write(dir.join(name), [0u8; 0x200]).expect("write");
+}
+
+fn on(root: &Path, platform: Platform) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == platform)
+        .collect()
+}
+
+#[test]
+fn the_pc_engine_cd_follows_the_supergrafx_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES[23], Platform::Pcecd);
+    assert_eq!(Platform::SHELVES[22], Platform::Sgx);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::Pcecd.dir_name(), "PCECD");
+    assert_eq!(Platform::Pcecd.name(), "NEC PC Engine CD");
+}
+
+#[test]
+fn a_chd_cue_or_ccd_lands_on_the_cd_shelf_and_track_files_stay_off_it() {
+    let d = tmp_root();
+    for name in [
+        "Ys Book I & II (USA).chd",
+        "Gate of Thunder (Japan).CUE",
+        "Gate of Thunder (Japan) (Track 01).bin",
+        "Gate of Thunder (Japan) (Track 02).bin",
+        "Lords of Thunder (USA).ccd",
+        "Lords of Thunder (USA).img",
+        "Lords of Thunder (USA).sub",
+        "._Ys Book I & II (USA).chd",
+        "Rondo.m3u",
+        "Bonk's Adventure (USA).pce",
+    ] {
+        put(d.path(), "PCECD", name);
+    }
+    let mut carts = on(d.path(), Platform::Pcecd);
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(
+        stems,
+        [
+            "Gate of Thunder (Japan)",
+            "Lords of Thunder (USA)",
+            "Ys Book I & II (USA)"
+        ]
+    );
+    for c in &mut carts {
+        c.read_header();
+        assert!(c.title.is_empty(), "{} took a header title", c.stem);
+    }
+}
