+}
+
+fn seated(dylib: &Path) -> TempDir {
+    let discs = tempfile::tempdir().expect("tempdir");
+    let cue = disc(discs.path(), "Paint");
+    let root = real_seat::rooted(Platform::Pcecd, STEM, &cue, dylib);
+    std::fs::copy(
+        discs.path().join("Paint.bin"),
+        root.path().join("Games/PCECD/Paint.bin"),
+    )
+    .expect("copy track");
+    std::fs::write(root.path().join("Games/PCECD/Zzz.chd"), [0u8; 0x200]).expect("second disc");
+    put_card(root.path(), &placeholder_card());
+    root
+}
+
+fn sav(root: &Path) -> PathBuf {
+    root.join("Saves/PCECD").join(format!("{STEM}.sav"))
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+#[test]
+fn a_marked_backup_ram_survives_an_eject_and_a_reinsert_through_saves_pcecd() {
+    let _g = core_lock();
+    let Some(dylib) = pce_fast() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut marked = vec![0u8; 2048];
+    marked[..8].copy_from_slice(HUBM);
+    marked[0x10..0x14].copy_from_slice(b"SAVE");
+    std::fs::write(sav(root.path()), &marked).expect("write sav");
+    let mut first = real_seat::play(root.path(), true);
+    let in_core = |s: &Session| s.emu().expect("no core").snapshot().save_ram();
+    assert!(in_core(&first) == Some(marked.clone()), "first insert");
+    eject(&mut first);
+    drop(first);
+    assert!(std::fs::read(sav(root.path())).expect("read sav") == marked);
+    let second = real_seat::play(root.path(), true);
+    assert!(in_core(&second) == Some(marked), "after reinsert");
+}
+
+#[test]
+fn a_cd_that_never_saves_leaves_a_2_kb_formatted_sav_on_eject() {
+    let _g = core_lock();
+    let Some(dylib) = pce_fast() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut session = real_seat::play(root.path(), true);
+    eject(&mut session);
+    let mut blank = vec![0u8; 2048];
+    blank[..8].copy_from_slice(HUBM);
+    assert!(std::fs::read(sav(root.path())).expect("no sav after eject") == blank);
+}
+
+fn held(btn: Btn) -> u16 {
+    let mut p = Pad::default();
+    p.apply(Action::GbaDown(btn));
+    p.mask_for(&Controls::default(), Platform::Pcecd).0
+}
+
+#[test]
+fn the_pc_engine_cd_pad_is_the_turbografx_one_with_turbo_on_x_and_y() {
+    assert_eq!(held(Btn::B), ButtonMask::B, "II");
+    assert_eq!(held(Btn::A), ButtonMask::A, "I");
+    assert_eq!(held(Btn::Start), ButtonMask::START, "Run");
+    assert_eq!(held(Btn::X), ButtonMask::X);
+    assert_eq!(held(Btn::Y), ButtonMask::Y);
+    assert!(Platform::Pcecd.turbo_on_xy());
+    assert!(!Platform::Pcecd.passes_xy_through());
+}
+
+#[test]
+fn the_cd_shelf_sits_between_the_mega_drive_and_the_game_boy_by_release_date() {
+    let released = slot::shelf_order::RELEASED;
+    let at = |p: Platform| released.iter().position(|r| r.0 == p).expect("listed");
+    assert_eq!(
+        released[at(Platform::Pcecd)],
+        (Platform::Pcecd, 1988, 12, 4)
+    );
+    assert_eq!(at(Platform::Pcecd), at(Platform::Md) + 1);
+    assert_eq!(at(Platform::Gb), at(Platform::Pcecd) + 1);
+}
