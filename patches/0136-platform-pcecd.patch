+use pcecd_common::{disc, pce_fast, placeholder_card, put_card};
+use slot::app::{App, Phase};
+use slot::core::{apply_core_options, open_core_for_palette};
+use slot::input::Pad;
+use slot::persist::Snapshot;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::session::Session;
+use slot::video_mode::VideoMode;
+use slot_input::{Action, Btn, RawEvent};
+use slot_retro::{ButtonMask, LibretroCore};
+use slot_store::{Controls, Core, Platform, Shader, PCECD_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+use tg16_common::RED_BGRX;
+
+const STEM: &str = "Ys Book I & II (USA)";
+const HUBM: &[u8; 8] = b"HUBM\x00\x88\x10\x80";
+
+#[test]
+fn a_cd_is_told_to_boot_system_card_3_and_never_to_cache_the_whole_image() {
+    let _g = core_lock();
+    let Some(dylib) = pce_fast() else {
+        return;
+    };
+    let d = tmp_root_with_real_carts(&[]);
+    let mut core = LibretroCore::open_with(&dylib, d.path(), d.path()).expect("open pce_fast");
+    apply_core_options(
+        &mut core,
+        Core::MednafenPceFast,
+        Platform::Pcecd,
+        "auto",
+        false,
+        false,
+        None,
+    );
+    for (key, value) in [
+        ("pce_fast_cdbios", "System Card 3"),
+        ("pce_fast_cdimagecache", "disabled"),
+    ] {
+        assert_eq!(core.option(key).as_deref(), Some(value), "{key}");
+        let values = core
+            .declared_options()
+            .get(key)
+            .unwrap_or_else(|| panic!("the pin no longer declares {key}"));
+        assert!(values.iter().any(|v| v == value), "{key}={value}");
+    }
+}
+
+#[test]
+fn through_slots_open_path_a_disc_boots_its_system_card_and_fills_the_canvas_height() {
+    let _g = core_lock();
+    let Some(dylib) = pce_fast() else {
+        return;
+    };
+    let d = tmp_root_with_real_carts(&[]);
+    put_card(d.path(), &placeholder_card());
+    let cue = disc(&d.path().join("Games/PCECD"), "Paint");
+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::MednafenPceFast,
+        Platform::Pcecd,
+        "",
+        false,
+        None,
+        std::slice::from_ref(&dylib),
+    );
+    core.load(&cue).expect("Beetle PCE Fast refused the disc");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(core.frame_width(), 256);
+    let video = core.video_xrgb8888();
+    for y in 0..240 {
+        for x in 0..360 {
+            let at = (y * 360 + x) * 4;
+            let want = if (52..52 + 256).contains(&x) {
+                RED_BGRX
+            } else {
+                [0, 0, 0]
+            };
+            assert_eq!(&video[at..at + 3], want, "({x}, {y})");
+        }
+    }
+}
+
+fn card_with_a_cd() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(
+        root.path().join("Games/PCECD").join(format!("{STEM}.chd")),
+        [0u8; 0x200],
+    )
+    .expect("write disc");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_pcecd(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenPcecd.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenPcecd));
+    press(app, Btn::A);
+}
+
+#[test]
+fn the_pc_engine_cd_follows_the_supergrafx_in_the_screen_list_with_shader_and_picture() {
+    assert_eq!(QuickRow::SCREEN[23], QuickRow::ScreenPcecd);
+    assert_eq!(QuickRow::SCREEN[22], QuickRow::ScreenSgx);
+    assert_eq!(QuickRow::ScreenPcecd.label(), "PC Engine CD");
+    assert!(QuickRow::ScreenPcecd.opens());
+    assert_eq!(QuickRow::ScreenPcecd.child(), Some(QuickRow::PcecdShader));
+    assert_eq!(
+        QuickRow::SCREEN_PCECD.map(QuickRow::label),
+        ["Shader", "Picture"]
+    );
+    for row in QuickRow::SCREEN_PCECD {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenPcecd));
+        assert_eq!(row.page(), &QuickRow::SCREEN_PCECD);
+    }
+}
+
+#[test]
+fn the_pc_engine_cd_row_shows_only_on_a_card_with_cd_games() {
+    let (_root, mut app) = card_with_a_cd();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenPcecd));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    assert!(boot(root.path())
+        .hidden_rows()
+        .contains(&QuickRow::ScreenPcecd));
+    open_pcecd(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::PcecdShader));
+}
+
+#[test]
+fn the_pc_engine_cd_shader_walks_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_cd();
+    let state = std::fs::read(root.path().join("Config/slot.state")).ok();
+    open_pcecd(&mut app);
+    assert_eq!(
+        app.quick_value(QuickRow::PcecdShader),
+        Some(QuickValue::Off)
+    );
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(slot_store::read_sega_shaders(root.path()).pcecd);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(PCECD_SHADER_FILE).exists());
+    assert!(!root.path().join("Config/tg16_shader.txt").exists());
+    assert_eq!(
+        std::fs::read(root.path().join("Config/slot.state")).ok(),
+        state
+    );
+}
+
+#[test]
+fn the_pc_engine_cd_picture_starts_at_crop_and_walks_stretch_actual_four_three_crop() {
+    assert_eq!(default_video_mode(Platform::Pcecd), VideoMode::Crop);
+    use VideoMode::{Actual, Crop, FourThree, Stretch};
+    assert_eq!(
+        picture_choices(Platform::Pcecd),
+        [Crop, Stretch, Actual, FourThree]
+    );
+    let (root, mut app) = card_with_a_cd();
+    open_pcecd(&mut app);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::PcecdPicture));
+    assert_eq!(
+        app.quick_value(QuickRow::PcecdPicture),
+        Some(QuickValue::Crop)
+    );
+    for want in [Stretch, Actual, FourThree, Crop] {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        assert_eq!(
+            app.quick_value(QuickRow::PcecdPicture),
+            Some(want.quick_value())
+        );
+        assert_eq!(system_picture(root.path(), Platform::Pcecd), want);
+    }
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "pcecd = crop\n"
+    );
+    assert_eq!(system_picture(root.path(), Platform::Tg16), Crop);
+}
+
+#[test]
+fn the_in_game_shader_row_steps_the_pc_engine_cd_shader_into_its_own_file() {
+    let (root, mut session) = input_common::playing(Platform::Pcecd, "Gate of Thunder");
+    assert_eq!(session.app().screen_shader(), Shader::Off);
+    let mut now = 100;
+    for ev in [
+        RawEvent::Down(Btn::Select),
+        RawEvent::Down(Btn::A),
+        RawEvent::Up(Btn::A),
+        RawEvent::Up(Btn::Select),
+    ] {
+        now += 20;
+        session.feed([ev], now);
+    }
+    session.app().flush_state();
+    assert_eq!(session.app().screen_shader(), Shader::RETRO[1]);
+    assert_eq!(
+        slot_store::read_sega_shaders(root.path()).pcecd,
+        Shader::RETRO[1]
+    );
