+#[test]
+fn a_disc_on_the_turbografx_shelf_is_skipped_and_the_hucard_shelf_stays_pce_only() {
+    let d = tmp_root();
+    put(d.path(), "TG16", "Bonk's Adventure (USA).pce");
+    put(d.path(), "TG16", "Ys Book I & II (USA).chd");
+    let stems: Vec<String> = on(d.path(), Platform::Tg16)
+        .into_iter()
+        .map(|c| c.stem)
+        .collect();
+    assert_eq!(stems, ["Bonk's Adventure (USA)"]);
+    assert!(on(d.path(), Platform::Pcecd).is_empty());
+}
+
+#[test]
+fn the_pc_engine_cd_runs_on_beetle_pce_fast_alone_beside_the_turbografx() {
+    assert_eq!(Core::default_for(Platform::Pcecd), Core::MednafenPceFast);
+    assert_eq!(Core::MednafenPceFast.canvas(Platform::Pcecd), (360, 240));
+    assert_eq!(Platform::Pcecd.picker_cores(), None);
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Pcecd),
+            core == Core::MednafenPceFast,
+            "{core:?}"
+        );
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::MednafenPceFast.runs(platform),
+            matches!(platform, Platform::Tg16 | Platform::Pcecd),
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn the_pc_engine_cd_plays_and_draws_like_the_turbografx_and_rewinds() {
+    let (c, t) = (Platform::Pcecd, Platform::Tg16);
+    assert_eq!(c.owns_shoulders(), t.owns_shoulders());
+    assert_eq!(c.owns_triggers(), t.owns_triggers());
+    assert_eq!(c.passes_xy_through(), t.passes_xy_through());
+    assert_eq!(c.turbo_on_xy(), t.turbo_on_xy());
+    assert_eq!(c.select_x_toggles_picture(), t.select_x_toggles_picture());
+    assert_eq!(c.stretch_crops_height(), t.stretch_crops_height());
+    assert_eq!(c.overscan(), (0, 8));
+    assert_eq!(c.follows_frame_width(), t.follows_frame_width());
+    assert_eq!(c.picture(), (256, 240));
+    assert_eq!(c.shader_choices(), &Shader::RETRO);
+    assert!(c.rewinds());
+    assert!(!c.has_gb_palettes());
+    assert!(!c.fills_canvas());
+    assert!(!c.swaps_discs());
+    assert!(!c.flashes_on_unload());
+    assert!(!c.is_arcade());
+    assert_eq!(c.actual_scale(), None);
+    assert_eq!(GameButton::of(c), GameButton::of(t));
+}
+
+#[test]
+fn a_pc_engine_cd_game_resumes_as_a_pc_engine_cd_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Ys Book I & II (USA)".into()),
+        cart_platform: Some(Platform::Pcecd),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=pcecd"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn the_pc_engine_cd_shader_lives_in_its_own_file_and_leaves_the_turbografx_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        pcecd: Shader::Retro(RetroShader::CrtPi),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(PCECD_SHADER_FILE)).expect("read"),
+        "pcecd=crt-pi\n"
+    );
+    assert!(!d.path().join("Config/tg16_shader.txt").exists());
+    assert!(!d.path().join("Config/sgx_shader.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+}
+
+#[test]
+fn an_unknown_pc_engine_cd_shader_reads_as_off() {
+    let d = tmp_root();
+    std::fs::create_dir_all(d.path().join("Config")).unwrap();
+    std::fs::write(
+        d.path().join("Config").join(PCECD_SHADER_FILE),
+        "pcecd=lcd3x\n",
+    )
+    .unwrap();
+    assert_eq!(read_sega_shaders(d.path()).pcecd, Shader::Off);
+}
