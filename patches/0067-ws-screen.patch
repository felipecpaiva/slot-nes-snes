+fn wonderswan_is_paced_at_its_own_fps_whichever_refresh_is_chosen() {
+    let (_root, app) = card_with_a_cart();
+    assert!(app.native_pal(Platform::Ws));
+    assert_eq!(slot::ws_refresh::sixty_hz_mode(false), "enabled");
