+mod common;
+mod core_common;
+mod real_seat;
+mod wswan_common;
+
+use std::time::Duration;
+
+use common::core_lock;
+use slot::av_rate::owed_frames;
+use slot::core::open_core;
+use slot::session::Session;
+use slot::video_mode::VideoMode;
+use slot_store::{Core, Platform};
+use wswan_common::{assert_red_box, cart, cygne, Code, Save, NATIVE_FPS};
+
+fn playing(vertical: bool) -> Option<(tempfile::TempDir, Session)> {
+    let dylib = cygne()?;
+    let roms = tempfile::tempdir().expect("tempdir");
+    let rom = cart(roms.path(), "Game", Code::Paint, Save::None, vertical);
+    let root = real_seat::rooted(Platform::Ws, "Game", &rom, &dylib);
+    let mut session = real_seat::play(root.path(), true);
+    for _ in 0..10 {
+        session.update(1.0 / 60.0);
+    }
+    Some((root, session))
+}
+
+fn near(a: [f32; 4], b: [f32; 4]) -> bool {
+    a.iter().zip(b).all(|(x, y)| (x - y).abs() < 1e-4)
+}
+
+#[test]
+fn a_horizontal_cart_draws_224_by_144_in_the_middle_of_its_240_by_160_canvas() {
+    let _g = core_lock();
+    let Some((_root, session)) = playing(false) else {
+        return;
+    };
+    assert!(!session.app().vertical());
+    let frame = session
+        .emu()
+        .expect("no core")
+        .latest_frame()
+        .expect("no frame");
+    assert_red_box(&frame, (240, 160), (224, 144));
+    assert_eq!(session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert!(near(
+        session.app().picture_rect(),
+        [8.0 / 240.0, 8.0 / 160.0, 232.0 / 240.0, 152.0 / 160.0]
+    ));
+}
+
+#[test]
+fn a_vertical_cart_draws_144_by_224_upright_in_the_middle_of_its_360_by_240_canvas() {
+    let _g = core_lock();
+    let Some((_root, mut session)) = playing(true) else {
+        return;
+    };
+    assert!(session.app().vertical());
+    let frame = session
+        .emu()
+        .expect("no core")
+        .latest_frame()
+        .expect("no frame");
+    assert_red_box(&frame, (360, 240), (144, 224));
+    drop(frame);
+    assert_eq!(session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert!(near(
+        session.app().picture_rect(),
+        [108.0 / 360.0, 8.0 / 240.0, 252.0 / 360.0, 232.0 / 240.0]
+    ));
+    session.app_mut().set_video_mode(VideoMode::Stretch);
+    assert!(near(
+        session.app().source_rect(),
+        [108.0 / 360.0, 0.0, 144.0 / 360.0, 1.0]
+    ));
+}
+
+#[test]
+fn native_refresh_opens_at_75_47_fps() {
+    let _g = core_lock();
+    let Some(dylib) = cygne() else {
+        return;
+    };
+    let roms = tempfile::tempdir().expect("tempdir");
+    let rom = cart(roms.path(), "Game", Code::Paint, Save::None, false);
+    let root = real_seat::rooted(Platform::Ws, "Game", &rom, &dylib);
+    let mut core = open_core(
+        root.path(),
+        Core::MednafenWswan,
+        Platform::Ws,
+        "",
+        false,
+        None,
+        None,
+    )
+    .core;
+    slot::ws_load::prepare(core.as_mut(), Platform::Ws, false, true);
+    core.load(&root.path().join("Games/WS/Game.ws"))
+        .expect("Beetle Cygne refused the cart");
+    let fps = core.av_info().fps;
+    assert!((fps - NATIVE_FPS).abs() < 0.01, "{fps} fps");
+}
+
+#[test]
+fn native_75_47_fps_on_a_59_6_hz_panel_owes_one_or_two_frames_a_tick_and_none_are_lost() {
+    let present = Duration::from_nanos(16_666_667);
+    let tick = Duration::from_secs_f64(1.0 / 59.6);
+    let period = Duration::from_secs_f64(1.0 / NATIVE_FPS);
+    let mut owed = 0.0;
+    let mut total = 0u32;
+    let ticks = 596;
+    for _ in 0..ticks {
+        let n = owed_frames(&mut owed, tick, period, present);
+        assert!(n == 1 || n == 2, "{n} frames in one tick");
+        total += n;
+    }
+    let want = 10.0 * NATIVE_FPS;
+    assert!(
+        (f64::from(total) - want).abs() < 1.0,
+        "{total}, want {want}"
+    );
+}
