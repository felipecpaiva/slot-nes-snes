+#[test]
+fn refresh_starts_at_60_hz_and_the_choice_is_kept_as_the_default() {
+    let (root, mut app) = card_with_a_cart();
+    open_wonderswan(&mut app);
+    press(&mut app, Btn::Down);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::WsRefresh));
+    assert_eq!(app.quick_value(QuickRow::WsRefresh), Some(QuickValue::Hz60));
+    assert!(!app.ws_native());
+    assert!(!root.path().join(REFRESH_FILE).exists());
+    app.apply(Action::GbaDown(Btn::Right));
+    assert_eq!(
+        app.quick_value(QuickRow::WsRefresh),
+        Some(QuickValue::Native)
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(REFRESH_FILE)).expect("refresh.txt"),
+        "ws = native\n"
+    );
+    assert!(boot(root.path()).ws_native());
+    app.apply(Action::GbaDown(Btn::Left));
+    assert_eq!(app.quick_value(QuickRow::WsRefresh), Some(QuickValue::Hz60));
+    assert!(!boot(root.path()).ws_native());
+}
