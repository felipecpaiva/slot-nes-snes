+++ b/crates/slot/src/ws_refresh.rs
@@ -0,0 +1,44 @@
+use std::path::Path;
+
+use slot_store::ini;
+use slot_ui::QuickValue;
+
+use crate::card_log::CardWrites;
+
+pub const REFRESH_FILE: &str = "Config/refresh.txt";
+
+const KEY: &str = "ws";
+
+pub fn native(root: &Path) -> bool {
+    match ini::value(root, REFRESH_FILE, KEY).as_deref() {
+        None | Some("60hz") => false,
+        Some("native") => true,
+        Some(other) => {
+            eprintln!("slot: refresh.txt: ignoring {KEY}={other}");
+            false
+        }
+    }
+}
+
+pub fn quick_value(native: bool) -> QuickValue {
+    match native {
+        true => QuickValue::Native,
+        false => QuickValue::Hz60,
+    }
+}
+
+pub fn sixty_hz_mode(native: bool) -> &'static str {
+    match native {
+        true => "disabled",
+        false => "enabled",
+    }
+}
+
+pub fn save(root: &Path, native: bool, writes: &CardWrites) {
+    let value = if native { "native" } else { "60hz" };
+    let written = ini::write(root, REFRESH_FILE, KEY, value);
+    if let Err(e) = &written {
+        eprintln!("slot: emu: could not write refresh.txt: {e}");
+    }
+    writes.wrote("refresh.txt", &written);
+}
