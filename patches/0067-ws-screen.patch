+#[test]
+fn the_wonderswan_shader_walks_off_lcd3x_and_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_cart();
+    let state = std::fs::read(root.path().join("Config/slot.state")).ok();
+    open_wonderswan(&mut app);
+    assert_eq!(app.quick_value(QuickRow::WsShader), Some(QuickValue::Off));
+    let mut seen = Vec::new();
+    for _ in 0..Shader::GG.len() {
+        app.apply(Action::GbaDown(Btn::Right));
+        app.flush_state();
+        seen.push(slot_store::read_sega_shaders(root.path()).ws);
+    }
+    assert_eq!(seen, [&Shader::GG[1..], &Shader::GG[..1]].concat());
+    assert!(root.path().join("Config").join(WS_SHADER_FILE).exists());
+    assert!(!root.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(
+        std::fs::read(root.path().join("Config/slot.state")).ok(),
+        state
+    );
+}
