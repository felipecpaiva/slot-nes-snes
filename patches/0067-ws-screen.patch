+#[test]
+fn a_missing_or_unknown_refresh_line_reads_as_60_hz() {
+    let (root, _app) = card_with_a_cart();
+    assert!(!slot::ws_refresh::native(root.path()));
+    std::fs::write(root.path().join(REFRESH_FILE), "ws = 75hz\n").expect("write");
+    assert!(!slot::ws_refresh::native(root.path()));
+    std::fs::write(root.path().join(REFRESH_FILE), "ws = native\n").expect("write");
+    assert!(slot::ws_refresh::native(root.path()));
+}
