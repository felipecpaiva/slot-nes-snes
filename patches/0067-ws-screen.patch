+mod common;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::video_mode::VideoMode;
+use slot::ws_refresh::REFRESH_FILE;
+use slot_input::{Action, Btn};
+use slot_store::{Platform, Shader, WS_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_a_cart() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(root.path().join("Games/WS/Gunpey.ws"), [0u8; 16]).expect("write cart");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_wonderswan(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenWs.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenWs));
+    press(app, Btn::A);
+}
+
+#[test]
+fn wonderswan_closes_the_screen_list_with_shader_picture_and_refresh() {
+    assert_eq!(QuickRow::SCREEN.last(), Some(&QuickRow::ScreenWs));
+    assert_eq!(QuickRow::ScreenWs.label(), "WonderSwan");
+    assert!(QuickRow::ScreenWs.opens());
+    assert_eq!(QuickRow::ScreenWs.child(), Some(QuickRow::WsShader));
+    assert_eq!(
+        QuickRow::SCREEN_WS.map(QuickRow::label),
+        ["Shader", "Picture", "Refresh"]
+    );
+    for row in QuickRow::SCREEN_WS {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenWs));
+    }
+    assert!(!QuickRow::PLAY_SCREEN.contains(&QuickRow::WsShader));
+}
