+#[test]
+fn lcd3x_draws_as_off_on_a_vertical_game_and_as_itself_on_a_horizontal_one() {
+    use slot::ws_load::drawn_shader;
+    assert_eq!(drawn_shader(Shader::Lcd3x, false), Shader::Lcd3x);
+    assert_eq!(drawn_shader(Shader::Lcd3x, true), Shader::Off);
+    for shader in Shader::GG.into_iter().filter(|s| *s != Shader::Lcd3x) {
+        assert_eq!(drawn_shader(shader, true), shader);
+    }
+}
