+fn on_strip(kind: RetroShell, x: u32, y: u32) -> bool {
+    let (w, h) = cart_box(platform_of(kind));
+    retro_strip_rect(kind).is_some_and(|(sx, sy, sw, sh)| {
+        let at = |f: f32, of: u32| (f * of as f32).round() as u32;
+        (at(sx, w)..at(sx + sw, w)).contains(&x) && (at(sy, h)..at(sy + sh, h)).contains(&y)
+    })
+}
