+use std::path::{Path, PathBuf};
+
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    cart_box, cart_face, cart_face_with, cart_interior, disc_art_path, disc_face_with,
+    label_colour, label_cover, label_size, on_print, read_case, retro_cart_face, retro_label_rect,
+    retro_shell_of, retro_strip_rect, seated_box, shows_interior, tag_region, Canvas, Draw,
+    Ps1Case, RetroShell, SlotChrome, TexId, DISC_PX, OBI_PAPER, OUT_W,
+};
+
+const CASES: [Ps1Case; 4] = [Ps1Case::Us, Ps1Case::Eu, Ps1Case::Jp, Ps1Case::Double];
+
+fn disc(stem: &str, rom: PathBuf, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform: Platform::Ps1,
+        stem: stem.into(),
+        rom,
+        label,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn png(path: &Path, w: u32, h: u32, px: impl Fn(u32, u32) -> [u8; 4]) {
+    let file = std::fs::File::create(path).expect("create png");
+    let mut e = png::Encoder::new(std::io::BufWriter::new(file), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    let data: Vec<u8> = (0..w * h).flat_map(|i| px(i % w, i / w)).collect();
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&data)
+        .expect("png data");
+}
+
+fn iso_track(serial: &str) -> Vec<u8> {
+    let mut img = vec![0u8; 2048 * 22];
+    img[16 * 2048] = 1;
+    img[16 * 2048 + 1..16 * 2048 + 6].copy_from_slice(b"CD001");
+    let root = 16 * 2048 + 156;
+    img[root] = 34;
+    img[root + 2..root + 6].copy_from_slice(&20u32.to_le_bytes());
+    img[root + 10..root + 14].copy_from_slice(&2048u32.to_le_bytes());
+    let name = b"SYSTEM.CNF;1";
+    let rec = 20 * 2048;
+    img[rec] = (34 + name.len()) as u8;
+    img[rec + 2..rec + 6].copy_from_slice(&21u32.to_le_bytes());
+    img[rec + 32] = name.len() as u8;
+    img[rec + 33..rec + 33 + name.len()].copy_from_slice(name);
+    let cnf = format!("BOOT = cdrom:\\{serial};1\r\nTCB = 4\r\n");
+    img[21 * 2048..21 * 2048 + cnf.len()].copy_from_slice(cnf.as_bytes());
+    img
+}
+
+fn cue_game(dir: &Path, stem: &str, serial: &str) -> PathBuf {
+    std::fs::write(dir.join(format!("{stem}.bin")), iso_track(serial)).expect("write bin");
+    let cue = dir.join(format!("{stem}.cue"));
+    std::fs::write(
+        &cue,
+        format!("FILE \"{stem}.bin\" BINARY\n  TRACK 01 MODE2/2352\n"),
+    )
+    .expect("write cue");
+    cue
+}
+
+fn px(face: &[u8], w: u32, x: u32, y: u32) -> [u8; 4] {
+    let i = ((y * w + x) * 4) as usize;
+    [face[i], face[i + 1], face[i + 2], face[i + 3]]
+}
