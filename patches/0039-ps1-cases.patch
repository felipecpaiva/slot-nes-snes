diff --git a/crates/slot-ui/src/disc_insert.rs b/crates/slot-ui/src/disc_insert.rs
new file mode 100644
index 0000000..bf8b5f9
--- /dev/null
+++ b/crates/slot-ui/src/disc_insert.rs
@@ -0,0 +1,80 @@
+use slot_gfx::Draw;
+
+use crate::cart::cart_box;
+use crate::ps1_case::has_disc;
+use crate::retro_cart::look;
+use crate::retro_cart::{Ps1Case, RetroShell};
+use crate::retro_shell::JEWEL_TRAY_BLACK;
+use crate::shelf::foot_y;
+use crate::slot_chrome::{ease, SlotChrome};
+
+const DISC_IN_TRAY: f32 = 0.9;
+
+pub(crate) fn opening(k: f32) -> (f32, f32) {
+    let k = k.clamp(0.0, 1.0);
+    (
+        ease((k * 2.0).min(1.0)),
+        ease((k * 2.0 - 1.0).clamp(0.0, 1.0)),
+    )
+}
+
+pub(crate) fn draw(
+    chrome: &SlotChrome,
+    at: [f32; 4],
+    k: f32,
+    alpha: f32,
+    out: &mut Vec<Draw>,
+) -> f32 {
+    let (Some(case), Some(disc), true) = (chrome.face, chrome.behind[0], has_disc(chrome.cart))
+    else {
+        return alpha;
+    };
+    let [x, y, cw, _] = at;
+    let (bw, bh) = cart_box(chrome.cart.platform);
+    let scale = chrome.scale.clamp(0.0, 1.0);
+    let (w0, h0) = (bw as f32 * scale, bh as f32 * scale);
+    let (x0, y0) = (chrome.rest, foot_y(bh as f32) - h0);
+    let (open, travel) = opening(k);
+    let case_alpha = alpha * (1.0 - travel);
+    let l = look(RetroShell::Ps1(Ps1Case::Us));
+    let (lx, ly, lw, lh) = l.label;
+    let (cx, cy) = (
+        x0 + (lx as f32 + lw as f32 / 2.0) / l.w as f32 * w0,
+        y0 + (ly as f32 + lh as f32 / 2.0) / l.h as f32 * h0,
+    );
+    let d0 = DISC_IN_TRAY * h0;
+    let from = [cx - d0 / 2.0, cy - d0 / 2.0, d0];
+    let to = [x, y, cw];
+    let [dx, dy, d] = [0, 1, 2].map(|i| from[i] + (to[i] - from[i]) * travel);
+    if case_alpha > 0.0 && open > 0.0 {
+        let c = JEWEL_TRAY_BLACK.colour.map(|v| v as f32 / 255.0);
+        out.push(Draw::Rect {
+            x: x0,
+            y: y0,
+            w: w0,
+            h: h0,
+            colour: [c[0], c[1], c[2], case_alpha * open],
+        });
+    }
+    if open > 0.0 {
+        out.push(Draw::Tex {
+            x: dx,
+            y: dy,
+            w: d,
+            h: d,
+            tex: disc,
+            alpha,
+        });
+    }
+    if case_alpha > 0.0 && open < 1.0 {
+        out.push(Draw::Tex {
+            x: x0,
+            y: y0,
+            w: w0 * (1.0 - open),
+            h: h0,
+            tex: case,
+            alpha: case_alpha,
+        });
+    }
+    0.0
+}
