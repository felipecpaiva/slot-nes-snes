+fn insert(cart: &Cart, seat: f32) -> Vec<Draw> {
+    let mut out = Vec::new();
+    SlotChrome {
+        cart,
+        face: Some(TexId::from_raw(1)),
+        rest: (OUT_W - cart_box(cart.platform).0) as f32 / 2.0,
+        scale: 1.0,
+        seat,
+        alert: None,
+        dim: 0.0,
+        screen: 0.0,
+        game: false,
+        over: true,
+        behind: [Some(TexId::from_raw(2)), None],
+        slot: None,
+        canvas: Canvas::FRAMED,
+    }
+    .draw(&mut out);
+    out
+}
+
+fn drawn(out: &[Draw], id: usize) -> Vec<(f32, f32, f32, f32, f32)> {
+    out.iter()
+        .filter_map(|d| match *d {
+            Draw::Tex {
+                x,
+                y,
+                w,
+                h,
+                tex,
+                alpha,
+            } if tex == TexId::from_raw(id) && alpha > 0.0 => Some((x, y, w, h, alpha)),
+            _ => None,
+        })
+        .collect()
+}
