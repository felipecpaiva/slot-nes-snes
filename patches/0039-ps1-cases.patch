+#[test]
+fn ejecting_brings_the_disc_back_and_shuts_the_case() {
+    let cart = disc("Eject (USA)", "e.chd".into(), None);
+    for seat in [0.0, 0.1, 0.3, 0.6, 1.0] {
+        assert_eq!(insert(&cart, seat), insert(&cart, seat), "seat {seat}");
+    }
+    let back = insert(&cart, 0.0);
+    assert_eq!(drawn(&back, 1)[0].2, cart_box(Platform::Ps1).0 as f32);
+}
