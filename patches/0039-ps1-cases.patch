+    let face = disc_face_with(&cart, Some(art));
+    let c = DISC_PX / 2;
+    assert_eq!((face.w, face.h), (DISC_PX, DISC_PX));
+    assert_eq!(px(&face.rgba, DISC_PX, c, c)[3], 0, "the centre hole");
+    assert_eq!(px(&face.rgba, DISC_PX, 0, 0)[3], 0, "outside the disc");
+    assert_eq!(
+        px(&face.rgba, DISC_PX, c, c - 120),
+        [0, 0, 255, 255],
+        "the label scan"
+    );
+    let hub = px(&face.rgba, DISC_PX, c, c - 35);
+    assert!(
+        hub[3] > 0 && hub[3] < 255 && hub[2] < 255,
+        "the clear hub {hub:?}"
+    );
+    assert!(on_print(c, c - 120) && !on_print(c, c - 35));
