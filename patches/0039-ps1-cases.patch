+#[test]
+fn on_insert_the_case_opens_and_the_disc_goes_into_the_slot() {
+    let cart = disc("Insert (USA)", "i.chd".into(), None);
+    let (cw, _) = cart_box(Platform::Ps1);
+    let shut = insert(&cart, 0.0);
+    assert_eq!(drawn(&shut, 1).len(), 1, "the closed case");
+    assert_eq!(drawn(&shut, 1)[0].2, cw as f32, "the lid is shut");
+    assert!(
+        drawn(&shut, 2).is_empty(),
+        "the disc is hidden in the shut case"
+    );
+    let half = insert(&cart, 0.12);
+    let lid = drawn(&half, 1);
+    assert_eq!(lid.len(), 1);
+    assert!(
+        lid[0].2 < cw as f32 && lid[0].2 > 0.0,
+        "the lid swings open"
+    );
+    assert_eq!(drawn(&half, 2).len(), 1, "the disc shows in the tray");
+    let seated = insert(&cart, 1.0);
+    assert!(drawn(&seated, 1).is_empty(), "the case is gone");
+    let d = drawn(&seated, 2);
+    assert_eq!(d.len(), 1);
+    assert_eq!(d[0].2, d[0].3, "the disc stays round");
+    assert_eq!(
+        d[0].2,
+        seated_box(Platform::Ps1).0 as f32,
+        "the disc is seated"
+    );
+}
