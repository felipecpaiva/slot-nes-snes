+#[test]
+fn every_case_shares_the_jewel_case_box_at_its_cited_aspect() {
+    let (cw, ch) = cart_box(Platform::Ps1);
+    let (sw, sh) = seated_box(Platform::Ps1);
+    assert_eq!((cw, ch, sw, sh), (360, 317, 240, 211));
+    assert!((sw as f32 / sh as f32 - 142.0 / 125.0).abs() < 0.01);
+    for case in CASES {
+        let face = retro_cart_face(
+            &disc("A (USA)", "a.chd".into(), None),
+            RetroShell::Ps1(case),
+        );
+        assert_eq!((face.w, face.h), (cw, ch), "{case:?}");
+    }
+}
