+#[test]
+fn the_cover_well_is_square_and_the_double_well_sits_on_its_front_case() {
+    let (cw, ch) = cart_box(Platform::Ps1);
+    let well = |case| {
+        let (x, y, w, h) = retro_label_rect(RetroShell::Ps1(case));
+        (x * cw as f32, y * ch as f32, w * cw as f32, h * ch as f32)
+    };
+    for case in CASES {
+        let (_, _, w, h) = well(case);
+        assert!((w / h - 1.0).abs() < 0.01, "{case:?} well {w}x{h}");
+    }
+    let (sx, _, sw, _) = well(Ps1Case::Us);
+    let (dx, dy, dw, dh) = well(Ps1Case::Double);
+    assert!(
+        dw < sw && dx < sx,
+        "the double case front is smaller and to the left"
+    );
+    assert!(
+        dy > 12.0 && dy + dh <= ch as f32,
+        "the back case shows above the front"
+    );
+    let mask = slot_ui::retro_silhouette(RetroShell::Ps1(Ps1Case::Double), cw, ch);
+    assert_eq!(
+        mask[(5 * cw + cw - 6) as usize],
+        255,
+        "back case top right corner"
+    );
+    assert_eq!(
+        mask[((ch - 3) * cw + cw - 3) as usize],
+        0,
+        "no case below the back one"
+    );
+    assert_eq!(
+        mask[(3 * cw + 3) as usize],
+        0,
+        "no case above the front one"
+    );
+}
