+    let (x, y, _, _) = retro_label_rect(RetroShell::Ps1(Ps1Case::Us));
+    let (lx, ly) = (
+        (x * face.w as f32) as u32 + 2,
+        (y * face.h as f32) as u32 + 2,
+    );
+    assert_eq!(
+        px(&face.rgba, face.w, lx, ly)[..3],
+        label_colour("Plain"),
+        "the well is the title ground"
+    );
+    let green = face
+        .rgba
+        .chunks_exact(4)
+        .filter(|p| p[..3] == [0, 255, 0])
+        .count();
+    assert_eq!(green, 0, "the disc scan never faces the case");
+}
