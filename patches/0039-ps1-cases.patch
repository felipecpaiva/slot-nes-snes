+#[test]
+fn the_disc_is_round_with_a_hole_and_prints_only_outside_the_hub() {
+    let cart = disc("Round (USA)", "r.chd".into(), None);
+    let art: Vec<u8> = (0..DISC_PX * DISC_PX)
+        .flat_map(|_| [0, 0, 255, 255])
