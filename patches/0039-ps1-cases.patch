diff --git a/crates/slot-ui/src/ps1_case.rs b/crates/slot-ui/src/ps1_case.rs
new file mode 100644
index 0000000..98fc5b6
--- /dev/null
+++ b/crates/slot-ui/src/ps1_case.rs
@@ -0,0 +1,177 @@
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+
+use slot_store::ps1::{playlist, serial, serial_region, DiscRegion};
+use slot_store::{Cart, Platform};
+
+use crate::art::{cover_rgba, decode_png_bytes};
+use crate::cart::{label_colour, label_tags, label_text, CartFace};
+use crate::retro_cart::Ps1Case;
+use crate::text;
+
+pub const DISC_PX: u32 = 360;
+pub const DISC_HOLE_R: f32 = 22.5;
+pub const DISC_HUB_R: f32 = 49.5;
+pub const DISC_PRINT_R: f32 = 51.0;
+pub const DISC_EDGE_R: f32 = 177.0;
+pub const OBI_PAPER: [u8; 3] = [0xec, 0xe9, 0xe2];
+const NEUTRAL: u8 = 128;
+const TITLE_BOX: (u32, u32, u32, u32) = (80, 52, 200, 70);
+
+pub fn has_disc(cart: &Cart) -> bool {
+    cart.platform == Platform::Ps1
+}
+
+pub(crate) fn case_of(cart: &Cart) -> Ps1Case {
+    static CASES: OnceLock<Mutex<HashMap<PathBuf, Ps1Case>>> = OnceLock::new();
+    *CASES
+        .get_or_init(Mutex::default)
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .entry(cart.rom.clone())
+        .or_insert_with(|| read_case(&cart.rom, &cart.stem))
+}
+
+pub fn read_case(rom: &Path, stem: &str) -> Ps1Case {
+    let is_m3u = rom
+        .extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| e.eq_ignore_ascii_case("m3u"));
+    if is_m3u && playlist(rom).is_some_and(|discs| discs.len() > 1) {
+        return Ps1Case::Double;
+    }
+    match tag_region(stem).or_else(|| serial(rom).as_deref().and_then(serial_region)) {
+        Some(DiscRegion::Us) | None => Ps1Case::Us,
+        Some(DiscRegion::Eu) => Ps1Case::Eu,
+        Some(DiscRegion::Jp) => Ps1Case::Jp,
+    }
+}
+
+pub fn tag_region(stem: &str) -> Option<DiscRegion> {
+    label_tags(stem)
+        .iter()
+        .flat_map(|t| t.split(',').map(str::trim).collect::<Vec<_>>())
+        .find_map(|t| match t {
+            "USA" | "US" | "U" | "Canada" => Some(DiscRegion::Us),
+            "Europe" | "EU" | "E" | "UK" | "Germany" | "France" | "Spain" | "Italy"
+            | "Netherlands" | "Sweden" | "Australia" | "PAL" => Some(DiscRegion::Eu),
+            "Japan" | "JP" | "J" | "NTSC-J" => Some(DiscRegion::Jp),
+            _ => None,
+        })
+}
+
+pub fn disc_art_path(cart: &Cart) -> Option<PathBuf> {
+    let file = format!("{}.png", cart.stem);
+    match cart.label.as_deref() {
+        Some(label) => Some(label.parent()?.join("disc").join(file)),
+        None => Some(
+            cart.rom
+                .ancestors()
+                .find(|a| a.ends_with("Games") || a.ends_with("Config"))?
+                .parent()?
+                .join("Labels")
+                .join(Platform::Ps1.dir_name())
+                .join("disc")
+                .join(file),
+        ),
+    }
+}
+
+pub(crate) fn disc_neutral() -> &'static [u8] {
+    static GREY: OnceLock<Vec<u8>> = OnceLock::new();
+    GREY.get_or_init(|| {
+        match decode_png_bytes(include_bytes!("../assets/retro/disc_neutral.png")) {
+            Some((rgba, w, h)) if (w, h) == (DISC_PX, DISC_PX) => rgba,
+            _ => {
+                eprintln!("slot: cart art: disc neutral is not a {DISC_PX}x{DISC_PX} png");
+                vec![0; (DISC_PX * DISC_PX * 4) as usize]
+            }
+        }
+    })
+}
+
+pub fn disc_face(cart: &Cart) -> CartFace {
+    let art = disc_art_path(cart)
+        .and_then(|p| std::fs::read(p).ok())
+        .and_then(|bytes| decode_png_bytes(&bytes))
+        .and_then(|(src, sw, sh)| cover_rgba(&src, sw, sh, DISC_PX, DISC_PX));
+    disc_face_with(cart, art)
+}
+
+pub fn disc_face_with(cart: &Cart, art: Option<Vec<u8>>) -> CartFace {
+    let title = label_text(cart);
+    let ground = label_colour(&title);
+    let mut rgba = disc_neutral().to_vec();
+    let ink = text_layer(&title, ink_for(ground));
+    for (i, px) in rgba.chunks_exact_mut(4).enumerate() {
+        if !on_print(i as u32 % DISC_PX, i as u32 / DISC_PX) || px[3] == 0 {
+            continue;
+        }
+        let plain = [0, 1, 2].map(|c| overlay(px[c], ground[c]));
+        let top = match &art {
+            Some(art) => {
+                let a = art.get(i * 4 + 3).map_or(0, |a| *a as u32);
+                [0, 1, 2].map(|c| {
+                    let s = art.get(i * 4 + c).map_or(0, |v| *v as u32);
+                    ((s * a + plain[c] as u32 * (255 - a) + 127) / 255) as u8
+                })
+            }
+            None => {
+                let a = ink.get(i).map_or(0, |a| a.1 as u32);
+                let colour = ink.get(i).map_or([0; 3], |a| a.0);
+                [0, 1, 2].map(|c| {
+                    ((colour[c] as u32 * a + plain[c] as u32 * (255 - a) + 127) / 255) as u8
+                })
+            }
+        };
+        px[..3].copy_from_slice(&top);
+    }
+    CartFace {
+        rgba,
+        w: DISC_PX,
+        h: DISC_PX,
+    }
+}
+
+pub fn on_print(x: u32, y: u32) -> bool {
+    let c = DISC_PX as f32 / 2.0;
+    let (dx, dy) = (x as f32 + 0.5 - c, y as f32 + 0.5 - c);
+    let r = (dx * dx + dy * dy).sqrt();
+    (DISC_PRINT_R..DISC_EDGE_R).contains(&r)
+}
+
+fn text_layer(title: &str, ink: [u8; 3]) -> Vec<([u8; 3], u8)> {
+    let mut out = vec![([0; 3], 0); (DISC_PX * DISC_PX) as usize];
+    let Some(font) = text::label_font() else {
+        return out;
+    };
+    let (bx, by, bw, bh) = TITLE_BOX;
+    let layout = text::fit_box(font, title, bw as f32, bh as f32, 3, 24.0, 9.0);
+    for (i, a) in text::coverage(bw, bh, &layout).into_iter().enumerate() {
+        let (x, y) = (bx + i as u32 % bw, by + i as u32 / bw);
+        if let Some(px) = out.get_mut((y * DISC_PX + x) as usize) {
+            *px = (ink, a);
+        }
+    }
+    out
+}
+
+fn ink_for(bg: [u8; 3]) -> [u8; 3] {
+    let luma = 0.2126 * bg[0] as f32 + 0.7152 * bg[1] as f32 + 0.0722 * bg[2] as f32;
+    if luma > 140.0 {
+        [0x1a, 0x18, 0x16]
+    } else {
+        [0xf4, 0xf1, 0xea]
+    }
+}
+
+fn overlay(base: u8, colour: u8) -> u8 {
+    let (base, colour) = (i32::from(base), i32::from(colour));
+    let out = if base >= i32::from(NEUTRAL) {
+        colour + ((255 - colour) * (base - i32::from(NEUTRAL)) + 63) / 127
+    } else {
+        colour - (colour * (i32::from(NEUTRAL) - base) + 64) / i32::from(NEUTRAL)
+    };
+    out.clamp(0, 255) as u8
+}
