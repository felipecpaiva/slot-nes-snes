diff --git a/crates/slot-store/src/sega.rs b/crates/slot-store/src/sega.rs
index f4d22a0..266a612 100644
--- a/crates/slot-store/src/sega.rs
+++ b/crates/slot-store/src/sega.rs
@@ -2,6 +2,8 @@ use std::fs::File;
 use std::io::{Read, Seek, SeekFrom};
 use std::path::Path;
 
+use crate::Outline;
+
 const TMR_SEGA: &[u8; 8] = b"TMR SEGA";
 const TMR_PROBES: [u64; 3] = [0x7ff0, 0x3ff0, 0x1ff0];
 const TMR_LEN: usize = 16;
@@ -108,3 +110,24 @@ pub fn md_regions_of(head: &[u8; MD_HEADER_LEN]) -> Option<MdRegions> {
     };
     (regions != MdRegions::default()).then_some(regions)
 }
+
+const SEGA_CARD_MAX: u64 = 16 * 1024;
+
+pub fn sms_outline(rom: &Path) -> Outline {
+    match std::fs::metadata(rom) {
+        Ok(m) if m.len() < SEGA_CARD_MAX => Outline::SegaCard,
+        _ => Outline::Sms,
+    }
+}
+
+pub fn md_outline(rom: &Path) -> Outline {
+    md_regions(rom).map_or(Outline::Genesis, regions_outline)
+}
+
+pub fn regions_outline(r: MdRegions) -> Outline {
+    if r.japan && !r.usa && !r.europe {
+        Outline::MegaDrive
+    } else {
+        Outline::Genesis
+    }
+}
diff --git a/crates/slot-store/tests/sega_header.rs b/crates/slot-store/tests/sega_header.rs
index d268231..820f127 100644
--- a/crates/slot-store/tests/sega_header.rs
+++ b/crates/slot-store/tests/sega_header.rs
@@ -52,3 +52,54 @@ fn a_rom_shorter_than_the_header_or_without_one_gives_no_region() {
     let _ = std::fs::remove_file(&p);
     assert_eq!(sms_region(&PathBuf::from("/nonexistent/x.gg")), None);
 }
+
+#[test]
+fn a_master_system_rom_under_16_kb_is_a_sega_card_and_anything_bigger_a_cartridge() {
+    use slot_store::sega::sms_outline;
+    use slot_store::Outline;
+    let dir = std::env::temp_dir();
+    let card = dir.join(format!("slot-sega-card-{}.sms", std::process::id()));
+    let cart = dir.join(format!("slot-sega-cart-{}.sms", std::process::id()));
+    std::fs::write(&card, vec![0u8; 0x3fff]).expect("write card");
+    std::fs::write(&cart, vec![0u8; 0x4000]).expect("write cart");
+    assert_eq!(sms_outline(&card), Outline::SegaCard);
+    assert_eq!(sms_outline(&cart), Outline::Sms);
+    assert_eq!(
+        sms_outline(&PathBuf::from("/nonexistent/x.sms")),
+        Outline::Sms
+    );
+    let _ = std::fs::remove_file(card);
+    let _ = std::fs::remove_file(cart);
+}
+
+#[test]
+fn a_japan_only_mega_drive_header_draws_the_japanese_shell_and_the_rest_the_western_one() {
+    use slot_store::sega::{md_outline, regions_outline, MdRegions};
+    use slot_store::Outline;
+    let r = |japan, usa, europe| MdRegions { japan, usa, europe };
+    assert_eq!(regions_outline(r(true, false, false)), Outline::MegaDrive);
+    assert_eq!(regions_outline(r(true, true, true)), Outline::Genesis);
+    assert_eq!(regions_outline(r(false, false, true)), Outline::Genesis);
+    assert_eq!(regions_outline(r(false, true, false)), Outline::Genesis);
+    let p = std::env::temp_dir().join(format!("slot-md-noheader-{}.md", std::process::id()));
+    std::fs::write(&p, vec![0xffu8; 0x400]).expect("write rom");
+    assert_eq!(md_outline(&p), Outline::Genesis);
+    let _ = std::fs::remove_file(p);
+}
+
+#[test]
+fn the_sega_outline_words_round_trip_through_cart_shell_lines() {
+    use slot_store::{Outline, ShellChoice};
+    for (word, outline) in [
+        ("gg", Outline::Gg),
+        ("sms", Outline::Sms),
+        ("segacard", Outline::SegaCard),
+        ("megadrive", Outline::MegaDrive),
+        ("genesis", Outline::Genesis),
+    ] {
+        let line = format!("{word} 242129 solid");
+        let choice = ShellChoice::parse(&line).expect("parse");
+        assert_eq!(choice.outline, outline);
+        assert_eq!(choice.to_value(), line);
+    }
+}
