diff --git a/crates/slot-ui/tests/sega_shell.rs b/crates/slot-ui/tests/sega_shell.rs
new file mode 100644
index 0000000..0d99f8e
--- /dev/null
+++ b/crates/slot-ui/tests/sega_shell.rs
@@ -0,0 +1,139 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    cart_box, retro_shell_of, seated_box, shell_for, RetroShell, SegaShell, GENESIS_BLACK,
+    GG_BLACK, MEGA_DRIVE_BLACK, SEGA_CARD_BLACK, SMS_BLACK,
+};
+
+fn cart(platform: Platform, rom: PathBuf, word: Option<Outline>) -> Cart {
+    Cart {
+        platform,
+        stem: "Sonic (USA)".into(),
+        rom,
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: word.map(|outline| ShellChoice {
+            outline,
+            colour: [0x10, 0x20, 0x30],
+            finish: ShellFinish::Solid,
+        }),
+    }
+}
+
+fn rom(name: &str, bytes: Vec<u8>) -> PathBuf {
+    let p = std::env::temp_dir().join(format!("slot-sega-shell-{}-{name}", std::process::id()));
+    std::fs::write(&p, bytes).expect("write rom");
+    p
+}
+
+fn md(name: &str, country: &[u8]) -> PathBuf {
+    let mut bytes = vec![0u8; 0x400];
+    bytes[0x100..0x104].copy_from_slice(b"SEGA");
+    bytes[0x1f0..0x1f0 + country.len()].copy_from_slice(country);
+    rom(name, bytes)
+}
+
+fn sega(kind: SegaShell) -> Option<RetroShell> {
+    Some(RetroShell::Sega(kind))
+}
+
+#[test]
+fn every_game_gear_cart_takes_the_one_game_gear_shell() {
+    let p = rom("gg.gg", vec![0u8; 0x8000]);
+    assert_eq!(
+        retro_shell_of(&cart(Platform::Gg, p.clone(), None)),
+        sega(SegaShell::Gg)
+    );
+    assert_eq!(
+        retro_shell_of(&cart(Platform::Gg, p, Some(Outline::Genesis))),
+        sega(SegaShell::Gg)
+    );
+}
