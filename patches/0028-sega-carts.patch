+#[test]
+fn a_small_master_system_rom_is_drawn_as_a_sega_card_and_a_word_overrides_it() {
+    let small = rom("card.sms", vec![0u8; 0x2000]);
+    let big = rom("cart.sms", vec![0u8; 0x20000]);
+    assert_eq!(
+        retro_shell_of(&cart(Platform::Sms, small.clone(), None)),
+        sega(SegaShell::SegaCard)
+    );
+    assert_eq!(
+        retro_shell_of(&cart(Platform::Sms, big.clone(), None)),
+        sega(SegaShell::Sms)
+    );
+    assert_eq!(
+        retro_shell_of(&cart(Platform::Sms, small, Some(Outline::Sms))),
+        sega(SegaShell::Sms)
+    );
+    assert_eq!(
+        retro_shell_of(&cart(Platform::Sms, big, Some(Outline::SegaCard))),
+        sega(SegaShell::SegaCard)
+    );
+}
