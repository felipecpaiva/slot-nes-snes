+#[test]
+fn the_sega_boxes_are_their_seated_boxes_scaled_to_the_shelf() {
+    for (platform, seated) in [
+        (Platform::Gg, (240, 234)),
+        (Platform::Sms, (240, 145)),
+        (Platform::Md, (240, 164)),
+    ] {
+        assert_eq!(seated_box(platform), seated, "{platform:?}");
+        let (cw, ch) = cart_box(platform);
+        assert_eq!(ch, (cw * seated.1 + 120) / 240, "{platform:?}");
+    }
+}
