+#[test]
+fn each_sega_shell_defaults_to_its_sampled_black() {
+    let small = rom("black-card.sms", vec![0u8; 0x2000]);
+    let big = rom("black-cart.sms", vec![0u8; 0x20000]);
+    for (c, want) in [
+        (
+            cart(Platform::Gg, rom("black.gg", vec![0u8; 0x8000]), None),
+            GG_BLACK,
+        ),
+        (cart(Platform::Sms, big, None), SMS_BLACK),
+        (cart(Platform::Sms, small, None), SEGA_CARD_BLACK),
+        (
+            cart(Platform::Md, md("black-jp.md", b"J"), None),
+            MEGA_DRIVE_BLACK,
+        ),
+        (
+            cart(Platform::Md, md("black-us.md", b"U"), None),
+            GENESIS_BLACK,
+        ),
+    ] {
+        assert_eq!(shell_for(&c), want, "{:?}", c.rom);
+    }
+}
