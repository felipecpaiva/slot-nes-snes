+#[test]
+fn a_mega_drive_cart_takes_its_shell_from_the_header_region() {
+    for (country, want) in [
+        (&b"J  "[..], SegaShell::MegaDrive),
+        (b"1", SegaShell::MegaDrive),
+        (b"JUE", SegaShell::Genesis),
+        (b"U", SegaShell::Genesis),
+        (b"E", SegaShell::Genesis),
+        (b"   ", SegaShell::Genesis),
+    ] {
+        let p = md(
+            &format!("{}.md", String::from_utf8_lossy(country).trim()),
+            country,
+        );
+        assert_eq!(
+            retro_shell_of(&cart(Platform::Md, p, None)),
+            sega(want),
+            "{country:?}"
+        );
+    }
+    let p = md("word.md", b"U");
+    assert_eq!(
+        retro_shell_of(&cart(Platform::Md, p, Some(Outline::MegaDrive))),
+        sega(SegaShell::MegaDrive)
+    );
+}
