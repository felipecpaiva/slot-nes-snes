+#[test]
+fn serialize_and_the_rewind_writer_fit_the_two_frame_cadence_on_every_new_core() {
+    let _g = core_lock();
+    let cadence = PRESENT * CADENCE;
+    println!(
+        "budget: serialize p95 under {:.2} ms, writer worst case under {:.2} ms",
+        ms(PRESENT),
+        ms(cadence)
+    );
+    for which in [
+        Core::Snes9x,
+        Core::Snes9x2005Plus,
+        Core::Nestopia,
+        Core::Fceumm,
+    ] {
+        let Some(dylib) = dylib_for(which) else {
+            continue;
+        };
+        let root = common::tmp_root_with_real_carts(&[]);
+        let mut core = open_core_for(root.path(), which, "auto", false, &[dylib]);
+        core.load(&rom_for(which)).expect("load");
+        let (mut saves, mut states) = (Vec::new(), Vec::new());
+        for _ in 0..FRAMES {
+            core.run_frame(ButtonMask::default());
+            let began = Instant::now();
+            let state = core.serialize().expect("serialize");
+            saves.push(began.elapsed());
+            states.push(state);
+        }
+        let size = states[0].len();
+        let mut real = Rewind::new(REWIND_BYTES);
+        let mut writes = Vec::new();
+        for state in &states {
+            let began = Instant::now();
+            real.push(state);
+            writes.push(began.elapsed());
+        }
+        let mut worst = Rewind::new(REWIND_BYTES);
+        let mut noisy = Vec::new();
+        let mut x = 0x2545_f491u32;
+        for _ in 0..64 {
+            let state: Vec<u8> = (0..size)
+                .map(|_| {
+                    x = x.wrapping_mul(1664525).wrapping_add(1013904223);
+                    (x >> 24) as u8
+                })
+                .collect();
+            let began = Instant::now();
+            worst.push(&state);
+            noisy.push(began.elapsed());
+        }
+        let (save, write, noise) = (spread(saves), spread(writes), spread(noisy));
+        println!(
+            "{}: state {size} bytes, serialize median {:.3} p95 {:.3} max {:.3} ms, writer median {:.3} p95 {:.3} max {:.3} ms, worst case writer median {:.3} p95 {:.3} ms, ring {}% after {FRAMES} states",
+            which.as_str(), save.0, save.1, save.2, write.0, write.1, write.2, noise.0, noise.1, real.fill()
+        );
+        assert!(
+            save.1 < ms(PRESENT),
+            "{}: serialize p95 {:.2} ms",
+            which.as_str(),
+            save.1
+        );
+        assert!(
+            noise.1 < ms(cadence),
+            "{}: writer worst case p95 {:.2} ms",
+            which.as_str(),
+            noise.1
+        );
+    }
+}
