@@ -0,0 +1,278 @@
+mod common;
+mod core_common;
+mod nes_common;
+mod snes_common;
+
+use std::collections::hash_map::DefaultHasher;
+use std::hash::{Hash, Hasher};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use core_common::require_core;
+use nes_common::{fceumm, nes_rom};
+use slot::audio::{AudioSink, StubSink};
+use slot::core::open_core_for;
+use slot::emu::{CoreState, EmuHandle, Speed};
+use slot::rewind::{Rewind, REWIND_BYTES};
+use slot_retro::{AvInfo, ButtonMask, CoreError, Link, RetroCore, Rumble};
+use slot_store::Core;
+use snes_common::{snes_rom, Map};
+
+const PRESENT: Duration = Duration::from_nanos(16_666_667);
+const CADENCE: u32 = 2;
+const FRAMES: u64 = 300;
+
+#[derive(Default)]
+struct Log {
+    ran: AtomicU64,
+    pushed: Mutex<Vec<u64>>,
+    loaded: Mutex<Vec<u64>>,
+}
+
+struct Tapped {
+    inner: Box<dyn RetroCore>,
+    log: Arc<Log>,
+}
+
+fn fingerprint(bytes: &[u8]) -> u64 {
+    let mut h = DefaultHasher::new();
+    bytes.hash(&mut h);
+    h.finish()
+}
+
+impl RetroCore for Tapped {
+    fn load(&mut self, rom: &Path) -> Result<(), CoreError> {
+        self.inner.load(rom)
+    }
+    fn run_frame(&mut self, input: ButtonMask) {
+        self.log.ran.fetch_add(1, Ordering::Relaxed);
+        self.inner.run_frame(input);
+    }
+    fn set_option(&mut self, key: &str, value: &str) {
+        self.inner.set_option(key, value);
+    }
+    fn set_frame_skip(&mut self, skip: bool) {
+        self.inner.set_frame_skip(skip);
+    }
+    fn video_xrgb8888(&self) -> &[u8] {
+        self.inner.video_xrgb8888()
+    }
+    fn take_audio(&mut self) -> Vec<i16> {
+        self.inner.take_audio()
+    }
+    fn serialize(&mut self) -> Result<Vec<u8>, CoreError> {
+        let state = self.inner.serialize()?;
+        self.log
+            .pushed
+            .lock()
+            .expect("pushed")
+            .push(fingerprint(&state));
+        Ok(state)
+    }
+    fn unserialize(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.log
+            .loaded
+            .lock()
+            .expect("loaded")
+            .push(fingerprint(data));
+        self.inner.unserialize(data)
+    }
+    fn save_ram(&self) -> Option<Vec<u8>> {
+        self.inner.save_ram()
+    }
+    fn load_save_ram(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.load_save_ram(data)
+    }
+    fn av_info(&self) -> AvInfo {
+        self.inner.av_info()
+    }
+    fn rumble(&self) -> Rumble {
+        self.inner.rumble()
+    }
+    fn net(&self) -> Link {
+        self.inner.net()
+    }
+    fn canvas(&self) -> (u32, u32) {
+        self.inner.canvas()
+    }
+    fn take_av_change(&mut self) -> Option<AvInfo> {
+        self.inner.take_av_change()
+    }
+}
+
+fn dylib_for(which: Core) -> Option<PathBuf> {
+    match which {
+        Core::Fceumm => fceumm(),
+        _ => require_core(which.as_str()),
+    }
+}
+
+fn rom_for(which: Core) -> PathBuf {
+    match which {
+        Core::Fceumm | Core::Nestopia => nes_rom("snes_rewind.nes", false),
+        Core::Snes9x2005Plus => snes_rom("snes_rewind.sfc", Map::Hi, false, 0),
+        _ => snes_rom("snes_rewind.sfc", Map::Lo, false, 0),
+    }
+}
+
+fn played(which: Core, dylib: PathBuf, frames: u64) -> (EmuHandle, Arc<Log>) {
+    let root = common::tmp_root_with_real_carts(&[]);
+    let log = Arc::new(Log::default());
+    let core = Tapped {
+        inner: open_core_for(root.path(), which, "auto", false, &[dylib]),
+        log: log.clone(),
+    };
+    let mut sink = StubSink::draining();
+    sink.open(32_768).expect("the stub refused to open");
+    let emu = EmuHandle::spawn(Box::new(core), rom_for(which), sink.ring(), None, None);
+    emu.set_speed(Speed::Normal);
+    let deadline = Instant::now() + Duration::from_secs(20);
+    while log.ran.load(Ordering::Relaxed) < frames {
+        assert!(
+            Instant::now() < deadline,
+            "the core never ran {frames} frames"
+        );
+        assert_ne!(emu.state(), CoreState::Failed, "{} failed", which.as_str());
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    (emu, log)
+}
+
+fn ms(d: Duration) -> f64 {
+    d.as_secs_f64() * 1000.0
+}
+
+fn spread(mut v: Vec<Duration>) -> (f64, f64, f64) {
+    v.sort();
+    (
+        ms(v[v.len() / 2]),
+        ms(v[(v.len() - 1) * 95 / 100]),
+        ms(v[v.len() - 1]),
+    )
+}
