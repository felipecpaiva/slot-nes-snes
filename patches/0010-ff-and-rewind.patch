+#[test]
+fn rewind_fill_rises_while_snes9x_plays_300_frames() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("snes9x") else {
+        return;
+    };
+    let (emu, log) = played(Core::Snes9x, dylib, FRAMES);
+    assert!(
+        emu.rewind_fill() > 0,
+        "300 frames left the rewind ring at 0%"
+    );
+    assert!(
+        log.pushed.lock().expect("pushed").len() as u64 >= FRAMES / u64::from(CADENCE) - 2,
+        "snes9x was serialized less than every {CADENCE} frames"
+    );
+}
+
+#[test]
+fn l2_walks_snes9x_back_through_states_it_serialized_earlier() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("snes9x") else {
+        return;
+    };
+    let (emu, log) = played(Core::Snes9x, dylib, FRAMES);
+    let pushed = log.pushed.lock().expect("pushed").clone();
+    emu.set_rewinding(true);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while log.loaded.lock().expect("loaded").len() < 5 {
+        assert!(Instant::now() < deadline, "L2 never restored a state");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    emu.set_rewinding(false);
+    let loaded = log.loaded.lock().expect("loaded").clone();
+    let at: Vec<usize> = loaded
+        .iter()
+        .map(|h| {
+            pushed
+                .iter()
+                .rposition(|p| p == h)
+                .expect("a state snes9x never serialized")
+        })
+        .collect();
+    assert!(
+        at[0] < pushed.len(),
+        "the first restored state is newer than every serialized one"
+    );
+    assert!(
+        at.windows(2).all(|w| w[1] < w[0]),
+        "L2 did not walk back through older states: {at:?}"
+    );
+}
