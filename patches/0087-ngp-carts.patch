diff --git a/crates/slot-ui/tests/ngp_cart.rs b/crates/slot-ui/tests/ngp_cart.rs
new file mode 100644
index 0000000..6cd693a
--- /dev/null
+++ b/crates/slot-ui/tests/ngp_cart.rs
@@ -0,0 +1,117 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    cart_box, label_cover, retro_cart_face, retro_label_rect, retro_shell_of, seated_box,
+    shell_for, RetroShell, NGP_GREY,
+};
+
+const RED: [u8; 3] = [230, 30, 30];
+
+fn rom(name: &str, colour: u8) -> PathBuf {
+    let mut bytes = vec![0u8; 0x200];
+    bytes[..28].copy_from_slice(b"COPYRIGHT BY SNK CORPORATION");
+    bytes[0x23] = colour;
+    let p = std::env::temp_dir().join(format!("slot-ngp-cart-{}-{name}", std::process::id()));
+    std::fs::write(&p, bytes).expect("write rom");
+    p
+}
+
+fn cart(rom: PathBuf, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform: Platform::Ngp,
+        stem: "Sonic the Hedgehog Pocket Adventure (World)".into(),
+        rom,
+        label,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn art(name: &str, w: u32, h: u32) -> PathBuf {
+    let px: Vec<u8> = (0..w * h)
+        .flat_map(|_| [RED[0], RED[1], RED[2], 255])
+        .collect();
+    let p = std::env::temp_dir().join(format!("slot-ngp-art-{}-{name}.png", std::process::id()));
+    let mut e = png::Encoder::new(std::fs::File::create(&p).expect("create art"), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    p
+}
+
+fn near(p: &[u8], c: [u8; 3]) -> bool {
+    (0..3).all(|i| p[i].abs_diff(c[i]) < 16)
+}
+
+#[test]
+fn mono_and_color_carts_both_take_the_ngp_pak_in_the_dark_grey_shell() {
+    for (name, colour) in [("mono.ngp", 0x00), ("color.ngc", 0x10), ("color.ngp", 0x10)] {
+        let c = cart(rom(name, colour), None);
+        assert_eq!(retro_shell_of(&c), Some(RetroShell::Ngp), "{name}");
+        assert_eq!(shell_for(&c), NGP_GREY, "{name}");
+    }
+    assert_eq!(NGP_GREY.colour, [0x24, 0x25, 0x29]);
+}
+
+#[test]
+fn a_chosen_shell_colour_still_wins_over_the_ngp_grey() {
+    let mut c = cart(rom("chosen.ngc", 0x10), None);
+    c.shell = Some(ShellChoice {
+        outline: Outline::Auto,
+        colour: [0x10, 0x20, 0x30],
+        finish: ShellFinish::Solid,
+    });
+    assert_eq!(retro_shell_of(&c), Some(RetroShell::Ngp));
+    assert_eq!(shell_for(&c).colour, [0x10, 0x20, 0x30]);
+}
+
+#[test]
+fn the_ngp_pak_is_312_by_268_seated_at_240_by_206_with_a_wide_label() {
+    assert_eq!(cart_box(Platform::Ngp), (312, 268));
+    assert_eq!(seated_box(Platform::Ngp), (240, 206));
+    let (x, y, w, h) = retro_label_rect(RetroShell::Ngp);
+    let px = |f: f32, of: f32| (f * of).round() as u32;
+    assert_eq!(
+        (px(x, 312.0), px(y, 268.0), px(w, 312.0), px(h, 268.0)),
+        (36, 58, 246, 133)
+    );
+}
+
+#[test]
+fn the_ngp_pak_renders_at_the_shelf_size_without_a_label() {
+    let face = retro_cart_face(&cart(rom("bare.ngc", 0x10), None), RetroShell::Ngp);
+    assert_eq!((face.w, face.h), (312, 268));
+    let opaque = face.rgba.chunks_exact(4).filter(|p| p[3] > 200).count();
+    assert!(opaque > 312 * 268 * 9 / 10, "{opaque} opaque pixels");
+    let at = |x: u32, y: u32| &face.rgba[((y * 312 + x) * 4) as usize..][..4];
+    assert_eq!(
+        at(0, 267)[3],
+        0,
+        "the cap stands proud, so the body's corner is cut"
+    );
+    let body = at(60, 204);
+    assert_eq!(body[3], 255);
+    assert!(
+        near(body, [0x24, 0x25, 0x29]),
+        "the plastic is the NGP grey: {body:?}"
+    );
+}
+
+#[test]
+fn the_ngp_pak_renders_its_label_art_inside_the_well() {
+    let red = art("label", 492, 266);
+    let c = cart(rom("label.ngc", 0x10), Some(red.clone()));
+    let (_, _, lw, lh) = retro_label_rect(RetroShell::Ngp);
+    let (lw, lh) = ((lw * 312.0).round() as u32, (lh * 268.0).round() as u32);
+    assert!(label_cover(&c, &red, lw, lh).is_some());
+    let face = retro_cart_face(&c, RetroShell::Ngp);
+    let red_at = |x: u32, y: u32| near(&face.rgba[((y * 312 + x) * 4) as usize..], RED);
+    assert!(red_at(156, 124), "the middle of the well is the label");
+    assert!(!red_at(156, 240), "the foot below the seam is plastic");
+    assert!(!red_at(156, 10), "the cap is plastic");
+}
