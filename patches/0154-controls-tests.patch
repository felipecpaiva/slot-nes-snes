diff --git a/crates/slot/tests/arcade_controls.rs b/crates/slot/tests/arcade_controls.rs
new file mode 100644
index 0000000..43d3a80
--- /dev/null
+++ b/crates/slot/tests/arcade_controls.rs
@@ -0,0 +1,125 @@
+// Each arcade set's own inputs, as FBNeo declares them for that set, are rows on the In-Game page
+// named as the set names them, and every one reaches the core from a device button (ADR 0108).
+// The sets are the zero-filled ones of arcade_common: FBNeo declares a set's inputs on its first
+// frame whatever its ROMs hold. FBNeo's "Buttons ..." entries are its own combos of buttons the set
+// already has, and L3/R3 have no device button, so neither needs a row.
+mod arcade_common;
+mod common;
+mod core_common;
+
+use arcade_common::{fbneo, install, install_neogeo_bios, Set, DDTOD, FFIGHT, KNIGHTS, MSLUG, SF2};
+use common::core_lock;
+use slot::console_pad::{self, PadMode};
+use slot::input::{device_btn, Pad};
+use slot_input::Action;
+use slot_retro::{ButtonMask, LibretroCore, RetroCore};
+use slot_store::{console_factory, Platform};
+use slot_ui::QuickRow;
+
+fn declared(set: &Set, platform: Platform) -> Option<Vec<(u32, String)>> {
+    let dylib = fbneo()?;
+    let d = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(slot::root::saves_dir(d.path())).unwrap();
+    if platform == Platform::NeoGeo {
+        install_neogeo_bios(d.path());
+    }
+    let rom = install(d.path(), set);
+    let mut core = LibretroCore::open_with(
+        &dylib,
+        &slot::root::bios_dir(d.path()),
+        &slot::root::saves_dir(d.path()),
+    )
+    .expect("open FBNeo");
+    core.set_canvas(432, 288);
+    core.load(&rom).expect("FBNeo refused the set");
+    for _ in 0..2 {
+        core.run_frame(ButtonMask::default());
+    }
+    Some(core.pad_names())
+}
+
+fn needs_a_row(id: u32, name: &str) -> bool {
+    id < 14 && !name.starts_with("Buttons ")
+}
+
+fn reached(mode: PadMode, names: &[(u32, String)]) -> Vec<(QuickRow, u16)> {
+    let controls = console_factory(mode.platform);
+    let hidden = console_pad::hidden(mode, names);
+    QuickRow::IN_GAME
+        .into_iter()
+        .filter(|r| !hidden.contains(r))
+        .filter_map(|r| {
+            let binding = controls.game(r.game_button()?)?;
+            let mut pad = Pad::default();
+            pad.apply(Action::GbaDown(device_btn(binding.button)));
+            let mask = pad.mask_with(&controls, console_pad::triggers(mode, names));
+            Some((r, mode.delivered(mask).0))
+        })
+        .collect()
+}
+
+fn check(set: &Set, platform: Platform) {
+    let _g = core_lock();
+    let Some(names) = declared(set, platform) else {
+        return;
+    };
+    assert!(!names.is_empty(), "{}: FBNeo declared no inputs", set.name);
+    let mode = PadMode::plain(platform);
+    let rows = reached(mode, &names);
+    let labels = console_pad::labels(mode, &names);
+    for (id, name) in names.iter().filter(|(id, n)| needs_a_row(*id, n)) {
+        let Some((row, _)) = rows.iter().find(|(_, bits)| bits & (1 << id) != 0) else {
+            panic!(
+                "{}: \"{name}\" (id {id}) has no row that reaches it",
+                set.name
+            );
+        };
+        let label = labels
+            .iter()
+            .find(|(r, _)| r == row)
+            .map(|(_, l)| l.as_str());
+        assert_eq!(label, Some(name.as_str()), "{}: {row:?}", set.name);
+    }
+}
+
+#[test]
+fn knights_of_the_round_shows_attack_and_jump_and_both_reach_the_board() {
+    check(&KNIGHTS, Platform::Cps1);
+}
+
+#[test]
+fn final_fight_shows_its_three_buttons() {
+    check(&FFIGHT, Platform::Cps1);
+}
+
+#[test]
+fn street_fighter_ii_shows_three_punches_and_three_kicks() {
+    check(&SF2, Platform::Cps1);
+}
+
+#[test]
+fn tower_of_doom_shows_its_four_buttons() {
+    check(&DDTOD, Platform::Cps2);
+}
+
+#[test]
+fn metal_slug_shows_the_neo_geo_a_to_d() {
+    check(&MSLUG, Platform::NeoGeo);
+}
+
+#[test]
+fn a_set_that_uses_two_buttons_hides_the_rows_it_has_no_input_for() {
+    let _g = core_lock();
+    let Some(names) = declared(&KNIGHTS, Platform::Cps1) else {
+        return;
+    };
+    let hidden = console_pad::hidden(PadMode::plain(Platform::Cps1), &names);
+    for row in [
+        QuickRow::GameTurboA,
+        QuickRow::GameTurboB,
+        QuickRow::GameL,
+        QuickRow::GameR,
+    ] {
+        assert!(hidden.contains(&row), "{row:?} shows for knights");
+    }
+}
diff --git a/crates/slot/tests/console_controls.rs b/crates/slot/tests/console_controls.rs
new file mode 100644
index 0000000..f9c239b
--- /dev/null
+++ b/crates/slot/tests/console_controls.rs
@@ -0,0 +1,144 @@
+// The In-Game Controls page while a game of the newer systems plays: its rows carry the console's
+// own button names, X and Y are rows on systems that pass them to the game, PlayStation L2 and R2
+// are rows, and a change is saved for that system alone (ADR 0108).
+mod common;
+mod core_common;
+mod ps1_common;
+mod real_seat;
+mod snes_common;
+
+use std::time::Duration;
+
+use common::core_lock;
+use core_common::require_core;
+use slot::app::App;
+use slot::session::Session;
+use slot_input::{Action, Btn, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{read_controls, Binding, Controls, Device, GameButton, Platform};
+use slot_ui::QuickRow;
+use snes_common::{snes_rom, Map};
+
+fn press(a: &mut App, b: Btn) {
+    a.apply(Action::GbaDown(b));
+    a.apply(Action::GbaUp(b));
+}
+
+fn in_game_at(a: &mut App, row: QuickRow) {
+    a.apply(Action::QuickMenu);
+    let mut path = vec![row];
+    while let Some(parent) = path.last().and_then(|r| r.parent_in_game()) {
+        path.push(parent);
+    }
+    for (depth, step) in path.iter().rev().enumerate() {
+        if depth > 0 {
+            press(a, Btn::A);
+        }
+        let hidden = a.in_game_hidden();
+        for _ in 0..step.position(&hidden) {
+            press(a, Btn::Down);
+        }
+    }
+    assert_eq!(a.in_game_menu(), Some(row));
+}
+
+fn snes() -> Option<(tempfile::TempDir, Session)> {
+    let dylib = require_core("snes9x")?;
+    let rom = snes_rom("Pad", Map::Lo, false, 0);
+    let root = real_seat::rooted(Platform::Snes, "Pad", &rom, &dylib);
+    let session = real_seat::play(root.path(), true);
+    Some((root, session))
+}
+
+fn ps1() -> Option<(tempfile::TempDir, Session)> {
+    let dylib = ps1_common::pcsx_rearmed()?;
+    let discs = tempfile::tempdir().expect("tempdir");
+    let cue = ps1_common::disc(discs.path(), "Pad");
+    let root = real_seat::rooted(Platform::Ps1, "Pad", &cue, &dylib);
+    std::fs::copy(
+        discs.path().join("Pad.bin"),
+        root.path().join("Games/PS1/Pad.bin"),
+    )
+    .expect("copy bin");
+    let session = real_seat::play(root.path(), true);
+    Some((root, session))
+}
+
+fn label(a: &App, row: QuickRow) -> Option<String> {
+    a.console_labels()
+        .into_iter()
+        .find(|(r, _)| *r == row)
+        .map(|(_, l)| l)
+}
+
+fn held(s: &mut Session, b: Btn) -> u16 {
+    s.feed([RawEvent::Down(b)], 100_000);
+    let input = s.emu().expect("no core").input().0;
+    s.feed([RawEvent::Up(b)], 100_016);
+    input
+}
+
+#[test]
+fn the_snes_page_shows_x_and_y_with_their_own_names() {
+    let _g = core_lock();
+    let Some((_root, s)) = snes() else {
+        return;
+    };
+    let a = s.app();
+    let hidden = a.in_game_hidden();
+    for row in [QuickRow::GameTurboA, QuickRow::GameTurboB] {
+        assert!(!hidden.contains(&row), "{row:?} is hidden on SNES");
+    }
+    assert_eq!(label(a, QuickRow::GameTurboA).as_deref(), Some("X Button"));
+    assert_eq!(label(a, QuickRow::GameTurboB).as_deref(), Some("Y Button"));
+    assert_eq!(label(a, QuickRow::GameL).as_deref(), Some("L Button"));
+    assert!(hidden.contains(&QuickRow::GameL2));
+}
+
+#[test]
+fn moving_the_snes_x_row_is_saved_for_snes_alone_and_reaches_the_game() {
+    let _g = core_lock();
+    let Some((root, mut s)) = snes() else {
+        return;
+    };
+    let a = s.app_mut();
+    in_game_at(a, QuickRow::GameTurboA);
+    press(a, Btn::A);
+    assert!(a.capturing());
+    a.capture_input(RawEvent::Down(Btn::L1));
+    assert!(!a.capturing());
+    assert_eq!(read_controls(root.path()), Controls::default());
+    let own = std::fs::read_to_string(root.path().join("Config/controls/SNES.txt"))
+        .expect("no SNES controls file");
+    assert!(own.contains("turbo_a = l1"), "{own}");
+    assert_eq!(
+        a.active_controls().game(GameButton::TurboA),
+        Binding::plain(Device::L1)
+    );
+    while a.in_game_menu().is_some() {
+        press(a, Btn::B);
+    }
+    std::thread::sleep(Duration::from_millis(20));
+    assert_eq!(held(&mut s, Btn::L1) & ButtonMask::X, ButtonMask::X);
+}
+
+#[test]
+fn the_playstation_page_has_l2_and_r2_rows_on_l2_and_r2_and_flags_nothing() {
+    let _g = core_lock();
+    let Some((_root, s)) = ps1() else {
+        return;
+    };
+    let a = s.app();
+    let hidden = a.in_game_hidden();
+    for row in [QuickRow::GameL2, QuickRow::GameR2] {
+        assert!(!hidden.contains(&row), "{row:?} is hidden on PS1");
+    }
+    assert_eq!(label(a, QuickRow::GameL2).as_deref(), Some("L2"));
+    assert_eq!(label(a, QuickRow::GameTurboA).as_deref(), Some("Triangle"));
+    for row in QuickRow::IN_GAME
+        .into_iter()
+        .filter(|r| !hidden.contains(r))
+    {
+        assert_eq!(a.clash(row), None, "{row:?} is flagged by default");
+    }
+}
diff --git a/crates/slot/tests/controls_common/mod.rs b/crates/slot/tests/controls_common/mod.rs
new file mode 100644
index 0000000..6a3161a
--- /dev/null
+++ b/crates/slot/tests/controls_common/mod.rs
@@ -0,0 +1,96 @@
+#![allow(dead_code)]
+// What each core reads, by RetroPad id, at its pinned commit (ADR 0108): taken from the cores' own
+// input code and kept apart from slot's name table (console_pad::core_name) on purpose. Used by
+// controls_pages.rs (no cores) and controls_real_games.rs (real games). A new Platform does not
+// compile until it has a list here.
+use slot::console_pad::PadMode;
+use slot::vb_input;
+use slot::ws_input::{SIDEWAYS, VERTICAL};
+use slot_store::Platform;
+
+pub const DPAD: [u32; 4] = [4, 5, 6, 7];
+pub const B: u32 = 0;
+pub const Y: u32 = 1;
+pub const SELECT: u32 = 2;
+pub const START: u32 = 3;
+pub const A: u32 = 8;
+pub const X: u32 = 9;
+pub const L: u32 = 10;
+pub const R: u32 = 11;
+pub const L2: u32 = 12;
+pub const R2: u32 = 13;
+pub const L3: u32 = 14;
+pub const R3: u32 = 15;
+
+pub fn reads(mode: PadMode) -> Vec<u32> {
+    let face: &[u32] = match mode.platform {
+        Platform::Gba => &[B, A, L, R, SELECT, START],
+        Platform::Gb | Platform::Gbc | Platform::Nes | Platform::Fds => &[B, A, SELECT, START],
+        Platform::Snes => &[B, Y, A, X, L, R, SELECT, START],
+        Platform::Md | Platform::SegaCd | Platform::S32x => &[Y, B, A, X, L, R, SELECT, START],
+        Platform::Gg | Platform::Sms => &[B, A, START],
+        Platform::Ps1 => &[B, Y, A, X, L, R, L2, R2, SELECT, START],
+        Platform::Tg16 | Platform::Pcecd => &[B, A, SELECT, START],
+        Platform::Sgx if mode.six => &[B, A, Y, X, L, R, SELECT, START],
+        Platform::Sgx => &[B, A, SELECT, START],
+        Platform::Ws => &[L, R, L2, R2, B, A, START],
+        Platform::Lynx => &[B, A, L, R, START],
+        Platform::Ngp => &[B, A, START],
+        Platform::A2600 => &[B, SELECT, START],
+        Platform::A7800 => &[B, A, X, SELECT, START],
+        Platform::Vb if mode.code == vb_input::BUTTONS => {
+            &[B, A, L, R, SELECT, START, L2, R2, L3, R3]
+        }
+        Platform::Vb => &[B, A, L, R, SELECT, START],
+        Platform::Neocd => &[B, A, Y, X, L, SELECT, START],
+        Platform::NeoGeo => &[B, A, Y, X, SELECT, START],
+        Platform::Cps1 | Platform::Cps2 => &[B, A, Y, X, R, L, SELECT, START],
+        Platform::Pico8 => &[B, A, START],
+    };
+    DPAD.into_iter().chain(face.iter().copied()).collect()
+}
+
+pub fn modes(platform: Platform) -> Vec<PadMode> {
+    let plain = PadMode::plain(platform);
+    let other = match platform {
+        Platform::Ws => Some(PadMode {
+            code: VERTICAL,
+            ..plain
+        }),
+        Platform::Vb => Some(PadMode {
+            code: vb_input::BUTTONS,
+            ..plain
+        }),
+        Platform::Sgx => Some(PadMode {
+            six: true,
+            pass_through: true,
+            ..plain
+        }),
+        Platform::Cps1 | Platform::Cps2 => Some(PadMode {
+            code: SIDEWAYS,
+            ..plain
+        }),
+        Platform::Gba
+        | Platform::Gb
+        | Platform::Gbc
+        | Platform::Nes
+        | Platform::Fds
+        | Platform::Snes
+        | Platform::Gg
+        | Platform::Sms
+        | Platform::Md
+        | Platform::SegaCd
+        | Platform::Neocd
+        | Platform::Ps1
+        | Platform::Tg16
+        | Platform::Pcecd
+        | Platform::Lynx
+        | Platform::Ngp
+        | Platform::S32x
+        | Platform::A2600
+        | Platform::A7800
+        | Platform::Pico8
+        | Platform::NeoGeo => None,
+    };
+    std::iter::once(plain).chain(other).collect()
+}
diff --git a/crates/slot/tests/controls_pages.rs b/crates/slot/tests/controls_pages.rs
new file mode 100644
index 0000000..aa442f1
--- /dev/null
+++ b/crates/slot/tests/controls_pages.rs
@@ -0,0 +1,176 @@
+// Every console button a core reads has a visible, remappable row on that system's In-Game
+// Controls page (ADR 0108). What each core reads is in controls_common, kept apart from slot's
+// name table on purpose: a row that goes missing, a remap that drops a button or a new Platform
+// without its list fails here.
+mod controls_common;
+
+use controls_common::{modes, reads};
+use slot::console_pad::{self, PadMode};
+use slot::input::{device_btn, Pad};
+use slot::ws_input::VERTICAL;
+use slot_input::Action;
+use slot_retro::ButtonMask;
+use slot_store::{console_factory, Controls, Device, Platform};
+use slot_ui::QuickRow;
+
+fn visible(mode: PadMode) -> Vec<QuickRow> {
+    let hidden = match mode.platform.keeps_own_controls() {
+        true => console_pad::hidden(mode, &[]),
+        false if mode.platform.owns_shoulders() => vec![QuickRow::GameL, QuickRow::GameR],
+        false => Vec::new(),
+    };
+    QuickRow::IN_GAME
+        .into_iter()
+        .filter(|r| !hidden.contains(r))
+        .filter(|r| mode.platform.keeps_own_controls() || QuickRow::CONTROLS.contains(r))
+        .collect()
+}
+
+fn device(controls: &Controls, row: QuickRow) -> Option<Device> {
+    let binding = controls.game(row.game_button()?)?;
+    binding.modifier.is_none().then_some(binding.button)
+}
+
+fn sent(mode: PadMode, controls: &Controls, held: &[Device]) -> u16 {
+    let mut pad = Pad::default();
+    for d in held {
+        pad.apply(Action::GbaDown(device_btn(*d)));
+    }
+    let mask = pad.mask_with(controls, console_pad::triggers(mode, &[]));
+    let delivered = mode.delivered(mask).0;
+    let pulsed = match mode.passes() {
+        true => 0,
+        false => {
+            let out =
+                slot::ws_input::pass(mode.code, slot::ws_input::starting_layout(mode.code), mask).0;
+            let turbo = |bit: u16, gives: u16| if out & bit != 0 { gives } else { 0 };
+            turbo(ButtonMask::X, ButtonMask::A) | turbo(ButtonMask::Y, ButtonMask::B)
+        }
+    };
+    delivered | pulsed
+}
+
+fn reached(mode: PadMode) -> u16 {
+    let controls = console_factory(mode.platform);
+    let devices: Vec<Device> = visible(mode)
+        .into_iter()
+        .filter_map(|r| device(&controls, r))
+        .collect();
+    let mut bits = 0;
+    for first in &devices {
+        bits |= sent(mode, &controls, &[*first]);
+        for second in &devices {
+            bits |= sent(mode, &controls, &[*first, *second]);
+        }
+    }
+    bits
+}
+
+#[test]
+fn every_console_button_a_core_reads_has_a_visible_row_that_reaches_it() {
+    for platform in Platform::SHELVES {
+        for mode in modes(platform) {
+            let bits = reached(mode);
+            for id in reads(mode) {
+                assert!(
+                    bits & (1 << id) != 0,
+                    "{platform:?} ({mode:?}): the core reads id {id} and no visible row sends it"
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn no_two_visible_rows_start_on_the_same_device_button() {
+    for platform in Platform::SHELVES {
+        for mode in modes(platform) {
+            let controls = console_factory(platform);
+            let mut seen: Vec<(Device, QuickRow)> = Vec::new();
+            for row in visible(mode) {
+                let Some(d) = device(&controls, row) else {
+                    continue;
+                };
+                if let Some((_, other)) = seen.iter().find(|(s, _)| *s == d) {
+                    panic!("{platform:?}: {row:?} and {other:?} both start on {d:?}");
+                }
+                seen.push((d, row));
+            }
+        }
+    }
+}
+
+#[test]
+fn turbo_rows_show_only_where_the_console_face_is_a_and_b() {
+    let a_b_only = |mode: PadMode| match mode.platform {
+        Platform::Nes
+        | Platform::Fds
+        | Platform::Gg
+        | Platform::Sms
+        | Platform::Tg16
+        | Platform::Pcecd
+        | Platform::Lynx
+        | Platform::Ngp
+        | Platform::Pico8 => true,
+        Platform::Sgx => !mode.six,
+        Platform::Ws => mode.code != VERTICAL,
+        Platform::Gba
+        | Platform::Gb
+        | Platform::Gbc
+        | Platform::Snes
+        | Platform::Md
+        | Platform::SegaCd
+        | Platform::S32x
+        | Platform::Ps1
+        | Platform::A2600
+        | Platform::A7800
+        | Platform::Vb
+        | Platform::NeoGeo
+        | Platform::Neocd
+        | Platform::Cps1
+        | Platform::Cps2 => false,
+    };
+    for platform in Platform::SHELVES
+        .into_iter()
+        .filter(|p| p.keeps_own_controls())
+    {
+        for mode in modes(platform) {
+            let turbo = console_pad::labels(mode, &[])
+                .into_iter()
+                .filter(|(_, l)| l.starts_with("Turbo "))
+                .count();
+            match a_b_only(mode) {
+                true => assert_eq!(turbo, 2, "{platform:?} ({mode:?}) lost its turbo rows"),
+                false => assert_eq!(turbo, 0, "{platform:?} ({mode:?}) shows a turbo row"),
+            }
+        }
+    }
+}
+
+#[test]
+fn the_device_check_reads_the_same_lists() {
+    let file = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../../../harness/controls-reads.tsv");
+    let text = std::fs::read_to_string(&file).expect("harness/controls-reads.tsv");
+    let mask = |mode: PadMode| reads(mode).into_iter().fold(0u16, |m, id| m | 1 << id);
+    let listed: Vec<(String, u16)> = text
+        .lines()
+        .filter(|l| !l.starts_with('#') && !l.trim().is_empty())
+        .filter_map(|l| l.split_once('\t'))
+        .map(|(shelf, hex)| {
+            let bits = u16::from_str_radix(hex.trim().trim_start_matches("0x"), 16);
+            (shelf.to_string(), bits.expect("a hex mask"))
+        })
+        .collect();
+    for platform in Platform::SHELVES {
+        let mode = PadMode::plain(platform);
+        let line = listed.iter().find(|(s, _)| s == platform.dir_name());
+        assert_eq!(line.map(|(_, b)| *b), Some(mask(mode)), "{platform:?}");
+    }
+    let abxy = PadMode {
+        code: slot::vb_input::BUTTONS,
+        ..PadMode::plain(Platform::Vb)
+    };
+    let line = listed.iter().find(|(s, _)| s == "VB-ABXY");
+    assert_eq!(line.map(|(_, b)| *b), Some(mask(abxy)));
+}
diff --git a/crates/slot/tests/controls_real_games.rs b/crates/slot/tests/controls_real_games.rs
new file mode 100644
index 0000000..318cfef
--- /dev/null
+++ b/crates/slot/tests/controls_real_games.rs
@@ -0,0 +1,260 @@
+// One real game per shelf, played through the whole session: every visible row of the In-Game
+// Controls page is pressed on its device button, and the core's own input_state answers are read
+// back (ADR 0108). Two things must hold for every game: each console button the core polls while it
+// plays (a polled id that controls_common lists for that core) is answered "pressed" for some row's
+// button, and each row's button lands only on the ids the page names for it. Many cores poll all 16
+// ids every frame, so a polled id outside the core's own list is shown but not required.
+//
+// The games are the maintainer's own and never live in the repo: SLOT_CONTROLS_GAMES names a
+// tab-separated list (harness/controls-games.tsv, `task test:controls`). Without it the test only
+// says it skipped, so CI stays green. A line whose game or BIOS is missing is skipped by name.
+mod common;
+mod controls_common;
+mod core_common;
+mod real_seat;
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::time::Duration;
+
+use common::core_lock;
+use core_common::require_core;
+use slot::console_pad::{self, PadMode};
+use slot::core::dylib_name;
+use slot::input::device_btn;
+use slot::session::Session;
+use slot_input::RawEvent;
+use slot_store::{Core, Device, Platform};
+use slot_ui::QuickRow;
+
+struct Game {
+    platform: Platform,
+    rom: PathBuf,
+    bios: Vec<(String, PathBuf)>,
+}
+
+fn games() -> Option<Vec<Game>> {
+    let Some(list) = std::env::var_os("SLOT_CONTROLS_GAMES") else {
+        eprintln!("skipping: SLOT_CONTROLS_GAMES names no game list (task test:controls)");
+        return None;
+    };
+    let text = std::fs::read_to_string(&list).expect("read the game list");
+    let base = Path::new(&list).parent().unwrap_or(Path::new("."));
+    let mut out = Vec::new();
+    for line in text.lines().map(str::trim_end) {
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let mut fields = line.split('\t');
+        let dir = fields.next().unwrap_or("");
+        let platform = Platform::SHELVES
+            .into_iter()
+            .find(|p| p.dir_name() == dir)
+            .unwrap_or_else(|| panic!("{dir} is no shelf"));
+        let rom = base.join(fields.next().expect("a game path"));
+        let bios = fields
+            .filter_map(|f| f.split_once('='))
+            .map(|(to, from)| (to.to_string(), base.join(from)))
+            .collect();
+        out.push(Game {
+            platform,
+            rom,
+            bios,
+        });
+    }
+    Some(out)
+}
+
+fn unzip(zip: &Path, into: &Path) -> bool {
+    Command::new("unzip")
+        .args(["-o", "-q", "-j"])
+        .arg(zip)
+        .arg("-d")
+        .arg(into)
+        .status()
+        .is_ok_and(|s| s.success())
+}
+
+fn cue_tracks(cue: &Path) -> Vec<PathBuf> {
+    let text = std::fs::read_to_string(cue).unwrap_or_default();
+    text.lines()
+        .filter_map(|l| l.trim().strip_prefix("FILE \""))
+        .filter_map(|l| l.split_once('"'))
+        .map(|(name, _)| cue.with_file_name(name))
+        .collect()
+}
+
+fn shelve(game: &Game, shelf: &Path, scratch: &Path) -> Option<String> {
+    let unpacked = match game.rom.extension().and_then(|e| e.to_str()) {
+        Some("zip") if !game.platform.is_arcade() => {
+            if !unzip(&game.rom, scratch) {
+                return None;
+            }
+            std::fs::read_dir(scratch)
+                .ok()?
+                .filter_map(Result::ok)
+                .map(|e| e.path())
+                .find(|p| {
+                    p.extension().and_then(|e| e.to_str()).is_some_and(|e| {
+                        game.platform
+                            .extensions()
+                            .contains(&e.to_lowercase().as_str())
+                    })
+                })?
+        }
+        _ => game.rom.clone(),
+    };
+    let stem = unpacked.file_stem()?.to_str()?.to_string();
+    let mut files = vec![unpacked.clone()];
+    if unpacked.extension().is_some_and(|e| e == "cue") {
+        files.extend(cue_tracks(&unpacked));
+    }
+    std::fs::create_dir_all(shelf).ok()?;
+    for f in files {
+        std::fs::copy(&f, shelf.join(f.file_name()?)).ok()?;
+    }
+    Some(stem)
+}
+
+fn seat(game: &Game) -> Option<(tempfile::TempDir, Session, String)> {
+    let core = Core::default_for(game.platform);
+    let dylib = require_core(core.as_str())?;
+    if !game.rom.exists() {
+        eprintln!(
+            "skipping a {:?} game: it is not in the library",
+            game.platform
+        );
+        return None;
+    }
+    if let Some((to, _)) = game.bios.iter().find(|(_, from)| !from.exists()) {
+        eprintln!("skipping a {:?} game: no BIOS for {to}", game.platform);
+        return None;
+    }
+    let root = common::tmp_root_with_real_carts(&[]);
+    let scratch = tempfile::tempdir().ok()?;
+    let shelf = root.path().join("Games").join(game.platform.dir_name());
+    let Some(stem) = shelve(game, &shelf, scratch.path()) else {
+        eprintln!(
+            "skipping a {:?} game: it could not be unpacked",
+            game.platform
+        );
+        return None;
+    };
+    for (to, from) in &game.bios {
+        let dest = slot::root::bios_dir(root.path()).join(to);
+        std::fs::create_dir_all(dest.parent()?).ok()?;
+        std::fs::copy(from, dest).ok()?;
+    }
+    std::os::unix::fs::symlink(
+        std::fs::canonicalize(dylib).ok()?,
+        root.path().join("System").join(dylib_name(core)),
+    )
+    .ok()?;
+    common::clocked(root.path());
+    let session = real_seat::play(root.path(), true);
+    Some((root, session, stem))
+}
+
+fn frames(s: &mut Session, now: &mut u64, n: u32) {
+    for _ in 0..n {
+        *now += 16;
+        s.feed([], *now);
+        s.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(16));
+    }
+}
+
+fn press(s: &mut Session, now: &mut u64, held: &[Device]) -> u16 {
+    frames(s, now, 4);
+    s.emu().expect("no core").pad_seen().take_answered();
+    for d in held {
+        *now += 16;
+        s.feed([RawEvent::Down(device_btn(*d))], *now);
+    }
+    frames(s, now, 12);
+    let answered = s.emu().expect("no core").pad_seen().take_answered();
+    for d in held.iter().rev() {
+        *now += 16;
+        s.feed([RawEvent::Up(device_btn(*d))], *now);
+    }
+    frames(s, now, 4);
+    answered | s.emu().expect("no core").pad_seen().take_answered()
+}
+
+fn check(game: &Game, report: &mut Vec<String>) {
+    let Some((_root, mut s, stem)) = seat(game) else {
+        return;
+    };
+    let mut now = 1_000_000;
+    frames(&mut s, &mut now, 180);
+    let app = s.app();
+    let mode = app.pad_mode().unwrap_or(PadMode::plain(game.platform));
+    let names = app.pad_names().to_vec();
+    let hidden = app.in_game_hidden();
+    let controls = app.active_controls();
+    let labels = app.console_labels();
+    let rows: Vec<(QuickRow, Device, String, u16)> = QuickRow::IN_GAME
+        .into_iter()
+        .filter(|r| !hidden.contains(r))
+        .filter(|r| game.platform.keeps_own_controls() || QuickRow::CONTROLS.contains(r))
+        .filter_map(|r| {
+            let g = r.game_button()?;
+            let b = controls.game(g).filter(|b| b.modifier.is_none())?;
+            let label = labels
+                .iter()
+                .find(|(l, _)| *l == r)
+                .map_or(r.label().to_string(), |(_, t)| t.clone());
+            Some((r, b.button, label, console_pad::row_bits(mode, g)))
+        })
+        .collect();
+    let idle = press(&mut s, &mut now, &[]);
+    let mut answered_any = 0u16;
+    let mut lines = vec![format!("{:?} {stem}", game.platform)];
+    for (row, device, label, bits) in &rows {
+        let answered = press(&mut s, &mut now, &[*device]) & !idle;
+        answered_any |= answered;
+        lines.push(format!(
+            "  {label} ({row:?}) on {device:?}: answered {answered:#06x}"
+        ));
+        if answered & !bits != 0 {
+            report.push(format!(
+                "{:?} {stem}: {label} on {device:?} reached ids {:#06x} the page does not name",
+                game.platform,
+                answered & !bits
+            ));
+        }
+        if label.starts_with("Y Pad") {
+            for (_, other, _, _) in rows.iter().filter(|(r, ..)| r != row) {
+                answered_any |= press(&mut s, &mut now, &[*device, *other]) & !idle;
+            }
+        }
+    }
+    let polled = s.emu().expect("no core").pad_seen().polled();
+    let reads = controls_common::reads(mode)
+        .into_iter()
+        .fold(0u16, |bits, id| bits | 1 << id);
+    let missed = polled & reads & !answered_any & !idle;
+    lines.push(format!(
+        "  polled {polled:#06x}, read {reads:#06x}, answered {answered_any:#06x}, held by slot {idle:#06x}, names {names:?}"
+    ));
+    eprintln!("{}", lines.join("\n"));
+    if missed != 0 {
+        report.push(format!(
+            "{:?} {stem}: the core reads ids {missed:#06x} that no row's button reaches",
+            game.platform
+        ));
+    }
+}
+
+#[test]
+fn every_button_of_a_real_game_on_every_shelf_reaches_its_core() {
+    let Some(games) = games() else {
+        return;
+    };
+    let _g = core_lock();
+    let mut report = Vec::new();
+    for game in &games {
+        check(game, &mut report);
+    }
+    assert!(report.is_empty(), "\n{}", report.join("\n"));
+}
