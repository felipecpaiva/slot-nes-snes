+use std::path::{Path, PathBuf};
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    cart_box, cart_face, cart_face_with, retro_label_rect, retro_silhouette, NesShell, RetroShell,
+    SnesShell,
+};
+
+const WELL: f32 = 116.0;
+
+fn platform_of(kind: RetroShell) -> Platform {
+    match kind {
+        RetroShell::Nes(_) => Platform::Nes,
+        RetroShell::Snes(_) => Platform::Snes,
+    }
+}
+
+fn outline_of(kind: RetroShell) -> Outline {
+    match kind {
+        RetroShell::Nes(NesShell::Nes) => Outline::Nes,
+        RetroShell::Nes(NesShell::Famicom) => Outline::Famicom,
+        RetroShell::Snes(SnesShell::Snes) => Outline::Snes,
+        RetroShell::Snes(SnesShell::Sfc) => Outline::Sfc,
+    }
+}
+
+fn cart(kind: RetroShell, colour: [u8; 3], finish: ShellFinish) -> Cart {
+    Cart {
+        platform: platform_of(kind),
+        stem: "Bitmap Cart (USA)".into(),
+        rom: PathBuf::from("Bitmap Cart (USA).rom"),
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: Some(ShellChoice {
+            outline: outline_of(kind),
+            colour,
+            finish,
+        }),
+    }
+}
+
+fn neutral(kind: RetroShell) -> (Vec<u8>, u32, u32) {
+    let path = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("assets/retro")
+        .join(format!("{}_neutral.png", kind.name()));
+    let file = std::fs::File::open(&path).expect("neutral png");
+    let mut reader = png::Decoder::new(std::io::BufReader::new(file))
+        .read_info()
+        .expect("png header");
+    let mut buf = vec![0; reader.output_buffer_size()];
+    let info = reader.next_frame(&mut buf).expect("png frame");
+    assert_eq!(info.color_type, png::ColorType::Rgba, "{kind:?}");
+    assert_eq!(info.bit_depth, png::BitDepth::Eight, "{kind:?}");
+    buf.truncate(info.buffer_size());
+    (buf, info.width, info.height)
+}
+
+fn label_px(kind: RetroShell) -> (u32, u32, u32, u32) {
+    let (w, h) = cart_box(platform_of(kind));
+    let (x, y, lw, lh) = retro_label_rect(kind);
+    let at = |f: f32, of: u32| (f * of as f32).round() as u32;
+    (at(x, w), at(y, h), at(lw, w), at(lh, h))
+}
+
+fn luma(rgba: &[u8], w: u32, x: u32, y: u32) -> f32 {
+    let i = ((y * w + x) * 4) as usize;
+    (rgba[i] as f32 + rgba[i + 1] as f32 + rgba[i + 2] as f32) / 3.0
+}
+
+#[test]
+fn every_retro_neutral_is_the_size_of_its_cart_box() {
+    for kind in RetroShell::ALL {
+        let (_, w, h) = neutral(kind);
+        assert_eq!((w, h), cart_box(platform_of(kind)), "{kind:?}");
+    }
+}
+
+#[test]
+fn a_fifty_percent_grey_cart_is_the_neutral_image_itself() {
+    for kind in RetroShell::ALL {
+        let (grey, w, _) = neutral(kind);
+        let (_, _, lw, lh) = label_px(kind);
+        let blank = vec![0u8; (lw * lh * 4) as usize];
+        let face = cart_face_with(&cart(kind, [128; 3], ShellFinish::Solid), Some(blank));
+        assert_eq!(face.w, w, "{kind:?}");
+        let mut drawn = 0;
+        for (i, (got, want)) in face
+            .rgba
+            .chunks_exact(4)
+            .zip(grey.chunks_exact(4))
+            .enumerate()
+        {
+            if got[3] == 0 {
+                continue;
+            }
+            drawn += 1;
+            assert_eq!(got[..3], want[..3], "{kind:?} pixel {i}");
+        }
+        assert!(
+            drawn > (face.w * face.h / 3) as usize,
+            "{kind:?} drew {drawn}"
+        );
+    }
+}
+
+#[test]
+fn the_label_box_sits_inside_the_painted_well_of_every_shell() {
+    for kind in RetroShell::ALL {
+        let (grey, w, _) = neutral(kind);
+        let (x, y, lw, lh) = label_px(kind);
+        let mut sum = 0.0;
+        for yy in y..y + lh {
+            for xx in x..x + lw {
+                assert_eq!(
+                    grey[((yy * w + xx) * 4 + 3) as usize],
+                    255,
+                    "{kind:?} {xx},{yy}"
+                );
+                sum += luma(&grey, w, xx, yy);
+            }
+        }
+        let well = sum / (lw * lh) as f32;
+        assert!((well - WELL).abs() < 2.0, "{kind:?} well {well}");
+        let column =
+            |xx: u32| (y..y + lh).map(|yy| luma(&grey, w, xx, yy)).sum::<f32>() / lh as f32;
+        let row = |yy: u32| (x..x + lw).map(|xx| luma(&grey, w, xx, yy)).sum::<f32>() / lw as f32;
+        let lips = [
+            ("left", column(x - 3)),
+            ("right", column(x + lw + 2)),
+            ("bottom", row(y + lh + 2)),
+        ];
+        for (side, lip) in lips {
+            assert!(
+                (lip - well).abs() > 10.0,
+                "{kind:?} {side} lip {lip} vs well {well}"
+            );
+        }
+        if y >= 3 {
+            let top = row(y - 3);
+            assert!(well - top > 10.0, "{kind:?} top lip {top} vs well {well}");
+        }
+    }
+}
+
+#[test]
+fn a_clear_or_glitter_retro_cart_is_opaque_wherever_its_outline_is() {
+    for kind in RetroShell::ALL {
+        let (w, h) = cart_box(platform_of(kind));
+        let mask = retro_silhouette(kind, w, h);
+        for finish in [ShellFinish::Clear, ShellFinish::Glitter, ShellFinish::Solid] {
+            let face = cart_face(&cart(kind, [0x40, 0x80, 0xc0], finish));
+            let alpha: Vec<u8> = face.rgba.chunks_exact(4).map(|p| p[3]).collect();
+            assert!(
+                alpha == mask,
+                "{kind:?} {finish:?} alpha is not the outline"
+            );
+        }
+    }
+}
+
+#[test]
+fn the_favorites_star_corner_stays_on_the_same_label_pixels() {
+    for (kind, want) in [
+        (RetroShell::Nes(NesShell::Nes), (128, 7, 137, 212)),
+        (RetroShell::Nes(NesShell::Famicom), (26, 171, 260, 104)),
+        (RetroShell::Snes(SnesShell::Snes), (50, 7, 264, 88)),
+        (RetroShell::Snes(SnesShell::Sfc), (50, 7, 264, 88)),
+    ] {
+        assert_eq!(label_px(kind), want, "{kind:?}");
+    }
+}
+
+#[test]
+fn a_retro_face_is_the_same_every_time_it_is_drawn() {
+    for kind in RetroShell::ALL {
+        for finish in [ShellFinish::Solid, ShellFinish::Clear, ShellFinish::Glitter] {
+            let c = cart(kind, [0x5b, 0x4a, 0x8c], finish);
+            assert!(
+                cart_face(&c).rgba == cart_face(&c).rgba,
+                "{kind:?} {finish:?}"
+            );
+        }
+    }
+}
+
+#[test]
+fn a_coloured_cart_follows_the_painted_light_and_shade() {
+    for kind in RetroShell::ALL {
+        let (grey, w, h) = neutral(kind);
+        let face = cart_face(&cart(kind, [0x5b, 0x4a, 0x8c], ShellFinish::Solid));
+        let (lx, ly, lw, lh) = label_px(kind);
+        let mut seen = (false, false);
+        for y in 0..h {
+            for x in 0..w {
+                let i = ((y * w + x) * 4) as usize;
+                let on_label = (lx..lx + lw).contains(&x) && (ly..ly + lh).contains(&y);
+                if on_label || face.rgba[i + 3] < 255 {
+                    continue;
+                }
+                let g = grey[i];
+                if g < 110 {
+                    assert!(face.rgba[i] < 0x5b, "{kind:?} {x},{y} grey {g}");
+                    seen.0 = true;
+                }
+                if g > 140 {
+                    assert!(face.rgba[i] > 0x5b, "{kind:?} {x},{y} grey {g}");
+                    seen.1 = true;
+                }
+            }
+        }
+        assert_eq!(seen, (true, true), "{kind:?} has no painted shade or light");
+    }
+}
