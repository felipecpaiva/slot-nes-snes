diff --git a/crates/slot-ui/examples/retro_neutrals.rs b/crates/slot-ui/examples/retro_neutrals.rs
new file mode 100644
index 0000000..146eb24
--- /dev/null
+++ b/crates/slot-ui/examples/retro_neutrals.rs
@@ -0,0 +1,257 @@
+use std::path::Path;
+
+use slot_store::Platform;
+use slot_ui::{label_panel, retro_label_rect, retro_silhouette, RetroShell, CART_H, CART_W};
+
+const NEUTRAL: f32 = 128.0;
+const LIP: usize = 3;
+const BEVEL: usize = 16;
+
+struct Lighting {
+    body: f32,
+    well: f32,
+    grain: f32,
+    bevel: [f32; BEVEL],
+    lips: [[f32; LIP]; 4],
+    groove: f32,
+    ridge: f32,
+}
+
+struct Rect {
+    x: usize,
+    y: usize,
+    w: usize,
+    h: usize,
+}
+
+fn read_rgba(path: &Path) -> (Vec<u8>, usize, usize) {
+    let file = std::fs::File::open(path).expect("open the upstream gba_neutral.png");
+    let mut dec = png::Decoder::new(std::io::BufReader::new(file));
+    dec.set_transformations(png::Transformations::normalize_to_color8());
+    let mut reader = dec.read_info().expect("read the png header");
+    let mut buf = vec![0; reader.output_buffer_size()];
+    let info = reader.next_frame(&mut buf).expect("decode the png");
+    assert_eq!(
+        info.color_type,
+        png::ColorType::Rgba,
+        "{path:?} is not RGBA"
+    );
+    buf.truncate(info.buffer_size());
+    (buf, info.width as usize, info.height as usize)
+}
+
+fn write_rgba(path: &Path, rgba: &[u8], w: usize, h: usize) {
+    let file = std::fs::File::create(path).expect("create the neutral png");
+    let mut enc = png::Encoder::new(std::io::BufWriter::new(file), w as u32, h as u32);
+    enc.set_color(png::ColorType::Rgba);
+    enc.set_depth(png::BitDepth::Eight);
+    enc.write_header()
+        .and_then(|mut wr| wr.write_image_data(rgba))
+        .expect("write the neutral png");
+}
+
+fn distance(alpha: &[u8], w: usize, h: usize) -> Vec<usize> {
+    let mut d: Vec<usize> = alpha
+        .iter()
+        .map(|a| if *a > 127 { usize::MAX / 2 } else { 0 })
+        .collect();
+    for y in 0..h {
+        for x in 0..w {
+            let i = y * w + x;
+            if d[i] == 0 {
+                continue;
+            }
+            let up = if y == 0 { 0 } else { d[i - w] };
+            let left = if x == 0 { 0 } else { d[i - 1] };
+            d[i] = d[i].min(up + 1).min(left + 1);
+        }
+    }
+    for y in (0..h).rev() {
+        for x in (0..w).rev() {
+            let i = y * w + x;
+            if d[i] == 0 {
+                continue;
+            }
+            let down = if y + 1 == h { 0 } else { d[i + w] };
+            let right = if x + 1 == w { 0 } else { d[i + 1] };
+            d[i] = d[i].min(down + 1).min(right + 1);
+        }
+    }
+    d
+}
+
+fn mean(v: &[f32]) -> f32 {
+    v.iter().sum::<f32>() / v.len().max(1) as f32
+}
+
+fn measure(gba: &Path) -> Lighting {
+    let (rgba, w, h) = read_rgba(gba);
+    let luma: Vec<f32> = rgba
+        .chunks_exact(4)
+        .map(|p| (p[0] as f32 + p[1] as f32 + p[2] as f32) / 3.0)
+        .collect();
+    let alpha: Vec<u8> = rgba.chunks_exact(4).map(|p| p[3]).collect();
+    let d = distance(&alpha, w, h);
+    let (x0, y0, x1, y1) = label_panel(CART_W, CART_H);
+    let (x0, y0, x1, y1) = (x0 as usize, y0 as usize, x1 as usize, y1 as usize);
+    let at = |x: usize, y: usize| luma[y * w + x];
+    let wall = |x: usize| x + LIP < x0 || x >= x1 + LIP;
+    let side = |keep: &dyn Fn(usize) -> bool| -> Vec<f32> {
+        (y0..y1)
+            .flat_map(|y| (0..w).map(move |x| (x, y)))
+            .filter(|&(x, y)| wall(x) && keep(d[y * w + x]))
+            .map(|(x, y)| at(x, y))
+            .collect()
+    };
+    let body_px = side(&|k| k > BEVEL);
+    let body = mean(&body_px);
+    let grain = (body_px.iter().map(|v| (v - body).powi(2)).sum::<f32>()
+        / body_px.len().max(1) as f32)
+        .sqrt();
+    let bevel = std::array::from_fn(|k| mean(&side(&|dk| dk == k + 1)));
+    let inner: Vec<f32> = (y0 + LIP..y1 - LIP)
+        .flat_map(|y| (x0 + LIP..x1 - LIP).map(move |x| (x, y)))
+        .map(|(x, y)| at(x, y))
+        .collect();
+    let well = mean(&inner);
+    let column = |x: usize| mean(&(y0..y1).map(|y| at(x, y)).collect::<Vec<_>>());
+    let row = |y: usize| mean(&(x0..x1).map(|x| at(x, y)).collect::<Vec<_>>());
+    let lips = [
+        std::array::from_fn(|k| column(x0 - 1 - k)),
+        std::array::from_fn(|k| column(x1 + k)),
+        std::array::from_fn(|k| row(y0 - 1 - k)),
+        std::array::from_fn(|k| row(y1 + k)),
+    ];
+    let every = lips.iter().flatten();
+    let groove = every.clone().fold(f32::MAX, |a, b| a.min(*b));
+    let ridge = every.fold(f32::MIN, |a, b| a.max(*b));
+    Lighting {
+        body,
+        well,
+        grain,
+        bevel,
+        lips,
+        groove,
+        ridge,
+    }
+}
+
+fn grain(x: usize, y: usize, seed: u32) -> f32 {
+    let mut h = (x as u32 / 2).wrapping_mul(0x9e37_79b9)
+        ^ (y as u32 / 2).wrapping_mul(0x85eb_ca6b)
+        ^ seed.wrapping_mul(0xc2b2_ae35);
+    h ^= h >> 15;
+    h = h.wrapping_mul(0x2c1b_3c6d);
+    h ^= h >> 12;
+    h = h.wrapping_mul(0x297a_2d39);
+    h ^= h >> 15;
+    let sum: u32 = h.to_le_bytes().iter().map(|b| *b as u32).sum();
+    (sum as f32 - 510.0) / 147.8
+}
+
+fn detail(svg: &str, w: usize, h: usize) -> Vec<(f32, f32)> {
+    let tree = usvg::Tree::from_str(svg, &usvg::Options::default()).expect("parse detail svg");
+    let mut pixmap = resvg::tiny_skia::Pixmap::new(w as u32, h as u32).expect("pixmap");
+    let size = tree.size();
+    let scale =
+        resvg::tiny_skia::Transform::from_scale(w as f32 / size.width(), h as f32 / size.height());
+    resvg::render(&tree, scale, &mut pixmap.as_mut());
+    pixmap
+        .data()
+        .chunks_exact(4)
+        .map(|p| {
+            let lit =
+                ((p[0] as u32 * 54 + p[1] as u32 * 183 + p[2] as u32 * 19) / 256).min(p[3] as u32);
+            ((p[3] as u32 - lit) as f32 / 255.0, lit as f32 / 255.0)
+        })
+        .collect()
+}
+
+fn mix(a: f32, b: f32, t: f32) -> f32 {
+    a * (1.0 - t) + b * t
+}
+
+fn neutral(kind: RetroShell, light: &Lighting, assets: &Path) -> (Vec<u8>, usize, usize) {
+    let platform = match kind {
+        RetroShell::Nes(_) => Platform::Nes,
+        RetroShell::Snes(_) => Platform::Snes,
+    };
+    let (w, h) = slot_ui::cart_box(platform);
+    let mask = retro_silhouette(kind, w, h);
+    let (w, h) = (w as usize, h as usize);
+    let d = distance(&mask, w, h);
+    let svg = std::fs::read_to_string(assets.join(format!("{}_cart_detail.svg", kind.name())))
+        .expect("read the detail svg");
+    let sides = detail(&svg, w, h);
+    let (fx, fy, fw, fh) = retro_label_rect(kind);
+    let r = Rect {
+        x: (fx * w as f32).round() as usize,
+        y: (fy * h as f32).round() as usize,
+        w: (fw * w as f32).round() as usize,
+        h: (fh * h as f32).round() as usize,
+    };
+    let seed = kind.slot() as u32 * 2 + 1;
+    let mut g: Vec<f32> = (0..w * h)
+        .map(|i| {
+            let (x, y) = (i % w, i / w);
+            let base = match d[i] {
+                0 => return NEUTRAL,
+                k if k <= BEVEL => light.bevel[k - 1],
+                _ => light.body,
+            };
+            let lit = base + grain(x, y, seed) * light.grain;
+            let (shade, high) = sides[i];
+            mix(mix(lit, light.groove, shade), light.ridge, high)
+        })
+        .collect();
+    for y in r.y..r.y + r.h {
+        for x in r.x..r.x + r.w {
+            g[y * w + x] = light.well + grain(x, y, seed + 1) * light.grain;
+        }
+    }
+    let mut put = |x: usize, y: usize, v: f32| {
+        if x < w && y < h && d[y * w + x] > 0 {
+            g[y * w + x] = v;
+        }
+    };
+    for k in 0..LIP {
+        for y in r.y..r.y + r.h {
+            if let Some(x) = r.x.checked_sub(1 + k) {
+                put(x, y, light.lips[0][k]);
+            }
+            put(r.x + r.w + k, y, light.lips[1][k]);
+        }
+    }
+    for k in 0..LIP {
+        for x in r.x.saturating_sub(LIP)..r.x + r.w + LIP {
+            if let Some(y) = r.y.checked_sub(1 + k) {
+                put(x, y, light.lips[2][k]);
+            }
+            put(x, r.y + r.h + k, light.lips[3][k]);
+        }
+    }
+    let mut rgba = Vec::with_capacity(w * h * 4);
+    for (v, a) in g.iter().zip(&mask) {
+        let v = v.round().clamp(0.0, 255.0) as u8;
+        rgba.extend_from_slice(&[v, v, v, *a]);
+    }
+    (rgba, w, h)
+}
+
+fn main() {
+    let crate_dir = Path::new(env!("CARGO_MANIFEST_DIR"));
+    let assets = crate_dir.join("assets");
+    let light = measure(&crate_dir.join("../../assets/gba_neutral.png"));
+    println!(
+        "measured gba_neutral.png: body {:.1}, well {:.1}, grain {:.2}, groove {:.1}, ridge {:.1}",
+        light.body, light.well, light.grain, light.groove, light.ridge
+    );
+    let out = assets.join("retro");
+    std::fs::create_dir_all(&out).expect("create assets/retro");
+    for kind in RetroShell::ALL {
+        let (rgba, w, h) = neutral(kind, &light, &assets);
+        let path = out.join(format!("{}_neutral.png", kind.name()));
+        write_rgba(&path, &rgba, w, h);
+        println!("wrote {} ({w}x{h})", path.display());
+    }
+}
