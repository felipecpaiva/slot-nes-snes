From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paiva <felipe.paiva@gmail.com>
Date: Tue, 20 Oct 2026 00:35:44 +0400
Subject: [PATCH] s32x-tests

A Mega Drive game played after a 32X game, in one session, gets exactly
what a Mega Drive only run gets: the same input for every button and the
Select+X chord, the same frame byte for byte, the same source rect and
frame width, and the same shader. It starts on Genesis Plus GX, never on
PicoDrive. A remembered 32X cart resumes on its own shelf and never as a
NES cart with the same name.
---
 crates/slot/tests/resume_platform.rs |   8 +-
 crates/slot/tests/s32x_then_md.rs    | 191 +++++++++++++++++++++++++++
 2 files changed, 198 insertions(+), 1 deletion(-)
 create mode 100644 crates/slot/tests/s32x_then_md.rs

diff --git a/crates/slot/tests/resume_platform.rs b/crates/slot/tests/resume_platform.rs
index f23723b..7b66de7 100644
--- a/crates/slot/tests/resume_platform.rs
+++ b/crates/slot/tests/resume_platform.rs
@@ -15,7 +15,13 @@ fn remembering(root: &std::path::Path, platform: Platform) {
 
 #[test]
 fn each_new_system_resumes_its_own_cart_and_never_a_nes_cart_with_the_same_name() {
-    for platform in [Platform::Tg16, Platform::Ws, Platform::Lynx, Platform::Ngp] {
+    for platform in [
+        Platform::Tg16,
+        Platform::Ws,
+        Platform::Lynx,
+        Platform::Ngp,
+        Platform::S32x,
+    ] {
         let root = common::tmp_root_with_real_carts(&[]);
         let mut nes = b"NES\x1a\x02\x01".to_vec();
         nes.resize(16 + 0x8000 + 0x2000, 0);
diff --git a/crates/slot/tests/s32x_then_md.rs b/crates/slot/tests/s32x_then_md.rs
new file mode 100644
index 0000000..7ec04c1
--- /dev/null
+++ b/crates/slot/tests/s32x_then_md.rs
@@ -0,0 +1,191 @@
+mod common;
+mod core_common;
+mod real_seat;
+mod s32x_common;
+mod sega_common;
+
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use s32x_common::{cart, picodrive};
+use sega_common::{genesis_plus_gx, md_rom};
+use slot::app::Phase;
+use slot::audio::{AudioSink, StubSink};
+use slot::core::dylib_name;
+use slot::session::Session;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{Core, Platform};
+use tempfile::TempDir;
+
+struct Rig {
+    root: TempDir,
+    session: Session,
+    now: Millis,
+}
+
+impl Rig {
+    fn feed(&mut self, ev: RawEvent) {
+        self.now += 20;
+        self.session.feed([ev], self.now);
+    }
+
+    fn tap(&mut self, b: Btn) {
+        self.feed(RawEvent::Down(b));
+        self.feed(RawEvent::Up(b));
+    }
+
+    fn until(&mut self, what: &str, cond: impl Fn(&Session) -> bool) {
+        let deadline = Instant::now() + Duration::from_secs(20);
+        while !cond(&self.session) {
+            assert!(Instant::now() < deadline, "timed out waiting for {what}");
+            self.now += 16;
+            self.session.feed([], self.now);
+            self.session.update(1.0 / 60.0);
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
+
+    fn pad(&self) -> u16 {
+        self.session.emu().expect("no core in the slot").input().0
+    }
+
+    fn booted(pico: &Path, gpgx: &Path) -> Rig {
+        let roms = tempfile::tempdir().expect("tempdir");
+        let rom = cart(roms.path(), "Aaa");
+        let root = real_seat::rooted(Platform::S32x, "Aaa", &rom, pico);
+        std::fs::copy(
+            md_rom("s32x_then_md.md", true, false),
+            root.path().join("Games/MD/Bbb.md"),
+        )
+        .expect("rom");
+        std::os::unix::fs::symlink(
+            std::fs::canonicalize(gpgx).expect("core path"),
+            root.path()
+                .join("System")
+                .join(dylib_name(Core::GenesisPlusGx)),
+        )
+        .expect("link core");
+        let mut sink = StubSink::draining();
+        sink.open(32_768).expect("the stub refused to open");
+        Rig {
+            session: Session::boot_with(root.path().to_path_buf(), Box::new(sink)),
+            root,
+            now: 0,
+        }
+    }
+
+    fn playing(&mut self, what: &str) {
+        self.until(what, |s| {
+            matches!(s.app().phase(), Phase::Playing { .. }) && s.frames_published() >= 10
+        });
+    }
+
+    fn mega_drive(after_32x: bool) -> Option<Rig> {
+        let pico = picodrive()?;
+        let gpgx = genesis_plus_gx()?;
+        let mut r = Rig::booted(&pico, &gpgx);
+        if after_32x {
+            r.tap(Btn::R1);
+            r.tap(Btn::A);
+            r.playing("the 32x cart to seat");
+            assert_eq!(r.session.app().playing_platform(), Platform::S32x);
+            assert_eq!(r.session.app().core(), Core::Picodrive);
+            r.feed(RawEvent::Down(Btn::Menu));
+            r.until("the eject", |s| !s.has_core());
+            r.feed(RawEvent::Up(Btn::Menu));
+            r.until("the shelf", |s| matches!(s.app().phase(), Phase::Shelf));
+            r.tap(Btn::L1);
+        }
+        r.tap(Btn::A);
+        r.playing("the mega drive cart to seat");
+        assert_eq!(r.session.app().playing_platform(), Platform::Md);
+        assert_eq!(r.session.app().core(), Core::GenesisPlusGx);
+        Some(r)
+    }
+
+    fn input(&mut self) -> Vec<u16> {
+        let mut seen = vec![u16::from(
+            self.session.emu().expect("core").passes_through(),
+        )];
+        for btn in [
+            Btn::A,
+            Btn::B,
+            Btn::X,
+            Btn::Y,
+            Btn::L1,
+            Btn::R1,
+            Btn::L2,
+            Btn::R2,
+        ] {
+            self.feed(RawEvent::Down(btn));
+            seen.push(self.pad());
+            self.feed(RawEvent::Up(btn));
+            seen.push(self.pad());
+        }
+        self.feed(RawEvent::Down(Btn::Select));
+        self.feed(RawEvent::Down(Btn::X));
+        seen.push(self.pad() & ButtonMask::X);
+        self.feed(RawEvent::Up(Btn::X));
+        self.feed(RawEvent::Up(Btn::Select));
+        seen.push(u16::from(
+            self.root.path().join("Config/video_mode.txt").exists(),
+        ));
+        seen
+    }
+
+    fn picture(&self) -> ([f32; 4], u32, Vec<u8>) {
+        let emu = self.session.emu().expect("core");
+        let frame = emu.latest_frame().expect("nothing was published");
+        (
+            self.session.app().source_rect(),
+            emu.frame_width(),
+            frame.to_vec(),
+        )
+    }
+}
+
+#[test]
+fn a_mega_drive_game_after_a_32x_game_gets_the_same_input_as_a_mega_drive_only_run() {
+    let _g = core_lock();
+    let Some(mut alone) = Rig::mega_drive(false) else {
+        return;
+    };
+    let want = alone.input();
+    drop(alone);
+    let mut after = Rig::mega_drive(true).expect("cores");
+    assert_eq!(after.input(), want);
+}
+
+#[test]
+fn a_mega_drive_game_after_a_32x_game_draws_the_same_frame_as_a_mega_drive_only_run() {
+    let _g = core_lock();
+    let Some(alone) = Rig::mega_drive(false) else {
+        return;
+    };
+    let want = alone.picture();
+    assert_eq!(want.2.len(), 360 * 240 * 4);
+    assert_eq!(want.1, 320);
+    drop(alone);
+    let after = Rig::mega_drive(true).expect("cores");
+    let got = after.picture();
+    assert_eq!(got.0, want.0);
+    assert_eq!(got.1, want.1);
+    assert!(
+        got.2 == want.2,
+        "the Mega Drive frame differs after a 32X game"
+    );
+}
+
+#[test]
+fn a_mega_drive_game_after_a_32x_game_keeps_the_mega_drive_shader() {
+    let _g = core_lock();
+    let Some(alone) = Rig::mega_drive(false) else {
+        return;
+    };
+    let want = alone.session.app().screen_shader();
+    drop(alone);
+    let after = Rig::mega_drive(true).expect("cores");
+    assert_eq!(after.session.app().screen_shader(), want);
+}
