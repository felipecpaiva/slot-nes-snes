 pub fn answers_declared_defaults(which: Core) -> bool {
     match which {
         Core::PcsxRearmed => true,
@@ -93,9 +105,9 @@ pub fn apply_policy_options(core: &mut LibretroCore, which: Core) {
         | Core::Fceumm
         | Core::Snes9x
         | Core::Nestopia
-        | Core::Snes9x2005Plus
-        | Core::MednafenPceFast => &[],
+        | Core::Snes9x2005Plus => &[],
         Core::PcsxRearmed => &PCSX_REARMED,
+        Core::MednafenPceFast => &PCE_FAST,
     };
     for (key, value) in fixed {
