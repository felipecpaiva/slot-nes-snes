new file mode 100644
index 0000000..3683844
--- /dev/null
+++ b/crates/slot-retro/src/turbo_mode.rs
@@ -0,0 +1,28 @@
+use crate::core::ButtonMask;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum TurboMode {
+    Turbo,
+    Off,
+    PassThrough,
+}
+
+impl TurboMode {
+    pub fn from_flags(pass_through: bool, turbo: bool) -> TurboMode {
+        match (pass_through, turbo) {
+            (true, _) => TurboMode::PassThrough,
+            (false, true) => TurboMode::Turbo,
+            (false, false) => TurboMode::Off,
+        }
+    }
+}
+
+impl ButtonMask {
+    pub fn apply(self, mode: TurboMode, frame: u32) -> ButtonMask {
+        match mode {
+            TurboMode::Turbo => self.turbo(frame),
+            TurboMode::Off => self.without_turbo(),
+            TurboMode::PassThrough => self,
+        }
+    }
+}
diff --git a/crates/slot-retro/tests/snes_turbo.rs b/crates/slot-retro/tests/snes_turbo.rs
new file mode 100644
index 0000000..e526493
--- /dev/null
+++ b/crates/slot-retro/tests/snes_turbo.rs
@@ -0,0 +1,35 @@
+use slot_retro::{ButtonMask, TurboMode};
+
+const XY: u16 = ButtonMask::X | ButtonMask::Y;
+
+fn held() -> ButtonMask {
+    ButtonMask(XY | ButtonMask::L | ButtonMask::R | ButtonMask::SELECT | ButtonMask::UP)
+}
+
+#[test]
+fn pass_through_keeps_x_and_y_on_every_frame() {
+    for frame in 0..12 {
+        assert_eq!(held().apply(TurboMode::PassThrough, frame), held());
+    }
+}
+
+#[test]
+fn turbo_mode_is_the_upstream_turbo_on_every_frame() {
+    for frame in 0..12 {
+        assert_eq!(held().apply(TurboMode::Turbo, frame), held().turbo(frame));
+    }
+}
+
+#[test]
+fn off_mode_is_the_upstream_without_turbo() {
+    assert_eq!(held().apply(TurboMode::Off, 0), held().without_turbo());
+}
+
+#[test]
+fn the_snes_pass_through_flag_wins_over_the_turbo_setting() {
+    for turbo in [true, false] {
+        assert_eq!(TurboMode::from_flags(true, turbo), TurboMode::PassThrough);
+    }
+    assert_eq!(TurboMode::from_flags(false, true), TurboMode::Turbo);
+    assert_eq!(TurboMode::from_flags(false, false), TurboMode::Off);
+}
