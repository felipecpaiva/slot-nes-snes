diff --git a/crates/slot/tests/snes_select.rs b/crates/slot/tests/snes_select.rs
new file mode 100644
index 0000000..cf309a6
--- /dev/null
+++ b/crates/slot/tests/snes_select.rs
@@ -0,0 +1,263 @@
+mod common;
+mod input_common;
+
+use input_common::playing;
+use slot::app::Phase;
+use slot::session::Session;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{read_slot_state, Core, Platform, StateRing};
+use slot_ui::{Icon, Toast};
+use tempfile::TempDir;
+
+const STEM: &str = "Zzz";
+
+struct Rig {
+    root: TempDir,
+    session: Session,
+    now: Millis,
+    ever: u16,
+}
+
+fn rig(platform: Platform) -> Rig {
+    let (root, session) = playing(platform, STEM);
+    Rig {
+        root,
+        session,
+        now: 100,
+        ever: 0,
+    }
+}
+
+impl Rig {
+    fn feed(&mut self, ev: RawEvent) {
+        self.now += 20;
+        self.session.feed([ev], self.now);
+        self.ever |= self.pad();
+    }
+
+    fn press(&mut self, b: Btn) {
+        self.feed(RawEvent::Down(b));
+    }
+
+    fn release(&mut self, b: Btn) {
+        self.feed(RawEvent::Up(b));
+    }
+
+    fn chord(&mut self, b: Btn) {
+        self.press(Btn::Select);
+        self.press(b);
+        self.release(b);
+        self.release(Btn::Select);
+    }
+
+    fn wait(&mut self, ms: Millis) {
+        self.now += ms;
+        self.session.feed([], self.now);
+    }
+
+    fn pad(&self) -> u16 {
+        self.session.emu().expect("no core in the slot").input().0
+    }
+
+    fn colour(&self) -> bool {
+        self.session.app().colour_correction()
+    }
+
+    fn saved_colour(&self) -> [bool; 3] {
+        self.session.app().flush_state();
+        let s = read_slot_state(self.root.path());
+        [
+            s.colour_correction_gba,
+            s.colour_correction_gb,
+            s.colour_correction_gbc,
+        ]
+    }
+
+    fn picture(&self) -> slot::video_mode::VideoMode {
+        slot::video_mode::video_mode_for(self.root.path(), STEM)
+    }
+
+    fn states(&self, platform: Platform, core: Core) -> usize {
+        StateRing::new(self.root.path(), platform, core, STEM)
+            .list()
+            .expect("list the ring")
+            .len()
+    }
+}
+
+#[test]
+fn a_snes_game_is_run_with_x_and_y_passed_through() {
+    assert!(rig(Platform::Snes)
+        .session
+        .emu()
+        .expect("core")
+        .passes_through());
+}
+
+#[test]
+fn a_nes_game_is_not_run_with_x_and_y_passed_through() {
+    assert!(!rig(Platform::Nes)
+        .session
+        .emu()
+        .expect("core")
+        .passes_through());
+}
+
+#[test]
+fn x_y_l_and_r_reach_the_snes_core() {
+    let mut r = rig(Platform::Snes);
+    for (btn, bit) in [
+        (Btn::X, ButtonMask::X),
+        (Btn::Y, ButtonMask::Y),
+        (Btn::L1, ButtonMask::L),
+        (Btn::R1, ButtonMask::R),
+    ] {
+        r.press(btn);
+        assert_eq!(r.pad() & bit, bit, "{btn:?} never reached the core");
+        r.release(btn);
+        assert_eq!(r.pad() & bit, 0, "{btn:?} stuck down");
+    }
+}
+
+#[test]
+fn r2_still_fast_forwards_and_l2_and_r2_never_reach_the_snes_core() {
+    let mut r = rig(Platform::Snes);
+    r.press(Btn::L2);
+    assert_eq!(r.pad(), 0);
+    r.release(Btn::L2);
+    r.press(Btn::R2);
+    r.session.update(1.0 / 60.0);
+    assert_eq!(r.pad(), 0);
+    assert_eq!(r.session.app().ff_badge(), Some(Icon::FastForward));
+    r.release(Btn::R2);
+}
+
+#[test]
+fn a_select_tap_reaches_the_snes_core() {
+    let mut r = rig(Platform::Snes);
+    r.press(Btn::Select);
+    r.release(Btn::Select);
+    assert_eq!(r.pad() & ButtonMask::SELECT, ButtonMask::SELECT);
+    r.wait(100);
+    assert_eq!(r.pad() & ButtonMask::SELECT, 0);
+}
+
+#[test]
+fn select_and_r1_save_a_state_on_snes_without_sending_r() {
+    let mut r = rig(Platform::Snes);
+    r.chord(Btn::R1);
+    for _ in 0..200 {
+        if r.states(Platform::Snes, Core::Snes9x) > 0 {
+            break;
+        }
+        r.session.update(1.0 / 60.0);
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+    assert_eq!(r.states(Platform::Snes, Core::Snes9x), 1);
+    assert_eq!(r.ever & ButtonMask::R, 0, "R was sent to the game");
+}
+
+#[test]
+fn select_and_l1_load_on_snes_without_sending_l() {
+    let mut r = rig(Platform::Snes);
+    r.chord(Btn::L1);
+    assert_eq!(r.ever & ButtonMask::L, 0, "L was sent to the game");
+}
+
+#[test]
+fn select_and_y_on_snes_sends_no_y_changes_nothing_and_says_nothing() {
+    let mut r = rig(Platform::Snes);
+    let (before, saved) = (r.colour(), r.saved_colour());
+    r.chord(Btn::Y);
+    r.session.update(1.0 / 60.0);
+    assert_eq!(r.ever & ButtonMask::Y, 0, "Y was sent to the game");
+    assert_eq!(r.colour(), before);
+    assert_eq!(r.saved_colour(), saved);
+    assert_eq!(r.session.app().toast(), None);
+    assert!(matches!(r.session.app().phase(), Phase::Playing { .. }));
+}
+
+#[test]
+fn select_and_y_on_nes_changes_nothing_and_says_nothing() {
+    let mut r = rig(Platform::Nes);
+    let before = r.colour();
+    r.chord(Btn::Y);
+    assert_eq!(r.ever & ButtonMask::Y, 0);
+    assert_eq!(r.colour(), before);
+    assert_eq!(r.session.app().toast(), None);
+}
+
+#[test]
+fn select_and_y_still_flip_colour_correction_on_a_gba_cart() {
+    let mut r = rig(Platform::Gba);
+    let before = r.colour();
+    r.chord(Btn::Y);
+    assert_eq!(r.colour(), !before);
+    assert!(r
+        .session
+        .app()
+        .toast()
+        .is_some_and(|t| matches!(t, Toast::ColourOn | Toast::ColourOff)));
+}
+
+#[test]
+fn select_and_x_on_snes_never_sends_x_and_toggles_the_picture_mode_both_ways() {
+    let mut r = rig(Platform::Snes);
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    r.chord(Btn::X);
+    assert_ne!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(r.picture(), slot::video_mode::VideoMode::Stretch);
+    r.chord(Btn::X);
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(r.picture(), slot::video_mode::VideoMode::Actual);
+    assert_eq!(r.ever & ButtonMask::X, 0, "X was sent to the game");
+}
+
+#[test]
+fn l1_and_r1_do_not_change_the_snes_picture_mode() {
+    let mut r = rig(Platform::Snes);
+    r.press(Btn::L1);
+    r.release(Btn::L1);
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+}
+
+#[test]
+fn select_and_x_on_nes_leave_the_picture_alone_and_x_is_turbo_a() {
+    let mut r = rig(Platform::Nes);
+    r.chord(Btn::X);
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(r.picture(), slot::video_mode::VideoMode::Actual);
+    assert_eq!(r.ever & ButtonMask::X, ButtonMask::X);
+}
+
+#[test]
+fn l1_on_nes_still_stretches_the_picture() {
+    let mut r = rig(Platform::Nes);
+    r.press(Btn::L1);
+    assert_ne!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(r.ever & ButtonMask::L, 0);
+}
+
+#[test]
+fn the_picture_toggle_flips_only_on_snes() {
+    use slot::video_mode::VideoMode::{Actual, Stretch};
+    for platform in Platform::SHELVES {
+        let (from_actual, from_stretch) = match platform {
+            Platform::Snes => (Stretch, Actual),
+            Platform::Gba | Platform::Gb | Platform::Gbc | Platform::Nes => (Actual, Stretch),
+        };
+        assert_eq!(Actual.flipped(platform), from_actual, "{platform:?}");
+        assert_eq!(Stretch.flipped(platform), from_stretch, "{platform:?}");
+    }
+}
+
+#[test]
+fn l2_starts_the_rewind_on_snes_and_never_reaches_the_core() {
+    let mut r = rig(Platform::Snes);
+    r.press(Btn::L2);
+    r.session.update(1.0 / 60.0);
+    assert_eq!(r.session.app().hud_icon(), Icon::Rewind);
+    assert_eq!(r.pad(), 0);
+    r.release(Btn::L2);
+}
