@@ -0,0 +1,42 @@
+use slot_input::Btn;
+use slot_retro::ButtonMask;
+use slot_store::{Controls, GameButton, Platform};
+
+use super::bind::btn_device;
+use super::mask::Pad;
+
+fn raw_buttons(platform: Platform) -> Vec<(Btn, u16)> {
+    let mut raw = Vec::new();
+    if platform.passes_xy_through() {
+        raw.extend([(Btn::X, ButtonMask::X), (Btn::Y, ButtonMask::Y)]);
+    }
+    raw
+}
+
+fn bound_to_game(controls: &Controls, b: Btn) -> bool {
+    GameButton::ALL.into_iter().any(|g| {
+        controls
+            .game(g)
+            .is_some_and(|x| x.modifier.is_none() && Some(x.button) == btn_device(b))
+    })
+}
+
+fn game_buttons(controls: &Controls, platform: Platform) -> Controls {
+    let mut c = *controls;
+    if platform.passes_xy_through() {
+        c.set_game(GameButton::TurboA, None);
+        c.set_game(GameButton::TurboB, None);
+    }
+    c
+}
+
+impl Pad {
+    pub fn mask_for(&self, controls: &Controls, platform: Platform) -> ButtonMask {
+        let controls = game_buttons(controls, platform);
+        let raw = raw_buttons(platform)
+            .into_iter()
+            .filter(|(b, _)| self.holds(*b) && !bound_to_game(&controls, *b))
+            .fold(0, |bits, (_, bit)| bits | bit);
+        ButtonMask(self.mask(&controls).0 | raw)
+    }
+}
