+rumble=1
+ff_speed=6
+ff_sound=0
+colour_correction=0
+shader_gba=grid
+shader_gb=simpletex
+eject_save=1
+turbo=1
+rewind=1
+gb_palettes=0
+gb_palette=DMG Green
+";
+
+fn trace() -> (Vec<(&'static str, u16)>, String, String) {
+    let d = common::tmp_root_with_carts(&[STEM]);
+    common::clocked(d.path());
+    let mut s = Session::boot(d.path().to_path_buf());
+    s.feed([RawEvent::Down(Btn::A)], 16);
+    s.feed([RawEvent::Up(Btn::A)], 32);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !matches!(s.app().phase(), Phase::Playing { .. }) {
+        assert!(Instant::now() < deadline, "the cart never seated");
+        s.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    assert_eq!(s.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    let mut now: Millis = 100;
+    let mut seen = Vec::new();
+    let script: &[(&'static str, Option<RawEvent>, Millis)] = &[
+        ("select down", Some(RawEvent::Down(Btn::Select)), 20),
+        (
+            "x down in the chord window",
+            Some(RawEvent::Down(Btn::X)),
+            20,
+        ),
+        ("x up", Some(RawEvent::Up(Btn::X)), 20),
+        ("select up", Some(RawEvent::Up(Btn::Select)), 20),
+        ("settle", None, 200),
+        ("select down again", Some(RawEvent::Down(Btn::Select)), 20),
+        ("select held past the chord window", None, 700),
+        ("x down after the window", Some(RawEvent::Down(Btn::X)), 20),
+        ("x up after the window", Some(RawEvent::Up(Btn::X)), 20),
+        (
+            "select up after the window",
+            Some(RawEvent::Up(Btn::Select)),
+            20,
+        ),
+        ("settle again", None, 200),
+        ("x alone down", Some(RawEvent::Down(Btn::X)), 20),
+        ("x alone up", Some(RawEvent::Up(Btn::X)), 20),
+    ];
+    for (name, ev, dt) in script {
+        now += dt;
+        s.feed(ev.iter().copied(), now);
+        seen.push((*name, s.emu().expect("core").input().0));
+    }
+    assert_eq!(s.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    s.app().flush_state();
+    let state = std::fs::read_to_string(d.path().join("Config/slot.state")).unwrap_or_default();
+    let mode = std::fs::read_to_string(d.path().join("Config/video_mode.txt")).unwrap_or_default();
+    (seen, state, mode)
+}
+
+#[test]
+fn select_and_x_on_a_gba_cart_send_the_same_masks_and_leave_the_same_state_as_upstream() {
+    let (seen, state, mode) = trace();
+    assert_eq!(seen, EXPECTED);
+    assert_eq!(state, EXPECTED_STATE);
+    assert_eq!(mode, "");
+}
diff --git a/crates/slot/tests/snes_emu_input.rs b/crates/slot/tests/snes_emu_input.rs
new file mode 100644
index 0000000..1f315a7
--- /dev/null
+++ b/crates/slot/tests/snes_emu_input.rs
@@ -0,0 +1,117 @@
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use slot::audio::{AudioSink, StubSink};
+use slot::emu::{CoreState, EmuHandle, Speed};
+use slot_retro::{AvInfo, ButtonMask, CoreError, MockCore, RetroCore};
+
+const XY: u16 = ButtonMask::X | ButtonMask::Y;
+const LR: u16 = ButtonMask::L | ButtonMask::R;
+
+struct Recorder {
+    inner: MockCore,
+    seen: Arc<Mutex<Vec<u16>>>,
+}
+
+impl RetroCore for Recorder {
+    fn load(&mut self, rom: &Path) -> Result<(), CoreError> {
+        self.inner.load(rom)
+    }
+    fn run_frame(&mut self, input: ButtonMask) {
+        self.seen.lock().expect("seen").push(input.0);
+        self.inner.run_frame(input);
+    }
+    fn video_xrgb8888(&self) -> &[u8] {
+        self.inner.video_xrgb8888()
+    }
+    fn take_audio(&mut self) -> Vec<i16> {
+        self.inner.take_audio()
+    }
+    fn serialize(&mut self) -> Result<Vec<u8>, CoreError> {
+        self.inner.serialize()
+    }
+    fn unserialize(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.unserialize(data)
+    }
+    fn save_ram(&self) -> Option<Vec<u8>> {
+        self.inner.save_ram()
+    }
+    fn load_save_ram(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.load_save_ram(data)
+    }
+    fn av_info(&self) -> AvInfo {
+        self.inner.av_info()
+    }
+}
+
+fn held_masks(pass_through: bool, turbo: bool) -> Vec<u16> {
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let mut sink = StubSink::new();
+    sink.open(32_768).expect("the stub refused to open");
+    let drain = sink.clone();
+    std::thread::spawn(move || loop {
+        drain.device_drain();
+        std::thread::sleep(Duration::from_millis(2));
+    });
+    let core = Recorder {
+        inner: MockCore::new(),
+        seen: seen.clone(),
+    };
+    let emu = EmuHandle::spawn(
+        Box::new(core),
+        PathBuf::from("mock"),
+        sink.ring(),
+        None,
+        None,
+    );
+    emu.set_pass_through(pass_through);
+    emu.set_turbo(turbo);
+    emu.set_input(ButtonMask(XY | LR));
+    emu.set_speed(Speed::Normal);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while seen
+        .lock()
+        .expect("seen")
+        .iter()
+        .filter(|m| **m != 0)
+        .count()
+        < 12
+    {
+        assert!(Instant::now() < deadline, "the core never ran 12 frames");
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    assert_eq!(emu.state(), CoreState::Ready);
+    let held = seen
+        .lock()
+        .expect("seen")
+        .iter()
+        .copied()
+        .filter(|m| *m != 0)
+        .collect();
+    held
+}
+
+#[test]
+fn x_y_l_and_r_reach_the_core_on_every_frame_with_turbo_on() {
+    for mask in held_masks(true, true) {
+        assert_eq!(mask, XY | LR);
+    }
+}
+
+#[test]
+fn x_y_l_and_r_reach_the_core_on_every_frame_with_turbo_off() {
+    for mask in held_masks(true, false) {
+        assert_eq!(mask, XY | LR);
+    }
+}
+
+#[test]
+fn without_pass_through_the_core_never_sees_x_or_y() {
+    for turbo in [true, false] {
+        for mask in held_masks(false, turbo) {
+            assert_eq!(mask & XY, 0);
+            assert_eq!(mask & LR, LR);
+        }
+    }
+}
