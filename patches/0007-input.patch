diff --git a/crates/slot/src/snes_input.rs b/crates/slot/src/snes_input.rs
new file mode 100644
index 0000000..5e5659a
--- /dev/null
+++ b/crates/slot/src/snes_input.rs
@@ -0,0 +1,20 @@
+use slot_input::{Action, Entry};
+use slot_store::Platform;
+
+use crate::video_mode::VideoMode;
+
+impl VideoMode {
+    pub fn flipped(self, platform: Platform) -> VideoMode {
+        match (platform, self) {
+            (Platform::Snes, VideoMode::Actual) => VideoMode::Stretch,
+            (Platform::Snes, VideoMode::Stretch) => VideoMode::Actual,
+            (Platform::Gba | Platform::Gb | Platform::Gbc | Platform::Nes, mode) => mode,
+        }
+    }
+}
+
+pub fn keep_applicable(entries: &mut Vec<Entry>, platform: Platform) {
+    if !platform.select_x_toggles_picture() {
+        entries.retain(|e| e.action != Action::VideoModeToggle);
+    }
+}
diff --git a/crates/slot/tests/input_common/mod.rs b/crates/slot/tests/input_common/mod.rs
new file mode 100644
index 0000000..e382d1e
--- /dev/null
+++ b/crates/slot/tests/input_common/mod.rs
@@ -0,0 +1,27 @@
+use std::time::{Duration, Instant};
+
+use slot::app::Phase;
+use slot::session::Session;
+use slot_input::{Btn, RawEvent};
+use slot_store::Platform;
+use tempfile::TempDir;
+
+use crate::common;
+
+pub fn playing(platform: Platform, stem: &str) -> (TempDir, Session) {
+    let root = common::tmp_root_with_real_carts(&[]);
+    let dir = root.path().join("Games").join(platform.dir_name());
+    let cart = dir.join(format!("{stem}.{}", platform.extensions()[0]));
+    std::fs::write(cart, vec![0u8; 0x200]).expect("write cart");
+    common::clocked(root.path());
+    let mut session = Session::boot(root.path().to_path_buf());
+    session.feed([RawEvent::Down(Btn::A)], 16);
+    session.feed([RawEvent::Up(Btn::A)], 32);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !matches!(session.app().phase(), Phase::Playing { .. }) {
+        assert!(Instant::now() < deadline, "the cart never seated");
+        session.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    (root, session)
+}
