index 0000000..d9c9691
--- /dev/null
+++ b/crates/slot/tests/select_x_gba.rs
@@ -0,0 +1,106 @@
+mod common;
+
+use std::time::{Duration, Instant};
+
+use slot::app::Phase;
+use slot::session::Session;
+use slot_input::{Btn, Millis, RawEvent};
+
+const STEM: &str = "ZZZ";
+
+const EXPECTED: [(&str, u16); 13] = [
+    ("select down", 0),
+    ("x down in the chord window", 516),
+    ("x up", 4),
+    ("select up", 4),
+    ("settle", 0),
+    ("select down again", 0),
+    ("select held past the chord window", 4),
+    ("x down after the window", 516),
+    ("x up after the window", 4),
+    ("select up after the window", 0),
+    ("settle again", 0),
+    ("x alone down", 512),
+    ("x alone up", 0),
+];
+
+const EXPECTED_STATE: &str = "cart=ZZZ
+cart_platform=gba
+brightness=5
+blue_light=0
+volume=60
+volume_hp=60
+muted=0
+muted_hp=0
+clock_set=1
+utc_offset_min=0
+rumble=1
+ff_speed=6
+ff_sound=0
+colour_correction=0
+shader_gba=grid
+shader_gb=simpletex
+eject_save=1
+turbo=1
+rewind=1
+gb_palettes=0
+gb_palette=DMG Green
+";
+
+fn trace() -> (Vec<(&'static str, u16)>, String, String) {
+    let d = common::tmp_root_with_carts(&[STEM]);
+    common::clocked(d.path());
+    let mut s = Session::boot(d.path().to_path_buf());
+    s.feed([RawEvent::Down(Btn::A)], 16);
+    s.feed([RawEvent::Up(Btn::A)], 32);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !matches!(s.app().phase(), Phase::Playing { .. }) {
+        assert!(Instant::now() < deadline, "the cart never seated");
+        s.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    assert_eq!(s.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    let mut now: Millis = 100;
+    let mut seen = Vec::new();
+    let script: &[(&'static str, Option<RawEvent>, Millis)] = &[
+        ("select down", Some(RawEvent::Down(Btn::Select)), 20),
+        (
+            "x down in the chord window",
+            Some(RawEvent::Down(Btn::X)),
+            20,
+        ),
+        ("x up", Some(RawEvent::Up(Btn::X)), 20),
+        ("select up", Some(RawEvent::Up(Btn::Select)), 20),
+        ("settle", None, 200),
+        ("select down again", Some(RawEvent::Down(Btn::Select)), 20),
+        ("select held past the chord window", None, 700),
+        ("x down after the window", Some(RawEvent::Down(Btn::X)), 20),
+        ("x up after the window", Some(RawEvent::Up(Btn::X)), 20),
+        (
+            "select up after the window",
+            Some(RawEvent::Up(Btn::Select)),
+            20,
+        ),
+        ("settle again", None, 200),
+        ("x alone down", Some(RawEvent::Down(Btn::X)), 20),
+        ("x alone up", Some(RawEvent::Up(Btn::X)), 20),
+    ];
+    for (name, ev, dt) in script {
+        now += dt;
+        s.feed(ev.iter().copied(), now);
+        seen.push((*name, s.emu().expect("core").input().0));
+    }
+    assert_eq!(s.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    s.app().flush_state();
+    let state = std::fs::read_to_string(d.path().join("Config/slot.state")).unwrap_or_default();
+    let mode = std::fs::read_to_string(d.path().join("Config/video_mode.txt")).unwrap_or_default();
+    (seen, state, mode)
+}
+
+#[test]
+fn select_and_x_on_a_gba_cart_send_the_same_masks_and_leave_the_same_state_as_upstream() {
+    let (seen, state, mode) = trace();
+    assert_eq!(seen, EXPECTED);
+    assert_eq!(state, EXPECTED_STATE);
+    assert_eq!(mode, "");
+}
diff --git a/crates/slot/tests/snes_emu_input.rs b/crates/slot/tests/snes_emu_input.rs
new file mode 100644
index 0000000..1f315a7
--- /dev/null
+++ b/crates/slot/tests/snes_emu_input.rs
@@ -0,0 +1,117 @@
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use slot::audio::{AudioSink, StubSink};
+use slot::emu::{CoreState, EmuHandle, Speed};
+use slot_retro::{AvInfo, ButtonMask, CoreError, MockCore, RetroCore};
+
+const XY: u16 = ButtonMask::X | ButtonMask::Y;
+const LR: u16 = ButtonMask::L | ButtonMask::R;
+
+struct Recorder {
+    inner: MockCore,
+    seen: Arc<Mutex<Vec<u16>>>,
+}
+
+impl RetroCore for Recorder {
+    fn load(&mut self, rom: &Path) -> Result<(), CoreError> {
+        self.inner.load(rom)
+    }
+    fn run_frame(&mut self, input: ButtonMask) {
+        self.seen.lock().expect("seen").push(input.0);
+        self.inner.run_frame(input);
+    }
+    fn video_xrgb8888(&self) -> &[u8] {
+        self.inner.video_xrgb8888()
+    }
+    fn take_audio(&mut self) -> Vec<i16> {
+        self.inner.take_audio()
+    }
+    fn serialize(&mut self) -> Result<Vec<u8>, CoreError> {
+        self.inner.serialize()
+    }
+    fn unserialize(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.unserialize(data)
+    }
+    fn save_ram(&self) -> Option<Vec<u8>> {
+        self.inner.save_ram()
+    }
+    fn load_save_ram(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.load_save_ram(data)
+    }
+    fn av_info(&self) -> AvInfo {
+        self.inner.av_info()
+    }
+}
+
+fn held_masks(pass_through: bool, turbo: bool) -> Vec<u16> {
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let mut sink = StubSink::new();
+    sink.open(32_768).expect("the stub refused to open");
+    let drain = sink.clone();
+    std::thread::spawn(move || loop {
+        drain.device_drain();
+        std::thread::sleep(Duration::from_millis(2));
+    });
+    let core = Recorder {
+        inner: MockCore::new(),
+        seen: seen.clone(),
+    };
+    let emu = EmuHandle::spawn(
+        Box::new(core),
+        PathBuf::from("mock"),
+        sink.ring(),
+        None,
+        None,
+    );
+    emu.set_pass_through(pass_through);
+    emu.set_turbo(turbo);
+    emu.set_input(ButtonMask(XY | LR));
+    emu.set_speed(Speed::Normal);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while seen
+        .lock()
+        .expect("seen")
+        .iter()
+        .filter(|m| **m != 0)
+        .count()
+        < 12
+    {
+        assert!(Instant::now() < deadline, "the core never ran 12 frames");
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    assert_eq!(emu.state(), CoreState::Ready);
+    let held = seen
+        .lock()
+        .expect("seen")
+        .iter()
+        .copied()
+        .filter(|m| *m != 0)
+        .collect();
+    held
+}
+
+#[test]
+fn x_y_l_and_r_reach_the_core_on_every_frame_with_turbo_on() {
+    for mask in held_masks(true, true) {
+        assert_eq!(mask, XY | LR);
+    }
+}
+
+#[test]
+fn x_y_l_and_r_reach_the_core_on_every_frame_with_turbo_off() {
+    for mask in held_masks(true, false) {
+        assert_eq!(mask, XY | LR);
+    }
+}
+
+#[test]
+fn without_pass_through_the_core_never_sees_x_or_y() {
+    for turbo in [true, false] {
+        for mask in held_masks(false, turbo) {
+            assert_eq!(mask & XY, 0);
+            assert_eq!(mask & LR, LR);
+        }
+    }
+}
diff --git a/crates/slot/tests/snes_select.rs b/crates/slot/tests/snes_select.rs
new file mode 100644
index 0000000..37ff520
--- /dev/null
+++ b/crates/slot/tests/snes_select.rs
@@ -0,0 +1,258 @@
+mod common;
+mod input_common;
+
+use input_common::playing;
+use slot::app::Phase;
+use slot::session::Session;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{read_slot_state, Core, Platform, StateRing};
+use slot_ui::{Icon, Toast};
+use tempfile::TempDir;
+
+const STEM: &str = "Zzz";
+
+struct Rig {
+    root: TempDir,
+    session: Session,
+    now: Millis,
+    ever: u16,
+}
+
+fn rig(platform: Platform) -> Rig {
+    let (root, session) = playing(platform, STEM);
+    Rig {
+        root,
+        session,
+        now: 100,
+        ever: 0,
+    }
+}
+
+impl Rig {
+    fn feed(&mut self, ev: RawEvent) {
+        self.now += 20;
+        self.session.feed([ev], self.now);
+        self.ever |= self.pad();
+    }
+
+    fn press(&mut self, b: Btn) {
+        self.feed(RawEvent::Down(b));
+    }
+
+    fn release(&mut self, b: Btn) {
+        self.feed(RawEvent::Up(b));
+    }
+
+    fn chord(&mut self, b: Btn) {
+        self.press(Btn::Select);
+        self.press(b);
+        self.release(b);
+        self.release(Btn::Select);
+    }
+
+    fn wait(&mut self, ms: Millis) {
+        self.now += ms;
+        self.session.feed([], self.now);
+    }
+
+    fn pad(&self) -> u16 {
+        self.session.emu().expect("no core in the slot").input().0
+    }
+
+    fn colour(&self) -> bool {
+        self.session.app().colour_correction()
+    }
+
+    fn saved_colour(&self) -> bool {
+        self.session.app().flush_state();
+        read_slot_state(self.root.path()).colour_correction
+    }
+
+    fn picture(&self) -> slot::video_mode::VideoMode {
+        slot::video_mode::video_mode_for(self.root.path(), STEM)
+    }
+
+    fn states(&self, platform: Platform, core: Core) -> usize {
+        StateRing::new(self.root.path(), platform, core, STEM)
+            .list()
+            .expect("list the ring")
+            .len()
+    }
+}
+
+#[test]
+fn a_snes_game_is_run_with_x_and_y_passed_through() {
+    assert!(rig(Platform::Snes)
+        .session
+        .emu()
+        .expect("core")
+        .passes_through());
+}
+
+#[test]
+fn a_nes_game_is_not_run_with_x_and_y_passed_through() {
+    assert!(!rig(Platform::Nes)
+        .session
+        .emu()
+        .expect("core")
+        .passes_through());
+}
+
+#[test]
+fn x_y_l_and_r_reach_the_snes_core() {
+    let mut r = rig(Platform::Snes);
+    for (btn, bit) in [
+        (Btn::X, ButtonMask::X),
+        (Btn::Y, ButtonMask::Y),
+        (Btn::L1, ButtonMask::L),
+        (Btn::R1, ButtonMask::R),
+    ] {
+        r.press(btn);
+        assert_eq!(r.pad() & bit, bit, "{btn:?} never reached the core");
+        r.release(btn);
+        assert_eq!(r.pad() & bit, 0, "{btn:?} stuck down");
+    }
+}
+
+#[test]
+fn r2_still_fast_forwards_and_l2_and_r2_never_reach_the_snes_core() {
+    let mut r = rig(Platform::Snes);
+    r.press(Btn::L2);
+    assert_eq!(r.pad(), 0);
+    r.release(Btn::L2);
+    r.press(Btn::R2);
+    r.session.update(1.0 / 60.0);
+    assert_eq!(r.pad(), 0);
+    assert_eq!(r.session.app().ff_badge(), Some(Icon::FastForward));
+    r.release(Btn::R2);
+}
+
+#[test]
+fn a_select_tap_reaches_the_snes_core() {
+    let mut r = rig(Platform::Snes);
+    r.press(Btn::Select);
+    r.release(Btn::Select);
+    assert_eq!(r.pad() & ButtonMask::SELECT, ButtonMask::SELECT);
+    r.wait(100);
+    assert_eq!(r.pad() & ButtonMask::SELECT, 0);
+}
+
+#[test]
+fn select_and_r1_save_a_state_on_snes_without_sending_r() {
+    let mut r = rig(Platform::Snes);
+    r.chord(Btn::R1);
+    for _ in 0..200 {
+        if r.states(Platform::Snes, Core::Snes9x) > 0 {
+            break;
+        }
+        r.session.update(1.0 / 60.0);
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+    assert_eq!(r.states(Platform::Snes, Core::Snes9x), 1);
+    assert_eq!(r.ever & ButtonMask::R, 0, "R was sent to the game");
+}
+
+#[test]
+fn select_and_l1_load_on_snes_without_sending_l() {
+    let mut r = rig(Platform::Snes);
+    r.chord(Btn::L1);
+    assert_eq!(r.ever & ButtonMask::L, 0, "L was sent to the game");
+}
+
+#[test]
+fn select_and_y_on_snes_sends_no_y_changes_nothing_and_says_nothing() {
+    let mut r = rig(Platform::Snes);
+    let (before, saved) = (r.colour(), r.saved_colour());
+    r.chord(Btn::Y);
+    r.session.update(1.0 / 60.0);
+    assert_eq!(r.ever & ButtonMask::Y, 0, "Y was sent to the game");
+    assert_eq!(r.colour(), before);
+    assert_eq!(r.saved_colour(), saved);
+    assert_eq!(r.session.app().toast(), None);
+    assert!(matches!(r.session.app().phase(), Phase::Playing { .. }));
+}
+
+#[test]
+fn select_and_y_on_nes_changes_nothing_and_says_nothing() {
+    let mut r = rig(Platform::Nes);
+    let before = r.colour();
+    r.chord(Btn::Y);
+    assert_eq!(r.ever & ButtonMask::Y, 0);
+    assert_eq!(r.colour(), before);
+    assert_eq!(r.session.app().toast(), None);
+}
+
+#[test]
+fn select_and_y_still_flip_colour_correction_on_a_gba_cart() {
+    let mut r = rig(Platform::Gba);
+    let before = r.colour();
+    r.chord(Btn::Y);
+    assert_eq!(r.colour(), !before);
+    assert!(r
+        .session
+        .app()
+        .toast()
+        .is_some_and(|t| matches!(t, Toast::ColourOn | Toast::ColourOff)));
+}
+
+#[test]
+fn select_and_x_on_snes_never_sends_x_and_toggles_the_picture_mode_both_ways() {
+    let mut r = rig(Platform::Snes);
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    r.chord(Btn::X);
+    assert_ne!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(r.picture(), slot::video_mode::VideoMode::Stretch);
+    r.chord(Btn::X);
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(r.picture(), slot::video_mode::VideoMode::Actual);
+    assert_eq!(r.ever & ButtonMask::X, 0, "X was sent to the game");
+}
+
+#[test]
+fn l1_and_r1_do_not_change_the_snes_picture_mode() {
+    let mut r = rig(Platform::Snes);
+    r.press(Btn::L1);
+    r.release(Btn::L1);
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+}
+
+#[test]
+fn select_and_x_on_nes_leave_the_picture_alone_and_x_goes_down() {
+    let mut r = rig(Platform::Nes);
+    r.chord(Btn::X);
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(r.picture(), slot::video_mode::VideoMode::Actual);
+    assert_eq!(r.ever & ButtonMask::X, ButtonMask::X);
+}
+
+#[test]
+fn l1_on_nes_still_stretches_the_picture() {
+    let mut r = rig(Platform::Nes);
+    r.press(Btn::L1);
+    assert_ne!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(r.ever & ButtonMask::L, 0);
+}
+
+#[test]
+fn the_picture_toggle_flips_only_on_snes() {
+    use slot::video_mode::VideoMode::{Actual, Stretch};
+    for platform in Platform::SHELVES {
+        let (from_actual, from_stretch) = match platform {
+            Platform::Snes => (Stretch, Actual),
+            Platform::Gba | Platform::Gb | Platform::Gbc | Platform::Nes => (Actual, Stretch),
+        };
+        assert_eq!(Actual.flipped(platform), from_actual, "{platform:?}");
+        assert_eq!(Stretch.flipped(platform), from_stretch, "{platform:?}");
+    }
+}
+
+#[test]
+fn l2_starts_the_rewind_on_snes_and_never_reaches_the_core() {
+    let mut r = rig(Platform::Snes);
+    r.press(Btn::L2);
+    r.session.update(1.0 / 60.0);
+    assert_eq!(r.session.app().hud_icon(), Icon::Rewind);
+    assert_eq!(r.pad(), 0);
+    r.release(Btn::L2);
+}
