+#[test]
+fn the_sega_cd_shader_walks_the_retro_list_into_its_own_file_and_leaves_the_mega_drive_alone() {
+    let (root, mut app) = card_with_a_disc();
+    open_segacd(&mut app);
+    assert_eq!(
+        app.quick_value(QuickRow::SegaCdShader),
+        Some(QuickValue::Off)
+    );
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(read_sega_shaders(root.path()).segacd);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(SEGACD_SHADER_FILE).exists());
+    assert_eq!(read_sega_shaders(root.path()).md, Shader::Off);
+}
