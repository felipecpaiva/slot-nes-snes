+#[test]
+fn pal_speed_is_sega_cds_own_and_leaves_the_mega_drive_native() {
+    let (root, mut app) = card_with_a_disc();
+    open_segacd(&mut app);
+    press(&mut app, Btn::Down);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::SegaCdPalSpeed));
+    assert_eq!(
+        app.quick_value(QuickRow::SegaCdPalSpeed),
+        Some(QuickValue::Native)
+    );
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_eq!(
+        app.quick_value(QuickRow::SegaCdPalSpeed),
+        Some(QuickValue::Panel)
+    );
+    assert_eq!(
+        app.quick_value(QuickRow::MdPalSpeed),
+        Some(QuickValue::Native)
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PAL_SPEED_FILE)).ok(),
+        Some("segacd = panel\n".to_string())
+    );
+}
