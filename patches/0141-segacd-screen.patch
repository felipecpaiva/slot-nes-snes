+#[test]
+fn the_picture_is_the_mega_drive_picture_with_four_three_and_its_own_line() {
+    assert_eq!(
+        default_video_mode(Platform::SegaCd),
+        default_video_mode(Platform::Md)
+    );
+    assert_eq!(
+        picture_choices(Platform::SegaCd),
+        picture_choices(Platform::Md)
+    );
+    assert!(picture_choices(Platform::SegaCd).contains(&VideoMode::FourThree));
+    let canvas = Core::GenesisPlusGx.canvas(Platform::SegaCd);
+    for frame in [(256, 224), (320, 224)] {
+        for mode in picture_choices(Platform::SegaCd) {
+            assert_eq!(
+                source_rect(Platform::SegaCd, frame, canvas, *mode),
+                source_rect(Platform::Md, frame, canvas, *mode),
+                "{mode:?} {frame:?}"
+            );
+        }
+    }
+    let (root, mut app) = card_with_a_disc();
+    open_segacd(&mut app);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::SegaCdPicture));
+    let first = app.quick_value(QuickRow::SegaCdPicture);
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_ne!(app.quick_value(QuickRow::SegaCdPicture), first);
+    assert_ne!(
+        system_picture(root.path(), Platform::SegaCd),
+        default_video_mode(Platform::SegaCd)
+    );
+    assert_eq!(
+        system_picture(root.path(), Platform::Md),
+        default_video_mode(Platform::Md)
+    );
+    let text = std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt");
+    assert!(text.starts_with("segacd = "), "{text:?}");
+}
