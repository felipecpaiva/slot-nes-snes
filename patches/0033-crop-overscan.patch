--- /dev/null
+++ b/crates/slot/tests/crop_overscan.rs
@@ -0,0 +1,237 @@
+mod common;
+mod input_common;
+
+use slot::platform_video::{
+    default_video_mode, picture_choices, shown, system_picture, video_mode_for,
+    write_system_picture,
+};
+use slot::video_mode::{source_rect, write_video_mode, VideoMode, VIDEO_MODE_FILE};
+use slot_store::Platform;
+use tempfile::TempDir;
+
+use VideoMode::{Actual, Crop, Stretch};
+
+const CANVAS: (u32, u32) = (360, 240);
+const STEM: &str = "Zzz";
+
+fn rect(platform: Platform, frame_w: u32, mode: VideoMode) -> [f32; 4] {
+    source_rect(platform, shown(platform, frame_w, mode), CANVAS, mode)
+}
+
+fn px(x: u32, y: u32, w: u32, h: u32) -> [f32; 4] {
+    [
+        x as f32 / 360.0,
+        y as f32 / 240.0,
+        w as f32 / 360.0,
+        h as f32 / 240.0,
+    ]
+}
+
+fn config_root() -> TempDir {
+    let d = tempfile::tempdir().expect("tempdir");
+    std::fs::create_dir(d.path().join("Config")).expect("config dir");
+    d
+}
+
+#[test]
+fn nes_crop_takes_eight_pixels_off_every_edge_of_the_240_line_picture() {
+    assert_eq!(rect(Platform::Nes, 256, Crop), px(60, 8, 240, 224));
+    assert_eq!(rect(Platform::Nes, 256, Stretch), px(52, 0, 256, 240));
+    assert_eq!(rect(Platform::Nes, 256, Actual), slot_gfx::WHOLE_TEXTURE);
+}
+
+#[test]
+fn snes_crop_takes_eight_lines_off_the_top_and_bottom_and_nothing_off_the_sides() {
+    assert_eq!(rect(Platform::Snes, 256, Crop), px(52, 16, 256, 208));
+    assert_eq!(rect(Platform::Snes, 256, Stretch), px(52, 8, 256, 224));
+    assert_eq!(rect(Platform::Snes, 256, Actual), slot_gfx::WHOLE_TEXTURE);
+}
+
+#[test]
+fn a_239_line_snes_frame_crops_to_the_same_208_lines_as_a_224_line_one() {
+    for frame_w in [0, 256] {
+        assert_eq!(rect(Platform::Snes, frame_w, Crop), px(52, 16, 256, 208));
+    }
+}
+
+#[test]
+fn nes_and_snes_start_in_crop_and_the_other_systems_keep_their_defaults() {
+    assert_eq!(default_video_mode(Platform::Nes), Crop);
+    assert_eq!(default_video_mode(Platform::Snes), Crop);
+    assert_eq!(default_video_mode(Platform::Sms), Stretch);
+    assert_eq!(default_video_mode(Platform::Md), Stretch);
+    assert_eq!(default_video_mode(Platform::Gg), Actual);
+    for p in [Platform::Gba, Platform::Gb, Platform::Gbc] {
+        assert_eq!(default_video_mode(p), Actual, "{p:?}");
+    }
+}
+
+#[test]
+fn only_nes_and_snes_offer_crop_and_it_comes_first() {
+    for platform in Platform::SHELVES {
+        let want: &[VideoMode] = match platform {
+            Platform::Nes | Platform::Snes => &[Crop, Stretch, Actual],
+            Platform::Gba
+            | Platform::Gb
+            | Platform::Gbc
+            | Platform::Gg
+            | Platform::Sms
+            | Platform::Md => &[Stretch, Actual],
+        };
+        assert_eq!(picture_choices(platform), want, "{platform:?}");
+    }
+}
+
+#[test]
+fn the_picture_row_cycles_crop_stretch_actual_one_way_and_back_the_other() {
+    for p in [Platform::Nes, Platform::Snes] {
+        assert_eq!(Crop.stepped(p, true), Stretch);
+        assert_eq!(Stretch.stepped(p, true), Actual);
+        assert_eq!(Actual.stepped(p, true), Crop);
+        assert_eq!(Crop.stepped(p, false), Actual);
+        assert_eq!(Actual.stepped(p, false), Stretch);
+        assert_eq!(Stretch.stepped(p, false), Crop);
+    }
+    assert_eq!(Stretch.stepped(Platform::Md, true), Actual);
+    assert_eq!(Actual.stepped(Platform::Md, true), Stretch);
+    assert_eq!(Crop.stepped(Platform::Md, true), Stretch);
+}
+
+#[test]
+fn l1_on_nes_moves_between_crop_and_stretch_and_stays_stretch_elsewhere() {
+    assert_eq!(Actual.stretched(Platform::Nes), Crop);
+    assert_eq!(Crop.stretched(Platform::Nes), Stretch);
+    assert_eq!(Stretch.stretched(Platform::Nes), Crop);
+    for p in [Platform::Gb, Platform::Gbc, Platform::Gg, Platform::Sms] {
+        for mode in [Actual, Stretch, Crop] {
+            assert_eq!(mode.stretched(p), Stretch, "{p:?} {mode:?}");
+        }
+    }
+}
+
+#[test]
+fn a_crop_line_round_trips_through_both_files() {
+    let d = config_root();
+    write_video_mode(d.path(), STEM, Crop).expect("write video_mode.txt");
+    let line = std::fs::read_to_string(d.path().join(VIDEO_MODE_FILE)).expect("read back");
+    assert!(line.contains("crop"), "{line}");
+    assert_eq!(video_mode_for(d.path(), STEM, Platform::Snes), Crop);
+    write_system_picture(d.path(), Platform::Nes, Stretch).expect("write picture.txt");
+    assert_eq!(system_picture(d.path(), Platform::Nes), Stretch);
+    write_system_picture(d.path(), Platform::Nes, Crop).expect("write picture.txt");
+    assert_eq!(system_picture(d.path(), Platform::Nes), Crop);
+    assert_eq!(VideoMode::parse("Crop"), Some(Crop));
+}
+
+#[test]
+fn a_stretch_line_saved_before_crop_existed_still_means_the_whole_picture() {
+    let d = config_root();
+    std::fs::write(d.path().join(VIDEO_MODE_FILE), format!("{STEM}=stretch\n"))
+        .expect("write video_mode.txt");
+    std::fs::write(
+        d.path().join(slot::platform_video::PICTURE_FILE),
+        "snes = stretch\n",
+    )
+    .expect("write picture.txt");
+    assert_eq!(video_mode_for(d.path(), STEM, Platform::Nes), Stretch);
+    assert_eq!(video_mode_for(d.path(), "Other", Platform::Snes), Stretch);
+    assert_eq!(video_mode_for(d.path(), "Other", Platform::Nes), Crop);
+}
+
+#[test]
+fn crop_on_a_system_without_overscan_draws_the_same_as_stretch() {
+    for p in [Platform::Gg, Platform::Sms, Platform::Md, Platform::Gb] {
+        assert_eq!(p.overscan(), (0, 0), "{p:?}");
+        let canvas = slot_store::Core::default_for(p).canvas(p);
+        assert_eq!(
+            source_rect(p, shown(p, 0, Crop), canvas, Crop),
+            source_rect(p, shown(p, 0, Stretch), canvas, Stretch),
+            "{p:?}"
+        );
+    }
+}
+
+#[test]
+fn a_never_played_nes_cart_seats_with_the_crop_rect() {
+    let (root, session) = input_common::playing(Platform::Nes, STEM);
+    assert_eq!(session.app().source_rect(), px(60, 8, 240, 224));
+    assert!(!root.path().join(VIDEO_MODE_FILE).exists());
+}
+
+#[cfg(target_os = "macos")]
+mod frame {
+    use super::*;
+    use slot_gfx::{Compositor, HeadlessSurface, ScreenEffect, OUT_H, OUT_W};
+
+    fn canvas_with(w: usize, h: usize, blank_top: usize, blank_left: usize) -> Vec<u8> {
+        let (cw, ch) = (CANVAS.0 as usize, CANVAS.1 as usize);
+        let (ox, oy) = ((cw - w) / 2, (ch - h) / 2);
+        let mut buf = vec![0u8; cw * ch * 4];
+        for y in blank_top..h {
+            for x in blank_left..w {
+                let at = ((y + oy) * cw + x + ox) * 4;
+                buf[at..at + 4].copy_from_slice(&[0xff, 0xff, 0xff, 0]);
+            }
+        }
+        buf
+    }
+
+    fn dark(frame: &[u8], x: usize, y: usize) -> bool {
+        let o = (y * OUT_W as usize + x) * 4;
+        frame[o..o + 3].iter().all(|c| *c <= 8)
+    }
+
+    fn black_rows(frame: &[u8]) -> usize {
+        (0..OUT_H as usize)
+            .filter(|y| (0..OUT_W as usize).all(|x| dark(frame, x, *y)))
+            .count()
+    }
+
+    fn black_columns(frame: &[u8]) -> usize {
+        (0..OUT_W as usize)
+            .filter(|x| (0..OUT_H as usize).all(|y| dark(frame, *x, y)))
+            .count()
+    }
+
+    fn drawn(c: &mut Compositor, buf: &[u8], rect: [f32; 4]) -> Vec<u8> {
+        c.set_game_source_rect(rect);
+        c.begin_frame();
+        c.upload_game(buf);
+        c.draw_game();
+        c.read_frame()
+    }
+
+    #[test]
+    fn frames_with_blank_overscan_edges_fill_the_panel_once_cropped() {
+        let Ok(surface) = HeadlessSurface::new() else {
+            return;
+        };
+        let Ok(mut c) = Compositor::new(&surface) else {
+            return;
+        };
+        c.set_game_canvas(CANVAS.0, CANVAS.1);
+        c.set_screen_effect(ScreenEffect::None);
+
+        let nes = canvas_with(256, 240, 8, 8);
+        let stretched = drawn(&mut c, &nes, rect(Platform::Nes, 256, Stretch));
+        assert!(black_rows(&stretched) >= 14, "the test frame has no band");
+        assert!(
+            black_columns(&stretched) >= 20,
+            "the test frame has no band"
+        );
+        let cropped = drawn(&mut c, &nes, rect(Platform::Nes, 256, Crop));
+        assert_eq!(black_rows(&cropped), 0, "nes rows");
+        assert_eq!(black_columns(&cropped), 0, "nes columns");
+
+        for height in [224, 239] {
+            let snes = canvas_with(256, height, 8, 0);
+            let stretched = drawn(&mut c, &snes, rect(Platform::Snes, 256, Stretch));
+            let cropped = drawn(&mut c, &snes, rect(Platform::Snes, 256, Crop));
+            if height == 224 {
+                assert!(black_rows(&stretched) >= 16, "the test frame has no band");
+            }
+            assert_eq!(black_rows(&cropped), 0, "snes {height} rows");
+            assert_eq!(black_columns(&cropped), 0, "snes {height} columns");
+        }
+    }
+}
