diff --git a/crates/slot/src/platform_video.rs b/crates/slot/src/platform_video.rs
index 85c3506..0aedb67 100644
--- a/crates/slot/src/platform_video.rs
+++ b/crates/slot/src/platform_video.rs
@@ -19,7 +19,47 @@ pub const PICTURE_ROWS: [(QuickRow, Platform); 5] = [
 pub fn default_video_mode(platform: Platform) -> VideoMode {
     match platform {
         Platform::Gba | Platform::Gb | Platform::Gbc | Platform::Gg => VideoMode::Actual,
-        Platform::Nes | Platform::Snes | Platform::Sms | Platform::Md => VideoMode::Stretch,
+        Platform::Nes | Platform::Snes => VideoMode::Crop,
+        Platform::Sms | Platform::Md => VideoMode::Stretch,
+    }
+}
+
+pub fn picture_choices(platform: Platform) -> &'static [VideoMode] {
+    if platform.overscan() == (0, 0) {
+        &[VideoMode::Stretch, VideoMode::Actual]
+    } else {
+        &[VideoMode::Crop, VideoMode::Stretch, VideoMode::Actual]
+    }
+}
+
+pub fn shown(platform: Platform, frame_w: u32, mode: VideoMode) -> (u32, u32) {
+    let (w, h) = picture(platform, frame_w);
+    if mode != VideoMode::Crop {
+        return (w, h);
+    }
+    let (x, y) = platform.overscan();
+    (w.saturating_sub(2 * x), h.saturating_sub(2 * y))
+}
+
+impl VideoMode {
+    pub fn stepped(self, platform: Platform, right: bool) -> VideoMode {
+        let choices = picture_choices(platform);
+        let n = choices.len();
+        let next = match choices.iter().position(|m| *m == self) {
+            Some(at) if right => (at + 1) % n,
+            Some(at) => (at + n - 1) % n,
+            None => 0,
+        };
+        choices.get(next).copied().unwrap_or(self)
+    }
+
+    pub fn stretched(self, platform: Platform) -> VideoMode {
+        let crops = picture_choices(platform).contains(&VideoMode::Crop);
+        match self {
+            VideoMode::Crop => VideoMode::Stretch,
+            VideoMode::Actual | VideoMode::Stretch if crops => VideoMode::Crop,
+            VideoMode::Actual | VideoMode::Stretch => VideoMode::Stretch,
+        }
     }
 }
 
@@ -77,6 +117,7 @@ impl VideoMode {
         match self {
             VideoMode::Stretch => QuickValue::Stretch,
             VideoMode::Actual => QuickValue::Actual,
+            VideoMode::Crop => QuickValue::Crop,
         }
     }
 }
@@ -100,14 +141,11 @@ impl SystemPictures {
         self.0.get(at).copied()
     }
 
-    pub fn flip(&mut self, row: QuickRow) -> Option<(Platform, VideoMode)> {
+    pub fn step(&mut self, row: QuickRow, right: bool) -> Option<(Platform, VideoMode)> {
         let at = PICTURE_ROWS.iter().position(|(r, _)| *r == row)?;
         let (_, platform) = PICTURE_ROWS.get(at)?;
         let mode = self.0.get_mut(at)?;
-        *mode = match *mode {
-            VideoMode::Actual => VideoMode::Stretch,
-            VideoMode::Stretch => VideoMode::Actual,
-        };
+        *mode = mode.stepped(*platform, right);
         Some((*platform, *mode))
     }
 }
