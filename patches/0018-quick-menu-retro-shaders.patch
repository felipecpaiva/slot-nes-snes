diff --git a/crates/slot-ui/src/quick_retro.rs b/crates/slot-ui/src/quick_retro.rs
new file mode 100644
index 0000000..89c612f
--- /dev/null
+++ b/crates/slot-ui/src/quick_retro.rs
@@ -0,0 +1,18 @@
+use crate::quick_menu::QuickRow;
+use slot_store::Platform;
+
+impl QuickRow {
+    pub const NES_SCREEN: [QuickRow; 1] = [QuickRow::NesShader];
+    pub const SNES_SCREEN: [QuickRow; 1] = [QuickRow::SnesShader];
+
+    pub fn child_for(self, platform: Platform) -> Option<QuickRow> {
+        if self != QuickRow::Screen {
+            return self.child();
+        }
+        match platform {
+            Platform::Gba | Platform::Gb | Platform::Gbc => self.child(),
+            Platform::Nes => Some(QuickRow::NES_SCREEN[0]),
+            Platform::Snes => Some(QuickRow::SNES_SCREEN[0]),
+        }
+    }
+}
diff --git a/crates/slot-ui/tests/quick_retro.rs b/crates/slot-ui/tests/quick_retro.rs
