--- /dev/null
+++ b/crates/slot-ui/tests/quick_retro.rs
@@ -0,0 +1,34 @@
+use slot_store::Platform;
+use slot_ui::QuickRow;
+
+#[test]
+fn the_nes_and_snes_pages_hold_only_their_own_shader_row() {
+    assert_eq!(QuickRow::NesShader.page(), [QuickRow::NesShader]);
+    assert_eq!(QuickRow::SnesShader.page(), [QuickRow::SnesShader]);
+    assert_eq!(QuickRow::NesShader.label(), "NES Shader");
+    assert_eq!(QuickRow::SnesShader.label(), "SNES Shader");
+    assert_eq!(QuickRow::NesShader.parent(), Some(QuickRow::Screen));
+    assert_eq!(QuickRow::SnesShader.parent(), Some(QuickRow::Screen));
+}
+
+#[test]
+fn the_screen_row_opens_the_page_of_the_shelf_it_is_opened_on() {
+    for platform in [Platform::Gba, Platform::Gb, Platform::Gbc] {
+        assert_eq!(
+            QuickRow::Screen.child_for(platform),
+            Some(QuickRow::GbaShader)
+        );
+    }
+    assert_eq!(
+        QuickRow::Screen.child_for(Platform::Nes),
+        Some(QuickRow::NesShader)
+    );
+    assert_eq!(
+        QuickRow::Screen.child_for(Platform::Snes),
+        Some(QuickRow::SnesShader)
+    );
+    assert_eq!(
+        QuickRow::Game.child_for(Platform::Nes),
+        Some(QuickRow::FastForward)
+    );
+}
