+
+pub fn cps2_colour(title: &str) -> Shell {
+    let tag = title
+        .rsplit_once('(')
+        .map_or(String::new(), |(_, t)| t.to_ascii_lowercase());
+    if tag.contains("rent") {
+        CPS2_YELLOW
+    } else if tag.starts_with("japan") {
+        CPS2_GREEN
+    } else if tag.starts_with("asia") {
+        CPS2_GREY
+    } else if tag.starts_with("hispanic") || tag.starts_with("brazil") {
+        CPS2_ORANGE
+    } else {
+        CPS2_BLUE
+    }
+}
diff --git a/crates/slot-ui/tests/arcade_cart.rs b/crates/slot-ui/tests/arcade_cart.rs
new file mode 100644
index 0000000..73e51a7
--- /dev/null
+++ b/crates/slot-ui/tests/arcade_cart.rs
@@ -0,0 +1,132 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    cart_box, cps2_colour, retro_cart_face, retro_label_rect, retro_shell_of, seated_box,
+    shell_for, RetroShell, CPS1_GREY, CPS2_BLUE, CPS2_GREEN, CPS2_GREY, CPS2_ORANGE, CPS2_YELLOW,
+    NEOGEO_BLACK,
+};
+
+const RED: [u8; 3] = [230, 30, 30];
+
+fn cart(platform: Platform, stem: &str, title: &str, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform,
+        stem: stem.into(),
+        rom: PathBuf::from(format!("{stem}.zip")),
+        label,
+        title: title.into(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn art(name: &str, w: u32, h: u32) -> PathBuf {
+    let px: Vec<u8> = (0..w * h)
+        .flat_map(|_| [RED[0], RED[1], RED[2], 255])
+        .collect();
+    let p = std::env::temp_dir().join(format!("slot-arcade-art-{}-{name}.png", std::process::id()));
+    let mut e = png::Encoder::new(std::fs::File::create(&p).expect("create art"), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    p
+}
+
+fn near(p: &[u8], c: [u8; 3]) -> bool {
+    (0..3).all(|i| p[i].abs_diff(c[i]) < 16)
+}
+
+#[test]
+fn each_board_takes_its_own_shell() {
+    for (p, kind, stem) in [
+        (Platform::NeoGeo, RetroShell::NeoGeo, "mslug"),
+        (Platform::Cps1, RetroShell::Cps1, "ffight"),
+        (Platform::Cps2, RetroShell::Cps2, "ddtod"),
+    ] {
+        assert_eq!(retro_shell_of(&cart(p, stem, "", None)), Some(kind));
+    }
+    assert_eq!(RetroShell::NeoGeo.name(), "neogeo");
+    assert_eq!(
+        shell_for(&cart(Platform::NeoGeo, "mslug", "", None)),
+        NEOGEO_BLACK
+    );
+    assert_eq!(
+        shell_for(&cart(Platform::Cps1, "ffight", "", None)),
+        CPS1_GREY
+    );
+}
+
+#[test]
+fn a_cps2_case_takes_its_regions_colour_from_the_sets_title() {
+    for (title, want) in [
+        (
+            "Dungeons & Dragons: Shadow over Mystara (Japan 960206)",
+            CPS2_GREEN,
+        ),
+        ("Super Street Fighter II Turbo (USA 940323)", CPS2_BLUE),
+        (
+            "Dungeons & Dragons: Tower of Doom (Europe 940412)",
+            CPS2_BLUE,
+        ),
+        ("Street Fighter Alpha (Asia 950627)", CPS2_GREY),
+        (
+            "Dungeons & Dragons: Tower of Doom (Hispanic 940412)",
+            CPS2_ORANGE,
+        ),
+        ("Street Fighter Zero (Brazil 950727)", CPS2_ORANGE),
+        (
+            "Super Street Fighter II X (Japan 940223 rent version)",
+            CPS2_YELLOW,
+        ),
+        ("Mystery set", CPS2_BLUE),
+    ] {
+        assert_eq!(cps2_colour(title), want, "{title}");
+        let c = cart(Platform::Cps2, "x", title, None);
+        assert_eq!(shell_for(&c), want, "{title}");
+    }
+    assert_eq!(CPS2_GREEN.colour, [0x21, 0x90, 0x59]);
+}
+
+#[test]
+fn the_arcade_objects_have_their_own_sizes_on_the_shelf() {
+    assert_eq!(cart_box(Platform::NeoGeo), (360, 266));
+    assert_eq!(seated_box(Platform::NeoGeo), (240, 177));
+    assert_eq!(cart_box(Platform::Cps1), (360, 300));
+    assert_eq!(seated_box(Platform::Cps1), (240, 200));
+    assert_eq!(cart_box(Platform::Cps2), (222, 329));
+    assert_eq!(seated_box(Platform::Cps2), (162, 240));
+}
+
+#[test]
+fn the_aes_cart_renders_black_with_its_well_at_the_top_and_ribs_below() {
+    let c = cart(Platform::NeoGeo, "mslug", "", None);
+    let face = retro_cart_face(&c, RetroShell::NeoGeo);
+    assert_eq!((face.w, face.h), (360, 266));
+    let at = |x: u32, y: u32| &face.rgba[((y * 360 + x) * 4) as usize..][..4];
+    assert_eq!(at(0, 0)[3], 0, "the corner is rounded off");
+    assert!(near(at(40, 120), [0x2a, 0x2a, 0x2d]), "{:?}", at(40, 120));
+}
+
+#[test]
+fn a_flyer_is_shown_whole_inside_the_well() {
+    let flyer = art("flyer", 300, 420);
+    for (p, kind, stem) in [
+        (Platform::NeoGeo, RetroShell::NeoGeo, "mslug"),
+        (Platform::Cps1, RetroShell::Cps1, "ffight"),
+        (Platform::Cps2, RetroShell::Cps2, "ddtod"),
+    ] {
+        let c = cart(p, stem, "", Some(flyer.clone()));
+        let face = retro_cart_face(&c, kind);
+        let (x, y, w, h) = retro_label_rect(kind);
+        let (fw, fh) = (face.w as f32, face.h as f32);
+        let mid = (((x + w / 2.0) * fw) as u32, ((y + h / 2.0) * fh) as u32);
+        let i = ((mid.1 * face.w + mid.0) * 4) as usize;
+        assert!(near(&face.rgba[i..], RED), "{kind:?} well middle");
+        let outside = ((((y + h) * fh) as u32 + 4).min(face.h - 1) * face.w + mid.0) as usize * 4;
+        assert!(!near(&face.rgba[outside..], RED), "{kind:?} below the well");
+    }
+}
