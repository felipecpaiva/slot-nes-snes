diff --git a/crates/slot/tests/stepping/mod.rs b/crates/slot/tests/stepping/mod.rs
new file mode 100644
index 0000000..4f1dee9
--- /dev/null
+++ b/crates/slot/tests/stepping/mod.rs
@@ -0,0 +1,11 @@
+//! step_emulator returns late since slot 1.14: false when a frame was served, and also false when the
+//! emulator is not locked and ran nothing. A test that wants a frame needs both halves.
+
+use std::time::Duration;
+
+use slot::emu::EmuHandle;
+use slot::session::Session;
+
+pub fn stepped(session: &Session, present: Duration, timeout: Duration) -> bool {
+    !session.step_emulator(present, timeout) && session.emu().is_some_and(EmuHandle::locked)
+}
