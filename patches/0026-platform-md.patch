@@ -0,0 +1,145 @@
+mod common;
+mod core_common;
+mod input_common;
+mod real_seat;
+mod sega_common;
+
+use std::path::{Path, PathBuf};
+
+use common::core_lock;
+use sega_common::{genesis_plus_gx, md_rom};
+use slot::app::Phase;
+use slot::persist::Snapshot;
+use slot::session::Session;
+use slot::video_mode::VideoMode;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{Core, Platform};
+
+const STEM: &str = "Phantasy Star IV";
+
+fn sav(root: &Path) -> PathBuf {
+    root.join("Saves/MD").join(format!("{STEM}.sav"))
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+fn seated(dylib: &Path, h40: bool) -> tempfile::TempDir {
+    let root = real_seat::rooted(Platform::Md, STEM, &md_rom("md_seat.md", h40, true), dylib);
+    std::fs::copy(
+        md_rom("md_seat_spare.md", true, true),
+        root.path().join("Games/MD/Zzz.md"),
+    )
+    .expect("copy spare cart");
+    root
+}
+
+#[test]
+fn a_mega_drive_sav_goes_into_the_core_and_comes_back_out_on_eject() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let root = seated(&dylib, true);
+    let marked: Vec<u8> = (0..0x4000u32).map(|i| (i % 239) as u8).collect();
+    std::fs::write(sav(root.path()), &marked).expect("write .sav");
+    let mut session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::GenesisPlusGx);
+    assert_eq!(
+        session.emu().expect("no core").snapshot().save_ram(),
+        Some(marked.clone())
+    );
+    std::fs::remove_file(sav(root.path())).expect("remove .sav");
+    eject(&mut session);
+    assert_eq!(
+        std::fs::read(sav(root.path())).expect("no .sav after eject"),
+        marked
+    );
+}
+
+#[test]
+fn a_seated_h32_game_stretches_to_its_own_256_wide_picture() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let root = seated(&dylib, false);
+    let mut session = real_seat::play(root.path(), true);
+    session.update(1.0 / 60.0);
+    assert_eq!(
+        session.app().source_rect(),
+        [52.0 / 360.0, 8.0 / 240.0, 256.0 / 360.0, 224.0 / 240.0]
+    );
+}
+
+struct Pad {
+    session: Session,
+    now: Millis,
+    ever: u16,
+    _root: tempfile::TempDir,
+}
+
+impl Pad {
+    fn new() -> Self {
+        let (root, session) = input_common::playing(Platform::Md, "Zzz");
+        Pad {
+            session,
+            now: 100,
+            ever: 0,
+            _root: root,
+        }
+    }
+
+    fn feed(&mut self, ev: RawEvent) {
+        self.now += 20;
+        self.session.feed([ev], self.now);
+        self.ever |= self.pad();
+    }
+
+    fn pad(&self) -> u16 {
+        self.session.emu().expect("no core in the slot").input().0
+    }
+}
+
+#[test]
+fn x_y_l_and_r_reach_the_mega_drive_game_as_its_six_button_row() {
+    let mut p = Pad::new();
+    assert!(p.session.emu().expect("core").passes_through());
+    assert_eq!(p.session.app().taken_buttons(), []);
+    for (btn, bit) in [
+        (Btn::X, ButtonMask::X),
+        (Btn::Y, ButtonMask::Y),
+        (Btn::L1, ButtonMask::L),
+        (Btn::R1, ButtonMask::R),
+    ] {
+        p.feed(RawEvent::Down(btn));
+        assert_eq!(p.pad() & bit, bit, "{btn:?} never reached the core");
+        p.feed(RawEvent::Up(btn));
+        assert_eq!(p.pad() & bit, 0, "{btn:?} stuck down");
+    }
+}
+
+#[test]
+fn select_and_x_on_mega_drive_toggles_the_picture_and_never_sends_x() {
+    let mut p = Pad::new();
+    assert_ne!(p.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    for ev in [
+        RawEvent::Down(Btn::Select),
+        RawEvent::Down(Btn::X),
+        RawEvent::Up(Btn::X),
+        RawEvent::Up(Btn::Select),
+    ] {
+        p.feed(ev);
+    }
+    assert_eq!(p.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(p.ever & ButtonMask::X, 0, "X was sent to the game");
+    assert_eq!(VideoMode::Stretch.flipped(Platform::Md), VideoMode::Actual);
+}
diff --git a/crates/slot/tests/sega_common/mod.rs b/crates/slot/tests/sega_common/mod.rs
index efd0309..200707f 100644
--- a/crates/slot/tests/sega_common/mod.rs
+++ b/crates/slot/tests/sega_common/mod.rs
@@ -53,6 +53,31 @@ fn sms_with(name: &str, mode: &[u8]) -> PathBuf {
     write(name, &rom)
 }
 
+pub const MD_TITLE: &str = "SLOT TEST CART";
+
+pub fn md_rom(name: &str, h40: bool, sram: bool) -> PathBuf {
+    let mut rom = vec![0u8; 0x20000];
+    rom[0..4].copy_from_slice(&0x00ff_fe00u32.to_be_bytes());
+    rom[4..8].copy_from_slice(&0x0000_0200u32.to_be_bytes());
+    rom[0x100..0x110].copy_from_slice(b"SEGA MEGA DRIVE ");
+    rom[0x120..0x180].fill(b' ');
+    rom[0x150..0x150 + MD_TITLE.len()].copy_from_slice(MD_TITLE.as_bytes());
+    rom[0x1f0..0x1f4].copy_from_slice(b"JUE ");
+    if sram {
+        rom[0x1b0..0x1b4].copy_from_slice(&[b'R', b'A', 0xf8, 0x20]);
+        rom[0x1b4..0x1b8].copy_from_slice(&0x0020_0001u32.to_be_bytes());
+        rom[0x1b8..0x1bc].copy_from_slice(&0x0020_3fffu32.to_be_bytes());
+    }
+    let width: u16 = if h40 { 0x8c81 } else { 0x8c00 };
+    let mut program = vec![0x33, 0xfc, 0x81, 0x44, 0x00, 0xc0, 0x00, 0x04, 0x33, 0xfc];
+    program.extend(width.to_be_bytes());
+    program.extend([0x00, 0xc0, 0x00, 0x04]);
+    program.extend([0x23, 0xfc, 0xc0, 0x00, 0x00, 0x00, 0x00, 0xc0, 0x00, 0x04]);
+    program.extend([0x33, 0xfc, 0x00, 0x0e, 0x00, 0xc0, 0x00, 0x00, 0x60, 0xfe]);
+    rom[0x200..0x200 + program.len()].copy_from_slice(&program);
+    write(name, &rom)
+}
+
 fn write(name: &str, rom: &[u8]) -> PathBuf {
     let p = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
     std::fs::write(&p, rom).expect("write rom");
diff --git a/crates/slot/tests/sega_then_gba.rs b/crates/slot/tests/sega_then_gba.rs
new file mode 100644
index 0000000..3c54f44
--- /dev/null
+++ b/crates/slot/tests/sega_then_gba.rs
@@ -0,0 +1,107 @@
+mod common;
+
+use std::time::{Duration, Instant};
+
+use slot::app::Phase;
+use slot::session::Session;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::Platform;
+use tempfile::TempDir;
+
+struct Rig {
+    root: TempDir,
+    session: Session,
+    now: Millis,
+}
+
+fn write_cart(root: &TempDir, platform: Platform, stem: &str) {
+    let dir = root.path().join("Games").join(platform.dir_name());
+    let cart = dir.join(format!("{stem}.{}", platform.extensions()[0]));
+    std::fs::write(cart, vec![0u8; 0x200]).expect("write cart");
+}
+
+impl Rig {
+    fn feed(&mut self, ev: RawEvent) {
+        self.now += 20;
+        self.session.feed([ev], self.now);
+    }
+
+    fn tap(&mut self, b: Btn) {
+        self.feed(RawEvent::Down(b));
+        self.feed(RawEvent::Up(b));
+    }
+
+    fn until(&mut self, what: &str, cond: impl Fn(&Session) -> bool) {
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !cond(&self.session) {
+            assert!(Instant::now() < deadline, "timed out waiting for {what}");
+            self.now += 16;
+            self.session.feed([], self.now);
+            self.session.update(1.0 / 60.0);
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
+
+    fn pad(&self) -> u16 {
+        self.session.emu().expect("no core in the slot").input().0
+    }
+
+    fn shelf_after_a_mega_drive_game() -> Rig {
+        let root = common::tmp_root_with_real_carts(&[]);
+        write_cart(&root, Platform::Md, "Aaa");
+        write_cart(&root, Platform::Gba, "Bbb");
+        common::clocked(root.path());
+        let mut r = Rig {
+            session: Session::boot(root.path().to_path_buf()),
+            root,
+            now: 0,
+        };
+        r.tap(Btn::R1);
+        r.tap(Btn::A);
+        r.until("the mega drive cart to seat", |s| {
+            matches!(s.app().phase(), Phase::Playing { .. })
+        });
+        assert!(r.session.emu().expect("core").passes_through());
+        assert_ne!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+        r.feed(RawEvent::Down(Btn::Menu));
+        r.until("the eject", |s| !s.has_core());
+        r.feed(RawEvent::Up(Btn::Menu));
+        r.until("the shelf", |s| matches!(s.app().phase(), Phase::Shelf));
+        r
+    }
+
+    fn insert_the_gba_cart(&mut self) {
+        self.tap(Btn::L1);
+        self.tap(Btn::A);
+        self.until("the gba cart to seat", |s| {
+            matches!(s.app().phase(), Phase::Playing { .. })
+        });
+    }
+}
+
+#[test]
+fn a_gba_game_after_a_mega_drive_game_gets_gba_input_and_picture_back() {
+    let mut r = Rig::shelf_after_a_mega_drive_game();
+    r.insert_the_gba_cart();
+    assert!(!r.session.emu().expect("core").passes_through());
+
+    r.feed(RawEvent::Down(Btn::Select));
+    r.feed(RawEvent::Down(Btn::X));
+    assert_eq!(
+        r.pad() & ButtonMask::X,
+        ButtonMask::X,
+        "X is Turbo A on GBA"
+    );
+    r.feed(RawEvent::Up(Btn::X));
+    r.feed(RawEvent::Up(Btn::Select));
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert!(!r.root.path().join("Config/video_mode.txt").exists());
+
+    r.now += 300;
+    r.session.feed([], r.now);
+    r.feed(RawEvent::Down(Btn::X));
+    assert_eq!(r.pad() & ButtonMask::X, ButtonMask::X);
+    r.feed(RawEvent::Up(Btn::X));
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+}
