diff --git a/crates/slot/tests/md_emu.rs b/crates/slot/tests/md_emu.rs
new file mode 100644
index 0000000..960e490
--- /dev/null
+++ b/crates/slot/tests/md_emu.rs
@@ -0,0 +1,106 @@
+mod common;
+mod core_common;
+mod sega_common;
+
+use common::core_lock;
+use sega_common::{genesis_plus_gx, md_rom};
+use slot::core::open_core_for_palette;
+use slot::video_mode::{source_rect, VideoMode};
+use slot_retro::{ButtonMask, RetroCore};
+use slot_store::{Core, Platform};
+
+const CANVAS_W: usize = 360;
+
+fn pixel(video: &[u8], x: usize, y: usize) -> [u8; 4] {
+    let at = (y * CANVAS_W + x) * 4;
+    [video[at], video[at + 1], video[at + 2], video[at + 3]]
+}
+
+fn running(rom: std::path::PathBuf) -> Option<Box<dyn RetroCore>> {
+    let dylib = genesis_plus_gx()?;
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::GenesisPlusGx,
+        Platform::Md,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.load(&rom)
+        .expect("Genesis Plus GX refused the Mega Drive cart");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    Some(core)
+}
+
+fn assert_picture(video: &[u8], width: usize) {
+    let (x0, y0, h) = ((CANVAS_W - width) / 2, 8, 224);
+    let red = pixel(video, x0, y0);
+    assert!(red[2] > 0 && red[1] == 0 && red[0] == 0, "{red:?}");
+    for y in 0..240 {
+        for x in 0..CANVAS_W {
+            let inside = (x0..x0 + width).contains(&x) && (y0..y0 + h).contains(&y);
+            let want = if inside { red } else { [0; 4] };
+            assert_eq!(pixel(video, x, y), want, "({x}, {y})");
+        }
+    }
+}
+
+#[test]
+fn an_h40_mega_drive_cart_draws_320_by_224_at_the_centre_of_the_360_by_240_canvas() {
+    let _g = core_lock();
+    let Some(core) = running(md_rom("md_h40.md", true, false)) else {
+        return;
+    };
+    assert_eq!(core.canvas(), (360, 240));
+    assert_eq!(core.frame_width(), 320);
+    assert_picture(core.video_xrgb8888(), 320);
+}
+
+#[test]
+fn an_h32_mega_drive_cart_draws_256_by_224_and_reports_its_width() {
+    let _g = core_lock();
+    let Some(core) = running(md_rom("md_h32.bin", false, false)) else {
+        return;
+    };
+    assert_eq!(core.frame_width(), 256);
+    assert_picture(core.video_xrgb8888(), 256);
+}
+
+#[test]
+fn mega_drive_stretch_crops_to_the_live_frame_width_on_both_axes() {
+    let picture = |w| slot::platform_video::picture(Platform::Md, w);
+    assert_eq!(picture(320), (320, 224));
+    assert_eq!(picture(256), (256, 224));
+    assert_eq!(picture(0), (320, 224));
+    let at = |w: u32| source_rect(Platform::Md, picture(w), (360, 240), VideoMode::Stretch);
+    assert_eq!(
+        at(320),
+        [20.0 / 360.0, 8.0 / 240.0, 320.0 / 360.0, 224.0 / 240.0]
+    );
+    assert_eq!(
+        at(256),
+        [52.0 / 360.0, 8.0 / 240.0, 256.0 / 360.0, 224.0 / 240.0]
+    );
+    assert_eq!(
+        source_rect(Platform::Md, picture(256), (360, 240), VideoMode::Actual),
+        slot_gfx::WHOLE_TEXTURE
+    );
+}
+
+#[test]
+fn every_other_platform_keeps_its_fixed_picture_whatever_the_frame_width() {
+    for platform in Platform::SHELVES {
+        if platform == Platform::Md {
+            continue;
+        }
+        assert_eq!(
+            slot::platform_video::picture(platform, 123),
+            platform.picture(),
+            "{platform:?}"
+        );
+    }
+}
diff --git a/crates/slot/tests/md_seat.rs b/crates/slot/tests/md_seat.rs
