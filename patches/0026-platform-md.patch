diff --git a/crates/slot-store/src/sega.rs b/crates/slot-store/src/sega.rs
index 492b413..f4d22a0 100644
--- a/crates/slot-store/src/sega.rs
+++ b/crates/slot-store/src/sega.rs
@@ -35,3 +35,76 @@ pub fn tmr_region(head: &[u8; TMR_LEN]) -> Option<Region> {
         _ => None,
     }
 }
+
+const MD_HEADER_AT: u64 = 0x100;
+const MD_HEADER_LEN: usize = 0x100;
+const MD_DOMESTIC: std::ops::Range<usize> = 0x20..0x50;
+const MD_OVERSEAS: std::ops::Range<usize> = 0x50..0x80;
+const MD_COUNTRY: std::ops::Range<usize> = 0xf0..0xf4;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug, Default)]
+pub struct MdRegions {
+    pub japan: bool,
+    pub usa: bool,
+    pub europe: bool,
+}
+
+pub fn md_title(rom: &Path) -> Option<String> {
+    let head = md_header(rom)?;
+    md_title_of(&head)
+}
+
+pub fn md_regions(rom: &Path) -> Option<MdRegions> {
+    let head = md_header(rom)?;
+    md_regions_of(&head)
+}
+
+fn md_header(rom: &Path) -> Option<[u8; MD_HEADER_LEN]> {
+    let mut f = File::open(rom).ok()?;
+    let mut head = [0u8; MD_HEADER_LEN];
+    f.seek(SeekFrom::Start(MD_HEADER_AT)).ok()?;
+    f.read_exact(&mut head).ok()?;
+    (head.starts_with(b"SEGA") || head[1..].starts_with(b"SEGA")).then_some(head)
+}
+
+pub fn md_title_of(head: &[u8; MD_HEADER_LEN]) -> Option<String> {
+    printable(&head[MD_OVERSEAS]).or_else(|| printable(&head[MD_DOMESTIC]))
+}
+
+fn printable(field: &[u8]) -> Option<String> {
+    if !field.iter().all(|b| (0x20..0x7f).contains(b) || *b == 0) {
+        return None;
+    }
+    let text: String = field.iter().map(|b| char::from(*b)).collect();
+    let words: Vec<&str> = text.trim_end_matches('\0').split_whitespace().collect();
+    (!words.is_empty()).then(|| words.join(" "))
+}
+
+pub fn md_regions_of(head: &[u8; MD_HEADER_LEN]) -> Option<MdRegions> {
+    let field = &head[MD_COUNTRY];
+    let mut mask = 0u8;
+    match field.get(..3) {
+        Some(b"eur" | b"EUR") => mask = 8,
+        Some(b"jap" | b"JAP") => mask = 1,
+        Some(b"usa" | b"USA") => mask = 4,
+        _ => {
+            for c in field.iter().map(u8::to_ascii_uppercase) {
+                mask |= match c {
+                    b'U' => 4,
+                    b'J' | b'K' => 1,
+                    b'E' => 8,
+                    0..=15 => c,
+                    b'0'..=b'9' => c - b'0',
+                    b'A'..=b'F' => c - b'A' + 10,
+                    _ => 0,
+                };
+            }
+        }
+    }
+    let regions = MdRegions {
+        japan: mask & 3 != 0,
+        usa: mask & 4 != 0,
+        europe: mask & 8 != 0,
+    };
+    (regions != MdRegions::default()).then_some(regions)
+}
diff --git a/crates/slot-store/tests/md_platform.rs b/crates/slot-store/tests/md_platform.rs
