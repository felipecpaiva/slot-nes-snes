index 0000000..dbf014b
--- /dev/null
+++ b/crates/slot-store/tests/md_platform.rs
@@ -0,0 +1,141 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::sega::{md_regions_of, md_title_of, MdRegions};
+use slot_store::{read_slot_state, scan, write_slot_state, Core, Platform, Shader, SlotState};
+
+fn header(overseas: &[u8], country: &[u8]) -> [u8; 0x100] {
+    let mut head = [b' '; 0x100];
+    head[..4].copy_from_slice(b"SEGA");
+    head[0x50..0x50 + overseas.len()].copy_from_slice(overseas);
+    head[0xf0..0xf0 + country.len()].copy_from_slice(country);
+    head
+}
+
+#[test]
+fn mega_drive_is_the_last_shelf() {
+    assert_eq!(Platform::SHELVES[7], Platform::Md);
+    assert_eq!(Platform::ALL.len(), 3);
+}
+
+#[test]
+fn mega_drive_has_its_own_name_folder_extensions_and_picture() {
+    assert_eq!(Platform::Md.name(), "Sega Mega Drive");
+    assert_eq!(Platform::Md.dir_name(), "MD");
+    for name in ["x.md", "x.gen", "x.bin", "X.BIN"] {
+        assert!(Platform::Md.accepts(Path::new(name)), "{name}");
+    }
+    assert!(!Platform::Md.accepts(Path::new("x.smd")));
+    assert!(!Platform::Md.accepts(Path::new("x.sms")));
+    assert_eq!(Platform::Md.picture(), (320, 224));
+}
+
+#[test]
+fn mega_drive_plays_like_snes_and_follows_the_frame_width() {
+    assert!(!Platform::Md.owns_shoulders());
+    assert!(Platform::Md.passes_xy_through());
+    assert!(Platform::Md.select_x_toggles_picture());
+    assert!(Platform::Md.stretch_crops_height());
+    assert!(Platform::Md.follows_frame_width());
+    assert_eq!(Platform::Md.picker_cores(), None);
+    assert_eq!(Platform::Md.shader_choices(), &Shader::RETRO);
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            platform.follows_frame_width(),
+            platform == Platform::Md,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn mega_drive_runs_on_genesis_plus_gx_alone_at_2x() {
+    assert_eq!(Core::default_for(Platform::Md), Core::GenesisPlusGx);
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Md),
+            core == Core::GenesisPlusGx,
+            "{core:?}"
+        );
+    }
+    assert_eq!(Core::GenesisPlusGx.canvas(Platform::Md), (360, 240));
+}
+
+#[test]
+fn a_bin_outside_the_mega_drive_folder_is_not_a_mega_drive_cart() {
+    let d = tempfile::tempdir().expect("tempdir");
+    for dir in ["Games/MD", "Games/GBA"] {
+        std::fs::create_dir_all(d.path().join(dir)).expect("create dir");
+    }
+    std::fs::write(d.path().join("Games/GBA/Stray.bin"), [0u8; 16]).expect("write");
+    std::fs::write(d.path().join("Games/MD/Sonic.bin"), [0u8; 0x200]).expect("write");
+    let carts = scan(d.path()).expect("scan");
+    assert_eq!(carts.len(), 1);
+    assert_eq!(carts[0].platform, Platform::Md);
+    assert_eq!(carts[0].stem, "Sonic");
+}
+
+#[test]
+fn a_mega_drive_cart_takes_its_overseas_title_from_the_header() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let dir = d.path().join("Games/MD");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let mut rom = vec![0u8; 0x400];
+    rom[0x100..0x200].copy_from_slice(&header(b"SONIC THE               HEDGEHOG", b"JUE"));
+    std::fs::write(dir.join("Sonic the Hedgehog (USA, Europe).md"), rom).expect("write");
+    let mut carts = scan(d.path()).expect("scan");
+    let cart = &mut carts[0];
+    cart.read_header();
+    assert_eq!(cart.title, "SONIC THE HEDGEHOG");
+}
+
+#[test]
+fn a_mega_drive_header_without_sega_or_with_no_title_leaves_the_stem() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let dir = d.path().join("Games/MD");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let mut no_sega = vec![0u8; 0x400];
+    no_sega[0x100..0x200].copy_from_slice(&header(b"STREETS OF RAGE", b"U"));
+    no_sega[0x100] = b'X';
+    std::fs::write(dir.join("Streets of Rage (World).md"), no_sega).expect("write");
+    let mut carts = scan(d.path()).expect("scan");
+    carts[0].read_header();
+    assert_eq!(carts[0].title, "");
+    let blank = header(b"", b"U");
+    assert_eq!(md_title_of(&blank), None);
+    let mut japanese = header(b"", b"J");
+    japanese[0x20..0x24].copy_from_slice(&[0x83, 0x5c, 0x83, 0x6e]);
+    assert_eq!(md_title_of(&japanese), None);
+}
+
+#[test]
+fn the_mega_drive_region_field_reads_letters_hex_and_words() {
+    let read = |field: &[u8]| md_regions_of(&header(b"X", field));
+    let r = |japan, usa, europe| Some(MdRegions { japan, usa, europe });
+    assert_eq!(read(b"J"), r(true, false, false));
+    assert_eq!(read(b"U"), r(false, true, false));
+    assert_eq!(read(b"E"), r(false, false, true));
+    assert_eq!(read(b"JUE"), r(true, true, true));
+    assert_eq!(read(b"4"), r(false, true, false));
+    assert_eq!(read(b"5"), r(true, true, false));
+    assert_eq!(read(b"F"), r(true, true, true));
+    assert_eq!(read(b"EUR"), r(false, false, true));
+    assert_eq!(read(b"   "), None);
+}
+
+#[test]
+fn a_mega_drive_cart_resumes_as_a_mega_drive_cart() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Phantasy Star IV (USA)".into()),
+        cart_platform: Some(Platform::Md),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=md"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
