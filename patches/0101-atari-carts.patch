diff --git a/crates/slot-ui/tests/atari_cart.rs b/crates/slot-ui/tests/atari_cart.rs
new file mode 100644
index 0000000..3ba738e
--- /dev/null
+++ b/crates/slot-ui/tests/atari_cart.rs
@@ -0,0 +1,69 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    cart_box, retro_cart_face, retro_label_rect, retro_shell_of, seated_box, shell_for, RetroShell,
+    A2600_BLACK, A7800_BLACK,
+};
+
+fn cart(platform: Platform, stem: &str) -> Cart {
+    Cart {
+        platform,
+        stem: stem.into(),
+        rom: PathBuf::from(format!("Games/{stem}.rom")),
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+#[test]
+fn each_atari_system_takes_its_own_shell_in_its_own_black() {
+    let a26 = cart(Platform::A2600, "Pitfall! (USA)");
+    let a78 = cart(Platform::A7800, "Asteroids (USA)");
+    assert_eq!(retro_shell_of(&a26), Some(RetroShell::A2600));
+    assert_eq!(retro_shell_of(&a78), Some(RetroShell::A7800));
+    assert_eq!(shell_for(&a26), A2600_BLACK);
+    assert_eq!(shell_for(&a78), A7800_BLACK);
+    assert_ne!(A2600_BLACK, A7800_BLACK);
+    assert_eq!(RetroShell::A2600.name(), "a2600");
+    assert_eq!(RetroShell::A7800.name(), "a7800");
+}
+
+#[test]
+fn a_chosen_shell_colour_still_wins_over_the_atari_black() {
+    let mut c = cart(Platform::A2600, "Adventure (USA)");
+    c.shell = Some(ShellChoice {
+        outline: Outline::Auto,
+        colour: [0x10, 0x20, 0x30],
+        finish: ShellFinish::Solid,
+    });
+    assert_eq!(shell_for(&c).colour, [0x10, 0x20, 0x30]);
+}
+
+#[test]
+fn the_atari_carts_are_portrait_in_the_82_by_98_mm_ratio() {
+    for p in [Platform::A2600, Platform::A7800] {
+        assert_eq!(seated_box(p), (240, 287));
+        assert_eq!(cart_box(p), (312, 373));
+    }
+}
+
+#[test]
+fn the_2600_label_sits_below_its_ribbed_grip_and_the_7800_label_below_its_cap() {
+    let (_, y26, _, h26) = retro_label_rect(RetroShell::A2600);
+    let (_, y78, _, _) = retro_label_rect(RetroShell::A7800);
+    assert!(y26 > 0.3 && y26 + h26 <= 0.97, "{y26} {h26}");
+    assert!(y78 > 0.15 && y78 < y26, "{y78}");
+    for (kind, p) in [
+        (RetroShell::A2600, Platform::A2600),
+        (RetroShell::A7800, Platform::A7800),
+    ] {
+        let face = retro_cart_face(&cart(p, "Bare (USA)"), kind);
+        assert_eq!((face.w, face.h), (312, 373));
+        let at = |x: u32, y: u32| &face.rgba[((y * 312 + x) * 4) as usize..][..4];
+        assert_eq!(at(0, 0)[3], 0, "{kind:?} top corner is rounded off");
+        assert_eq!(at(156, 360)[3], 255, "{kind:?} body is solid");
+    }
+}
