From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paiva <felipe.paiva@gmail.com>
Date: Wed, 21 Oct 2026 00:59:08 +0400
Subject: [PATCH] fds-saves

fceumm exposes the live disk, every side without the fwNES header, as
save RAM, so the Disk System uses the ordinary .sav: Saves/FDS/<stem>.sav
holds the disk as the game left it (65,500 bytes a side) and loads back
over the disk at the next insert. The .fds file on the shelf is only
ever read, so deleting the .sav gives the disk back as dumped. A
RetroArch .srm of the same disk loads the same way. A save whose size
is not the disk's (another dump of the same name, a different side
count) is not loaded half over the disk: it is renamed
<stem>.sav.mismatch, kept, and the game starts from the disk as it is.
---
 crates/slot/src/fds_save.rs    |  60 +++++++++++++
 crates/slot/src/lib.rs         |   1 +
 crates/slot/src/session.rs     |   2 +
 crates/slot/tests/fds_saves.rs | 156 +++++++++++++++++++++++++++++++++
 4 files changed, 219 insertions(+)
 create mode 100644 crates/slot/src/fds_save.rs
 create mode 100644 crates/slot/tests/fds_saves.rs

diff --git a/crates/slot/src/fds_save.rs b/crates/slot/src/fds_save.rs
new file mode 100644
index 0000000..051a93b
--- /dev/null
+++ b/crates/slot/src/fds_save.rs
@@ -0,0 +1,60 @@
+use std::io::Read;
+use std::path::Path;
+
+use slot_store::Platform;
+
+use crate::fds_disk::{flips, SIDE_BYTES};
+
+pub fn disk_bytes(rom: &Path) -> Option<usize> {
+    let mut head = [0u8; 16];
+    let mut file = std::fs::File::open(rom).ok()?;
+    let len = file.metadata().ok()?.len() as usize;
+    file.read_exact(&mut head).ok()?;
+    let sides = if head.starts_with(b"FDS\x1a") {
+        usize::from(head[4])
+    } else if head.get(1..15) == Some(b"*NINTENDO-HVC*".as_slice()) {
+        len.max(SIDE_BYTES) / SIDE_BYTES
+    } else {
+        return None;
+    };
+    Some(sides.clamp(1, 8) * SIDE_BYTES)
+}
+
+pub fn checked_sav(
+    root: &Path,
+    platform: Platform,
+    stem: &str,
+    rom: &Path,
+    sav: Option<Vec<u8>>,
+) -> Option<Vec<u8>> {
+    let sav = sav?;
+    if !flips(platform) {
+        return Some(sav);
+    }
+    let want = disk_bytes(rom);
+    if want == Some(sav.len()) {
+        return Some(sav);
+    }
+    let dir = crate::root::saves_dir(root).join(platform.dir_name());
+    let kept = ["sav", "srm"]
+        .into_iter()
+        .map(|ext| dir.join(format!("{stem}.{ext}")))
+        .find(|p| p.exists())
+        .map(|p| {
+            let aside = p.with_extension(format!(
+                "{}.mismatch",
+                p.extension().and_then(|e| e.to_str()).unwrap_or("sav")
+            ));
+            (std::fs::rename(&p, &aside), aside)
+        });
+    eprintln!(
+        "slot: fds: {stem} save is {} bytes, the disk is {want:?}, starting from the disk as it is",
+        sav.len()
+    );
+    match kept {
+        Some((Ok(()), aside)) => eprintln!("slot: fds: kept the old save as {}", aside.display()),
+        Some((Err(e), aside)) => eprintln!("slot: fds: could not keep {}: {e}", aside.display()),
+        None => {}
+    }
+    None
+}
