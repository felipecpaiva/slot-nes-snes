From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paiva <felipe.paiva@gmail.com>
Date: Sun, 18 Oct 2026 13:20:09 +0400
Subject: [PATCH] start-closes-picker

START, which opens the core picker on the shelf, also closes it
without changing the core, as B does. From jgraving/slot e047d17
(GPL-3.0),
https://github.com/jgraving/slot/commit/e047d17
---
 crates/slot/src/app.rs                   |  2 +-
 crates/slot/tests/start_closes_picker.rs | 49 ++++++++++++++++++++++++
 2 files changed, 50 insertions(+), 1 deletion(-)
 create mode 100644 crates/slot/tests/start_closes_picker.rs

diff --git a/crates/slot/src/app.rs b/crates/slot/src/app.rs
index 4606dbf..ef6b789 100644
--- a/crates/slot/src/app.rs
+++ b/crates/slot/src/app.rs
@@ -4000,7 +4000,7 @@ impl App {
             Action::GbaDown(Btn::Left) | Action::ShelfLeft => Press::Left,
             Action::GbaDown(Btn::Right) | Action::ShelfRight => Press::Right,
             Action::GbaDown(Btn::A) => Press::Keep,
-            Action::GbaDown(Btn::B) => Press::Back,
+            Action::GbaDown(Btn::B | Btn::Start) => Press::Back,
             _ => return,
         };
         let now = self.now();
diff --git a/crates/slot/tests/start_closes_picker.rs b/crates/slot/tests/start_closes_picker.rs
new file mode 100644
index 0000000..a20228f
--- /dev/null
+++ b/crates/slot/tests/start_closes_picker.rs
@@ -0,0 +1,49 @@
+mod common;
+
+use slot::app::App;
+use slot_gfx::TexId;
+use slot_input::{Action, Btn};
+use slot_store::{write_slot_state, Core, SlotState};
+
+fn picker_open() -> (tempfile::TempDir, App) {
+    let d = common::tmp_root_with_carts(&["Emerald", "Zzz"]);
+    write_slot_state(
+        d.path(),
+        &SlotState {
+            clock_set: true,
+            ..Default::default()
+        },
+    )
+    .unwrap();
+    let mut app = App::boot(d.path());
+    let id = TexId::from_raw;
+    app.set_core_part_faces(
+        vec![id(902), id(903)],
+        vec![id(904), id(905)],
+        id(906),
+        id(907),
+    );
+    app.set_core_legend_faces(vec![(id(908), 60), (id(909), 90), (id(910), 80)]);
+    app.set_core_board_faces(id(900), id(901));
+    app.apply(Action::GbaDown(Btn::Start));
+    assert_eq!(app.core_picker(), Some(Core::Mgba));
+    (d, app)
+}
+
+#[test]
+fn start_closes_the_picker_it_opened() {
+    let (_d, mut app) = picker_open();
+    app.apply(Action::GbaDown(Btn::Start));
+    app.update(0.4);
+    assert_eq!(app.core_picker(), None);
+}
+
+#[test]
+fn closing_the_picker_with_start_keeps_the_core() {
+    let (d, mut app) = picker_open();
+    app.apply(Action::GbaDown(Btn::Right));
+    app.apply(Action::GbaDown(Btn::Start));
+    app.update(0.4);
+    assert_eq!(app.core_picker(), None);
+    assert_eq!(slot_store::core_for(d.path(), "Emerald"), Core::Mgba);
+}
