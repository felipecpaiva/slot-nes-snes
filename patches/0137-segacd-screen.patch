+mod common;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::pal_speed::PAL_SPEED_FILE;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::video_mode::{source_rect, VideoMode};
+use slot_input::{Action, Btn};
+use slot_store::{read_sega_shaders, Core, Platform, Shader, SEGACD_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_a_disc() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(
+        root.path().join("Games/SEGACD/Sonic CD (USA).chd"),
+        [0u8; 16],
+    )
+    .expect("write disc");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_segacd(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenSegaCd.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenSegaCd));
+    press(app, Btn::A);
+}
+
+#[test]
+fn sega_cd_follows_the_supergrafx_with_the_mega_drive_rows() {
+    assert_eq!(QuickRow::SCREEN.last(), Some(&QuickRow::ScreenSegaCd));
+    assert_eq!(QuickRow::ScreenSegaCd.label(), "Sega CD");
+    assert!(QuickRow::ScreenSegaCd.opens());
+    assert_eq!(QuickRow::ScreenSegaCd.child(), Some(QuickRow::SegaCdShader));
+    assert_eq!(
+        QuickRow::SCREEN_SEGACD.map(QuickRow::label),
+        QuickRow::SCREEN_MD.map(QuickRow::label)
+    );
+    assert_eq!(
+        QuickRow::SCREEN_SEGACD.map(QuickRow::label),
+        ["Shader", "Picture", "PAL Speed"]
+    );
+    for row in QuickRow::SCREEN_SEGACD {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenSegaCd));
+    }
+}
