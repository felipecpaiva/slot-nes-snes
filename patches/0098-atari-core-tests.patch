+        .unwrap();
+    play(&mut core, 60, 0);
+    assert_eq!(core.av_info().fps, 60.0);
+    let (w, h, _) = lit(&core);
+    assert_eq!((w, h), (320, 223));
+}
+
+#[test]
+fn a_7800_state_round_trips_and_there_is_no_save_ram() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = prosystem(d.path(), None) else {
+        return;
+    };
+    core.load(&a78(d.path(), "Ntsc", Some(0x1f), false, true))
+        .unwrap();
+    play(&mut core, 5, 0);
+    let state = core.serialize().expect("no state");
+    play(&mut core, 10, 0);
+    core.unserialize(&state)
+        .expect("the state would not load back");
+    assert_eq!(core.serialize().unwrap(), state);
+    assert_eq!(core.save_ram(), None);
+}
+
+#[test]
+fn every_7800_console_switch_counts_only_while_held_difficulty_included() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = prosystem(d.path(), None) else {
+        return;
+    };
+    core.load(&a78(d.path(), "Switches", None, false, true))
+        .unwrap();
+    play(&mut core, 30, 0);
+    let idle = lit(&core).2;
+    // L and R are the difficulty switches, X Reset, SELECT Select, START Pause.
+    for b in [
+        ButtonMask::L,
+        ButtonMask::R,
+        ButtonMask::X,
+        ButtonMask::SELECT,
+        ButtonMask::START,
+    ] {
+        let (held, after) = press(&mut core, b);
+        assert_ne!(held, idle, "button {b:#x}");
+        assert_eq!(after, idle, "button {b:#x}");
+    }
+}
+
+#[test]
+fn with_the_ntsc_bios_an_unsigned_7800_cart_never_draws() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(bios) = bios_7800() else {
+        return;
+    };
+    let Some(mut core) = prosystem(d.path(), Some(&bios)) else {
+        return;
+    };
+    core.load(&a78(d.path(), "Unsigned", Some(0x1f), false, true))
+        .expect("the core loads it, the BIOS refuses it");
+    // The same cart draws on its first frames with no BIOS (above); the BIOS checks the cart's
+    // signature, finds none, and the picture stays black.
+    play(&mut core, 600, 0);
+    assert_eq!(lit(&core), (0, 0, [0, 0, 0]));
+    assert_eq!(core.av_info().fps, 60.0);
+}
