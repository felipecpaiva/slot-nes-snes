diff --git a/crates/slot/src/app/retro_scale.rs b/crates/slot/src/app/retro_scale.rs
new file mode 100644
index 0000000..8d3d217
--- /dev/null
+++ b/crates/slot/src/app/retro_scale.rs
@@ -0,0 +1,28 @@
+use std::path::Path;
+
+use slot_store::{Core, Platform, Scale};
+
+use super::App;
+
+impl App {
+    pub(super) fn read_retro_scale(&mut self, root: &Path) {
+        self.retro_scale = crate::retro_scale::read(root);
+    }
+
+    pub(super) fn set_retro_scale(&mut self, platform: Platform, scale: Scale) {
+        self.retro_scale.insert(platform, scale);
+        if let Some(root) = &self.root {
+            crate::retro_scale::save(root, platform, scale, &self.card_writes);
+        }
+    }
+
+    /// The canvas a shelf's picture is placed on: the playing core's while that shelf plays, its default
+    /// core's otherwise (the Screen pages size every shelf's choices from the shelf).
+    pub(super) fn canvas_for(&self, platform: Platform) -> (u32, u32) {
+        if matches!(self.phase, super::Phase::Playing { .. }) && self.playing_platform() == platform
+        {
+            return self.core.game_canvas(platform, self.vertical);
+        }
+        Core::pair(platform)[0].game_canvas(platform, false)
+    }
+}
