new file mode 100644
index 0000000..abc3ae0
--- /dev/null
+++ b/crates/slot/src/retro_scale.rs
@@ -0,0 +1,34 @@
+use std::collections::HashMap;
+use std::path::Path;
+
+use slot_store::{ini, Platform, Scale};
+
+use crate::card_log::CardWrites;
+
+pub const RETRO_SCALE_FILE: &str = "Config/retro_scale.txt";
+
+/// Scale per added shelf, one `FOLDER=scale` line each, kept out of slot.state so upstream's state file and
+/// the tests that hold it byte for byte stay as they are (ADR 0110).
+pub fn read(root: &Path) -> HashMap<Platform, Scale> {
+    let mut out = HashMap::new();
+    for (key, value) in ini::read(root, RETRO_SCALE_FILE) {
+        let platform = Platform::SHELVES
+            .into_iter()
+            .find(|p| !p.classic() && p.dir_name() == key);
+        match (platform, Scale::parse(&value)) {
+            (Some(platform), Some(scale)) => {
+                out.insert(platform, scale);
+            }
+            _ => eprintln!("slot: retro scale: ignoring {key}={value}"),
+        }
+    }
+    out
+}
+
+pub fn save(root: &Path, platform: Platform, scale: Scale, writes: &CardWrites) {
+    let written = ini::write(root, RETRO_SCALE_FILE, platform.dir_name(), scale.name());
+    if let Err(e) = &written {
+        eprintln!("slot: retro scale: could not write retro_scale.txt: {e}");
+    }
+    writes.wrote("retro_scale.txt", &written);
+}
