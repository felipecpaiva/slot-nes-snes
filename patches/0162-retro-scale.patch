diff --git a/crates/slot/tests/retro_scale.rs b/crates/slot/tests/retro_scale.rs
new file mode 100644
index 0000000..bfe98ff
--- /dev/null
+++ b/crates/slot/tests/retro_scale.rs
@@ -0,0 +1,180 @@
+//! Scale on the added shelves (ADR 0110): upstream's Scale row, one per shelf, saved in its own file.
+
+mod common;
+
+use common::{app_booting_at, tmp_root_with_carts, CLOCK_IS_SET};
+use slot::app::{App, Phase};
+use slot_input::{Action, Btn};
+use slot_store::{read_slot_state, write_slot_state, Platform, Scale, SlotState};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+const PAGES: [(Platform, QuickRow, QuickRow); 23] = [
+    (Platform::Nes, QuickRow::NesScale, QuickRow::ScreenNes),
+    (Platform::Snes, QuickRow::SnesScale, QuickRow::ScreenSnes),
+    (Platform::Gg, QuickRow::GgScale, QuickRow::ScreenGg),
+    (Platform::Sms, QuickRow::SmsScale, QuickRow::ScreenSms),
+    (Platform::Md, QuickRow::MdScale, QuickRow::ScreenMd),
+    (Platform::Ps1, QuickRow::Ps1Scale, QuickRow::ScreenPs1),
+    (Platform::Tg16, QuickRow::Tg16Scale, QuickRow::ScreenTg16),
+    (Platform::Ws, QuickRow::WsScale, QuickRow::ScreenWs),
+    (Platform::Lynx, QuickRow::LynxScale, QuickRow::ScreenLynx),
+    (Platform::Ngp, QuickRow::NgpScale, QuickRow::ScreenNgp),
+    (Platform::S32x, QuickRow::S32xScale, QuickRow::ScreenS32x),
+    (Platform::A2600, QuickRow::A2600Scale, QuickRow::ScreenA2600),
+    (Platform::A7800, QuickRow::A7800Scale, QuickRow::ScreenA7800),
+    (Platform::Vb, QuickRow::VbScale, QuickRow::ScreenVb),
+    (
+        Platform::NeoGeo,
+        QuickRow::NeoGeoScale,
+        QuickRow::ScreenNeoGeo,
+    ),
+    (Platform::Fds, QuickRow::FdsScale, QuickRow::ScreenFds),
+    (Platform::Cps1, QuickRow::Cps1Scale, QuickRow::ScreenCps1),
+    (Platform::Pico8, QuickRow::Pico8Scale, QuickRow::ScreenPico8),
+    (Platform::Cps2, QuickRow::Cps2Scale, QuickRow::ScreenCps2),
+    (Platform::Sgx, QuickRow::SgxScale, QuickRow::ScreenSgx),
+    (Platform::Pcecd, QuickRow::PcecdScale, QuickRow::ScreenPcecd),
+    (
+        Platform::SegaCd,
+        QuickRow::SegaCdScale,
+        QuickRow::ScreenSegaCd,
+    ),
+    (Platform::Neocd, QuickRow::NeocdScale, QuickRow::ScreenNeocd),
+];
+
+fn root_with_every_shelf() -> TempDir {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    write_slot_state(
+        d.path(),
+        &SlotState {
+            clock_set: true,
+            ..SlotState::default()
+        },
+    )
+    .expect("write slot.state");
+    for (p, ..) in PAGES {
+        let dir = d.path().join("Games").join(p.dir_name());
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(
+            dir.join(format!("Game.{}", p.extensions()[0])),
+            vec![0u8; 0x400],
+        )
+        .unwrap();
+    }
+    d
+}
+
+fn boot(d: &TempDir) -> App {
+    let (mut a, _) = app_booting_at(d.path(), CLOCK_IS_SET);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    a.set_panel((640, 480));
+    a
+}
+
+fn press(a: &mut App, btn: Btn) {
+    a.apply(Action::GbaDown(btn));
+    a.apply(Action::GbaUp(btn));
+}
+
+fn open_at(a: &mut App, row: QuickRow) {
+    a.apply(Action::QuickMenu);
+    let mut path = vec![row];
+    while let Some(parent) = path.last().and_then(|r| r.parent()) {
+        path.push(parent);
+    }
+    for (depth, step) in path.iter().rev().enumerate() {
+        if depth > 0 {
+            press(a, Btn::A);
+        }
+        for _ in 0..step.position(&a.hidden_rows()) {
+            press(a, Btn::Down);
+        }
+    }
+    assert_eq!(a.quick_menu(), Some(row), "the bar never reached {row:?}");
+}
+
+#[test]
+fn every_added_shelf_has_a_scale_row_on_its_own_screen_page() {
+    for (_, scale, screen) in PAGES {
+        assert_eq!(scale.parent(), Some(screen), "{scale:?}");
+        assert_eq!(scale.label(), "Scale");
+    }
+}
+
+#[test]
+fn every_added_shelf_starts_on_the_picture_it_always_had() {
+    let d = root_with_every_shelf();
+    let a = boot(&d);
+    for (p, row, _) in PAGES {
+        assert_eq!(a.resolved_scale(p), Scale::SpFrame, "{p:?}");
+        assert_eq!(a.quick_value(row), Some(QuickValue::SpFrame), "{p:?}");
+        assert!(
+            !a.hidden_rows().contains(&row),
+            "{p:?} hides its Scale row on 640x480"
+        );
+    }
+    assert!(!d.path().join("Config/retro_scale.txt").exists());
+}
+
+#[test]
+fn cycling_a_shelf_scale_saves_to_its_own_file_and_survives_a_reboot() {
+    let d = root_with_every_shelf();
+    let mut a = boot(&d);
+    open_at(&mut a, QuickRow::NesScale);
+    press(&mut a, Btn::Right);
+    assert_eq!(a.quick_value(QuickRow::NesScale), Some(QuickValue::Integer));
+    assert_eq!(
+        a.quick_value(QuickRow::SnesScale),
+        Some(QuickValue::SpFrame)
+    );
+    let file = std::fs::read_to_string(d.path().join("Config/retro_scale.txt")).unwrap();
+    assert_eq!(file.trim(), "NES = integer");
+    let after = std::fs::read_to_string(d.path().join("Config/slot.state")).unwrap();
+    assert!(
+        !after.contains("scale_nes"),
+        "the state file got a key of ours:\n{after}"
+    );
+    assert_eq!(
+        read_slot_state(d.path()).scale_gba,
+        SlotState::default().scale_gba,
+        "Game Boy Scale moved"
+    );
+    drop(a);
+    let again = boot(&d);
+    assert_eq!(again.resolved_scale(Platform::Nes), Scale::Integer);
+    assert_eq!(
+        again.quick_value(QuickRow::NesScale),
+        Some(QuickValue::Integer)
+    );
+}
+
+#[test]
+fn a_shelf_with_one_choice_on_this_panel_hides_its_row() {
+    let d = root_with_every_shelf();
+    let mut a = boot(&d);
+    a.set_panel((720, 480));
+    assert_eq!(a.scale_choices(Platform::Nes), [Scale::Integer]);
+    assert!(a.hidden_rows().contains(&QuickRow::NesScale));
+    assert!(!a.hidden_rows().contains(&QuickRow::SnesScale));
+    a.set_panel((640, 480));
+    assert!(!a.hidden_rows().contains(&QuickRow::NesScale));
+}
+
+#[test]
+fn a_file_with_unknown_lines_is_read_without_them() {
+    let d = root_with_every_shelf();
+    std::fs::write(
+        d.path().join("Config/retro_scale.txt"),
+        "SNES=fit\nGBA=integer\nNES=sideways\nNOPE=fit\n",
+    )
+    .unwrap();
+    let a = boot(&d);
+    assert_eq!(a.resolved_scale(Platform::Snes), Scale::Fit);
+    assert_eq!(a.resolved_scale(Platform::Nes), Scale::SpFrame);
+    assert_ne!(
+        a.resolved_scale(Platform::Gba),
+        Scale::Integer,
+        "a GBA line in our file moved the GBA shelf"
+    );
+}
