diff --git a/crates/slot/tests/render_sega_quick.rs b/crates/slot/tests/render_sega_quick.rs
new file mode 100644
index 0000000..e254c8a
--- /dev/null
+++ b/crates/slot/tests/render_sega_quick.rs
@@ -0,0 +1,90 @@
+#![cfg(target_os = "macos")]
+
+mod common;
+
+use std::collections::VecDeque;
+
+use common::{clocked, tmp_root_with_real_carts};
+use slot::frontend::Frontend;
+use slot_gfx::{Compositor, HeadlessSurface, OUT_H, OUT_W};
+use slot_input::{Btn, InputSource, Millis, RawEvent};
+use slot_power::SimPlatform;
+use slot_store::Platform;
+use slot_ui::QUICK_LABEL_X;
+
+struct Script(VecDeque<Vec<RawEvent>>);
+
+impl InputSource for Script {
+    fn poll(&mut self, _now: Millis) -> Vec<RawEvent> {
+        self.0.pop_front().unwrap_or_default()
+    }
+}
+
+fn tap(f: &mut Frontend, input: &mut Script, btn: Btn) {
+    input.0.push_back(vec![RawEvent::Down(btn)]);
+    f.advance(input);
+    input.0.push_back(vec![RawEvent::Up(btn)]);
+    f.advance(input);
+}
+
+fn save(px: &[u8], name: &str) {
+    let Ok(dir) = std::env::var("SCRATCH_PNG_DIR") else {
+        return;
+    };
+    let path = format!("{dir}/quick-menu-{name}.png");
+    let file = std::fs::File::create(&path).expect("create png");
+    let mut e = png::Encoder::new(std::io::BufWriter::new(file), OUT_W, OUT_H);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(px)
+        .expect("png data");
+    println!("wrote {path}");
+}
+
+#[test]
+fn the_full_screen_list_of_eight_systems_fits_between_the_top_and_the_legend() {
+    let Ok(surface) = HeadlessSurface::new() else {
+        return;
+    };
+    let Ok(mut c) = Compositor::new(&surface) else {
+        return;
+    };
+    let d = tmp_root_with_real_carts(&["Emerald"]);
+    for platform in [
+        Platform::Gb,
+        Platform::Nes,
+        Platform::Gg,
+        Platform::Sms,
+        Platform::Md,
+    ] {
+        let dir = d.path().join("Games").join(platform.dir_name());
+        std::fs::create_dir_all(&dir).expect("create dir");
+        let cart = dir.join(format!("Zelda.{}", platform.extensions()[0]));
+        std::fs::write(cart, vec![0u8; 0x8000]).expect("write cart");
+    }
+    clocked(d.path());
+    let mut f = Frontend::boot(Box::new(SimPlatform::at(d.path().to_path_buf())));
+    f.upload_faces(&mut c);
+    let mut input = Script(VecDeque::new());
+    tap(&mut f, &mut input, Btn::Menu);
+    tap(&mut f, &mut input, Btn::Down);
+    tap(&mut f, &mut input, Btn::A);
+    f.compose(&mut c);
+    let px = c.read_frame();
+    save(&px, "sega-screen-list");
+    let x0 = QUICK_LABEL_X as usize;
+    let ink = |x: usize, y: usize| {
+        let i = (y * OUT_W as usize + x) * 4;
+        px[i..i + 3].iter().all(|c| *c > 0x70)
+    };
+    let rows: Vec<usize> = (0..427).filter(|y| (x0..360).any(|x| ink(x, *y))).collect();
+    let bands = rows.windows(2).filter(|w| w[1] > w[0] + 1).count() + 1;
+    assert!(bands >= 8, "only {bands} ink bands for eight rows");
+    assert!(rows[0] > 0, "the first row is cut at the top");
+    assert!(
+        *rows.last().expect("ink") < 427,
+        "the last row runs into the legend"
+    );
+}
diff --git a/crates/slot/tests/sega_ingame_shader.rs b/crates/slot/tests/sega_ingame_shader.rs
new file mode 100644
index 0000000..057b073
--- /dev/null
+++ b/crates/slot/tests/sega_ingame_shader.rs
@@ -0,0 +1,75 @@
+mod common;
+mod input_common;
+
+use input_common::playing;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{
+    read_sega_shaders, read_slot_state, Platform, RetroShader, SegaShaders, Shader, SlotState,
+};
+use slot_ui::{QuickRow, Toast};
+
+fn chord(session: &mut slot::session::Session, now: &mut Millis, b: Btn) -> u16 {
+    let mut ever = 0;
+    for ev in [
+        RawEvent::Down(Btn::Select),
+        RawEvent::Down(b),
+        RawEvent::Up(b),
+        RawEvent::Up(Btn::Select),
+    ] {
+        *now += 20;
+        session.feed([ev], *now);
+        ever |= session.emu().expect("core").input().0;
+    }
+    ever
+}
+
+fn cycle(platform: Platform, pick: fn(&SegaShaders) -> Shader) {
+    let (root, mut session) = playing(platform, "Zzz");
+    let mut now = 100;
+    assert_eq!(session.app().screen_shader(), Shader::Off);
+    assert_eq!(
+        session.app().quick_value(QuickRow::Shader),
+        Some(slot_ui::QuickValue::Off)
+    );
+    let mut ever = 0;
+    for _ in 0..Shader::RETRO.len() {
+        ever |= chord(&mut session, &mut now, Btn::A);
+        session.app().flush_state();
+        let saved = pick(&read_sega_shaders(root.path()));
+        assert_eq!(session.app().screen_shader(), saved, "{platform:?}");
+        if let Shader::Retro(s) = saved {
+            assert_eq!(session.app().toast(), Some(Toast::Retro(s)));
+        }
+    }
+    assert_eq!(session.app().screen_shader(), Shader::Off);
+    ever |= chord(&mut session, &mut now, Btn::B);
+    session.app().flush_state();
+    assert_eq!(
+        pick(&read_sega_shaders(root.path())),
+        Shader::Retro(RetroShader::Pixel)
+    );
+    let st = read_slot_state(root.path());
+    assert_eq!(st.shader_nes, SlotState::default().shader_nes);
+    assert_eq!(st.shader_gb, SlotState::default().shader_gb);
+    assert_eq!(
+        ever & (ButtonMask::A | ButtonMask::B),
+        0,
+        "A or B reached the game"
+    );
+}
+
+#[test]
+fn select_a_and_b_cycle_the_game_gear_shader_into_the_sega_file() {
+    cycle(Platform::Gg, |s| s.gg);
+}
+
+#[test]
+fn select_a_and_b_cycle_the_master_system_shader_into_the_sega_file() {
+    cycle(Platform::Sms, |s| s.sms);
+}
+
+#[test]
+fn select_a_and_b_cycle_the_mega_drive_shader_into_the_sega_file() {
+    cycle(Platform::Md, |s| s.md);
+}
diff --git a/crates/slot/tests/sega_quick_shader.rs b/crates/slot/tests/sega_quick_shader.rs
new file mode 100644
index 0000000..e052cd7
--- /dev/null
+++ b/crates/slot/tests/sega_quick_shader.rs
@@ -0,0 +1,187 @@
+mod common;
+
+use common::{boot, tmp_root_with_real_carts, write_gb_cart};
+use slot::app::App;
+use slot_input::{Action, Btn};
+use slot_store::{
+    read_sega_shaders, read_slot_state, Platform, RetroShader, SegaShaders, Shader, SlotState,
+};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card(platforms: &[Platform]) -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    write_gb_cart(&root, "Tetris", "TETRIS");
+    for platform in platforms {
+        let dir = root.path().join("Games").join(platform.dir_name());
+        std::fs::create_dir_all(&dir).expect("create dir");
+        let cart = dir.join(format!("Sonic.{}", platform.extensions()[0]));
+        std::fs::write(cart, vec![0u8; 0x8000]).expect("write cart");
+    }
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    common::through(app, btn);
+}
+
+fn open_screen(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::Screen));
+    press(app, Btn::A);
+}
+
+fn screen_list(app: &mut App) -> Vec<QuickRow> {
+    open_screen(app);
+    let first = app.quick_menu().expect("menu open");
+    let mut rows = vec![first];
+    loop {
+        press(app, Btn::Down);
+        let row = app.quick_menu().expect("menu open");
+        if row == first {
+            return rows;
+        }
+        rows.push(row);
+    }
+}
+
+const SEGA: [Platform; 3] = [Platform::Gg, Platform::Sms, Platform::Md];
+
+#[test]
+fn the_screen_list_names_each_sega_system_after_the_others_when_its_carts_are_on_the_card() {
+    let (_root, mut app) = card(&SEGA);
+    assert_eq!(
+        screen_list(&mut app),
+        [
+            QuickRow::ScreenGeneral,
+            QuickRow::ScreenGba,
+            QuickRow::ScreenGbc,
+            QuickRow::ScreenGb,
+            QuickRow::ScreenGg,
+            QuickRow::ScreenSms,
+            QuickRow::ScreenMd,
+        ]
+    );
+}
+
+#[test]
+fn a_sega_system_with_no_carts_on_the_card_stays_off_the_screen_list() {
+    let (_root, mut app) = card(&[Platform::Md, Platform::Nes]);
+    assert_eq!(
+        screen_list(&mut app),
+        [
+            QuickRow::ScreenGeneral,
+            QuickRow::ScreenGba,
+            QuickRow::ScreenGbc,
+            QuickRow::ScreenGb,
+            QuickRow::ScreenNes,
+            QuickRow::ScreenSnes,
+            QuickRow::ScreenMd,
+        ]
+    );
+    let (_root, mut app) = card(&[]);
+    assert_eq!(
+        screen_list(&mut app),
+        [
+            QuickRow::ScreenGeneral,
+            QuickRow::ScreenGba,
+            QuickRow::ScreenGbc,
+            QuickRow::ScreenGb
+        ]
+    );
+}
+
+#[test]
+fn every_card_mix_hides_exactly_the_absent_systems() {
+    use slot::retro_quick::hidden_on_shelf;
+    assert!(hidden_on_shelf([true; 4]).is_empty());
+    for key in 0..15u8 {
+        let systems = [0, 1, 2, 3].map(|i| key & 1 << i != 0);
+        let hidden = hidden_on_shelf(systems);
+        assert_eq!(hidden.contains(&QuickRow::ScreenNes), !systems[0]);
+        assert_eq!(hidden.contains(&QuickRow::ScreenSnes), !systems[0]);
+        assert_eq!(hidden.contains(&QuickRow::ScreenGg), !systems[1]);
+        assert_eq!(hidden.contains(&QuickRow::ScreenSms), !systems[2]);
+        assert_eq!(hidden.contains(&QuickRow::ScreenMd), !systems[3]);
+    }
+}
+
+#[test]
+fn each_sega_shader_row_walks_the_nine_retro_shaders_into_its_own_file_not_slot_state() {
+    type Pick = fn(&SegaShaders) -> Shader;
+    let rows: [(QuickRow, QuickRow, Pick); 3] = [
+        (QuickRow::ScreenGg, QuickRow::GgShader, |s| s.gg),
+        (QuickRow::ScreenSms, QuickRow::SmsShader, |s| s.sms),
+        (QuickRow::ScreenMd, QuickRow::MdShader, |s| s.md),
+    ];
+    for (console, row, pick) in rows {
+        let (root, mut app) = card(&SEGA);
+        let before = std::fs::read(root.path().join("Config/slot.state")).ok();
+        open_screen(&mut app);
+        for _ in 0..console.position(&app.hidden_rows()) {
+            press(&mut app, Btn::Down);
+        }
+        assert_eq!(app.quick_menu(), Some(console));
+        press(&mut app, Btn::A);
+        assert_eq!(app.quick_menu(), Some(row));
+        assert_eq!(app.quick_value(row), Some(QuickValue::Off));
+        let mut seen = vec![];
+        for _ in 0..Shader::RETRO.len() {
+            press(&mut app, Btn::Right);
+            app.flush_state();
+            seen.push(pick(&read_sega_shaders(root.path())));
+        }
+        assert_eq!(seen[..2], [Shader::Grid, Shader::Dot], "{console:?}");
+        assert_eq!(seen[7], Shader::Retro(RetroShader::Pixel), "{console:?}");
+        assert_eq!(seen[8], Shader::Off, "{console:?}");
+        press(&mut app, Btn::Left);
+        app.flush_state();
+        let saved = read_sega_shaders(root.path());
+        assert_eq!(pick(&saved), Shader::Retro(RetroShader::Pixel));
+        assert_eq!(
+            app.quick_value(row),
+            Some(QuickValue::Retro(RetroShader::Pixel))
+        );
+        let others = [saved.gg, saved.sms, saved.md]
+            .iter()
+            .filter(|s| **s == Shader::Off)
+            .count();
+        assert_eq!(others, 2, "{console:?} moved another Sega shader");
+        assert_eq!(
+            std::fs::read(root.path().join("Config/slot.state")).ok(),
+            before,
+            "{console:?} wrote slot.state"
+        );
+        let st = read_slot_state(root.path());
+        assert_eq!(st.shader_nes, SlotState::default().shader_nes);
+        assert_eq!(st.shader_snes, SlotState::default().shader_snes);
+    }
+}
+
+#[test]
+fn a_sega_shader_on_the_card_is_the_one_the_screen_draws_with_after_a_boot() {
+    let (root, app) = card(&SEGA);
+    drop(app);
+    std::fs::write(
+        root.path().join("Config/sega_shaders.txt"),
+        "gg=crt-pi\nsms=line\nmd=scanlines\n",
+    )
+    .expect("write sega shaders");
+    let app = boot(root.path());
+    assert_eq!(
+        app.quick_value(QuickRow::GgShader),
+        Some(QuickValue::Retro(RetroShader::CrtPi))
+    );
+    assert_eq!(
+        app.quick_value(QuickRow::SmsShader),
+        Some(QuickValue::Retro(RetroShader::Line))
+    );
+    assert_eq!(
+        app.quick_value(QuickRow::MdShader),
+        Some(QuickValue::Retro(RetroShader::Scanlines))
+    );
+}
