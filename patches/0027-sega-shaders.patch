diff --git a/crates/slot-store/src/sega_shader.rs b/crates/slot-store/src/sega_shader.rs
new file mode 100644
index 0000000..1c05bbb
--- /dev/null
+++ b/crates/slot-store/src/sega_shader.rs
@@ -0,0 +1,59 @@
+use std::path::Path;
+
+use crate::atomic::atomic_write;
+use crate::slot_state::{list_path, Shader};
+
+pub const SEGA_SHADERS_FILE: &str = "sega_shaders.txt";
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub struct SegaShaders {
+    pub gg: Shader,
+    pub sms: Shader,
+    pub md: Shader,
+}
+
+impl Default for SegaShaders {
+    fn default() -> Self {
+        SegaShaders {
+            gg: Shader::Off,
+            sms: Shader::Off,
+            md: Shader::Off,
+        }
+    }
+}
+
+pub fn read_sega_shaders(root: &Path) -> SegaShaders {
+    let mut s = SegaShaders::default();
+    let text = std::fs::read_to_string(list_path(root, SEGA_SHADERS_FILE)).unwrap_or_default();
+    for (key, value) in text.lines().filter_map(|l| l.split_once('=')) {
+        let Some(shader) = Shader::parse(value.trim()).filter(|v| Shader::RETRO.contains(v)) else {
+            eprintln!("slot: {SEGA_SHADERS_FILE}: ignoring {key}={value}");
+            continue;
+        };
+        match key.trim() {
+            "gg" => s.gg = shader,
+            "sms" => s.sms = shader,
+            "md" => s.md = shader,
+            other => eprintln!("slot: {SEGA_SHADERS_FILE}: ignoring {other}"),
+        }
+    }
+    s
+}
+
+pub fn write_sega_shaders(root: &Path, s: &SegaShaders) -> std::io::Result<()> {
+    let path = list_path(root, SEGA_SHADERS_FILE);
+    let text = format!(
+        "gg={}\nsms={}\nmd={}\n",
+        s.gg.name(),
+        s.sms.name(),
+        s.md.name()
+    );
+    let unchanged = match std::fs::read(&path) {
+        Ok(old) => old == text.as_bytes(),
+        Err(_) => *s == SegaShaders::default(),
+    };
+    if unchanged {
+        return Ok(());
+    }
+    atomic_write(&path, text.as_bytes())
+}
diff --git a/crates/slot-store/tests/sega_shader_state.rs b/crates/slot-store/tests/sega_shader_state.rs
new file mode 100644
index 0000000..61c40b0
--- /dev/null
+++ b/crates/slot-store/tests/sega_shader_state.rs
@@ -0,0 +1,57 @@
+mod common;
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, write_sega_shaders, write_slot_state, RetroShader,
+    SegaShaders, Shader, SlotState,
+};
+
+#[test]
+fn a_card_with_no_sega_shader_file_reads_every_sega_shader_as_off() {
+    let d = tmp_root();
+    assert_eq!(read_sega_shaders(d.path()), SegaShaders::default());
+    assert_eq!(SegaShaders::default().gg, Shader::Off);
+}
+
+#[test]
+fn sega_shaders_round_trip_through_their_own_file() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        gg: Shader::Retro(RetroShader::CrtPi),
+        sms: Shader::Grid,
+        md: Shader::Retro(RetroShader::Line),
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config/sega_shaders.txt")).expect("read"),
+        "gg=crt-pi\nsms=grid\nmd=line\n"
+    );
+    assert_eq!(read_sega_shaders(d.path()), s);
+}
+
+#[test]
+fn a_damaged_or_foreign_line_keeps_the_default_for_that_system_only() {
+    let d = tmp_root();
+    std::fs::write(
+        d.path().join("Config/sega_shaders.txt"),
+        "gg=lcd3x\nsms=bogus\nmd=pixel\nnes=crt-pi\nnot a line\n",
+    )
+    .expect("write");
+    let s = read_sega_shaders(d.path());
+    assert_eq!(s.gg, Shader::Off);
+    assert_eq!(s.sms, Shader::Off);
+    assert_eq!(s.md, Shader::Retro(RetroShader::Pixel));
+}
+
+#[test]
+fn the_default_sega_shaders_write_no_file_and_slot_state_never_names_them() {
+    let d = tmp_root();
+    write_sega_shaders(d.path(), &SegaShaders::default()).expect("write");
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    write_slot_state(d.path(), &SlotState::default()).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    for key in ["shader_gg", "shader_sms", "shader_md", "sega"] {
+        assert!(!text.contains(key), "{key} in {text:?}");
+    }
+    assert_eq!(read_slot_state(d.path()), SlotState::default());
+}
