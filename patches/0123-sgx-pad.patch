+#[test]
+fn the_pad_row_walks_two_and_six_buttons_into_sgx_txt() {
+    let (root, mut app) = card_with_a_supergrafx_game();
+    open_supergrafx(&mut app);
+    press(&mut app, Btn::Down);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::SgxPad));
+    assert_eq!(
+        app.quick_value(QuickRow::SgxPad),
+        Some(QuickValue::TwoButtons)
+    );
+    assert!(!root.path().join(slot::sgx_pad::SGX_FILE).exists());
+    press(&mut app, Btn::Right);
+    assert_eq!(
+        app.quick_value(QuickRow::SgxPad),
+        Some(QuickValue::SixButtons)
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(slot::sgx_pad::SGX_FILE)).expect("sgx.txt"),
+        "pad = 6\n"
+    );
+    assert_eq!(slot::sgx_pad::SgxPad::read(root.path()), SgxPad::Six);
+    press(&mut app, Btn::Right);
+    assert_eq!(slot::sgx_pad::SgxPad::read(root.path()), SgxPad::Two);
+}
+
+#[test]
+fn the_pad_row_answers_the_cores_joypad_type_and_only_on_the_supergrafx() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let d = tmp_root_with_real_carts(&[]);
+    for (file, want) in [(None, "2 Buttons"), (Some("pad = 6\n"), "6 Buttons")] {
+        if let Some(text) = file {
+            std::fs::write(d.path().join(slot::sgx_pad::SGX_FILE), text).unwrap();
+        }
+        let mut core = answered(&dylib);
+        slot::sgx_pad::apply(&mut core, d.path(), Platform::Sgx);
+        assert_eq!(
+            core.option("sgx_default_joypad_type_p1").as_deref(),
+            Some(want)
+        );
+        drop(core);
+        let mut other = answered(&dylib);
+        slot::sgx_pad::apply(&mut other, d.path(), Platform::Tg16);
+        assert_eq!(
+            other.option("sgx_default_joypad_type_p1").as_deref(),
+            Some("2 Buttons")
+        );
+    }
+}
+
+#[test]
+fn with_six_buttons_x_y_l1_and_r1_reach_the_supergrafx_game_as_iii_to_vi() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    std::fs::write(root.path().join(slot::sgx_pad::SGX_FILE), "pad = 6\n").unwrap();
+    let mut session = real_seat::play(root.path(), true);
+    let input = |s: &Session| s.emu().expect("no core").input().0;
+    assert!(session.app().taken_buttons().is_empty());
+    let mut now = 5000;
+    for (btn, bit) in [
+        (Btn::X, ButtonMask::X),
+        (Btn::Y, ButtonMask::Y),
+        (Btn::L1, ButtonMask::L),
+        (Btn::R1, ButtonMask::R),
+    ] {
+        session.feed([RawEvent::Down(btn)], now);
+        assert_eq!(input(&session), bit, "{btn:?} held");
+        session.feed([RawEvent::Up(btn)], now + 100);
+        assert_eq!(input(&session), 0, "{btn:?} let go");
+        now += 200;
+    }
+}
+
+#[test]
+fn with_two_buttons_l1_and_r1_stay_slots_picture_keys() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut session = real_seat::play(root.path(), true);
+    let input = |s: &Session| s.emu().expect("no core").input().0;
+    assert_eq!(session.app().taken_buttons(), [Btn::L1, Btn::R1]);
+    session.feed([RawEvent::Down(Btn::L1)], 5000);
+    assert_eq!(input(&session), 0);
+}
