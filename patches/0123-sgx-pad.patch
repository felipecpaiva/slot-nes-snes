--- /dev/null
+++ b/crates/slot/src/sgx_pad.rs
@@ -0,0 +1,84 @@
+use std::path::Path;
+
+use slot_retro::LibretroCore;
+use slot_store::{ini, Platform};
+use slot_ui::{QuickRow, QuickValue};
+
+use crate::card_log::CardWrites;
+
+pub const SGX_FILE: &str = "Config/sgx.txt";
+
+const PAD_KEY: &str = "pad";
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum SgxPad {
+    #[default]
+    Two,
+    Six,
+}
+
+impl SgxPad {
+    pub const ALL: [SgxPad; 2] = [SgxPad::Two, SgxPad::Six];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            SgxPad::Two => "2",
+            SgxPad::Six => "6",
+        }
+    }
+
+    pub fn core_value(self) -> &'static str {
+        match self {
+            SgxPad::Two => "2 Buttons",
+            SgxPad::Six => "6 Buttons",
+        }
+    }
+
+    pub fn quick_value(self) -> QuickValue {
+        match self {
+            SgxPad::Two => QuickValue::TwoButtons,
+            SgxPad::Six => QuickValue::SixButtons,
+        }
+    }
+
+    pub fn read(root: &Path) -> SgxPad {
+        let Some(line) = ini::value(root, SGX_FILE, PAD_KEY) else {
+            return SgxPad::default();
+        };
+        SgxPad::ALL
+            .into_iter()
+            .find(|p| p.as_str() == line)
+            .unwrap_or_else(|| {
+                eprintln!("slot: sgx.txt: ignoring {PAD_KEY}={line}");
+                SgxPad::default()
+            })
+    }
+
+    pub fn change(&mut self, row: QuickRow, root: Option<&Path>, writes: &CardWrites) -> bool {
+        if row != QuickRow::SgxPad {
+            return false;
+        }
+        *self = match self {
+            SgxPad::Two => SgxPad::Six,
+            SgxPad::Six => SgxPad::Two,
+        };
+        if let Some(root) = root {
+            let written = ini::write(root, SGX_FILE, PAD_KEY, self.as_str());
+            if let Err(e) = &written {
+                eprintln!("slot: emu: could not write sgx.txt: {e}");
+            }
+            writes.wrote("sgx.txt", &written);
+        }
+        true
+    }
+}
+
+pub fn apply(core: &mut LibretroCore, root: &Path, platform: Platform) {
+    if platform != Platform::Sgx {
+        return;
+    }
+    core.set_option(
+        "sgx_default_joypad_type_p1",
+        SgxPad::read(root).core_value(),
+    );
+}
