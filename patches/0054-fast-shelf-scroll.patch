index 0000000..a1f3d26
--- /dev/null
+++ b/crates/slot-ui/src/shelf/fast.rs
@@ -0,0 +1,28 @@
+use super::Shelf;
+
+const FAST_AFTER: usize = 30;
+const LONG_SHELF: usize = 60;
+const FAST_STRIDE: i32 = 3;
+const LEASH: f32 = 1.0;
+
+impl Shelf {
+    pub fn fast(&self) -> bool {
+        matches!(self.held, Some((_, _, fired)) if fired >= FAST_AFTER)
+            && self.carts.len() >= LONG_SHELF
+    }
+
+    pub(super) fn stride(&self) -> i32 {
+        match self.fast() {
+            true => FAST_STRIDE,
+            false => 1,
+        }
+    }
+
+    pub(super) fn leash(&mut self) {
+        if !self.fast() {
+            return;
+        }
+        let target = self.scroll_target();
+        self.scroll = self.scroll.clamp(target - LEASH, target + LEASH);
+    }
+}
