+use slot_store::{Cart, Platform};
+use slot_ui::{Canvas, Shelf};
+
+fn shelf_with(n: usize) -> Shelf {
+    Shelf::new(
+        (0..n)
+            .map(|i| Cart {
+                platform: Platform::Gba,
+                stem: format!("Game {i:03}"),
+                rom: format!("Games/GBA/Game {i:03}.gba").into(),
+                label: None,
+                code: String::new(),
+                shell: None,
+                title: format!("GAME {i:03}"),
+            })
+            .collect(),
+    )
+}
+
+fn hold_for(s: &mut Shelf, frames: u64) {
+    s.hold_right(0);
+    for f in 1..=frames {
+        s.tick(f * 1000 / 60);
+        s.update(1.0 / 60.0);
+    }
+}
+
+fn repeat_at(fired: usize) -> u64 {
+    400 + (0..fired).map(slot_ui::repeat_gap).sum::<u64>()
+}
+
+fn draws_a_cart(s: &Shelf) -> bool {
+    let mut out = Vec::new();
+    s.draw_row(Canvas::FRAMED, None, 0.0, 0.0, 1.0, &mut out);
+    !out.is_empty()
+}
+
+#[test]
+fn the_first_thirty_repeats_move_one_cart_each() {
+    let mut s = shelf_with(100);
+    s.hold_right(0);
+    for fired in 0..30 {
+        s.tick(repeat_at(fired));
+    }
+    assert_eq!(s.index, 31);
+    assert!(s.fast());
+}
+
+#[test]
+fn the_thirty_first_repeat_on_a_long_shelf_moves_three_carts() {
+    let mut s = shelf_with(100);
+    s.hold_right(0);
+    for fired in 0..31 {
+        s.tick(repeat_at(fired));
+    }
+    assert_eq!(s.index, 34);
+}
+
+#[test]
+fn a_shelf_under_sixty_carts_never_moves_more_than_one_a_step() {
+    let mut s = shelf_with(59);
+    s.hold_right(0);
+    for fired in 0..40 {
+        s.tick(repeat_at(fired));
+    }
+    assert_eq!(s.index, 41);
+    assert!(!s.fast());
+}
+
+#[test]
+fn a_new_press_after_fast_scroll_starts_at_one_cart_again() {
+    let mut s = shelf_with(100);
+    s.hold_right(0);
+    for fired in 0..35 {
+        s.tick(repeat_at(fired));
+    }
+    s.release_right();
+    assert!(!s.fast());
+    let at = s.index;
+    s.hold_right(10_000);
+    assert_eq!(s.index, at + 1);
+}
+
+#[test]
+fn ten_seconds_of_fast_scroll_never_leave_the_row_empty() {
+    let mut s = shelf_with(700);
+    s.hold_right(0);
+    for f in 1..=600u64 {
+        s.tick(f * 1000 / 60);
+        s.update(1.0 / 60.0);
+        assert!(draws_a_cart(&s), "frame {f}: no cart on screen");
+    }
+    assert!(s.fast());
+}
+
+#[test]
+fn letting_go_of_fast_scroll_settles_on_the_selected_cart() {
+    let mut s = shelf_with(700);
+    hold_for(&mut s, 300);
+    s.release_right();
+    for _ in 0..600 {
+        s.update(1.0 / 60.0);
+    }
+    assert!((s.scroll - s.scroll_target()).abs() < 1e-3);
+}
