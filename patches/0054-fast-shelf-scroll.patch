+mod common;
+
+use std::time::{Duration, Instant};
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::fast_scroll_trace::{FastScrollTrace, FastView};
+use slot_input::{Action, Btn};
+
+const PERIOD: Duration = Duration::from_micros(16_720);
+
+fn long_shelf() -> (tempfile::TempDir, App) {
+    let stems: Vec<String> = (0..70).map(|i| format!("Game {i:03}")).collect();
+    let stems: Vec<&str> = stems.iter().map(String::as_str).collect();
+    let root = tmp_root_with_real_carts(&stems);
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn hold_right(app: &mut App, frames: usize) {
+    app.apply(Action::GbaDown(Btn::Right));
+    for _ in 0..frames {
+        app.update(1.0 / 60.0);
+    }
+}
+
+fn view(fast: bool, placeholder: bool) -> Option<FastView> {
+    Some(FastView {
+        fast,
+        placeholder,
+        empty: false,
+    })
+}
+
+#[test]
+fn a_shelf_held_into_fast_scroll_asks_for_no_cart_face_and_prefetches_nothing() {
+    let (_root, mut app) = long_shelf();
+    hold_right(&mut app, 180);
+    assert_eq!(app.face_wants(), Vec::new());
+    assert_eq!(app.browsed_rom(), None);
+    assert_eq!(
+        app.stem_to_prebuild(),
+        None,
+        "the core picker faces were built mid-hold"
+    );
+}
+
+fn settle(app: &mut App) {
+    app.apply(Action::GbaUp(Btn::Right));
+    for _ in 0..120 {
+        app.update(1.0 / 60.0);
+    }
+}
+
+#[test]
+fn a_settled_row_after_fast_scroll_waits_on_no_face_until_its_faces_are_back() {
+    let (_root, mut app) = long_shelf();
+    hold_right(&mut app, 180);
+    settle(&mut app);
+    let wants = app.face_wants();
+    assert!(!wants.is_empty());
+    assert!(wants.iter().all(|w| !w.on_screen), "{wants:?}");
+    assert_eq!(
+        app.browsed_rom(),
+        None,
+        "prefetched while faces were still missing"
+    );
+    assert_eq!(app.stem_to_prebuild(), None);
+    for (n, w) in wants.iter().enumerate() {
+        app.set_cart_face(w.shelf, w.index, slot_gfx::TexId::from_raw(1000 + n));
+    }
+    app.update(1.0 / 60.0);
+    assert!(
+        app.browsed_rom().is_some(),
+        "no prefetch once the faces are back"
+    );
+    assert!(app.stem_to_prebuild().is_some());
+    assert_eq!(app.stem_to_prebuild(), app.selected_stem());
+    assert_eq!(app.fast_scroll_view(), None);
+}
+
+#[test]
+fn a_plain_hold_still_waits_on_its_visible_faces_and_prefetches() {
+    let (_root, mut app) = long_shelf();
+    hold_right(&mut app, 20);
+    assert!(app.face_wants().iter().any(|w| w.on_screen));
+    assert!(app.browsed_rom().is_some());
+    assert_eq!(app.stem_to_prebuild(), app.selected_stem());
+}
+
+#[test]
+fn a_shelf_at_rest_still_waits_on_its_visible_faces() {
+    let (_root, app) = long_shelf();
+    assert!(app.face_wants().iter().any(|w| w.on_screen));
+}
+
+#[test]
+fn fast_scroll_shows_placeholders_and_never_an_empty_board() {
+    let (_root, mut app) = long_shelf();
+    hold_right(&mut app, 180);
+    assert_eq!(
+        app.fast_scroll_view(),
+        Some(FastView {
+            fast: true,
+            placeholder: true,
+            empty: false
+        })
+    );
+}
+
+#[test]
+fn a_shelf_at_rest_has_no_fast_scroll_view() {
+    let (_root, app) = long_shelf();
+    assert_eq!(app.fast_scroll_view(), None);
+}
+
+#[test]
+fn the_trace_prints_one_line_once_the_row_has_settled() {
+    let mut trace = FastScrollTrace::new();
+    let t0 = Instant::now();
+    let at = |i: u32| t0 + Duration::from_millis(17) * i;
+    assert_eq!(trace.frame(None, at(0), PERIOD), None);
+    for i in 1..=60 {
+        assert_eq!(trace.frame(view(true, i % 2 == 0), at(i), PERIOD), None);
+    }
+    for i in 61..=99 {
+        assert_eq!(trace.frame(view(false, false), at(i), PERIOD), None);
+    }
+    let stall = at(99) + Duration::from_millis(40);
+    assert_eq!(trace.frame(view(false, true), stall, PERIOD), None);
+    assert_eq!(
+        trace
+            .frame(None, stall + Duration::from_millis(17), PERIOD)
+            .as_deref(),
+        Some("slot: fast scroll: 99 frames, p50 17.00 p99 40.00 max 40.00 ms, period 16.72 ms, 31 with a placeholder, 0 empty")
+    );
+}
+
+#[test]
+fn a_settling_row_without_fast_scroll_prints_nothing() {
+    let mut trace = FastScrollTrace::new();
+    let t0 = Instant::now();
+    for i in 0..10u32 {
+        let at = t0 + Duration::from_millis(17) * i;
+        assert_eq!(trace.frame(view(false, true), at, PERIOD), None);
+    }
+    assert_eq!(
+        trace.frame(None, t0 + Duration::from_millis(170), PERIOD),
+        None
+    );
+}
+
+#[test]
+fn a_shelf_just_let_go_of_fast_scroll_still_reports_while_it_settles() {
+    let (_root, mut app) = long_shelf();
+    hold_right(&mut app, 180);
+    app.apply(Action::GbaUp(Btn::Right));
+    app.update(1.0 / 60.0);
+    assert_eq!(app.fast_scroll_view().map(|v| v.fast), Some(false));
+}
+
+#[test]
+fn the_trace_is_silent_without_fast_scroll() {
+    let mut trace = FastScrollTrace::new();
+    let t0 = Instant::now();
+    for i in 0..10u32 {
+        assert_eq!(
+            trace.frame(None, t0 + Duration::from_millis(17) * i, PERIOD),
+            None
+        );
+    }
+}
