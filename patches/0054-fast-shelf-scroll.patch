diff --git a/crates/slot/src/fast_scroll_trace.rs b/crates/slot/src/fast_scroll_trace.rs
new file mode 100644
index 0000000..3a38d74
--- /dev/null
+++ b/crates/slot/src/fast_scroll_trace.rs
@@ -0,0 +1,73 @@
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct FastView {
+    pub fast: bool,
+    pub placeholder: bool,
+    pub empty: bool,
+}
+
+#[derive(Default)]
+pub struct FastScrollTrace {
+    last: Option<Instant>,
+    open: bool,
+    frames: Vec<f64>,
+    placeholders: u32,
+    empty: u32,
+}
+
+impl FastScrollTrace {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn frame(
+        &mut self,
+        view: Option<FastView>,
+        now: Instant,
+        period: Duration,
+    ) -> Option<String> {
+        let since = self.last.replace(now).map(|last| now - last);
+        let was_open = self.open;
+        match view {
+            Some(view) if view.fast || was_open => {
+                self.open = true;
+                if let (true, Some(since)) = (was_open, since) {
+                    self.frames.push(since.as_secs_f64() * 1e3);
+                }
+                self.placeholders += u32::from(view.placeholder);
+                self.empty += u32::from(view.empty);
+                None
+            }
+            _ if was_open => {
+                self.open = false;
+                self.finish(period)
+            }
+            _ => None,
+        }
+    }
+
+    fn finish(&mut self, period: Duration) -> Option<String> {
+        if self.frames.is_empty() {
+            return None;
+        }
+        self.frames.sort_by(f64::total_cmp);
+        let n = self.frames.len();
+        let at = |q: f64| {
+            let i = ((n as f64 * q).ceil() as usize).clamp(1, n) - 1;
+            self.frames.get(i).copied().unwrap_or_default()
+        };
+        let line = format!(
+            "slot: fast scroll: {n} frames, p50 {:.2} p99 {:.2} max {:.2} ms, period {:.2} ms, {} with a placeholder, {} empty",
+            at(0.5),
+            at(0.99),
+            at(1.0),
+            period.as_secs_f64() * 1e3,
+            self.placeholders,
+            self.empty
+        );
+        self.frames.clear();
+        (self.placeholders, self.empty) = (0, 0);
+        Some(line)
+    }
+}
