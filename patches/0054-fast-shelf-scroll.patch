@@ -0,0 +1,49 @@
+use crate::fast_scroll_trace::FastView;
+
+use super::{App, Phase};
+
+const SETTLED: f32 = 0.05;
+
+impl App {
+    pub fn fast_scroll_view(&self) -> Option<FastView> {
+        let shelf = self.shelf();
+        let fast = shelf.fast();
+        if !matches!(self.phase, Phase::Shelf) || !(fast || self.settling() || self.fast_trail) {
+            return None;
+        }
+        let mut out = Vec::new();
+        shelf.draw_row(self.canvas(), None, 0.0, 0.0, 1.0, &mut out);
+        Some(FastView {
+            fast,
+            placeholder: self.faces_missing(),
+            empty: out.is_empty(),
+        })
+    }
+
+    pub fn shelf_racing(&self) -> bool {
+        self.shelf().fast() || self.fast_trail
+    }
+
+    pub fn stem_to_prebuild(&self) -> Option<&str> {
+        if self.shelf_racing() && self.core_picker.is_none() {
+            return None;
+        }
+        self.selected_stem()
+    }
+
+    pub(super) fn track_fast(&mut self) {
+        let trail =
+            self.shelf().fast() || (self.fast_trail && (self.settling() || self.faces_missing()));
+        self.fast_trail = matches!(self.phase, Phase::Shelf) && trail;
+    }
+
+    fn settling(&self) -> bool {
+        let shelf = self.shelf();
+        (shelf.scroll - shelf.scroll_target()).abs() > SETTLED
+    }
+
+    fn faces_missing(&self) -> bool {
+        let shelf = self.shelf();
+        shelf.on_screen().iter().any(|i| shelf.face(*i).is_none())
+    }
+}
