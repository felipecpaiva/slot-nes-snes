+++ b/crates/slot/tests/sgx_platform.rs
@@ -0,0 +1,387 @@
+mod common;
+mod core_common;
+mod input_common;
+mod real_seat;
+mod sgx_common;
+mod tg16_common;
+
+use std::path::{Path, PathBuf};
+
+use common::{boot, core_lock, tmp_root_with_real_carts};
+use sgx_common::{card, supergrafx, work_ram_size, SGX_RAM};
+use slot::app::{App, Phase};
+use slot::core::{apply_core_options, open_core_for_palette};
+use slot::core_options_policy::answers_declared_defaults;
+use slot::input::Pad;
+use slot::persist::Snapshot;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::session::Session;
+use slot::video_mode::VideoMode;
+use slot_input::{Action, Btn, RawEvent, SELECT_CHORD_MS};
+use slot_retro::{ButtonMask, LibretroCore};
+use slot_store::{Controls, Core, Platform, Shader, SGX_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+use tg16_common::RED_BGRX;
+
+const EXPLICIT: [(&str, &str); 10] = [
+    ("sgx_initial_scanline", "3"),
+    ("sgx_last_scanline", "242"),
+    ("sgx_hoverscan", "352"),
+    ("sgx_palette", "RGB"),
+    ("sgx_default_joypad_type_p1", "2 Buttons"),
+    ("sgx_disable_softreset", "disabled"),
+    ("sgx_turbo_toggle", "disabled"),
+    ("sgx_nospritelimit", "disabled"),
+    ("sgx_ocmultiplier", "1"),
+    ("sgx_forcesgx", "enabled"),
+];
+
+const CD_KEYS: [&str; 7] = [
+    "sgx_cdbios",
+    "sgx_cdimagecache",
+    "sgx_cdspeed",
+    "sgx_adpcmvolume",
+    "sgx_cddavolume",
+    "sgx_cdpsgvolume",
+    "sgx_detect_gexpress",
+];
+
+const STEM: &str = "Daimakaimura";
+const HUBM: &[u8; 8] = b"HUBM\x00\x88\x10\x80";
+
+fn answered(dylib: &Path) -> LibretroCore {
+    let d = tmp_root_with_real_carts(&[]);
+    let mut core = LibretroCore::open_with(dylib, d.path(), d.path()).expect("open supergrafx");
+    apply_core_options(
+        &mut core,
+        Core::MednafenSupergrafx,
+        Platform::Sgx,
+        "auto",
+        false,
+        false,
+        None,
+    );
+    core
+}
+
+#[test]
+fn every_explicit_supergrafx_option_is_answered_with_a_value_the_pinned_core_declares() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let core = answered(&dylib);
+    for (key, value) in EXPLICIT {
+        assert_eq!(core.option(key).as_deref(), Some(value), "{key}");
+        let values = core
+            .declared_options()
+            .get(key)
+            .unwrap_or_else(|| panic!("the pin no longer declares {key}"));
+        assert!(
+            values.iter().any(|v| v == value),
+            "{key}={value} {values:?}"
+        );
+    }
+}
+
+#[test]
+fn the_cd_keys_stay_unanswered_because_no_hucard_reaches_them() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let core = answered(&dylib);
+    for key in CD_KEYS {
+        assert!(core.declared_options().contains_key(key), "{key}");
+        assert_eq!(core.option(key), None, "{key}");
+    }
+}
+
+#[test]
+fn beetle_supergrafx_declares_no_frameskip_and_gets_only_its_list() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let core = answered(&dylib);
+    assert!(!core.declared_options().contains_key("sgx_frameskip"));
+    assert_eq!(core.option("sgx_frameskip"), None);
+    assert!(!answers_declared_defaults(Core::MednafenSupergrafx));
+}
+
+#[test]
+fn through_slots_open_path_a_pce_card_runs_as_a_supergrafx_and_fills_the_canvas_height() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let d = tmp_root_with_real_carts(&[]);
+    let rom = card(&d.path().join("Games/SGX"), "Paint", "pce");
+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::MednafenSupergrafx,
+        Platform::Sgx,
+        "",
+        false,
+        None,
+        std::slice::from_ref(&dylib),
+    );
+    core.load(&rom).expect("Beetle SuperGrafx refused the card");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(work_ram_size(&dylib), SGX_RAM);
+    assert_eq!(core.frame_width(), 256);
+    let video = core.video_xrgb8888();
+    for y in 0..240 {
+        for x in 0..360 {
+            let at = (y * 360 + x) * 4;
+            let want = if (52..52 + 256).contains(&x) {
+                RED_BGRX
+            } else {
+                [0, 0, 0]
+            };
+            assert_eq!(&video[at..at + 3], want, "({x}, {y})");
+        }
+    }
+}
+
+fn card_with_a_supergrafx_game() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(
+        root.path().join("Games/SGX/Daimakaimura (Japan) (En).sgx"),
+        [0u8; 0x2000],
+    )
+    .expect("write card");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_supergrafx(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenSgx.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenSgx));
+    press(app, Btn::A);
+}
+
+#[test]
+fn supergrafx_follows_pico8_in_the_screen_list_and_opens_shader_and_picture() {
+    assert_eq!(QuickRow::SCREEN[22], QuickRow::ScreenSgx);
+    assert_eq!(QuickRow::ScreenSgx.label(), "SuperGrafx");
+    assert!(QuickRow::ScreenSgx.opens());
+    assert_eq!(QuickRow::ScreenSgx.child(), Some(QuickRow::SgxShader));
+    assert_eq!(
+        QuickRow::SCREEN_SGX.map(QuickRow::label),
+        ["Shader", "Picture"]
+    );
+    for row in QuickRow::SCREEN_SGX {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenSgx));
+        assert_eq!(row.page(), &QuickRow::SCREEN_SGX);
+    }
+}
+
+#[test]
+fn the_supergrafx_row_shows_only_on_a_card_with_supergrafx_games() {
+    let (_root, mut app) = card_with_a_supergrafx_game();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenSgx));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    assert!(boot(root.path())
+        .hidden_rows()
+        .contains(&QuickRow::ScreenSgx));
+    open_supergrafx(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::SgxShader));
+}
+
+#[test]
+fn the_supergrafx_shader_walks_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_supergrafx_game();
+    let state = std::fs::read(root.path().join("Config/slot.state")).ok();
+    open_supergrafx(&mut app);
+    assert_eq!(app.quick_value(QuickRow::SgxShader), Some(QuickValue::Off));
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(slot_store::read_sega_shaders(root.path()).sgx);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(SGX_SHADER_FILE).exists());
+    assert!(!root.path().join("Config/tg16_shader.txt").exists());
+    assert_eq!(
+        std::fs::read(root.path().join("Config/slot.state")).ok(),
+        state
+    );
+}
+
+#[test]
+fn the_supergrafx_picture_starts_at_crop_and_walks_stretch_actual_four_three_crop() {
+    assert_eq!(default_video_mode(Platform::Sgx), VideoMode::Crop);
+    use VideoMode::{Actual, Crop, FourThree, Stretch};
+    assert_eq!(
+        picture_choices(Platform::Sgx),
+        [Crop, Stretch, Actual, FourThree]
+    );
+    let (root, mut app) = card_with_a_supergrafx_game();
+    open_supergrafx(&mut app);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::SgxPicture));
+    assert_eq!(
+        app.quick_value(QuickRow::SgxPicture),
+        Some(QuickValue::Crop)
+    );
+    for want in [Stretch, Actual, FourThree, Crop] {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        assert_eq!(
+            app.quick_value(QuickRow::SgxPicture),
+            Some(want.quick_value())
+        );
+        assert_eq!(system_picture(root.path(), Platform::Sgx), want);
+    }
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "sgx = crop\n"
+    );
+    assert_eq!(system_picture(root.path(), Platform::Tg16), Crop);
+}
+
+#[test]
+fn the_in_game_shader_row_steps_the_supergrafx_shader_into_its_own_file() {
+    let (root, mut session) = input_common::playing(Platform::Sgx, "Aldynes");
+    assert_eq!(session.app().screen_shader(), Shader::Off);
+    let mut now = 100;
+    for ev in [
+        RawEvent::Down(Btn::Select),
+        RawEvent::Down(Btn::A),
+        RawEvent::Up(Btn::A),
+        RawEvent::Up(Btn::Select),
+    ] {
+        now += 20;
+        session.feed([ev], now);
+    }
+    session.app().flush_state();
+    assert_eq!(session.app().screen_shader(), Shader::RETRO[1]);
+    assert_eq!(
+        slot_store::read_sega_shaders(root.path()).sgx,
+        Shader::RETRO[1]
+    );
+    assert_eq!(slot_store::read_sega_shaders(root.path()).tg16, Shader::Off);
+}
+
+#[test]
+fn a_booted_card_has_the_supergrafx_folders() {
+    let (root, _app) = card_with_a_supergrafx_game();
+    for dir in ["Games/SGX", "Saves/SGX", "States/SGX", "Labels/SGX"] {
+        assert!(slot::root::DIRS.contains(&dir), "{dir}");
+        assert!(root.path().join(dir).is_dir(), "{dir}");
+    }
+}
+
+fn seated(dylib: &Path) -> TempDir {
+    let roms = tempfile::tempdir().expect("tempdir");
+    let rom = card(roms.path(), STEM, "sgx");
+    let root = real_seat::rooted(Platform::Sgx, STEM, &rom, dylib);
+    card(&root.path().join("Games/SGX"), "Zzz", "sgx");
+    root
+}
+
+fn sav(root: &Path) -> PathBuf {
+    root.join("Saves/SGX").join(format!("{STEM}.sav"))
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+#[test]
+fn a_marked_backup_ram_survives_an_eject_and_a_reinsert_through_saves_sgx() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut marked = vec![0u8; 2048];
+    marked[..8].copy_from_slice(HUBM);
+    marked[0x10..0x14].copy_from_slice(b"SAVE");
+    std::fs::write(sav(root.path()), &marked).expect("write sav");
+    let mut first = real_seat::play(root.path(), true);
+    let in_core = |s: &Session| s.emu().expect("no core").snapshot().save_ram();
+    assert!(in_core(&first) == Some(marked.clone()), "first insert");
+    eject(&mut first);
+    drop(first);
+    assert!(std::fs::read(sav(root.path())).expect("read sav") == marked);
+    let second = real_seat::play(root.path(), true);
+    assert!(in_core(&second) == Some(marked), "after reinsert");
+}
+
+#[test]
+fn a_supergrafx_card_that_never_saves_leaves_a_2_kb_formatted_sav_on_eject() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut session = real_seat::play(root.path(), true);
+    eject(&mut session);
+    let mut blank = vec![0u8; 2048];
+    blank[..8].copy_from_slice(HUBM);
+    assert!(std::fs::read(sav(root.path())).expect("no sav after eject") == blank);
+}
+
+fn held(btn: Btn) -> u16 {
+    let mut p = Pad::default();
+    p.apply(Action::GbaDown(btn));
+    p.mask_for(&Controls::default(), Platform::Sgx).0
+}
+
+#[test]
+fn the_supergrafx_pad_is_the_turbografx_one_with_turbo_on_x_and_y() {
+    assert_eq!(held(Btn::B), ButtonMask::B, "II");
+    assert_eq!(held(Btn::A), ButtonMask::A, "I");
+    assert_eq!(held(Btn::Start), ButtonMask::START, "Run");
+    assert_eq!(held(Btn::X), ButtonMask::X);
+    assert_eq!(held(Btn::Y), ButtonMask::Y);
+    assert!(Platform::Sgx.turbo_on_xy());
+    assert!(!Platform::Sgx.passes_xy_through());
+}
+
+#[test]
+fn on_the_device_select_reaches_the_supergrafx_game_only_after_the_chord_hold() {
+    let _g = core_lock();
+    let Some(dylib) = supergrafx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut session = real_seat::play(root.path(), true);
+    let input = |s: &Session| s.emu().expect("no core").input().0;
+    assert_eq!(session.app().taken_buttons(), [Btn::L1, Btn::R1]);
+    session.feed([RawEvent::Down(Btn::Select)], 5000);
+    assert_eq!(input(&session) & ButtonMask::SELECT, 0, "at once");
+    session.feed([], 5000 + SELECT_CHORD_MS + 1);
+    assert_eq!(input(&session), ButtonMask::SELECT, "after the hold");
+    session.feed([RawEvent::Up(Btn::Select)], 5000 + SELECT_CHORD_MS + 20);
+    for (btn, bit) in [(Btn::X, ButtonMask::X), (Btn::Y, ButtonMask::Y)] {
+        session.feed([RawEvent::Down(btn)], 9000);
+        assert_eq!(input(&session), bit, "{btn:?} held");
+        session.feed([RawEvent::Up(btn)], 9100);
+        assert_eq!(input(&session), 0, "{btn:?} let go");
+    }
+}
