+#[test]
+fn the_real_us_bios_boots_to_its_menu_and_draws_inside_the_mega_drive_picture() {
+    let _g = core_lock();
+    let Some(bios) = real_bios() else {
+        return;
+    };
+    let r = Root::new(&[("bios_CD_U.bin", &bios)]);
+    let Some(mut core) = r.core(&[]) else {
+        return;
+    };
+    // With no disc: the BIOS file itself as the content, which the core boots as a CD unit.
+    let alone = r.games().join("bios_CD_U.bin");
+    std::fs::write(&alone, &bios).unwrap();
+    for content in [alone, cue_disc(&r.games(), "Menu", US)] {
+        core.load(&content)
+            .unwrap_or_else(|e| panic!("{}: {e}", content.display()));
+        play(&mut core, 600);
+        let fps = core.av_info().fps;
+        assert!((59.90..59.95).contains(&fps), "{fps} fps");
+        let width = core.frame_width() as usize;
+        assert!(width == 320 || width == 256, "frame width {width}");
+        let video = core.video_xrgb8888();
+        let (x0, y0) = ((CANVAS.0 - width) / 2, 8);
+        let mut lit = 0;
+        for y in 0..CANVAS.1 {
+            for x in 0..CANVAS.0 {
+                let at = (y * CANVAS.0 + x) * 4;
+                let px = &video[at..at + 3];
+                let inside = (x0..x0 + width).contains(&x) && (y0..y0 + 224).contains(&y);
+                if inside {
+                    lit += usize::from(px != [0, 0, 0]);
+                } else {
+                    assert_eq!(px, [0, 0, 0], "{}: ({x}, {y})", content.display());
+                }
+            }
+        }
+        assert!(lit > 1000, "{}: {lit} lit pixels", content.display());
+        eprintln!("{}: {width} wide, {lit} lit pixels", content.display());
+    }
+}
