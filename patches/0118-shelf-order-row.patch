new file mode 100644
index 0000000..46fdd3b
--- /dev/null
+++ b/crates/slot-ui/src/screen_order.rs
@@ -0,0 +1,23 @@
+use std::cell::Cell;
+
+use crate::QuickRow;
+
+thread_local! {
+    static SCREEN_PAGE: Cell<&'static [QuickRow]> = const { Cell::new(&QuickRow::SCREEN) };
+}
+
+pub fn screen_page() -> &'static [QuickRow] {
+    SCREEN_PAGE.with(Cell::get)
+}
+
+pub fn set_screen_page(rows: &'static [QuickRow]) {
+    let same_rows =
+        rows.len() == QuickRow::SCREEN.len() && QuickRow::SCREEN.iter().all(|r| rows.contains(r));
+    if !same_rows {
+        eprintln!(
+            "slot: screen order: ignoring a Screen page that is not the Screen rows reordered"
+        );
+        return;
+    }
+    SCREEN_PAGE.with(|p| p.set(rows));
+}
