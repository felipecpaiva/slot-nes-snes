+            QuickRow::ScreenGba,
+            QuickRow::ScreenGbc,
+            QuickRow::ScreenGb,
+            QuickRow::ScreenNes,
+            QuickRow::ScreenSnes,
+            QuickRow::ScreenGg,
+            QuickRow::ScreenPs1,
+            QuickRow::ScreenS32x,
+        ]
