+#[test]
+fn release_year_reorders_the_screen_page_at_once_and_after_a_reboot() {
+    let d = card();
+    let mut a = boot(d.path());
+    flip_shelf_order(&mut a);
+    let want = [
+        QuickRow::ScreenGeneral,
+        QuickRow::ScreenNes,
+        QuickRow::ScreenGb,
+        QuickRow::ScreenGg,
+        QuickRow::ScreenSnes,
+        QuickRow::ScreenS32x,
+        QuickRow::ScreenPs1,
+        QuickRow::ScreenGbc,
+        QuickRow::ScreenGba,
+    ];
+    assert_eq!(screen_page_walk(&mut a), want);
+    let mut a = boot(d.path());
+    assert_eq!(screen_page_walk(&mut a), want);
+    flip_shelf_order(&mut a);
+    assert_eq!(screen_page_walk(&mut a)[1], QuickRow::ScreenGba);
+}
