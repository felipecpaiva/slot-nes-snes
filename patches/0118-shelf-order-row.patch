+#[test]
+fn the_screen_rows_in_release_year_are_the_shelf_order_platforms() {
+    let rows: Vec<QuickRow> = std::iter::once(QuickRow::ScreenGeneral)
+        .chain(
+            ShelfOrder::ReleaseYear
+                .platforms()
+                .into_iter()
+                .map(screen_row),
+        )
+        .collect();
+    assert_eq!(ShelfOrder::ReleaseYear.screen_rows(), rows);
+    assert_eq!(ShelfOrder::Classic.screen_rows(), QuickRow::SCREEN);
+}
