@@ -0,0 +1,219 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root_with_carts;
+use slot::app::App;
+use slot::shelf_order::{screen_row, ShelfOrder, SHELF_ORDER_FILE};
+use slot_input::{Action, Btn};
+use slot_store::{write_slot_state, Platform, SlotState};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card() -> TempDir {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    for platform in [Platform::Gg, Platform::Snes, Platform::Ps1, Platform::S32x] {
+        let cart = d
+            .path()
+            .join("Games")
+            .join(platform.dir_name())
+            .join(format!("Cart.{}", platform.extensions()[0]));
+        std::fs::write(cart, vec![0u8; 0x200]).expect("write cart");
+    }
+    d
+}
+
+fn boot(root: &Path) -> App {
+    write_slot_state(
+        root,
+        &SlotState {
+            clock_set: true,
+            ..SlotState::default()
+        },
+    )
+    .expect("write slot.state");
+    App::boot(root)
+}
+
+fn press(a: &mut App, btn: Btn) {
+    common::through(a, btn);
+    for _ in 0..120 {
+        a.update(1.0 / 60.0);
+    }
+}
+
+fn go_to(a: &mut App, platform: Platform) {
+    for _ in 0..8 {
+        if a.shelf_platform_name() == Some(platform.name()) {
+            return;
+        }
+        press(a, Btn::R1);
+    }
+    panic!("never reached the {platform:?} shelf");
+}
+
+fn flip_shelf_order(a: &mut App) {
+    a.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::General.position(&a.hidden_rows()) {
+        press(a, Btn::Down);
+    }
+    press(a, Btn::A);
+    for _ in 0..QuickRow::ShelfOrder.position(&a.hidden_rows()) {
+        press(a, Btn::Down);
+    }
+    assert_eq!(a.quick_menu(), Some(QuickRow::ShelfOrder));
+    press(a, Btn::Right);
+    while a.quick_menu().is_some() {
+        press(a, Btn::B);
+    }
+}
+
+#[test]
+fn the_shelf_order_row_sits_on_the_general_page_between_game_titles_and_cpu() {
+    let at = |r: QuickRow| QuickRow::GENERAL.iter().position(|g| *g == r);
+    assert_eq!(
+        at(QuickRow::ShowTitles).map(|i| i + 1),
+        at(QuickRow::ShelfOrder)
+    );
+    assert_eq!(at(QuickRow::ShelfOrder).map(|i| i + 1), at(QuickRow::Cpu));
+    assert_eq!(QuickRow::ShelfOrder.parent(), Some(QuickRow::General));
+    assert_eq!(QuickRow::ShelfOrder.label(), "Shelf Order");
+}
+
+#[test]
+fn a_fresh_card_shows_classic() {
+    let d = card();
+    let a = boot(d.path());
+    assert_eq!(
+        a.quick_value(QuickRow::ShelfOrder),
+        Some(QuickValue::Classic)
+    );
+}
+
+#[test]
+fn right_on_the_row_saves_release_year_and_a_reboot_keeps_it() {
+    let d = card();
+    let mut a = boot(d.path());
+    flip_shelf_order(&mut a);
+    assert_eq!(
+        a.quick_value(QuickRow::ShelfOrder),
+        Some(QuickValue::ReleaseYear)
+    );
+    assert_eq!(ShelfOrder::read(d.path()), ShelfOrder::ReleaseYear);
+    let text = std::fs::read_to_string(d.path().join(SHELF_ORDER_FILE)).expect("shelf_order.txt");
+    assert_eq!(text, "order = release-year\n");
+    let a = boot(d.path());
+    assert_eq!(
+        a.quick_value(QuickRow::ShelfOrder),
+        Some(QuickValue::ReleaseYear)
+    );
+}
+
+#[test]
+fn the_new_order_applies_at_once_and_the_shelf_stays_selected() {
+    let d = card();
+    let mut a = boot(d.path());
+    go_to(&mut a, Platform::Snes);
+    press(&mut a, Btn::R1);
+    assert_eq!(a.shelf_platform_name(), Some(Platform::Gg.name()));
+    press(&mut a, Btn::L1);
+    flip_shelf_order(&mut a);
+    assert_eq!(a.shelf_platform_name(), Some(Platform::Snes.name()));
+    press(&mut a, Btn::R1);
+    assert_eq!(a.shelf_platform_name(), Some(Platform::S32x.name()));
+    press(&mut a, Btn::L1);
+    press(&mut a, Btn::L1);
+    assert_eq!(a.shelf_platform_name(), Some(Platform::Gg.name()));
+}
+
+#[test]
+fn flipping_back_to_classic_puts_the_old_order_back_at_once() {
+    let d = card();
+    let mut a = boot(d.path());
+    go_to(&mut a, Platform::Snes);
+    flip_shelf_order(&mut a);
+    flip_shelf_order(&mut a);
+    assert_eq!(ShelfOrder::read(d.path()), ShelfOrder::Classic);
+    assert_eq!(a.shelf_platform_name(), Some(Platform::Snes.name()));
+    press(&mut a, Btn::R1);
+    assert_eq!(a.shelf_platform_name(), Some(Platform::Gg.name()));
+}
+
+fn screen_page_walk(a: &mut App) -> Vec<QuickRow> {
+    a.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&a.hidden_rows()) {
+        press(a, Btn::Down);
+    }
+    press(a, Btn::A);
+    let first = a.quick_menu().expect("on the Screen page");
+    let mut rows = vec![first];
+    loop {
+        press(a, Btn::Down);
+        let row = a.quick_menu().expect("still on the Screen page");
+        if row == first {
+            break;
+        }
+        rows.push(row);
+    }
+    while a.quick_menu().is_some() {
+        press(a, Btn::B);
+    }
+    rows
+}
