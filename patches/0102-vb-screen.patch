@@ -0,0 +1,258 @@
+mod common;
+mod core_common;
+mod vb_common;
+
+use common::{boot, core_lock, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::pal_speed::PAL_SPEED_FILE;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::vb_screen::{apply, Palette, RightPad, VbScreen, VB_FILE};
+use slot::video_mode::{source_rect, VideoMode};
+use slot_gfx::WHOLE_TEXTURE;
+use slot_input::{Action, Btn};
+use slot_retro::{LibretroCore, RetroCore};
+use slot_store::{read_sega_shaders, Core, Platform, Shader, VB_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_a_cart() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(root.path().join("Games/VB/Wario Land.vb"), [0u8; 16]).expect("write cart");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_vb(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenVb.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenVb));
+    press(app, Btn::A);
+}
+
+fn down_to(app: &mut App, row: QuickRow) {
+    while app.quick_menu() != Some(row) {
+        press(app, Btn::Down);
+    }
+}
+
+#[test]
+fn the_virtual_boy_closes_the_screen_list_with_its_own_five_row_section() {
+    assert_eq!(QuickRow::SCREEN.last(), Some(&QuickRow::ScreenVb));
+    assert_eq!(QuickRow::ScreenVb.label(), "Virtual Boy");
+    assert!(QuickRow::ScreenVb.opens());
+    assert_eq!(QuickRow::ScreenVb.child(), Some(QuickRow::VbShader));
+    assert_eq!(
+        QuickRow::SCREEN_VB.map(QuickRow::label),
+        ["Shader", "Picture", "VB Speed", "Palette", "Right Pad"]
+    );
+    for row in QuickRow::SCREEN_VB {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenVb));
+    }
+}
+
+#[test]
+fn the_virtual_boy_row_shows_only_on_a_card_with_virtual_boy_games() {
+    let (_root, mut app) = card_with_a_cart();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenVb));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    let without = boot(root.path());
+    assert!(without.hidden_rows().contains(&QuickRow::ScreenVb));
+    open_vb(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::VbShader));
+}
+
+#[test]
+fn the_picture_starts_actual_and_offers_stretch_and_its_own_line_in_picture_txt() {
+    assert_eq!(default_video_mode(Platform::Vb), VideoMode::Actual);
+    assert_eq!(
+        picture_choices(Platform::Vb),
+        [VideoMode::Stretch, VideoMode::Actual]
+    );
+    let (root, mut app) = card_with_a_cart();
+    open_vb(&mut app);
+    down_to(&mut app, QuickRow::VbPicture);
+    assert_eq!(
+        app.quick_value(QuickRow::VbPicture),
+        Some(QuickValue::Actual)
+    );
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_eq!(
+        system_picture(root.path(), Platform::Vb),
+        VideoMode::Stretch
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "vb = stretch\n"
+    );
+}
+
+#[test]
+fn actual_fills_the_panel_width_at_one_and_seven_eighths_and_stretch_fills_the_panel() {
+    let canvas = Core::MednafenVb.canvas(Platform::Vb);
+    assert_eq!(
+        source_rect(Platform::Vb, (384, 224), canvas, VideoMode::Actual),
+        WHOLE_TEXTURE
+    );
+    assert_eq!(
+        source_rect(Platform::Vb, (384, 224), canvas, VideoMode::Stretch),
+        [0.0, 16.0 / 256.0, 1.0, 224.0 / 256.0]
+    );
+    assert_eq!(720.0 / 384.0, 480.0 / 256.0);
+    assert_eq!(224.0 * 720.0 / 384.0, 420.0);
+}
+
+#[test]
+fn the_virtual_boy_shader_walks_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_cart();
+    open_vb(&mut app);
+    assert_eq!(app.quick_value(QuickRow::VbShader), Some(QuickValue::Off));
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(read_sega_shaders(root.path()).vb);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(VB_SHADER_FILE).exists());
+    assert!(!root.path().join("Config/sega_shaders.txt").exists());
+}
+
+#[test]
+fn the_vb_speed_row_starts_native_so_the_50_27_fps_core_is_paced_at_its_own_rate() {
+    let (root, mut app) = card_with_a_cart();
+    assert!(app.native_pal(Platform::Vb));
+    open_vb(&mut app);
+    down_to(&mut app, QuickRow::VbSpeed);
+    assert_eq!(app.quick_value(QuickRow::VbSpeed), Some(QuickValue::Native));
+    press(&mut app, Btn::Right);
+    assert_eq!(app.quick_value(QuickRow::VbSpeed), Some(QuickValue::Panel));
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PAL_SPEED_FILE)).expect("pal_speed.txt"),
+        "vb = panel\n"
+    );
+    assert!(!app.native_pal(Platform::Vb));
+}
+
+#[test]
+fn the_palette_walks_all_eight_colours_from_red_and_the_choice_is_the_next_boots_default() {
+    let (root, mut app) = card_with_a_cart();
+    open_vb(&mut app);
+    down_to(&mut app, QuickRow::VbPalette);
+    assert_eq!(app.quick_value(QuickRow::VbPalette), Some(QuickValue::Red));
+    let mut seen = Vec::new();
+    for _ in 0..Palette::ALL.len() {
+        press(&mut app, Btn::Right);
+        seen.push(app.quick_value(QuickRow::VbPalette));
+    }
+    assert_eq!(
+        seen,
+        [
+            QuickValue::White,
+            QuickValue::Blue,
+            QuickValue::Cyan,
+            QuickValue::ElectricCyan,
+            QuickValue::Green,
+            QuickValue::Magenta,
+            QuickValue::Yellow,
+            QuickValue::Red,
+        ]
+        .map(Some)
+    );
+    press(&mut app, Btn::Left);
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(VB_FILE)).expect("vb.txt"),
+        "palette = yellow\n"
+    );
+    let again = boot(root.path());
+    assert_eq!(
+        again.quick_value(QuickRow::VbPalette),
+        Some(QuickValue::Yellow)
+    );
+}
+
+#[test]
+fn the_right_pad_flips_between_the_stick_and_abxy_and_the_choice_is_the_next_boots_default() {
+    let (root, mut app) = card_with_a_cart();
+    open_vb(&mut app);
+    down_to(&mut app, QuickRow::VbRightPad);
+    assert_eq!(
+        app.quick_value(QuickRow::VbRightPad),
+        Some(QuickValue::Stick)
+    );
+    assert_eq!(QuickValue::Buttons.text(), "ABXY");
+    press(&mut app, Btn::Right);
+    assert_eq!(
+        app.quick_value(QuickRow::VbRightPad),
+        Some(QuickValue::Buttons)
+    );
+    let again = boot(root.path());
+    assert_eq!(
+        again.quick_value(QuickRow::VbRightPad),
+        Some(QuickValue::Buttons)
+    );
+    assert_eq!(
+        VbScreen::read(root.path()),
+        VbScreen {
+            palette: Palette::Red,
+            right_pad: RightPad::Buttons
+        }
+    );
+}
+
+#[test]
+fn an_unknown_value_in_vb_txt_reads_as_the_factory_choice() {
+    let (root, _app) = card_with_a_cart();
+    std::fs::write(
+        root.path().join(VB_FILE),
+        "palette = black & red\nright_pad = left\n",
+    )
+    .expect("write");
+    assert_eq!(VbScreen::read(root.path()), VbScreen::default());
+}
+
+#[test]
+fn the_chosen_palette_is_what_beetle_vb_is_told_at_start_and_only_for_the_virtual_boy() {
+    let _g = core_lock();
+    let Some(dylib) = vb_common::beetle_vb() else {
+        return;
+    };
+    let root = tmp_root_with_real_carts(&[]);
+    std::fs::write(root.path().join(VB_FILE), "palette = electric_cyan\n").expect("write");
+    let mut core = LibretroCore::open_with(&dylib, root.path(), root.path()).expect("open");
+    apply(&mut core, root.path(), Platform::Vb);
+    assert_eq!(
+        core.option("vb_color_mode").as_deref(),
+        Some("black & electric cyan")
+    );
+    drop(core);
+    let mut other = LibretroCore::open_with(&dylib, root.path(), root.path()).expect("open");
+    apply(&mut other, root.path(), Platform::Snes);
+    assert_eq!(other.option("vb_color_mode"), None);
+}
+
+#[test]
+fn every_palette_word_is_one_the_pinned_core_declares() {
+    let _g = core_lock();
+    let Some(dylib) = vb_common::beetle_vb() else {
+        return;
+    };
+    let d = tempfile::tempdir().unwrap();
+    let mut core = LibretroCore::open_with(&dylib, d.path(), d.path()).expect("open");
+    core.load(&vb_common::cart(d.path(), "Eyes")).unwrap();
+    let declared = core.declared_options();
+    let values = declared.get("vb_color_mode").expect("vb_color_mode");
+    let ours: Vec<&str> = Palette::ALL.iter().map(|p| p.core_value()).collect();
+    assert_eq!(*values, ours);
+}
