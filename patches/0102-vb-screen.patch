diff --git a/crates/slot/src/vb_screen.rs b/crates/slot/src/vb_screen.rs
new file mode 100644
index 0000000..138d1a9
--- /dev/null
+++ b/crates/slot/src/vb_screen.rs
@@ -0,0 +1,196 @@
+use std::path::Path;
+
+use slot_retro::LibretroCore;
+use slot_store::{ini, Platform};
+use slot_ui::{QuickRow, QuickValue};
+
+use crate::card_log::CardWrites;
+
+pub const VB_FILE: &str = "Config/vb.txt";
+
+const PALETTE_KEY: &str = "palette";
+const RIGHT_PAD_KEY: &str = "right_pad";
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum Palette {
+    #[default]
+    Red,
+    White,
+    Blue,
+    Cyan,
+    ElectricCyan,
+    Green,
+    Magenta,
+    Yellow,
+}
+
+impl Palette {
+    pub const ALL: [Palette; 8] = [
+        Palette::Red,
+        Palette::White,
+        Palette::Blue,
+        Palette::Cyan,
+        Palette::ElectricCyan,
+        Palette::Green,
+        Palette::Magenta,
+        Palette::Yellow,
+    ];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Palette::Red => "red",
+            Palette::White => "white",
+            Palette::Blue => "blue",
+            Palette::Cyan => "cyan",
+            Palette::ElectricCyan => "electric_cyan",
+            Palette::Green => "green",
+            Palette::Magenta => "magenta",
+            Palette::Yellow => "yellow",
+        }
+    }
+
+    pub fn core_value(self) -> &'static str {
+        match self {
+            Palette::Red => "black & red",
+            Palette::White => "black & white",
+            Palette::Blue => "black & blue",
+            Palette::Cyan => "black & cyan",
+            Palette::ElectricCyan => "black & electric cyan",
+            Palette::Green => "black & green",
+            Palette::Magenta => "black & magenta",
+            Palette::Yellow => "black & yellow",
+        }
+    }
+
+    pub fn quick_value(self) -> QuickValue {
+        match self {
+            Palette::Red => QuickValue::Red,
+            Palette::White => QuickValue::White,
+            Palette::Blue => QuickValue::Blue,
+            Palette::Cyan => QuickValue::Cyan,
+            Palette::ElectricCyan => QuickValue::ElectricCyan,
+            Palette::Green => QuickValue::Green,
+            Palette::Magenta => QuickValue::Magenta,
+            Palette::Yellow => QuickValue::Yellow,
+        }
+    }
+
+    fn stepped(self, right: bool) -> Palette {
+        let n = Palette::ALL.len();
+        let at = Palette::ALL.iter().position(|p| *p == self).unwrap_or(0);
+        let next = if right {
+            (at + 1) % n
+        } else {
+            (at + n - 1) % n
+        };
+        Palette::ALL.get(next).copied().unwrap_or(self)
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum RightPad {
+    #[default]
+    Stick,
+    Buttons,
+}
+
+impl RightPad {
+    pub const ALL: [RightPad; 2] = [RightPad::Stick, RightPad::Buttons];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            RightPad::Stick => "stick",
+            RightPad::Buttons => "abxy",
+        }
+    }
+
+    pub fn quick_value(self) -> QuickValue {
+        match self {
+            RightPad::Stick => QuickValue::Stick,
+            RightPad::Buttons => QuickValue::Buttons,
+        }
+    }
+
+    fn flipped(self) -> RightPad {
+        match self {
+            RightPad::Stick => RightPad::Buttons,
+            RightPad::Buttons => RightPad::Stick,
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub struct VbScreen {
+    pub palette: Palette,
+    pub right_pad: RightPad,
+}
+
+fn read_one<T: Copy + Default>(
+    root: &Path,
+    key: &str,
+    all: &[T],
+    name: fn(T) -> &'static str,
+) -> T {
+    let Some(line) = ini::value(root, VB_FILE, key) else {
+        return T::default();
+    };
+    all.iter()
+        .copied()
+        .find(|v| name(*v) == line)
+        .unwrap_or_else(|| {
+            eprintln!("slot: vb.txt: ignoring {key}={line}");
+            T::default()
+        })
+}
+
+impl VbScreen {
+    pub fn read(root: &Path) -> VbScreen {
+        VbScreen {
+            palette: read_one(root, PALETTE_KEY, &Palette::ALL, Palette::as_str),
+            right_pad: read_one(root, RIGHT_PAD_KEY, &RightPad::ALL, RightPad::as_str),
+        }
+    }
+
+    pub fn quick_value(&self, row: QuickRow) -> Option<QuickValue> {
+        match row {
+            QuickRow::VbPalette => Some(self.palette.quick_value()),
+            QuickRow::VbRightPad => Some(self.right_pad.quick_value()),
+            _ => None,
+        }
+    }
+
+    pub fn change(
+        &mut self,
+        row: QuickRow,
+        right: bool,
+        root: Option<&Path>,
+        writes: &CardWrites,
+    ) -> bool {
+        let (key, value) = match row {
+            QuickRow::VbPalette => {
+                self.palette = self.palette.stepped(right);
+                (PALETTE_KEY, self.palette.as_str())
+            }
+            QuickRow::VbRightPad => {
+                self.right_pad = self.right_pad.flipped();
+                (RIGHT_PAD_KEY, self.right_pad.as_str())
+            }
+            _ => return false,
+        };
+        if let Some(root) = root {
+            let written = ini::write(root, VB_FILE, key, value);
+            if let Err(e) = &written {
+                eprintln!("slot: emu: could not write vb.txt: {e}");
+            }
+            writes.wrote("vb.txt", &written);
+        }
+        true
+    }
+}
+
+pub fn apply(core: &mut LibretroCore, root: &Path, platform: Platform) {
+    if platform != Platform::Vb {
+        return;
+    }
+    core.set_option("vb_color_mode", VbScreen::read(root).palette.core_value());
+}
