--- a/crates/slot/src/platform_video.rs
+++ b/crates/slot/src/platform_video.rs
@@ -1,9 +1,21 @@
 use std::path::Path;
 
 use slot_store::{ini, Platform};
+use slot_ui::{QuickRow, QuickValue};
 
+use crate::card_log::CardWrites;
 use crate::video_mode::{VideoMode, VIDEO_MODE_FILE};
 
+pub const PICTURE_FILE: &str = "Config/picture.txt";
+
+pub const PICTURE_ROWS: [(QuickRow, Platform); 5] = [
+    (QuickRow::NesPicture, Platform::Nes),
+    (QuickRow::SnesPicture, Platform::Snes),
+    (QuickRow::GgPicture, Platform::Gg),
+    (QuickRow::SmsPicture, Platform::Sms),
+    (QuickRow::MdPicture, Platform::Md),
+];
+
 pub fn default_video_mode(platform: Platform) -> VideoMode {
     match platform {
         Platform::Gba | Platform::Gb | Platform::Gbc | Platform::Gg => VideoMode::Actual,
@@ -24,5 +36,78 @@ pub fn video_mode_for(root: &Path, stem: &str, platform: Platform) -> VideoMode
     ini::value(root, VIDEO_MODE_FILE, stem)
         .as_deref()
         .and_then(VideoMode::parse)
-        .unwrap_or_else(|| default_video_mode(platform))
+        .unwrap_or_else(|| system_picture(root, platform))
+}
+
+fn picture_key(platform: Platform) -> String {
+    platform.dir_name().to_ascii_lowercase()
+}
+
+pub fn system_picture(root: &Path, platform: Platform) -> VideoMode {
+    let Some(line) = ini::value(root, PICTURE_FILE, &picture_key(platform)) else {
+        return default_video_mode(platform);
+    };
+    VideoMode::parse(&line).unwrap_or_else(|| {
+        eprintln!(
+            "slot: picture.txt: ignoring {}={line}",
+            picture_key(platform)
+        );
+        default_video_mode(platform)
+    })
+}
+
+pub fn write_system_picture(
+    root: &Path,
+    platform: Platform,
+    mode: VideoMode,
+) -> std::io::Result<()> {
+    ini::write(root, PICTURE_FILE, &picture_key(platform), mode.as_str())
+}
+
+pub fn save(root: &Path, platform: Platform, mode: VideoMode, writes: &CardWrites) {
+    let written = write_system_picture(root, platform, mode);
+    if let Err(e) = &written {
+        eprintln!("slot: video: could not write picture.txt: {e}");
+    }
+    writes.wrote("picture.txt", &written);
+}
+
+impl VideoMode {
+    pub fn quick_value(self) -> QuickValue {
+        match self {
+            VideoMode::Stretch => QuickValue::Stretch,
+            VideoMode::Actual => QuickValue::Actual,
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct SystemPictures([VideoMode; 5]);
+
+impl Default for SystemPictures {
+    fn default() -> Self {
+        SystemPictures(PICTURE_ROWS.map(|(_, p)| default_video_mode(p)))
+    }
+}
+
+impl SystemPictures {
+    pub fn read(root: &Path) -> Self {
+        SystemPictures(PICTURE_ROWS.map(|(_, p)| system_picture(root, p)))
+    }
+
+    pub fn get(&self, row: QuickRow) -> Option<VideoMode> {
+        let at = PICTURE_ROWS.iter().position(|(r, _)| *r == row)?;
+        self.0.get(at).copied()
+    }
+
+    pub fn flip(&mut self, row: QuickRow) -> Option<(Platform, VideoMode)> {
+        let at = PICTURE_ROWS.iter().position(|(r, _)| *r == row)?;
+        let (_, platform) = PICTURE_ROWS.get(at)?;
+        let mode = self.0.get_mut(at)?;
+        *mode = match *mode {
+            VideoMode::Actual => VideoMode::Stretch,
+            VideoMode::Stretch => VideoMode::Actual,
+        };
+        Some((*platform, *mode))
+    }
 }
