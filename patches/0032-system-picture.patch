@@ -0,0 +1,304 @@
+mod common;
+
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::{App, Phase};
+use slot::platform_video::{system_picture, video_mode_for, PICTURE_FILE, PICTURE_ROWS};
+use slot::session::Session;
+use slot::video_mode::{VideoMode, VIDEO_MODE_FILE};
+use slot_input::{Action, Btn, Millis, RawEvent};
+use slot_store::Platform;
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+const STEM: &str = "Zzz";
+
+const SECTIONS: [(QuickRow, QuickRow, QuickRow, Platform, QuickValue); 5] = [
+    (
+        QuickRow::ScreenNes,
+        QuickRow::NesShader,
+        QuickRow::NesPicture,
+        Platform::Nes,
+        QuickValue::Stretch,
+    ),
+    (
+        QuickRow::ScreenSnes,
+        QuickRow::SnesShader,
+        QuickRow::SnesPicture,
+        Platform::Snes,
+        QuickValue::Stretch,
+    ),
+    (
+        QuickRow::ScreenGg,
+        QuickRow::GgShader,
+        QuickRow::GgPicture,
+        Platform::Gg,
+        QuickValue::Actual,
+    ),
+    (
+        QuickRow::ScreenSms,
+        QuickRow::SmsShader,
+        QuickRow::SmsPicture,
+        Platform::Sms,
+        QuickValue::Stretch,
+    ),
+    (
+        QuickRow::ScreenMd,
+        QuickRow::MdShader,
+        QuickRow::MdPicture,
+        Platform::Md,
+        QuickValue::Stretch,
+    ),
+];
+
+fn write_cart(root: &Path, platform: Platform, stem: &str) {
+    let dir = root.join("Games").join(platform.dir_name());
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let cart = dir.join(format!("{stem}.{}", platform.extensions()[0]));
+    std::fs::write(cart, vec![0u8; 0x8000]).expect("write cart");
+}
+
+fn every_system() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    for (_, _, _, platform, _) in SECTIONS {
+        write_cart(root.path(), platform, "Sonic");
+    }
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_section(app: &mut App, console: QuickRow) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..console.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(console));
+    press(app, Btn::A);
+}
+
+fn picture_file(root: &TempDir) -> Option<String> {
+    std::fs::read_to_string(root.path().join(PICTURE_FILE)).ok()
+}
+
+fn root_with(picture: &str, cart_line: Option<&str>) -> TempDir {
+    let d = tempfile::tempdir().expect("tempdir");
+    std::fs::create_dir(d.path().join("Config")).expect("config dir");
+    std::fs::write(d.path().join(PICTURE_FILE), picture).expect("write picture.txt");
+    if let Some(line) = cart_line {
+        std::fs::write(d.path().join(VIDEO_MODE_FILE), format!("{STEM}={line}\n"))
+            .expect("write video_mode.txt");
+    }
+    d
+}
+
+#[test]
+fn each_retro_screen_section_shows_a_picture_row_under_its_shader() {
+    for (console, shader, picture, _, factory) in SECTIONS {
+        let (_root, mut app) = every_system();
+        assert_eq!(picture.page(), [shader, picture], "{console:?}");
+        assert_eq!(picture.label(), "Picture");
+        open_section(&mut app, console);
+        assert_eq!(app.quick_menu(), Some(shader));
+        press(&mut app, Btn::Down);
+        assert_eq!(app.quick_menu(), Some(picture));
+        assert_eq!(app.quick_value(picture), Some(factory), "{console:?}");
+        press(&mut app, Btn::Down);
+        assert_eq!(app.quick_menu(), Some(shader), "{console:?} does not wrap");
+    }
+}
+
+#[test]
+fn the_game_boy_sections_gain_no_picture_row() {
+    for page in [
+        &QuickRow::SCREEN_GBA[..],
+        &QuickRow::SCREEN_GBC[..],
+        &QuickRow::SCREEN_GB[..],
+    ] {
+        assert!(page.iter().all(|r| r.label() != "Picture"), "{page:?}");
+    }
+    for (_, platform) in PICTURE_ROWS {
+        assert!(!matches!(
+            platform,
+            Platform::Gba | Platform::Gb | Platform::Gbc
+        ));
+    }
+}
+
+#[test]
+fn the_picture_row_walks_stretch_and_actual_and_saves_only_its_own_system() {
+    for (console, _, picture, platform, factory) in SECTIONS {
+        let (root, mut app) = every_system();
+        let state = std::fs::read(root.path().join("Config/slot.state")).ok();
+        open_section(&mut app, console);
+        press(&mut app, Btn::Down);
+        assert_eq!(
+            picture_file(&root),
+            None,
+            "{console:?} wrote before a change"
+        );
+        let flipped = match factory {
+            QuickValue::Stretch => (QuickValue::Actual, VideoMode::Actual),
+            _ => (QuickValue::Stretch, VideoMode::Stretch),
+        };
+        press(&mut app, Btn::Right);
+        assert_eq!(app.quick_value(picture), Some(flipped.0), "{console:?}");
+        assert_eq!(system_picture(root.path(), platform), flipped.1);
+        let key = platform.dir_name().to_ascii_lowercase();
+        assert_eq!(
+            picture_file(&root),
+            Some(format!("{key} = {}\n", flipped.1.as_str()))
+        );
+        for (_, _, other, p, own) in SECTIONS {
+            if p != platform {
+                assert_eq!(app.quick_value(other), Some(own), "{console:?} moved {p:?}");
+            }
+        }
+        press(&mut app, Btn::Left);
+        assert_eq!(app.quick_value(picture), Some(factory));
+        press(&mut app, Btn::Left);
+        assert_eq!(app.quick_value(picture), Some(flipped.0));
+        assert_eq!(
+            std::fs::read(root.path().join("Config/slot.state")).ok(),
+            state,
+            "{console:?} wrote slot.state"
+        );
+        drop(app);
+        let app = boot(root.path());
+        assert_eq!(app.quick_value(picture), Some(flipped.0), "{console:?}");
+    }
+}
