+#[test]
+fn select_x_still_sets_the_running_snes_cart_and_leaves_the_system_picture() {
+    for platform in [Platform::Snes, Platform::Md] {
+        let key = platform.dir_name().to_ascii_lowercase();
+        let picture = format!("{key} = actual\n");
+        let mut r = Rig::seated(platform, &picture);
+        assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+        r.feed(RawEvent::Down(Btn::Select));
+        r.feed(RawEvent::Down(Btn::X));
+        r.feed(RawEvent::Up(Btn::X));
+        r.feed(RawEvent::Up(Btn::Select));
+        assert_ne!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+        assert_eq!(r.cart_line().as_deref(), Some("stretch"), "{platform:?}");
+        assert_eq!(r.picture_file(), Some(picture), "{platform:?}");
+    }
+}
