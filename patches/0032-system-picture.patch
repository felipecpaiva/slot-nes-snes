+struct Rig {
+    root: TempDir,
+    session: Session,
+    now: Millis,
+}
+
+impl Rig {
+    fn seated(platform: Platform, picture: &str) -> Rig {
+        let root = common::tmp_root_with_real_carts(&[]);
+        write_cart(root.path(), platform, STEM);
+        std::fs::write(root.path().join(PICTURE_FILE), picture).expect("write picture.txt");
+        common::clocked(root.path());
+        let mut r = Rig {
+            session: Session::boot(root.path().to_path_buf()),
+            root,
+            now: 0,
+        };
+        r.feed(RawEvent::Down(Btn::A));
+        r.feed(RawEvent::Up(Btn::A));
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !matches!(r.session.app().phase(), Phase::Playing { .. }) {
+            assert!(Instant::now() < deadline, "the cart never seated");
+            r.now += 16;
+            r.session.feed([], r.now);
+            r.session.update(1.0 / 60.0);
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        r
+    }
+
+    fn feed(&mut self, ev: RawEvent) {
+        self.now += 20;
+        self.session.feed([ev], self.now);
+    }
+
+    fn cart_line(&self) -> Option<String> {
+        slot_store::ini::value(self.root.path(), VIDEO_MODE_FILE, STEM)
+    }
+
+    fn picture_file(&self) -> Option<String> {
+        std::fs::read_to_string(self.root.path().join(PICTURE_FILE)).ok()
+    }
+}
+
+#[test]
+fn a_cart_seats_in_its_system_picture() {
+    let r = Rig::seated(Platform::Nes, "nes = actual\n");
+    assert_eq!(r.session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert_eq!(r.cart_line(), None);
+}
