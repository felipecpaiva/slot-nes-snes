index 0000000..e89a74f
--- /dev/null
+++ b/crates/slot/src/av_rate.rs
@@ -0,0 +1,56 @@
+use std::time::Duration;
+
+use slot_retro::AvInfo;
+
+use crate::resample::Resampler;
+
+fn core_hz(av: AvInfo, present: Duration) -> f64 {
+    match av.fps {
+        fps if fps > 0.0 => av.sample_rate / (fps * present.as_secs_f64()),
+        _ => av.sample_rate,
+    }
+}
+
+pub fn rebuilt_resampler(av: AvInfo, present: Duration, device_hz: f64) -> Resampler {
+    Resampler::new(core_hz(av, present), device_hz)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const PRESENT: Duration = Duration::from_nanos(16_666_667);
+
+    #[test]
+    fn a_50_fps_core_is_resampled_from_its_rate_stretched_to_the_60_hz_present() {
+        let av = AvInfo {
+            fps: 50.0,
+            sample_rate: 32040.0,
+        };
+        assert!((core_hz(av, PRESENT) - 38448.0).abs() < 0.01);
+    }
+
+    #[test]
+    fn a_core_with_no_frame_rate_keeps_its_sample_rate() {
+        let av = AvInfo {
+            fps: 0.0,
+            sample_rate: 32040.0,
+        };
+        assert_eq!(core_hz(av, PRESENT), 32040.0);
+    }
+
+    #[test]
+    fn a_rebuilt_resampler_turns_one_second_of_core_audio_into_device_rate_frames() {
+        let av = AvInfo {
+            fps: 50.0,
+            sample_rate: 32040.0,
+        };
+        let mut out = Vec::new();
+        rebuilt_resampler(av, PRESENT, 32768.0).process(&vec![0i16; 2 * 38448], &mut out);
+        assert!(
+            (out.len() / 2).abs_diff(32768) <= 2,
+            "{} frames",
+            out.len() / 2
+        );
+    }
+}
