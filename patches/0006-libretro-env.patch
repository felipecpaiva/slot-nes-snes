+fn with_av<R>(f: impl FnOnce(&mut HostExtra) -> R) -> Option<R> {
+    let p = EXTRA.with(|e| e.get());
+    // SAFETY: the pointer is null or set by a live ExtraGuard on this thread, which clears it on drop.
+    let extra = unsafe { p.as_mut() }?;
+    (extra.canvas != (GBA_W, GBA_H)).then(|| f(extra))
+}
+
+pub fn geometry_set() -> bool {
+    with_av(|_| ()).is_some()
+}
+
+pub unsafe fn av_info_set(data: *const SystemAvInfo) -> bool {
+    let Some(info) = data.as_ref() else {
+        return false;
+    };
+    let (fps, sample_rate) = (info.timing.fps, info.timing.sample_rate);
+    if !(sample_rate.is_finite() && sample_rate > 0.0) {
+        eprintln!("slot: av: ignoring a system av info with sample rate {sample_rate}");
+        return false;
+    }
+    with_av(|e| e.av_change = Some(AvInfo { fps, sample_rate })).is_some()
+}
+
+pub unsafe fn av_enable_get(data: *mut c_int) -> bool {
+    // A NULL data pointer is the spec's availability query: answer true without writing.
+    with_av(|e| {
+        if let Some(mask) = data.as_mut() {
+            *mask = e.av_enable;
+        }
+    })
+    .is_some()
+}
