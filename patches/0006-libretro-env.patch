@@ -0,0 +1,122 @@
+mod common;
+mod core_common;
+mod snes_common;
+
+use std::path::PathBuf;
+
+use common::core_lock;
+use core_common::require_core;
+use slot::core::open_core_for;
+use slot_retro::{ButtonMask, MockCore, RetroCore};
+use slot_store::Core;
+use snes_common::{snes_rom, Map, SNES_TITLE};
+
+const PICTURE_X: usize = 52;
+const PICTURE_Y: usize = 8;
+const PICTURE_W: usize = 256;
+const PICTURE_H: usize = 224;
+const RED_BACKDROP_BGRX: [u8; 4] = [57, 199, 255, 0];
+
+fn booted(dylib: PathBuf, rom: PathBuf) -> Box<dyn RetroCore> {
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = open_core_for(d.path(), Core::Snes9x, "auto", false, &[dylib]);
+    core.load(&rom)
+        .unwrap_or_else(|e| panic!("snes9x refused the {SNES_TITLE} cart: {e}"));
+    core
+}
+
+fn red_backdrop_rom() -> PathBuf {
+    let path = snes_rom("snes_emu_red.sfc", Map::Lo, false, 0);
+    let mut rom = std::fs::read(&path).expect("read rom");
+    let program = [
+        0x78, 0x18, 0xfb, 0xa9, 0x00, 0x8d, 0x21, 0x21, 0xa9, 0x1f, 0x8d, 0x22, 0x21, 0x8d, 0x22,
+        0x21, 0xa9, 0x0f, 0x8d, 0x00, 0x21, 0x4c, 0x15, 0x80,
+    ];
+    rom[..program.len()].copy_from_slice(&program);
+    rom[0x7fdc..0x7fe0].copy_from_slice(&[0xff, 0xff, 0, 0]);
+    let sum = rom.iter().fold(0u16, |a, b| a.wrapping_add(u16::from(*b)));
+    rom[0x7fdc..0x7fde].copy_from_slice(&(!sum).to_le_bytes());
+    rom[0x7fde..0x7fe0].copy_from_slice(&sum.to_le_bytes());
+    std::fs::write(&path, rom).expect("write rom");
+    path
+}
+
+fn pixel(video: &[u8], x: usize, y: usize) -> [u8; 4] {
+    let at = (y * 360 + x) * 4;
+    [video[at], video[at + 1], video[at + 2], video[at + 3]]
+}
+
+fn in_picture(x: usize, y: usize) -> bool {
+    (PICTURE_X..PICTURE_X + PICTURE_W).contains(&x)
+        && (PICTURE_Y..PICTURE_Y + PICTURE_H).contains(&y)
+}
+
+#[test]
+fn snes9x_draws_a_uniform_256_by_224_picture_in_the_middle_of_a_360_by_240_canvas() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("snes9x") else {
+        return;
+    };
+    let mut core = booted(dylib, red_backdrop_rom());
+    for _ in 0..60 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(core.canvas(), (360, 240));
+    let video = core.video_xrgb8888();
+    assert_eq!(video.len(), 360 * 240 * 4);
+    for y in 0..240 {
+        for x in 0..360 {
+            let want = if in_picture(x, y) {
+                RED_BACKDROP_BGRX
+            } else {
+                [0; 4]
+            };
+            assert_eq!(pixel(video, x, y), want, "pixel {x},{y}");
+        }
+    }
+    assert_ne!(
+        video,
+        MockCore::sized((360, 240)).video_xrgb8888(),
+        "the mock ran with snes9x sitting right there"
+    );
+}
+
+#[test]
+fn snes9x_runs_both_rom_layouts_and_reports_a_32040_hz_sample_rate() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("snes9x") else {
+        return;
+    };
+    for (name, map) in [("snes_emu_lo.sfc", Map::Lo), ("snes_emu_hi.sfc", Map::Hi)] {
+        let mut core = booted(dylib.clone(), snes_rom(name, map, false, 0));
+        core.run_frame(ButtonMask::default());
+        let hz = core.av_info().sample_rate;
+        assert!((hz - 32040.0).abs() < 1.0, "{name} reports {hz} Hz");
+    }
+}
+
+#[test]
+fn a_frame_the_frontend_skips_is_not_drawn_by_snes9x() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("snes9x") else {
+        return;
+    };
+    let mut core = booted(dylib, red_backdrop_rom());
+    core.set_frame_skip(true);
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert!(
+        core.video_xrgb8888().iter().all(|b| *b == 0),
+        "snes9x drew while the video bit was clear"
+    );
+    core.set_frame_skip(false);
+    for _ in 0..3 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(
+        pixel(core.video_xrgb8888(), 180, 120),
+        RED_BACKDROP_BGRX,
+        "snes9x did not draw once the video bit was back"
+    );
+}
