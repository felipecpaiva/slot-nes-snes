+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use slot::audio::{AudioSink, StubSink};
+use slot::emu::{CoreState, EmuHandle, Speed};
+use slot_retro::{AvInfo, ButtonMask, CoreError, MockCore, RetroCore};
+
+const CHANGE_AT: usize = 15;
+const CALLS: usize = 45;
+
+struct Pal {
+    inner: MockCore,
+    sink: StubSink,
+    calls: usize,
+    drained: Arc<Mutex<Vec<usize>>>,
+}
+
+impl RetroCore for Pal {
+    fn load(&mut self, rom: &Path) -> Result<(), CoreError> {
+        self.inner.load(rom)
+    }
+    fn run_frame(&mut self, input: ButtonMask) {
+        self.inner.run_frame(input);
+    }
+    fn video_xrgb8888(&self) -> &[u8] {
+        self.inner.video_xrgb8888()
+    }
+    fn take_audio(&mut self) -> Vec<i16> {
+        let queued = self.sink.device_drain();
+        self.drained.lock().expect("the drain log").push(queued);
+        self.inner.take_audio()
+    }
+    fn serialize(&mut self) -> Result<Vec<u8>, CoreError> {
+        self.inner.serialize()
+    }
+    fn unserialize(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.unserialize(data)
+    }
+    fn save_ram(&self) -> Option<Vec<u8>> {
+        self.inner.save_ram()
+    }
+    fn load_save_ram(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.load_save_ram(data)
+    }
+    fn av_info(&self) -> AvInfo {
+        self.inner.av_info()
+    }
+    fn take_av_change(&mut self) -> Option<AvInfo> {
+        self.calls += 1;
+        (self.calls == CHANGE_AT).then_some(AvInfo {
+            fps: 50.0,
+            sample_rate: 32040.0,
+        })
+    }
+}
+
+fn mean(log: &[usize]) -> f64 {
+    log.iter().sum::<usize>() as f64 / log.len() as f64
+}
+
+#[test]
+fn the_emu_loop_rebuilds_its_resampler_when_the_core_changes_its_av_rate() {
+    let mut sink = StubSink::new();
+    sink.open(32_768).expect("the stub refused to open");
+    let drained = Arc::new(Mutex::new(Vec::new()));
+    let core = Box::new(Pal {
+        inner: MockCore::new(),
+        sink: sink.clone(),
+        calls: 0,
+        drained: drained.clone(),
+    });
+    let emu = EmuHandle::spawn(core, PathBuf::from("mock"), sink.ring(), None, None);
+    emu.set_speed(Speed::Normal);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while drained.lock().expect("the drain log").len() < CALLS {
+        assert!(Instant::now() < deadline, "the worker stopped presenting");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert_eq!(emu.state(), CoreState::Ready);
+    let log = drained.lock().expect("the drain log").clone();
+    // Call n drains what the presents before it pushed, so the change lands in the log
+    // one call after the take_av_change that returned it.
+    let before = mean(&log[3..CHANGE_AT]);
+    let after = mean(&log[CHANGE_AT + 3..CALLS]);
+    assert!(
+        after < before * 0.92,
+        "frames pushed a present did not drop after the 50 fps change: {before:.0} then {after:.0}"
+    );
+}
