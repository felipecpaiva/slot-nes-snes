+const AV_VIDEO_AND_AUDIO: c_int = 3;
+const AV_AUDIO_ONLY: c_int = 2;
 
 pub struct HostExtra {
     pub canvas: (u32, u32),
+    pub av_change: Option<AvInfo>,
+    pub av_enable: c_int,
 }
 
 impl Default for HostExtra {
     fn default() -> Self {
         HostExtra {
             canvas: (GBA_W, GBA_H),
+            av_change: None,
+            av_enable: AV_VIDEO_AND_AUDIO,
         }
     }
