+impl HostExtra {
+    pub fn skip_video(&mut self, skip: bool) {
+        self.av_enable = if skip {
+            AV_AUDIO_ONLY
+        } else {
+            AV_VIDEO_AND_AUDIO
+        };
+    }
+}
