@@ -0,0 +1,112 @@
+use super::*;
+use crate::canvas::HostExtra;
+
+fn snes_extra() -> HostExtra {
+    HostExtra {
+        canvas: (360, 240),
+        ..HostExtra::default()
+    }
+}
+
+fn av_info(fps: f64, sample_rate: f64) -> SystemAvInfo {
+    let mut info = SystemAvInfo::default();
+    info.timing.fps = fps;
+    info.timing.sample_rate = sample_rate;
+    info
+}
+
+fn set_av(info: &SystemAvInfo) -> bool {
+    // SAFETY: info is a live SystemAvInfo, which is what SET_SYSTEM_AV_INFO reads.
+    unsafe { environment(canvas::SET_SYSTEM_AV_INFO, info as *const _ as *mut c_void) }
+}
+
+fn set_geometry() -> bool {
+    // SAFETY: SET_GEOMETRY ignores its data pointer in this host.
+    unsafe { environment(canvas::SET_GEOMETRY, ptr::null_mut()) }
+}
+
+fn av_enable() -> Option<c_int> {
+    let mut mask: c_int = -1;
+    // SAFETY: mask is a live c_int, which is what GET_AUDIO_VIDEO_ENABLE writes.
+    let ok = unsafe {
+        environment(
+            canvas::GET_AUDIO_VIDEO_ENABLE,
+            &mut mask as *mut _ as *mut c_void,
+        )
+    };
+    ok.then_some(mask)
+}
+
+fn bound<R>(extra: &mut HostExtra, f: impl FnOnce() -> R) -> R {
+    let _e = ExtraGuard::bind(extra);
+    f()
+}
+
+#[test]
+fn set_geometry_is_answered_true_once_the_extra_state_is_bound() {
+    let mut extra = snes_extra();
+    assert!(bound(&mut extra, set_geometry));
+}
+
+#[test]
+fn set_system_av_info_is_held_for_the_emu_loop_exactly_once() {
+    let mut extra = snes_extra();
+    assert!(bound(&mut extra, || set_av(&av_info(50.0, 32040.0))));
+    let av = extra.av_change.take().expect("av info was not stored");
+    assert_eq!((av.fps, av.sample_rate), (50.0, 32040.0));
+    assert!(extra.av_change.is_none());
+}
+
+#[test]
+fn an_av_info_with_no_sample_rate_is_refused_and_not_stored() {
+    let mut extra = snes_extra();
+    assert!(!bound(&mut extra, || set_av(&av_info(60.0, 0.0))));
+    assert!(extra.av_change.is_none());
+}
+
+#[test]
+fn the_three_env_calls_answer_false_exactly_like_upstream_with_no_extra_state() {
+    assert!(!set_geometry());
+    assert!(!set_av(&av_info(50.0, 32040.0)));
+    assert_eq!(av_enable(), None);
+}
+
+#[test]
+fn the_three_env_calls_answer_false_exactly_like_upstream_on_the_gba_canvas() {
+    let mut extra = HostExtra::default();
+    assert!(!bound(&mut extra, set_geometry));
+    assert!(!bound(&mut extra, || set_av(&av_info(50.0, 32040.0))));
+    assert_eq!(bound(&mut extra, av_enable), None);
+    assert!(extra.av_change.is_none());
+}
+
+#[test]
+fn audio_video_enable_is_3_normally_and_loses_the_video_bit_on_a_skipped_frame() {
+    let mut extra = snes_extra();
+    assert_eq!(bound(&mut extra, av_enable), Some(3));
+    extra.skip_video(true);
+    assert_eq!(bound(&mut extra, av_enable), Some(2));
+    extra.skip_video(false);
+    assert_eq!(bound(&mut extra, av_enable), Some(3));
+}
+
+fn av_enable_available() -> bool {
+    // SAFETY: GET_AUDIO_VIDEO_ENABLE with NULL data is the spec's availability query.
+    unsafe { environment(canvas::GET_AUDIO_VIDEO_ENABLE, ptr::null_mut()) }
+}
+
+#[test]
+fn audio_video_enable_with_null_data_is_answered_true_only_off_the_gba_canvas() {
+    let mut extra = snes_extra();
+    assert!(bound(&mut extra, av_enable_available));
+    assert!(!av_enable_available());
+    let mut gba = HostExtra::default();
+    assert!(!bound(&mut gba, av_enable_available));
+}
+
+#[test]
+fn the_env_command_numbers_are_the_libretro_ones() {
+    assert_eq!(canvas::SET_SYSTEM_AV_INFO, 32);
+    assert_eq!(canvas::SET_GEOMETRY, 37);
+    assert_eq!(canvas::GET_AUDIO_VIDEO_ENABLE, 47 | 0x10000);
+}
