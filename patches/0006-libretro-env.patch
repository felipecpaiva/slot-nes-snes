+mod common;
+mod core_common;
+mod nes_common;
+
+use common::core_lock;
+use nes_common::{fceumm, nes_rom};
+use slot::core::open_core_for;
+use slot_retro::ButtonMask;
+use slot_store::Core;
+
+#[test]
+fn switching_fceumm_to_pal_hands_the_emu_loop_a_50_fps_av_change_once() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = open_core_for(d.path(), Core::Fceumm, "auto", false, &[dylib]);
+    core.load(&nes_rom("nes_av.nes", false))
+        .expect("fceumm refused the generated cart");
+    for _ in 0..5 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert!(
+        core.take_av_change().is_none(),
+        "an av change before any option moved"
+    );
+    core.set_option("fceumm_region", "PAL");
+    core.run_frame(ButtonMask::default());
+    let av = core
+        .take_av_change()
+        .expect("fceumm region change was lost");
+    assert!((av.fps - 50.0).abs() < 0.5, "fps {}", av.fps);
+    assert!(
+        core.take_av_change().is_none(),
+        "the av change came back twice"
+    );
+    assert!((core.av_info().fps - av.fps).abs() < 1e-9);
+}
