+fn rom_of(code: &[u16]) -> Vec<u8> {
+    let mut rom = vec![0xffu8; 0x10000];
+    for (at, half) in code.iter().enumerate() {
+        rom[at * 2..at * 2 + 2].copy_from_slice(&half.to_le_bytes());
+    }
+    let back = -(0x10000 - 16i32);
+    let jr = [(JR << 10) | ((back >> 16) as u16 & 0x3ff), back as u16];
+    rom[0xfff0..0xfff2].copy_from_slice(&jr[0].to_le_bytes());
+    rom[0xfff2..0xfff4].copy_from_slice(&jr[1].to_le_bytes());
+    rom
+}
+
+/// A cart that reads the game pad the way games do and copies SDLR (0x02000010) and SDHR (0x02000014)
+/// into the first two bytes of cart RAM, over and over, so a test reads what the game sees through
+/// save_ram(). Each read writes HW_SI and K_INT_INH (0x84) to SCR (0x02000028) and waits for SI_STAT
+/// (0x02) to clear. The pad word is the libretro buttons shifted up two bits, bit 1 set and bit 0 the
+/// low battery flag (mednafen/vb/input.c VBINPUT_Write and VBINPUT_Frame at d5ae54c).
+pub fn keypad_cart(dir: &Path, stem: &str) -> PathBuf {
+    let mut code = f5(MOVHI, 13, 0, 0x0200);
+    code.extend(f5(MOVHI, 15, 0, 0x0600));
+    code.extend(f5(MOVEA, 17, 0, 0x84));
+    let top = code.len();
+    code.extend(f5(ST_B, 17, 13, 0x28));
+    let wait = code.len();
+    code.extend(f5(LD_B, 16, 13, 0x28));
+    code.extend(f5(ANDI, 16, 16, 0x02));
+    let back = -(((code.len() - wait) * 2) as i32);
+    code.push(BNE | (back as u16 & 0x1ff));
+    code.extend(f5(LD_B, 16, 13, 0x10));
+    code.extend(f5(ST_B, 16, 15, 0));
+    code.extend(f5(LD_B, 16, 13, 0x14));
+    code.extend(f5(ST_B, 16, 15, 1));
+    let back = -(((code.len() - top) * 2) as i32);
+    code.push(BR_SELF | (back as u16 & 0x1ff));
+    let path = dir.join(format!("{stem}.vb"));
+    std::fs::write(&path, rom_of(&code)).unwrap();
+    path
+}
+
 pub fn cart(dir: &Path, stem: &str) -> PathBuf {
     Cart::GAME.write(dir, &format!("{stem}.vb"))
 }
