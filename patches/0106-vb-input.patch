+#[test]
+fn in_abxy_mode_l2_and_r2_go_to_the_game_from_the_next_start() {
+    let _g = core_lock();
+    let Some((_root, mut session)) = playing("right_pad = abxy\n") else {
+        return;
+    };
+    assert!(session.app().triggers_to_game());
+    for (btn, bit) in [(Btn::L2, M::L2), (Btn::R2, M::R2)] {
+        session.feed([RawEvent::Down(btn)], 5000);
+        assert_eq!(input_of(&session), bit, "{btn:?} held");
+        session.feed([RawEvent::Up(btn)], 5100);
+        assert_eq!(input_of(&session), 0, "{btn:?} let go");
+    }
+}
