+use slot_retro::ButtonMask as M;
+
+pub const STICK: u8 = 3;
+pub const BUTTONS: u8 = 4;
+
+const KEPT: u16 =
+    M::UP | M::DOWN | M::LEFT | M::RIGHT | M::A | M::B | M::L | M::R | M::START | M::SELECT;
+const RIGHT_UP: u16 = M::L2;
+const RIGHT_LEFT: u16 = M::R2;
+const RIGHT_DOWN: u16 = M::L3;
+const RIGHT_RIGHT: u16 = M::R3;
+
+pub fn owns(code: u8) -> bool {
+    code == STICK || code == BUTTONS
+}
+
+pub fn code(buttons: bool) -> u8 {
+    if buttons {
+        BUTTONS
+    } else {
+        STICK
+    }
+}
+
+fn given(mask: u16, button: u16, gives: u16) -> u16 {
+    if mask & button != 0 {
+        gives
+    } else {
+        0
+    }
+}
+
+pub fn remap(code: u8, mask: M) -> M {
+    let m = mask.0;
+    if code != BUTTONS {
+        return M(m & KEPT);
+    }
+    let kept = m & (KEPT & !(M::A | M::B));
+    M(kept
+        | given(m, M::X, RIGHT_UP)
+        | given(m, M::A, RIGHT_RIGHT)
+        | given(m, M::B, RIGHT_DOWN)
+        | given(m, M::Y, RIGHT_LEFT)
+        | given(m, M::L2, M::B)
+        | given(m, M::R2, M::A))
+}
