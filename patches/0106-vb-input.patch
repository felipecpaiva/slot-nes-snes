+fn playing(root_words: &str) -> Option<(tempfile::TempDir, Session)> {
+    let dylib = beetle_vb()?;
+    let roms = tempfile::tempdir().expect("tempdir");
+    let rom = keypad_cart(roms.path(), "Keys");
+    let root = real_seat::rooted(Platform::Vb, "Keys", &rom, &dylib);
+    std::fs::write(root.path().join(VB_FILE), root_words).expect("write vb.txt");
+    let session = real_seat::play(root.path(), true);
+    Some((root, session))
+}
+
+fn input_of(session: &Session) -> u16 {
+    session.emu().expect("no core in the slot").input().0
+}
