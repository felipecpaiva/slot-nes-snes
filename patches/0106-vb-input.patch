+#[test]
+fn in_stick_mode_l2_and_r2_stay_slots_rewind_and_fast_forward() {
+    let _g = core_lock();
+    let Some((_root, mut session)) = playing("right_pad = stick\n") else {
+        return;
+    };
+    assert!(!session.app().triggers_to_game());
+    for btn in [Btn::L2, Btn::R2] {
+        session.feed([RawEvent::Down(btn)], 5000);
+        assert_eq!(input_of(&session) & (M::L2 | M::R2), 0, "{btn:?}");
+        session.feed([RawEvent::Up(btn)], 5100);
+    }
+    session.feed([RawEvent::Down(Btn::X)], 6000);
+    assert_eq!(input_of(&session), M::X);
+    session.feed([RawEvent::Up(Btn::X)], 6100);
+}
