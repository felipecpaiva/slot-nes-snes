@@ -0,0 +1,237 @@
+// The Virtual Boy pad (ADR 0097, issue 159): the device D-pad is the left D-pad, the right analog stick
+// is the right D-pad (Beetle VB reads it itself with vb_right_analog_to_digital enabled), and the Right
+// Pad row's ABXY choice puts the right D-pad on the face buttons with A and B on R2 and L2.
+mod common;
+mod core_common;
+mod real_seat;
+mod vb_common;
+
+use std::path::Path;
+
+use common::core_lock;
+use slot::core::apply_core_options;
+use slot::core_options_policy::analog_pad;
+use slot::session::Session;
+use slot::vb_input::{remap, BUTTONS, STICK};
+use slot::vb_screen::VB_FILE;
+use slot::ws_input::{pad_code, WsPad};
+use slot_input::{Btn, RawEvent};
+use slot_retro::{publish_sticks, ButtonMask as M, LibretroCore, MockCore, RetroCore, PLAIN_PAD};
+use slot_store::{Core, Platform};
+use vb_common::{beetle_vb, keypad_cart};
+
+const PAD_A: u16 = 1 << 2;
+const PAD_B: u16 = 1 << 3;
+const PAD_R: u16 = 1 << 4;
+const PAD_L: u16 = 1 << 5;
+const PAD_RIGHT_UP: u16 = 1 << 6;
+const PAD_RIGHT_RIGHT: u16 = 1 << 7;
+const PAD_LEFT_RIGHT: u16 = 1 << 8;
+const PAD_LEFT_LEFT: u16 = 1 << 9;
+const PAD_LEFT_DOWN: u16 = 1 << 10;
+const PAD_LEFT_UP: u16 = 1 << 11;
+const PAD_START: u16 = 1 << 12;
+const PAD_SELECT: u16 = 1 << 13;
+const PAD_RIGHT_LEFT: u16 = 1 << 14;
+const PAD_RIGHT_DOWN: u16 = 1 << 15;
+const PAD_ALWAYS: u16 = 1 << 1;
+const LOW_BATTERY: u16 = 1;
+
+fn answered(dylib: &Path, root: &Path) -> LibretroCore {
+    let mut core = LibretroCore::open_with(dylib, root, root).expect("open Beetle VB");
+    apply_core_options(
+        &mut core,
+        Core::MednafenVb,
+        Platform::Vb,
+        "auto",
+        false,
+        false,
+        None,
+    );
+    core
+}
+
+fn pad_word(core: &mut LibretroCore, mask: u16) -> u16 {
+    for _ in 0..3 {
+        core.run_frame(M(mask));
+    }
+    let ram = core.save_ram().expect("no cart RAM");
+    u16::from_le_bytes([ram[0], ram[1]])
+}
+
+#[test]
+fn the_stick_mode_sends_the_virtual_boy_buttons_as_they_are_and_never_x_or_y() {
+    for (device, sent) in [
+        (M::A, M::A),
+        (M::B, M::B),
+        (M::L, M::L),
+        (M::R, M::R),
+        (M::START, M::START),
+        (M::SELECT, M::SELECT),
+        (M::UP, M::UP),
+        (M::DOWN, M::DOWN),
+        (M::LEFT, M::LEFT),
+        (M::RIGHT, M::RIGHT),
+        (M::X, 0),
+        (M::Y, 0),
+        (M::L2, 0),
+        (M::R2, 0),
+    ] {
+        assert_eq!(remap(STICK, M(device)).0, sent, "{device:#x}");
+    }
+}
+
+#[test]
+fn the_abxy_mode_puts_the_right_d_pad_on_the_face_buttons_and_a_and_b_on_the_triggers() {
+    for (device, sent) in [
+        (M::X, M::L2),
+        (M::A, M::R3),
+        (M::B, M::L3),
+        (M::Y, M::R2),
+        (M::R2, M::A),
+        (M::L2, M::B),
+        (M::L, M::L),
+        (M::R, M::R),
+        (M::START, M::START),
+        (M::SELECT, M::SELECT),
+        (M::UP, M::UP),
+        (M::LEFT, M::LEFT),
+    ] {
+        assert_eq!(remap(BUTTONS, M(device)).0, sent, "{device:#x}");
+    }
