+++ b/crates/slot/src/shelf_restock.rs
@@ -0,0 +1,44 @@
+use std::collections::HashMap;
+
+use slot_store::{Cart, Platform};
+use slot_ui::{Shelf, TexId};
+
+use crate::app::App;
+
+pub fn face_fits(app: &App, key: (usize, usize), cart: &Cart) -> bool {
+    app.face_cart(key.0, key.1)
+        .is_some_and(|c| c.platform == cart.platform && c.stem == cart.stem)
+}
+
+pub fn restock_keeping_faces(shelf: &mut Shelf, carts: Vec<Cart>) -> Vec<TexId> {
+    let selected = shelf
+        .carts
+        .get(shelf.index)
+        .map(|c| (c.platform, c.stem.clone()));
+    let keys: Vec<(Platform, String)> = shelf
+        .carts
+        .iter()
+        .map(|c| (c.platform, c.stem.clone()))
+        .collect();
+    let mut held: HashMap<(Platform, String), [Option<TexId>; 2]> = keys
+        .into_iter()
+        .enumerate()
+        .map(|(i, key)| (key, [shelf.take_face(i), shelf.take_interior(i)]))
+        .collect();
+    let kept: Vec<(usize, [Option<TexId>; 2])> = carts
+        .iter()
+        .enumerate()
+        .filter_map(|(i, c)| held.remove(&(c.platform, c.stem.clone())).map(|t| (i, t)))
+        .collect();
+    let index = selected
+        .and_then(|(p, stem)| carts.iter().position(|c| c.platform == p && c.stem == stem))
+        .unwrap_or(shelf.index.min(carts.len().saturating_sub(1)));
+    let mut freed = shelf.restock(carts);
+    for (i, [face, interior]) in kept {
+        freed.extend(face.and_then(|t| shelf.set_face(i, t)));
+        freed.extend(interior.and_then(|t| shelf.set_interior(i, t)));
+    }
+    freed.extend(held.into_values().flatten().flatten());
+    shelf.select(index);
+    freed
+}
diff --git a/crates/slot/tests/shelf_restock.rs b/crates/slot/tests/shelf_restock.rs
