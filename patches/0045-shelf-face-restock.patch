+++ b/crates/slot/tests/shelf_restock.rs
@@ -0,0 +1,113 @@
+mod common;
+
+use common::{tmp_root_with_carts, write_gb_cart};
+use slot::app::App;
+use slot::shelf_restock::{face_fits, restock_keeping_faces};
+use slot_input::Btn;
+use slot_store::{write_slot_state, Cart, Platform, Recent, SlotState};
+use slot_ui::{Shelf, TexId};
+
+fn cart(platform: Platform, stem: &str) -> Cart {
+    Cart {
+        platform,
+        stem: stem.into(),
+        rom: format!("/x/{stem}.gba").into(),
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn press(a: &mut App, btn: Btn) {
+    common::through(a, btn);
+}
+
+#[test]
+fn a_restock_keeps_each_carts_face_and_hands_back_the_rest() {
+    let mut s = Shelf::new(vec![
+        cart(Platform::Gba, "Kept"),
+        cart(Platform::Gba, "Gone"),
+    ]);
+    let (kept_face, gone_face) = (TexId::from_raw(20), TexId::from_raw(21));
+    let (kept_inside, gone_inside) = (TexId::from_raw(30), TexId::from_raw(31));
+    s.set_faces(vec![kept_face, gone_face]);
+    s.set_interior(0, kept_inside);
+    s.set_interior(1, gone_inside);
+    let mut freed = restock_keeping_faces(
+        &mut s,
+        vec![cart(Platform::Gba, "New"), cart(Platform::Gba, "Kept")],
+    );
+    freed.sort_by_key(|t| format!("{t:?}"));
+    let mut want = vec![gone_face, gone_inside];
+    want.sort_by_key(|t| format!("{t:?}"));
+    assert_eq!(freed, want);
+    assert_eq!(
+        [s.face(0), s.face(1), s.take_interior(0), s.take_interior(1)],
+        [None, Some(kept_face), None, Some(kept_inside)]
+    );
+}
+
+#[test]
+fn a_restock_keeps_the_selected_cart_selected() {
+    let mut s = Shelf::new(vec![
+        cart(Platform::Gba, "Alpha"),
+        cart(Platform::Gba, "Beta"),
+    ]);
+    s.select(1);
+    restock_keeping_faces(
+        &mut s,
+        vec![
+            cart(Platform::Gba, "Aardvark"),
+            cart(Platform::Gba, "Alpha"),
+            cart(Platform::Gba, "Beta"),
+        ],
+    );
+    assert_eq!(s.carts.get(s.index).map(|c| c.stem.as_str()), Some("Beta"));
+}
+
+#[test]
+fn the_selected_cart_wins_a_stem_another_platform_shares() {
+    let mut s = Shelf::new(vec![
+        cart(Platform::Gb, "Tetris"),
+        cart(Platform::Gbc, "Tetris"),
+    ]);
+    s.select(1);
+    assert_eq!(
+        s.find("Tetris").map(|(c, _)| c.platform),
+        Some(Platform::Gbc)
+    );
+}
+
+#[test]
+fn a_face_built_before_a_favourite_restock_does_not_fit_the_cart_now_there() {
+    let d = tmp_root_with_carts(&["Emerald", "Fusion"]);
+    write_gb_cart(&d, "Tetris", "TETRIS");
+    let fav = |platform, stem: &str| Recent {
+        platform,
+        stem: stem.into(),
+    };
+    write_slot_state(
+        d.path(),
+        &SlotState {
+            clock_set: true,
+            favorites: vec![fav(Platform::Gba, "Fusion"), fav(Platform::Gb, "Tetris")],
+            ..SlotState::default()
+        },
+    )
+    .expect("write slot.state");
+    let mut a = App::boot(d.path());
+    let favorites = 1;
+    let built_for = a.face_cart(favorites, 0).cloned().expect("a favourite");
+    assert_eq!(built_for.stem, "Fusion");
+    for _ in 0..8 {
+        if a.shelf_platform_name() == Some("Game Boy Advance") {
+            break;
+        }
+        press(&mut a, Btn::R1);
+    }
+    assert_eq!(a.selected_stem(), Some("Emerald"));
+    press(&mut a, Btn::Y);
+    assert!(!face_fits(&a, (favorites, 0), &built_for));
+    assert!(face_fits(&a, (favorites, 1), &built_for));
+}
