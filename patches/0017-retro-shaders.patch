+
+use common::tmp_root;
+use slot_store::{read_slot_state, write_slot_state, Platform, RetroShader, Shader, SlotState};
+
+fn state_file(root: &std::path::Path) -> std::path::PathBuf {
+    root.join("Config/slot.state")
+}
+
+fn written(s: &SlotState) -> (tempfile::TempDir, String) {
+    let d = tmp_root();
+    write_slot_state(d.path(), s).unwrap();
+    let text = std::fs::read_to_string(state_file(d.path())).unwrap();
+    (d, text)
+}
+
+fn base() -> SlotState {
+    SlotState {
+        cart: Some("Zzz".into()),
+        clock_set: true,
+        ..SlotState::default()
+    }
+}
+
+#[test]
+fn the_retro_list_keeps_off_grid_dot_first_and_appends_the_four_new_shaders() {
+    assert_eq!(
+        Shader::RETRO.map(Shader::name),
+        [
+            "off",
+            "grid",
+            "dot",
+            "sharp",
+            "scanlines",
+            "crt-pi",
+            "crt-1tap"
+        ]
+    );
+    assert_eq!(
+        RetroShader::ALL.map(RetroShader::label),
+        ["Sharp", "Scanlines", "crt-pi", "crt-1tap"]
+    );
+    for (i, s) in RetroShader::ALL.into_iter().enumerate() {
+        assert_eq!(s.index(), i, "{s:?}");
+    }
+}
+
+#[test]
+fn every_retro_shader_round_trips_through_slot_state_for_nes_and_snes() {
+    for shader in Shader::RETRO {
+        let s = SlotState {
+            shader_nes: shader,
+            shader_snes: shader,
+            ..base()
+        };
+        let (d, text) = written(&s);
+        assert!(
+            text.ends_with(&format!("shader_nes={0}\nshader_snes={0}\n", shader.name())),
+            "{text:?}"
+        );
+        assert_eq!(read_slot_state(d.path()), s, "{shader:?}");
+    }
+}
+
+#[test]
+fn a_slot_state_from_before_the_new_shaders_still_loads_its_retro_values() {
+    let s = SlotState {
+        shader_nes: Shader::Grid,
+        shader_snes: Shader::Dot,
+        ..base()
+    };
+    let (d, text) = written(&s);
+    assert!(
+        text.ends_with("shader_nes=grid\nshader_snes=dot\n"),
+        "{text:?}"
+    );
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn gba_gb_and_gbc_cannot_hold_a_retro_shader() {
+    for platform in [Platform::Gba, Platform::Gb, Platform::Gbc] {
+        assert!(
+            platform
+                .shader_choices()
+                .iter()
+                .all(|s| !matches!(s, Shader::Retro(_))),
+            "{platform:?}"
+        );
+    }
+    for retro in RetroShader::ALL {
+        let (d, text) = written(&base());
+        let text = text
+            .replace("shader_gba=grid", &format!("shader_gba={}", retro.name()))
+            .replace(
+                "shader_gb=simpletex",
+                &format!("shader_gb={}", retro.name()),
+            );
+        std::fs::write(state_file(d.path()), text).unwrap();
+        let back = read_slot_state(d.path());
+        assert_eq!(
+            back.shader_gba,
+            SlotState::default().shader_gba,
+            "{retro:?}"
+        );
+        assert_eq!(back.shader_gb, SlotState::default().shader_gb, "{retro:?}");
+        assert_eq!(back.cart.as_deref(), Some("Zzz"));
+    }
+}
+
+#[test]
+fn an_unknown_retro_name_falls_back_to_off() {
+    let (d, text) = written(&base());
+    let text = text
+        .replace("shader_nes=off", "shader_nes=crt-royale")
+        .replace("shader_snes=off", "shader_snes=Sharp");
+    std::fs::write(state_file(d.path()), text).unwrap();
+    let back = read_slot_state(d.path());
+    assert_eq!(back.shader_nes, Shader::Off);
+    assert_eq!(back.shader_snes, Shader::Off);
+}
