diff --git a/crates/slot-gfx/src/pipeline/retro.rs b/crates/slot-gfx/src/pipeline/retro.rs
new file mode 100644
index 0000000..639059f
--- /dev/null
+++ b/crates/slot-gfx/src/pipeline/retro.rs
@@ -0,0 +1,262 @@
+use super::GamePass;
+use crate::lcd3x::ScreenEffect;
+use crate::quad::Quad;
+use crate::shaders::RECT_VERT;
+use crate::surface::{OUT_H, OUT_W};
+
+pub struct RetroProgram {
+    prog: gl::types::GLuint,
+    u_src: gl::types::GLint,
+    u_uv: gl::types::GLint,
+    u_rect: gl::types::GLint,
+    u_fbo: gl::types::GLint,
+    u_pic: gl::types::GLint,
+    u_bright: gl::types::GLint,
+    u_mode: gl::types::GLint,
+}
+
+impl RetroProgram {
+    pub fn new() -> Option<Self> {
+        let prog = match crate::shaders::program(RECT_VERT, RETRO_FRAG) {
+            Ok(prog) => prog,
+            Err(e) => {
+                eprintln!(
+                    "slot: gfx: the nes and snes shaders did not build, they draw plain: {e}"
+                );
+                return None;
+            }
+        };
+        let at = |name| crate::gl::uniform_location(prog, name);
+        // SAFETY: the GL context is current while the compositor is built, and prog was just linked.
+        unsafe {
+            gl::UseProgram(prog);
+            gl::Uniform1i(at("u_game"), 0);
+            gl::Uniform2f(at("u_target"), OUT_W as f32, OUT_H as f32);
+        }
+        warm(prog, at("u_rect"), at("u_src"));
+        Some(RetroProgram {
+            prog,
+            u_src: at("u_src"),
+            u_uv: at("u_uv"),
+            u_rect: at("u_rect"),
+            u_fbo: at("u_fbo"),
+            u_pic: at("u_pic"),
+            u_bright: at("u_bright"),
+            u_mode: at("u_mode"),
+        })
+    }
+}
+
+/// One off-screen draw of every retro mode into a 1x1 RGBA target. The Mali driver finishes a
+/// program on its first draw, which cost one 31-67 ms present the first time a retro shader drew in
+/// a game (docs/DEVICE-GATE.md, 2026-10-13); this moves that cost to start-up. The caller's
+/// framebuffer, viewport and program are put back.
+fn warm(prog: gl::types::GLuint, u_rect: gl::types::GLint, u_src: gl::types::GLint) {
+    let tex = crate::gl::texture(1, 1, gl::NEAREST, gl::CLAMP_TO_EDGE, gl::RGBA, None);
+    let quad = Quad::new();
+    // SAFETY: the GL context is current while the compositor is built; every object made here is
+    // deleted here, and the bindings read first are restored.
+    unsafe {
+        let (mut old_fbo, mut old_prog, mut old_view) = (0, 0, [0i32; 4]);
+        gl::GetIntegerv(gl::FRAMEBUFFER_BINDING, &mut old_fbo);
+        gl::GetIntegerv(gl::CURRENT_PROGRAM, &mut old_prog);
+        gl::GetIntegerv(gl::VIEWPORT, old_view.as_mut_ptr());
+        let mut fbo = 0;
+        gl::GenFramebuffers(1, &mut fbo);
+        gl::BindFramebuffer(gl::FRAMEBUFFER, fbo);
+        gl::FramebufferTexture2D(
+            gl::FRAMEBUFFER,
+            gl::COLOR_ATTACHMENT0,
+            gl::TEXTURE_2D,
+            tex,
+            0,
+        );
+        if gl::CheckFramebufferStatus(gl::FRAMEBUFFER) == gl::FRAMEBUFFER_COMPLETE {
+            gl::Viewport(0, 0, 1, 1);
+            gl::UseProgram(prog);
+            gl::Uniform4f(u_rect, 0.0, 0.0, OUT_W as f32, OUT_H as f32);
+            gl::Uniform2f(u_src, 1.0, 1.0);
+            gl::ActiveTexture(gl::TEXTURE0);
+            gl::BindTexture(gl::TEXTURE_2D, tex);
+            let u_mode = crate::gl::uniform_location(prog, "u_mode");
+            // the four branches of RETRO_FRAG
+            for n in 0..4u8 {
+                gl::Uniform1f(u_mode, n as f32);
+                quad.draw();
+            }
+            gl::Finish();
+        }
+        gl::BindFramebuffer(gl::FRAMEBUFFER, old_fbo as u32);
+        gl::Viewport(old_view[0], old_view[1], old_view[2], old_view[3]);
+        gl::UseProgram(old_prog as u32);
+        gl::DeleteFramebuffers(1, &fbo);
+        gl::DeleteTextures(1, &tex);
+    }
+}
+
+impl Drop for RetroProgram {
+    fn drop(&mut self) {
+        // SAFETY: prog is this program's own, deleted once, with the compositor's context current.
+        unsafe { gl::DeleteProgram(self.prog) };
+    }
+}
+
+impl GamePass {
+    pub(super) fn draw_retro(
+        &self,
+        tex: gl::types::GLuint,
+        quad: &Quad,
+        src: [f32; 4],
+        rect: [f32; 5],
+    ) -> bool {
+        let (ScreenEffect::Retro(n), Some(r)) = (self.effect, &self.retro) else {
+            return false;
+        };
+        let [x, y, w, h, bright] = rect;
+        let pic = self.pic;
+        // SAFETY: the GL context is current while drawing, r.prog and its uniform locations are this pass's own.
+        unsafe {
+            gl::UseProgram(r.prog);
+            gl::Uniform2f(r.u_src, self.canvas.0 as f32, self.canvas.1 as f32);
+            gl::Uniform4f(r.u_rect, x, y, w, h);
+            gl::Uniform4f(r.u_uv, src[0], src[1], src[2], src[3]);
+            gl::Uniform2f(r.u_fbo, self.fbo_scale[0], self.fbo_scale[1]);
+            gl::Uniform4f(r.u_pic, pic[0], pic[1], pic[2], pic[3]);
+            gl::Uniform1f(r.u_bright, bright);
+            gl::Uniform1f(r.u_mode, n as f32);
+            gl::ActiveTexture(gl::TEXTURE0);
+            gl::BindTexture(gl::TEXTURE_2D, tex);
+        }
+        quad.draw();
+        true
+    }
+}
+
+const RETRO_FRAG: &str = r#"
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+uniform sampler2D u_game;
+uniform vec2 u_src;
+uniform vec4 u_uv;
+uniform vec4 u_rect;
+uniform vec2 u_fbo;
+uniform vec4 u_pic;
+uniform float u_bright;
+uniform float u_mode;
+varying vec2 v_uv;
+
+vec3 tap(vec2 texel) {
+    return texture2D(u_game, texel / u_src).rgb;
+}
+
+vec3 bilinear(vec2 uv) {
+    vec2 p = uv * u_src - 0.5;
+    vec2 i = floor(p);
+    vec2 t = p - i;
+    vec3 top = mix(tap(i + vec2(0.5, 0.5)), tap(i + vec2(1.5, 0.5)), t.x);
+    vec3 bottom = mix(tap(i + vec2(0.5, 1.5)), tap(i + vec2(1.5, 1.5)), t.x);
+    return mix(top, bottom, t.y);
+}
+
+/*
+    sharp-bilinear-simple by rsn8887, based on TheMaister. Public domain.
+*/
+vec3 sharp(vec2 uv, vec2 out_per_texel) {
+    vec2 texel = uv * u_src;
+    vec2 scale = max(floor(out_per_texel), vec2(1.0));
+    vec2 region_range = 0.5 - 0.5 / scale;
+    vec2 center_dist = fract(texel) - 0.5;
+    vec2 f = (center_dist - clamp(center_dist, -region_range, region_range)) * scale + 0.5;
+    return bilinear((floor(texel) + f) / u_src);
+}
+
+/*
+    Scanlines Sine Absolute Value by RiskyJumps. Public domain.
+*/
+vec3 scanlines(vec2 uv, vec3 c) {
+    float angle = uv.y * 3.141592654 * u_src.y + 0.5;
+    return c * abs(sin(angle) * 1.25);
+}
+
+/*
+    crt-pi - A Raspberry Pi friendly CRT shader.
+
+    Copyright (C) 2015-2016 davej
+
+    This program is free software; you can redistribute it and/or modify it
+    under the terms of the GNU General Public License as published by the Free
+    Software Foundation; either version 2 of the License, or (at your option)
+    any later version.
+*/
+float crt_pi_weight(float dist) {
+    return max(1.0 - dist * dist * 6.0, 0.12);
+}
+
+vec3 crt_pi(vec2 uv, vec2 texel_per_px) {
+    float filter_width = texel_per_px.y / 3.0;
+    vec2 texel = uv * u_src;
+    float temp_y = floor(texel.y) + 0.5;
+    float dy = texel.y - temp_y;
+    float weight = (crt_pi_weight(dy) + crt_pi_weight(dy - filter_width)
+        + crt_pi_weight(dy + filter_width)) * 0.3333333;
+    float sign_y = sign(dy);
+    dy = dy * dy;
+    dy = dy * dy;
+    dy *= 8.0;
+    dy /= u_src.y;
+    dy *= sign_y;
+    vec3 colour = bilinear(vec2(uv.x, temp_y / u_src.y + dy));
+    colour = pow(colour, vec3(2.4));
+    colour *= weight * 1.5;
+    colour = pow(colour, vec3(1.0 / 2.2));
+    vec3 mask = vec3(1.0, 0.7, 1.0);
+    if (fract(gl_FragCoord.x * 0.5) < 0.5) {
+        mask = vec3(0.7, 1.0, 0.7);
+    }
+    return colour * mask;
+}
+
+/*
+    crt-1tap v1.4 by fishku, ported to GLSL by DariusG. Public domain (CC0).
+*/
+vec3 crt_1tap_prefix(float y, vec3 width) {
+    float cell = floor(y);
+    float phase = y - cell;
+    return cell * width + clamp(vec3(phase - 0.5) + 0.5 * width, vec3(0.0), width);
+}
+
+vec3 crt_1tap(vec2 uv, vec2 texel_per_px) {
+    vec2 src = uv * u_src - vec2(0.5, 0.31);
+    float x_int = floor(src.x);
+    float x = 2.0 * (src.x - x_int) - 1.0;
+    float slope = mix(6.0, 1.0, 0.8);
+    float shift = 0.5 + 0.5 * slope * x * inversesqrt(1.0 + (slope * slope - 1.0) * x * x);
+    float row = floor(src.y) + 0.5;
+    vec3 signal = bilinear(vec2((x_int + shift + 0.5) / u_src.x, row / u_src.y));
+    vec3 width = min(mix(vec3(0.1), vec3(0.95), pow(clamp(signal, 0.0, 1.0), vec3(0.45))), vec3(1.0));
+    float h = texel_per_px.y;
+    vec3 area = crt_1tap_prefix(src.y + 0.5 * h, width) - crt_1tap_prefix(src.y - 0.5 * h, width);
+    return sqrt(signal * signal * area / h);
+}
+
+void main() {
+    vec2 uv = u_uv.xy + v_uv * u_uv.zw;
+    vec3 c = texture2D(u_game, uv).rgb;
+    bool inside = all(greaterThanEqual(uv, u_pic.xy)) && all(lessThan(uv, u_pic.zw));
+    vec2 texel_per_px = u_uv.zw * u_src / (u_rect.zw * u_fbo);
+    if (!inside) {
+    } else if (u_mode > 2.5) {
+        c = crt_1tap(uv, texel_per_px);
+    } else if (u_mode > 1.5) {
+        c = crt_pi(uv, texel_per_px);
+    } else if (u_mode > 0.5) {
+        c = scanlines(uv, c);
+    } else {
+        c = sharp(uv, 1.0 / texel_per_px);
+    }
+    FRAG_COLOR = vec4(c * u_bright, 1.0);
+}
+"#;
diff --git a/crates/slot-gfx/tests/retro_pipeline.rs b/crates/slot-gfx/tests/retro_pipeline.rs
new file mode 100644
index 0000000..00c2934
--- /dev/null
+++ b/crates/slot-gfx/tests/retro_pipeline.rs
@@ -0,0 +1,85 @@
+#![cfg(target_os = "macos")]
+
+use slot_gfx::{Compositor, HeadlessSurface, ScreenEffect};
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+static GL: Mutex<()> = Mutex::new(());
+
+const RETRO: [ScreenEffect; 4] = [
+    ScreenEffect::Retro(0),
+    ScreenEffect::Retro(1),
+    ScreenEffect::Retro(2),
+    ScreenEffect::Retro(3),
+];
+
+fn compositor() -> Option<(MutexGuard<'static, ()>, HeadlessSurface, Compositor)> {
+    let guard = GL.lock().unwrap_or_else(PoisonError::into_inner);
+    let surface = HeadlessSurface::new().ok()?;
+    let compositor = Compositor::new(&surface).expect("the compositor and its shaders build");
+    Some((guard, surface, compositor))
+}
+
+fn source(w: usize, h: usize) -> Vec<u8> {
+    let mut buf = Vec::with_capacity(w * h * 4);
+    for y in 0..h {
+        for x in 0..w {
+            buf.extend_from_slice(&[(x * 7 + y * 13) as u8, (y * 5) as u8, (x * 3) as u8, 0]);
+        }
+    }
+    buf
+}
+
+fn drawn(c: &mut Compositor, effect: ScreenEffect, w: u32, h: u32) -> Vec<u8> {
+    c.set_game_canvas(w, h);
+    c.set_screen_effect(effect);
+    c.set_screen_power(1.0);
+    c.begin_frame(slot_gfx::Layout::Framed);
+    c.upload_game(&source(w as usize, h as usize));
+    c.draw_game();
+    c.read_frame()
+}
+
+#[test]
+fn every_retro_shader_changes_a_stretched_nes_frame_and_draws_it_the_same_twice() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    let off = drawn(&mut c, ScreenEffect::None, 256, 240);
+    let mut frames = vec![off];
+    for effect in RETRO {
+        let once = drawn(&mut c, effect, 256, 240);
+        let twice = drawn(&mut c, effect, 256, 240);
+        assert_eq!(once, twice, "{effect:?} is not deterministic");
+        assert!(
+            frames.iter().all(|f| *f != once),
+            "{effect:?} draws the same frame as Off or an earlier shader"
+        );
+        frames.push(once);
+    }
+}
+
+#[test]
+fn sharp_leaves_a_whole_2x_frame_exactly_as_off_draws_it() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    let off = drawn(&mut c, ScreenEffect::None, 360, 240);
+    let sharp = drawn(&mut c, ScreenEffect::Retro(0), 360, 240);
+    assert_eq!(off, sharp);
+}
+
+#[test]
+fn the_upstream_effects_keep_their_shader_modes() {
+    assert_eq!(
+        [
+            ScreenEffect::None,
+            ScreenEffect::Lcd3x,
+            ScreenEffect::Grid,
+            ScreenEffect::Dot,
+            ScreenEffect::Simpletex,
+        ]
+        .map(ScreenEffect::mode),
+        [0.0, 1.0, 2.0, 3.0, 4.0]
+    );
+    assert!(RETRO.iter().all(|e| e.mode() == 0.0));
+}
