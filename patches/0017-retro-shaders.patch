@@ -0,0 +1,65 @@
+use crate::slot_state::Shader;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum RetroShader {
+    Sharp,
+    Scanlines,
+    CrtPi,
+    Crt1Tap,
+}
+
+impl RetroShader {
+    pub const ALL: [RetroShader; 4] = [
+        RetroShader::Sharp,
+        RetroShader::Scanlines,
+        RetroShader::CrtPi,
+        RetroShader::Crt1Tap,
+    ];
+
+    pub fn index(self) -> usize {
+        self as usize
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            RetroShader::Sharp => "sharp",
+            RetroShader::Scanlines => "scanlines",
+            RetroShader::CrtPi => "crt-pi",
+            RetroShader::Crt1Tap => "crt-1tap",
+        }
+    }
+
+    pub fn label(self) -> &'static str {
+        match self {
+            RetroShader::Sharp => "Sharp",
+            RetroShader::Scanlines => "Scanlines",
+            RetroShader::CrtPi => "crt-pi",
+            RetroShader::Crt1Tap => "crt-1tap",
+        }
+    }
+
+    pub fn toast(self) -> &'static str {
+        match self {
+            RetroShader::Sharp => "Shader: Sharp",
+            RetroShader::Scanlines => "Shader: Scanlines",
+            RetroShader::CrtPi => "Shader: crt-pi",
+            RetroShader::Crt1Tap => "Shader: crt-1tap",
+        }
+    }
+
+    pub fn parse(name: &str) -> Option<RetroShader> {
+        RetroShader::ALL.into_iter().find(|s| s.name() == name)
+    }
+}
+
+impl Shader {
+    pub const RETRO: [Shader; 7] = [
+        Shader::Off,
+        Shader::Grid,
+        Shader::Dot,
+        Shader::Retro(RetroShader::Sharp),
+        Shader::Retro(RetroShader::Scanlines),
+        Shader::Retro(RetroShader::CrtPi),
+        Shader::Retro(RetroShader::Crt1Tap),
+    ];
+}
