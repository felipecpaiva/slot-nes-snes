diff --git a/crates/slot-ui/tests/retro_faces.rs b/crates/slot-ui/tests/retro_faces.rs
new file mode 100644
index 0000000..43ac034
--- /dev/null
+++ b/crates/slot-ui/tests/retro_faces.rs
@@ -0,0 +1,46 @@
+use slot_store::RetroShader;
+use slot_ui::{toast_face, QuickValue, Toast};
+
+#[test]
+fn the_quick_menu_uploads_the_upstream_values_then_one_face_per_retro_shader() {
+    let every = QuickValue::every();
+    assert_eq!(every[..QuickValue::ALL.len()], QuickValue::ALL);
+    assert_eq!(
+        every[QuickValue::ALL.len()..],
+        RetroShader::ALL.map(QuickValue::Retro)
+    );
+    for (i, v) in every.iter().enumerate() {
+        assert_eq!(v.index(), i, "{v:?} does not answer to its own place");
+    }
+    assert_eq!(
+        RetroShader::ALL.map(|s| QuickValue::Retro(s).text()),
+        ["Sharp", "Scanlines", "crt-pi", "crt-1tap"]
+    );
+}
+
+#[test]
+fn the_toasts_upload_upstream_banners_then_one_per_retro_shader() {
+    let every = Toast::every();
+    let all = Toast::all();
+    assert_eq!(every[..all.len()], all[..]);
+    assert_eq!(every[all.len()..], RetroShader::ALL.map(Toast::Retro));
+    for (i, t) in every.iter().enumerate() {
+        assert_eq!(t.index(), i, "{t:?} does not answer to its own place");
+    }
+    assert_eq!(
+        RetroShader::ALL.map(|s| Toast::Retro(s).text()),
+        [
+            "Shader: Sharp",
+            "Shader: Scanlines",
+            "Shader: crt-pi",
+            "Shader: crt-1tap"
+        ]
+    );
+    for s in RetroShader::ALL {
+        let f = toast_face(Toast::Retro(s));
+        assert!(
+            f.rgba.chunks(4).any(|p| p[3] > 0),
+            "{s:?} rastered to a blank banner"
+        );
+    }
+}
