+#[test]
+fn a_wonderswan_game_gets_a_black_cart_and_a_colour_game_a_clear_one() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let mono = cart(rom(d.path(), "Gunpey (Japan).ws", 0));
+    let colour = cart(rom(d.path(), "Final Fantasy (Japan).wsc", 1));
+    assert_eq!(retro_shell_of(&mono), Some(RetroShell::Ws(WsShell::Mono)));
+    assert_eq!(
+        retro_shell_of(&colour),
+        Some(RetroShell::Ws(WsShell::Color))
+    );
+    assert_eq!(shell_for(&mono), WS_BLACK);
+    assert_eq!(shell_for(&colour), WSC_CLEAR);
+    assert_eq!(WSC_CLEAR.finish, Finish::Translucent);
+    assert_eq!(plastic_in(&mono, RetroShell::Ws(WsShell::Mono)), WS_BLACK);
+}
