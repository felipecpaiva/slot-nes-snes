new file mode 100644
index 0000000..a033935
--- /dev/null
+++ b/crates/slot-ui/src/ws_cart.rs
@@ -0,0 +1,31 @@
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+
+use slot_store::Cart;
+
+use crate::retro_cart::WsShell;
+
+pub(crate) fn shell_of(cart: &Cart) -> WsShell {
+    static SHELLS: OnceLock<Mutex<HashMap<PathBuf, WsShell>>> = OnceLock::new();
+    *SHELLS
+        .get_or_init(Mutex::default)
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .entry(cart.rom.clone())
+        .or_insert_with(|| read_shell(&cart.rom))
+}
+
+pub fn read_shell(rom: &Path) -> WsShell {
+    let colour = match slot_store::ws::footer(rom) {
+        Some(footer) => footer.colour,
+        None => rom
+            .extension()
+            .and_then(|e| e.to_str())
+            .is_some_and(|e| e.eq_ignore_ascii_case("wsc")),
+    };
+    match colour {
+        true => WsShell::Color,
+        false => WsShell::Mono,
+    }
+}
