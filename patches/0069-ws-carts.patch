+#[test]
+fn both_shells_share_one_wide_box_no_taller_than_66_by_41_mm() {
+    assert_eq!(seated_box(Platform::Ws), (240, 149));
+    let (w, h) = cart_box(Platform::Ws);
+    assert_eq!(w, 360);
+    assert!(h.abs_diff(149 * 360 / 240) <= 1);
+}
