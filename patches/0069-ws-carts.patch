+#[test]
+fn an_unreadable_footer_falls_back_to_the_extension() {
+    let d = tempfile::tempdir().expect("tempdir");
+    assert_eq!(ws_shell(&d.path().join("Missing.wsc")), WsShell::Color);
+    assert_eq!(ws_shell(&d.path().join("Missing.WSC")), WsShell::Color);
+    assert_eq!(ws_shell(&d.path().join("Missing.ws")), WsShell::Mono);
+    std::fs::write(d.path().join("Short.wsc"), [1u8; 64]).expect("write");
+    assert_eq!(ws_shell(&d.path().join("Short.wsc")), WsShell::Color);
+}
