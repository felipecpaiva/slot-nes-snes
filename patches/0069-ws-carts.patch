new file mode 100644
index 0000000..acb6ec4
--- /dev/null
+++ b/crates/slot-ui/tests/wswan_cart.rs
@@ -0,0 +1,70 @@
+use std::path::{Path, PathBuf};
+
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    cart_box, plastic_in, retro_shell_of, seated_box, shell_for, ws_shell, Finish, RetroShell,
+    WsShell, WSC_CLEAR, WS_BLACK,
+};
+
+fn rom(dir: &Path, name: &str, colour: u8) -> PathBuf {
+    let mut bytes = vec![0u8; 0x10000];
+    bytes[0x10000 - 9] = colour;
+    let path = dir.join(name);
+    std::fs::write(&path, bytes).expect("write rom");
+    path
+}
+
+fn cart(rom: PathBuf) -> Cart {
+    Cart {
+        platform: Platform::Ws,
+        stem: "Game".into(),
+        rom,
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+#[test]
+fn the_footer_colour_flag_picks_the_shell_whatever_the_extension() {
+    let d = tempfile::tempdir().expect("tempdir");
+    assert_eq!(ws_shell(&rom(d.path(), "a.ws", 1)), WsShell::Color);
+    assert_eq!(ws_shell(&rom(d.path(), "b.wsc", 0)), WsShell::Mono);
+    assert_eq!(ws_shell(&rom(d.path(), "c.ws", 0)), WsShell::Mono);
+    assert_eq!(ws_shell(&rom(d.path(), "d.wsc", 1)), WsShell::Color);
+}
