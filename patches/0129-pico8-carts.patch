diff --git a/crates/slot-ui/tests/pico8_cart.rs b/crates/slot-ui/tests/pico8_cart.rs
new file mode 100644
index 0000000..9fe0bd5
--- /dev/null
+++ b/crates/slot-ui/tests/pico8_cart.rs
@@ -0,0 +1,122 @@
+// The PICO-8 cart (ADR 0102): one grey shell for every cart, drawn by us to the proportions of the
+// 160x205 cart export, the cart's own 128x128 label picture in the square well.
+use std::path::PathBuf;
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    cart_box, label_cover, retro_cart_face, retro_label_rect, retro_shell_of, seated_box,
+    shell_for, RetroShell, PICO8_GREY,
+};
+
+const RED: [u8; 3] = [230, 30, 30];
+
+fn rom(name: &str) -> PathBuf {
+    let p = std::env::temp_dir().join(format!("slot-pico8-cart-{}-{name}", std::process::id()));
+    std::fs::write(&p, b"pico-8 cartridge // http://www.pico-8.com\n").expect("write rom");
+    p
+}
+
+fn cart(rom: PathBuf, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform: Platform::Pico8,
+        stem: "Celeste".into(),
+        rom,
+        label,
+        title: "Celeste".into(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn art(name: &str, w: u32, h: u32) -> PathBuf {
+    let px: Vec<u8> = (0..w * h)
+        .flat_map(|_| [RED[0], RED[1], RED[2], 255])
+        .collect();
+    let p = std::env::temp_dir().join(format!("slot-pico8-art-{}-{name}.png", std::process::id()));
+    let mut e = png::Encoder::new(std::fs::File::create(&p).expect("create art"), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    p
+}
+
+fn near(p: &[u8], c: [u8; 3]) -> bool {
+    (0..3).all(|i| p[i].abs_diff(c[i]) < 16)
+}
+
+#[test]
+fn every_pico_8_cart_takes_the_one_pico_8_shell_in_grey() {
+    for name in ["Celeste.p8", "Cherry_Bomb.p8.png", "X-Zero.p8"] {
+        let c = cart(rom(name), None);
+        assert_eq!(retro_shell_of(&c), Some(RetroShell::Pico8), "{name}");
+        assert_eq!(shell_for(&c), PICO8_GREY, "{name}");
+    }
+    assert_eq!(RetroShell::Pico8.name(), "pico8");
+}
+
+#[test]
+fn a_chosen_shell_colour_still_wins_over_the_pico_8_grey() {
+    let mut c = cart(rom("chosen.p8"), None);
+    c.shell = Some(ShellChoice {
+        outline: Outline::Auto,
+        colour: [0x10, 0x20, 0x30],
+        finish: ShellFinish::Solid,
+    });
+    assert_eq!(retro_shell_of(&c), Some(RetroShell::Pico8));
+    assert_eq!(shell_for(&c).colour, [0x10, 0x20, 0x30]);
+}
+
+#[test]
+fn the_pico_8_cart_keeps_the_export_proportions_with_a_square_label_well() {
+    assert_eq!(seated_box(Platform::Pico8), (240, 308));
+    assert_eq!(cart_box(Platform::Pico8), (312, 400));
+    let (x, y, w, h) = retro_label_rect(RetroShell::Pico8);
+    let px = |f: f32, of: f32| (f * of).round() as u32;
+    assert_eq!(
+        (px(x, 312.0), px(y, 400.0), px(w, 312.0), px(h, 400.0)),
+        (31, 47, 250, 249)
+    );
+}
+
+#[test]
+fn the_pico_8_cart_renders_grey_with_a_cut_corner_and_a_darker_title_strip() {
+    let face = retro_cart_face(&cart(rom("bare.p8"), None), RetroShell::Pico8);
+    assert_eq!((face.w, face.h), (312, 400));
+    let at = |x: u32, y: u32| &face.rgba[((y * 312 + x) * 4) as usize..][..4];
+    assert_eq!(at(0, 0)[3], 0, "the top corner is rounded off");
+    assert_eq!(at(309, 397)[3], 0, "the bottom right corner is cut");
+    assert_eq!(at(8, 397)[3], 255, "the bottom left corner is only rounded");
+    let body = at(156, 20);
+    let strip = at(156, 350);
+    assert_eq!((body[3], strip[3]), (255, 255));
+    assert!(
+        near(body, [0x64, 0x64, 0x64]),
+        "the plastic is grey: {body:?}"
+    );
+    assert!(
+        (0..3).all(|i| strip[i] + 25 < body[i]),
+        "the title strip is darker: {strip:?} against {body:?}"
+    );
+}
+
+#[test]
+fn the_pico_8_cart_renders_its_label_picture_inside_the_well() {
+    let red = art("label", 128, 128);
+    let c = cart(rom("label.p8"), Some(red.clone()));
+    let (_, _, lw, lh) = retro_label_rect(RetroShell::Pico8);
+    let (lw, lh) = ((lw * 312.0).round() as u32, (lh * 400.0).round() as u32);
+    assert!(label_cover(&c, &red, lw, lh).is_some());
+    let face = retro_cart_face(&c, RetroShell::Pico8);
+    let red_at = |x: u32, y: u32| near(&face.rgba[((y * 312 + x) * 4) as usize..], RED);
+    assert!(red_at(156, 170), "the middle of the well is the label");
+    assert!(
+        red_at(40, 60) && red_at(272, 286),
+        "the whole square is the label"
+    );
+    assert!(!red_at(156, 20), "the top is plastic");
+    assert!(!red_at(12, 170), "the side is plastic");
+    assert!(!red_at(156, 350), "the title strip is plastic");
+}
