+// one mode per branch of main() in RETRO_FRAG, the place of each RetroShader in RetroShader::ALL
+const RETRO_MODES: u8 = 6;
+
 const RETRO_FRAG: &str = r#"
 #ifdef GL_FRAGMENT_PRECISION_HIGH
 precision highp float;
@@ -146,6 +149,7 @@ uniform vec2 u_fbo;
 uniform vec4 u_pic;
 uniform float u_bright;
 uniform float u_mode;
+uniform float u_out_h;
 varying vec2 v_uv;
 
 vec3 tap(vec2 texel) {
@@ -181,6 +185,46 @@ vec3 scanlines(vec2 uv, vec3 c) {
     return c * abs(sin(angle) * 1.25);
 }
 
+vec3 line(vec2 texel_per_px, vec3 c) {
+    float repeat = max(floor(1.0 / texel_per_px.y), 2.0);
+    float top = u_rect.y + (u_pic.y - u_uv.y) / u_uv.w * u_rect.w;
+    float row = floor((u_out_h - top) * u_fbo.y - gl_FragCoord.y);
+    return mod(row, repeat) < 0.5 ? c * 0.5 : c;
+}
+
+/*
+    Pixellate Shader
+    Copyright (c) 2011, 2012 Fes
+    Permission to use, copy, modify, and/or distribute this software for any
+    purpose with or without fee is hereby granted, provided that the above
+    copyright notice and this permission notice appear in all copies.
+    THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+    WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+    MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY
+    SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+    WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+    ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR
+    IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+    (Fes gave their permission to have this shader distributed under this
+    licence in this forum post:
+        http://board.byuu.org/viewtopic.php?p=57295#p57295
+*/
+vec3 pixel(vec2 uv, vec2 texel_per_px) {
+    vec2 texel = uv * u_src;
+    vec2 range = texel_per_px * 0.5 * 0.999;
+    vec2 lo = texel - range;
+    vec2 hi = texel + range;
+    vec2 border = clamp(floor(texel + 0.5), lo, hi);
+    vec2 a = border - lo;
+    vec2 b = hi - border;
+    vec3 ll = tap(floor(lo) + 0.5);
+    vec3 hl = tap(vec2(floor(hi.x), floor(lo.y)) + 0.5);
+    vec3 lh = tap(vec2(floor(lo.x), floor(hi.y)) + 0.5);
+    vec3 hh = tap(floor(hi) + 0.5);
+    vec3 sum = a.x * a.y * ll * ll + b.x * a.y * hl * hl + a.x * b.y * lh * lh + b.x * b.y * hh * hh;
+    return sqrt(sum / ((a.x + b.x) * (a.y + b.y)));
+}
+
 /*
     crt-pi - A Raspberry Pi friendly CRT shader.
 
@@ -248,12 +292,16 @@ void main() {
     bool inside = all(greaterThanEqual(uv, u_pic.xy)) && all(lessThan(uv, u_pic.zw));
     vec2 texel_per_px = u_uv.zw * u_src / (u_rect.zw * u_fbo);
     if (!inside) {
+    } else if (u_mode > 4.5) {
+        c = pixel(uv, texel_per_px);
+    } else if (u_mode > 3.5) {
+        c = line(texel_per_px, sharp(uv, 1.0 / texel_per_px));
     } else if (u_mode > 2.5) {
         c = crt_1tap(uv, texel_per_px);
     } else if (u_mode > 1.5) {
         c = crt_pi(uv, texel_per_px);
     } else if (u_mode > 0.5) {
-        c = scanlines(uv, c);
+        c = scanlines(uv, sharp(uv, 1.0 / texel_per_px));
     } else {
         c = sharp(uv, 1.0 / texel_per_px);
     }
