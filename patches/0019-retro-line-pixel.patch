 static GL: Mutex<()> = Mutex::new(());
 
-const RETRO: [ScreenEffect; 4] = [
+const SHARP: ScreenEffect = ScreenEffect::Retro(0);
+const SCANLINES: ScreenEffect = ScreenEffect::Retro(1);
+const LINE: ScreenEffect = ScreenEffect::Retro(4);
+const PIXEL: ScreenEffect = ScreenEffect::Retro(5);
+
+const RETRO: [ScreenEffect; 6] = [
     ScreenEffect::Retro(0),
     ScreenEffect::Retro(1),
     ScreenEffect::Retro(2),
     ScreenEffect::Retro(3),
+    ScreenEffect::Retro(4),
+    ScreenEffect::Retro(5),
 ];
 
 fn compositor() -> Option<(MutexGuard<'static, ()>, HeadlessSurface, Compositor)> {
@@ -30,15 +37,38 @@ fn source(w: usize, h: usize) -> Vec<u8> {
 }
 
 fn drawn(c: &mut Compositor, effect: ScreenEffect, w: u32, h: u32) -> Vec<u8> {
+    drawn_from(c, effect, w, h, &source(w as usize, h as usize))
+}
+
+fn drawn_from(c: &mut Compositor, effect: ScreenEffect, w: u32, h: u32, src: &[u8]) -> Vec<u8> {
     c.set_game_canvas(w, h);
     c.set_screen_effect(effect);
     c.set_screen_power(1.0);
     c.begin_frame();
-    c.upload_game(&source(w as usize, h as usize));
+    c.upload_game(src);
     c.draw_game();
     c.read_frame()
 }
 
+fn grey(w: u32, h: u32) -> Vec<u8> {
+    vec![200; w as usize * h as usize * 4]
+}
+
+fn bars(w: u32, h: u32) -> Vec<u8> {
+    let mut buf = Vec::with_capacity(w as usize * h as usize * 4);
+    for _ in 0..h {
+        for x in 0..w {
+            let v = if x % 2 == 0 { 0 } else { 200 };
+            buf.extend_from_slice(&[v, v, v, 0]);
+        }
+    }
+    buf
+}
+
+fn column(frame: &[u8], x: usize) -> Vec<u8> {
+    frame.chunks_exact(720 * 4).map(|row| row[x * 4]).collect()
+}
+
 #[test]
 fn every_retro_shader_changes_a_stretched_nes_frame_and_draws_it_the_same_twice() {
     let Some((_g, _s, mut c)) = compositor() else {
@@ -64,10 +94,57 @@ fn sharp_leaves_a_whole_2x_frame_exactly_as_off_draws_it() {
         return;
     };
     let off = drawn(&mut c, ScreenEffect::None, 360, 240);
-    let sharp = drawn(&mut c, ScreenEffect::Retro(0), 360, 240);
+    let sharp = drawn(&mut c, SHARP, 360, 240);
     assert_eq!(off, sharp);
 }
 
+#[test]
+fn pixel_leaves_a_whole_2x_frame_exactly_as_off_draws_it() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    let off = drawn(&mut c, ScreenEffect::None, 360, 240);
+    let pixel = drawn(&mut c, PIXEL, 360, 240);
+    assert_eq!(off, pixel);
+}
+
+#[test]
+fn line_halves_the_top_panel_row_of_every_repeat() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    for (w, h, repeat) in [(360, 240, 2), (256, 224, 2), (240, 160, 3)] {
+        let frame = drawn_from(&mut c, LINE, w, h, &grey(w, h));
+        let want: Vec<u8> = (0..480)
+            .map(|y| if y % repeat == 0 { 100 } else { 200 })
+            .collect();
+        assert_eq!(column(&frame, 360), want, "{w}x{h}");
+    }
+}
+
+#[test]
+fn scanlines_samples_the_sharp_picture_at_nes_stretch() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    let bright = |frame: &[u8], y: usize| {
+        let mut seen: Vec<u8> = frame[y * 720 * 4..(y + 1) * 720 * 4]
+            .chunks_exact(4)
+            .map(|p| p[0])
+            .collect();
+        seen.sort_unstable();
+        seen.dedup();
+        seen
+    };
+    let off = drawn_from(&mut c, ScreenEffect::None, 256, 240, &bars(256, 240));
+    let scan = drawn_from(&mut c, SCANLINES, 256, 240, &bars(256, 240));
+    let y = (0..480)
+        .max_by_key(|&y| bright(&scan, y).last().copied())
+        .unwrap();
+    assert_eq!(bright(&off, y), [0, 200]);
+    assert!(bright(&scan, y).len() > 2, "{:?}", bright(&scan, y));
+}
