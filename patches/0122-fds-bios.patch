+use crate::Toast;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum FdsToast {
+    NeedsBios,
+    UnknownBios,
+    Side(u8),
+}
+
+impl FdsToast {
+    pub const SIDES: u8 = 8;
+
+    pub const ALL: [FdsToast; 10] = [
+        FdsToast::NeedsBios,
+        FdsToast::UnknownBios,
+        FdsToast::Side(0),
+        FdsToast::Side(1),
+        FdsToast::Side(2),
+        FdsToast::Side(3),
+        FdsToast::Side(4),
+        FdsToast::Side(5),
+        FdsToast::Side(6),
+        FdsToast::Side(7),
+    ];
+
+    pub fn index(self) -> usize {
+        Self::ALL.iter().position(|t| *t == self).unwrap_or(0)
+    }
+
+    pub fn text(self) -> &'static str {
+        match self {
+            FdsToast::NeedsBios => "FDS needs BIOS/disksys.rom",
+            FdsToast::UnknownBios => "disksys.rom is not the known dump",
+            FdsToast::Side(0) => "Disk 1 Side A",
+            FdsToast::Side(1) => "Disk 1 Side B",
+            FdsToast::Side(2) => "Disk 2 Side A",
+            FdsToast::Side(3) => "Disk 2 Side B",
+            FdsToast::Side(4) => "Disk 3 Side A",
+            FdsToast::Side(5) => "Disk 3 Side B",
+            FdsToast::Side(6) => "Disk 4 Side A",
+            FdsToast::Side(_) => "Disk 4 Side B",
+        }
+    }
+}
+
+impl Toast {
+    pub fn fds_index(f: FdsToast) -> usize {
+        Toast::arcade_index(crate::ArcadeToast::ALL[0]) + crate::ArcadeToast::ALL.len() + f.index()
+    }
+}
