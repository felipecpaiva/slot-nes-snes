diff --git a/crates/slot/src/app/fds_bios.rs b/crates/slot/src/app/fds_bios.rs
new file mode 100644
index 0000000..2ef960d
--- /dev/null
+++ b/crates/slot/src/app/fds_bios.rs
@@ -0,0 +1,35 @@
+use slot_store::fds::bios;
+use slot_store::lynx::Bios;
+use slot_store::Platform;
+use slot_ui::{FdsToast, Toast};
+
+use super::App;
+
+impl App {
+    pub(super) fn fds_bios_allows(&mut self, platform: Platform) -> bool {
+        if platform != Platform::Fds {
+            return true;
+        }
+        let Some(root) = self.root.as_deref() else {
+            return true;
+        };
+        match bios(&crate::root::bios_dir(root)) {
+            Bios::Known => true,
+            Bios::Unknown => {
+                if !self.fds_bios_warned {
+                    self.fds_bios_warned = true;
+                    eprintln!("slot: fds: BIOS/disksys.rom is not the known dump, launching");
+                    self.hud
+                        .toast(Toast::Fds(FdsToast::UnknownBios), self.now());
+                }
+                true
+            }
+            Bios::Missing => {
+                eprintln!("slot: fds: no usable BIOS/disksys.rom, not launching");
+                self.hud.toast(Toast::Fds(FdsToast::NeedsBios), self.now());
+                self.refuse();
+                false
+            }
+        }
+    }
+}
diff --git a/crates/slot/tests/fds_bios.rs b/crates/slot/tests/fds_bios.rs
new file mode 100644
index 0000000..4790dd7
--- /dev/null
+++ b/crates/slot/tests/fds_bios.rs
@@ -0,0 +1,132 @@
+// The Famicom Disk System needs BIOS/disksys.rom, which slot never ships or fetches (ADR 0101).
+// Without it fceumm refuses the disk, so slot checks before the disk is inserted, like the Lynx.
+mod common;
+mod core_common;
+mod fds_common;
+
+use std::path::Path;
+
+use common::tmp_root_with_carts;
+use fds_common::{disk, fds_bios, placeholder_bios, put_bios};
+use slot::app::{App, Phase};
+use slot_input::{Action, Btn};
+use slot_store::fds::{bios, bios_of, BIOS_FILE};
+use slot_store::lynx::Bios;
+use slot_store::{write_slot_state, Platform, SlotState};
+use slot_ui::{ArcadeToast, FdsToast, Toast};
+use tempfile::TempDir;
+
+fn card(bios: Option<&[u8]>) -> TempDir {
+    let d = tmp_root_with_carts(&[]);
+    disk(&d.path().join("Games/FDS"), "Esper Dream", 2, true);
+    if let Some(b) = bios {
+        put_bios(d.path(), b);
+    }
+    d
+}
+
+fn boot_on(root: &Path, cart: Option<&str>) -> App {
+    write_slot_state(
+        root,
+        &SlotState {
+            clock_set: true,
+            cart: cart.map(str::to_string),
+            cart_platform: cart.map(|_| Platform::Fds),
+            ..SlotState::default()
+        },
+    )
+    .expect("write slot.state");
+    App::boot(root)
+}
+
+fn insert(a: &mut App) {
+    a.apply(Action::GbaDown(Btn::A));
+    a.apply(Action::GbaUp(Btn::A));
+    for _ in 0..10 {
+        a.update(1.0 / 60.0);
+    }
+}
+
+fn inserting(a: &App) -> bool {
+    matches!(a.phase(), Phase::Inserting { .. } | Phase::Playing { .. })
+}
+
+#[test]
+fn the_check_reads_missing_short_long_and_unknown_files() {
+    let d = tempfile::tempdir().unwrap();
+    assert_eq!(BIOS_FILE, "disksys.rom");
+    assert_eq!(bios(d.path()), Bios::Missing);
+    for (bytes, want) in [
+        (vec![], Bios::Missing),
+        (vec![0u8; 4096], Bios::Missing),
+        (vec![0u8; 8193], Bios::Missing),
+        (vec![0u8; 8192], Bios::Unknown),
+    ] {
+        std::fs::write(d.path().join(BIOS_FILE), &bytes).unwrap();
+        assert_eq!(bios(d.path()), want, "{} bytes", bytes.len());
+    }
+}
+
+#[test]
+fn the_maintainers_own_bios_is_the_known_dump() {
+    let Some(b) = fds_bios() else {
+        return;
+    };
+    assert_eq!(bios_of(&b), Bios::Known);
+}
+
+#[test]
+fn with_no_bios_a_disk_stays_on_the_shelf_with_a_toast() {
+    let d = card(None);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Fds(FdsToast::NeedsBios)));
+    assert_eq!(
+        Toast::Fds(FdsToast::NeedsBios).text(),
+        "FDS needs BIOS/disksys.rom"
+    );
+}
+
+#[test]
+fn a_disk_resumed_at_boot_is_checked_too() {
+    let d = card(Some(&[0u8; 100]));
+    let a = boot_on(d.path(), Some("Esper Dream"));
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Fds(FdsToast::NeedsBios)));
+}
+
+#[test]
+fn an_unknown_bios_launches_and_says_so() {
+    let d = card(Some(&placeholder_bios()));
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Fds(FdsToast::UnknownBios)));
+}
+
+#[test]
+fn a_known_bios_launches_with_no_toast() {
+    let Some(b) = fds_bios() else {
+        return;
+    };
+    let d = card(Some(&b));
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn the_fds_toasts_upload_in_their_own_place_after_the_arcade_one() {
+    let every = Toast::every();
+    for f in FdsToast::ALL {
+        let t = Toast::Fds(f);
+        assert_eq!(every.get(t.index()), Some(&t), "{f:?}");
+    }
+    assert_eq!(
+        Toast::Fds(FdsToast::ALL[0]).index(),
+        Toast::Arcade(ArcadeToast::ALL[ArcadeToast::ALL.len() - 1]).index() + 1
+    );
+    assert_eq!(FdsToast::ALL.len(), 2 + usize::from(FdsToast::SIDES));
+}
diff --git a/crates/slot/tests/fds_common/mod.rs b/crates/slot/tests/fds_common/mod.rs
new file mode 100644
index 0000000..fba4a84
--- /dev/null
+++ b/crates/slot/tests/fds_common/mod.rs
@@ -0,0 +1,66 @@
+#![allow(dead_code)]
+
+use std::path::{Path, PathBuf};
+
+pub const SIDE: usize = 65_500;
+pub const BIOS_CRC32: u32 = 0x5e60_7dcf;
+
+pub fn fceumm() -> Option<PathBuf> {
+    crate::core_common::require_core("fceumm")
+}
+
+pub fn side(n: u8) -> Vec<u8> {
+    let mut s = vec![0u8; SIDE];
+    s[0] = 1;
+    s[1..15].copy_from_slice(b"*NINTENDO-HVC*");
+    s[0x40] = 0xa0 + n;
+    s
+}
+
+pub fn disk_bytes(sides: u8, headered: bool) -> Vec<u8> {
+    let mut d = Vec::new();
+    if headered {
+        d.extend_from_slice(b"FDS\x1a");
+        d.push(sides);
+        d.extend_from_slice(&[0; 11]);
+    }
+    for n in 0..sides {
+        d.extend(side(n));
+    }
+    d
+}
+
+pub fn disk(dir: &Path, stem: &str, sides: u8, headered: bool) -> PathBuf {
+    std::fs::create_dir_all(dir).expect("disk dir");
+    let p = dir.join(format!("{stem}.fds"));
+    std::fs::write(&p, disk_bytes(sides, headered)).expect("write disk");
+    p
+}
+
+pub fn put_bios(root: &Path, bios: &[u8]) {
+    let dir = slot::root::bios_dir(root);
+    std::fs::create_dir_all(&dir).expect("bios dir");
+    std::fs::write(dir.join("disksys.rom"), bios).expect("write bios");
+}
+
+pub fn placeholder_bios() -> Vec<u8> {
+    vec![0u8; 8192]
+}
+
+pub fn fds_bios() -> Option<Vec<u8>> {
+    let Some(path) = std::env::var_os("SLOT_FDS_BIOS") else {
+        eprintln!(
+            "skipping: no FDS BIOS, set SLOT_FDS_BIOS to a disksys.rom (8192 bytes, crc32 5e607dcf)"
+        );
+        return None;
+    };
+    let bytes = std::fs::read(&path).unwrap_or_default();
+    if bytes.len() != 8192 || slot_store::lynx::crc32(&bytes) != BIOS_CRC32 {
+        eprintln!(
+            "skipping: SLOT_FDS_BIOS {} is not the FDS BIOS",
+            Path::new(&path).display()
+        );
+        return None;
+    }
+    Some(bytes)
+}
