--- /dev/null
+++ b/crates/slot-store/src/fds.rs
@@ -0,0 +1,22 @@
+use std::path::Path;
+
+use crate::lynx::{crc32, Bios};
+
+pub const BIOS_FILE: &str = "disksys.rom";
+const BIOS_BYTES: usize = 8192;
+const BIOS_CRC32: u32 = 0x5e60_7dcf;
+
+pub fn bios(bios_dir: &Path) -> Bios {
+    match std::fs::read(bios_dir.join(BIOS_FILE)) {
+        Ok(bytes) => bios_of(&bytes),
+        Err(_) => Bios::Missing,
+    }
+}
+
+pub fn bios_of(bytes: &[u8]) -> Bios {
+    match (bytes.len(), crc32(bytes)) {
+        (BIOS_BYTES, BIOS_CRC32) => Bios::Known,
+        (BIOS_BYTES, _) => Bios::Unknown,
+        _ => Bios::Missing,
+    }
+}
