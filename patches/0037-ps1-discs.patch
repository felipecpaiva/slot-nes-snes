+
+fn is_playlist(rom: &Path) -> bool {
+    rom.extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| e.eq_ignore_ascii_case("m3u"))
+}
+
+pub fn disc_file(root: &Path, stem: &str) -> PathBuf {
+    crate::root::saves_dir(root)
+        .join(Platform::Ps1.dir_name())
+        .join(format!("{stem}.disc"))
+}
+
+pub fn remembered_disc(root: &Path, stem: &str, discs: usize) -> u32 {
+    let path = disc_file(root, stem);
+    let text = match std::fs::read_to_string(&path) {
+        Ok(text) => text,
+        Err(e) => {
+            eprintln!("slot: disc: {}: {e}, starting on disc 1", path.display());
+            return 0;
+        }
+    };
+    match text.trim().parse::<u32>() {
+        Ok(index) if (index as usize) < discs => index,
+        _ => {
+            eprintln!(
+                "slot: disc: {} says {:?} for a game of {discs} discs, starting on disc 1",
+                path.display(),
+                text.trim()
+            );
+            0
+        }
+    }
+}
+
+pub fn remember_disc(root: &Path, stem: &str, index: u32) -> std::io::Result<()> {
+    let path = disc_file(root, stem);
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    slot_store::atomic_write(&path, format!("{index}\n").as_bytes())
+}
+
+pub fn offer_remembered_disc(
+    core: &mut dyn RetroCore,
+    root: &Path,
+    platform: Platform,
+    stem: &str,
+    rom: &Path,
+) {
+    if !platform.swaps_discs() || !is_playlist(rom) {
+        return;
+    }
+    let Some(discs) = slot_store::ps1::playlist(rom) else {
+        return;
+    };
+    let index = remembered_disc(root, stem, discs.len());
+    if let Some(path) = discs.get(index as usize).filter(|_| index > 0) {
+        core.set_initial_disc(index, path);
+    }
+}
