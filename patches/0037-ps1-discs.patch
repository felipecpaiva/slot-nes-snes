+use slot_retro::DiscEvent;
+use slot_ui::{DiscToast, Toast};
+
+use super::App;
+
+impl App {
+    pub fn disc_event(&mut self, event: DiscEvent) {
+        let (Some(root), Some(cart)) = (
+            self.root.clone(),
+            self.seated_cart().map(|c| c.stem.clone()),
+        ) else {
+            return;
+        };
+        let toast = match event {
+            DiscEvent::Swapped(index) | DiscEvent::Restored(index) => {
+                let written = crate::ps1_load::remember_disc(&root, &cart, index);
+                if let Err(e) = &written {
+                    eprintln!("slot: disc: could not remember disc {}: {e}", index + 1);
+                }
+                self.card_writes.wrote("disc", &written);
+                match event {
+                    DiscEvent::Swapped(_) => DiscToast::inserted(index),
+                    _ => None,
+                }
+            }
+            DiscEvent::Refused => Some(DiscToast::Refused),
+            DiscEvent::NewerState => Some(DiscToast::NewerState),
+        };
+        if let Some(toast) = toast {
+            self.hud.toast(Toast::Disc(toast), self.now());
+        }
+    }
+}
