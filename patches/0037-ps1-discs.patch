diff --git a/crates/slot-input/src/gesture/ps1.rs b/crates/slot-input/src/gesture/ps1.rs
new file mode 100644
index 0000000..c43ec3b
--- /dev/null
+++ b/crates/slot-input/src/gesture/ps1.rs
@@ -0,0 +1,14 @@
+use super::{Action, Gestures};
+
+impl Gestures {
+    pub fn set_disc_chord(&mut self, on: bool) {
+        self.disc_chord = on;
+    }
+
+    pub(super) fn ps1_chord(&self, action: Option<Action>) -> Option<Action> {
+        match action {
+            Some(Action::PalettePrev) if self.disc_chord => Some(Action::DiscNext),
+            other => other,
+        }
+    }
+}
diff --git a/crates/slot-input/tests/ps1_gesture.rs b/crates/slot-input/tests/ps1_gesture.rs
new file mode 100644
index 0000000..1f9060d
--- /dev/null
+++ b/crates/slot-input/tests/ps1_gesture.rs
@@ -0,0 +1,30 @@
+use slot_input::{Action, Btn, Gestures, RawEvent};
+
+fn select_with(g: &mut Gestures, b: Btn) -> Vec<Action> {
+    let mut out = g.feed(RawEvent::Down(Btn::Select), 1000);
+    out.extend(g.feed(RawEvent::Down(b), 1020));
+    out.extend(g.feed(RawEvent::Up(b), 1100));
+    out.extend(g.feed(RawEvent::Up(Btn::Select), 1120));
+    out.extend(g.tick(2000));
+    out
+}
+
+fn ps1() -> Gestures {
+    let mut g = Gestures::new();
+    g.set_video_mode_chord(true);
+    g.set_disc_chord(true);
+    g
+}
+
+#[test]
+fn select_l2_swaps_the_disc_on_ps1() {
+    assert_eq!(select_with(&mut ps1(), Btn::L2), [Action::DiscNext]);
+}
+
+#[test]
+fn select_l2_still_steps_the_palette_back_everywhere_else() {
+    assert_eq!(
+        select_with(&mut Gestures::new(), Btn::L2),
+        [Action::PalettePrev]
+    );
+}
