@@ -0,0 +1,290 @@
+mod common;
+mod core_common;
+mod ps1_common;
+mod real_seat;
+
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use ps1_common::{disc, pcsx_rearmed, two_discs};
+use slot::core::{apply_core_options, dylib_name};
+use slot::ps1_load::{disc_file, offer_remembered_disc, remember_disc, remembered_disc};
+use slot_input::{Btn, RawEvent};
+use slot_retro::{DiscEvent, LibretroCore, RetroCore};
+use slot_store::{Core, Platform};
+use slot_ui::{DiscToast, Toast};
+
+const PCSX_STATE_BYTES: usize = 0x44_0000;
+const STEM: &str = "Game";
+
+fn opened(dylib: &Path, root: &Path) -> LibretroCore {
+    let mut core = LibretroCore::open_with(
+        dylib,
+        &slot::root::bios_dir(root),
+        &slot::root::saves_dir(root),
+    )
+    .expect("open pcsx");
+    core.set_canvas(640, 480);
+    core.fill_canvas();
+    core.use_disc_drive();
+    apply_core_options(
+        &mut core,
+        Core::PcsxRearmed,
+        Platform::Ps1,
+        "auto",
+        false,
+        false,
+        None,
+    );
+    core.set_option("pcsx_rearmed_bios", "HLE");
+    core
+}
+
+fn run(core: &mut LibretroCore, frames: usize) {
+    for _ in 0..frames {
+        core.run_frame(slot_retro::ButtonMask::default());
+    }
+}
+
+fn two_disc_game(dylib: &Path) -> (tempfile::TempDir, LibretroCore) {
+    let root = common::tmp_root_with_real_carts(&[]);
+    let m3u = two_discs(&root.path().join("Games/PS1"), STEM);
+    let mut core = opened(dylib, root.path());
+    slot::ps1_load::load(&mut core, &m3u).expect("load the playlist");
+    run(&mut core, 10);
+    (root, core)
+}
+
+#[test]
+fn a_two_disc_game_swaps_from_disc_one_to_disc_two_and_back() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let (_root, mut core) = two_disc_game(&dylib);
+    assert_eq!((core.disc_count(), core.disc_index()), (2, 0));
+    core.next_disc();
+    assert_eq!(core.disc_index(), 1);
+    assert_eq!(core.take_disc_event(), Some(DiscEvent::Swapped(1)));
+    run(&mut core, 5);
+    core.next_disc();
+    assert_eq!(core.disc_index(), 0);
+    assert_eq!(core.take_disc_event(), Some(DiscEvent::Swapped(0)));
+}
+
+#[test]
+fn a_disc_out_of_range_is_refused_and_the_disc_in_play_stays() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let (_root, mut core) = two_disc_game(&dylib);
+    for index in [2, 7, 8, u32::MAX] {
+        assert!(core.swap_disc(index).is_err(), "disc index {index}");
+        assert_eq!(core.disc_index(), 0, "disc index {index}");
+    }
+}
+
+#[test]
+fn a_swap_the_core_refuses_rolls_back_to_the_old_disc() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let (root, mut core) = two_disc_game(&dylib);
+    for name in ["Game (Disc 2).cue", "Game (Disc 2).bin"] {
+        std::fs::remove_file(root.path().join("Games/PS1").join(name)).expect("remove disc 2");
+    }
+    core.next_disc();
+    assert_eq!(core.take_disc_event(), Some(DiscEvent::Refused));
+    assert_eq!(core.disc_index(), 0);
+    run(&mut core, 5);
+    assert_eq!(
+        core.serialize().expect("serialize").len(),
+        PCSX_STATE_BYTES + 12
+    );
+}
+
+#[test]
+fn a_game_resumes_on_the_disc_its_disc_file_names() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let root = common::tmp_root_with_real_carts(&[]);
+    let m3u = two_discs(&root.path().join("Games/PS1"), STEM);
+    remember_disc(root.path(), STEM, 1).expect("write the disc file");
+    let mut core = opened(&dylib, root.path());
+    offer_remembered_disc(&mut core, root.path(), Platform::Ps1, STEM, &m3u);
+    slot::ps1_load::load(&mut core, &m3u).expect("load the playlist");
+    assert_eq!(core.disc_index(), 1);
+}
+
+#[test]
+fn a_disc_one_state_loaded_on_disc_two_swaps_back_to_disc_one() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let (_root, mut core) = two_disc_game(&dylib);
+    let state = core.serialize().expect("serialize");
+    assert_eq!(state.len(), PCSX_STATE_BYTES + 12);
+    assert_eq!(&state[PCSX_STATE_BYTES..PCSX_STATE_BYTES + 8], b"SLOTPSX1");
+    assert_eq!(state[PCSX_STATE_BYTES + 8..], 0u32.to_le_bytes());
+    core.next_disc();
+    core.take_disc_event();
+    assert_eq!(core.disc_index(), 1);
+    core.unserialize(&state).expect("unserialize");
+    assert_eq!(core.disc_index(), 0);
+    assert_eq!(core.take_disc_event(), Some(DiscEvent::Restored(0)));
+}
+
+#[test]
+fn a_state_with_no_trailer_is_left_to_the_core_and_slot_swaps_nothing() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let (_root, mut core) = two_disc_game(&dylib);
+    let state = core.serialize().expect("serialize");
+    core.next_disc();
+    core.take_disc_event();
+    core.unserialize(&state[..PCSX_STATE_BYTES])
+        .expect("a state from before the trailer");
+    assert_eq!(core.take_disc_event(), None);
+    assert_eq!(
+        core.disc_index(),
+        0,
+        "pcsx records its own disc in the state"
+    );
+}
+
+#[test]
+fn a_trailer_of_an_unknown_version_is_refused() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let (_root, mut core) = two_disc_game(&dylib);
+    let mut state = core.serialize().expect("serialize");
+    state[PCSX_STATE_BYTES + 7] = b'2';
+    assert!(core.unserialize(&state).is_err());
+    assert_eq!(core.take_disc_event(), Some(DiscEvent::NewerState));
+    assert_eq!(core.disc_index(), 0);
+}
+
+#[test]
+fn a_single_disc_state_is_exactly_the_cores_bytes() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let root = common::tmp_root_with_real_carts(&[]);
+    let cue = disc(&root.path().join("Games/PS1"), "Single");
+    let mut core = opened(&dylib, root.path());
+    core.load(&cue).expect("load");
+    run(&mut core, 10);
+    assert_eq!(core.disc_count(), 1);
+    assert_eq!(core.serialize().expect("serialize").len(), PCSX_STATE_BYTES);
+    core.next_disc();
+    assert_eq!(core.take_disc_event(), None);
+}
+
+#[test]
+fn a_missing_or_corrupt_disc_file_means_disc_one() {
+    let root = tempfile::tempdir().expect("tempdir");
+    assert_eq!(remembered_disc(root.path(), STEM, 2), 0);
+    for text in ["", "two", "-1", "2", "7\n"] {
+        std::fs::create_dir_all(disc_file(root.path(), STEM).parent().expect("dir")).expect("dir");
+        std::fs::write(disc_file(root.path(), STEM), text).expect("write");
+        assert_eq!(remembered_disc(root.path(), STEM, 2), 0, "{text:?}");
+    }
+    remember_disc(root.path(), STEM, 1).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(root.path().join("Saves/PS1/Game.disc")).expect("read"),
+        "1\n"
+    );
+    assert_eq!(remembered_disc(root.path(), STEM, 2), 1);
+}
+
+#[test]
+fn the_disc_toasts_follow_the_retro_banners_and_read_plainly() {
+    let every = Toast::every();
+    for (i, d) in DiscToast::ALL.into_iter().enumerate() {
+        let t = Toast::Disc(d);
+        assert_eq!(every.get(t.index()), Some(&t), "{d:?}");
+        assert_eq!(t.index(), every.len() - DiscToast::ALL.len() + i);
+    }
+    assert_eq!(Toast::Disc(DiscToast::Inserted(1)).text(), "Disc 2");
+    assert_eq!(DiscToast::inserted(7), Some(DiscToast::Inserted(7)));
+    assert_eq!(DiscToast::inserted(8), None);
+    assert_eq!(Toast::Disc(DiscToast::Refused).text(), "Disc swap failed");
+}
+
+fn seated_two_disc_game(dylib: &Path) -> tempfile::TempDir {
+    let root = common::tmp_root_with_real_carts(&[]);
+    two_discs(&root.path().join("Games/PS1"), STEM);
+    std::os::unix::fs::symlink(
+        std::fs::canonicalize(dylib).expect("core path"),
+        root.path()
+            .join("System")
+            .join(dylib_name(Core::PcsxRearmed)),
+    )
+    .expect("link core");
+    common::clocked(root.path());
+    root
+}
+
+#[test]
+fn select_l2_in_a_two_disc_game_swaps_the_disc_and_remembers_it() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let root = seated_two_disc_game(&dylib);
+    remember_disc(root.path(), STEM, 1).expect("start on disc 2");
+    let mut session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().playing_platform(), Platform::Ps1);
+    session.feed([RawEvent::Down(Btn::Select)], 5000);
+    session.feed([RawEvent::Down(Btn::L2)], 5016);
+    session.feed([RawEvent::Up(Btn::L2)], 5100);
+    session.feed([RawEvent::Up(Btn::Select)], 5116);
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while std::fs::read_to_string(disc_file(root.path(), STEM))
+        .ok()
+        .as_deref()
+        != Some("0\n")
+    {
+        assert!(
+            Instant::now() < deadline,
+            "the swap to disc 1 was never remembered"
+        );
+        session.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+
+#[test]
+fn a_disc_interface_on_a_platform_that_swaps_no_discs_is_never_used() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let root = common::tmp_root_with_real_carts(&[]);
+    let m3u = two_discs(&root.path().join("Games/PS1"), STEM);
+    let mut core = LibretroCore::open_with(
+        &dylib,
+        &slot::root::bios_dir(root.path()),
+        &slot::root::saves_dir(root.path()),
+    )
+    .expect("open pcsx");
+    core.set_option("pcsx_rearmed_bios", "HLE");
+    core.load(&m3u).expect("load the playlist");
+    run(&mut core, 10);
+    assert_eq!(core.disc_count(), 0);
+    assert_eq!(core.serialize().expect("serialize").len(), PCSX_STATE_BYTES);
+    core.next_disc();
+    assert_eq!(core.take_disc_event(), None);
+    assert!(!Platform::Md.swaps_discs() && !Platform::Nes.swaps_discs());
+}
