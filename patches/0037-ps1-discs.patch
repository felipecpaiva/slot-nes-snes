diff --git a/crates/slot-retro/src/libretro/discs.rs b/crates/slot-retro/src/libretro/discs.rs
new file mode 100644
index 0000000..65e8e67
--- /dev/null
+++ b/crates/slot-retro/src/libretro/discs.rs
@@ -0,0 +1,254 @@
+use std::ffi::{c_char, c_uint, c_void, CString};
+use std::path::Path;
+
+use super::{Active, LibretroCore};
+use crate::canvas::{self, ExtraGuard};
+use crate::core::CoreError;
+use crate::ffi::GameInfo;
+
+pub const SET_DISK_CONTROL_INTERFACE: c_uint = 13;
+pub const GET_DISK_CONTROL_INTERFACE_VERSION: c_uint = 57;
+pub const SET_DISK_CONTROL_EXT_INTERFACE: c_uint = 58;
+
+pub const MOST_DISCS: u32 = 8;
+pub const TRAILER_MAGIC: &[u8; 7] = b"SLOTPSX";
+pub const TRAILER_VERSION: u8 = b'1';
+pub const TRAILER_BYTES: usize = 12;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum DiscEvent {
+    Swapped(u32),
+    Restored(u32),
+    Refused,
+    NewerState,
+}
+
+#[repr(C)]
+#[derive(Copy, Clone)]
+struct DiskControl {
+    set_eject_state: Option<unsafe extern "C" fn(bool) -> bool>,
+    _get_eject_state: Option<unsafe extern "C" fn() -> bool>,
+    get_image_index: Option<unsafe extern "C" fn() -> c_uint>,
+    set_image_index: Option<unsafe extern "C" fn(c_uint) -> bool>,
+    get_num_images: Option<unsafe extern "C" fn() -> c_uint>,
+    _replace_image_index: Option<unsafe extern "C" fn(c_uint, *const GameInfo) -> bool>,
+    _add_image_index: Option<unsafe extern "C" fn() -> bool>,
+}
+
+#[repr(C)]
+#[derive(Copy, Clone)]
+struct DiskControlExt {
+    legacy: DiskControl,
+    set_initial_image: Option<unsafe extern "C" fn(c_uint, *const c_char) -> bool>,
+    _get_image_path: Option<unsafe extern "C" fn(c_uint, *mut c_char, usize) -> bool>,
+    _get_image_label: Option<unsafe extern "C" fn(c_uint, *mut c_char, usize) -> bool>,
+}
+
+#[derive(Default)]
+pub struct DiscDrive {
+    in_use: bool,
+    control: Option<DiskControl>,
+    set_initial_image: Option<unsafe extern "C" fn(c_uint, *const c_char) -> bool>,
+    initial: Option<(c_uint, CString)>,
+    event: Option<DiscEvent>,
+}
+
+pub unsafe fn env(cmd: c_uint, data: *mut c_void) -> bool {
+    match cmd {
+        GET_DISK_CONTROL_INTERFACE_VERSION => {
+            let Some(version) = (data as *mut c_uint).as_mut() else {
+                return false;
+            };
+            *version = 1;
+            true
+        }
+        SET_DISK_CONTROL_INTERFACE => {
+            let control = (data as *const DiskControl).as_ref().copied();
+            canvas::with_extra(|e| {
+                e.discs.control = control;
+                e.discs.set_initial_image = None;
+            })
+            .is_some()
+        }
+        SET_DISK_CONTROL_EXT_INTERFACE => {
+            let ext = (data as *const DiskControlExt).as_ref().copied();
+            canvas::with_extra(|e| {
+                e.discs.control = ext.map(|x| x.legacy);
+                e.discs.set_initial_image = ext.and_then(|x| x.set_initial_image);
+            })
+            .is_some()
+        }
+        _ => false,
+    }
+}
+
+impl LibretroCore {
+    pub fn use_disc_drive(&mut self) {
+        self.extra.discs.in_use = true;
+    }
+
+    fn drive(&self) -> Option<DiskControl> {
+        self.extra.discs.control.filter(|_| self.extra.discs.in_use)
+    }
+
+    fn with_drive<R>(&mut self, f: impl FnOnce(&DiskControl) -> R) -> Option<R> {
+        let control = self.drive()?;
+        let _a = Active::bind(&mut self.host);
+        let _e = ExtraGuard::bind(&mut self.extra);
+        Some(f(&control))
+    }
+
+    pub fn disc_count(&mut self) -> u32 {
+        self.with_drive(|c| {
+            // SAFETY: the core registered this getter through the disk-control interface and is loaded.
+            c.get_num_images.map(|f| unsafe { f() })
+        })
+        .flatten()
+        .unwrap_or(0)
+    }
+
+    pub fn disc_index(&mut self) -> u32 {
+        self.with_drive(|c| {
+            // SAFETY: the core registered this getter through the disk-control interface and is loaded.
+            c.get_image_index.map(|f| unsafe { f() })
+        })
+        .flatten()
+        .unwrap_or(0)
+    }
+
+    pub fn swap_disc(&mut self, index: u32) -> Result<(), CoreError> {
+        let count = self.disc_count();
+        if index >= count.min(MOST_DISCS) {
+            return Err(CoreError::State(format!(
+                "disc {} is out of range, the game has {count}",
+                u64::from(index) + 1
+            )));
+        }
+        let old = self.disc_index();
+        let swapped = self.with_drive(|c| {
+            let (Some(eject), Some(set)) = (c.set_eject_state, c.set_image_index) else {
+                return false;
+            };
+            // SAFETY: the core registered both callbacks and is loaded; the tray is closed again on every path.
+            unsafe {
+                eject(true);
+                let swapped = set(index);
+                if !swapped {
+                    set(old);
+                }
+                eject(false);
+                swapped
+            }
+        });
+        match swapped {
+            Some(true) => Ok(()),
+            _ => Err(CoreError::State(format!(
+                "the core refused disc {}, disc {} stays in",
+                index + 1,
+                old + 1
+            ))),
+        }
+    }
+
+    pub fn next_disc(&mut self) {
+        let count = self.disc_count();
+        if count < 2 {
+            eprintln!("slot: disc: this game has {count} disc, nothing to swap");
+            return;
+        }
+        let next = (self.disc_index() + 1) % count;
+        self.extra.discs.event = Some(match self.swap_disc(next) {
+            Ok(()) => {
+                eprintln!("slot: disc: swapped to disc {} of {count}", next + 1);
+                DiscEvent::Swapped(next)
+            }
+            Err(e) => {
+                eprintln!("slot: disc: {e}");
+                DiscEvent::Refused
+            }
+        });
+    }
+
+    pub fn set_initial_disc(&mut self, index: u32, path: &Path) {
+        match CString::new(path.as_os_str().as_encoded_bytes()) {
+            Ok(path) => self.extra.discs.initial = Some((index, path)),
+            Err(_) => eprintln!("slot: disc: {} contains a nul", path.display()),
+        }
+    }
+
+    pub(super) fn offer_initial_disc(&mut self) {
+        let Some((index, path)) = self.extra.discs.initial.take() else {
+            return;
+        };
+        let Some(set) = self
+            .extra
+            .discs
+            .set_initial_image
+            .filter(|_| self.extra.discs.in_use)
+        else {
+            eprintln!("slot: disc: the core takes no initial disc, starting on disc 1");
+            return;
+        };
+        let _a = Active::bind(&mut self.host);
+        let _e = ExtraGuard::bind(&mut self.extra);
+        // SAFETY: the core registered set_initial_image through the EXT interface; it copies the path before returning.
+        if !unsafe { set(index, path.as_ptr()) } {
+            eprintln!(
+                "slot: disc: the core refused disc {} to start on",
+                u64::from(index) + 1
+            );
+        }
+    }
+
+    pub fn take_disc_event(&mut self) -> Option<DiscEvent> {
+        self.extra.discs.event.take()
+    }
+
+    pub(super) fn with_disc_trailer(&mut self, mut state: Vec<u8>) -> Vec<u8> {
+        if self.disc_count() < 2 {
+            return state;
+        }
+        let index = self.disc_index();
+        state.extend_from_slice(TRAILER_MAGIC);
+        state.push(TRAILER_VERSION);
+        state.extend_from_slice(&index.to_le_bytes());
+        state
+    }
+
+    pub(super) fn without_disc_trailer<'a>(
+        &mut self,
+        data: &'a [u8],
+    ) -> Result<&'a [u8], CoreError> {
+        if self.drive().is_none() {
+            return Ok(data);
+        }
+        let Some(at) = data.len().checked_sub(TRAILER_BYTES) else {
+            return Ok(data);
+        };
+        let (state, trailer) = data.split_at(at);
+        let (magic, rest) = trailer.split_at(TRAILER_MAGIC.len());
+        if magic != TRAILER_MAGIC {
+            return Ok(data);
+        }
+        let (version, index) = rest.split_at(1);
+        if version != [TRAILER_VERSION] {
+            self.extra.discs.event = Some(DiscEvent::NewerState);
+            return Err(CoreError::State(format!(
+                "the state's disc trailer is version {}, slot reads version 1",
+                String::from_utf8_lossy(version)
+            )));
+        }
+        let mut le = [0u8; 4];
+        le.copy_from_slice(index);
+        let index = u32::from_le_bytes(le);
+        if index != self.disc_index() {
+            if let Err(e) = self.swap_disc(index) {
+                self.extra.discs.event = Some(DiscEvent::Refused);
+                return Err(e);
+            }
+            eprintln!("slot: disc: the state swapped to disc {}", index + 1);
+            self.extra.discs.event = Some(DiscEvent::Restored(index));
+        }
+        Ok(state)
+    }
+}
