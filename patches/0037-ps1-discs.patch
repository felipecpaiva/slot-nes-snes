index 0000000..e917714
--- /dev/null
+++ b/crates/slot-ui/src/disc_toast.rs
@@ -0,0 +1,44 @@
+const INSERTED: [&str; 8] = [
+    "Disc 1", "Disc 2", "Disc 3", "Disc 4", "Disc 5", "Disc 6", "Disc 7", "Disc 8",
+];
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum DiscToast {
+    Inserted(u8),
+    Refused,
+    NewerState,
+}
+
+impl DiscToast {
+    pub const ALL: [DiscToast; 10] = [
+        DiscToast::Inserted(0),
+        DiscToast::Inserted(1),
+        DiscToast::Inserted(2),
+        DiscToast::Inserted(3),
+        DiscToast::Inserted(4),
+        DiscToast::Inserted(5),
+        DiscToast::Inserted(6),
+        DiscToast::Inserted(7),
+        DiscToast::Refused,
+        DiscToast::NewerState,
+    ];
+
+    pub fn inserted(index: u32) -> Option<DiscToast> {
+        u8::try_from(index)
+            .ok()
+            .filter(|i| usize::from(*i) < INSERTED.len())
+            .map(DiscToast::Inserted)
+    }
+
+    pub fn index(self) -> usize {
+        Self::ALL.iter().position(|t| *t == self).unwrap_or(0)
+    }
+
+    pub fn text(self) -> &'static str {
+        match self {
+            DiscToast::Inserted(i) => INSERTED.get(usize::from(i)).copied().unwrap_or("Disc"),
+            DiscToast::Refused => "Disc swap failed",
+            DiscToast::NewerState => "State needs a newer slot",
+        }
+    }
+}
