--- /dev/null
+++ b/crates/slot/src/app/shelf_order.rs
@@ -0,0 +1,24 @@
+use crate::shelf_order::ShelfOrder;
+
+use super::{App, Rack};
+
+impl App {
+    pub(super) fn arrange_shelves(&mut self, order: ShelfOrder) {
+        let platforms = order.platforms();
+        self.shelves.sort_by_key(|(rack, _)| match rack {
+            Rack::Recents => 0,
+            Rack::Favorites => 1,
+            Rack::Of(p) => {
+                2 + platforms
+                    .iter()
+                    .position(|q| q == p)
+                    .unwrap_or(platforms.len())
+            }
+        });
+        self.shelf_at = self
+            .shelves
+            .iter()
+            .position(|(_, s)| !s.carts.is_empty())
+            .unwrap_or(0);
+    }
+}
