diff --git a/crates/slot-retro/src/pad_names.rs b/crates/slot-retro/src/pad_names.rs
new file mode 100644
index 0000000..c2d6a87
--- /dev/null
+++ b/crates/slot-retro/src/pad_names.rs
@@ -0,0 +1,44 @@
+use std::ffi::{c_char, c_uint, c_void, CStr};
+
+use crate::canvas::with_extra;
+use crate::ffi::DEVICE_JOYPAD;
+
+pub const SET_INPUT_DESCRIPTORS: c_uint = 11;
+
+#[repr(C)]
+struct InputDescriptor {
+    port: c_uint,
+    device: c_uint,
+    index: c_uint,
+    id: c_uint,
+    description: *const c_char,
+}
+
+pub unsafe fn names_set(data: *const c_void) -> bool {
+    if data.is_null() {
+        return false;
+    }
+    let mut names: Vec<(u32, String)> = Vec::new();
+    let mut p = data as *const InputDescriptor;
+    for _ in 0..1024 {
+        let d = &*p;
+        if d.description.is_null() {
+            break;
+        }
+        let first = !names.iter().any(|(id, _)| *id == d.id);
+        if d.port == 0 && d.device == DEVICE_JOYPAD && d.index == 0 && d.id < 16 && first {
+            if let Ok(text) = CStr::from_ptr(d.description).to_str() {
+                names.push((d.id, text.to_string()));
+            }
+        }
+        p = p.add(1);
+    }
+    with_extra(|e| e.pad_names = names).is_some()
+}
+
+pub fn polled(port: c_uint, id: c_uint) {
+    if port != 0 || id >= 16 {
+        return;
+    }
+    with_extra(|e| e.polled |= 1 << id);
+}
