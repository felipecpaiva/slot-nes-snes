diff --git a/crates/slot/src/fds_disk.rs b/crates/slot/src/fds_disk.rs
new file mode 100644
index 0000000..11ac8f7
--- /dev/null
+++ b/crates/slot/src/fds_disk.rs
@@ -0,0 +1,98 @@
+use std::sync::atomic::{AtomicU32, Ordering};
+
+use slot_retro::{ButtonMask, DiscEvent, RetroCore};
+use slot_store::Platform;
+
+pub const SIDE_BYTES: usize = 65_500;
+pub const EJECTED: u8 = 255;
+pub const EJECT_AT: u32 = 0;
+pub const SELECT_AT: u32 = 2;
+pub const INSERT_AT: u32 = 60;
+pub const FRAMES: u32 = INSERT_AT + 2;
+
+const SKIP_EJECT: u32 = 1 << 31;
+
+pub fn flips(platform: Platform) -> bool {
+    platform == Platform::Fds
+}
+
+pub fn sides(core: &dyn RetroCore) -> usize {
+    core.save_ram().map_or(0, |d| d.len() / SIDE_BYTES)
+}
+
+pub fn chunk(state: &[u8], tag: &[u8; 4]) -> Option<u8> {
+    let mut at = 16;
+    while let (Some(_kind), Some(size)) = (state.get(at), word(state, at + 1)) {
+        let end = (at + 5).checked_add(size)?;
+        let mut entry = at + 5;
+        while entry + 8 <= end {
+            let len = word(state, entry + 4)?;
+            if state.get(entry..entry + 4)? == tag {
+                return (len == 1).then(|| state.get(entry + 8).copied())?;
+            }
+            entry = entry.checked_add(8 + len)?;
+        }
+        at = end;
+    }
+    None
+}
+
+fn word(state: &[u8], at: usize) -> Option<usize> {
+    let b = state.get(at..at + 4)?;
+    Some(u32::from_le_bytes([b[0], b[1], b[2], b[3]]) as usize)
+}
+
+pub fn start(flip: &AtomicU32, core: &mut dyn RetroCore) {
+    if flip.load(Ordering::Relaxed) != 0 {
+        return;
+    }
+    if sides(core) < 2 {
+        eprintln!("slot: fds: this disk has one side, nothing to flip");
+        return;
+    }
+    let inserted = core
+        .serialize()
+        .ok()
+        .and_then(|s| chunk(&s, b"INDI"))
+        .is_none_or(|d| d != EJECTED);
+    let skip = if inserted { 0 } else { SKIP_EJECT };
+    flip.store(skip | FRAMES, Ordering::Relaxed);
+}
+
+pub fn press(flip: &AtomicU32, input: ButtonMask) -> (ButtonMask, bool) {
+    let left = flip.load(Ordering::Relaxed);
+    if left == 0 {
+        return (input, false);
+    }
+    let frames = left & !SKIP_EJECT;
+    let frame = FRAMES - frames;
+    let held = match frame {
+        EJECT_AT if left & SKIP_EJECT == 0 => ButtonMask::R,
+        SELECT_AT => ButtonMask::L,
+        INSERT_AT => ButtonMask::R,
+        _ => 0,
+    };
+    let next = frames - 1;
+    flip.store(
+        if next == 0 {
+            0
+        } else {
+            (left & SKIP_EJECT) | next
+        },
+        Ordering::Relaxed,
+    );
+    let shoulders = ButtonMask::L | ButtonMask::R;
+    (ButtonMask((input.0 & !shoulders) | held), next == 0)
+}
+
+pub fn flipped(core: &mut dyn RetroCore) -> Option<DiscEvent> {
+    let state = core.serialize().ok()?;
+    let side = chunk(&state, b"SELD")?;
+    eprintln!(
+        "slot: fds: disk {} side {} of {} sides",
+        side / 2 + 1,
+        if side % 2 == 0 { 'A' } else { 'B' },
+        sides(core)
+    );
+    Some(DiscEvent::Side(side))
+}
