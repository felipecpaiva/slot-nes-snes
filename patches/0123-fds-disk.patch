diff --git a/crates/slot/tests/fds_core.rs b/crates/slot/tests/fds_core.rs
new file mode 100644
index 0000000..0de2a9e
--- /dev/null
+++ b/crates/slot/tests/fds_core.rs
@@ -0,0 +1,211 @@
+// fceumm runs the Famicom Disk System (ADR 0101). The disk is a generated one: block 1 and the
+// *NINTENDO-HVC* mark on every side, the rest zero, so it never boots a game. Under an 8 KB
+// placeholder BIOS (zeros, not the real ROM) the core still loads it, exposes the disk as save RAM
+// and runs the disk drive, which is all these tests need. Tests that boot through the real BIOS read
+// it from SLOT_FDS_BIOS and print a BIOS skip without it.
+mod common;
+mod core_common;
+mod fds_common;
+
+use std::path::Path;
+
+use common::core_lock;
+use fds_common::{disk, disk_bytes, fds_bios, placeholder_bios, put_bios, side, SIDE};
+use slot::fds_disk::{chunk, flipped, press, start, EJECTED, FRAMES, INSERT_AT};
+use slot_retro::{ButtonMask, DiscEvent, LibretroCore, RetroCore};
+use std::sync::atomic::AtomicU32;
+
+fn opened(root: &Path) -> Option<LibretroCore> {
+    let dylib = fds_common::fceumm()?;
+    std::fs::create_dir_all(slot::root::saves_dir(root)).unwrap();
+    std::fs::create_dir_all(slot::root::bios_dir(root)).unwrap();
+    Some(
+        LibretroCore::open_with(
+            &dylib,
+            &slot::root::bios_dir(root),
+            &slot::root::saves_dir(root),
+        )
+        .expect("open fceumm"),
+    )
+}
+
+fn loaded(root: &Path, sides: u8, headered: bool) -> Option<LibretroCore> {
+    put_bios(root, &placeholder_bios());
+    let mut core = opened(root)?;
+    core.load(&disk(&root.join("Games/FDS"), "Disk", sides, headered))
+        .expect("load the disk");
+    core.run_frame(ButtonMask::default());
+    Some(core)
+}
+
+fn drive(core: &mut LibretroCore) -> (u8, u8) {
+    let state = core.serialize().expect("state");
+    (
+        chunk(&state, b"SELD").expect("SELD"),
+        chunk(&state, b"INDI").expect("INDI"),
+    )
+}
+
+fn flip(core: &mut LibretroCore) -> Option<DiscEvent> {
+    let at = AtomicU32::new(0);
+    start(&at, core);
+    let mut event = None;
+    for _ in 0..FRAMES {
+        let (input, done) = press(&at, ButtonMask::default());
+        core.run_frame(input);
+        if done {
+            event = flipped(core);
+        }
+    }
+    event
+}
+
+#[test]
+fn a_disk_without_disksys_rom_does_not_load() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = opened(d.path()) else {
+        return;
+    };
+    let rom = disk(&d.path().join("Games/FDS"), "Disk", 2, true);
+    assert!(core.load(&rom).is_err());
+}
+
+#[test]
+fn the_save_ram_is_the_whole_disk_without_the_fwnes_header() {
+    let _g = core_lock();
+    for headered in [true, false] {
+        let d = tempfile::tempdir().unwrap();
+        let Some(core) = loaded(d.path(), 2, headered) else {
+            return;
+        };
+        let ram = core.save_ram().expect("save ram");
+        assert_eq!(ram.len(), 2 * SIDE, "headered {headered}");
+        assert_eq!(ram, [side(0), side(1)].concat(), "headered {headered}");
+    }
+}
+
+#[test]
+fn a_disk_starts_on_side_a_inserted() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = loaded(d.path(), 2, true) else {
+        return;
+    };
+    assert_eq!(drive(&mut core), (0, 0));
+}
+
+#[test]
+fn a_flip_ejects_the_disk_for_a_second_then_inserts_the_next_side() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = loaded(d.path(), 2, true) else {
+        return;
+    };
+    let at = AtomicU32::new(0);
+    start(&at, &mut core);
+    for frame in 0..FRAMES {
+        let (input, _) = press(&at, ButtonMask::default());
+        core.run_frame(input);
+        let (_, inserted) = drive(&mut core);
+        if frame < INSERT_AT {
+            assert_eq!(inserted, EJECTED, "frame {frame}");
+        } else {
+            assert_eq!(inserted, 1, "frame {frame}");
+        }
+    }
+    assert_eq!(drive(&mut core), (1, 1));
+    assert_eq!(
+        press(&at, ButtonMask(ButtonMask::L)).0,
+        ButtonMask(ButtonMask::L)
+    );
+}
+
+#[test]
+fn flips_walk_every_side_of_every_disk_and_come_back_to_the_first() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = loaded(d.path(), 4, true) else {
+        return;
+    };
+    let mut seen = Vec::new();
+    for _ in 0..4 {
+        match flip(&mut core) {
+            Some(DiscEvent::Side(s)) => seen.push(s),
+            other => panic!("{other:?}"),
+        }
+    }
+    assert_eq!(seen, [1, 2, 3, 0]);
+}
+
+#[test]
+fn a_one_sided_disk_is_never_flipped() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = loaded(d.path(), 1, true) else {
+        return;
+    };
+    let at = AtomicU32::new(0);
+    start(&at, &mut core);
+    assert_eq!(
+        press(&at, ButtonMask::default()),
+        (ButtonMask::default(), false)
+    );
+    assert_eq!(drive(&mut core), (0, 0));
+}
+
+#[test]
+fn a_state_keeps_the_side_that_was_in_the_drive() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = loaded(d.path(), 2, true) else {
+        return;
+    };
+    flip(&mut core);
+    let state = core.serialize().unwrap();
+    drop(core);
+    let e = tempfile::tempdir().unwrap();
+    let Some(mut again) = loaded(e.path(), 2, true) else {
+        return;
+    };
+    assert_eq!(drive(&mut again), (0, 0));
+    again.unserialize(&state).unwrap();
+    assert_eq!(drive(&mut again), (1, 1));
+    assert_eq!(flip(&mut again), Some(DiscEvent::Side(0)));
+}
+
+#[test]
+fn a_written_back_save_changes_the_disk_and_never_the_file() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = loaded(d.path(), 2, true) else {
+        return;
+    };
+    let mut changed = [side(0), side(1)].concat();
+    changed[SIDE + 0x100] = 0x5a;
+    core.load_save_ram(&changed).unwrap();
+    assert_eq!(core.save_ram().unwrap(), changed);
+    let file = std::fs::read(d.path().join("Games/FDS/Disk.fds")).unwrap();
+    assert_eq!(file, disk_bytes(2, true));
+}
+
+#[test]
+fn the_real_bios_draws_its_title_screen() {
+    let Some(bios) = fds_bios() else {
+        return;
+    };
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    put_bios(d.path(), &bios);
+    let Some(mut core) = opened(d.path()) else {
+        return;
+    };
+    core.load(&disk(&d.path().join("Games/FDS"), "Disk", 2, true))
+        .unwrap();
+    for _ in 0..120 {
+        core.run_frame(ButtonMask::default());
+    }
+    let video = core.video_xrgb8888();
+    let first = video.get(..4).unwrap().to_vec();
+    assert!(video.chunks_exact(4).any(|p| p != first.as_slice()));
+}
