+use crate::Toast;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum ArcadeToast {
+    NeedsNeoGeoBios,
+}
+
+impl ArcadeToast {
+    pub const ALL: [ArcadeToast; 1] = [ArcadeToast::NeedsNeoGeoBios];
+
+    pub fn index(self) -> usize {
+        Self::ALL.iter().position(|t| *t == self).unwrap_or(0)
+    }
+
+    pub fn text(self) -> &'static str {
+        match self {
+            ArcadeToast::NeedsNeoGeoBios => "Neo Geo needs BIOS/neogeo.zip",
+        }
+    }
+}
+
+impl Toast {
+    pub fn arcade_index(a: ArcadeToast) -> usize {
+        Toast::lynx_index(crate::LynxToast::ALL[0]) + crate::LynxToast::ALL.len() + a.index()
+    }
+}
