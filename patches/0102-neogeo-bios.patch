@@ -0,0 +1,23 @@
+use slot_store::Platform;
+use slot_ui::{ArcadeToast, Toast};
+
+use super::App;
+
+impl App {
+    pub(super) fn neogeo_bios_allows(&mut self, platform: Platform) -> bool {
+        if platform != Platform::NeoGeo {
+            return true;
+        }
+        let Some(root) = self.root.as_deref() else {
+            return true;
+        };
+        if slot_store::arcade::has_neogeo_bios(&crate::root::bios_dir(root)) {
+            return true;
+        }
+        eprintln!("slot: neogeo: no usable BIOS/neogeo.zip, not launching");
+        self.hud
+            .toast(Toast::Arcade(ArcadeToast::NeedsNeoGeoBios), self.now());
+        self.refuse();
+        false
+    }
+}
diff --git a/crates/slot/tests/arcade_bios.rs b/crates/slot/tests/arcade_bios.rs
new file mode 100644
index 0000000..c3062e1
--- /dev/null
+++ b/crates/slot/tests/arcade_bios.rs
@@ -0,0 +1,105 @@
+// Neo Geo sets need BIOS/neogeo.zip, which slot never ships or fetches (ADR 0097). Without it FBNeo
+// loads the set and shows its missing-ROM page, so slot checks before the cart is inserted.
+mod arcade_common;
+mod common;
+mod core_common;
+
+use std::path::Path;
+
+use common::tmp_root_with_carts;
+use slot::app::{App, Phase};
+use slot_input::{Action, Btn};
+use slot_store::{write_slot_state, Platform, SlotState};
+use slot_ui::{ArcadeToast, LynxToast, Toast};
+use tempfile::TempDir;
+
+fn card(shelf: &str, set: &str, bios: bool) -> TempDir {
+    let d = tmp_root_with_carts(&[]);
+    let dir = d.path().join("Games").join(shelf);
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join(format!("{set}.zip")), b"PK\x05\x06").unwrap();
+    if bios {
+        arcade_common::install_neogeo_bios(d.path());
+    }
+    d
+}
+
+fn boot_on(root: &Path, cart: Option<(&str, Platform)>) -> App {
+    write_slot_state(
+        root,
+        &SlotState {
+            clock_set: true,
+            cart: cart.map(|(c, _)| c.to_string()),
+            cart_platform: cart.map(|(_, p)| p),
+            ..SlotState::default()
+        },
+    )
+    .expect("write slot.state");
+    App::boot(root)
+}
+
+fn insert(a: &mut App) {
+    a.apply(Action::GbaDown(Btn::A));
+    a.apply(Action::GbaUp(Btn::A));
+    for _ in 0..10 {
+        a.update(1.0 / 60.0);
+    }
+}
+
+fn inserting(a: &App) -> bool {
+    matches!(a.phase(), Phase::Inserting { .. } | Phase::Playing { .. })
+}
+
+#[test]
+fn without_the_neo_geo_bios_a_neo_geo_set_stays_on_the_shelf_with_a_toast() {
+    let d = card("NEOGEO", "mslug", false);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Arcade(ArcadeToast::NeedsNeoGeoBios)));
+    assert_eq!(
+        Toast::Arcade(ArcadeToast::NeedsNeoGeoBios).text(),
+        "Neo Geo needs BIOS/neogeo.zip"
+    );
+}
+
+#[test]
+fn a_neo_geo_set_resumed_at_boot_is_checked_too() {
+    let d = card("NEOGEO", "mslug", false);
+    let a = boot_on(d.path(), Some(("mslug", Platform::NeoGeo)));
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Arcade(ArcadeToast::NeedsNeoGeoBios)));
+}
+
+#[test]
+fn with_the_bios_a_neo_geo_set_launches_with_no_toast() {
+    let d = card("NEOGEO", "mslug", true);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn cps_sets_need_no_bios() {
+    for (shelf, set) in [("CPS1", "ffight"), ("CPS2", "ssf2t")] {
+        let d = card(shelf, set, false);
+        let mut a = boot_on(d.path(), None);
+        insert(&mut a);
+        assert!(inserting(&a), "{shelf} {:?}", a.phase());
+        assert_eq!(a.toast(), None);
+    }
+}
+
+#[test]
+fn the_arcade_toast_uploads_in_its_own_place_after_the_lynx_ones() {
+    let every = Toast::every();
+    for t in ArcadeToast::ALL {
+        let t = Toast::Arcade(t);
+        assert_eq!(every.get(t.index()), Some(&t), "{t:?}");
+    }
+    assert_eq!(
+        Toast::Arcade(ArcadeToast::ALL[0]).index(),
+        Toast::Lynx(LynxToast::ALL[LynxToast::ALL.len() - 1]).index() + 1
+    );
+}
