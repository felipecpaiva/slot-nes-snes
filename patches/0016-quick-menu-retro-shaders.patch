diff --git a/crates/slot/src/retro_quick.rs b/crates/slot/src/retro_quick.rs
new file mode 100644
index 0000000..845d964
--- /dev/null
+++ b/crates/slot/src/retro_quick.rs
@@ -0,0 +1,40 @@
+use slot_store::{Platform, Shader, SlotState};
+use slot_ui::QuickRow;
+
+pub fn step(state: &mut SlotState, row: QuickRow, right: bool) {
+    let shader = match row {
+        QuickRow::NesShader => &mut state.shader_nes,
+        QuickRow::SnesShader => &mut state.shader_snes,
+        _ => return,
+    };
+    *shader = shader.step(&Shader::RETRO, right);
+}
+
+pub fn hidden_in_game(
+    platform: Platform,
+    framed: bool,
+    single: bool,
+) -> Option<&'static [QuickRow]> {
+    match platform {
+        Platform::Gba | Platform::Gb | Platform::Gbc => None,
+        Platform::Nes | Platform::Snes => Some(match (framed, single) {
+            (true, false) => &[QuickRow::ColourCorrection, QuickRow::Palette],
+            (true, true) => &[
+                QuickRow::ColourCorrection,
+                QuickRow::Palette,
+                QuickRow::ExitGame,
+            ],
+            (false, false) => &[
+                QuickRow::ColourCorrection,
+                QuickRow::Palette,
+                QuickRow::Bezel,
+            ],
+            (false, true) => &[
+                QuickRow::ColourCorrection,
+                QuickRow::Palette,
+                QuickRow::Bezel,
+                QuickRow::ExitGame,
+            ],
+        }),
+    }
+}
diff --git a/crates/slot/tests/quick_retro_shader.rs b/crates/slot/tests/quick_retro_shader.rs
new file mode 100644
index 0000000..9afc80c
--- /dev/null
+++ b/crates/slot/tests/quick_retro_shader.rs
@@ -0,0 +1,145 @@
+mod common;
+
+use common::{boot, tmp_root_with_real_carts, write_gb_cart};
+use slot::app::{App, Phase};
+use slot_input::{Action, Btn};
+use slot_store::{read_slot_state, Platform, Shader, SlotState};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn shelves() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    write_gb_cart(&root, "Tetris", "TETRIS");
+    for platform in [Platform::Nes, Platform::Snes] {
+        let cart = root
+            .path()
+            .join("Games")
+            .join(platform.dir_name())
+            .join(format!("Zelda.{}", platform.extensions()[0]));
+        std::fs::write(cart, vec![0u8; 0x200]).expect("write cart");
+    }
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn on_shelf(platform: Platform) -> (TempDir, App) {
+    let (root, mut app) = shelves();
+    for _ in 0..5 {
+        if app.shelf_platform_name() == Some(platform.name()) {
+            break;
+        }
+        press(&mut app, Btn::R1);
+    }
+    assert_eq!(app.shelf_platform_name(), Some(platform.name()));
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_screen(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::Screen));
+    press(app, Btn::A);
+}
+
+type ShaderRow = (Platform, QuickRow, fn(&SlotState) -> Shader);
+
+fn shader_rows() -> [ShaderRow; 2] {
+    [
+        (Platform::Nes, QuickRow::NesShader, |s| s.shader_nes),
+        (Platform::Snes, QuickRow::SnesShader, |s| s.shader_snes),
+    ]
+}
+
+#[test]
+fn the_nes_and_snes_shelves_open_their_own_shader_row_alone() {
+    for (platform, row, _) in shader_rows() {
+        let (_root, mut app) = on_shelf(platform);
+        open_screen(&mut app);
+        assert_eq!(app.quick_menu(), Some(row), "{platform:?}");
+        assert_eq!(row.page(), [row], "{platform:?}");
+        assert_eq!(app.quick_value(row), Some(QuickValue::Off), "{platform:?}");
+        press(&mut app, Btn::Down);
+        assert_eq!(app.quick_menu(), Some(row), "{platform:?}");
+        press(&mut app, Btn::B);
+        assert_eq!(app.quick_menu(), Some(QuickRow::Screen), "{platform:?}");
+    }
+}
+
+#[test]
+fn stepping_the_shader_row_cycles_retro_and_the_card_remembers_it() {
+    for (platform, row, pick) in shader_rows() {
+        let (root, mut app) = on_shelf(platform);
+        open_screen(&mut app);
+        let mut seen = vec![];
+        for _ in 0..3 {
+            press(&mut app, Btn::Right);
+            app.flush_state();
+            seen.push(pick(&read_slot_state(root.path())));
+        }
+        assert_eq!(
+            seen,
+            [Shader::Grid, Shader::Dot, Shader::Off],
+            "{platform:?}"
+        );
+        press(&mut app, Btn::Left);
+        app.flush_state();
+        let st = read_slot_state(root.path());
+        assert_eq!(pick(&st), Shader::Dot, "{platform:?}");
+        assert_eq!(app.quick_value(row), Some(QuickValue::Dot), "{platform:?}");
+        assert_eq!(st.shader_gba, SlotState::default().shader_gba);
+        assert_eq!(st.shader_gb, SlotState::default().shader_gb);
+        let other = if platform == Platform::Nes {
+            st.shader_snes
+        } else {
+            st.shader_nes
+        };
+        assert_eq!(
+            other,
+            Shader::Off,
+            "{platform:?} moved the other retro shader"
+        );
+    }
+}
+
+#[test]
+fn the_gba_and_gb_shelves_keep_the_upstream_platform_list() {
+    for platform in [Platform::Gba, Platform::Gb] {
+        let (_root, mut app) = on_shelf(platform);
+        open_screen(&mut app);
+        assert_eq!(app.quick_menu(), Some(QuickRow::ScreenGba), "{platform:?}");
+        for want in [QuickRow::ScreenGbc, QuickRow::ScreenGb, QuickRow::ScreenGba] {
+            press(&mut app, Btn::Down);
+            assert_eq!(app.quick_menu(), Some(want), "{platform:?}");
+        }
+        press(&mut app, Btn::B);
+        press(&mut app, Btn::B);
+        assert!(matches!(app.phase(), Phase::Shelf), "{platform:?}");
+    }
+}
+
+#[test]
+fn the_in_game_screen_page_hides_colour_correction_and_palette_on_nes_and_snes() {
+    use slot::retro_quick::hidden_in_game;
+    for platform in [Platform::Gba, Platform::Gb, Platform::Gbc] {
+        assert_eq!(hidden_in_game(platform, true, false), None, "{platform:?}");
+    }
+    for platform in [Platform::Nes, Platform::Snes] {
+        for framed in [true, false] {
+            for single in [true, false] {
+                let hidden = hidden_in_game(platform, framed, single).expect("no hidden rows");
+                assert!(hidden.contains(&QuickRow::ColourCorrection));
+                assert!(hidden.contains(&QuickRow::Palette));
+                assert!(!hidden.contains(&QuickRow::Shader));
+                assert_eq!(hidden.contains(&QuickRow::Bezel), !framed);
+                assert_eq!(hidden.contains(&QuickRow::ExitGame), single);
+            }
+        }
+    }
+}
diff --git a/crates/slot/tests/render_quick_retro.rs b/crates/slot/tests/render_quick_retro.rs
new file mode 100644
index 0000000..93ec378
--- /dev/null
+++ b/crates/slot/tests/render_quick_retro.rs
@@ -0,0 +1,103 @@
+#![cfg(target_os = "macos")]
+
+mod common;
+
+use std::collections::VecDeque;
+
+use common::{clocked, tmp_root_with_real_carts};
+use slot::frontend::Frontend;
+use slot_gfx::{Compositor, HeadlessSurface, OUT_H, OUT_W};
+use slot_input::{Btn, InputSource, Millis, RawEvent};
+use slot_power::SimPlatform;
+use slot_store::Platform;
+use slot_ui::{QUICK_LABEL_X, QUICK_PITCH};
+
+struct Script(VecDeque<Vec<RawEvent>>);
+
+impl InputSource for Script {
+    fn poll(&mut self, _now: Millis) -> Vec<RawEvent> {
+        self.0.pop_front().unwrap_or_default()
+    }
+}
+
+fn tap(f: &mut Frontend, input: &mut Script, btn: Btn) {
+    input.0.push_back(vec![RawEvent::Down(btn)]);
+    f.advance(input);
+    input.0.push_back(vec![RawEvent::Up(btn)]);
+    f.advance(input);
+}
+
+fn save(px: &[u8], name: &str) {
+    let Ok(dir) = std::env::var("SCRATCH_PNG_DIR") else {
+        return;
+    };
+    let path = format!("{dir}/quick-menu-{name}.png");
+    let file = std::fs::File::create(&path).expect("create png");
+    let mut e = png::Encoder::new(std::io::BufWriter::new(file), OUT_W, OUT_H);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(px)
+        .expect("png data");
+    println!("wrote {path}");
+}
+
+#[test]
+fn the_nes_shelf_quick_menu_prints_the_nes_shader_row_where_gba_prints_its_own() {
+    let Ok(surface) = HeadlessSurface::new() else {
+        return;
+    };
+    let Ok(mut c) = Compositor::new(&surface) else {
+        return;
+    };
+    let d = tmp_root_with_real_carts(&["Emerald"]);
+    let cart = d
+        .path()
+        .join("Games")
+        .join(Platform::Nes.dir_name())
+        .join(format!("Zelda.{}", Platform::Nes.extensions()[0]));
+    std::fs::write(cart, vec![0u8; 0x200]).expect("write cart");
+    clocked(d.path());
+    let mut f = Frontend::boot(Box::new(SimPlatform::at(d.path().to_path_buf())));
+    f.upload_faces(&mut c);
+    let mut input = Script(VecDeque::new());
+    tap(&mut f, &mut input, Btn::R1);
+    for _ in 0..40 {
+        f.advance(&mut input);
+    }
+    tap(&mut f, &mut input, Btn::Menu);
+    tap(&mut f, &mut input, Btn::Down);
+    tap(&mut f, &mut input, Btn::A);
+    f.compose(&mut c);
+    let px = c.read_frame();
+    save(&px, "nes-shader");
+
+    let x0 = QUICK_LABEL_X as usize;
+    let white = |x: usize, y: usize| {
+        let i = (y * OUT_W as usize + x) * 4;
+        px[i..i + 3].iter().all(|c| *c > 0xc0)
+    };
+    let rows: Vec<usize> = (0..400)
+        .filter(|y| (x0..360).any(|x| white(x, *y)))
+        .collect();
+    let (first_row, last_row) = (rows[0], rows[rows.len() - 1]);
+    assert!(
+        last_row - first_row < QUICK_PITCH as usize,
+        "more than one row is drawn, ink from y {first_row} to {last_row}"
+    );
+    let label: Vec<usize> = (x0..360)
+        .filter(|x| rows.iter().any(|y| white(*x, *y)))
+        .collect();
+    let first = label[0];
+    assert!((x0..=x0 + 4).contains(&first), "label starts at x {first}");
+    assert!(
+        label.len() > 60,
+        "label is only {} columns wide",
+        label.len()
+    );
+    assert!(
+        (360..OUT_W as usize).any(|x| rows.iter().any(|y| white(x, *y))),
+        "the NES shader row has no value"
+    );
+}
