index 0000000..a8efab0
--- /dev/null
+++ b/crates/slot-ui/src/quick_retro.rs
@@ -0,0 +1,18 @@
+use crate::quick_menu::QuickRow;
+use slot_store::Platform;
+
+impl QuickRow {
+    pub const NES_SCREEN: [QuickRow; 1] = [QuickRow::NesShader];
+    pub const SNES_SCREEN: [QuickRow; 1] = [QuickRow::SnesShader];
+
+    pub fn child_for(self, shelf: Option<Platform>) -> Option<QuickRow> {
+        if self != QuickRow::Screen {
+            return self.child();
+        }
+        match shelf {
+            Some(Platform::Gba | Platform::Gb | Platform::Gbc) | None => self.child(),
+            Some(Platform::Nes) => Some(QuickRow::NES_SCREEN[0]),
+            Some(Platform::Snes) => Some(QuickRow::SNES_SCREEN[0]),
+        }
+    }
+}
