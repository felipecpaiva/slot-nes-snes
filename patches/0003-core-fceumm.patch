diff --git a/crates/slot/src/core_options_policy.rs b/crates/slot/src/core_options_policy.rs
new file mode 100644
index 0000000..5448a2e
--- /dev/null
+++ b/crates/slot/src/core_options_policy.rs
@@ -0,0 +1,26 @@
+use slot_retro::LibretroCore;
+use slot_store::Core;
+
+const FCEUMM_OVERSCAN: [&str; 4] = [
+    "fceumm_overscan_h_left",
+    "fceumm_overscan_h_right",
+    "fceumm_overscan_v_top",
+    "fceumm_overscan_v_bottom",
+];
+
+pub fn apply_policy_options(core: &mut LibretroCore, which: Core) {
+    let frameskip = format!("{}_frameskip", which.option_prefix());
+    if core.declared_options().contains_key(&frameskip) {
+        core.set_option(&frameskip, "auto");
+    } else {
+        eprintln!(
+            "slot: core: {} declares no frameskip option",
+            which.as_str()
+        );
+    }
+    if which == Core::Fceumm {
+        for key in FCEUMM_OVERSCAN {
+            core.set_option(key, "0");
+        }
+    }
+}
