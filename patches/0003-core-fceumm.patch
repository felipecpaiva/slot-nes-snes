@@ -0,0 +1,73 @@
+use slot_store::{core_for_platform, Core, Platform};
+
+fn root_with_selection(text: &str) -> tempfile::TempDir {
+    let d = tempfile::tempdir().expect("tempdir");
+    std::fs::create_dir(d.path().join("Config")).expect("config dir");
+    std::fs::write(d.path().join("Config/selected_core.txt"), text).expect("write selection");
+    d
+}
+
+#[test]
+fn a_nes_cart_opens_fceumm_by_default() {
+    let d = root_with_selection("");
+    assert_eq!(
+        core_for_platform(d.path(), "Mario", Platform::Nes),
+        Core::Fceumm
+    );
+}
+
+#[test]
+fn a_game_boy_core_choice_is_dropped_for_a_nes_cart() {
+    let d = root_with_selection("Mario=mgba\n");
+    assert_eq!(
+        core_for_platform(d.path(), "Mario", Platform::Nes),
+        Core::Fceumm
+    );
+}
+
+#[test]
+fn a_game_boy_cart_never_takes_fceumm() {
+    let d = root_with_selection("Tetris=fceumm\n");
+    assert_eq!(
+        core_for_platform(d.path(), "Tetris", Platform::Gb),
+        Core::Mgba
+    );
+}
+
+#[test]
+fn the_pinned_core_list_still_has_two_entries() {
+    assert_eq!(Core::ALL.len(), 2);
+    assert!(!Core::ALL.contains(&Core::Fceumm));
+}
+
+#[test]
+fn every_core_is_listed_and_reads_back_from_its_own_name() {
+    assert_eq!(Core::EVERY, [Core::Mgba, Core::Gpsp, Core::Fceumm]);
+    for core in Core::EVERY {
+        assert_eq!(Core::parse(core.as_str()), Some(core));
+    }
+}
+
+#[test]
+fn each_core_runs_only_its_own_platforms() {
+    let truth = [
+        (Core::Mgba, [true, true, true, false]),
+        (Core::Gpsp, [true, false, false, false]),
+        (Core::Fceumm, [false, false, false, true]),
+    ];
+    let platforms = [Platform::Gba, Platform::Gb, Platform::Gbc, Platform::Nes];
+    for (core, expected) in truth {
+        for (platform, runs) in platforms.into_iter().zip(expected) {
+            assert_eq!(core.runs(platform), runs, "{core:?} on {platform:?}");
+        }
+    }
+}
+
+#[test]
+fn each_core_names_its_option_prefix_after_its_dylib() {
+    for core in Core::EVERY {
+        assert_eq!(core.option_prefix(), core.as_str());
+    }
+    assert!(!Core::Fceumm.has_colour_correction());
+    assert!(Core::Mgba.has_colour_correction() && Core::Gpsp.has_colour_correction());
+}
