+++ b/crates/slot/tests/nes_fceumm.rs
@@ -0,0 +1,110 @@
+mod common;
+mod nes_common;
+
+use std::path::Path;
+
+use common::core_lock;
+use nes_common::{fceumm, nes_rom};
+use slot::core::{apply_core_options, open_core_for};
+use slot_retro::{ButtonMask, LibretroCore, MockCore, RetroCore};
+use slot_store::Core;
+
+const OVERSCAN_KEYS: [&str; 4] = [
+    "fceumm_overscan_h_left",
+    "fceumm_overscan_h_right",
+    "fceumm_overscan_v_top",
+    "fceumm_overscan_v_bottom",
+];
+
+#[repr(C)]
+struct SystemAvInfo {
+    base_width: u32,
+    base_height: u32,
+    max_width: u32,
+    max_height: u32,
+    aspect_ratio: f32,
+    fps: f64,
+    sample_rate: f64,
+}
+
+fn base_geometry(dylib: &Path) -> (u32, u32) {
+    // SAFETY: the dylib is already loaded by the core under test, so this only takes another
+    // handle on it, and retro_get_system_av_info writes one SystemAvInfo through the pointer.
+    unsafe {
+        let lib = libloading::Library::new(dylib).expect("reopen fceumm");
+        let get: libloading::Symbol<unsafe extern "C" fn(*mut SystemAvInfo)> = lib
+            .get(b"retro_get_system_av_info")
+            .expect("retro_get_system_av_info");
+        let mut av = std::mem::MaybeUninit::<SystemAvInfo>::zeroed();
+        get(av.as_mut_ptr());
+        let av = av.assume_init();
+        (av.base_width, av.base_height)
+    }
+}
+
+fn loaded_geometry(dylib: &Path, rom: &str, tweak: impl FnOnce(&mut LibretroCore)) -> (u32, u32) {
+    let mut core = LibretroCore::open(dylib).expect("open fceumm");
+    apply_core_options(&mut core, Core::Fceumm, "auto", false, false, None);
+    tweak(&mut core);
+    core.load(&nes_rom(rom))
+        .expect("fceumm refused the generated cart");
+    for _ in 0..3 {
+        core.run_frame(ButtonMask::default());
+    }
+    base_geometry(dylib)
+}
+
+#[test]
+fn slots_own_open_path_runs_a_nes_cart_on_fceumm() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = open_core_for(d.path(), Core::Fceumm, "auto", false, &[dylib]);
+    core.load(&nes_rom("fceumm_open.nes"))
+        .expect("fceumm refused the generated cart");
+    for _ in 0..5 {
+        core.run_frame(ButtonMask::default());
+    }
+    let fps = core.av_info().fps;
+    assert_ne!(
+        fps,
+        MockCore::new().av_info().fps,
+        "the mock ran with fceumm sitting right there"
+    );
+    assert!((49.0..61.0).contains(&fps), "fceumm reported {fps} fps");
+}
+
+#[test]
+fn fceumm_is_told_to_show_the_whole_picture() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let mut core = LibretroCore::open(&dylib).expect("open fceumm");
+    apply_core_options(&mut core, Core::Fceumm, "auto", false, false, None);
+    core.load(&nes_rom("fceumm_overscan.nes"))
+        .expect("fceumm refused the generated cart");
+    for _ in 0..3 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(base_geometry(&dylib), (256, 240));
+    for key in OVERSCAN_KEYS {
+        assert_eq!(core.option(key).as_deref(), Some("0"), "{key}");
+    }
+}
+
+#[test]
+fn fceumm_crops_the_picture_when_the_overscan_keys_say_so() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let cropped = loaded_geometry(&dylib, "fceumm_cropped.nes", |core| {
+        for key in OVERSCAN_KEYS {
+            core.set_option(key, "8");
+        }
+    });
+    assert_eq!(cropped, (240, 224));
+}
