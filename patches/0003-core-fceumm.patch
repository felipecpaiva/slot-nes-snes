diff --git a/crates/slot-store/src/core_policy.rs b/crates/slot-store/src/core_policy.rs
new file mode 100644
index 0000000..e805dac
--- /dev/null
+++ b/crates/slot-store/src/core_policy.rs
@@ -0,0 +1,20 @@
+use crate::core::Core;
+
+impl Core {
+    pub const EVERY: [Core; 3] = [Core::Mgba, Core::Gpsp, Core::Fceumm];
+
+    pub fn option_prefix(self) -> &'static str {
+        match self {
+            Core::Mgba => "mgba",
+            Core::Gpsp => "gpsp",
+            Core::Fceumm => "fceumm",
+        }
+    }
+
+    pub fn has_colour_correction(self) -> bool {
+        match self {
+            Core::Mgba | Core::Gpsp => true,
+            Core::Fceumm => false,
+        }
+    }
+}
