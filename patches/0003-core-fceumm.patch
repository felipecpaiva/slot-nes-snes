--- /dev/null
+++ b/crates/slot/tests/nes_common/mod.rs
@@ -0,0 +1,33 @@
+use std::path::{Path, PathBuf};
+
+use crate::common;
+
+pub fn fceumm() -> Option<PathBuf> {
+    let p = common::repo_root().join(format!(
+        "vendor/fceumm_libretro.{}",
+        std::env::consts::DLL_EXTENSION
+    ));
+    if p.exists() {
+        return Some(p);
+    }
+    assert!(
+        std::env::var_os("SLOT_REQUIRE_CORES").is_none_or(|v| v != "1"),
+        "SLOT_REQUIRE_CORES=1 and {} is missing",
+        p.display()
+    );
+    eprintln!("skipping: no fceumm dylib at {}", p.display());
+    None
+}
+
+pub fn nes_rom(name: &str) -> PathBuf {
+    let mut rom = vec![0u8; 16 + 0x4000 + 0x2000];
+    rom[..4].copy_from_slice(b"NES\x1a");
+    rom[4] = 1;
+    rom[5] = 1;
+    rom[16..19].copy_from_slice(&[0x4c, 0x00, 0xc0]);
+    rom[16 + 0x3ffc] = 0x00;
+    rom[16 + 0x3ffd] = 0xc0;
+    let p = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
+    std::fs::write(&p, rom).expect("write rom");
+    p
+}
diff --git a/crates/slot/tests/nes_fceumm.rs b/crates/slot/tests/nes_fceumm.rs
