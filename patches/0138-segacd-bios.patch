diff --git a/crates/slot-store/src/segacd.rs b/crates/slot-store/src/segacd.rs
new file mode 100644
index 0000000..25db6d1
--- /dev/null
+++ b/crates/slot-store/src/segacd.rs
@@ -0,0 +1,69 @@
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::Path;
+
+use crate::lynx::{crc32, Bios};
+use crate::ps1::{first_track, playlist, DiscRegion};
+
+pub const BIOS_BYTES: usize = 131072;
+const REGION_BYTE: u64 = 0x20b;
+const RAW_DATA: u64 = 16;
+const SYNC: [u8; 12] = [
+    0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0,
+];
+
+pub fn bios_file(region: DiscRegion) -> &'static str {
+    match region {
+        DiscRegion::Us => "bios_CD_U.bin",
+        DiscRegion::Eu => "bios_CD_E.bin",
+        DiscRegion::Jp => "bios_CD_J.bin",
+    }
+}
+
+fn known_crcs(region: DiscRegion) -> &'static [u32] {
+    match region {
+        DiscRegion::Us => &[0x9f6f_6276, 0xc6d1_0268],
+        DiscRegion::Eu => &[0x529a_c15a],
+        DiscRegion::Jp => &[0x9d2d_a8f2],
+    }
+}
+
+pub fn bios(bios_dir: &Path, region: DiscRegion) -> Bios {
+    match std::fs::read(bios_dir.join(bios_file(region))) {
+        Ok(bytes) => bios_of(&bytes, region),
+        Err(_) => Bios::Missing,
+    }
+}
+
+pub fn bios_of(bytes: &[u8], region: DiscRegion) -> Bios {
+    match bytes.len() {
+        BIOS_BYTES if known_crcs(region).contains(&crc32(bytes)) => Bios::Known,
+        BIOS_BYTES => Bios::Unknown,
+        _ => Bios::Missing,
+    }
+}
+
+pub fn disc_region(disc: &Path) -> Option<DiscRegion> {
+    let ext = disc.extension()?.to_str()?.to_ascii_lowercase();
+    match ext.as_str() {
+        "m3u" => disc_region(playlist(disc)?.first()?),
+        "cue" => region_of_track(&first_track(disc)?),
+        "iso" | "bin" => region_of_track(disc),
+        _ => None,
+    }
+}
+
+fn region_of_track(path: &Path) -> Option<DiscRegion> {
+    let mut file = File::open(path).ok()?;
+    let mut sync = [0u8; 12];
+    file.read_exact(&mut sync).ok()?;
+    let at = if sync == SYNC { RAW_DATA } else { 0 } + REGION_BYTE;
+    let mut byte = [0u8; 1];
+    file.seek(SeekFrom::Start(at)).ok()?;
+    file.read_exact(&mut byte).ok()?;
+    Some(match byte[0] {
+        0x64 => DiscRegion::Eu,
+        0xa1 => DiscRegion::Jp,
+        _ => DiscRegion::Us,
+    })
+}
