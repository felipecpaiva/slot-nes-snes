@@ -0,0 +1,41 @@
+use slot_store::ps1::DiscRegion;
+
+use crate::Toast;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum SegaCdToast {
+    NeedsBios(DiscRegion),
+    UnknownBios(DiscRegion),
+}
+
+impl SegaCdToast {
+    pub const ALL: [SegaCdToast; 6] = [
+        SegaCdToast::NeedsBios(DiscRegion::Us),
+        SegaCdToast::NeedsBios(DiscRegion::Eu),
+        SegaCdToast::NeedsBios(DiscRegion::Jp),
+        SegaCdToast::UnknownBios(DiscRegion::Us),
+        SegaCdToast::UnknownBios(DiscRegion::Eu),
+        SegaCdToast::UnknownBios(DiscRegion::Jp),
+    ];
+
+    pub fn index(self) -> usize {
+        Self::ALL.iter().position(|t| *t == self).unwrap_or(0)
+    }
+
+    pub fn text(self) -> &'static str {
+        match self {
+            SegaCdToast::NeedsBios(DiscRegion::Us) => "Sega CD needs BIOS/bios_CD_U.bin",
+            SegaCdToast::NeedsBios(DiscRegion::Eu) => "Sega CD needs BIOS/bios_CD_E.bin",
+            SegaCdToast::NeedsBios(DiscRegion::Jp) => "Sega CD needs BIOS/bios_CD_J.bin",
+            SegaCdToast::UnknownBios(DiscRegion::Us) => "bios_CD_U.bin is not a known dump",
+            SegaCdToast::UnknownBios(DiscRegion::Eu) => "bios_CD_E.bin is not a known dump",
+            SegaCdToast::UnknownBios(DiscRegion::Jp) => "bios_CD_J.bin is not a known dump",
+        }
+    }
+}
+
+impl Toast {
+    pub fn segacd_index(s: SegaCdToast) -> usize {
+        Toast::fds_index(crate::FdsToast::ALL[0]) + crate::FdsToast::ALL.len() + s.index()
+    }
+}
