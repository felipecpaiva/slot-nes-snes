diff --git a/crates/slot/src/app/segacd_bios.rs b/crates/slot/src/app/segacd_bios.rs
new file mode 100644
index 0000000..b47d173
--- /dev/null
+++ b/crates/slot/src/app/segacd_bios.rs
@@ -0,0 +1,41 @@
+use slot_store::lynx::Bios;
+use slot_store::segacd::{bios, bios_file};
+use slot_store::Platform;
+use slot_ui::{SegaCdToast, Toast};
+
+use super::App;
+
+impl App {
+    pub(super) fn segacd_bios_allows(&mut self, platform: Platform) -> bool {
+        if platform != Platform::SegaCd {
+            return true;
+        }
+        let Some(root) = self.root.as_deref() else {
+            return true;
+        };
+        let Some(cart) = self.shelf().carts.get(self.shelf().index) else {
+            return true;
+        };
+        let region = slot_ui::sega_cd_region(&cart.rom, &cart.stem);
+        let file = bios_file(region);
+        match bios(&crate::root::bios_dir(root), region) {
+            Bios::Known => true,
+            Bios::Unknown => {
+                if !self.segacd_bios_warned {
+                    self.segacd_bios_warned = true;
+                    eprintln!("slot: segacd: BIOS/{file} is not a known dump, launching");
+                    self.hud
+                        .toast(Toast::SegaCd(SegaCdToast::UnknownBios(region)), self.now());
+                }
+                true
+            }
+            Bios::Missing => {
+                eprintln!("slot: segacd: no usable BIOS/{file}, not launching");
+                self.hud
+                    .toast(Toast::SegaCd(SegaCdToast::NeedsBios(region)), self.now());
+                self.refuse();
+                false
+            }
+        }
+    }
+}
