diff --git a/crates/slot/tests/segacd_bios.rs b/crates/slot/tests/segacd_bios.rs
new file mode 100644
index 0000000..f105c74
--- /dev/null
+++ b/crates/slot/tests/segacd_bios.rs
@@ -0,0 +1,187 @@
+// Sega CD needs the BIOS of the disc's region in BIOS/, which slot never ships or fetches (ADR 0104).
+// Genesis Plus GX opens bios_CD_U.bin, bios_CD_E.bin or bios_CD_J.bin by the disc's region byte at
+// 0x20b and checks nothing in it, so slot checks the file before the disc is inserted.
+mod common;
+mod core_common;
+mod segacd_common;
+
+use std::path::Path;
+
+use common::tmp_root_with_carts;
+use segacd_common::{cue_disc, dummy_bios, iso_disc, put_bios, real_bios, EU, JP, US};
+use slot::app::{App, Phase};
+use slot_input::{Action, Btn};
+use slot_store::lynx::Bios;
+use slot_store::ps1::DiscRegion;
+use slot_store::segacd::{bios, bios_file, bios_of, disc_region, BIOS_BYTES};
+use slot_store::{write_slot_state, Platform, SlotState};
+use slot_ui::{sega_cd_region, FdsToast, SegaCdToast, Toast};
+use tempfile::TempDir;
+
+fn card(disc: &str, region: u8, bios: &[(&str, &[u8])]) -> TempDir {
+    let d = tmp_root_with_carts(&[]);
+    iso_disc(&d.path().join("Games/SEGACD"), disc, region);
+    for (file, bytes) in bios {
+        put_bios(d.path(), file, bytes);
+    }
+    d
+}
+
+fn boot_on(root: &Path, cart: Option<&str>) -> App {
+    write_slot_state(
+        root,
+        &SlotState {
+            clock_set: true,
+            cart: cart.map(str::to_string),
+            cart_platform: cart.map(|_| Platform::SegaCd),
+            ..SlotState::default()
+        },
+    )
+    .expect("write slot.state");
+    App::boot(root)
+}
+
+fn insert(a: &mut App) {
+    a.apply(Action::GbaDown(Btn::A));
+    a.apply(Action::GbaUp(Btn::A));
+    for _ in 0..10 {
+        a.update(1.0 / 60.0);
+    }
+}
+
+fn inserting(a: &App) -> bool {
+    matches!(a.phase(), Phase::Inserting { .. } | Phase::Playing { .. })
+}
+
+#[test]
+fn each_region_has_its_own_bios_file() {
+    assert_eq!(bios_file(DiscRegion::Us), "bios_CD_U.bin");
+    assert_eq!(bios_file(DiscRegion::Eu), "bios_CD_E.bin");
+    assert_eq!(bios_file(DiscRegion::Jp), "bios_CD_J.bin");
+}
+
+#[test]
+fn the_check_reads_missing_short_long_and_unknown_files() {
+    let d = tempfile::tempdir().unwrap();
+    assert_eq!(bios(d.path(), DiscRegion::Us), Bios::Missing);
+    for (bytes, want) in [
+        (vec![], Bios::Missing),
+        (vec![0u8; 65536], Bios::Missing),
+        (vec![0u8; BIOS_BYTES + 1], Bios::Missing),
+        (vec![0u8; BIOS_BYTES], Bios::Unknown),
+    ] {
+        std::fs::write(d.path().join("bios_CD_U.bin"), &bytes).unwrap();
+        assert_eq!(
+            bios(d.path(), DiscRegion::Us),
+            want,
+            "{} bytes",
+            bytes.len()
+        );
+    }
+    assert_eq!(bios(d.path(), DiscRegion::Eu), Bios::Missing);
+}
+
+#[test]
+fn the_maintainers_own_us_bios_is_a_known_dump_and_not_a_european_one() {
+    let Some(b) = real_bios() else {
+        return;
+    };
+    assert_eq!(bios_of(&b, DiscRegion::Us), Bios::Known);
+    assert_eq!(bios_of(&b, DiscRegion::Eu), Bios::Unknown);
+}
+
+#[test]
+fn the_region_comes_from_the_name_then_the_byte_at_0x20b_then_usa() {
+    let d = tempfile::tempdir().unwrap();
+    let eu = iso_disc(d.path(), "Untagged EU", EU);
+    let jp = cue_disc(d.path(), "Untagged JP", JP);
+    let us = iso_disc(d.path(), "Untagged US", US);
+    assert_eq!(disc_region(&eu), Some(DiscRegion::Eu));
+    assert_eq!(disc_region(&jp), Some(DiscRegion::Jp));
+    assert_eq!(disc_region(&us), Some(DiscRegion::Us));
+    assert_eq!(sega_cd_region(&eu, "Untagged EU"), DiscRegion::Eu);
+    assert_eq!(sega_cd_region(&eu, "Sol-Feace (USA)"), DiscRegion::Us);
+    assert_eq!(
+        sega_cd_region(&us, "Lunar - Eternal Blue (Japan) (En)"),
+        DiscRegion::Jp
+    );
+    let chd = d.path().join("Popful Mail.chd");
+    std::fs::write(&chd, [0u8; 64]).unwrap();
+    assert_eq!(disc_region(&chd), None);
+    assert_eq!(sega_cd_region(&chd, "Popful Mail"), DiscRegion::Us);
+    let m3u = d.path().join("Two.m3u");
+    std::fs::write(&m3u, "Untagged JP.cue\n").unwrap();
+    assert_eq!(disc_region(&m3u), Some(DiscRegion::Jp));
+}
+
+#[test]
+fn with_no_bios_a_disc_stays_on_the_shelf_with_a_toast_naming_its_file() {
+    let d = card("Sonic CD (USA)", US, &[]);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    let toast = Toast::SegaCd(SegaCdToast::NeedsBios(DiscRegion::Us));
+    assert_eq!(a.toast(), Some(toast));
+    assert_eq!(toast.text(), "Sega CD needs BIOS/bios_CD_U.bin");
+}
+
+#[test]
+fn a_european_disc_needs_the_european_bios_even_with_the_us_one_present() {
+    let us = dummy_bios();
+    let d = card("Sonic CD (Europe)", EU, &[("bios_CD_U.bin", &us)]);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(
+        a.toast(),
+        Some(Toast::SegaCd(SegaCdToast::NeedsBios(DiscRegion::Eu)))
+    );
+}
+
+#[test]
+fn a_disc_resumed_at_boot_is_checked_too() {
+    let d = card("Sonic CD (Japan)", JP, &[("bios_CD_J.bin", &[0u8; 100])]);
+    let a = boot_on(d.path(), Some("Sonic CD (Japan)"));
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(
+        a.toast(),
+        Some(Toast::SegaCd(SegaCdToast::NeedsBios(DiscRegion::Jp)))
+    );
+}
+
+#[test]
+fn an_unknown_bios_launches_and_says_so() {
+    let d = card("Sonic CD (USA)", US, &[("bios_CD_U.bin", &dummy_bios())]);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(
+        a.toast(),
+        Some(Toast::SegaCd(SegaCdToast::UnknownBios(DiscRegion::Us)))
+    );
+}
+
+#[test]
+fn a_known_bios_launches_with_no_toast() {
+    let Some(b) = real_bios() else {
+        return;
+    };
+    let d = card("Sonic CD (USA)", US, &[("bios_CD_U.bin", &b)]);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn the_sega_cd_toasts_upload_in_their_own_place_after_the_fds_ones() {
+    let every = Toast::every();
+    for s in SegaCdToast::ALL {
+        let t = Toast::SegaCd(s);
+        assert_eq!(every.get(t.index()), Some(&t), "{s:?}");
+    }
+    assert_eq!(
+        Toast::SegaCd(SegaCdToast::ALL[0]).index(),
+        Toast::Fds(FdsToast::ALL[FdsToast::ALL.len() - 1]).index() + 1
+    );
+}
