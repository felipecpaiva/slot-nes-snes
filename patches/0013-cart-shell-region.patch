diff --git a/crates/slot-store/tests/nes_cart_shell.rs b/crates/slot-store/tests/nes_cart_shell.rs
new file mode 100644
index 0000000..020ba7f
--- /dev/null
+++ b/crates/slot-store/tests/nes_cart_shell.rs
@@ -0,0 +1,51 @@
+use slot_store::{Outline, ShellChoice, ShellFinish};
+
+const NEW_WORDS: [(&str, Outline); 4] = [
+    ("nes", Outline::Nes),
+    ("famicom", Outline::Famicom),
+    ("snes", Outline::Snes),
+    ("sfc", Outline::Sfc),
+];
+
+#[test]
+fn the_new_outline_words_parse_to_their_outlines() {
+    for (word, outline) in NEW_WORDS {
+        let choice = ShellChoice::parse(&format!("{word} ff00aa glitter")).expect(word);
+        assert_eq!(choice.outline, outline, "{word}");
+        assert_eq!(choice.colour, [0xff, 0x00, 0xaa], "{word}");
+        assert_eq!(choice.finish, ShellFinish::Glitter, "{word}");
+    }
+}
+
+#[test]
+fn the_new_outlines_write_back_as_their_words() {
+    for (word, outline) in NEW_WORDS {
+        let choice = ShellChoice {
+            outline,
+            colour: [1, 2, 3],
+            finish: ShellFinish::Solid,
+        };
+        assert_eq!(choice.to_value(), format!("{word} 010203 solid"));
+        assert_eq!(ShellChoice::parse(&choice.to_value()), Some(choice));
+    }
+}
+
+#[test]
+fn an_unknown_outline_word_is_not_a_choice() {
+    assert_eq!(ShellChoice::parse("n64 ffffff solid"), None);
+    assert_eq!(ShellChoice::parse("NES ffffff solid"), None);
+    assert_eq!(ShellChoice::parse("nes ffffff"), None);
+}
+
+#[test]
+fn the_game_boy_words_are_unchanged() {
+    for (word, outline) in [
+        ("auto", Outline::Auto),
+        ("notched", Outline::Notched),
+        ("rounded", Outline::Rounded),
+    ] {
+        let choice = ShellChoice::parse(&format!("{word} 123456 clear")).expect(word);
+        assert_eq!(choice.outline, outline, "{word}");
+        assert_eq!(choice.to_value(), format!("{word} 123456 clear"));
+    }
+}
diff --git a/crates/slot-store/tests/nes_region.rs b/crates/slot-store/tests/nes_region.rs
new file mode 100644
index 0000000..5a5e367
--- /dev/null
+++ b/crates/slot-store/tests/nes_region.rs
@@ -0,0 +1,66 @@
+use slot_store::{nes, Outline};
+
+#[test]
+fn a_japan_tag_gives_the_famicom() {
+    assert_eq!(nes::outline("Super Mario Bros. (Japan)"), Outline::Famicom);
+}
+
+#[test]
+fn a_usa_tag_gives_the_nes() {
+    assert_eq!(nes::outline("Super Mario Bros. (USA)"), Outline::Nes);
+}
+
+#[test]
+fn a_europe_tag_gives_the_nes() {
+    assert_eq!(nes::outline("Super Mario Bros. (Europe)"), Outline::Nes);
+}
+
+#[test]
+fn no_tag_gives_the_nes() {
+    assert_eq!(nes::outline("Super Mario Bros."), Outline::Nes);
+}
+
+#[test]
+fn a_game_released_in_japan_and_the_west_gives_the_nes() {
+    assert_eq!(nes::outline("Game (Japan, USA)"), Outline::Nes);
+    assert_eq!(nes::outline("Game (World)"), Outline::Nes);
+}
+
+#[test]
+fn a_japan_tag_still_counts_next_to_a_revision_tag() {
+    assert_eq!(nes::outline("Game (Japan) (Rev 1)"), Outline::Famicom);
+    assert_eq!(nes::outline("Game (Japan) (En,Ja)"), Outline::Famicom);
+}
+
+#[test]
+fn a_goodtools_j_tag_gives_the_famicom() {
+    assert_eq!(nes::outline("Akumajou Dracula (J)"), Outline::Famicom);
+    assert_eq!(nes::outline("Akumajou Dracula (J) [!]"), Outline::Famicom);
+}
+
+#[test]
+fn a_goodtools_western_tag_gives_the_nes() {
+    for stem in ["Game (U)", "Game (E)", "Game (UE)"] {
+        assert_eq!(nes::outline(stem), Outline::Nes, "{stem}");
+    }
+}
+
+#[test]
+fn a_goodtools_tag_for_japan_and_the_west_gives_the_nes() {
+    for stem in ["Game (JU)", "Game (JE)", "Game (JUE)", "Game (J) (U)"] {
+        assert_eq!(nes::outline(stem), Outline::Nes, "{stem}");
+    }
+}
+
+#[test]
+fn a_tag_that_only_starts_with_a_goodtools_letter_is_not_a_region() {
+    for stem in [
+        "Game (Japan) (Unl)",
+        "Game (Japan) (UK)",
+        "Game (Japan) (PRG0)",
+        "Game (Japan) (Hack)",
+        "Game (Japan) (VS)",
+    ] {
+        assert_eq!(nes::outline(stem), Outline::Famicom, "{stem}");
+    }
+}
diff --git a/crates/slot-store/tests/snes_region.rs b/crates/slot-store/tests/snes_region.rs
