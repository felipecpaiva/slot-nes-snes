+fn cached_snes_outline(rom: &Path) -> Option<Outline> {
+    static OUTLINES: OnceLock<Mutex<HashMap<PathBuf, Option<Outline>>>> = OnceLock::new();
+    *OUTLINES
+        .get_or_init(Mutex::default)
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .entry(rom.to_path_buf())
+        .or_insert_with(|| slot_store::snes::outline(rom))
+}
+
 pub fn retro_shell_of(cart: &Cart) -> Option<RetroShell> {
+    let word = cart.shell.map(|c| c.outline);
     match cart.platform {
-        Platform::Nes => Some(RetroShell::Nes(NesShell::Nes)),
-        Platform::Snes => Some(RetroShell::Snes(SnesShell::Snes)),
+        Platform::Nes => Some(RetroShell::Nes(match word {
+            Some(Outline::Nes) => NesShell::Nes,
+            Some(Outline::Famicom) => NesShell::Famicom,
+            Some(
+                Outline::Auto | Outline::Notched | Outline::Rounded | Outline::Snes | Outline::Sfc,
+            )
+            | None => {
+                if slot_store::nes::outline(&cart.stem) == Outline::Famicom {
+                    NesShell::Famicom
+                } else {
+                    NesShell::Nes
+                }
+            }
+        })),
+        Platform::Snes => Some(RetroShell::Snes(match word {
+            Some(Outline::Snes) => SnesShell::Snes,
+            Some(Outline::Sfc) => SnesShell::Sfc,
+            Some(
+                Outline::Auto
+                | Outline::Notched
+                | Outline::Rounded
+                | Outline::Nes
+                | Outline::Famicom,
+            )
+            | None => {
+                if cached_snes_outline(&cart.rom) == Some(Outline::Sfc) {
+                    SnesShell::Sfc
+                } else {
+                    SnesShell::Snes
+                }
+            }
+        })),
         Platform::Gba | Platform::Gb | Platform::Gbc => None,
     }
 }
