@@ -0,0 +1,90 @@
+use std::path::PathBuf;
+
+use slot_store::{snes, Outline};
+
+const LO: usize = 0x7fc0;
+const HI: usize = 0xffc0;
+const EX: usize = 0x40ffc0;
+
+fn rom_file(header_at: usize, map: u8, region: u8, copier: bool) -> (tempfile::TempDir, PathBuf) {
+    let mut rom = vec![0u8; header_at + 0x40];
+    rom[header_at + 0x15] = map;
+    rom[header_at + 0x19] = region;
+    rom[header_at + 0x1c..header_at + 0x1e].copy_from_slice(&0xa5a5u16.to_le_bytes());
+    rom[header_at + 0x1e..header_at + 0x20].copy_from_slice(&0x5a5au16.to_le_bytes());
+    if copier {
+        rom.splice(0..0, [0xffu8; 512]);
+    }
+    let d = tempfile::tempdir().expect("tempdir");
+    let path = d.path().join("Some Game.sfc");
+    std::fs::write(&path, rom).expect("write rom");
+    (d, path)
+}
+
+fn region(header_at: usize, map: u8, code: u8, copier: bool) -> Option<Outline> {
+    let (_d, path) = rom_file(header_at, map, code, copier);
+    snes::outline(&path)
+}
+
+#[test]
+fn a_japan_lorom_gives_the_sfc() {
+    assert_eq!(region(LO, 0x20, 0x00, false), Some(Outline::Sfc));
+}
+
+#[test]
+fn a_usa_lorom_gives_the_snes() {
+    assert_eq!(region(LO, 0x20, 0x01, false), Some(Outline::Snes));
+}
+
+#[test]
+fn a_europe_lorom_gives_the_sfc() {
+    assert_eq!(region(LO, 0x20, 0x02, false), Some(Outline::Sfc));
+}
+
+#[test]
+fn the_hirom_region_is_read_from_its_own_header() {
+    assert_eq!(region(HI, 0x21, 0x00, false), Some(Outline::Sfc));
+    assert_eq!(region(HI, 0x21, 0x01, false), Some(Outline::Snes));
+    assert_eq!(region(HI, 0x21, 0x02, false), Some(Outline::Sfc));
+}
+
+#[test]
+fn the_exhirom_region_is_read_from_its_own_header() {
+    assert_eq!(region(EX, 0x25, 0x00, false), Some(Outline::Sfc));
+    assert_eq!(region(EX, 0x25, 0x01, false), Some(Outline::Snes));
+}
+
+#[test]
+fn the_region_is_read_past_a_copier_header() {
+    assert_eq!(region(LO, 0x20, 0x00, true), Some(Outline::Sfc));
+    assert_eq!(region(LO, 0x20, 0x01, true), Some(Outline::Snes));
+    assert_eq!(region(HI, 0x21, 0x02, true), Some(Outline::Sfc));
+    assert_eq!(region(HI, 0x21, 0x01, true), Some(Outline::Snes));
+}
+
+#[test]
+fn the_other_pal_and_asian_codes_give_the_sfc() {
+    for code in [0x03, 0x06, 0x09, 0x0b, 0x0d, 0x0f, 0x10, 0x11, 0x14] {
+        assert_eq!(
+            region(LO, 0x20, code, false),
+            Some(Outline::Sfc),
+            "{code:#x}"
+        );
+    }
+}
+
+#[test]
+fn a_code_past_the_table_gives_the_snes() {
+    assert_eq!(region(LO, 0x20, 0x15, false), Some(Outline::Snes));
+    assert_eq!(region(LO, 0x20, 0xff, false), Some(Outline::Snes));
+}
+
+#[test]
+fn a_rom_with_no_valid_header_has_no_region() {
+    let (_d, path) = rom_file(LO, 0x20, 0x00, false);
+    let mut bytes = std::fs::read(&path).expect("read rom");
+    bytes[LO + 0x1c] ^= 1;
+    std::fs::write(&path, bytes).expect("write rom");
+    assert_eq!(snes::outline(&path), None);
+    assert_eq!(snes::outline(&path.with_file_name("missing.sfc")), None);
+}
