@@ -0,0 +1,50 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{gb_shell_of, GbShell};
+
+fn gb_cart(dir: &tempfile::TempDir, cgb: u8, word: Option<Outline>) -> Cart {
+    let mut rom = vec![0u8; 0x150];
+    rom[0x143] = cgb;
+    let path: PathBuf = dir.path().join(format!("Game {cgb}.gb"));
+    std::fs::write(&path, rom).expect("write rom");
+    Cart {
+        platform: Platform::Gb,
+        stem: format!("Game {cgb}"),
+        rom: path,
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: word.map(|outline| ShellChoice {
+            outline,
+            colour: [1, 2, 3],
+            finish: ShellFinish::Solid,
+        }),
+    }
+}
+
+#[test]
+fn a_console_outline_word_on_a_game_boy_stem_is_treated_as_auto() {
+    let d = tempfile::tempdir().expect("tempdir");
+    for word in [Outline::Nes, Outline::Famicom, Outline::Snes, Outline::Sfc] {
+        assert_eq!(
+            gb_shell_of(&gb_cart(&d, 0x00, Some(word))),
+            Some(GbShell::Notched),
+            "{word:?} on an original"
+        );
+        assert_eq!(
+            gb_shell_of(&gb_cart(&d, 0xc0, Some(word))),
+            Some(GbShell::Rounded),
+            "{word:?} on a colour-only cart"
+        );
+    }
+}
+
+#[test]
+fn a_game_boy_outline_word_still_wins_over_the_header() {
+    let d = tempfile::tempdir().expect("tempdir");
+    assert_eq!(
+        gb_shell_of(&gb_cart(&d, 0x00, Some(Outline::Rounded))),
+        Some(GbShell::Rounded)
+    );
+}
diff --git a/crates/slot-ui/tests/nes_region_shell.rs b/crates/slot-ui/tests/nes_region_shell.rs
new file mode 100644
index 0000000..07afebc
--- /dev/null
+++ b/crates/slot-ui/tests/nes_region_shell.rs
@@ -0,0 +1,127 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    retro_shell_of, shell_for, NesShell, RetroShell, SnesShell, FAMICOM_YELLOW, NES_GREY,
+    RETRO_BLACK,
+};
+
+fn choice(outline: Outline) -> ShellChoice {
+    ShellChoice {
+        outline,
+        colour: [1, 2, 3],
+        finish: ShellFinish::Solid,
+    }
+}
+
+fn nes(stem: &str, word: Option<Outline>) -> Cart {
+    Cart {
+        platform: Platform::Nes,
+        stem: stem.into(),
+        rom: PathBuf::from(format!("{stem}.nes")),
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: word.map(choice),
+    }
+}
+
+fn snes(dir: &tempfile::TempDir, stem: &str, region: u8, word: Option<Outline>) -> Cart {
+    let mut rom = vec![0u8; 0x8000];
+    rom[0x7fd5] = 0x20;
+    rom[0x7fd9] = region;
+    rom[0x7fdc..0x7fde].copy_from_slice(&0xa5a5u16.to_le_bytes());
+    rom[0x7fde..0x7fe0].copy_from_slice(&0x5a5au16.to_le_bytes());
+    let path = dir.path().join(format!("{stem}.sfc"));
+    std::fs::write(&path, rom).expect("write rom");
+    Cart {
+        platform: Platform::Snes,
+        stem: stem.into(),
+        rom: path,
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: word.map(choice),
+    }
+}
+
+const FAMICOM: Option<RetroShell> = Some(RetroShell::Nes(NesShell::Famicom));
+const NES: Option<RetroShell> = Some(RetroShell::Nes(NesShell::Nes));
+const SNES: Option<RetroShell> = Some(RetroShell::Snes(SnesShell::Snes));
+const SFC: Option<RetroShell> = Some(RetroShell::Snes(SnesShell::Sfc));
+
+#[test]
+fn a_japan_nes_stem_picks_the_famicom_and_a_usa_stem_the_nes() {
+    assert_eq!(retro_shell_of(&nes("Game (Japan)", None)), FAMICOM);
+    assert_eq!(retro_shell_of(&nes("Game (USA)", None)), NES);
+    assert_eq!(retro_shell_of(&nes("Game", Some(Outline::Auto))), NES);
+}
+
+#[test]
+fn a_usa_snes_rom_picks_the_snes_and_a_japan_one_the_sfc() {
+    let d = tempfile::tempdir().expect("tempdir");
+    assert_eq!(retro_shell_of(&snes(&d, "Game (USA)", 0x01, None)), SNES);
+    assert_eq!(retro_shell_of(&snes(&d, "Game (Japan)", 0x00, None)), SFC);
+    assert_eq!(retro_shell_of(&snes(&d, "Game (Europe)", 0x02, None)), SFC);
+}
+
+#[test]
+fn a_snes_rom_with_no_header_picks_the_snes() {
+    let cart = Cart {
+        platform: Platform::Snes,
+        stem: "Game (Japan)".into(),
+        rom: PathBuf::from("missing.sfc"),
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    };
+    assert_eq!(retro_shell_of(&cart), SNES);
+}
+
+#[test]
+fn a_word_for_the_carts_platform_beats_the_region() {
+    let d = tempfile::tempdir().expect("tempdir");
+    assert_eq!(
+        retro_shell_of(&nes("Game (Japan)", Some(Outline::Nes))),
+        NES
+    );
+    assert_eq!(
+        retro_shell_of(&nes("Game (USA)", Some(Outline::Famicom))),
+        FAMICOM
+    );
+    assert_eq!(
+        retro_shell_of(&snes(&d, "Game (Japan)", 0x00, Some(Outline::Snes))),
+        SNES
+    );
+    assert_eq!(
+        retro_shell_of(&snes(&d, "Game (USA)", 0x01, Some(Outline::Sfc))),
+        SFC
+    );
+}
+
+#[test]
+fn a_word_for_the_wrong_platform_is_ignored() {
+    let d = tempfile::tempdir().expect("tempdir");
+    assert_eq!(
+        retro_shell_of(&nes("Game (Japan)", Some(Outline::Sfc))),
+        FAMICOM
+    );
+    assert_eq!(retro_shell_of(&nes("Game (USA)", Some(Outline::Snes))), NES);
+    assert_eq!(
+        retro_shell_of(&snes(&d, "Game (USA)", 0x01, Some(Outline::Famicom))),
+        SNES
+    );
+    assert_eq!(
+        retro_shell_of(&snes(&d, "Game (Japan)", 0x00, Some(Outline::Nes))),
+        SFC
+    );
+}
+
+#[test]
+fn the_famicom_title_rows_colour_a_japan_nes_stem() {
+    let smb = nes("Super Mario Bros. (Japan)", None);
+    assert_eq!(shell_for(&smb), FAMICOM_YELLOW);
+    assert_eq!(shell_for(&nes("Bomberman (Japan)", None)), RETRO_BLACK);
+    assert_eq!(shell_for(&nes("Super Mario Bros. (USA)", None)), NES_GREY);
+}
diff --git a/crates/slot-ui/tests/render_nes_region.rs b/crates/slot-ui/tests/render_nes_region.rs
new file mode 100644
index 0000000..00073ac
--- /dev/null
+++ b/crates/slot-ui/tests/render_nes_region.rs
@@ -0,0 +1,142 @@
+#![cfg(target_os = "macos")]
+
+use std::path::PathBuf;
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+use slot_gfx::{Compositor, HeadlessSurface};
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    cart_face, retro_cart_face, retro_cart_shadow, Draw, NesShell, RetroShell, Shelf, SnesShell,
+};
+
+static GL: Mutex<()> = Mutex::new(());
+
+fn compositor() -> Option<(MutexGuard<'static, ()>, HeadlessSurface, Compositor)> {
+    let guard = GL.lock().unwrap_or_else(PoisonError::into_inner);
+    let surface = HeadlessSurface::new().ok()?;
+    let compositor = Compositor::new(&surface).ok()?;
+    Some((guard, surface, compositor))
+}
+
+fn snes_rom(dir: &tempfile::TempDir, name: &str, region: u8) -> PathBuf {
+    let mut rom = vec![0u8; 0x8000];
+    rom[0x7fd5] = 0x20;
+    rom[0x7fd9] = region;
+    rom[0x7fdc..0x7fde].copy_from_slice(&0xa5a5u16.to_le_bytes());
+    rom[0x7fde..0x7fe0].copy_from_slice(&0x5a5au16.to_le_bytes());
+    let path = dir.path().join(name);
+    std::fs::write(&path, rom).expect("write rom");
+    path
+}
+
+fn cart(platform: Platform, stem: &str, rom: PathBuf) -> Cart {
+    Cart {
+        platform,
+        stem: stem.into(),
+        rom,
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn region_carts(dir: &tempfile::TempDir) -> Vec<(Cart, RetroShell)> {
+    vec![
+        (
+            cart(Platform::Nes, "Mega Man (Japan)", PathBuf::from("a.nes")),
+            RetroShell::Nes(NesShell::Famicom),
+        ),
+        (
+            cart(Platform::Nes, "Mega Man (USA)", PathBuf::from("b.nes")),
+            RetroShell::Nes(NesShell::Nes),
+        ),
+        (
+            cart(Platform::Snes, "F-Zero (USA)", snes_rom(dir, "us.sfc", 1)),
+            RetroShell::Snes(SnesShell::Snes),
+        ),
+        (
+            cart(Platform::Snes, "F-Zero (Japan)", snes_rom(dir, "jp.sfc", 0)),
+            RetroShell::Snes(SnesShell::Sfc),
+        ),
+    ]
+}
+
+#[test]
+fn a_cart_face_carries_the_outline_its_region_picks() {
+    let d = tempfile::tempdir().expect("tempdir");
+    for (cart, kind) in region_carts(&d) {
+        let face = cart_face(&cart);
+        let want = retro_cart_face(&cart, kind);
+        assert_eq!(
+            (face.w, face.h, face.rgba),
+            (want.w, want.h, want.rgba),
+            "{} is not drawn as {}",
+            cart.stem,
+            kind.name()
+        );
+    }
+}
+
+#[test]
+fn a_faded_neighbour_is_backed_by_the_shadow_of_its_region_outline() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    let d = tempfile::tempdir().expect("tempdir");
+    let gba = slot_ui::cart_shadow();
+    let gba_tex = c.create_texture(gba.w, gba.h, &gba.rgba);
+    let shadows: Vec<_> = RetroShell::ALL
+        .iter()
+        .map(|k| {
+            let s = retro_cart_shadow(*k);
+            (*k, c.create_texture(s.w, s.h, &s.rgba))
+        })
+        .collect();
+    for (cart, kind) in region_carts(&d) {
+        let others: Vec<Cart> = (0..2)
+            .map(|i| Cart {
+                stem: format!("{} {i}", cart.stem),
+                ..cart.clone()
+            })
+            .collect();
+        let mut shelf = Shelf::new(vec![cart.clone(), others[0].clone(), others[1].clone()]);
+        shelf.set_shadow(gba_tex);
+        let faces: Vec<_> = shelf
+            .carts
+            .iter()
+            .map(|cart| {
+                let f = cart_face(cart);
+                c.create_texture(f.w, f.h, &f.rgba)
+            })
+            .collect();
+        shelf.set_faces(faces);
+        slot_ui::publish_retro_shadows(&shadows);
+        let own = shadows.iter().find(|(k, _)| *k == kind).map(|(_, t)| *t);
+        let mut list = Vec::new();
+        shelf.draw_row(slot_gfx::Canvas::FRAMED, None, 0.0, 0.5, 1.0, &mut list);
+        let used: Vec<_> = list
+            .iter()
+            .filter_map(|d| match d {
+                Draw::Tex { tex, .. } => Some(*tex),
+                _ => None,
+            })
+            .collect();
+        assert!(
+            used.contains(&own.expect("own shadow")),
+            "{} is not backed by the {} shadow",
+            cart.stem,
+            kind.name()
+        );
+        for (other, tex) in &shadows {
+            if *other != kind {
+                assert!(
+                    !used.contains(tex),
+                    "{} is backed by the {} shadow",
+                    cart.stem,
+                    other.name()
+                );
+            }
+        }
+    }
+}
diff --git a/crates/slot/tests/nes_label_cache.rs b/crates/slot/tests/nes_label_cache.rs
new file mode 100644
index 0000000..ebfca44
--- /dev/null
+++ b/crates/slot/tests/nes_label_cache.rs
@@ -0,0 +1,68 @@
+use std::path::Path;
+
+use slot::label_cache::{fresh, label_art};
+use slot_store::{Cart, Platform};
+use slot_ui::label_size;
+
+fn label_png(path: &Path, w: u32, h: u32) {
+    std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+    let file = std::fs::File::create(path).unwrap();
+    let mut enc = png::Encoder::new(file, w, h);
+    enc.set_color(png::ColorType::Rgb);
+    let mut writer = enc.write_header().unwrap();
+    let px: Vec<u8> = (0..w * h).flat_map(|_| [200, 10, 10]).collect();
+    writer.write_image_data(&px).unwrap();
+}
+
+fn nes_cart(root: &Path, stem: &str) -> Cart {
+    let label = root.join(format!("Labels/NES/{stem}.png"));
+    label_png(&label, 400, 400);
+    Cart {
+        platform: Platform::Nes,
+        stem: stem.into(),
+        rom: root.join(format!("Games/NES/{stem}.nes")),
+        label: Some(label),
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+#[test]
+fn a_famicom_cart_label_is_cached_at_the_famicom_label_size() {
+    let d = tempfile::tempdir().unwrap();
+    let famicom = nes_cart(d.path(), "Game (Japan)");
+    let nes = nes_cart(d.path(), "Game (USA)");
+    let (fw, fh) = label_size(&famicom);
+    assert_ne!(
+        (fw, fh),
+        label_size(&nes),
+        "the two shells share a label box"
+    );
+    let art = label_art(d.path(), &famicom).expect("no art from a good label");
+    assert_eq!(art.len(), (fw * fh * 4) as usize);
+    assert!(fresh(d.path(), &famicom));
+}
+
+#[test]
+fn a_cache_written_at_the_nes_size_is_rebuilt_once_the_stem_says_japan() {
+    let d = tempfile::tempdir().unwrap();
+    let nes = nes_cart(d.path(), "Game (USA)");
+    label_art(d.path(), &nes).expect("art");
+    let cached = slot::label_cache::cache_path(d.path(), &nes);
+    let famicom = Cart {
+        stem: "Game (USA)".into(),
+        shell: Some(slot_store::ShellChoice {
+            outline: slot_store::Outline::Famicom,
+            colour: [1, 2, 3],
+            finish: slot_store::ShellFinish::Solid,
+        }),
+        ..nes.clone()
+    };
+    assert!(!fresh(d.path(), &famicom), "an old cache passed as fresh");
+    let art = label_art(d.path(), &famicom).expect("art");
+    let (w, h) = label_size(&famicom);
+    assert_eq!(art.len(), (w * h * 4) as usize);
+    assert!(cached.is_file());
+    assert!(fresh(d.path(), &famicom));
+}
