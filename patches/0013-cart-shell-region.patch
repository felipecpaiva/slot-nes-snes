diff --git a/crates/slot-store/src/nes.rs b/crates/slot-store/src/nes.rs
new file mode 100644
index 0000000..d265ed0
--- /dev/null
+++ b/crates/slot-store/src/nes.rs
@@ -0,0 +1,75 @@
+use crate::Outline;
+
+const WESTERN: [&str; 3] = ["USA", "Europe", "World"];
+const GOODTOOLS: [(char, &str); 3] = [('J', "Japan"), ('U', "USA"), ('E', "Europe")];
+
+pub fn outline(stem: &str) -> Outline {
+    let mut japan = false;
+    for tag in tags(stem).flat_map(regions) {
+        if tag == "Japan" {
+            japan = true;
+        } else if WESTERN.contains(&tag) {
+            return Outline::Nes;
+        }
+    }
+    if japan {
+        Outline::Famicom
+    } else {
+        Outline::Nes
+    }
+}
+
+fn tags(stem: &str) -> impl Iterator<Item = &str> {
+    stem.split('(')
+        .skip(1)
+        .filter_map(|part| part.split(')').next())
+        .flat_map(|group| group.split(','))
+        .map(str::trim)
+}
+
+fn regions(tag: &str) -> Vec<&str> {
+    let short: Option<Vec<&str>> = tag
+        .chars()
+        .map(|c| {
+            GOODTOOLS
+                .iter()
+                .find(|(code, _)| *code == c)
+                .map(|(_, name)| *name)
+        })
+        .collect();
+    match short {
+        Some(names) if !names.is_empty() => names,
+        _ => vec![tag],
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tags_are_read_from_every_bracket_group() {
+        assert_eq!(
+            tags("Game (Japan, USA) (Rev 1)").collect::<Vec<_>>(),
+            ["Japan", "USA", "Rev 1"]
+        );
+    }
+
+    #[test]
+    fn an_unclosed_bracket_still_yields_its_text() {
+        assert_eq!(tags("Game (Japan").collect::<Vec<_>>(), ["Japan"]);
+    }
+
+    #[test]
+    fn a_goodtools_code_reads_as_its_regions() {
+        assert_eq!(regions("J"), ["Japan"]);
+        assert_eq!(regions("JU"), ["Japan", "USA"]);
+        assert_eq!(regions("UK"), ["UK"]);
+        assert_eq!(regions(""), [""]);
+    }
+
+    #[test]
+    fn a_stem_with_no_brackets_has_no_tags() {
+        assert_eq!(tags("Game").count(), 0);
+    }
+}
