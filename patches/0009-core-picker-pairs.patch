+#![cfg(target_os = "macos")]
+
+mod common;
+
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+use slot::app::App;
+use slot::core_faces::PairFaces;
+use slot_gfx::{Compositor, HeadlessSurface, TexId};
+use slot_input::{Action, Btn};
+use slot_store::{read_selected_cores, write_slot_state, Core, SlotState};
+use slot_ui::{
+    arrows_hint_face, board_face, cart_face, cart_shadow, chip_face, chip_shadow_face, hint_face,
+    padded, socket_face, CartFace, TURN_PAD,
+};
+use tempfile::TempDir;
+
+static GL: Mutex<()> = Mutex::new(());
+
+fn compositor() -> Option<(MutexGuard<'static, ()>, HeadlessSurface, Compositor)> {
+    let guard = GL.lock().unwrap_or_else(PoisonError::into_inner);
+    let surface = HeadlessSurface::new().ok()?;
+    let compositor = Compositor::new(&surface).ok()?;
+    Some((guard, surface, compositor))
+}
+
+fn tex(c: &mut Compositor, f: &CartFace) -> TexId {
+    c.create_texture(f.w, f.h, &f.rgba)
+}
+
+fn nes_root() -> TempDir {
+    let d = tempfile::tempdir().expect("tempdir");
+    for sub in slot::root::DIRS {
+        std::fs::create_dir(d.path().join(sub)).expect("create content dir");
+    }
+    let mut rom = vec![0u8; 16 + 0x4000 + 0x2000];
+    rom[..4].copy_from_slice(b"NES\x1a");
+    rom[4] = 1;
+    rom[5] = 1;
+    for stem in ["Contra", "Zelda"] {
+        std::fs::write(d.path().join(format!("Games/NES/{stem}.nes")), &rom).expect("write rom");
+    }
+    write_slot_state(
+        d.path(),
+        &SlotState {
+            clock_set: true,
+            ..Default::default()
+        },
+    )
+    .unwrap();
+    d
+}
+
+fn faces_for(c: &mut Compositor, cores: &[Core]) -> (Vec<TexId>, Vec<TexId>) {
+    let sockets = cores.iter().map(|k| tex(c, &socket_face(*k))).collect();
+    let chips = cores.iter().map(|k| tex(c, &chip_face(Some(*k)))).collect();
+    (sockets, chips)
+}
+
+fn seat_board(app: &mut App, c: &mut Compositor) {
+    let row: Vec<TexId> = app.carts().map(|cart| tex(c, &cart_face(cart))).collect();
+    app.set_faces(row);
+    app.set_cart_shadow(tex(c, &cart_shadow()));
+    let blank = tex(c, &chip_face(None));
+    let shadow = tex(c, &chip_shadow_face());
+    let (sockets, chips) = faces_for(c, &Core::ALL);
+    app.set_core_part_faces(sockets, chips, blank, shadow);
+    let legend = [
+        hint_face("B", "Cancel"),
+        arrows_hint_face("Swap"),
+        hint_face("A", "Choose"),
+    ]
+    .iter()
+    .map(|f| (c.create_texture(f.w, f.h, &f.rgba), f.w))
+    .collect();
+    app.set_core_legend_faces(legend);
+    seat_board_faces(app, c);
+}
+
+fn seat_board_faces(app: &mut App, c: &mut Compositor) {
+    let highlighted = app.selected_stem().map(str::to_string);
+    let cart = app
+        .carts()
+        .find(|k| highlighted.as_deref() == Some(k.stem.as_str()))
+        .cloned()
+        .expect("a nes cart on the shelf");
+    let board = tex(c, &board_face(&cart));
+    let lid = tex(c, &padded(&cart_face(&cart), TURN_PAD));
+    app.set_core_board_faces(board, lid);
+}
+
+struct Parts {
+    sockets: Vec<TexId>,
+    chips: Vec<TexId>,
+    blank: TexId,
+    shadow: TexId,
+}
+
+impl Parts {
+    fn upload(c: &mut Compositor) -> Parts {
+        let (sockets, chips) = faces_for(c, &Core::EVERY);
+        Parts {
+            sockets,
+            chips,
+            blank: tex(c, &chip_face(None)),
+            shadow: tex(c, &chip_shadow_face()),
+        }
+    }
+
+    fn faces(&self) -> PairFaces {
+        PairFaces::new(
+            self.sockets.clone(),
+            self.chips.clone(),
+            self.blank,
+            self.shadow,
+        )
+    }
+
+    fn set(&self, app: &mut App, pair: [Core; 2]) {
+        self.faces().show((pair[0], pair[1]), app);
+    }
+}
+
+fn picker_over_nes(d: &TempDir, c: &mut Compositor) -> App {
+    let mut app = App::boot(d.path());
+    seat_board(&mut app, c);
+    app.apply(Action::GbaDown(Btn::Start));
+    app.update(0.5);
+    app
+}
+
+fn shot(app: &App, c: &mut Compositor) -> Vec<u8> {
+    let mut out = Vec::new();
+    app.draw(&mut out);
+    c.begin_frame();
+    c.draw_list(&out);
+    c.read_frame()
+}
+
+fn same(a: &[u8], b: &[u8]) -> bool {
+    a.len() == b.len() && a.iter().zip(b).all(|(u, v)| u.abs_diff(*v) <= 2)
+}
+
+fn spread(a: &[u8], b: &[u8]) -> String {
+    let w = slot_gfx::OUT_W as usize;
+    let mut n = 0;
+    let mut hi = 0;
+    let (mut x0, mut y0, mut x1, mut y1) = (usize::MAX, usize::MAX, 0, 0);
+    for (i, (p, q)) in a.chunks(4).zip(b.chunks(4)).enumerate() {
+        if p != q {
+            let (x, y) = (i % w, i / w);
+            n += 1;
+            hi = hi.max(
+                p.iter()
+                    .zip(q)
+                    .map(|(u, v)| u.abs_diff(*v))
+                    .max()
+                    .unwrap_or(0),
+            );
+            (x0, y0, x1, y1) = (x0.min(x), y0.min(y), x1.max(x), y1.max(y));
+        }
+    }
+    format!("{n} px differ, max channel delta {hi}, box x {x0}..{x1} y {y0}..{y1}")
+}
+
+#[test]
+fn right_then_a_on_a_nes_cart_writes_nestopia() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        eprintln!("no GL on this host, skipping");
+        return;
+    };
+    let d = nes_root();
+    let mut app = picker_over_nes(&d, &mut c);
+    assert_eq!(app.core_picker(), Some(Core::Fceumm));
+    assert_eq!(app.core_picker_chip().map(|k| k.across), Some(0.0));
+    app.apply(Action::GbaDown(Btn::Right));
+    app.update(0.25);
+    assert_eq!(app.core_picker(), Some(Core::Nestopia));
+    assert_eq!(app.core_picker_chip().map(|k| k.across), Some(1.0));
+    app.apply(Action::GbaDown(Btn::A));
+    app.update(0.5);
+    assert_eq!(
+        read_selected_cores(d.path()).get("Contra"),
+        Some(&Core::Nestopia)
+    );
+    let text = std::fs::read_to_string(d.path().join("Config/selected_core.txt")).unwrap();
+    assert!(text.contains("Contra = nestopia"), "{text}");
+}
+
+#[test]
+fn the_nes_picker_draws_fceumm_and_nestopia_sockets_and_chips() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        eprintln!("no GL on this host, skipping");
+        return;
+    };
+    let d = nes_root();
+    let mut app = picker_over_nes(&d, &mut c);
+    let parts = Parts::upload(&mut c);
+    let mut faces = parts.faces();
+    faces.follow(&mut app);
+    let ours = shot(&app, &mut c);
+
+    parts.set(&mut app, [Core::Fceumm, Core::Nestopia]);
+    let nes = shot(&app, &mut c);
+    assert!(
+        same(&ours, &nes),
+        "the NES picker did not draw FCEUmm and Nestopia: {}",
+        spread(&ours, &nes)
+    );
+
+    parts.set(&mut app, [Core::Mgba, Core::Gpsp]);
+    assert!(
+        !same(&ours, &shot(&app, &mut c)),
+        "the NES picker drew the GBA faces"
+    );
+}
+
+#[test]
+fn the_chip_wears_nestopia_after_the_swap() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        eprintln!("no GL on this host, skipping");
+        return;
+    };
+    let d = nes_root();
+    let mut app = picker_over_nes(&d, &mut c);
+    let mut faces = Parts::upload(&mut c).faces();
+    faces.follow(&mut app);
+    let before = shot(&app, &mut c);
+    app.apply(Action::GbaDown(Btn::Right));
+    app.update(0.25);
+    let after = shot(&app, &mut c);
+    assert!(!same(&before, &after), "the chip did not move to Nestopia");
+    app.apply(Action::GbaDown(Btn::Left));
+    app.update(0.25);
+    let home = shot(&app, &mut c);
+    assert!(
+        same(&before, &home),
+        "the chip did not come home: {}",
+        spread(&before, &home)
+    );
+}
+
+fn mixed_root() -> TempDir {
+    let d = nes_root();
+    let mut rom = vec![0u8; 0x100];
+    rom[0xa0..0xa7].copy_from_slice(b"EMERALD");
+    std::fs::write(d.path().join("Games/GBA/Emerald.gba"), rom).expect("write gba rom");
+    d
+}
+
+fn open_shoot_close(
+    app: &mut App,
+    c: &mut Compositor,
+    parts: &Parts,
+    faces: &mut PairFaces,
+    stem: &str,
+    pair: [Core; 2],
+) -> (Vec<u8>, Vec<u8>) {
+    for _ in 0..4 {
+        if app.selected_stem() == Some(stem) {
+            break;
+        }
+        app.apply(Action::GbaDown(Btn::R1));
+        app.update(0.5);
+    }
+    assert_eq!(app.selected_stem(), Some(stem));
+    seat_board_faces(app, c);
+    app.apply(Action::GbaDown(Btn::Start));
+    app.update(0.5);
+    faces.follow(app);
+    let ours = shot(app, c);
+    parts.set(app, pair);
+    let reference = shot(app, c);
+    app.apply(Action::GbaDown(Btn::B));
+    app.update(0.5);
+    assert_eq!(app.core_picker(), None);
+    (ours, reference)
+}
+
+#[test]
+fn the_picker_redraws_gba_faces_after_a_nes_visit_in_one_process() {
+    let (_g, _s, mut c) = compositor().expect("a GL surface is required");
+    let d = mixed_root();
+    let mut app = App::boot(d.path());
+    seat_board(&mut app, &mut c);
+    let parts = Parts::upload(&mut c);
+    let mut faces = parts.faces();
+    let gba = [Core::Mgba, Core::Gpsp];
+    let nes = [Core::Fceumm, Core::Nestopia];
+    let (gba_first, gba_ref) =
+        open_shoot_close(&mut app, &mut c, &parts, &mut faces, "Emerald", gba);
+    assert!(
+        same(&gba_first, &gba_ref),
+        "first GBA picker drew the wrong faces: {}",
+        spread(&gba_first, &gba_ref)
+    );
+    let (nes_shot, nes_ref) = open_shoot_close(&mut app, &mut c, &parts, &mut faces, "Contra", nes);
+    assert!(
+        same(&nes_shot, &nes_ref),
+        "the NES picker drew the wrong faces: {}",
+        spread(&nes_shot, &nes_ref)
+    );
+    assert!(
+        !same(&nes_shot, &gba_first),
+        "the NES and GBA pickers look alike"
+    );
+    let (gba_last, gba_ref) =
+        open_shoot_close(&mut app, &mut c, &parts, &mut faces, "Emerald", gba);
+    assert!(
+        same(&gba_last, &gba_ref),
+        "the GBA picker kept the NES faces: {}",
+        spread(&gba_last, &gba_ref)
+    );
+    assert!(
+        same(&gba_last, &gba_first),
+        "the GBA picker changed between visits: {}",
+        spread(&gba_last, &gba_first)
+    );
+}
