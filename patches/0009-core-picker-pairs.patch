@@ -0,0 +1,131 @@
+mod common;
+mod core_common;
+mod nes_common;
+mod snes_common;
+
+use std::path::PathBuf;
+
+use common::core_lock;
+use core_common::require_core;
+use nes_common::{fceumm, nes_rom};
+use slot::core::open_core_for;
+use slot_retro::{ButtonMask, MockCore, RetroCore};
+use slot_store::Core;
+use snes_common::{snes_rom, Map, SNES_TITLE};
+
+const PICTURE_X: usize = 52;
+const PICTURE_W: usize = 256;
+const NES_PICTURE_Y: usize = 0;
+const NES_PICTURE_H: usize = 240;
+const SNES_PICTURE_Y: usize = 8;
+const SNES_PICTURE_H: usize = 224;
+const FCEUMM_BACKDROP_BGRX: [u8; 4] = [0x20, 0x20, 0xd0, 0];
+const NESTOPIA_BACKDROP_BGRX: [u8; 4] = [32, 49, 181, 0];
+const SNES_HZ: f64 = 32040.0;
+const SNES9X_RED_BGRX: [u8; 4] = [57, 199, 255, 0];
+const SNES9X_2005_PLUS_RED_BGRX: [u8; 4] = [57, 195, 255, 0];
+
+fn red_backdrop_rom(name: &str) -> PathBuf {
+    let path = snes_rom(name, Map::Lo, false, 0);
+    let mut rom = std::fs::read(&path).expect("read rom");
+    let program = [
+        0x78, 0x18, 0xfb, 0xa9, 0x00, 0x8d, 0x21, 0x21, 0xa9, 0x1f, 0x8d, 0x22, 0x21, 0x8d, 0x22,
+        0x21, 0xa9, 0x0f, 0x8d, 0x00, 0x21, 0x4c, 0x15, 0x80,
+    ];
+    rom[..program.len()].copy_from_slice(&program);
+    rom[0x7fdc..0x7fe0].copy_from_slice(&[0xff, 0xff, 0, 0]);
+    let sum = rom.iter().fold(0u16, |a, b| a.wrapping_add(u16::from(*b)));
+    rom[0x7fdc..0x7fde].copy_from_slice(&(!sum).to_le_bytes());
+    rom[0x7fde..0x7fe0].copy_from_slice(&sum.to_le_bytes());
+    std::fs::write(&path, rom).expect("write rom");
+    path
+}
+
+fn pixel(video: &[u8], x: usize, y: usize) -> [u8; 4] {
+    let at = (y * 360 + x) * 4;
+    [video[at], video[at + 1], video[at + 2], video[at + 3]]
+}
+
+fn booted_video(core: Core, dylib: PathBuf, rom: PathBuf) -> Vec<u8> {
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut opened = open_core_for(d.path(), core, "auto", false, &[dylib]);
+    opened
+        .load(&rom)
+        .unwrap_or_else(|e| panic!("{} refused the {SNES_TITLE} cart: {e}", core.as_str()));
+    for _ in 0..60 {
+        opened.run_frame(ButtonMask::default());
+    }
+    assert_eq!(opened.canvas(), (360, 240));
+    opened.video_xrgb8888().to_vec()
+}
+
+fn assert_uniform_picture(video: &[u8], y0: usize, h: usize, want: [u8; 4]) {
+    assert_eq!(video.len(), 360 * 240 * 4);
+    for y in 0..240 {
+        for x in 0..360 {
+            let inside =
+                (PICTURE_X..PICTURE_X + PICTURE_W).contains(&x) && (y0..y0 + h).contains(&y);
+            let expected = if inside { want } else { [0; 4] };
+            assert_eq!(pixel(video, x, y), expected, "pixel {x},{y}");
+        }
+    }
+    assert_ne!(
+        video,
+        MockCore::sized((360, 240)).video_xrgb8888(),
+        "the mock ran with the core sitting right there"
+    );
+}
+
+#[test]
+fn nestopia_boots_a_generated_nes_cart_in_its_own_colours() {
+    let _g = core_lock();
+    let (Some(dylib), Some(_)) = (require_core("nestopia"), fceumm()) else {
+        return;
+    };
+    let video = booted_video(Core::Nestopia, dylib, nes_rom("alt_nestopia.nes", false));
+    assert_uniform_picture(&video, NES_PICTURE_Y, NES_PICTURE_H, NESTOPIA_BACKDROP_BGRX);
+    assert_ne!(NESTOPIA_BACKDROP_BGRX, FCEUMM_BACKDROP_BGRX);
+}
+
+#[test]
+fn snes9x_2005_plus_boots_a_generated_snes_cart_in_its_own_colours() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("snes9x2005_plus") else {
+        return;
+    };
+    let video = booted_video(
+        Core::Snes9x2005Plus,
+        dylib,
+        red_backdrop_rom("alt_snes9x_2005_plus.sfc"),
+    );
+    assert_uniform_picture(
+        &video,
+        SNES_PICTURE_Y,
+        SNES_PICTURE_H,
+        SNES9X_2005_PLUS_RED_BGRX,
+    );
+    assert_ne!(SNES9X_2005_PLUS_RED_BGRX, SNES9X_RED_BGRX);
+}
+
+#[test]
+fn snes9x_2005_plus_runs_both_rom_layouts() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("snes9x2005_plus") else {
+        return;
+    };
+    for (name, map) in [("alt_2005_lo.sfc", Map::Lo), ("alt_2005_hi.sfc", Map::Hi)] {
+        let d = common::tmp_root_with_real_carts(&[]);
+        let mut core = open_core_for(
+            d.path(),
+            Core::Snes9x2005Plus,
+            "auto",
+            false,
+            std::slice::from_ref(&dylib),
+        );
+        core.load(&snes_rom(name, map, false, 0))
+            .unwrap_or_else(|e| panic!("snes9x2005_plus refused {name}: {e}"));
+        core.run_frame(ButtonMask::default());
+        let hz = core.av_info().sample_rate;
+        assert!((hz - SNES_HZ).abs() < 1.0, "{name} reports {hz} Hz");
+    }
+}
