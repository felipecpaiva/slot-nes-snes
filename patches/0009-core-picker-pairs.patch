@@ -0,0 +1,46 @@
+use slot_gfx::TexId;
+use slot_store::Core;
+
+use crate::app::App;
+
+pub struct PairFaces {
+    sockets: Vec<TexId>,
+    chips: Vec<TexId>,
+    blank: TexId,
+    shadow: TexId,
+    shown: Option<(Core, Core)>,
+}
+
+impl PairFaces {
+    pub fn new(sockets: Vec<TexId>, chips: Vec<TexId>, blank: TexId, shadow: TexId) -> Self {
+        PairFaces {
+            sockets,
+            chips,
+            blank,
+            shadow,
+            shown: None,
+        }
+    }
+
+    pub fn show(&mut self, pair: (Core, Core), app: &mut App) {
+        if self.shown == Some(pair) {
+            return;
+        }
+        let sockets: Vec<TexId> = [pair.0, pair.1]
+            .iter()
+            .filter_map(|core| self.sockets.get(core.index()).copied())
+            .collect();
+        if sockets.len() != 2 {
+            eprintln!("slot: core: no socket faces for {}", pair.0.as_str());
+            return;
+        }
+        app.set_core_part_faces(sockets, self.chips.clone(), self.blank, self.shadow);
+        self.shown = Some(pair);
+    }
+
+    pub fn follow(&mut self, app: &mut App) {
+        if let Some(seat) = app.core_picker() {
+            self.show(seat.pair(), app);
+        }
+    }
+}
