@@ -0,0 +1,24 @@
+use slot_store::{Core, Platform};
+
+#[test]
+fn every_picker_pair_is_the_pair_of_both_its_cores() {
+    for platform in Platform::SHELVES {
+        if let Some((left, right)) = platform.picker_cores() {
+            assert_eq!(left.pair(), (left, right));
+            assert_eq!(right.pair(), (left, right));
+            assert!(left.runs(platform) && right.runs(platform));
+        }
+    }
+}
+
+#[test]
+fn the_pinned_core_list_stays_two_while_every_lists_six() {
+    assert_eq!(Core::ALL.len(), 2);
+    assert_eq!(Core::EVERY.len(), 6);
+    assert_eq!(
+        Platform::Nes.picker_cores(),
+        Some((Core::Fceumm, Core::Nestopia))
+    );
+    assert_eq!(Platform::Gb.picker_cores(), None);
+    assert_eq!(Platform::Gbc.picker_cores(), None);
+}
