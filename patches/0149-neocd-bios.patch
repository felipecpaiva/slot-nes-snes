diff --git a/crates/slot/src/neocd_bios.rs b/crates/slot/src/neocd_bios.rs
new file mode 100644
index 0000000..e683a6c
--- /dev/null
+++ b/crates/slot/src/neocd_bios.rs
@@ -0,0 +1,61 @@
+use std::path::Path;
+
+use slot_retro::RetroCore;
+use slot_store::neocd::Model;
+use slot_store::{ini, Platform};
+use slot_ui::{QuickRow, QuickValue};
+
+use crate::card_log::CardWrites;
+
+pub const NEOCD_FILE: &str = "Config/neocd.txt";
+
+const KEY: &str = "bios";
+const OPTION: &str = "neocd_bios";
+
+pub fn read(root: &Path) -> Model {
+    let Some(line) = ini::value(root, NEOCD_FILE, KEY) else {
+        return Model::default();
+    };
+    Model::parse(&line).unwrap_or_else(|| {
+        eprintln!("slot: neocd.txt: ignoring {KEY}={line}");
+        Model::default()
+    })
+}
+
+pub fn prepare(core: &mut dyn RetroCore, root: &Path, platform: Platform) {
+    if platform == Platform::Neocd {
+        core.set_option(OPTION, read(root).option_value());
+    }
+}
+
+pub fn quick_value(model: Model) -> QuickValue {
+    match model {
+        Model::Cdz => QuickValue::Cdz,
+        Model::Front => QuickValue::FrontLoader,
+        Model::Top => QuickValue::TopLoader,
+    }
+}
+
+pub fn change(
+    model: &mut Model,
+    row: QuickRow,
+    right: bool,
+    root: Option<&Path>,
+    writes: &CardWrites,
+) -> bool {
+    if row != QuickRow::NeocdBios {
+        return false;
+    }
+    let all = Model::ALL;
+    let at = all.iter().position(|m| m == model).unwrap_or(0);
+    let step = if right { 1 } else { all.len() - 1 };
+    *model = all[(at + step) % all.len()];
+    if let Some(root) = root {
+        let written = ini::write(root, NEOCD_FILE, KEY, model.as_str());
+        if let Err(e) = &written {
+            eprintln!("slot: neocd: could not write neocd.txt: {e}");
+        }
+        writes.wrote("neocd.txt", &written);
+    }
+    true
+}
