diff --git a/crates/slot-store/src/neocd.rs b/crates/slot-store/src/neocd.rs
new file mode 100644
index 0000000..9a48d2c
--- /dev/null
+++ b/crates/slot-store/src/neocd.rs
@@ -0,0 +1,73 @@
+use std::path::{Path, PathBuf};
+
+use crate::lynx::{crc32, Bios};
+
+pub const BIOS_DIR: &str = "neocd";
+const BIOS_BYTES: usize = 524_288;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum Model {
+    #[default]
+    Cdz,
+    Front,
+    Top,
+}
+
+impl Model {
+    pub const ALL: [Model; 3] = [Model::Cdz, Model::Front, Model::Top];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Model::Cdz => "cdz",
+            Model::Front => "front",
+            Model::Top => "top",
+        }
+    }
+
+    pub fn parse(s: &str) -> Option<Model> {
+        Model::ALL.into_iter().find(|m| m.as_str() == s)
+    }
+
+    pub fn file(self) -> &'static str {
+        match self {
+            Model::Cdz => "neocd.bin",
+            Model::Front => "front-sp1.bin",
+            Model::Top => "top-sp1.bin",
+        }
+    }
+
+    pub fn crc32(self) -> u32 {
+        match self {
+            Model::Cdz => 0xdf9d_e490,
+            Model::Front => 0xcac6_2307,
+            Model::Top => 0xc36a_47c0,
+        }
+    }
+
+    pub fn option_value(self) -> &'static str {
+        match self {
+            Model::Cdz => "neocd.bin (CDZ)",
+            Model::Front => "front-sp1.bin (Front Loader)",
+            Model::Top => "top-sp1.bin (Top Loader)",
+        }
+    }
+}
+
+pub fn bios_path(bios_dir: &Path, model: Model) -> PathBuf {
+    bios_dir.join(BIOS_DIR).join(model.file())
+}
+
+pub fn bios(bios_dir: &Path, model: Model) -> Bios {
+    match std::fs::read(bios_path(bios_dir, model)) {
+        Ok(bytes) => bios_of(&bytes, model),
+        Err(_) => Bios::Missing,
+    }
+}
+
+pub fn bios_of(bytes: &[u8], model: Model) -> Bios {
+    match (bytes.len(), crc32(bytes) == model.crc32()) {
+        (BIOS_BYTES, true) => Bios::Known,
+        (BIOS_BYTES, false) => Bios::Unknown,
+        _ => Bios::Missing,
+    }
+}
