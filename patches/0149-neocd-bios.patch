+// A Neo Geo CD boots one of the three console BIOSes in BIOS/neocd/, which slot never ships or fetches
+// (ADR 0107). Without one NeoCD would boot its own incomplete high-level BIOS with no error, so slot
+// checks the file of the model the Screen section names before the disc goes in, like the PC Engine CD.
+// The model is a row of its own, CDZ by default (the fastest loads), kept in Config/neocd.txt, and NeoCD
+// is told it as the "<file> (<model>)" value it declares.
+mod common;
+mod core_common;
+mod neocd_common;
+
+use std::path::Path;
+
+use common::tmp_root_with_carts;
+use neocd_common::{disc, placeholder_bios, MODELS};
+use slot::app::{App, Phase};
+use slot_input::{Action, Btn};
+use slot_retro::LibretroCore;
+use slot_store::lynx::Bios;
+use slot_store::neocd::{bios, bios_of, Model};
+use slot_store::{write_slot_state, Platform, SlotState};
+use slot_ui::{NeocdToast, QuickRow, QuickValue, SegaCdToast, Toast};
+use tempfile::TempDir;
+
+const STEM: &str = "Samurai Shodown RPG (Japan) (En)";
+
+fn card(files: &[(&str, Vec<u8>)]) -> TempDir {
+    let d = tmp_root_with_carts(&[]);
+    disc(&d.path().join("Games/NEOCD"), STEM);
+    let dir = slot::root::bios_dir(d.path()).join("neocd");
+    std::fs::create_dir_all(&dir).unwrap();
+    for (name, bytes) in files {
+        std::fs::write(dir.join(name), bytes).unwrap();
+    }
+    d
+}
+
+fn placeholders() -> Vec<(&'static str, Vec<u8>)> {
+    MODELS
+        .into_iter()
+        .map(|(name, family)| (name, placeholder_bios(family)))
+        .collect()
+}
+
+fn boot_on(root: &Path, cart: Option<&str>) -> App {
+    write_slot_state(
+        root,
+        &SlotState {
+            clock_set: true,
+            cart: cart.map(str::to_string),
+            cart_platform: cart.map(|_| Platform::Neocd),
+            ..SlotState::default()
+        },
+    )
+    .expect("write slot.state");
+    App::boot(root)
+}
+
+fn press(a: &mut App, btn: Btn) {
+    a.apply(Action::GbaDown(btn));
+    a.apply(Action::GbaUp(btn));
+}
+
+fn insert(a: &mut App) {
+    press(a, Btn::A);
+    for _ in 0..10 {
+        a.update(1.0 / 60.0);
+    }
+}
+
+fn inserting(a: &App) -> bool {
+    matches!(a.phase(), Phase::Inserting { .. } | Phase::Playing { .. })
+}
+
+#[test]
+fn each_model_names_its_file_its_crc_and_the_value_neocd_declares() {
+    assert_eq!(Model::default(), Model::Cdz);
+    assert_eq!(
+        Model::ALL.map(Model::file),
+        ["neocd.bin", "front-sp1.bin", "top-sp1.bin"]
+    );
+    assert_eq!(
+        Model::ALL.map(Model::crc32),
+        [0xdf9d_e490, 0xcac6_2307, 0xc36a_47c0]
+    );
+    assert_eq!(
+        Model::ALL.map(Model::option_value),
+        [
+            "neocd.bin (CDZ)",
+            "front-sp1.bin (Front Loader)",
+            "top-sp1.bin (Top Loader)"
+        ]
+    );
+    for m in Model::ALL {
+        assert_eq!(Model::parse(m.as_str()), Some(m));
+    }
+    assert_eq!(Model::parse("unibios"), None);
+}
+
+#[test]
+fn neocd_declares_exactly_the_values_slot_sends() {
+    let _g = common::core_lock();
+    let Some(dylib) = neocd_common::neocd() else {
+        return;
+    };
+    let d = card(&placeholders());
+    let core = LibretroCore::open_with(&dylib, &slot::root::bios_dir(d.path()), d.path())
+        .expect("open neocd");
+    let declared = core.declared_options().get("neocd_bios").cloned();
+    let mut want: Vec<String> = Model::ALL.map(|m| m.option_value().to_string()).to_vec();
+    want.sort();
+    assert_eq!(declared, Some(want));
+}
+
+#[test]
+fn the_check_reads_missing_short_long_and_unknown_files() {
+    let d = tempfile::tempdir().unwrap();
+    assert_eq!(bios(d.path(), Model::Cdz), Bios::Missing);
+    std::fs::create_dir_all(d.path().join("neocd")).unwrap();
+    for (bytes, want) in [
+        (vec![], Bios::Missing),
+        (vec![0u8; 262_144], Bios::Missing),
+        (vec![0u8; 524_289], Bios::Missing),
+        (vec![0u8; 524_288], Bios::Unknown),
+    ] {
+        std::fs::write(d.path().join("neocd/neocd.bin"), &bytes).unwrap();
+        assert_eq!(bios(d.path(), Model::Cdz), want, "{} bytes", bytes.len());
+    }
+    assert_eq!(bios(d.path(), Model::Front), Bios::Missing);
+}
+
+#[test]
+fn the_maintainers_own_bios_files_are_the_known_dumps() {
+    let d = tempfile::tempdir().unwrap();
+    if !neocd_common::real_bios(d.path()) {
+        return;
+    }
+    for m in Model::ALL {
+        let bytes = std::fs::read(neocd_common::bios_dir(d.path()).join(m.file())).unwrap();
+        assert_eq!(bios_of(&bytes, m), Bios::Known, "{m:?}");
+    }
+}
+
+#[test]
+fn with_no_bios_a_disc_stays_on_the_shelf_with_a_toast_naming_the_file() {
+    let d = card(&[]);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    let t = Toast::Neocd(NeocdToast::NeedsBios(Model::Cdz));
+    assert_eq!(a.toast(), Some(t));
+    assert_eq!(t.text(), "Neo Geo CD needs BIOS/neocd/neocd.bin");
+}
+
+#[test]
+fn the_other_models_files_do_not_stand_in_for_the_chosen_one() {
+    let d = card(&placeholders()[..1]);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(
+        a.toast(),
+        Some(Toast::Neocd(NeocdToast::NeedsBios(Model::Cdz)))
+    );
+}
+
+#[test]
+fn a_disc_resumed_at_boot_is_checked_too() {
+    let d = card(&[("neocd.bin", vec![0u8; 100])]);
+    let a = boot_on(d.path(), Some(STEM));
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(
+        a.toast(),
+        Some(Toast::Neocd(NeocdToast::NeedsBios(Model::Cdz)))
+    );
+}
+
+#[test]
+fn an_unknown_bios_launches_and_says_so() {
+    let d = card(&placeholders());
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(
+        a.toast(),
+        Some(Toast::Neocd(NeocdToast::UnknownBios(Model::Cdz)))
+    );
+}
+
+#[test]
+fn a_known_bios_launches_with_no_toast() {
+    let d = card(&[]);
+    if !neocd_common::real_bios(d.path()) {
+        return;
+    }
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), None);
+}
+
+fn open_bios_row(a: &mut App) {
+    a.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&a.hidden_rows()) {
+        press(a, Btn::Down);
+    }
+    press(a, Btn::A);
+    for _ in 0..QuickRow::ScreenNeocd.position(&a.hidden_rows()) {
+        press(a, Btn::Down);
+    }
+    press(a, Btn::A);
+    press(a, Btn::Down);
+    press(a, Btn::Down);
+    assert_eq!(a.quick_menu(), Some(QuickRow::NeocdBios));
+}
+
+#[test]
+fn the_bios_row_walks_cdz_front_top_into_neocd_txt_and_the_check_follows_it() {
+    assert_eq!(QuickRow::NeocdBios.label(), "BIOS");
+    assert_eq!(QuickRow::SCREEN_NEOCD[2], QuickRow::NeocdBios);
+    let d = card(&placeholders()[..1]);
+    let mut a = boot_on(d.path(), None);
+    open_bios_row(&mut a);
+    assert_eq!(a.quick_value(QuickRow::NeocdBios), Some(QuickValue::Cdz));
+    for (btn, want, word) in [
+        (Btn::Right, QuickValue::FrontLoader, "front"),
+        (Btn::Right, QuickValue::TopLoader, "top"),
+        (Btn::Right, QuickValue::Cdz, "cdz"),
+        (Btn::Left, QuickValue::TopLoader, "top"),
+    ] {
+        press(&mut a, btn);
+        assert_eq!(a.quick_value(QuickRow::NeocdBios), Some(want));
+        assert_eq!(
+            std::fs::read_to_string(d.path().join(slot::neocd_bios::NEOCD_FILE)).unwrap(),
+            format!("bios = {word}\n")
+        );
+    }
+    assert_eq!(QuickValue::FrontLoader.text(), "Front Loader");
+    let d2 = card(&placeholders()[..1]);
+    std::fs::create_dir_all(d2.path().join("Config")).unwrap();
+    std::fs::write(
+        d2.path().join(slot::neocd_bios::NEOCD_FILE),
+        "bios = front\n",
+    )
+    .unwrap();
+    let mut b = boot_on(d2.path(), None);
+    insert(&mut b);
+    assert!(inserting(&b), "{:?}", b.phase());
+    assert_eq!(
+        b.toast(),
+        Some(Toast::Neocd(NeocdToast::UnknownBios(Model::Front)))
+    );
+}
+
+#[test]
+fn the_model_is_sent_to_neocd_before_the_disc_loads() {
+    let _g = common::core_lock();
+    let Some(dylib) = neocd_common::neocd() else {
+        return;
+    };
+    let d = card(&placeholders());
+    std::fs::create_dir_all(d.path().join("Config")).unwrap();
+    std::fs::write(d.path().join(slot::neocd_bios::NEOCD_FILE), "bios = top\n").unwrap();
+    let mut core = LibretroCore::open_with(&dylib, &slot::root::bios_dir(d.path()), d.path())
+        .expect("open neocd");
+    slot::neocd_bios::prepare(&mut core, d.path(), Platform::Neocd);
+    assert_eq!(
+        core.option("neocd_bios").as_deref(),
+        Some("top-sp1.bin (Top Loader)")
+    );
+    drop(core);
+    let mut other = LibretroCore::open_with(&dylib, &slot::root::bios_dir(d.path()), d.path())
+        .expect("open neocd");
+    slot::neocd_bios::prepare(&mut other, d.path(), Platform::NeoGeo);
+    assert_eq!(other.option("neocd_bios"), None);
+    std::fs::write(
+        d.path().join(slot::neocd_bios::NEOCD_FILE),
+        "bios = unibios\n",
+    )
+    .unwrap();
+    assert_eq!(slot::neocd_bios::read(d.path()), Model::Cdz);
+}
+
+#[test]
+fn the_bios_row_is_hidden_while_a_neo_geo_cd_game_plays() {
+    assert!(
+        slot::retro_quick::hidden_in_game(Platform::Neocd, false).contains(&QuickRow::NeocdBios)
+    );
+    assert!(
+        !slot::retro_quick::hidden_in_game(Platform::NeoGeo, false).contains(&QuickRow::NeocdBios)
+    );
+}
+
+#[test]
+fn the_neo_geo_cd_toasts_upload_in_their_own_place_after_the_sega_cd_ones() {
+    let every = Toast::every();
+    for n in NeocdToast::ALL {
+        let t = Toast::Neocd(n);
+        assert_eq!(every.get(t.index()), Some(&t), "{n:?}");
+    }
+    assert_eq!(
+        Toast::Neocd(NeocdToast::ALL[0]).index(),
+        Toast::SegaCd(SegaCdToast::ALL[SegaCdToast::ALL.len() - 1]).index() + 1
+    );
+    assert_eq!(
+        every.len(),
+        Toast::Neocd(NeocdToast::ALL[NeocdToast::ALL.len() - 1]).index() + 1
+    );
+}
