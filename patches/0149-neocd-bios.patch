new file mode 100644
index 0000000..f1af06a
--- /dev/null
+++ b/crates/slot-ui/src/neocd_toast.rs
@@ -0,0 +1,41 @@
+use slot_store::neocd::Model;
+
+use crate::Toast;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum NeocdToast {
+    NeedsBios(Model),
+    UnknownBios(Model),
+}
+
+impl NeocdToast {
+    pub const ALL: [NeocdToast; 6] = [
+        NeocdToast::NeedsBios(Model::Cdz),
+        NeocdToast::NeedsBios(Model::Front),
+        NeocdToast::NeedsBios(Model::Top),
+        NeocdToast::UnknownBios(Model::Cdz),
+        NeocdToast::UnknownBios(Model::Front),
+        NeocdToast::UnknownBios(Model::Top),
+    ];
+
+    pub fn index(self) -> usize {
+        Self::ALL.iter().position(|t| *t == self).unwrap_or(0)
+    }
+
+    pub fn text(self) -> &'static str {
+        match self {
+            NeocdToast::NeedsBios(Model::Cdz) => "Neo Geo CD needs BIOS/neocd/neocd.bin",
+            NeocdToast::NeedsBios(Model::Front) => "Neo Geo CD needs BIOS/neocd/front-sp1.bin",
+            NeocdToast::NeedsBios(Model::Top) => "Neo Geo CD needs BIOS/neocd/top-sp1.bin",
+            NeocdToast::UnknownBios(Model::Cdz) => "neocd.bin is not the known dump",
+            NeocdToast::UnknownBios(Model::Front) => "front-sp1.bin is not the known dump",
+            NeocdToast::UnknownBios(Model::Top) => "top-sp1.bin is not the known dump",
+        }
+    }
+}
+
+impl Toast {
+    pub fn neocd_index(n: NeocdToast) -> usize {
+        Toast::segacd_index(crate::SegaCdToast::ALL[0]) + crate::SegaCdToast::ALL.len() + n.index()
+    }
+}
