--- /dev/null
+++ b/crates/slot/src/app/neocd_bios.rs
@@ -0,0 +1,38 @@
+use slot_store::lynx::Bios;
+use slot_store::neocd::bios;
+use slot_store::Platform;
+use slot_ui::{NeocdToast, Toast};
+
+use super::App;
+
+impl App {
+    pub(super) fn neocd_bios_allows(&mut self, platform: Platform) -> bool {
+        if platform != Platform::Neocd {
+            return true;
+        }
+        let Some(root) = self.root.as_deref() else {
+            return true;
+        };
+        let model = self.neocd_model;
+        let file = model.file();
+        match bios(&crate::root::bios_dir(root), model) {
+            Bios::Known => true,
+            Bios::Unknown => {
+                if !self.neocd_bios_warned {
+                    self.neocd_bios_warned = true;
+                    eprintln!("slot: neocd: BIOS/neocd/{file} is not the known dump, launching");
+                    self.hud
+                        .toast(Toast::Neocd(NeocdToast::UnknownBios(model)), self.now());
+                }
+                true
+            }
+            Bios::Missing => {
+                eprintln!("slot: neocd: no usable BIOS/neocd/{file}, not launching");
+                self.hud
+                    .toast(Toast::Neocd(NeocdToast::NeedsBios(model)), self.now());
+                self.refuse();
+                false
+            }
+        }
+    }
+}
