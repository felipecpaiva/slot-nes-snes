 pub fn picture_choices(platform: Platform) -> &'static [VideoMode] {
-    if platform.overscan() == (0, 0) {
-        &[VideoMode::Stretch, VideoMode::Actual]
-    } else {
-        &[VideoMode::Crop, VideoMode::Stretch, VideoMode::Actual]
+    use VideoMode::{Actual, Crop, FourThree, Stretch};
+    match (platform.overscan() == (0, 0), offers_four_three(platform)) {
+        (true, false) => &[Stretch, Actual],
+        (true, true) => &[Stretch, Actual, FourThree],
+        (false, false) => &[Crop, Stretch, Actual],
+        (false, true) => &[Crop, Stretch, Actual, FourThree],
     }
