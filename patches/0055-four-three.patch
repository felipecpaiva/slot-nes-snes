+pub fn offers_four_three(platform: Platform) -> bool {
+    match platform {
+        Platform::Nes | Platform::Snes | Platform::Sms | Platform::Md => true,
+        Platform::Gba | Platform::Gb | Platform::Gbc | Platform::Gg | Platform::Ps1 => false,
+    }
+}
+
+pub fn four_three_rect((w, h): (u32, u32), (canvas_w, canvas_h): (u32, u32)) -> [f32; 4] {
+    if w == 0 || h == 0 || canvas_w == 0 || canvas_h == 0 {
+        return WHOLE_TEXTURE;
+    }
+    let source_w = w as f32 * (OUT_W * 3) as f32 / (OUT_H * 4) as f32;
+    let y = canvas_h.saturating_sub(h) / 2;
+    [
+        (canvas_w as f32 - source_w) / 2.0 / canvas_w as f32,
+        y as f32 / canvas_h as f32,
+        source_w / canvas_w as f32,
+        h as f32 / canvas_h as f32,
+    ]
+}
+
