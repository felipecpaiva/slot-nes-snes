@@ -0,0 +1,161 @@
+use slot::platform_video::{
+    default_video_mode, offers_four_three, picture_choices, shown, system_picture, video_mode_for,
+    write_system_picture, PICTURE_FILE,
+};
+use slot::video_mode::{source_rect, write_video_mode, VideoMode, VIDEO_MODE_FILE};
+use slot_store::{Core, Platform};
+use tempfile::TempDir;
+
+use VideoMode::FourThree;
+
+const STEM: &str = "Zzz";
+
+const TV: [(Platform, u32, (u32, u32)); 5] = [
+    (Platform::Nes, 256, (256, 240)),
+    (Platform::Snes, 256, (256, 224)),
+    (Platform::Sms, 256, (256, 192)),
+    (Platform::Md, 320, (320, 224)),
+    (Platform::Md, 256, (256, 224)),
+];
+
+fn canvas(platform: Platform) -> (u32, u32) {
+    Core::default_for(platform).canvas(platform)
+}
+
+fn rect(platform: Platform, frame_w: u32) -> [f32; 4] {
+    source_rect(
+        platform,
+        shown(platform, frame_w, FourThree),
+        canvas(platform),
+        FourThree,
+    )
+}
+
+fn px(x: f32, y: u32, w: f32, h: u32) -> [f32; 4] {
+    [x / 360.0, y as f32 / 240.0, w / 360.0, h as f32 / 240.0]
+}
+
+fn config_root() -> TempDir {
+    let d = tempfile::tempdir().expect("tempdir");
+    std::fs::create_dir(d.path().join("Config")).expect("config dir");
+    d
+}
+
+#[test]
+fn four_three_shows_nine_eighths_of_the_picture_width_at_its_full_height() {
+    assert_eq!(rect(Platform::Nes, 256), px(36.0, 0, 288.0, 240));
+    assert_eq!(rect(Platform::Snes, 256), px(36.0, 8, 288.0, 224));
+    assert_eq!(rect(Platform::Sms, 256), px(36.0, 24, 288.0, 192));
+    assert_eq!(rect(Platform::Md, 320), px(0.0, 8, 360.0, 224));
+    assert_eq!(rect(Platform::Md, 256), px(36.0, 8, 288.0, 224));
+}
+
+#[test]
+fn a_239_line_snes_frame_takes_the_same_four_three_rect_as_a_224_line_one() {
+    assert_eq!(rect(Platform::Snes, 0), rect(Platform::Snes, 256));
+}
+
+#[test]
+fn only_the_tv_consoles_offer_four_three_and_it_comes_last() {
+    for platform in Platform::SHELVES {
+        let tv = matches!(
+            platform,
+            Platform::Nes | Platform::Snes | Platform::Sms | Platform::Md
+        );
+        assert_eq!(offers_four_three(platform), tv, "{platform:?}");
+        assert_eq!(
+            picture_choices(platform).last() == Some(&FourThree),
+            tv,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn no_system_starts_in_four_three() {
+    for platform in Platform::SHELVES {
+        assert_ne!(default_video_mode(platform), FourThree, "{platform:?}");
+        let d = config_root();
+        assert_ne!(
+            system_picture(d.path(), platform),
+            FourThree,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn a_four_three_line_round_trips_through_both_files() {
+    let d = config_root();
+    write_system_picture(d.path(), Platform::Snes, FourThree).expect("write picture.txt");
+    let line = std::fs::read_to_string(d.path().join(PICTURE_FILE)).expect("read back");
+    assert_eq!(line, "snes = 4:3\n");
+    assert_eq!(system_picture(d.path(), Platform::Snes), FourThree);
+    assert_eq!(video_mode_for(d.path(), STEM, Platform::Snes), FourThree);
+    write_video_mode(d.path(), STEM, FourThree).expect("write video_mode.txt");
+    let line = std::fs::read_to_string(d.path().join(VIDEO_MODE_FILE)).expect("read back");
+    assert!(line.contains("4:3"), "{line}");
+    assert_eq!(video_mode_for(d.path(), STEM, Platform::Nes), FourThree);
+    assert_eq!(FourThree.quick_value().text(), "4:3");
+}
+
+#[cfg(target_os = "macos")]
+mod frame {
+    use super::*;
+    use slot_gfx::{Compositor, HeadlessSurface, ScreenEffect, OUT_H, OUT_W};
+
+    const PILLAR: usize = (OUT_W as usize - 640) / 2;
+
+    fn canvas_with((cw, ch): (u32, u32), (w, h): (u32, u32)) -> Vec<u8> {
+        let (cw, ch, w, h) = (cw as usize, ch as usize, w as usize, h as usize);
+        let (ox, oy) = ((cw - w) / 2, (ch - h) / 2);
+        let mut buf = vec![0u8; cw * ch * 4];
+        for y in 0..h {
+            for x in 0..w {
+                let at = ((y + oy) * cw + x + ox) * 4;
+                buf[at..at + 4].copy_from_slice(&[0xff, 0xff, 0xff, 0]);
+            }
+        }
+        buf
+    }
+
+    fn lit(frame: &[u8], x: usize, y: usize) -> bool {
+        let o = (y * OUT_W as usize + x) * 4;
+        frame[o..o + 3].iter().any(|c| *c > 8)
+    }
+
+    fn column_lit_on_every_row(frame: &[u8], x: usize) -> bool {
+        (0..OUT_H as usize).all(|y| lit(frame, x, y))
+    }
+
+    fn column_dark(frame: &[u8], x: usize) -> bool {
+        (0..OUT_H as usize).all(|y| !lit(frame, x, y))
+    }
+
+    #[test]
+    fn a_four_three_pick_fills_640_by_480_centred_on_every_tv_console() {
+        let Ok(surface) = HeadlessSurface::new() else {
+            return;
+        };
+        let Ok(mut c) = Compositor::new(&surface) else {
+            return;
+        };
+        c.set_screen_effect(ScreenEffect::None);
+        for (platform, frame_w, picture) in TV {
+            let (cw, ch) = canvas(platform);
+            c.set_game_canvas(cw, ch);
+            c.set_game_source_rect(rect(platform, frame_w));
+            c.begin_frame(slot_gfx::Layout::Framed);
+            c.upload_game(&canvas_with((cw, ch), picture));
+            c.draw_game();
+            let frame = c.read_frame();
+            let what = format!("{platform:?} {frame_w}");
+            for x in PILLAR + 1..OUT_W as usize - PILLAR - 1 {
+                assert!(column_lit_on_every_row(&frame, x), "{what}: column {x}");
+            }
+            for x in (0..PILLAR - 1).chain(OUT_W as usize - PILLAR + 1..OUT_W as usize) {
+                assert!(column_dark(&frame, x), "{what}: pillar column {x}");
+            }
+        }
+    }
+}
