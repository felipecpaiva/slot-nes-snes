diff --git a/crates/slot/src/app/pcecd_bios.rs b/crates/slot/src/app/pcecd_bios.rs
new file mode 100644
index 0000000..a20bd3b
--- /dev/null
+++ b/crates/slot/src/app/pcecd_bios.rs
@@ -0,0 +1,36 @@
+use slot_store::lynx::Bios;
+use slot_store::pcecd::bios;
+use slot_store::Platform;
+use slot_ui::{PcecdToast, Toast};
+
+use super::App;
+
+impl App {
+    pub(super) fn pcecd_bios_allows(&mut self, platform: Platform) -> bool {
+        if platform != Platform::Pcecd {
+            return true;
+        }
+        let Some(root) = self.root.as_deref() else {
+            return true;
+        };
+        match bios(&crate::root::bios_dir(root)) {
+            Bios::Known => true,
+            Bios::Unknown => {
+                if !self.pcecd_bios_warned {
+                    self.pcecd_bios_warned = true;
+                    eprintln!("slot: pcecd: BIOS/syscard3.pce is not the known dump, launching");
+                    self.hud
+                        .toast(Toast::Pcecd(PcecdToast::UnknownBios), self.now());
+                }
+                true
+            }
+            Bios::Missing => {
+                eprintln!("slot: pcecd: no usable BIOS/syscard3.pce, not launching");
+                self.hud
+                    .toast(Toast::Pcecd(PcecdToast::NeedsBios), self.now());
+                self.refuse();
+                false
+            }
+        }
+    }
+}
diff --git a/crates/slot/tests/pcecd_bios.rs b/crates/slot/tests/pcecd_bios.rs
new file mode 100644
index 0000000..3ea54ff
--- /dev/null
+++ b/crates/slot/tests/pcecd_bios.rs
@@ -0,0 +1,160 @@
+// A PC Engine CD boots the System Card in BIOS/syscard3.pce, which slot never ships or fetches
+// (ADR 0104). Without it Beetle PCE Fast refuses the disc, so slot checks before the disc goes in, like
+// the Lynx and the Disk System. The core skips a 512-byte copier header (libretro.c HuCLoadCD: a size
+// with the 0x200 bit set), so the check does too.
+mod common;
+mod core_common;
+mod pcecd_common;
+mod tg16_common;
+
+use std::path::Path;
+
+use common::tmp_root_with_carts;
+use pcecd_common::{disc, placeholder_card, put_card, real_card};
+use slot::app::{App, Phase};
+use slot_input::{Action, Btn};
+use slot_store::lynx::Bios;
+use slot_store::pcecd::{bios, bios_of, BIOS_FILE};
+use slot_store::{write_slot_state, Platform, SlotState};
+use slot_ui::{FdsToast, PcecdToast, Toast};
+use tempfile::TempDir;
+
+fn card(bios: Option<&[u8]>) -> TempDir {
+    let d = tmp_root_with_carts(&[]);
+    disc(&d.path().join("Games/PCECD"), "Ys Book I & II (USA)");
+    if let Some(b) = bios {
+        put_card(d.path(), b);
+    }
+    d
+}
+
+fn boot_on(root: &Path, cart: Option<&str>) -> App {
+    write_slot_state(
+        root,
+        &SlotState {
+            clock_set: true,
+            cart: cart.map(str::to_string),
+            cart_platform: cart.map(|_| Platform::Pcecd),
+            ..SlotState::default()
+        },
+    )
+    .expect("write slot.state");
+    App::boot(root)
+}
+
+fn insert(a: &mut App) {
+    a.apply(Action::GbaDown(Btn::A));
+    a.apply(Action::GbaUp(Btn::A));
+    for _ in 0..10 {
+        a.update(1.0 / 60.0);
+    }
+}
+
+fn inserting(a: &App) -> bool {
+    matches!(a.phase(), Phase::Inserting { .. } | Phase::Playing { .. })
+}
+
+fn headered(body: &[u8]) -> Vec<u8> {
+    let mut h = vec![0u8; 512];
+    h.extend_from_slice(body);
+    h
+}
+
+#[test]
+fn the_check_reads_missing_short_long_and_unknown_files() {
+    let d = tempfile::tempdir().unwrap();
+    assert_eq!(BIOS_FILE, "syscard3.pce");
+    assert_eq!(bios(d.path()), Bios::Missing);
+    for (bytes, want) in [
+        (vec![], Bios::Missing),
+        (vec![0u8; 131_072], Bios::Missing),
+        (vec![0u8; 262_145], Bios::Missing),
+        (vec![0u8; 262_144], Bios::Unknown),
+        (headered(&[0u8; 262_144]), Bios::Unknown),
+    ] {
+        std::fs::write(d.path().join(BIOS_FILE), &bytes).unwrap();
+        assert_eq!(bios(d.path()), want, "{} bytes", bytes.len());
+    }
+}
+
+#[test]
+fn the_maintainers_own_card_is_the_known_dump_with_or_without_a_copier_header() {
+    let Some(b) = real_card() else {
+        return;
+    };
+    assert_eq!(bios_of(&b), Bios::Known);
+    assert_eq!(bios_of(&headered(&b)), Bios::Known);
+}
+
+#[test]
+fn with_no_system_card_a_disc_stays_on_the_shelf_with_a_toast() {
+    let d = card(None);
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Pcecd(PcecdToast::NeedsBios)));
+    assert_eq!(
+        Toast::Pcecd(PcecdToast::NeedsBios).text(),
+        "PC Engine CD needs BIOS/syscard3.pce"
+    );
+}
+
+#[test]
+fn a_disc_resumed_at_boot_is_checked_too() {
+    let d = card(Some(&[0u8; 100]));
+    let a = boot_on(d.path(), Some("Ys Book I & II (USA)"));
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Pcecd(PcecdToast::NeedsBios)));
+}
+
+#[test]
+fn an_unknown_system_card_launches_and_says_so() {
+    let d = card(Some(&placeholder_card()));
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), Some(Toast::Pcecd(PcecdToast::UnknownBios)));
+}
+
+#[test]
+fn a_known_system_card_launches_with_no_toast() {
+    let Some(b) = real_card() else {
+        return;
+    };
+    let d = card(Some(&b));
+    let mut a = boot_on(d.path(), None);
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn the_check_never_stops_a_turbografx_hucard() {
+    let d = tmp_root_with_carts(&[]);
+    std::fs::write(
+        d.path().join("Games/TG16/Bonk.pce"),
+        tg16_common::hucard_bytes(false),
+    )
+    .unwrap();
+    let mut a = App::boot(d.path());
+    insert(&mut a);
+    assert!(inserting(&a), "{:?}", a.phase());
+    assert_ne!(a.toast(), Some(Toast::Pcecd(PcecdToast::NeedsBios)));
+}
+
+#[test]
+fn the_pc_engine_cd_toasts_upload_in_their_own_place_after_the_disk_system_ones() {
+    let every = Toast::every();
+    for p in PcecdToast::ALL {
+        let t = Toast::Pcecd(p);
+        assert_eq!(every.get(t.index()), Some(&t), "{p:?}");
+    }
+    assert_eq!(
+        Toast::Pcecd(PcecdToast::ALL[0]).index(),
+        Toast::Fds(FdsToast::ALL[FdsToast::ALL.len() - 1]).index() + 1
+    );
+    assert_eq!(
+        every.len(),
+        Toast::Pcecd(PcecdToast::UnknownBios).index() + 1
+    );
+}
