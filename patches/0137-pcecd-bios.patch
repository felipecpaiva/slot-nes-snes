@@ -0,0 +1,28 @@
+use crate::Toast;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum PcecdToast {
+    NeedsBios,
+    UnknownBios,
+}
+
+impl PcecdToast {
+    pub const ALL: [PcecdToast; 2] = [PcecdToast::NeedsBios, PcecdToast::UnknownBios];
+
+    pub fn index(self) -> usize {
+        Self::ALL.iter().position(|t| *t == self).unwrap_or(0)
+    }
+
+    pub fn text(self) -> &'static str {
+        match self {
+            PcecdToast::NeedsBios => "PC Engine CD needs BIOS/syscard3.pce",
+            PcecdToast::UnknownBios => "syscard3.pce is not the known dump",
+        }
+    }
+}
+
+impl Toast {
+    pub fn pcecd_index(p: PcecdToast) -> usize {
+        Toast::fds_index(crate::FdsToast::ALL[0]) + crate::FdsToast::ALL.len() + p.index()
+    }
+}
