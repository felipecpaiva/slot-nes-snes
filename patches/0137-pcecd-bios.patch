diff --git a/crates/slot-store/src/pcecd.rs b/crates/slot-store/src/pcecd.rs
new file mode 100644
index 0000000..3c721ca
--- /dev/null
+++ b/crates/slot-store/src/pcecd.rs
@@ -0,0 +1,27 @@
+use std::path::Path;
+
+use crate::lynx::{crc32, Bios};
+
+pub const BIOS_FILE: &str = "syscard3.pce";
+const BIOS_BYTES: usize = 262_144;
+const BIOS_CRC32: u32 = 0x6d9a_73ef;
+const COPIER_HEADER: usize = 512;
+
+pub fn bios(bios_dir: &Path) -> Bios {
+    match std::fs::read(bios_dir.join(BIOS_FILE)) {
+        Ok(bytes) => bios_of(&bytes),
+        Err(_) => Bios::Missing,
+    }
+}
+
+pub fn bios_of(bytes: &[u8]) -> Bios {
+    let body = match bytes.len() & COPIER_HEADER {
+        0 => bytes,
+        _ => bytes.get(COPIER_HEADER..).unwrap_or_default(),
+    };
+    match (body.len(), crc32(body)) {
+        (BIOS_BYTES, BIOS_CRC32) => Bios::Known,
+        (BIOS_BYTES, _) => Bios::Unknown,
+        _ => Bios::Missing,
+    }
+}
