@@ -0,0 +1,101 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::{
+    core_for_platform, read_slot_state, scan, write_slot_state, Core, Platform, Shader, SlotState,
+};
+
+#[test]
+fn game_gear_is_the_shelf_after_snes_and_the_pinned_list_stays_three() {
+    assert_eq!(Platform::SHELVES[5], Platform::Gg);
+    assert_eq!(Platform::ALL, [Platform::Gba, Platform::Gb, Platform::Gbc]);
+}
+
+#[test]
+fn game_gear_has_its_own_name_folder_extension_and_picture() {
+    assert_eq!(Platform::Gg.name(), "Sega Game Gear");
+    assert_eq!(Platform::Gg.dir_name(), "GG");
+    assert!(Platform::Gg.accepts(Path::new("x.gg")));
+    assert!(Platform::Gg.accepts(Path::new("X.GG")));
+    assert!(!Platform::Gg.accepts(Path::new("x.sms")));
+    assert_eq!(Platform::Gg.picture(), (160, 144));
+}
+
+#[test]
+fn game_gear_plays_like_a_game_boy_with_the_retro_shaders() {
+    assert!(Platform::Gg.owns_shoulders());
+    assert!(!Platform::Gg.passes_xy_through());
+    assert!(!Platform::Gg.select_x_toggles_picture());
+    assert!(!Platform::Gg.has_gb_palettes());
+    assert!(!Platform::Gg.stretch_crops_height());
+    assert_eq!(Platform::Gg.picker_cores(), None);
+    assert_eq!(Platform::Gg.shader_choices(), &Shader::RETRO);
+}
+
+#[test]
+fn game_gear_runs_on_genesis_plus_gx_alone_at_3x() {
+    assert_eq!(Core::default_for(Platform::Gg), Core::GenesisPlusGx);
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Gg),
+            core == Core::GenesisPlusGx,
+            "{core:?}"
+        );
+    }
+    assert!(!Core::GenesisPlusGx.runs(Platform::Gba));
+    assert_eq!(Core::GenesisPlusGx.canvas(Platform::Gg), (240, 160));
+    assert_eq!(Core::Mgba.canvas(Platform::Gb), (240, 160));
+}
+
+#[test]
+fn genesis_plus_gx_is_named_after_its_dylib_and_reads_back() {
+    assert_eq!(Core::GenesisPlusGx.as_str(), "genesis_plus_gx");
+    assert_eq!(Core::GenesisPlusGx.text(), "Genesis Plus GX");
+    assert_eq!(Core::parse("genesis_plus_gx"), Some(Core::GenesisPlusGx));
+    assert_eq!(Core::GenesisPlusGx.option_prefix(), "genesis_plus_gx");
+    assert!(!Core::GenesisPlusGx.has_colour_correction());
+}
+
+#[test]
+fn a_game_gear_cart_picked_for_another_core_still_opens_on_genesis_plus_gx() {
+    let d = tmp_root();
+    std::fs::write(d.path().join("Config/selected_core.txt"), "Sonic=mgba\n")
+        .expect("write selection");
+    assert_eq!(
+        core_for_platform(d.path(), "Sonic", Platform::Gg),
+        Core::GenesisPlusGx
+    );
+}
+
+#[test]
+fn a_game_gear_cart_lands_on_its_shelf_with_its_stem_as_the_name() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let dir = d.path().join("Games/GG");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    std::fs::write(dir.join("Sonic Chaos (USA, Europe).gg"), vec![0u8; 0x8000]).expect("write rom");
+    std::fs::write(dir.join("Not Mine.sms"), vec![0u8; 0x8000]).expect("write rom");
+    let mut carts = scan(d.path()).expect("scan");
+    assert_eq!(carts.len(), 1);
+    let cart = &mut carts[0];
+    assert_eq!(cart.platform, Platform::Gg);
+    cart.read_header();
+    assert_eq!(cart.title, "");
+    assert_eq!(cart.stem, "Sonic Chaos (USA, Europe)");
+}
+
+#[test]
+fn a_game_gear_cart_resumes_as_a_game_gear_cart() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Sonic Chaos (USA, Europe)".into()),
+        cart_platform: Some(Platform::Gg),
