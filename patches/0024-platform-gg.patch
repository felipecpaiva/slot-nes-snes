+mod common;
+mod core_common;
+mod input_common;
+mod real_seat;
+mod sega_common;
+
+use std::path::{Path, PathBuf};
+
+use common::core_lock;
+use sega_common::{genesis_plus_gx, gg_rom};
+use slot::app::Phase;
+use slot::persist::Snapshot;
+use slot::session::Session;
+use slot_input::{Btn, RawEvent};
+use slot_store::{Core, Platform};
+
+const STEM: &str = "Sonic Chaos";
+
+fn sav(root: &Path) -> PathBuf {
+    root.join("Saves/GG").join(format!("{STEM}.sav"))
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+fn seated(dylib: &Path) -> tempfile::TempDir {
+    let root = real_seat::rooted(Platform::Gg, STEM, &gg_rom("gg_seat.gg"), dylib);
+    std::fs::copy(
+        gg_rom("gg_seat_spare.gg"),
+        root.path().join("Games/GG/Zzz.gg"),
+    )
+    .expect("copy spare cart");
+    root
+}
+
+#[test]
+fn a_game_gear_cart_seats_on_genesis_plus_gx_at_3x() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::GenesisPlusGx);
+    assert_eq!(session.app().playing_platform(), Platform::Gg);
+    assert_eq!(
+        session
+            .app()
+            .core()
+            .canvas(session.app().playing_platform()),
+        (240, 160)
+    );
+}
+
+#[test]
+fn a_game_gear_sav_goes_into_the_core_and_comes_back_out_on_eject() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let marked: Vec<u8> = (0..0x2000u32).map(|i| (i % 251) as u8).collect();
+    std::fs::write(sav(root.path()), &marked).expect("write .sav");
+    let mut session = real_seat::play(root.path(), true);
+    assert_eq!(
+        session.emu().expect("no core").snapshot().save_ram(),
+        Some(marked.clone())
+    );
+    std::fs::remove_file(sav(root.path())).expect("remove .sav");
+    eject(&mut session);
+    assert_eq!(
+        std::fs::read(sav(root.path())).expect("no .sav after eject"),
+        marked
+    );
+}
+
+#[test]
+fn a_game_gear_cart_that_never_wrote_its_ram_leaves_no_sav() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut session = real_seat::play(root.path(), true);
+    eject(&mut session);
+    assert!(!sav(root.path()).exists());
+}
+
+#[test]
+fn a_game_gear_game_gives_both_shoulders_to_slot() {
+    let (_root, session) = input_common::playing(Platform::Gg, "Zzz");
+    assert_eq!(session.app().taken_buttons(), [Btn::L1, Btn::R1]);
+}
