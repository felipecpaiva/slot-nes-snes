@@ -0,0 +1,40 @@
+#![allow(dead_code)]
+
+use std::path::{Path, PathBuf};
+
+const MODE_4_ON: &[u8] = &[0xf3, 0x3e, 0x04, 0xd3, 0xbf, 0x3e, 0x80, 0xd3, 0xbf];
+const COLOUR_0: &[u8] = &[0x3e, 0x00, 0xd3, 0xbf, 0x3e, 0xc0, 0xd3, 0xbf];
+const GG_RED: &[u8] = &[0x3e, 0x0f, 0xd3, 0xbe, 0x3e, 0x00, 0xd3, 0xbe];
+const DISPLAY_ON_THEN_SPIN: &[u8] = &[0x3e, 0x40, 0xd3, 0xbf, 0x3e, 0x81, 0xd3, 0xbf, 0x18, 0xfe];
+
+const GG_CYCLE: &[u8] = &[
+    0x06, 0x00, 0xdb, 0xbf, 0x17, 0x30, 0xfb, 0x3e, 0x00, 0xd3, 0xbf, 0x3e, 0xc0, 0xd3, 0xbf, 0x78,
+    0xd3, 0xbe, 0xaf, 0xd3, 0xbe, 0x04, 0x18, 0xea,
+];
+const DISPLAY_ON: &[u8] = &[0x3e, 0x40, 0xd3, 0xbf, 0x3e, 0x81, 0xd3, 0xbf];
+
+pub fn genesis_plus_gx() -> Option<PathBuf> {
+    crate::core_common::require_core("genesis_plus_gx")
+}
+
+pub fn gg_rom(name: &str) -> PathBuf {
+    let program = [MODE_4_ON, COLOUR_0, GG_RED, DISPLAY_ON_THEN_SPIN].concat();
+    let mut rom = vec![0u8; 0x8000];
+    rom[..program.len()].copy_from_slice(&program);
+    rom[0x7ff0..0x7ff8].copy_from_slice(b"TMR SEGA");
+    rom[0x7fff] = 0x6c;
+    write(name, &rom)
+}
+
+pub fn gg_rom_cycling(name: &str) -> PathBuf {
+    let program = [MODE_4_ON, DISPLAY_ON, GG_CYCLE].concat();
+    let mut rom = vec![0u8; 0x8000];
+    rom[..program.len()].copy_from_slice(&program);
+    write(name, &rom)
+}
+
+fn write(name: &str, rom: &[u8]) -> PathBuf {
+    let p = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
+    std::fs::write(&p, rom).expect("write rom");
+    p
+}
