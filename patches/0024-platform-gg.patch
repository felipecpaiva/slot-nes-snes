+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::GenesisPlusGx,
+        Platform::Gg,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.load(&gg_rom("gg_emu.gg"))
+        .expect("Genesis Plus GX refused the Game Gear cart");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(core.canvas(), (240, 160));
+    let video = core.video_xrgb8888();
+    assert_eq!(video.len(), 240 * 160 * 4);
+    let red = pixel(video, PICTURE_X, PICTURE_Y);
+    assert!(red[2] > 200 && red[1] < 60 && red[0] < 60, "{red:?}");
+    for y in 0..160 {
+        for x in 0..CANVAS_W {
+            let inside = (PICTURE_X..PICTURE_X + PICTURE_W).contains(&x)
+                && (PICTURE_Y..PICTURE_Y + PICTURE_H).contains(&y);
+            let want = if inside { red } else { [0; 4] };
+            assert_eq!(pixel(video, x, y), want, "({x}, {y})");
+        }
+    }
+}
+
+#[test]
+fn genesis_plus_gx_on_game_gear_drops_the_picture_of_a_frame_slot_skips() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::GenesisPlusGx,
+        Platform::Gg,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.set_option("genesis_plus_gx_frameskip", "disabled");
+    core.load(&gg_rom_cycling("gg_skip.gg"))
+        .expect("Genesis Plus GX refused the Game Gear cart");
+    let step = |core: &mut Box<dyn RetroCore>| {
+        core.run_frame(ButtonMask::default());
+        pixel(core.video_xrgb8888(), 120, 80)
+    };
+    for _ in 0..20 {
+        step(&mut core);
+    }
+    let shown = step(&mut core);
+    assert_ne!(
+        step(&mut core),
+        shown,
+        "the test cart does not change colour every frame"
+    );
+    let before = pixel(core.video_xrgb8888(), 120, 80);
+    core.set_frame_skip(true);
+    assert_eq!(
+        step(&mut core),
+        before,
+        "a skipped frame still reached the canvas"
+    );
+    core.set_frame_skip(false);
+    assert_ne!(step(&mut core), before);
+}
