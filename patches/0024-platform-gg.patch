new file mode 100644
index 0000000..d268231
--- /dev/null
+++ b/crates/slot-store/tests/sega_header.rs
@@ -0,0 +1,54 @@
+use std::path::PathBuf;
+
+use slot_store::sega::{sms_region, tmr_region, Region};
+
+fn header(region: u8) -> [u8; 16] {
+    let mut head = [0u8; 16];
+    head[..8].copy_from_slice(b"TMR SEGA");
+    head[15] = region;
+    head
+}
+
+fn rom_with_header_at(name: &str, at: usize, region: u8) -> PathBuf {
+    let mut rom = vec![0u8; 0x8000];
+    rom[at..at + 16].copy_from_slice(&header(region));
+    let p = std::env::temp_dir().join(format!("slot-sega-header-{}-{name}", std::process::id()));
+    std::fs::write(&p, rom).expect("write rom");
+    p
+}
+
+#[test]
+fn the_region_nibble_reads_as_japan_export_or_international() {
+    assert_eq!(tmr_region(&header(0x3c)), Some(Region::Japan));
+    assert_eq!(tmr_region(&header(0x4c)), Some(Region::Export));
+    assert_eq!(tmr_region(&header(0x5c)), Some(Region::Japan));
+    assert_eq!(tmr_region(&header(0x6c)), Some(Region::Export));
+    assert_eq!(tmr_region(&header(0x7c)), Some(Region::International));
+}
+
+#[test]
+fn an_unknown_region_code_or_a_missing_signature_gives_no_region() {
+    assert_eq!(tmr_region(&header(0x0c)), None);
+    assert_eq!(tmr_region(&header(0xfc)), None);
+    let mut head = header(0x4c);
+    head[0] = b'X';
+    assert_eq!(tmr_region(&head), None);
+}
+
+#[test]
+fn the_header_is_found_at_7ff0_3ff0_or_1ff0() {
+    for at in [0x7ff0, 0x3ff0, 0x1ff0] {
+        let rom = rom_with_header_at(&format!("{at:x}"), at, 0x5c);
+        assert_eq!(sms_region(&rom), Some(Region::Japan), "{at:#x}");
+        let _ = std::fs::remove_file(rom);
+    }
+}
+
+#[test]
+fn a_rom_shorter_than_the_header_or_without_one_gives_no_region() {
+    let p = std::env::temp_dir().join(format!("slot-sega-header-{}-short", std::process::id()));
+    std::fs::write(&p, [0u8; 0x100]).expect("write rom");
+    assert_eq!(sms_region(&p), None);
+    let _ = std::fs::remove_file(&p);
+    assert_eq!(sms_region(&PathBuf::from("/nonexistent/x.gg")), None);
+}
