diff --git a/crates/slot-store/src/sega.rs b/crates/slot-store/src/sega.rs
new file mode 100644
index 0000000..492b413
--- /dev/null
+++ b/crates/slot-store/src/sega.rs
@@ -0,0 +1,37 @@
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::Path;
+
+const TMR_SEGA: &[u8; 8] = b"TMR SEGA";
+const TMR_PROBES: [u64; 3] = [0x7ff0, 0x3ff0, 0x1ff0];
+const TMR_LEN: usize = 16;
+const TMR_REGION_OFF: usize = 15;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum Region {
+    Japan,
+    Export,
+    International,
+}
+
+pub fn sms_region(rom: &Path) -> Option<Region> {
+    let mut f = File::open(rom).ok()?;
+    TMR_PROBES.into_iter().find_map(|off| {
+        let mut head = [0u8; TMR_LEN];
+        f.seek(SeekFrom::Start(off)).ok()?;
+        f.read_exact(&mut head).ok()?;
+        tmr_region(&head)
+    })
+}
+
+pub fn tmr_region(head: &[u8; TMR_LEN]) -> Option<Region> {
+    if !head.starts_with(TMR_SEGA) {
+        return None;
+    }
+    match head[TMR_REGION_OFF] >> 4 {
+        3 | 5 => Some(Region::Japan),
+        4 | 6 => Some(Region::Export),
+        7 => Some(Region::International),
+        _ => None,
+    }
+}
