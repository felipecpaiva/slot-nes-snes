diff --git a/crates/slot-ui/tests/wswan_cart.rs b/crates/slot-ui/tests/wswan_cart.rs
new file mode 100644
index 0000000..acb6ec4
--- /dev/null
+++ b/crates/slot-ui/tests/wswan_cart.rs
@@ -0,0 +1,70 @@
+use std::path::{Path, PathBuf};
+
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    cart_box, plastic_in, retro_shell_of, seated_box, shell_for, ws_shell, Finish, RetroShell,
+    WsShell, WSC_CLEAR, WS_BLACK,
+};
+
+fn rom(dir: &Path, name: &str, colour: u8) -> PathBuf {
+    let mut bytes = vec![0u8; 0x10000];
+    bytes[0x10000 - 9] = colour;
+    let path = dir.join(name);
+    std::fs::write(&path, bytes).expect("write rom");
+    path
+}
+
+fn cart(rom: PathBuf) -> Cart {
+    Cart {
+        platform: Platform::Ws,
+        stem: "Game".into(),
+        rom,
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+#[test]
+fn the_footer_colour_flag_picks_the_shell_whatever_the_extension() {
+    let d = tempfile::tempdir().expect("tempdir");
+    assert_eq!(ws_shell(&rom(d.path(), "a.ws", 1)), WsShell::Color);
+    assert_eq!(ws_shell(&rom(d.path(), "b.wsc", 0)), WsShell::Mono);
+    assert_eq!(ws_shell(&rom(d.path(), "c.ws", 0)), WsShell::Mono);
+    assert_eq!(ws_shell(&rom(d.path(), "d.wsc", 1)), WsShell::Color);
+}
+
+#[test]
+fn an_unreadable_footer_falls_back_to_the_extension() {
+    let d = tempfile::tempdir().expect("tempdir");
+    assert_eq!(ws_shell(&d.path().join("Missing.wsc")), WsShell::Color);
+    assert_eq!(ws_shell(&d.path().join("Missing.WSC")), WsShell::Color);
+    assert_eq!(ws_shell(&d.path().join("Missing.ws")), WsShell::Mono);
+    std::fs::write(d.path().join("Short.wsc"), [1u8; 64]).expect("write");
+    assert_eq!(ws_shell(&d.path().join("Short.wsc")), WsShell::Color);
+}
+
+#[test]
+fn a_wonderswan_game_gets_a_black_cart_and_a_colour_game_a_clear_one() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let mono = cart(rom(d.path(), "Gunpey (Japan).ws", 0));
+    let colour = cart(rom(d.path(), "Final Fantasy (Japan).wsc", 1));
+    assert_eq!(retro_shell_of(&mono), Some(RetroShell::Ws(WsShell::Mono)));
+    assert_eq!(
+        retro_shell_of(&colour),
+        Some(RetroShell::Ws(WsShell::Color))
+    );
+    assert_eq!(shell_for(&mono), WS_BLACK);
+    assert_eq!(shell_for(&colour), WSC_CLEAR);
+    assert_eq!(WSC_CLEAR.finish, Finish::Translucent);
+    assert_eq!(plastic_in(&mono, RetroShell::Ws(WsShell::Mono)), WS_BLACK);
+}
+
+#[test]
+fn both_shells_share_one_wide_box_no_taller_than_66_by_41_mm() {
+    assert_eq!(seated_box(Platform::Ws), (240, 149));
+    let (w, h) = cart_box(Platform::Ws);
+    assert_eq!(w, 360);
+    assert!(h.abs_diff(149 * 360 / 240) <= 1);
+}
