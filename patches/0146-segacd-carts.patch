index 0000000..fdb65f1
--- /dev/null
+++ b/crates/slot-ui/tests/segacd_case.rs
@@ -0,0 +1,137 @@
+use std::path::{Path, PathBuf};
+
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    cart_box, cart_face, cart_interior, disc_art_path, has_disc, read_sega_cd_case, retro_shell_of,
+    seated_box, shows_interior, Ps1Case, RetroShell, DISC_PX,
+};
+
+fn disc(platform: Platform, stem: &str, rom: PathBuf, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform,
+        stem: stem.into(),
+        rom,
+        label,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn png(path: &Path, w: u32, h: u32) {
+    let file = std::fs::File::create(path).expect("create png");
+    let mut e = png::Encoder::new(std::io::BufWriter::new(file), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    let data: Vec<u8> = (0..w * h)
+        .flat_map(|i| [(i % 251) as u8, (i % 13) as u8 * 19, 90, 255])
+        .collect();
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&data)
+        .expect("png data");
+}
+
+fn iso(dir: &Path, stem: &str, region: u8) -> PathBuf {
+    let mut data = vec![0u8; 4096];
+    data[..16].copy_from_slice(b"SEGADISCSYSTEM  ");
+    data[0x20b] = region;
+    let path = dir.join(format!("{stem}.iso"));
+    std::fs::write(&path, data).expect("write iso");
+    path
+}
+
+#[test]
+fn a_sega_cd_game_is_a_jewel_case_of_its_region() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let chd = Path::new("x.chd");
+    assert_eq!(read_sega_cd_case(chd, "Snatcher (USA)"), Ps1Case::Us);
+    assert_eq!(read_sega_cd_case(chd, "Sonic CD (Europe)"), Ps1Case::Eu);
+    assert_eq!(
+        read_sega_cd_case(chd, "Lunar - Eternal Blue (Japan) (En)"),
+        Ps1Case::Jp
+    );
+    assert_eq!(read_sega_cd_case(chd, "Popful Mail"), Ps1Case::Us);
+    let eu = iso(d.path(), "Untagged", 0x64);
+    assert_eq!(read_sega_cd_case(&eu, "Untagged"), Ps1Case::Eu);
+    let jp = iso(d.path(), "Untagged JP", 0xa1);
+    assert_eq!(read_sega_cd_case(&jp, "Untagged JP"), Ps1Case::Jp);
+    let cart = disc(
+        Platform::SegaCd,
+        "Keio Flying Squadron (Japan)",
+        "k.chd".into(),
+        None,
+    );
+    assert_eq!(retro_shell_of(&cart), Some(RetroShell::Ps1(Ps1Case::Jp)));
+}
+
+#[test]
+fn a_set_of_two_discs_is_a_double_case() {
+    let d = tempfile::tempdir().expect("tempdir");
+    iso(d.path(), "Night Trap (USA) (Disc 1)", 0x7a);
+    iso(d.path(), "Night Trap (USA) (Disc 2)", 0x7a);
+    let m3u = d.path().join("Night Trap (USA).m3u");
+    std::fs::write(
+        &m3u,
+        "Night Trap (USA) (Disc 1).iso\nNight Trap (USA) (Disc 2).iso\n",
+    )
+    .expect("write m3u");
+    assert_eq!(read_sega_cd_case(&m3u, "Night Trap (USA)"), Ps1Case::Double);
+}
+
+#[test]
+fn a_sega_cd_case_sits_and_draws_exactly_like_a_playstation_case_with_the_same_cover() {
+    assert_eq!(cart_box(Platform::SegaCd), cart_box(Platform::Ps1));
+    assert_eq!(seated_box(Platform::SegaCd), seated_box(Platform::Ps1));
+    let d = tempfile::tempdir().expect("tempdir");
+    let cover = d.path().join("Sonic CD (USA).png");
+    png(&cover, 300, 300);
+    let sega = disc(
+        Platform::SegaCd,
+        "Sonic CD (USA)",
+        d.path().join("Games/SEGACD/Sonic CD (USA).chd"),
+        Some(cover.clone()),
+    );
+    let ps1 = disc(
+        Platform::Ps1,
+        "Sonic CD (USA)",
+        d.path().join("Games/PS1/Sonic CD (USA).chd"),
+        Some(cover),
+    );
+    let (a, b) = (cart_face(&sega), cart_face(&ps1));
+    assert_eq!((a.w, a.h), (b.w, b.h));
+    assert!(
+        a.rgba == b.rgba,
+        "the Sega CD face differs from the PS1 face"
+    );
+}
+
+#[test]
+fn a_sega_cd_game_carries_its_disc_and_the_disc_scan_lives_under_labels_segacd() {
+    let cart = disc(
+        Platform::SegaCd,
+        "Vay (USA)",
+        "/card/Games/SEGACD/Vay (USA).chd".into(),
+        None,
+    );
+    assert!(has_disc(&cart));
+    assert!(shows_interior(&cart));
+    let face = cart_interior(&cart);
+    assert_eq!((face.w, face.h), (DISC_PX, DISC_PX));
+    assert_eq!(
+        disc_art_path(&cart),
+        Some(PathBuf::from("/card/Labels/SEGACD/disc/Vay (USA).png"))
+    );
+    let labelled = disc(
+        Platform::SegaCd,
+        "Vay (USA)",
+        "/card/Games/SEGACD/Vay (USA).chd".into(),
+        Some("/card/Labels/SEGACD/Vay (USA).png".into()),
+    );
+    assert_eq!(
+        disc_art_path(&labelled),
+        Some(PathBuf::from("/card/Labels/SEGACD/disc/Vay (USA).png"))
+    );
+    let md = disc(Platform::Md, "Vay (USA)", "v.md".into(), None);
+    assert!(!has_disc(&md));
+}
