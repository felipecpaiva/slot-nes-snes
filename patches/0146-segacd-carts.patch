+pub fn read_sega_cd_case(rom: &Path, stem: &str) -> Ps1Case {
+    if is_set(rom) {
+        return Ps1Case::Double;
+    }
+    match sega_cd_region(rom, stem) {
+        DiscRegion::Us => Ps1Case::Us,
+        DiscRegion::Eu => Ps1Case::Eu,
+        DiscRegion::Jp => Ps1Case::Jp,
+    }
