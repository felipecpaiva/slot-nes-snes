+#[test]
+fn the_super_hucard_contacts_are_gold_and_the_body_is_white() {
+    let face = cart_face(&daimakaimura(None));
+    let (tx, ty, tw, th) = px_rect(retro_strip_rect(RetroShell::Sgx).expect("no contact strip"));
+    let [r, g, b] = pixel(&face.rgba, face.w, tx + tw / 2 + 1, ty + th / 2);
+    assert!(
+        r > g && g > b && r - b > 60,
+        "contact {r},{g},{b} is not gold"
+    );
+    let (lx, ly, _, lh) = px_rect(retro_label_rect(RetroShell::Sgx));
+    let [r, g, b] = pixel(&face.rgba, face.w, lx + 2, ly + lh + 4);
+    assert!(
+        r > 150 && g > 150 && b > 150,
+        "body {r},{g},{b} is not white"
+    );
+}
