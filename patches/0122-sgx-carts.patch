diff --git a/crates/slot-ui/tests/sgx_card.rs b/crates/slot-ui/tests/sgx_card.rs
new file mode 100644
index 0000000..763e66d
--- /dev/null
+++ b/crates/slot-ui/tests/sgx_card.rs
@@ -0,0 +1,131 @@
+use std::path::{Path, PathBuf};
+
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    cart_box, cart_face, plastic_in, retro_label_rect, retro_shell_of, retro_strip_rect,
+    seated_box, RetroShell, HUCARD_WHITE,
+};
+
+fn on_the_sgx_shelf(file: &str, label: Option<PathBuf>) -> Cart {
+    let stem = Path::new(file)
+        .file_stem()
+        .and_then(|s| s.to_str())
+        .unwrap_or_default();
+    Cart {
+        platform: Platform::Sgx,
+        stem: stem.into(),
+        rom: Path::new("Games/SGX").join(file),
+        label,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn daimakaimura(label: Option<PathBuf>) -> Cart {
+    on_the_sgx_shelf("Daimakaimura (Japan) (En).sgx", label)
+}
+
+fn magenta_label(dir: &Path) -> PathBuf {
+    let path = dir.join("label.png");
+    let file = std::fs::File::create(&path).expect("create label");
+    let mut e = png::Encoder::new(file, 8, 8);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    let px: Vec<u8> = (0..64).flat_map(|_| [255, 0, 255, 255]).collect();
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    path
+}
+
+fn px_rect(rect: (f32, f32, f32, f32)) -> (u32, u32, u32, u32) {
+    let (w, h) = cart_box(Platform::Sgx);
+    let at = |f: f32, of: u32| (f * of as f32).round() as u32;
+    (at(rect.0, w), at(rect.1, h), at(rect.2, w), at(rect.3, h))
+}
+
+fn pixel(rgba: &[u8], w: u32, x: u32, y: u32) -> [u8; 3] {
+    let i = ((y * w + x) * 4) as usize;
+    [rgba[i], rgba[i + 1], rgba[i + 2]]
+}
