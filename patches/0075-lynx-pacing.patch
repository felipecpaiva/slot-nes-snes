+    assert_eq!(
+        std::fs::read_to_string(&file).expect("pal_speed.txt"),
+        "lynx = panel\n"
+    );
+    press(&mut app, Btn::Left);
+    app.flush_state();
+    assert_eq!(
+        std::fs::read_to_string(&file).expect("pal_speed.txt"),
+        "lynx = native\n"
+    );
+}
