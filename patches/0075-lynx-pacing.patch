@@ -0,0 +1,262 @@
+mod common;
+mod core_common;
+mod lynx_common;
+mod real_seat;
+
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use core_common::require_core;
+use lynx_common::{lnx_cart, lynx_bios, paint, put_bios};
+use slot::audio::{AudioSink, StubSink};
+use slot::emu::{CoreState, EmuHandle, Speed};
+use slot::session::Session;
+use slot_retro::{AvInfo, ButtonMask, CoreError, MockCore, RetroCore};
+use slot_store::{read_slot_state, write_slot_state, Platform};
+
+const PANEL: Duration = Duration::from_nanos(16_666_667);
+const DEVICE_HZ: u32 = 32_768;
+const AT_60: usize = 736;
+const AT_75: usize = 588;
+
+struct Carrying {
+    inner: MockCore,
+    per_frame: Arc<AtomicUsize>,
+    owed: usize,
+    ran: Arc<AtomicU64>,
+}
+
+impl RetroCore for Carrying {
+    fn load(&mut self, rom: &Path) -> Result<(), CoreError> {
+        self.inner.load(rom)
+    }
+    fn run_frame(&mut self, input: ButtonMask) {
+        self.ran.fetch_add(1, Ordering::Relaxed);
+        self.owed += self.per_frame.load(Ordering::Relaxed);
+        self.inner.run_frame(input);
+    }
+    fn video_xrgb8888(&self) -> &[u8] {
+        self.inner.video_xrgb8888()
+    }
+    fn take_audio(&mut self) -> Vec<i16> {
+        let _ = self.inner.take_audio();
+        vec![0; std::mem::take(&mut self.owed) * 2]
+    }
+    fn serialize(&mut self) -> Result<Vec<u8>, CoreError> {
+        self.inner.serialize()
+    }
+    fn unserialize(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.unserialize(data)
+    }
+    fn save_ram(&self) -> Option<Vec<u8>> {
+        None
+    }
+    fn load_save_ram(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.load_save_ram(data)
+    }
+    fn av_info(&self) -> AvInfo {
+        AvInfo {
+            fps: 75.0,
+            sample_rate: 44_100.0,
+        }
+    }
+}
+
+struct Run {
+    emu: EmuHandle,
+    per_frame: Arc<AtomicUsize>,
+    ran: Arc<AtomicU64>,
+    heard: Arc<AtomicU64>,
+}
+
+fn wait_for(cond: impl Fn() -> bool) -> bool {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !cond() {
+        if Instant::now() >= deadline {
+            return false;
+        }
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    true
+}
+
+fn spawn(per_frame: usize, native: bool, measures: bool) -> Run {
+    let per_frame = Arc::new(AtomicUsize::new(per_frame));
+    let ran = Arc::new(AtomicU64::new(0));
+    let core = Box::new(Carrying {
+        inner: MockCore::new(),
+        per_frame: per_frame.clone(),
+        owed: 0,
+        ran: ran.clone(),
+    });
+    let mut sink = StubSink::new();
+    sink.open(DEVICE_HZ).expect("the stub refused to open");
+    let ring = sink.ring();
+    let heard = Arc::new(AtomicU64::new(0));
+    let counted = heard.clone();
+    let drained = ring.clone();
+    std::thread::spawn(move || loop {
+        let frames = drained.queued_frames();
+        drained.fill(&mut vec![0i16; frames * 2]);
+        counted.fetch_add(frames as u64, Ordering::Relaxed);
+        std::thread::sleep(Duration::from_millis(2));
+    });
+    let emu = EmuHandle::spawn(core, PathBuf::from("mock"), ring, None, None);
+    emu.set_native_pal(native);
+    emu.set_measures_rate(measures);
+    emu.set_speed(Speed::Normal);
+    assert!(wait_for(|| emu.state() != CoreState::Loading));
+    assert_eq!(emu.state(), CoreState::Ready);
+    emu.set_driven(true);
+    assert!(wait_for(|| emu.locked()), "the worker never locked");
+    let run = Run {
+        emu,
+        per_frame,
+        ran,
+        heard,
+    };
+    ticks(&run, 60);
+    run
+}
+
+fn ticks(run: &Run, n: usize) {
+    for _ in 0..n {
+        run.emu.tick(PANEL);
+        assert!(
+            run.emu.wait_frame(Duration::from_millis(500)),
+            "a tick was never served"
+        );
+    }
+}
+
+fn frames_in_60_ticks(run: &Run) -> u64 {
+    let before = run.ran.load(Ordering::Relaxed);
+    ticks(run, 60);
+    run.ran.load(Ordering::Relaxed) - before
+}
+
+#[test]
+fn a_core_reporting_75_but_carrying_60_hz_frames_runs_60_frames_in_60_ticks() {
+    let run = spawn(AT_60, true, true);
+    assert_eq!(frames_in_60_ticks(&run), 60);
+}
+
+#[test]
+fn a_core_carrying_75_hz_frames_runs_75_frames_in_60_ticks() {
+    let run = spawn(AT_75, true, true);
+    assert_eq!(frames_in_60_ticks(&run), 75);
+}
+
+#[test]
+fn a_75_hz_game_keeps_all_its_sound() {
+    let run = spawn(AT_75, true, true);
+    std::thread::sleep(Duration::from_millis(50));
+    let (frames, sound) = (
+        run.ran.load(Ordering::Relaxed),
+        run.heard.load(Ordering::Relaxed),
+    );
+    ticks(&run, 240);
+    std::thread::sleep(Duration::from_millis(50));
+    let frames = run.ran.load(Ordering::Relaxed) - frames;
+    let sound = run.heard.load(Ordering::Relaxed) - sound;
+    let per_frame = sound as f64 / frames as f64;
+    let want = f64::from(DEVICE_HZ) / 75.0;
+    assert!(
+        (per_frame / want - 1.0).abs() < 0.02,
+        "{per_frame:.1} device frames of sound per game frame, want {want:.1}"
+    );
+}
+
+#[test]
+fn a_game_that_switches_to_75_hz_mid_play_is_followed_within_a_second() {
+    let run = spawn(AT_60, true, true);
+    assert_eq!(frames_in_60_ticks(&run), 60);
+    run.per_frame.store(AT_75, Ordering::Relaxed);
+    ticks(&run, 60);
+    assert_eq!(frames_in_60_ticks(&run), 75);
+}
+
+#[test]
+fn panel_runs_a_75_hz_game_one_frame_a_tick() {
+    let run = spawn(AT_75, false, true);
+    assert_eq!(frames_in_60_ticks(&run), 60);
+}
+
+#[test]
+fn a_core_that_is_not_measured_is_paced_at_the_rate_it_reports() {
+    let run = spawn(AT_60, true, false);
+    assert_eq!(frames_in_60_ticks(&run), 75);
+}
+
+fn seated_lynx(hz75: bool, speed: Option<&str>) -> Option<(tempfile::TempDir, Session)> {
+    let bios = lynx_bios()?;
+    let dylib = require_core("mednafen_lynx")?;
+    let carts = tempfile::tempdir().unwrap();
+    let rom = lnx_cart(carts.path(), "Paint", 0, paint(0xfb68, hz75));
+    let root = real_seat::rooted(Platform::Lynx, "Paint", &rom, &dylib);
+    put_bios(root.path(), Some(&bios));
+    if let Some(line) = speed {
+        std::fs::write(root.path().join(slot::pal_speed::PAL_SPEED_FILE), line).unwrap();
+    }
+    let mut state = read_slot_state(root.path());
+    state.cart = Some("Paint".into());
+    state.cart_platform = Some(Platform::Lynx);
+    write_slot_state(root.path(), &state).unwrap();
+    let mut session = real_seat::play(root.path(), false);
+    session.set_driven(true);
+    let emu = session.emu().expect("no emu");
+    assert!(wait_for(|| emu.locked()), "the worker never locked");
+    for _ in 0..120 {
+        assert!(session.step_emulator(PANEL, Duration::from_millis(500)));
+    }
+    Some((carts, session))
+}
+
+fn paced_fps(session: &Session) -> f64 {
+    session.emu().expect("no emu").paced_fps()
+}
+
+fn session_frames_in_60_ticks(session: &Session) -> u64 {
+    let before = session.frames_published();
+    for _ in 0..60 {
+        assert!(session.step_emulator(PANEL, Duration::from_millis(500)));
+    }
+    session.frames_published() - before
+}
+
+#[test]
+fn a_session_paces_a_real_lynx_cart_at_the_60_hz_the_boot_rom_sets() {
+    let _g = core_lock();
+    let Some((_carts, session)) = seated_lynx(false, None) else {
+        return;
+    };
+    assert_eq!(session_frames_in_60_ticks(&session), 60);
+    assert!((paced_fps(&session) - 60.0).abs() < 0.01);
+}
+
+#[test]
+fn a_session_paces_a_real_lynx_cart_that_sets_75_hz_at_75() {
+    let _g = core_lock();
+    let Some((_carts, session)) = seated_lynx(true, None) else {
+        return;
+    };
+    assert!(
+        (paced_fps(&session) - 75.0).abs() < 0.3,
+        "{}",
+        paced_fps(&session)
+    );
+    assert_eq!(session_frames_in_60_ticks(&session), 60);
+}
+
+#[test]
+fn a_session_with_lynx_speed_on_panel_runs_the_75_hz_cart_on_every_tick() {
+    let _g = core_lock();
+    let Some((_carts, session)) = seated_lynx(true, Some("lynx = panel\n")) else {
+        return;
+    };
+    assert_eq!(session_frames_in_60_ticks(&session), 60);
+    assert!((paced_fps(&session) - 60.0).abs() < 0.01);
+}
