+const MEASURE_FRAMES: u32 = 20;
+const MEASURED_FPS: std::ops::RangeInclusive<f64> = 50.0..=80.0;
+const MEASURE_STEP: f64 = 0.1;
+const SETTLED: f64 = 0.5;
+
+#[derive(Default)]
+pub struct MeasuredRate {
+    samples: usize,
+    frames: u32,
+    window: f64,
+    fps: f64,
+}
+
+impl MeasuredRate {
+    pub fn fps(&self) -> f64 {
+        self.fps
+    }
+
+    pub fn feed(&mut self, sample_frames: usize, frames: u32, sample_rate: f64) -> Option<f64> {
+        if sample_frames == 0 || frames == 0 {
+            return None;
+        }
+        self.samples += sample_frames;
+        self.frames += frames;
+        if self.frames < MEASURE_FRAMES {
+            return None;
+        }
+        let fps = sample_rate * f64::from(self.frames) / self.samples as f64;
+        self.samples = 0;
+        self.frames = 0;
+        let settled = (fps - std::mem::replace(&mut self.window, fps)).abs() <= SETTLED;
+        if !settled || !MEASURED_FPS.contains(&fps) || (fps - self.fps).abs() <= MEASURE_STEP {
+            return None;
+        }
+        self.fps = fps;
+        Some(fps)
+    }
+}
