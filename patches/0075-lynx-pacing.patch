+#[test]
+fn the_lynx_speed_row_starts_native_and_writes_only_its_own_line() {
+    let (root, mut app) = card_with_a_cart();
+    open_lynx(&mut app);
+    press(&mut app, Btn::Down);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::LynxSpeed));
+    assert_eq!(QuickRow::LynxSpeed.label(), "Lynx Speed");
+    assert_eq!(
+        app.quick_value(QuickRow::LynxSpeed),
+        Some(QuickValue::Native)
+    );
+    assert!(app.native_pal(Platform::Lynx));
+    let file = root.path().join(slot::pal_speed::PAL_SPEED_FILE);
+    assert!(!file.exists());
