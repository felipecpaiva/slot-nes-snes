diff --git a/crates/slot/src/doze_rest.rs b/crates/slot/src/doze_rest.rs
new file mode 100644
index 0000000..92c760e
--- /dev/null
+++ b/crates/slot/src/doze_rest.rs
@@ -0,0 +1,82 @@
+use std::time::{Duration, Instant};
+
+use crate::app::{App, Phase};
+
+pub const DOZE_POLL: Duration = Duration::from_millis(50);
+
+pub const DARK_FRAMES: u32 = 2;
+
+const TICK_MS: u64 = 10;
+
+pub fn rests(app: &App) -> bool {
+    matches!(app.phase(), Phase::Doze { .. })
+        && app.screen_power() <= 0.0
+        && !app.shutting_down()
+        && !app.link_active()
+}
+
+#[derive(Default)]
+pub struct DozeRest {
+    since: Option<Instant>,
+    cpu: Option<u64>,
+    presents: u32,
+    polls: u32,
+    resting: bool,
+}
+
+impl DozeRest {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn step(&mut self, dozing: bool, now: Instant) -> Option<String> {
+        if !dozing {
+            self.resting = false;
+            let since = self.since.take()?;
+            let cpu = own_cpu_ms()
+                .zip(self.cpu.take())
+                .map(|(now, then)| now.saturating_sub(then));
+            let line = awake_line(now - since, self.presents, self.polls, cpu);
+            (self.presents, self.polls) = (0, 0);
+            return Some(line);
+        }
+        self.resting = self.presents >= DARK_FRAMES;
+        match self.resting {
+            true => self.polls += 1,
+            false => self.presents += 1,
+        }
+        if self.since.is_some() {
+            return None;
+        }
+        self.since = Some(now);
+        self.cpu = own_cpu_ms();
+        Some(format!(
+            "slot: doze: resting after {DARK_FRAMES} dark frames, polling every {} ms",
+            DOZE_POLL.as_millis()
+        ))
+    }
+
+    pub fn resting(&self) -> bool {
+        self.resting
+    }
+}
+
+pub fn awake_line(dozed: Duration, presents: u32, polls: u32, cpu_ms: Option<u64>) -> String {
+    let secs = dozed.as_secs_f64();
+    let rate = f64::from(presents) / secs.max(0.001);
+    let cpu = cpu_ms.map_or(String::new(), |ms| format!(", {ms} ms of cpu"));
+    format!(
+        "slot: doze: awake after {secs:.1} s, {presents} presents ({rate:.2} per second), {polls} polls{cpu}"
+    )
+}
+
+pub fn cpu_ms(stat: &str) -> Option<u64> {
+    let mut fields = stat.rsplit_once(')')?.1.split_whitespace().skip(11);
+    let user: u64 = fields.next()?.parse().ok()?;
+    let system: u64 = fields.next()?.parse().ok()?;
+    Some((user + system) * TICK_MS)
+}
+
+fn own_cpu_ms() -> Option<u64> {
+    cpu_ms(&std::fs::read_to_string("/proc/self/stat").ok()?)
+}
