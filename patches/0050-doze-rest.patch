diff --git a/crates/slot/tests/doze_rest.rs b/crates/slot/tests/doze_rest.rs
new file mode 100644
index 0000000..249b24e
--- /dev/null
+++ b/crates/slot/tests/doze_rest.rs
@@ -0,0 +1,140 @@
+mod common;
+
+use std::time::{Duration, Instant};
+
+use common::{app_playing_in, tmp_root_with_carts};
+use slot::app::App;
+use slot::doze_rest::{awake_line, cpu_ms, rests, DozeRest, DARK_FRAMES};
+use slot_input::Action;
+
+fn fade_out(a: &mut App) {
+    for _ in 0..30 {
+        a.update(1.0 / 60.0);
+    }
+}
+
+#[test]
+fn awake_never_rests() {
+    let mut d = DozeRest::new();
+    let now = Instant::now();
+    for _ in 0..100 {
+        assert_eq!(d.step(false, now), None);
+        assert!(!d.resting());
+    }
+}
+
+#[test]
+fn a_doze_draws_its_dark_frames_then_rests() {
+    let mut d = DozeRest::new();
+    let now = Instant::now();
+    for i in 0..DARK_FRAMES {
+        d.step(true, now);
+        assert!(!d.resting(), "dark frame {i} was skipped");
+    }
+    for _ in 0..100 {
+        d.step(true, now);
+        assert!(d.resting());
+    }
+}
+
+#[test]
+fn waking_draws_at_once_and_the_next_doze_starts_dark_again() {
+    let mut d = DozeRest::new();
+    let now = Instant::now();
+    for _ in 0..10 {
+        d.step(true, now);
+    }
+    d.step(false, now);
+    assert!(!d.resting(), "the opened lid waited for a poll");
+    d.step(true, now);
+    assert!(!d.resting(), "the next doze skipped its dark frames");
+}
+
+#[test]
+fn entering_a_doze_is_logged_once() {
+    let mut d = DozeRest::new();
+    let now = Instant::now();
+    assert_eq!(
+        d.step(true, now).as_deref(),
+        Some("slot: doze: resting after 2 dark frames, polling every 50 ms")
+    );
+    for _ in 0..10 {
+        assert_eq!(d.step(true, now), None);
+    }
+}
+
+#[test]
+fn waking_logs_the_presents_per_second_of_the_doze() {
+    let mut d = DozeRest::new();
+    let began = Instant::now();
+    for _ in 0..202 {
+        d.step(true, began);
+    }
+    let line = d.step(false, began + Duration::from_secs(10)).unwrap();
+    assert!(
+        line.starts_with("slot: doze: awake after 10.0 s, 2 presents (0.20 per second), 200 polls"),
+        "{line}"
+    );
+}
+
+#[test]
+fn the_wake_line_ends_with_the_cpu_time_when_it_is_known() {
+    assert_eq!(
+        awake_line(Duration::from_secs(4), 2, 80, Some(120)),
+        "slot: doze: awake after 4.0 s, 2 presents (0.50 per second), 80 polls, 120 ms of cpu"
+    );
+    assert_eq!(
+        awake_line(Duration::from_secs(4), 2, 80, None),
+        "slot: doze: awake after 4.0 s, 2 presents (0.50 per second), 80 polls"
+    );
+}
+
+#[test]
+fn the_cpu_time_is_user_plus_system_ticks() {
+    let stat = "812 (slot (main)) S 1 812 812 0 -1 4194560 9 0 0 0 1234 56 0 0 20 0 9 0 300";
+    assert_eq!(cpu_ms(stat), Some(12_900));
+    assert_eq!(cpu_ms("garbage"), None);
+}
+
+#[test]
+fn a_shut_lid_rests_and_an_open_one_does_not() {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    let mut a = app_playing_in(d.path(), "Emerald");
+    assert!(!rests(&a));
+    a.apply(Action::LidClose);
+    fade_out(&mut a);
+    assert!(rests(&a));
+    a.apply(Action::LidOpen);
+    assert!(!rests(&a));
+}
+
+#[test]
+fn a_doze_keeps_drawing_until_the_picture_has_faded_to_black() {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    let mut a = app_playing_in(d.path(), "Emerald");
+    a.apply(Action::LidClose);
+    a.update(1.0 / 60.0);
+    assert!(a.screen_power() > 0.0);
+    assert!(!rests(&a));
+}
+
+#[test]
+fn the_doze_power_off_draws_its_shutdown() {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    let mut a = app_playing_in(d.path(), "Emerald");
+    a.apply(Action::LidClose);
+    fade_out(&mut a);
+    a.on_doze_timeout();
+    assert!(a.shutting_down());
+    assert!(!rests(&a));
+}
+
+#[test]
+fn a_link_that_starts_behind_a_shut_lid_keeps_drawing() {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    let mut a = app_playing_in(d.path(), "Emerald");
+    a.apply(Action::LidClose);
+    fade_out(&mut a);
+    a.begin_link(1);
+    assert!(!rests(&a));
+}
