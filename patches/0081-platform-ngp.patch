@@ -0,0 +1,26 @@
+mod common;
+mod core_common;
+mod ngp_common;
+mod real_seat;
+
+use common::core_lock;
+use ngp_common::{cart, neopop, red};
+use slot_store::{Core, Platform};
+
+#[test]
+fn an_ngp_cart_seats_on_neopop_through_a_real_session() {
+    let _g = core_lock();
+    let Some(dylib) = neopop() else {
+        return;
+    };
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = cart(carts.path(), "Pocket", false);
+    let root = real_seat::rooted(Platform::Ngp, "Pocket", &rom, &dylib);
+    let session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::MednafenNgp);
+    assert_eq!(session.app().playing_platform(), Platform::Ngp);
+    let emu = session.emu().expect("no core in the slot");
+    let frame = emu.latest_frame().expect("nothing was published");
+    assert_eq!(frame.len(), 240 * 160 * 4);
+    assert_eq!(red(&frame), 160 * 152);
+}
