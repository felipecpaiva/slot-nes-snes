diff --git a/crates/slot-store/src/ngp.rs b/crates/slot-store/src/ngp.rs
new file mode 100644
index 0000000..7cdffcf
--- /dev/null
+++ b/crates/slot-store/src/ngp.rs
@@ -0,0 +1,48 @@
+use std::fs::File;
+use std::io::Read;
+use std::path::Path;
+
+pub const HEADER_LEN: usize = 0x30;
+const COLOUR_OFF: usize = 0x23;
+const COLOUR: u8 = 0x10;
+const TITLE_OFF: usize = 0x24;
+const TITLE_LEN: usize = 12;
+const SIGNATURES: [&[u8]; 2] = [
+    b"COPYRIGHT BY SNK CORPORATION",
+    b" LICENSED BY SNK CORPORATION",
+];
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Header {
+    pub colour: bool,
+    pub title: String,
+}
+
+impl Header {
+    pub fn parse(bytes: &[u8]) -> Option<Header> {
+        let bytes = bytes.get(..HEADER_LEN)?;
+        if !SIGNATURES.iter().any(|s| bytes.starts_with(s)) {
+            return None;
+        }
+        let title = &bytes[TITLE_OFF..TITLE_OFF + TITLE_LEN];
+        let end = title.iter().position(|b| *b == 0).unwrap_or(TITLE_LEN);
+        Some(Header {
+            colour: bytes[COLOUR_OFF] == COLOUR,
+            title: String::from_utf8_lossy(&title[..end]).trim().to_string(),
+        })
+    }
+}
+
+pub fn header(rom: &Path) -> Option<Header> {
+    let mut bytes = Vec::with_capacity(HEADER_LEN);
+    File::open(rom)
+        .ok()?
+        .take(HEADER_LEN as u64)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    Header::parse(&bytes)
+}
+
+pub fn is_colour(rom: &Path) -> bool {
+    header(rom).is_some_and(|h| h.colour)
+}
