diff --git a/crates/slot/tests/ngp_common/mod.rs b/crates/slot/tests/ngp_common/mod.rs
new file mode 100644
index 0000000..9616505
--- /dev/null
+++ b/crates/slot/tests/ngp_common/mod.rs
@@ -0,0 +1,83 @@
+#![allow(dead_code)]
+// The synthetic cart follows nelynes/slotPlus's ngp_core.rs
+// (https://github.com/nelynes/slotPlus/commit/a8eae4c, GPL-3.0): the SNK header, the start address at
+// 0x1c, the colour byte at 0x23 and a `jr t,-2` spin. The paint and flash-command code is ours.
+
+use std::path::{Path, PathBuf};
+
+use crate::core_common::require_core;
+
+pub const ROM_START: usize = 0x20_0000;
+pub const FLASH_AT: usize = 0x20_f000;
+pub const MARK: u8 = 0x5a;
+// FlashFileHeader (8 bytes), one FlashFileBlockHeader (6, padded to 8), then the 256-byte block.
+pub const FLASH_LEN: usize = 8 + 8 + 256;
+pub const RED: u16 = 0x000f;
+
+pub fn neopop() -> Option<PathBuf> {
+    require_core("mednafen_ngp")
+}
+
+fn ld24(addr: usize, byte: u8) -> [u8; 6] {
+    // LD (n24),#: the 24-bit memory prefix 0xf2, the address low byte first, DST LD.B #, the byte.
+    let [a0, a1, a2, _] = (addr as u32).to_le_bytes();
+    [0xf2, a0, a1, a2, 0x00, byte]
+}
+
+fn ldw16(addr: u16, word: u16) -> [u8; 6] {
+    // LD.W (n16),#: the 16-bit memory prefix 0xf1, the address, DST LD.W #, the word.
+    let [a0, a1] = addr.to_le_bytes();
+    let [w0, w1] = word.to_le_bytes();
+    [0xf1, a0, a1, 0x02, w0, w1]
+}
+
+/// A 64 KB cart that paints the whole screen red (the background and out-of-window palette
+/// entries), optionally writes `mark` to cart flash at `FLASH_AT` through the AA/55/A0 command,
+/// then spins. Byte 0x23 is 0x10 for a Pocket Color cart and 0x00 for a mono one.
+pub fn cart_bytes(write_flash: Option<u8>, colour: bool) -> Vec<u8> {
+    let mut rom = vec![0u8; 0x10000];
+    rom[..28].copy_from_slice(b"COPYRIGHT BY SNK CORPORATION");
+    rom[0x1c..0x20].copy_from_slice(&(ROM_START as u32 + 0x40).to_le_bytes());
+    rom[0x23] = if colour { 0x10 } else { 0x00 };
+    rom[0x24..0x30].copy_from_slice(b"SLOT NGP    ");
+    let mut code = Vec::new();
+    code.extend(ldw16(0x83e0, RED));
+    code.extend(ldw16(0x83f0, RED));
+    if let Some(mark) = write_flash {
+        code.extend(ld24(0x20_5555, 0xaa));
+        code.extend(ld24(0x20_2aaa, 0x55));
+        code.extend(ld24(0x20_5555, 0xa0));
+        code.extend(ld24(FLASH_AT, mark));
+    }
+    code.extend([0x68, 0xfe]);
+    rom[0x40..0x40 + code.len()].copy_from_slice(&code);
+    rom
+}
+
+pub fn cart(dir: &Path, stem: &str, write_flash: bool) -> PathBuf {
+    let path = dir.join(format!("{stem}.ngc"));
+    std::fs::write(&path, cart_bytes(write_flash.then_some(MARK), true)).unwrap();
+    path
+}
+
+pub fn red(frame: &[u8]) -> usize {
+    frame
+        .chunks_exact(4)
+        .filter(|px| px[2] > 200 && px[1] < 60 && px[0] < 60)
+        .count()
+}
+
+/// The flash file NeoPop writes for one block at `FLASH_AT` holding `mark`.
+pub fn assert_holds(flash: &Path, mark: u8) {
+    let bytes = std::fs::read(flash).expect("no .flash file");
+    assert_eq!(bytes.len(), FLASH_LEN, "{} bytes", bytes.len());
+    assert_eq!(&bytes[..2], &0x0053u16.to_le_bytes(), "flash id");
+    assert_eq!(&bytes[2..4], &1u16.to_le_bytes(), "block count");
+    assert_eq!(
+        &bytes[8..12],
+        &(FLASH_AT as u32).to_le_bytes(),
+        "block address"
+    );
+    assert_eq!(bytes[16], mark);
+    assert!(bytes[17..].iter().all(|&b| b == 0));
+}
