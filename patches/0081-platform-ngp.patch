diff --git a/crates/slot-store/tests/ngp_platform.rs b/crates/slot-store/tests/ngp_platform.rs
new file mode 100644
index 0000000..f23f438
--- /dev/null
+++ b/crates/slot-store/tests/ngp_platform.rs
@@ -0,0 +1,209 @@
+mod common;
+
+use std::path::{Path, PathBuf};
+
+use common::tmp_root;
+use slot_store::ngp::{header, is_colour, Header};
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Cart, Core,
+    Platform, RetroShader, SegaShaders, Shader, SlotState, NGP_SHADER_FILE,
+};
+
+fn rom(colour: u8) -> Vec<u8> {
+    let mut rom = vec![0u8; 0x200];
+    rom[..28].copy_from_slice(b"COPYRIGHT BY SNK CORPORATION");
+    rom[0x23] = colour;
+    rom[0x24..0x30].copy_from_slice(b"SONIC POCKET");
+    rom
+}
+
+fn put(root: &Path, name: &str, bytes: &[u8]) -> PathBuf {
+    let dir = root.join("Games/NGP");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let p = dir.join(name);
+    std::fs::write(&p, bytes).expect("write");
+    p
+}
+
+fn ngp(root: &Path) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == Platform::Ngp)
+        .collect()
+}
+
+#[test]
+fn the_neogeo_pocket_is_the_last_shelf_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES.last(), Some(&Platform::Ngp));
+    assert_eq!(Platform::ALL.len(), 3);
+}
+
+#[test]
+fn an_ngc_cart_lands_on_the_ngp_shelf() {
+    let d = tmp_root();
+    put(
+        d.path(),
+        "Sonic the Hedgehog Pocket Adventure (World).ngc",
+        &rom(0x10),
+    );
+    put(d.path(), "Metal Slug 2nd Mission (World).NGP", &rom(0x10));
+    put(d.path(), "Neo Turf Masters (World).ngpc", &rom(0x00));
+    put(
+        d.path(),
+        "._Sonic the Hedgehog Pocket Adventure (World).ngc",
+        &rom(0x10),
+    );
+    put(d.path(), "Homebrew.npc", &rom(0x10));
+    put(d.path(), "Notes.txt", b"");
+    let mut carts = ngp(d.path());
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(
+        stems,
+        [
+            "Metal Slug 2nd Mission (World)",
+            "Neo Turf Masters (World)",
+            "Sonic the Hedgehog Pocket Adventure (World)",
+        ]
+    );
+    for c in &mut carts {
+        c.read_header();
+        assert!(c.title.is_empty(), "{} took a header title", c.stem);
+        assert!(c.code.is_empty());
+        assert_eq!(c.rom.parent(), Some(d.path().join("Games/NGP").as_path()));
+    }
+    assert_eq!(Platform::Ngp.dir_name(), "NGP");
+    assert_eq!(Platform::Ngp.name(), "SNK Neo Geo Pocket");
+}
+
+#[test]
+fn the_header_colour_byte_picks_color_or_mono() {
+    let d = tmp_root();
+    let color = put(d.path(), "Color.ngp", &rom(0x10));
+    let mono = put(d.path(), "Mono.ngc", &rom(0x00));
+    let short = put(d.path(), "Short.ngc", &rom(0x10)[..0x2f]);
+    assert!(is_colour(&color), "a Color cart in a .ngp file");
+    assert!(!is_colour(&mono));
+    assert!(!is_colour(&short));
+    assert_eq!(
+        header(&color),
+        Some(Header {
+            colour: true,
+            title: "SONIC POCKET".into()
+        })
+    );
+    assert_eq!(header(&short), None);
+}
+
+#[test]
+fn a_licensed_by_snk_cart_is_read_and_an_unsigned_one_is_mono() {
+    let mut licensed = rom(0x10);
+    licensed[..28].copy_from_slice(b" LICENSED BY SNK CORPORATION");
+    assert_eq!(Header::parse(&licensed).map(|h| h.colour), Some(true));
+    let mut unsigned = rom(0x10);
+    unsigned[..28].copy_from_slice(&[0xff; 28]);
+    assert_eq!(Header::parse(&unsigned), None);
+}
+
+#[test]
+fn a_short_or_unsigned_file_still_lists_with_its_stem_as_title() {
+    let d = tmp_root();
+    put(d.path(), "Tiny.ngc", b"\x01\x02");
+    put(d.path(), "Empty.ngp", b"");
+    let mut carts = ngp(d.path());
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(stems, ["Empty", "Tiny"]);
+    for c in &mut carts {
+        c.read_header();
+        assert!(c.title.is_empty());
+        assert!(!is_colour(&c.rom));
+    }
+}
+
+#[test]
+fn the_neogeo_pocket_keeps_slots_shoulders_and_turbo_and_answers_every_policy() {
+    let p = Platform::Ngp;
+    assert!(p.owns_shoulders());
+    assert!(!p.passes_xy_through());
+    assert!(p.select_x_toggles_picture());
+    assert_eq!(p.picker_cores(), None);
+    assert!(p.stretch_crops_height());
+    assert_eq!(p.overscan(), (0, 0));
+    assert!(!p.follows_frame_width());
+    assert!(!p.has_gb_palettes());
+    assert!(p.rewinds());
+    assert!(!p.fills_canvas());
+    assert!(!p.swaps_discs());
+    assert!(p.owns_triggers());
+    assert_eq!(p.picture(), (160, 152));
+    assert_eq!(p.shader_choices(), &Shader::GG);
+}
+
+#[test]
+fn the_neogeo_pocket_runs_on_beetle_neopop_alone_on_the_gba_sized_canvas() {
+    assert_eq!(Core::default_for(Platform::Ngp), Core::MednafenNgp);
+    assert_eq!(Core::EVERY.last(), Some(&Core::MednafenNgp));
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Ngp),
+            core == Core::MednafenNgp,
+            "{core:?}"
+        );
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::MednafenNgp.runs(platform),
+            platform == Platform::Ngp,
+            "{platform:?}"
+        );
+    }
+    assert_eq!(Core::MednafenNgp.canvas(Platform::Ngp), (240, 160));
+    assert_eq!(Core::MednafenNgp.as_str(), "mednafen_ngp");
+    assert_eq!(Core::MednafenNgp.option_prefix(), "ngp");
+    assert_eq!(
+        Core::MednafenNgp.pair(),
+        (Core::MednafenNgp, Core::MednafenNgp)
+    );
+    assert_eq!(Core::parse("mednafen_ngp"), Some(Core::MednafenNgp));
+    assert!(!Core::MednafenNgp.has_colour_correction());
+}
+
+#[test]
+fn a_neogeo_pocket_game_resumes_as_a_neogeo_pocket_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Sonic the Hedgehog Pocket Adventure (World)".into()),
+        cart_platform: Some(Platform::Ngp),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=ngp"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn the_ngp_shader_lives_in_its_own_file_and_leaves_the_others_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        ngp: Shader::Lcd3x,
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(NGP_SHADER_FILE)).expect("read"),
+        "ngp=lcd3x\n"
+    );
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    assert!(!d.path().join("Config/ps1_shader.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+    let file = d.path().join("Config").join(NGP_SHADER_FILE);
+    std::fs::write(&file, "ngp=crt-pi\n").expect("write");
+    assert_eq!(
+        read_sega_shaders(d.path()).ngp,
+        Shader::Retro(RetroShader::CrtPi)
+    );
+    std::fs::write(&file, "ngp=simpletex\n").expect("write");
+    assert_eq!(read_sega_shaders(d.path()).ngp, Shader::Off);
+}
