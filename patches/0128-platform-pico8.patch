diff --git a/crates/slot-store/src/pico8.rs b/crates/slot-store/src/pico8.rs
new file mode 100644
index 0000000..4152781
--- /dev/null
+++ b/crates/slot-store/src/pico8.rs
@@ -0,0 +1,111 @@
+use std::fs::File;
+use std::io::Read;
+use std::path::Path;
+
+const HEAD_LEN: u64 = 4096;
+
+/// A `.p8` file is a cart (text or PNG inside); a `.png` is one only when named `<name>.p8.png`, the
+/// PICO-8 export name, so a stray picture on the shelf is never offered to the core.
+pub fn admits(rom: &Path) -> bool {
+    let png = rom
+        .extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| e.eq_ignore_ascii_case("png"));
+    if !png || is_p8_png(rom) {
+        return true;
+    }
+    eprintln!(
+        "slot: scan: {}: a .png is a PICO-8 cart only as <name>.p8.png",
+        rom.display()
+    );
+    false
+}
+
+fn is_p8_png(rom: &Path) -> bool {
+    rom.file_stem()
+        .and_then(|s| s.to_str())
+        .is_some_and(|s| s.len() > 3 && s[s.len() - 3..].eq_ignore_ascii_case(".p8"))
+}
+
+/// The shelf title: the cart's own first comment line for a text cart (PICO-8 shows its code in
+/// capitals, so each word is capitalised), else the file stem without `.p8`, `_` read as a space.
+pub fn title(rom: &Path, stem: &str) -> String {
+    header_title(rom).unwrap_or_else(|| stem_title(stem))
+}
+
+pub fn stem_title(stem: &str) -> String {
+    let bare = match stem.len().checked_sub(3) {
+        Some(at) if stem.is_char_boundary(at) && stem[at..].eq_ignore_ascii_case(".p8") => {
+            &stem[..at]
+        }
+        _ => stem,
+    };
+    bare.replace('_', " ").trim().to_string()
+}
+
+fn header_title(rom: &Path) -> Option<String> {
+    let mut head = Vec::new();
+    File::open(rom)
+        .and_then(|f| f.take(HEAD_LEN).read_to_end(&mut head))
+        .ok()?;
+    if !head.starts_with(b"pico-8 cartridge") {
+        return None;
+    }
+    let text = String::from_utf8_lossy(&head);
+    let mut lines = text.lines().skip_while(|l| l.trim() != "__lua__").skip(1);
+    comment_title(lines.next()?)
+}
+
+pub fn comment_title(line: &str) -> Option<String> {
+    let body = line.trim().strip_prefix("--")?;
+    let body = body.trim_matches(|c: char| c == '-' || c == '~' || c == '=' || c.is_whitespace());
+    let body = match body.find(" by ") {
+        Some(at) => &body[..at],
+        None => body,
+    };
+    if body.starts_with("by ") {
+        return None;
+    }
+    let body = body.replace(':', " - ");
+    let words: Vec<&str> = body.split_whitespace().filter(|w| !is_version(w)).collect();
+    if words.is_empty() {
+        return None;
+    }
+    let title = words
+        .iter()
+        .enumerate()
+        .map(|(i, w)| capitalised(w, i == 0))
+        .collect::<Vec<_>>()
+        .join(" ");
+    let title = title.trim_matches(|c: char| c == '~').trim().to_string();
+    (!title.is_empty()).then_some(title)
+}
+
+const SMALL: [&str; 11] = [
+    "a", "an", "and", "at", "for", "in", "of", "on", "or", "the", "to",
+];
+
+/// The word with its first letter (after a leading "(") in capitals; a small word stays lower case
+/// unless it starts the title.
+fn capitalised(word: &str, first: bool) -> String {
+    let (lead, rest) = match word.strip_prefix('(') {
+        Some(rest) => ("(", rest),
+        None => ("", word),
+    };
+    if !first && SMALL.contains(&rest.to_lowercase().as_str()) {
+        return format!("{lead}{rest}");
+    }
+    let mut c = rest.chars();
+    let head: String = c
+        .next()
+        .map(|f| f.to_uppercase().collect())
+        .unwrap_or_default();
+    format!("{lead}{head}{}", c.as_str())
+}
+
+fn is_version(word: &str) -> bool {
+    let w = word.to_ascii_lowercase();
+    w == "version"
+        || w.strip_prefix('v')
+            .is_some_and(|n| !n.is_empty() && n.chars().all(|c| c.is_ascii_digit() || c == '.'))
+}
