diff --git a/crates/slot-store/tests/pico8_platform.rs b/crates/slot-store/tests/pico8_platform.rs
new file mode 100644
index 0000000..7fb3ce2
--- /dev/null
+++ b/crates/slot-store/tests/pico8_platform.rs
@@ -0,0 +1,178 @@
+mod common;
+
+use std::path::{Path, PathBuf};
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Cart, Core,
+    Platform, RetroShader, SegaShaders, Shader, SlotState, PICO8_SHADER_FILE,
+};
+
+fn put(root: &Path, name: &str, bytes: &[u8]) -> PathBuf {
+    let dir = root.join("Games/PICO8");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let p = dir.join(name);
+    std::fs::write(&p, bytes).expect("write");
+    p
+}
+
+fn pico8(root: &Path) -> Vec<Cart> {
+    let mut carts: Vec<Cart> = scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == Platform::Pico8)
+        .collect();
+    for c in &mut carts {
+        c.read_header();
+    }
+    carts
+}
+
+const TEXT: &[u8] = b"pico-8 cartridge // http://www.pico-8.com\nversion 41\n__lua__\n\
+-- ~celeste~ v1.2\n-- by matt thorson + noel berry\n";
+
+#[test]
+fn pico_8_is_the_last_shelf_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES.last(), Some(&Platform::Pico8));
+    assert_eq!(Platform::SHELVES.len(), 22);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::Pico8.dir_name(), "PICO8");
+    assert_eq!(Platform::Pico8.name(), "PICO-8");
+}
+
+#[test]
+fn a_p8_or_a_p8_png_lands_on_the_shelf_and_a_bare_png_does_not() {
+    let d = tmp_root();
+    put(d.path(), "Celeste.p8", TEXT);
+    put(d.path(), "Cherry_Bomb.p8.png", b"\x89PNG");
+    put(d.path(), "Pico_Racer.P8.PNG", b"\x89PNG");
+    put(d.path(), "cover.png", b"\x89PNG");
+    put(d.path(), "._Celeste.p8", TEXT);
+    let stems: Vec<String> = pico8(d.path()).into_iter().map(|c| c.stem).collect();
+    assert_eq!(stems, ["Celeste", "Cherry_Bomb.p8", "Pico_Racer.P8"]);
+}
+
+#[test]
+fn a_text_cart_is_titled_by_its_first_comment_and_a_png_cart_by_its_name() {
+    let d = tmp_root();
+    put(d.path(), "Celeste.p8", TEXT);
+    put(d.path(), "Cherry_Bomb.p8.png", b"\x89PNG");
+    put(
+        d.path(),
+        "Credits.p8",
+        b"pico-8 cartridge // http://www.pico-8.com\nversion 41\n__lua__\n--by someone\nx=1\n",
+    );
+    let titles: Vec<String> = pico8(d.path()).into_iter().map(|c| c.title).collect();
+    assert_eq!(titles, ["Celeste", "Cherry Bomb", "Credits"]);
+}
+
+#[test]
+fn a_comment_title_drops_dashes_tildes_versions_and_the_author() {
+    use slot_store::pico8::comment_title;
+    assert_eq!(comment_title("-- ~celeste~"), Some("Celeste".into()));
+    assert_eq!(comment_title("-- slacker v1.2"), Some("Slacker".into()));
+    assert_eq!(
+        comment_title("-- ~perisher~ by daniel linssen"),
+        Some("Perisher".into())
+    );
+    assert_eq!(
+        comment_title("--          = pico racer ="),
+        Some("Pico Racer".into())
+    );
+    assert_eq!(
+        comment_title("-- tomb of g'nir"),
+        Some("Tomb of G'nir".into())
+    );
+    assert_eq!(
+        comment_title("-- breakout hero (beta)"),
+        Some("Breakout Hero (Beta)".into())
+    );
+    assert_eq!(
+        comment_title("--valdi:beginnings"),
+        Some("Valdi - Beginnings".into())
+    );
+    assert_eq!(comment_title("-- the lair "), Some("The Lair".into()));
+    assert_eq!(comment_title("--by matthieu le gallic"), None);
+    assert_eq!(comment_title("-------------------------------"), None);
+    assert_eq!(comment_title("pr_recipe=3"), None);
+}
+
+#[test]
+fn pico_8_plays_like_the_nes_with_the_picture_toggle_and_no_rewind() {
+    let p = Platform::Pico8;
+    assert!(p.owns_shoulders());
+    assert!(p.owns_triggers());
+    assert!(!p.passes_xy_through());
+    assert!(!p.turbo_on_xy());
+    assert!(p.select_x_toggles_picture());
+    assert!(p.stretch_crops_height());
+    assert!(!p.rewinds());
+    assert_eq!(p.overscan(), (0, 0));
+    assert!(!p.follows_frame_width());
+    assert!(!p.has_gb_palettes());
+    assert!(!p.fills_canvas());
+    assert!(!p.swaps_discs());
+    assert_eq!(p.actual_scale(), None);
+    assert!(!p.flashes_on_unload());
+    assert!(!p.is_arcade());
+    assert_eq!(p.picker_cores(), None);
+    assert_eq!(p.picture(), (128, 128));
+    assert_eq!(p.shader_choices(), &Shader::RETRO);
+    assert_eq!(p.extensions(), ["p8", "png"]);
+}
+
+#[test]
+fn pico_8_runs_on_fake_08_alone_on_a_canvas_three_times_smaller_than_the_panel() {
+    assert_eq!(Core::default_for(Platform::Pico8), Core::Fake08);
+    assert_eq!(Core::EVERY.last(), Some(&Core::Fake08));
+    assert_eq!(Core::Fake08.as_str(), "fake08");
+    assert_eq!(Core::Fake08.option_prefix(), "fake08");
+    assert_eq!(Core::parse("fake08"), Some(Core::Fake08));
+    assert_eq!(Core::Fake08.text(), "FAKE-08");
+    assert_eq!(Core::Fake08.canvas(Platform::Pico8), (240, 160));
+    assert_eq!((240 * 3, 160 * 3), (720, 480));
+    assert_eq!(Core::Fake08.pair(), (Core::Fake08, Core::Fake08));
+    assert!(Core::Fake08.reports_its_frame_rate());
+    assert!(!Core::Fake08.has_colour_correction());
+    for core in Core::EVERY {
+        assert_eq!(core.runs(Platform::Pico8), core == Core::Fake08, "{core:?}");
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::Fake08.runs(platform),
+            platform == Platform::Pico8,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn a_pico_8_game_resumes_as_a_pico_8_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Celeste".into()),
+        cart_platform: Some(Platform::Pico8),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=pico8"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn the_pico_8_shader_lives_in_its_own_file_and_leaves_the_others_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        pico8: Shader::Retro(RetroShader::Sharp),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(PICO8_SHADER_FILE)).expect("read"),
+        "pico8=sharp\n"
+    );
+    assert!(!d.path().join("Config/vb_shader.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+}
