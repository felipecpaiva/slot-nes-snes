diff --git a/crates/slot/tests/pico8_screen.rs b/crates/slot/tests/pico8_screen.rs
new file mode 100644
index 0000000..d9a23d6
--- /dev/null
+++ b/crates/slot/tests/pico8_screen.rs
@@ -0,0 +1,127 @@
+// The PICO-8 Screen section (ADR 0102): Shader (Off and the retro list) and Picture (Actual, a 3x
+// integer 384x384 picture in the 720x480 panel, or Stretch).
+mod common;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::video_mode::{source_rect, VideoMode};
+use slot_gfx::WHOLE_TEXTURE;
+use slot_input::{Action, Btn};
+use slot_store::{read_sega_shaders, Core, Platform, Shader, PICO8_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_a_cart() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(
+        root.path().join("Games/PICO8/Celeste.p8"),
+        b"pico-8 cartridge\n",
+    )
+    .expect("write cart");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_pico8(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    while app.quick_menu() != Some(QuickRow::ScreenPico8) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+}
+
+#[test]
+fn pico_8_is_the_last_screen_section_with_shader_and_picture() {
+    assert_eq!(QuickRow::SCREEN.last(), Some(&QuickRow::ScreenPico8));
+    assert_eq!(QuickRow::ScreenPico8.label(), "PICO-8");
+    assert!(QuickRow::ScreenPico8.opens());
+    assert_eq!(QuickRow::ScreenPico8.child(), Some(QuickRow::Pico8Shader));
+    assert_eq!(
+        QuickRow::SCREEN_PICO8.map(QuickRow::label),
+        ["Shader", "Picture"]
+    );
+    for row in QuickRow::SCREEN_PICO8 {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenPico8));
+    }
+}
+
+#[test]
+fn the_pico_8_row_shows_only_on_a_card_with_pico_8_games() {
+    let (_root, mut app) = card_with_a_cart();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenPico8));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    let without = boot(root.path());
+    assert!(without.hidden_rows().contains(&QuickRow::ScreenPico8));
+    open_pico8(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::Pico8Shader));
+}
+
+#[test]
+fn the_picture_starts_actual_and_offers_stretch_and_its_own_line_in_picture_txt() {
+    assert_eq!(default_video_mode(Platform::Pico8), VideoMode::Actual);
+    assert_eq!(
+        picture_choices(Platform::Pico8),
+        [VideoMode::Stretch, VideoMode::Actual]
+    );
+    let (root, mut app) = card_with_a_cart();
+    open_pico8(&mut app);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::Pico8Picture));
+    assert_eq!(
+        app.quick_value(QuickRow::Pico8Picture),
+        Some(QuickValue::Actual)
+    );
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_eq!(
+        system_picture(root.path(), Platform::Pico8),
+        VideoMode::Stretch
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "pico8 = stretch\n"
+    );
+}
+
+#[test]
+fn actual_draws_the_128_square_at_exactly_3x_and_stretch_fills_the_panel() {
+    let canvas = Core::Fake08.canvas(Platform::Pico8);
+    assert_eq!(canvas, (240, 160));
+    assert_eq!(
+        source_rect(Platform::Pico8, (128, 128), canvas, VideoMode::Actual),
+        WHOLE_TEXTURE
+    );
+    assert_eq!((240 * 3, 160 * 3, 128 * 3), (720, 480, 384));
+    assert_eq!(
+        source_rect(Platform::Pico8, (128, 128), canvas, VideoMode::Stretch),
+        [56.0 / 240.0, 16.0 / 160.0, 128.0 / 240.0, 128.0 / 160.0]
+    );
+}
+
+#[test]
+fn the_pico_8_shader_walks_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_cart();
+    open_pico8(&mut app);
+    assert_eq!(
+        app.quick_value(QuickRow::Pico8Shader),
+        Some(QuickValue::Off)
+    );
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(read_sega_shaders(root.path()).pico8);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(PICO8_SHADER_FILE).exists());
+}
diff --git a/crates/slot/tests/pico8_seat.rs b/crates/slot/tests/pico8_seat.rs
new file mode 100644
index 0000000..74073b1
--- /dev/null
+++ b/crates/slot/tests/pico8_seat.rs
@@ -0,0 +1,161 @@
+// A PICO-8 cart through a real session on FAKE-08 (ADR 0102): the picture, the pad, cartdata in
+// Saves/PICO8/cdata, no states, and the triggers with rewind off.
+mod common;
+mod core_common;
+mod pico8_common;
+mod real_seat;
+
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use pico8_common::{band, fake08, lit_columns, text_cart, CANVAS, KEY};
+use slot::session::Session;
+use slot_input::{Btn, RawEvent};
+use slot_store::{Core, Platform};
+use slot_ui::QuickRow;
+
+const STEM: &str = "Band";
+
+fn frame(session: &Session) -> Vec<u8> {
+    session
+        .emu()
+        .expect("no core in the slot")
+        .latest_frame()
+        .expect("nothing was published")
+        .to_vec()
+}
+
+fn run(session: &mut Session, frames: usize) {
+    let deadline = Instant::now() + Duration::from_secs(20);
+    let want = session.frames_published() + frames as u64;
+    while session.frames_published() < want {
+        assert!(Instant::now() < deadline, "the core stopped drawing");
+        session.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(1));
+    }
+}
+
+fn hold(session: &mut Session, b: Btn, frames: usize, at: &mut u64) {
+    *at += 20;
+    session.feed([RawEvent::Down(b)], *at);
+    run(session, frames);
+    *at += 20;
+    session.feed([RawEvent::Up(b)], *at);
+    run(session, 8);
+}
+
+fn seated(dylib: &Path) -> (tempfile::TempDir, Session) {
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = text_cart(carts.path(), STEM, "band");
+    let root = real_seat::rooted(Platform::Pico8, STEM, &rom, dylib);
+    let session = real_seat::play(root.path(), true);
+    (root, session)
+}
+
+#[test]
+fn a_pico_8_cart_seats_on_fake_08_and_draws_its_screen_in_the_middle_of_the_canvas() {
+    let _g = core_lock();
+    let Some(dylib) = fake08() else {
+        return;
+    };
+    let (_root, mut session) = seated(&dylib);
+    assert_eq!(session.app().core(), Core::Fake08);
+    assert_eq!(session.app().playing_platform(), Platform::Pico8);
+    run(&mut session, 10);
+    let frame = frame(&session);
+    assert_eq!(frame.len(), CANVAS.0 * CANVAS.1 * 4);
+    assert_eq!(lit_columns(&frame), band(0));
+    assert_eq!(
+        session.app().picture_rect(),
+        [56.0 / 240.0, 16.0 / 160.0, 184.0 / 240.0, 144.0 / 160.0]
+    );
+}
+
+#[test]
+fn the_b_button_is_o_and_cartdata_lands_in_saves_pico8_cdata_while_the_game_runs() {
+    let _g = core_lock();
+    let Some(dylib) = fake08() else {
+        return;
+    };
+    let (root, mut session) = seated(&dylib);
+    let mut at = 1000;
+    hold(&mut session, Btn::B, 6, &mut at);
+    run(&mut session, 70);
+    assert_eq!(lit_columns(&frame(&session)), band(1));
+    let file = root
+        .path()
+        .join("Saves/PICO8/cdata")
+        .join(format!("{KEY}.p8d.txt"));
+    let text = std::fs::read_to_string(&file).expect("no cartdata in Saves/PICO8/cdata");
+    assert!(text.starts_with("00010000"), "{text:?}");
+    assert!(!root.path().join("Saves/cdata").exists());
+}
+
+#[test]
+fn l2_does_not_rewind_and_r2_still_fast_forwards() {
+    let _g = core_lock();
+    let Some(dylib) = fake08() else {
+        return;
+    };
+    let (_root, mut session) = seated(&dylib);
+    assert!(!session.app().may_rewind());
+    assert!(!session.app().records_rewind());
+    let mut at = 1000;
+    session.feed([RawEvent::Down(Btn::L2)], at);
+    run(&mut session, 10);
+    assert_eq!(session.app().ff_badge(), None);
+    at += 20;
+    session.feed([RawEvent::Up(Btn::L2)], at);
+    run(&mut session, 4);
+    at += 20;
+    session.feed([RawEvent::Down(Btn::R2)], at);
+    run(&mut session, 10);
+    assert!(
+        session.app().ff_badge().is_some(),
+        "R2 did not fast-forward"
+    );
+    session.feed([RawEvent::Up(Btn::R2)], at + 20);
+}
+
+#[test]
+fn the_states_page_is_hidden_and_a_quit_leaves_no_resume_state_only_the_cartdata() {
+    let _g = core_lock();
+    let Some(dylib) = fake08() else {
+        return;
+    };
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = text_cart(carts.path(), STEM, "band");
+    let root = real_seat::rooted(Platform::Pico8, STEM, &rom, &dylib);
+    text_cart(&root.path().join("Games/PICO8"), "Zzz", "zzz");
+    let mut session = real_seat::play(root.path(), true);
+    assert!(session.app().in_game_hidden().contains(&QuickRow::States));
+    let mut at = 1000;
+    hold(&mut session, Btn::B, 6, &mut at);
+    run(&mut session, 4);
+    at += 20;
+    session.feed([RawEvent::Down(Btn::Menu)], at);
+    let deadline = Instant::now() + Duration::from_secs(20);
+    while session.has_core() {
+        assert!(
+            Instant::now() < deadline,
+            "the eject never finished: {:?}",
+            session.app().phase()
+        );
+        at += 16;
+        session.feed([], at);
+        session.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    let states = root.path().join("States/PICO8");
+    let left: Vec<_> = std::fs::read_dir(&states)
+        .map(|d| d.filter_map(|e| e.ok()).map(|e| e.file_name()).collect())
+        .unwrap_or_default();
+    assert!(left.is_empty(), "a state was written: {left:?}");
+    let file = root
+        .path()
+        .join("Saves/PICO8/cdata")
+        .join(format!("{KEY}.p8d.txt"));
+    let text = std::fs::read_to_string(&file).expect("the cartdata was not written at eject");
+    assert!(text.starts_with("00010000"), "{text:?}");
+}
