+#[test]
+fn the_super_hucard_draws_its_label_art_and_a_generated_label_without_one() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let with = cart_face(&daimakaimura(Some(magenta_label(d.path()))));
+    let without = cart_face(&daimakaimura(None));
+    let (lx, ly, lw, lh) = px_rect(retro_label_rect(RetroShell::Sgx));
+    let centre = (lx + lw / 2, ly + lh / 2);
+    assert_eq!(pixel(&with.rgba, with.w, centre.0, centre.1), [255, 0, 255]);
+    assert_ne!(
+        pixel(&without.rgba, without.w, centre.0, centre.1),
+        [255, 0, 255]
+    );
+}
