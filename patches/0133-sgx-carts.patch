+#[test]
+fn the_super_hucard_is_the_hucard_turned_over_with_the_contacts_above_the_label() {
+    let (_, ch) = cart_box(Platform::Sgx);
+    let (hx, hy, hw, hh) = px_rect(retro_label_rect(RetroShell::Hucard));
+    let (sx, sy, sw, sh) = px_rect(retro_label_rect(RetroShell::Sgx));
+    assert_eq!((sx, sw, sh), (hx, hw, hh));
+    assert!(
+        sy.abs_diff(ch - (hy + hh)) <= 1,
+        "{sy} vs {}",
+        ch - (hy + hh)
+    );
+    assert!(
+        (sy + sh / 2) * 2 < ch,
+        "label centre {} of {ch}",
+        sy + sh / 2
+    );
+    let (_, ty, _, th) = px_rect(retro_strip_rect(RetroShell::Sgx).expect("no contact strip"));
+    assert!(ty + th < sy, "the contacts are not above the label");
+}
