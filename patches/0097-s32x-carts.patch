diff --git a/crates/slot-ui/tests/s32x_cart.rs b/crates/slot-ui/tests/s32x_cart.rs
new file mode 100644
index 0000000..f0a76ce
--- /dev/null
+++ b/crates/slot-ui/tests/s32x_cart.rs
@@ -0,0 +1,117 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    cart_box, label_cover, retro_cart_face, retro_label_rect, retro_shell_of, seated_box,
+    shell_for, RetroShell, S32X_BLACK,
+};
+
+const RED: [u8; 3] = [230, 30, 30];
+
+fn rom(name: &str) -> PathBuf {
+    let mut bytes = vec![0u8; 0x400];
+    bytes[0x100..0x110].copy_from_slice(b"SEGA 32X        ");
+    bytes[0x3c0..0x3d0].copy_from_slice(b"MARS CHECK MODE ");
+    let p = std::env::temp_dir().join(format!("slot-32x-cart-{}-{name}", std::process::id()));
+    std::fs::write(&p, bytes).expect("write rom");
+    p
+}
+
+fn cart(rom: PathBuf, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform: Platform::S32x,
+        stem: "Knuckles' Chaotix (Japan, USA)".into(),
+        rom,
+        label,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn art(name: &str, w: u32, h: u32) -> PathBuf {
+    let px: Vec<u8> = (0..w * h)
+        .flat_map(|_| [RED[0], RED[1], RED[2], 255])
+        .collect();
+    let p = std::env::temp_dir().join(format!("slot-32x-art-{}-{name}.png", std::process::id()));
+    let mut e = png::Encoder::new(std::fs::File::create(&p).expect("create art"), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    p
+}
+
+fn near(p: &[u8], c: [u8; 3]) -> bool {
+    (0..3).all(|i| p[i].abs_diff(c[i]) < 16)
+}
+
+#[test]
+fn every_32x_cart_takes_the_one_32x_shell_in_black_whatever_its_region() {
+    for name in [
+        "chaotix.32x",
+        "doom (E).bin",
+        "Virtua Racing Deluxe (Japan).32x",
+    ] {
+        let c = cart(rom(name), None);
+        assert_eq!(retro_shell_of(&c), Some(RetroShell::S32x), "{name}");
+        assert_eq!(shell_for(&c), S32X_BLACK, "{name}");
+    }
+    assert_eq!(S32X_BLACK.colour, [0x26, 0x24, 0x2a]);
+    assert_eq!(RetroShell::S32x.name(), "s32x");
+}
+
+#[test]
+fn a_chosen_shell_colour_still_wins_over_the_32x_black() {
+    let mut c = cart(rom("chosen.32x"), None);
+    c.shell = Some(ShellChoice {
+        outline: Outline::Auto,
+        colour: [0x10, 0x20, 0x30],
+        finish: ShellFinish::Solid,
+    });
+    assert_eq!(retro_shell_of(&c), Some(RetroShell::S32x));
+    assert_eq!(shell_for(&c).colour, [0x10, 0x20, 0x30]);
+}
+
+#[test]
+fn the_32x_cart_is_the_mega_drive_size_on_the_shelf() {
+    assert_eq!(cart_box(Platform::S32x), (360, 246));
+    assert_eq!(seated_box(Platform::S32x), seated_box(Platform::Md));
+    assert_eq!(cart_box(Platform::S32x), cart_box(Platform::Md));
+    let (x, y, w, h) = retro_label_rect(RetroShell::S32x);
+    let px = |f: f32, of: f32| (f * of).round() as u32;
+    assert_eq!(
+        (px(x, 360.0), px(y, 246.0), px(w, 360.0), px(h, 246.0)),
+        (60, 34, 241, 190)
+    );
+}
+
+#[test]
+fn the_32x_cart_renders_in_its_black_without_a_label() {
+    let face = retro_cart_face(&cart(rom("bare.32x"), None), RetroShell::S32x);
+    assert_eq!((face.w, face.h), (360, 246));
+    let at = |x: u32, y: u32| &face.rgba[((y * 360 + x) * 4) as usize..][..4];
+    assert_eq!(at(0, 0)[3], 0, "the top corner is rounded off");
+    let body = at(40, 235);
+    assert_eq!(body[3], 255);
+    assert!(
+        near(body, [0x26, 0x24, 0x2a]),
+        "the plastic is black: {body:?}"
+    );
+}
+
+#[test]
+fn the_32x_cart_renders_its_label_art_inside_the_well_below_the_top_cap() {
+    let red = art("label", 482, 378);
+    let c = cart(rom("label.32x"), Some(red.clone()));
+    let (_, _, lw, lh) = retro_label_rect(RetroShell::S32x);
+    let (lw, lh) = ((lw * 360.0).round() as u32, (lh * 246.0).round() as u32);
+    assert!(label_cover(&c, &red, lw, lh).is_some());
+    let face = retro_cart_face(&c, RetroShell::S32x);
+    let red_at = |x: u32, y: u32| near(&face.rgba[((y * 360 + x) * 4) as usize..], RED);
+    assert!(red_at(180, 120), "the middle of the well is the label");
+    assert!(!red_at(180, 12), "the top cap is plastic");
+    assert!(!red_at(20, 120), "the ridged side is plastic");
+}
