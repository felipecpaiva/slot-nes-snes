diff --git a/crates/slot/tests/s32x_screen.rs b/crates/slot/tests/s32x_screen.rs
new file mode 100644
index 0000000..6ddf74f
--- /dev/null
+++ b/crates/slot/tests/s32x_screen.rs
@@ -0,0 +1,268 @@
+mod common;
+mod core_common;
+mod s32x_common;
+
+use common::{boot, core_lock, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::pal_speed::PAL_SPEED_FILE;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::s32x_speed::{apply, Renderer, S32xSpeed, SoundRate, S32X_FILE};
+use slot::video_mode::VideoMode;
+use slot_input::{Action, Btn};
+use slot_retro::LibretroCore;
+use slot_store::{read_sega_shaders, Platform, Shader, S32X_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_a_cart() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(root.path().join("Games/32X/Chaotix.32x"), [0u8; 16]).expect("write cart");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_32x(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenS32x.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenS32x));
+    press(app, Btn::A);
+}
+
+fn down_to(app: &mut App, row: QuickRow) {
+    while app.quick_menu() != Some(row) {
+        press(app, Btn::Down);
+    }
+}
+
+#[test]
+fn the_32x_closes_the_screen_list_with_its_own_five_row_section() {
+    assert_eq!(QuickRow::SCREEN.last(), Some(&QuickRow::ScreenS32x));
+    assert_eq!(QuickRow::ScreenS32x.label(), "32X");
+    assert!(QuickRow::ScreenS32x.opens());
+    assert_eq!(QuickRow::ScreenS32x.child(), Some(QuickRow::S32xShader));
+    assert_eq!(
+        QuickRow::SCREEN_S32X.map(QuickRow::label),
+        ["Shader", "Picture", "PAL Speed", "Renderer", "Sound Rate"]
+    );
+    for row in QuickRow::SCREEN_S32X {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenS32x));
+    }
+}
+
+#[test]
+fn the_32x_row_shows_only_on_a_card_with_32x_games() {
+    let (_root, mut app) = card_with_a_cart();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenS32x));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    let without = boot(root.path());
+    assert!(without.hidden_rows().contains(&QuickRow::ScreenS32x));
+    open_32x(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::S32xShader));
+}
+
+#[test]
+fn the_32x_picture_starts_stretch_like_the_mega_drive_and_offers_actual_and_four_three() {
+    assert_eq!(default_video_mode(Platform::S32x), VideoMode::Stretch);
+    assert_eq!(
+        default_video_mode(Platform::S32x),
+        default_video_mode(Platform::Md)
+    );
+    assert_eq!(
+        picture_choices(Platform::S32x),
+        [VideoMode::Stretch, VideoMode::Actual, VideoMode::FourThree]
+    );
+    let (root, mut app) = card_with_a_cart();
+    open_32x(&mut app);
+    down_to(&mut app, QuickRow::S32xPicture);
+    assert_eq!(
+        app.quick_value(QuickRow::S32xPicture),
+        Some(QuickValue::Stretch)
+    );
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_eq!(
+        system_picture(root.path(), Platform::S32x),
+        VideoMode::Actual
+    );
+    assert_eq!(
+        system_picture(root.path(), Platform::Md),
+        VideoMode::Stretch
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "32x = actual\n"
+    );
+}
+
+#[test]
+fn the_32x_shader_walks_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_cart();
+    let state = std::fs::read(root.path().join("Config/slot.state")).ok();
+    open_32x(&mut app);
+    assert_eq!(app.quick_value(QuickRow::S32xShader), Some(QuickValue::Off));
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(read_sega_shaders(root.path()).s32x);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(S32X_SHADER_FILE).exists());
+    assert!(!root.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(
+        std::fs::read(root.path().join("Config/slot.state")).ok(),
+        state
+    );
+}
+
+#[test]
+fn the_32x_pal_speed_row_is_its_own_and_starts_native() {
+    let (root, mut app) = card_with_a_cart();
+    open_32x(&mut app);
+    down_to(&mut app, QuickRow::S32xPalSpeed);
+    assert_eq!(
+        app.quick_value(QuickRow::S32xPalSpeed),
+        Some(QuickValue::Native)
+    );
+    press(&mut app, Btn::Right);
+    assert_eq!(
+        app.quick_value(QuickRow::S32xPalSpeed),
+        Some(QuickValue::Panel)
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PAL_SPEED_FILE)).expect("pal_speed.txt"),
+        "32x = panel\n"
+    );
+    assert!(app.native_pal(Platform::Md));
+}
+
+#[test]
+fn the_renderer_walks_accurate_good_fast_and_the_choice_is_the_next_boots_default() {
+    let (root, mut app) = card_with_a_cart();
+    open_32x(&mut app);
+    down_to(&mut app, QuickRow::S32xRenderer);
+    assert_eq!(
+        app.quick_value(QuickRow::S32xRenderer),
+        Some(QuickValue::Accurate)
+    );
+    let mut seen = Vec::new();
+    for _ in 0..3 {
+        press(&mut app, Btn::Right);
+        seen.push(app.quick_value(QuickRow::S32xRenderer));
+    }
+    assert_eq!(
+        seen,
+        [
+            Some(QuickValue::Good),
+            Some(QuickValue::Fast),
+            Some(QuickValue::Accurate)
+        ]
+    );
+    press(&mut app, Btn::Left);
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(S32X_FILE)).expect("s32x.txt"),
+        "renderer = fast\n"
+    );
+    let again = boot(root.path());
+    assert_eq!(
+        again.quick_value(QuickRow::S32xRenderer),
+        Some(QuickValue::Fast)
+    );
+}
+
+#[test]
+fn the_sound_rate_flips_between_44_and_22_khz_and_the_choice_is_the_next_boots_default() {
+    let (root, mut app) = card_with_a_cart();
+    open_32x(&mut app);
+    down_to(&mut app, QuickRow::S32xSoundRate);
+    assert_eq!(
+        app.quick_value(QuickRow::S32xSoundRate),
+        Some(QuickValue::Khz44)
+    );
+    press(&mut app, Btn::Right);
+    assert_eq!(
+        app.quick_value(QuickRow::S32xSoundRate),
+        Some(QuickValue::Khz22)
+    );
+    let again = boot(root.path());
+    assert_eq!(
+        again.quick_value(QuickRow::S32xSoundRate),
+        Some(QuickValue::Khz22)
+    );
+    assert_eq!(
+        S32xSpeed::read(root.path()),
+        S32xSpeed {
+            renderer: Renderer::Accurate,
+            sound_rate: SoundRate::Khz22
+        }
+    );
+}
+
+#[test]
+fn an_unknown_value_in_s32x_txt_reads_as_the_factory_choice() {
+    let (root, _app) = card_with_a_cart();
+    std::fs::write(
+        root.path().join(S32X_FILE),
+        "renderer = turbo\nsound_rate = 11025\n",
+    )
+    .expect("write");
+    assert_eq!(S32xSpeed::read(root.path()), S32xSpeed::default());
+    let app = boot(root.path());
+    assert_eq!(
+        app.quick_value(QuickRow::S32xRenderer),
+        Some(QuickValue::Accurate)
+    );
+}
+
+#[test]
+fn the_chosen_renderer_and_sound_rate_are_what_picodrive_is_told_at_start() {
+    let _g = core_lock();
+    let Some(dylib) = s32x_common::picodrive() else {
+        return;
+    };
+    let root = tmp_root_with_real_carts(&[]);
+    std::fs::write(
+        root.path().join(S32X_FILE),
+        "renderer = good\nsound_rate = 22050\n",
+    )
+    .expect("write");
+    let mut core = LibretroCore::open_with(&dylib, root.path(), root.path()).expect("open");
+    apply(&mut core, root.path(), Platform::S32x);
+    assert_eq!(core.option("picodrive_renderer").as_deref(), Some("good"));
+    assert_eq!(
+        core.option("picodrive_sound_rate").as_deref(),
+        Some("22050")
+    );
+    drop(core);
+    let mut md = LibretroCore::open_with(&dylib, root.path(), root.path()).expect("open");
+    apply(&mut md, root.path(), Platform::Md);
+    assert_eq!(md.option("picodrive_renderer"), None);
+}
+
+#[test]
+fn every_32x_picture_is_drawn_the_size_the_mega_drive_one_is() {
+    for mode in [VideoMode::Stretch, VideoMode::Actual, VideoMode::FourThree] {
+        for frame_w in [256, 320] {
+            assert_eq!(
+                slot::platform_video::shown(Platform::S32x, frame_w, mode),
+                slot::platform_video::shown(Platform::Md, frame_w, mode),
+                "{mode:?} {frame_w}"
+            );
+        }
+    }
+    assert_eq!(
+        slot::platform_video::shown(Platform::S32x, 320, VideoMode::Actual),
+        (320, 224)
+    );
+}
