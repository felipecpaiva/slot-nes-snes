diff --git a/crates/slot/src/s32x_speed.rs b/crates/slot/src/s32x_speed.rs
new file mode 100644
index 0000000..cb482b4
--- /dev/null
+++ b/crates/slot/src/s32x_speed.rs
@@ -0,0 +1,161 @@
+use std::path::Path;
+
+use slot_retro::LibretroCore;
+use slot_store::{ini, Platform};
+use slot_ui::{QuickRow, QuickValue};
+
+use crate::card_log::CardWrites;
+
+pub const S32X_FILE: &str = "Config/s32x.txt";
+
+const RENDERER_KEY: &str = "renderer";
+const SOUND_RATE_KEY: &str = "sound_rate";
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum Renderer {
+    #[default]
+    Accurate,
+    Good,
+    Fast,
+}
+
+impl Renderer {
+    pub const ALL: [Renderer; 3] = [Renderer::Accurate, Renderer::Good, Renderer::Fast];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Renderer::Accurate => "accurate",
+            Renderer::Good => "good",
+            Renderer::Fast => "fast",
+        }
+    }
+
+    pub fn quick_value(self) -> QuickValue {
+        match self {
+            Renderer::Accurate => QuickValue::Accurate,
+            Renderer::Good => QuickValue::Good,
+            Renderer::Fast => QuickValue::Fast,
+        }
+    }
+
+    fn stepped(self, right: bool) -> Renderer {
+        let n = Renderer::ALL.len();
+        let at = Renderer::ALL.iter().position(|r| *r == self).unwrap_or(0);
+        let next = if right {
+            (at + 1) % n
+        } else {
+            (at + n - 1) % n
+        };
+        Renderer::ALL.get(next).copied().unwrap_or(self)
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum SoundRate {
+    #[default]
+    Khz44,
+    Khz22,
+}
+
+impl SoundRate {
+    pub const ALL: [SoundRate; 2] = [SoundRate::Khz44, SoundRate::Khz22];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            SoundRate::Khz44 => "44100",
+            SoundRate::Khz22 => "22050",
+        }
+    }
+
+    pub fn quick_value(self) -> QuickValue {
+        match self {
+            SoundRate::Khz44 => QuickValue::Khz44,
+            SoundRate::Khz22 => QuickValue::Khz22,
+        }
+    }
+
+    fn flipped(self) -> SoundRate {
+        match self {
+            SoundRate::Khz44 => SoundRate::Khz22,
+            SoundRate::Khz22 => SoundRate::Khz44,
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub struct S32xSpeed {
+    pub renderer: Renderer,
+    pub sound_rate: SoundRate,
+}
+
+fn read_one<T: Copy + Default>(
+    root: &Path,
+    key: &str,
+    all: &[T],
+    name: fn(T) -> &'static str,
+) -> T {
+    let Some(line) = ini::value(root, S32X_FILE, key) else {
+        return T::default();
+    };
+    all.iter()
+        .copied()
+        .find(|v| name(*v) == line)
+        .unwrap_or_else(|| {
+            eprintln!("slot: s32x.txt: ignoring {key}={line}");
+            T::default()
+        })
+}
+
+impl S32xSpeed {
+    pub fn read(root: &Path) -> S32xSpeed {
+        S32xSpeed {
+            renderer: read_one(root, RENDERER_KEY, &Renderer::ALL, Renderer::as_str),
+            sound_rate: read_one(root, SOUND_RATE_KEY, &SoundRate::ALL, SoundRate::as_str),
+        }
+    }
+
+    pub fn quick_value(&self, row: QuickRow) -> Option<QuickValue> {
+        match row {
+            QuickRow::S32xRenderer => Some(self.renderer.quick_value()),
+            QuickRow::S32xSoundRate => Some(self.sound_rate.quick_value()),
+            _ => None,
+        }
+    }
+
+    pub fn change(
+        &mut self,
+        row: QuickRow,
+        right: bool,
+        root: Option<&Path>,
+        writes: &CardWrites,
+    ) -> bool {
+        let (key, value) = match row {
+            QuickRow::S32xRenderer => {
+                self.renderer = self.renderer.stepped(right);
+                (RENDERER_KEY, self.renderer.as_str())
+            }
+            QuickRow::S32xSoundRate => {
+                self.sound_rate = self.sound_rate.flipped();
+                (SOUND_RATE_KEY, self.sound_rate.as_str())
+            }
+            _ => return false,
+        };
+        if let Some(root) = root {
+            let written = ini::write(root, S32X_FILE, key, value);
+            if let Err(e) = &written {
+                eprintln!("slot: emu: could not write s32x.txt: {e}");
+            }
+            writes.wrote("s32x.txt", &written);
+        }
+        true
+    }
+}
+
+pub fn apply(core: &mut LibretroCore, root: &Path, platform: Platform) {
+    if platform != Platform::S32x {
+        return;
+    }
+    let speed = S32xSpeed::read(root);
+    core.set_option("picodrive_renderer", speed.renderer.as_str());
+    core.set_option("picodrive_sound_rate", speed.sound_rate.as_str());
+}
