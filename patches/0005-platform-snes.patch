--- /dev/null
+++ b/crates/slot-store/tests/snes_platform.rs
@@ -0,0 +1,43 @@
+use std::path::Path;
+
+use slot_store::Platform;
+
+#[test]
+fn the_shelves_are_the_three_game_boy_platforms_then_nes_then_snes() {
+    assert_eq!(
+        Platform::SHELVES,
+        [
+            Platform::Gba,
+            Platform::Gb,
+            Platform::Gbc,
+            Platform::Nes,
+            Platform::Snes
+        ]
+    );
+}
+
+#[test]
+fn the_pinned_platform_list_does_not_grow_for_snes() {
+    assert_eq!(Platform::ALL, [Platform::Gba, Platform::Gb, Platform::Gbc]);
+}
+
+#[test]
+fn snes_accepts_sfc_and_smc_files_and_refuses_gba_files() {
+    assert!(Platform::Snes.accepts(Path::new("x.sfc")));
+    assert!(Platform::Snes.accepts(Path::new("X.SMC")));
+    assert!(!Platform::Snes.accepts(Path::new("x.gba")));
+    assert!(!Platform::Snes.accepts(Path::new("x.fig")));
+}
+
+#[test]
+fn snes_has_its_own_name_folder_and_picture() {
+    assert_eq!(Platform::Snes.name(), "Super Nintendo Entertainment System");
+    assert_eq!(Platform::Snes.dir_name(), "SNES");
+    assert_eq!(Platform::Snes.picture(), (256, 224));
+}
+
+#[test]
+fn snes_takes_no_game_boy_palette_and_no_core_picker() {
+    assert!(!Platform::Snes.has_gb_palettes());
+    assert_eq!(Platform::Snes.picker_cores(), None);
+}
