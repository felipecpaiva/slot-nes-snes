new file mode 100644
index 0000000..66c1543
--- /dev/null
+++ b/crates/slot/tests/snes_common/mod.rs
@@ -0,0 +1,49 @@
+use std::path::{Path, PathBuf};
+
+#[derive(Clone, Copy)]
+pub enum Map {
+    Lo,
+    Hi,
+}
+
+pub const SNES_TITLE: &str = "SLOT TEST ROM";
+
+pub fn snes_rom(name: &str, map: Map, copier: bool, sram_kb: u32) -> PathBuf {
+    let (size, header, mode) = match map {
+        Map::Lo => (0x8000usize, 0x7fc0usize, 0x20u8),
+        Map::Hi => (0x10000, 0xffc0, 0x21),
+    };
+    let mut rom = vec![0u8; size];
+    let program = [
+        0x78, 0x18, 0xfb, 0xa9, 0x00, 0x8d, 0x21, 0x21, 0x8d, 0x22, 0x21, 0x8d, 0x22, 0x21, 0xa9,
+        0x0f, 0x8d, 0x00, 0x21, 0x4c, 0x13, 0x80,
+    ];
+    let code = match map {
+        Map::Lo => 0,
+        Map::Hi => 0x8000,
+    };
+    rom[code..code + program.len()].copy_from_slice(&program);
+    rom[header..header + 21].fill(b' ');
+    rom[header..header + SNES_TITLE.len()].copy_from_slice(SNES_TITLE.as_bytes());
+    rom[header + 0x15] = mode;
+    rom[header + 0x16] = if sram_kb > 0 { 0x02 } else { 0x00 };
+    rom[header + 0x17] = (size / 1024).ilog2() as u8;
+    rom[header + 0x18] = if sram_kb > 0 {
+        sram_kb.ilog2() as u8
+    } else {
+        0
+    };
+    rom[header + 0x19] = 0x01;
+    rom[header + 0x3c] = 0x00;
+    rom[header + 0x3d] = 0x80;
+    rom[header + 0x1c..header + 0x1e].copy_from_slice(&0xffffu16.to_le_bytes());
+    let sum = rom.iter().fold(0u16, |a, b| a.wrapping_add(u16::from(*b)));
+    rom[header + 0x1c..header + 0x1e].copy_from_slice(&(!sum).to_le_bytes());
+    rom[header + 0x1e..header + 0x20].copy_from_slice(&sum.to_le_bytes());
+    if copier {
+        rom.splice(0..0, [0u8; 512]);
+    }
+    let p = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
+    std::fs::write(&p, rom).expect("write rom");
+    p
+}
