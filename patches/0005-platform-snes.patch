diff --git a/crates/slot-store/src/snes.rs b/crates/slot-store/src/snes.rs
new file mode 100644
index 0000000..ef98e8e
--- /dev/null
+++ b/crates/slot-store/src/snes.rs
@@ -0,0 +1,120 @@
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::Path;
+
+const COPIER_LEN: u64 = 512;
+const PROBES: [(u64, &[u8]); 2] = [(0x7fc0, &[0, 2, 3]), (0xffc0, &[1, 5])];
+const HEADER_LEN: usize = 0x20;
+const TITLE_LEN: usize = 21;
+const MAP_OFF: usize = 0x15;
+const COMPLEMENT_OFF: usize = 0x1c;
+
+pub fn title(rom: &Path) -> Option<String> {
+    let mut f = File::open(rom).ok()?;
+    let len = f.metadata().ok()?.len();
+    let skip = if len % 1024 == COPIER_LEN {
+        COPIER_LEN
+    } else {
+        0
+    };
+    for (off, modes) in PROBES {
+        let mut head = [0u8; HEADER_LEN];
+        if f.seek(SeekFrom::Start(skip + off)).is_ok() && f.read_exact(&mut head).is_ok() {
+            if let Some(found) = title_of(&head, modes) {
+                return found;
+            }
+        }
+    }
+    None
+}
+
+fn title_of(head: &[u8; HEADER_LEN], modes: &[u8]) -> Option<Option<String>> {
+    if head[MAP_OFF] & 0xe0 != 0x20 || !modes.contains(&(head[MAP_OFF] & 0x0f)) {
+        return None;
+    }
+    let complement = u16::from_le_bytes([head[COMPLEMENT_OFF], head[COMPLEMENT_OFF + 1]]);
+    let checksum = u16::from_le_bytes([head[COMPLEMENT_OFF + 2], head[COMPLEMENT_OFF + 3]]);
+    if complement ^ checksum != 0xffff || checksum == 0 || checksum == 0xffff {
+        return None;
+    }
+    let raw = &head[..TITLE_LEN];
+    let end = raw
+        .iter()
+        .rposition(|b| *b != b' ' && *b != 0)
+        .map_or(0, |i| i + 1);
+    let text = &raw[..end];
+    let printable = text.iter().all(|b| (0x20..=0x7e).contains(b));
+    Some((printable && !text.is_empty()).then(|| String::from_utf8_lossy(text).into_owned()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const LO: &[u8] = &[0, 2, 3];
+    const HI: &[u8] = &[1, 5];
+
+    fn head(title: &[u8], checksum: u16, map: u8) -> [u8; HEADER_LEN] {
+        let mut h = [b' '; HEADER_LEN];
+        h[..title.len()].copy_from_slice(title);
+        h[MAP_OFF] = map;
+        h[COMPLEMENT_OFF..COMPLEMENT_OFF + 2].copy_from_slice(&(!checksum).to_le_bytes());
+        h[COMPLEMENT_OFF + 2..].copy_from_slice(&checksum.to_le_bytes());
+        h
+    }
+
+    #[test]
+    fn a_header_with_a_matching_complement_gives_its_trimmed_title() {
+        assert_eq!(
+            title_of(&head(b"SUPER MARIOWORLD", 0x1234, 0x20), LO),
+            Some(Some("SUPER MARIOWORLD".into()))
+        );
+    }
+
+    #[test]
+    fn a_header_whose_complement_does_not_match_is_not_a_header() {
+        let mut h = head(b"X", 0x1234, 0x20);
+        h[COMPLEMENT_OFF] ^= 1;
+        assert_eq!(title_of(&h, LO), None);
+    }
+
+    #[test]
+    fn a_title_with_katakana_bytes_is_a_header_with_no_title() {
+        assert_eq!(
+            title_of(&head(&[0xb1, 0xb2, 0xb3], 0x1234, 0x20), LO),
+            Some(None)
+        );
+    }
+
+    #[test]
+    fn a_title_of_all_21_characters_is_kept_whole() {
+        assert_eq!(
+            title_of(&head(b"ABCDEFGHIJKLMNOPQRSTU", 0x1234, 0x20), LO),
+            Some(Some("ABCDEFGHIJKLMNOPQRSTU".into()))
+        );
+    }
+
+    #[test]
+    fn a_checksum_of_zero_or_ffff_is_not_a_header() {
+        for sum in [0x0000, 0xffff] {
+            assert_eq!(title_of(&head(b"X", sum, 0x20), LO), None);
+        }
+    }
+
+    #[test]
+    fn a_map_mode_that_does_not_fit_the_probe_is_not_a_header() {
+        assert_eq!(title_of(&head(b"X", 0x1234, 0x21), LO), None);
+        assert_eq!(title_of(&head(b"X", 0x1234, 0x20), HI), None);
+        assert_eq!(title_of(&head(b"X", 0x1234, 0x00), LO), None);
+    }
+
+    #[test]
+    fn the_lorom_family_and_hirom_family_map_modes_fit_their_probes() {
+        for map in [0x20, 0x30, 0x23, 0x33, 0x32] {
+            assert!(title_of(&head(b"X", 0x1234, map), LO).is_some(), "{map:#x}");
+        }
+        for map in [0x21, 0x31, 0x25, 0x35] {
+            assert!(title_of(&head(b"X", 0x1234, map), HI).is_some(), "{map:#x}");
+        }
+    }
+}
