@@ -0,0 +1,54 @@
+use slot_store::{core_for_platform, Core, Platform};
+
+#[test]
+fn each_core_runs_only_its_own_platforms_with_snes_added() {
+    let truth = [
+        (Core::Mgba, [true, true, true, false, false]),
+        (Core::Gpsp, [true, false, false, false, false]),
+        (Core::Fceumm, [false, false, false, true, false]),
+        (Core::Snes9x, [false, false, false, false, true]),
+    ];
+    let platforms = [
+        Platform::Gba,
+        Platform::Gb,
+        Platform::Gbc,
+        Platform::Nes,
+        Platform::Snes,
+    ];
+    for (core, expected) in truth {
+        for (platform, runs) in platforms.into_iter().zip(expected) {
+            assert_eq!(core.runs(platform), runs, "{core:?} on {platform:?}");
+        }
+    }
+}
+
+#[test]
+fn a_snes_cart_opens_snes9x_by_default() {
+    let d = tempfile::tempdir().expect("tempdir");
+    assert_eq!(
+        core_for_platform(d.path(), "Mario", Platform::Snes),
+        Core::Snes9x
+    );
+    assert_eq!(Core::default_for(Platform::Snes), Core::Snes9x);
+}
+
+#[test]
+fn every_core_lists_snes9x_while_the_pinned_list_stays_at_two() {
+    assert!(Core::EVERY.contains(&Core::Snes9x));
+    assert_eq!(Core::ALL.len(), 2);
+    assert!(!Core::ALL.contains(&Core::Snes9x));
+}
+
+#[test]
+fn snes9x_is_named_after_its_dylib_and_reads_back() {
+    assert_eq!(Core::Snes9x.as_str(), "snes9x");
+    assert_eq!(Core::Snes9x.text(), "Snes9x");
+    assert_eq!(Core::parse("snes9x"), Some(Core::Snes9x));
+    assert_eq!(Core::Snes9x.option_prefix(), "snes9x");
+}
+
+#[test]
+fn snes9x_draws_on_the_360_by_240_canvas_with_no_colour_correction() {
+    assert_eq!(Core::Snes9x.canvas(), (360, 240));
+    assert!(!Core::Snes9x.has_colour_correction());
+}
diff --git a/crates/slot-store/tests/snes_header.rs b/crates/slot-store/tests/snes_header.rs
new file mode 100644
index 0000000..8db76e7
--- /dev/null
+++ b/crates/slot-store/tests/snes_header.rs
@@ -0,0 +1,128 @@
+use slot_store::{scan, Cart, Platform};
+
+const LO: usize = 0x7fc0;
+const HI: usize = 0xffc0;
+
+fn rom(header_at: usize, title: &[u8], valid: bool, copier: bool) -> Vec<u8> {
+    let map = if header_at == LO { 0x20 } else { 0x21 };
+    rom_with_map(header_at, title, valid, copier, map)
+}
+
+fn rom_with_map(header_at: usize, title: &[u8], valid: bool, copier: bool, map: u8) -> Vec<u8> {
+    let mut rom = vec![0u8; header_at + 0x40];
+    rom[header_at..header_at + 21].fill(b' ');
+    rom[header_at..header_at + title.len()].copy_from_slice(title);
+    let (complement, checksum) = if valid {
+        (0xa5a5u16, 0x5a5au16)
+    } else {
+        (1, 2)
+    };
+    rom[header_at + 0x15] = map;
+    rom[header_at + 0x1c..header_at + 0x1e].copy_from_slice(&complement.to_le_bytes());
+    rom[header_at + 0x1e..header_at + 0x20].copy_from_slice(&checksum.to_le_bytes());
+    if copier {
+        rom.splice(0..0, [0xffu8; 512]);
+    }
+    rom
+}
+
+fn cart_from(bytes: &[u8]) -> Cart {
+    let d = tempfile::tempdir().expect("tempdir");
+    let dir = d.path().join("Games/SNES");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    std::fs::write(dir.join("Some Game (USA).sfc"), bytes).expect("write rom");
+    let mut carts = scan(d.path()).expect("scan");
+    assert_eq!(carts.len(), 1);
+    let mut cart = carts.remove(0);
+    assert_eq!(cart.platform, Platform::Snes);
+    cart.read_header();
+    cart
+}
+
+#[test]
+fn a_lorom_title_is_read_from_the_internal_header() {
+    assert_eq!(
+        cart_from(&rom(LO, b"SUPER MARIOWORLD", true, false)).title,
+        "SUPER MARIOWORLD"
+    );
+}
+
+#[test]
+fn a_hirom_title_is_read_from_the_internal_header() {
+    assert_eq!(
+        cart_from(&rom(HI, b"DONKEY KONG COUNTRY", true, false)).title,
+        "DONKEY KONG COUNTRY"
+    );
+}
+
+#[test]
+fn a_lorom_title_is_read_past_a_copier_header() {
+    assert_eq!(
+        cart_from(&rom(LO, b"SUPER METROID", true, true)).title,
+        "SUPER METROID"
+    );
+}
+
+#[test]
+fn a_hirom_title_is_read_past_a_copier_header() {
+    assert_eq!(
+        cart_from(&rom(HI, b"CHRONO TRIGGER", true, true)).title,
+        "CHRONO TRIGGER"
+    );
+}
+
+#[test]
+fn a_jis_x_0201_title_falls_back_to_the_stem() {
+    let cart = cart_from(&rom(LO, &[0xb1, 0xb2, 0xb3, 0xb4], true, false));
+    assert!(cart.title.is_empty());
+    assert_eq!(cart.stem, "Some Game (USA)");
+}
+
+#[test]
+fn garbage_with_no_matching_checksum_falls_back_to_the_stem() {
+    for at in [LO, HI] {
+        assert!(cart_from(&rom(at, b"NOT A TITLE", false, false))
+            .title
+            .is_empty());
+    }
+}
+
+#[test]
+fn a_file_shorter_than_any_header_falls_back_to_the_stem_without_panicking() {
+    for len in [0usize, 1, 0x7fc0, 0x7fdf] {
+        assert!(cart_from(&vec![0x41u8; len]).title.is_empty());
+    }
+}
+
+#[test]
+fn when_both_headers_check_out_the_lorom_one_wins() {
+    let mut both = rom(HI, b"HIROM LOSES", true, false);
+    let lo = rom(LO, b"LOROM WINS", true, false);
+    both[LO..LO + 0x20].copy_from_slice(&lo[LO..LO + 0x20]);
+    assert_eq!(cart_from(&both).title, "LOROM WINS");
+}
+
+#[test]
+fn a_21_character_title_is_read_in_full() {
+    assert_eq!(
+        cart_from(&rom(LO, b"ABCDEFGHIJKLMNOPQRSTU", true, false)).title,
+        "ABCDEFGHIJKLMNOPQRSTU"
+    );
+}
+
+#[test]
+fn a_header_whose_map_byte_belongs_to_the_other_mapping_gives_way_to_the_other_one() {
+    let mut both = rom(HI, b"REAL HIROM", true, false);
+    let fake = rom_with_map(LO, b"FAKE LOROM", true, false, 0x21);
+    both[LO..LO + 0x20].copy_from_slice(&fake[LO..LO + 0x20]);
+    assert_eq!(cart_from(&both).title, "REAL HIROM");
+}
+
+#[test]
+fn a_header_whose_map_byte_fits_neither_probe_falls_back_to_the_stem() {
+    for at in [LO, HI] {
+        assert!(cart_from(&rom_with_map(at, b"X", true, false, 0x00))
+            .title
+            .is_empty());
+    }
+}
