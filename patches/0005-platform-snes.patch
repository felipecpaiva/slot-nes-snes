diff --git a/crates/slot/tests/nes_shelf_memory.rs b/crates/slot/tests/nes_shelf_memory.rs
new file mode 100644
index 0000000..3a8d1c0
--- /dev/null
+++ b/crates/slot/tests/nes_shelf_memory.rs
@@ -0,0 +1,132 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root_with_carts;
+use slot::app::{App, Phase};
+use slot_input::{Action, Btn};
+use slot_store::{read_slot_state, write_slot_state, Platform, Recent, SlotState};
+use tempfile::TempDir;
+
+fn card() -> TempDir {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    for (platform, stem) in [
+        (Platform::Nes, "Metroid"),
+        (Platform::Nes, "Zelda"),
+        (Platform::Snes, "F-Zero"),
+        (Platform::Snes, "Pilotwings"),
+    ] {
+        let cart = d
+            .path()
+            .join("Games")
+            .join(platform.dir_name())
+            .join(format!("{stem}.{}", platform.extensions()[0]));
+        std::fs::write(cart, vec![0u8; 0x200]).expect("write cart");
+    }
+    d
+}
+
+fn boot_with(root: &Path, state: SlotState) -> App {
+    write_slot_state(
+        root,
+        &SlotState {
+            clock_set: true,
+            ..state
+        },
+    )
+    .expect("write slot.state");
+    App::boot(root)
+}
+
+fn settle(a: &mut App) {
+    for _ in 0..120 {
+        a.update(1.0 / 60.0);
+    }
+}
+
+fn press(a: &mut App, btn: Btn) {
+    common::through(a, btn);
+    settle(a);
+}
+
+fn go_to(a: &mut App, shelf: &str) {
+    for _ in 0..8 {
+        if a.shelf_platform_name() == Some(shelf) {
+            return;
+        }
+        press(a, Btn::R1);
+    }
+    panic!("never reached the {shelf} shelf");
+}
+
+fn recent(platform: Platform, stem: &str) -> Recent {
+    Recent {
+        platform,
+        stem: stem.into(),
+    }
+}
+
+#[test]
+fn powering_off_on_an_snes_cart_boots_back_onto_the_snes_shelf_and_cart() {
+    let d = card();
+    let mut a = boot_with(d.path(), SlotState::default());
+    go_to(&mut a, Platform::Snes.name());
+    press(&mut a, Btn::Right);
+    assert_eq!(a.selected_stem(), Some("Pilotwings"));
+    a.apply(Action::PowerHold);
+    a.apply(Action::GbaDown(Btn::Down));
+    a.apply(Action::GbaDown(Btn::A));
+    assert!(a.powering_off());
+    let saved = read_slot_state(d.path());
+    assert_eq!(saved.shelf.as_deref(), Some("snes"));
+    assert_eq!(saved.shelf_cart, Some(recent(Platform::Snes, "Pilotwings")));
+
+    let a = App::boot(d.path());
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.shelf_platform_name(), Some(Platform::Snes.name()));
+    assert_eq!(a.selected_stem(), Some("Pilotwings"));
+}
+
+#[test]
+fn y_stars_an_nes_cart_onto_the_favorites_shelf_and_the_card_keeps_it() {
+    let d = card();
+    let mut a = boot_with(d.path(), SlotState::default());
+    go_to(&mut a, Platform::Nes.name());
+    press(&mut a, Btn::Right);
+    assert_eq!(a.selected_stem(), Some("Zelda"));
+    press(&mut a, Btn::Y);
+    a.flush_state();
+    assert_eq!(
+        read_slot_state(d.path()).favorites,
+        [recent(Platform::Nes, "Zelda")]
+    );
+    let mut a = App::boot(d.path());
+    go_to(&mut a, "Favorites");
+    assert_eq!(a.selected_stem(), Some("Zelda"));
+}
+
+#[test]
+fn nes_and_snes_carts_in_recents_stock_the_recents_shelf() {
+    let d = card();
+    let mut a = boot_with(
+        d.path(),
+        SlotState {
+            show_recents: true,
+            recents: vec![
+                recent(Platform::Snes, "F-Zero"),
+                recent(Platform::Nes, "Metroid"),
+            ],
+            ..SlotState::default()
+        },
+    );
+    go_to(&mut a, "Recents");
+    let mut seen = Vec::new();
+    for _ in 0..2 {
+        seen.push(a.selected_stem().map(str::to_string));
+        press(&mut a, Btn::Right);
+    }
+    assert_eq!(
+        seen,
+        [Some("F-Zero".to_string()), Some("Metroid".to_string())]
+    );
+}
