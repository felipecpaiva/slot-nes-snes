diff --git a/crates/slot/tests/snes_rom.rs b/crates/slot/tests/snes_rom.rs
new file mode 100644
index 0000000..7cc3ca7
--- /dev/null
+++ b/crates/slot/tests/snes_rom.rs
@@ -0,0 +1,32 @@
+mod common;
+mod nes_common;
+
+use nes_common::{snes_rom, Map, SNES_TITLE};
+
+#[test]
+fn the_generated_snes_carts_carry_a_header_slot_can_read() {
+    for (name, map, copier) in [
+        ("rom_lo.sfc", Map::Lo, false),
+        ("rom_hi.sfc", Map::Hi, false),
+        ("rom_lo_copier.smc", Map::Lo, true),
+        ("rom_hi_copier.smc", Map::Hi, true),
+    ] {
+        let rom = snes_rom(name, map, copier, 0);
+        let len = std::fs::metadata(&rom).expect("stat rom").len();
+        assert_eq!(len % 1024 == 512, copier, "{name}");
+        assert_eq!(
+            slot_store::snes::title(&rom).as_deref(),
+            Some(SNES_TITLE),
+            "{name}"
+        );
+    }
+}
+
+#[test]
+fn a_battery_snes_cart_says_rom_ram_battery_and_its_sram_size() {
+    let bytes = std::fs::read(snes_rom("rom_battery.sfc", Map::Lo, false, 8)).expect("read rom");
+    assert_eq!(bytes[0x7fc0 + 0x16], 0x02);
+    assert_eq!(bytes[0x7fc0 + 0x18], 3);
+    let plain = std::fs::read(snes_rom("rom_plain.sfc", Map::Lo, false, 0)).expect("read rom");
+    assert_eq!(plain[0x7fc0 + 0x16], 0x00);
+}
