                     q.busy = true;
-                    break job;
+                    break (q.next.take(), q.file.take());
                 }
                 if q.closed {
                     return;
@@ -85,7 +95,12 @@ fn work(shared: &Shared, failing: &AtomicBool) {
                 q = wake.wait(q).unwrap_or_else(|e| e.into_inner());
             }
         };
-        write(&root, &state, failing);
+        if let Some((root, state)) = job {
+            write(&root, &state, failing);
+        }
+        if let Some((path, bytes)) = file {
+            write_file(&path, &bytes, failing);
+        }
         lock.lock().unwrap_or_else(|e| e.into_inner()).busy = false;
         wake.notify_all();
     }
@@ -98,3 +113,10 @@ fn write(root: &Path, state: &SlotState, failing: &AtomicBool) {
     }
     failing.store(written.is_err(), Ordering::Relaxed);
 }
+
+fn write_file(path: &Path, bytes: &[u8], failing: &AtomicBool) {
+    if let Err(e) = slot_store::atomic_write(path, bytes) {
+        eprintln!("slot: {}: {e}", path.display());
+        failing.store(true, Ordering::Relaxed);
+    }
+}
diff --git a/crates/slot/tests/shelf_memory.rs b/crates/slot/tests/shelf_memory.rs
new file mode 100644
index 0000000..b0994e1
--- /dev/null
+++ b/crates/slot/tests/shelf_memory.rs
@@ -0,0 +1,173 @@
+mod common;
+
+use std::path::Path;
+
+use common::{boot, tmp_root_with_carts};
+use slot::app::{App, Phase};
+use slot::shelf_recall::{self, ShelfMemory};
+use slot_input::{Action, Btn};
+use slot_store::{read_slot_state, write_slot_state, Platform, SlotState};
+use tempfile::TempDir;
+
+fn two_shelves() -> TempDir {
+    let d = tmp_root_with_carts(&["Advance", "Boktai", "Castlevania"]);
+    let mut rom = vec![0u8; 16 + 0x4000 + 0x2000];
+    rom[..4].copy_from_slice(b"NES\x1a");
+    rom[4] = 1;
+    rom[5] = 1;
+    for stem in ["Contra", "Metroid", "Zelda"] {
+        std::fs::write(d.path().join(format!("Games/NES/{stem}.nes")), &rom).expect("write rom");
+    }
+    d
+}
+
+fn remember(root: &Path, text: &str) {
+    std::fs::write(shelf_recall::path(root), text).expect("write shelf.state");
+}
+
+fn settle(app: &mut App) {
+    app.update(0.1);
+    app.flush_state();
+}
+
+#[test]
+fn shelf_state_round_trips_through_its_file() {
+    let memory = ShelfMemory {
+        platform: Some(Platform::Nes),
+        carts: vec![
+            (Platform::Gba, "Boktai".into()),
+            (Platform::Nes, "Super Mario Bros. 3 (USA) = Rev 1".into()),
+        ],
+    };
+    let text = memory.text();
+    assert!(text.lines().any(|l| l == "shelf=nes"), "{text:?}");
+    assert!(text.lines().any(|l| l == "shelf_gba=Boktai"), "{text:?}");
+    assert_eq!(ShelfMemory::parse(&text), memory);
+}
+
+#[test]
+fn a_missing_or_damaged_shelf_file_reads_as_no_memory() {
+    let d = two_shelves();
+    assert_eq!(shelf_recall::read(d.path()), ShelfMemory::default());
+    remember(d.path(), "shelf=pce\nshelf_pce=Bonk\nshelf_gba=\ngarbage\n");
+    assert_eq!(shelf_recall::read(d.path()), ShelfMemory::default());
+}
+
+#[test]
+fn an_old_card_with_no_shelf_file_opens_on_the_first_cart() {
+    let d = two_shelves();
+    std::fs::write(
+        d.path().join("Config/slot.state"),
+        "cart=\nbrightness=3\nblue_light=1\nvolume=40\nmuted=0\nclock_set=1\nutc_offset_min=0\n",
+    )
+    .unwrap();
+    let app = App::boot(d.path());
+    assert!(matches!(app.phase(), Phase::Shelf));
+    assert_eq!(app.selected_stem(), Some("Advance"));
+}
+
+#[test]
+fn boot_opens_the_remembered_shelf_on_its_remembered_cart() {
+    let d = two_shelves();
+    remember(
+        d.path(),
+        "shelf=nes\nshelf_nes=Metroid\nshelf_gba=Castlevania\n",
+    );
+    let mut app = boot(d.path());
+    assert!(matches!(app.phase(), Phase::Shelf));
+    assert_eq!(app.selected_stem(), Some("Metroid"));
+    app.apply(Action::GbaDown(Btn::R1));
+    assert_eq!(
+        app.selected_stem(),
+        Some("Castlevania"),
+        "GBA lost its own cart"
+    );
+}
+
+#[test]
+fn a_remembered_cart_that_is_gone_falls_back_to_the_first_cart() {
+    let d = two_shelves();
+    remember(d.path(), "shelf=nes\nshelf_nes=Kirby\n");
+    let app = boot(d.path());
+    assert_eq!(app.selected_stem(), Some("Contra"));
+}
+
+#[test]
+fn a_remembered_shelf_that_is_empty_falls_back_to_the_first_full_shelf() {
+    let d = two_shelves();
+    remember(d.path(), "shelf=snes\nshelf_snes=Mario\nshelf_gba=Boktai\n");
+    let app = boot(d.path());
+    assert_eq!(app.selected_stem(), Some("Boktai"));
+}
+
+#[test]
+fn a_seated_cart_still_wins_over_the_remembered_shelf() {
+    let d = two_shelves();
+    remember(d.path(), "shelf=nes\nshelf_nes=Metroid\n");
+    write_slot_state(
+        d.path(),
+        &SlotState {
+            cart: Some("Boktai".into()),
+            cart_platform: Some(Platform::Gba),
+            clock_set: true,
+            ..SlotState::default()
+        },
+    )
+    .unwrap();
+    let app = App::boot(d.path());
+    assert!(matches!(app.phase(), Phase::Inserting { .. }));
+    assert_eq!(
+        app.seated_cart().map(|c| (c.platform, c.stem.as_str())),
+        Some((Platform::Gba, "Boktai"))
+    );
+}
+
+#[test]
+fn moving_on_the_shelf_is_remembered_across_a_restart() {
+    let d = two_shelves();
+    let mut app = boot(d.path());
+    settle(&mut app);
+    let slot_state = std::fs::read(d.path().join("Config/slot.state")).unwrap();
+    app.apply(Action::GbaDown(Btn::Right));
+    app.apply(Action::GbaUp(Btn::Right));
+    settle(&mut app);
+    app.apply(Action::GbaDown(Btn::R1));
+    app.apply(Action::GbaDown(Btn::Right));
+    app.apply(Action::GbaUp(Btn::Right));
+    app.apply(Action::GbaDown(Btn::Right));
+    app.apply(Action::GbaUp(Btn::Right));
+    settle(&mut app);
+    assert_eq!(app.selected_stem(), Some("Zelda"));
+    drop(app);
+    assert_eq!(
+        std::fs::read(d.path().join("Config/slot.state")).unwrap(),
+        slot_state,
+        "moving on the shelf rewrote slot.state"
+    );
+
+    let mut app = App::boot(d.path());
+    assert_eq!(app.selected_stem(), Some("Zelda"));
+    app.apply(Action::GbaDown(Btn::L1));
+    assert_eq!(app.selected_stem(), Some("Boktai"));
+    assert_eq!(read_slot_state(d.path()).cart, None);
+}
+
+#[test]
+fn a_held_direction_is_written_once_it_is_let_go() {
+    let d = two_shelves();
+    let mut app = boot(d.path());
+    settle(&mut app);
+    app.apply(Action::GbaDown(Btn::Right));
+    settle(&mut app);
+    assert_eq!(
+        shelf_recall::read(d.path()).cart(Platform::Gba),
+        Some("Advance"),
+        "wrote while the button was still held"
+    );
+    app.apply(Action::GbaUp(Btn::Right));
+    settle(&mut app);
+    assert_eq!(
+        shelf_recall::read(d.path()).cart(Platform::Gba),
+        app.selected_stem()
+    );
+}
