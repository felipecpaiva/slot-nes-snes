index 0000000..6c06c23
--- /dev/null
+++ b/crates/slot/src/shelf_recall.rs
@@ -0,0 +1,121 @@
+//! Which shelf the user was last on and which cart was selected on each shelf, kept across
+//! restarts in Config/shelf.state as `shelf=<platform>` and `shelf_<platform>=<stem>` lines.
+//! Carts are kept by stem so adding or removing ROMs does not shift them. slot.state is left
+//! alone: upstream tests build SlotState as an exhaustive literal.
+
+use std::path::{Path, PathBuf};
+
+use slot_store::{Platform, CONFIG_DIR};
+use slot_ui::Shelf;
+
+use crate::state_writer::StateWriter;
+
+pub const SHELF_STATE_FILE: &str = "shelf.state";
+
+#[derive(Clone, PartialEq, Eq, Debug, Default)]
+pub struct ShelfMemory {
+    pub platform: Option<Platform>,
+    pub carts: Vec<(Platform, String)>,
+}
+
+impl ShelfMemory {
+    pub fn cart(&self, platform: Platform) -> Option<&str> {
+        self.carts
+            .iter()
+            .find(|(p, _)| *p == platform)
+            .map(|(_, stem)| stem.as_str())
+    }
+
+    /// Makes `platform` current with `stem` selected on it. Returns whether anything changed.
+    pub fn note(&mut self, platform: Platform, stem: &str) -> bool {
+        if self.platform == Some(platform) && self.cart(platform) == Some(stem) {
+            return false;
+        }
+        self.platform = Some(platform);
+        match self.carts.iter_mut().find(|(p, _)| *p == platform) {
+            Some((_, s)) => *s = stem.to_string(),
+            None => self.carts.push((platform, stem.to_string())),
+        }
+        true
+    }
+
+    pub fn text(&self) -> String {
+        let mut text = String::new();
+        if let Some(p) = self.platform {
+            text.push_str(&format!("shelf={}\n", key(p)));
+        }
+        for (p, stem) in &self.carts {
+            text.push_str(&format!("shelf_{}={stem}\n", key(*p)));
+        }
+        text
+    }
+
+    /// Unknown keys and unknown platforms are skipped, so a damaged file reads as less memory.
+    pub fn parse(text: &str) -> ShelfMemory {
+        let mut memory = ShelfMemory::default();
+        for (k, value) in text.lines().filter_map(|l| l.split_once('=')) {
+            if k == "shelf" {
+                memory.platform = platform(value);
+            } else if let Some(p) = k.strip_prefix("shelf_").and_then(platform) {
+                if !value.is_empty() && memory.cart(p).is_none() {
+                    memory.carts.push((p, value.to_string()));
+                }
+            }
+        }
+        memory
+    }
+}
+
+pub fn path(root: &Path) -> PathBuf {
+    root.join(CONFIG_DIR).join(SHELF_STATE_FILE)
+}
+
+pub fn read(root: &Path) -> ShelfMemory {
+    std::fs::read_to_string(path(root))
+        .map(|t| ShelfMemory::parse(&t))
+        .unwrap_or_default()
+}
+
+/// Selects each shelf's remembered cart (index 0 when its stem is gone) and returns the
+/// remembered shelf, unless it is missing or empty.
+pub fn restore(memory: &ShelfMemory, shelves: &mut [(Platform, Shelf)]) -> Option<usize> {
+    for (platform, shelf) in shelves.iter_mut() {
+        let at = memory
+            .cart(*platform)
+            .and_then(|stem| shelf.carts.iter().position(|c| c.stem == stem));
+        shelf.select(at.unwrap_or(0));
+    }
+    let want = memory.platform?;
+    shelves
+        .iter()
+        .position(|(p, s)| *p == want && !s.carts.is_empty())
+}
+
+/// Records the selection once the cursor is at rest, so a held direction does not write on
+/// every repeat step, and queues the file on the state writer when it changed.
+pub fn note(
+    memory: &mut ShelfMemory,
+    (platform, shelf): &(Platform, Shelf),
+    root: Option<&Path>,
+    writer: &StateWriter,
+) {
+    if shelf.held() {
+        return;
+    }
+    let Some(cart) = shelf.carts.get(shelf.index) else {
+        return;
+    };
+    if let (true, Some(root)) = (memory.note(*platform, &cart.stem), root) {
+        writer.save_file(path(root), memory.text().into_bytes());
+    }
+}
+
+fn key(platform: Platform) -> String {
+    platform.dir_name().to_ascii_lowercase()
+}
+
+fn platform(value: &str) -> Option<Platform> {
+    Platform::SHELVES
+        .into_iter()
+        .find(|p| value.eq_ignore_ascii_case(p.dir_name()))
+}
