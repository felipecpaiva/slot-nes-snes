+
+#[test]
+fn slot_opens_a_disc_with_per_game_backup_ram_no_ram_cart_and_the_mega_drive_without_either() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let d = tempfile::tempdir().expect("tempdir");
+    put_bios(d.path(), "bios_CD_U.bin", &dummy_bios());
+    let rom = iso_disc(d.path(), STEM, US);
+    stage(d.path(), P, &rom);
+    let mut core = slot::core::open_core_for_palette(
+        d.path(),
+        Core::GenesisPlusGx,
+        P,
+        "auto",
+        false,
+        None,
+        std::slice::from_ref(&dylib),
+    );
+    core.load(&rom).expect("load");
+    core.run_frame(ButtonMask::default());
+    drop(core);
+    let mut written: Vec<_> = std::fs::read_dir(core_save_dir(d.path(), P))
+        .expect("the staging dir")
+        .map(|e| e.expect("entry").file_name().to_string_lossy().into_owned())
+        .collect();
+    written.sort();
+    assert_eq!(written, [format!("{STEM}.brm")]);
+    let md = tempfile::tempdir().expect("tempdir");
+    put_bios(md.path(), "bios_CD_U.bin", &dummy_bios());
+    std::fs::create_dir_all(slot::root::saves_dir(md.path())).expect("saves");
+    let mut core = slot::core::open_core_for_palette(
+        md.path(),
+        Core::GenesisPlusGx,
+        Platform::Md,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.load(&rom).expect("load through the Mega Drive path");
+    core.run_frame(ButtonMask::default());
+    drop(core);
+    assert!(slot::root::saves_dir(md.path()).join("scd_U.brm").exists());
+}
diff --git a/crates/slot/tests/segacd_then_gba.rs b/crates/slot/tests/segacd_then_gba.rs
new file mode 100644
index 0000000..6224aff
--- /dev/null
+++ b/crates/slot/tests/segacd_then_gba.rs
@@ -0,0 +1,188 @@
+// A GBA game played after a Sega CD game whose disc was swapped gets exactly what a GBA only run gets,
+// and a Sega CD game gets the Mega Drive pad: X and Y passed to the game, L2 and R2 kept by slot
+// (ADR 0104).
+mod common;
+mod core_common;
+mod segacd_common;
+
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use segacd_common::{dummy_bios, genesis_plus_gx, iso_disc, put_bios, US};
+use slot::app::Phase;
+use slot::audio::{AudioSink, StubSink};
+use slot::core::dylib_name;
+use slot::session::Session;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{Core, Platform};
+use slot_ui::{DiscToast, Toast};
+use tempfile::TempDir;
+
+struct Rig {
+    root: TempDir,
+    session: Session,
+    now: Millis,
+}
+
+impl Rig {
+    fn feed(&mut self, ev: RawEvent) {
+        self.now += 20;
+        self.session.feed([ev], self.now);
+    }
+
+    fn tap(&mut self, b: Btn) {
+        self.feed(RawEvent::Down(b));
+        self.feed(RawEvent::Up(b));
+    }
+
+    fn until(&mut self, what: &str, cond: impl Fn(&Session) -> bool) {
+        let deadline = Instant::now() + Duration::from_secs(20);
+        while !cond(&self.session) {
+            assert!(Instant::now() < deadline, "timed out waiting for {what}");
+            self.now += 16;
+            self.session.feed([], self.now);
+            self.session.update(1.0 / 60.0);
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
+
+    fn pad(&self) -> u16 {
+        self.session.emu().expect("no core in the slot").input().0
+    }
+
+    fn booted(gpgx: &Path, mgba: &Path) -> Rig {
+        let root = common::tmp_root_with_real_carts(&[]);
+        let games = root.path().join("Games/SEGACD");
+        iso_disc(&games, "Aaa (USA) (Disc 1)", US);
+        iso_disc(&games, "Aaa (USA) (Disc 2)", US);
+        put_bios(root.path(), "bios_CD_U.bin", &dummy_bios());
+        std::fs::write(root.path().join("Games/GBA/Bbb.gba"), common::gba_rom()).expect("rom");
+        for (core, dylib) in [(Core::GenesisPlusGx, gpgx), (Core::Mgba, mgba)] {
+            std::os::unix::fs::symlink(
+                std::fs::canonicalize(dylib).expect("core path"),
+                root.path().join("System").join(dylib_name(core)),
+            )
+            .expect("link core");
+        }
+        common::clocked(root.path());
+        let mut sink = StubSink::draining();
+        sink.open(32_768).expect("the stub refused to open");
+        Rig {
+            session: Session::boot_with(root.path().to_path_buf(), Box::new(sink)),
+            root,
+            now: 0,
+        }
+    }
+
+    fn playing(&mut self, what: &str) {
+        self.until(what, |s| {
+            matches!(s.app().phase(), Phase::Playing { .. }) && s.frames_published() >= 10
+        });
+    }
+
+    fn sega_cd(&mut self) {
+        self.tap(Btn::R1);
+        self.tap(Btn::A);
+        self.playing("the disc to seat");
+        assert_eq!(self.session.app().playing_platform(), Platform::SegaCd);
+    }
+
+    fn gba(after_sega_cd: bool) -> Option<Rig> {
+        let gpgx = genesis_plus_gx()?;
+        let mgba = core_common::require_core("mgba")?;
+        let mut r = Rig::booted(&gpgx, &mgba);
+        if after_sega_cd {
+            r.sega_cd();
+            r.feed(RawEvent::Down(Btn::Select));
+            r.tap(Btn::L2);
+            r.feed(RawEvent::Up(Btn::Select));
+            r.until("the disc 2 banner", |s| {
+                s.app().toast() == DiscToast::inserted(1).map(Toast::Disc)
+            });
+            r.feed(RawEvent::Down(Btn::Menu));
+            r.until("the eject", |s| !s.has_core());
+            r.feed(RawEvent::Up(Btn::Menu));
+            r.until("the shelf", |s| matches!(s.app().phase(), Phase::Shelf));
+            r.tap(Btn::L1);
+        }
+        r.tap(Btn::A);
+        r.playing("the gba cart to seat");
+        assert_eq!(r.session.app().playing_platform(), Platform::Gba);
+        assert!(!r.session.app().triggers_to_game());
+        Some(r)
+    }
+
+    fn input(&mut self) -> Vec<u16> {
+        let mut seen = vec![u16::from(
+            self.session.emu().expect("core").passes_through(),
+        )];
+        for btn in [Btn::A, Btn::B, Btn::L1, Btn::R1, Btn::L2, Btn::R2] {
+            self.feed(RawEvent::Down(btn));
+            seen.push(self.pad());
+            self.feed(RawEvent::Up(btn));
+            seen.push(self.pad());
+        }
+        self.feed(RawEvent::Down(Btn::R2));
+        self.session.update(1.0 / 60.0);
+        seen.push(u16::from(self.session.app().ff_badge().is_some()));
+        self.feed(RawEvent::Up(Btn::R2));
+        self.session.update(1.0 / 60.0);
+        self.feed(RawEvent::Down(Btn::Select));
+        self.feed(RawEvent::Down(Btn::X));
+        seen.push(self.pad() & ButtonMask::X);
+        self.feed(RawEvent::Up(Btn::X));
+        self.feed(RawEvent::Up(Btn::Select));
+        seen.push(u16::from(
+            self.root.path().join("Config/video_mode.txt").exists(),
+        ));
+        seen
+    }
+
+    fn picture(&self) -> ([f32; 4], u32, usize) {
+        let emu = self.session.emu().expect("core");
+        let frame = emu.latest_frame().expect("nothing was published").len();
+        (self.session.app().source_rect(), emu.frame_width(), frame)
+    }
+}
+
+#[test]
+fn a_sega_cd_game_gets_the_mega_drive_pad_and_slot_keeps_the_triggers() {
+    let _g = core_lock();
+    let (Some(gpgx), Some(mgba)) = (genesis_plus_gx(), core_common::require_core("mgba")) else {
+        return;
+    };
+    let mut r = Rig::booted(&gpgx, &mgba);
+    r.sega_cd();
+    assert!(r.session.emu().expect("core").passes_through());
+    assert!(!r.session.app().triggers_to_game());
+    r.feed(RawEvent::Down(Btn::X));
+    assert_ne!(r.pad() & ButtonMask::X, 0, "X reaches the game");
+    r.feed(RawEvent::Up(Btn::X));
+}
+
+#[test]
+fn a_gba_game_after_a_swapped_disc_gets_the_same_input_as_a_gba_only_run() {
+    let _g = core_lock();
+    let Some(mut alone) = Rig::gba(false) else {
+        return;
+    };
+    let want = alone.input();
+    drop(alone);
+    let mut after = Rig::gba(true).expect("cores");
+    assert_eq!(after.input(), want);
+}
+
+#[test]
+fn a_gba_game_after_a_swapped_disc_gets_the_same_picture_as_a_gba_only_run() {
+    let _g = core_lock();
+    let Some(alone) = Rig::gba(false) else {
+        return;
+    };
+    let want = alone.picture();
+    assert_eq!(want.2, 240 * 160 * 4);
+    drop(alone);
+    let after = Rig::gba(true).expect("cores");
+    assert_eq!(after.picture(), want);
+}
