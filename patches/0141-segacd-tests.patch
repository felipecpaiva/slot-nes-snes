 crates/slot/tests/segacd_saves.rs    |  46 +++++++
 crates/slot/tests/segacd_then_gba.rs | 188 +++++++++++++++++++++++++++
 3 files changed, 237 insertions(+)
 create mode 100644 crates/slot/tests/segacd_then_gba.rs

