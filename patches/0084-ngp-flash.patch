diff --git a/crates/slot/tests/ngp_flash.rs b/crates/slot/tests/ngp_flash.rs
new file mode 100644
index 0000000..2291c52
--- /dev/null
+++ b/crates/slot/tests/ngp_flash.rs
@@ -0,0 +1,417 @@
+mod common;
+mod core_common;
+mod ngp_common;
+mod real_seat;
+
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use ngp_common::{assert_holds, cart_bytes, neopop, FLASH_AT, FLASH_LEN, MARK};
+use slot::app::Phase;
+use slot::emu::CoreState;
+use slot::ngp_flash::{
+    core_save_dir, flash_path, publish, refused_path, stage, staged_path, valid,
+};
+use slot::session::Session;
+use slot_input::Action;
+use slot_retro::{ButtonMask, LibretroCore, RetroCore};
+use slot_store::Platform;
+use tempfile::TempDir;
+
+const STEM: &str = "Pocket";
+
+fn flash_file(mark: u8) -> Vec<u8> {
+    let mut bytes = Vec::with_capacity(FLASH_LEN);
+    bytes.extend(0x0053u16.to_le_bytes());
+    bytes.extend(1u16.to_le_bytes());
+    bytes.extend((FLASH_LEN as u32).to_le_bytes());
+    bytes.extend((FLASH_AT as u32).to_le_bytes());
+    bytes.extend(256u16.to_le_bytes());
+    bytes.extend([0, 0]);
+    bytes.push(mark);
+    bytes.resize(FLASH_LEN, 0);
+    bytes
+}
+
+fn card(write_flash: Option<u8>) -> Option<TempDir> {
+    let dylib = neopop()?;
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = carts.path().join(format!("{STEM}.ngp"));
+    std::fs::write(&rom, cart_bytes(write_flash, true)).expect("write cart");
+    let root = real_seat::rooted(Platform::Ngp, STEM, &rom, &dylib);
+    std::fs::write(
+        root.path().join("Games/NGP/Zzz.ngc"),
+        cart_bytes(None, false),
+    )
+    .expect("write a second cart");
+    Some(root)
+}
+
+fn seated(write_flash: Option<u8>) -> Option<(TempDir, Session)> {
+    let root = card(write_flash)?;
+    let session = real_seat::play(root.path(), true);
+    Some((root, session))
+}
+
+fn wait_for(session: &mut Session, what: &str, done: impl Fn(&Session) -> bool) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !done(session) {
+        assert!(Instant::now() < deadline, "{what}");
+        session.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+fn eject(session: &mut Session) {
+    session.app_mut().apply(Action::Eject);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "Eject did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+fn still_playing(session: &mut Session) {
+    let before = session.frames_published();
+    wait_for(session, "the game stopped after the flush", |s| {
+        s.frames_published() > before + 5
+    });
+    assert_eq!(session.emu().map(|e| e.state()), Some(CoreState::Ready));
+}
+
+#[test]
+fn neopops_flash_file_layout_is_what_slot_checks() {
+    assert!(valid(&flash_file(MARK)));
+    let mut two = flash_file(1);
+    two.extend((0x20_1000u32).to_le_bytes());
+    two.extend(3u16.to_le_bytes());
+    two.extend([0, 0, 7, 8, 9]);
+    two[2..4].copy_from_slice(&2u16.to_le_bytes());
+    let len = two.len() as u32;
+    two[4..8].copy_from_slice(&len.to_le_bytes());
+    assert!(valid(&two));
+    assert!(valid(&[0x53, 0, 0, 0, 8, 0, 0, 0]), "no blocks");
+}
+
+#[test]
+fn a_torn_or_foreign_flash_file_fails_the_check() {
+    let good = flash_file(MARK);
+    assert!(!valid(&good[..7]), "torn inside the header");
+    assert!(!valid(&good[..100]), "torn after the header");
+    assert!(!valid(&[]), "empty");
+    let mut wrong_id = good.clone();
+    wrong_id[0] = 0x52;
+    assert!(!valid(&wrong_id));
+    let mut long = good.clone();
+    long.push(0);
+    assert!(!valid(&long), "total_file_length is not the file size");
+    let mut block_past_end = good.clone();
+    block_past_end[12..14].copy_from_slice(&300u16.to_le_bytes());
+    assert!(!valid(&block_past_end), "a block runs past the file");
+    let mut too_many = good.clone();
+    too_many[2..4].copy_from_slice(&257u16.to_le_bytes());
+    assert!(!valid(&too_many), "more blocks than NeoPop's table holds");
+    let mut missing_header = good;
+    missing_header[2..4].copy_from_slice(&2u16.to_le_bytes());
+    assert!(!valid(&missing_header), "a block header past the end");
+}
+
+#[test]
+fn only_the_neogeo_pocket_core_gets_a_staging_save_dir() {
+    let root = Path::new("/card");
+    for platform in Platform::SHELVES {
+        let want = match platform {
+            Platform::Ngp => root.join("Saves/NGP/.core"),
+            _ => root.join("Saves"),
+        };
+        assert_eq!(core_save_dir(root, platform), want, "{platform:?}");
+        assert_eq!(
+            platform.flashes_on_unload(),
+            platform == Platform::Ngp,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn a_good_flash_file_is_staged_for_the_core_before_it_loads() {
+    let root = tempfile::tempdir().expect("tempdir");
+    let rom = root.path().join("Games/NGP/Pocket.ngc");
+    std::fs::create_dir_all(root.path().join("Saves/NGP")).expect("dirs");
+    std::fs::write(flash_path(root.path(), STEM), flash_file(MARK)).expect("write");
+    stage(root.path(), Platform::Ngp, &rom);
+    assert_eq!(
+        std::fs::read(staged_path(root.path(), STEM)).ok(),
+        Some(flash_file(MARK))
+    );
+}
+
+#[test]
+fn a_torn_flash_file_at_the_final_path_is_moved_aside_and_never_staged() {
+    let root = tempfile::tempdir().expect("tempdir");
+    let rom = root.path().join("Games/NGP/Pocket.ngc");
+    std::fs::create_dir_all(root.path().join("Saves/NGP/.core")).expect("dirs");
+    let torn = flash_file(MARK)[..100].to_vec();
+    std::fs::write(flash_path(root.path(), STEM), &torn).expect("write");
+    std::fs::write(staged_path(root.path(), STEM), flash_file(1)).expect("write");
+    stage(root.path(), Platform::Ngp, &rom);
+    assert!(!flash_path(root.path(), STEM).exists());
+    assert!(!staged_path(root.path(), STEM).exists());
+    assert_eq!(
+        std::fs::read(refused_path(root.path(), STEM)).ok(),
+        Some(torn)
+    );
+}
+
+#[test]
+fn a_torn_file_left_in_staging_by_a_crash_is_replaced_by_the_published_one() {
+    let root = tempfile::tempdir().expect("tempdir");
+    let rom = root.path().join("Games/NGP/Pocket.ngc");
+    std::fs::create_dir_all(root.path().join("Saves/NGP/.core")).expect("dirs");
+    std::fs::write(flash_path(root.path(), STEM), flash_file(MARK)).expect("write");
+    std::fs::write(staged_path(root.path(), STEM), &flash_file(9)[..20]).expect("write");
+    stage(root.path(), Platform::Ngp, &rom);
+    assert_eq!(
+        std::fs::read(staged_path(root.path(), STEM)).ok(),
+        Some(flash_file(MARK))
+    );
+}
+
+#[test]
+fn with_no_published_flash_a_torn_staged_file_is_cleared() {
+    let root = tempfile::tempdir().expect("tempdir");
+    let rom = root.path().join("Games/NGP/Pocket.ngc");
+    std::fs::create_dir_all(root.path().join("Saves/NGP/.core")).expect("dirs");
+    std::fs::write(staged_path(root.path(), STEM), &flash_file(9)[..20]).expect("write");
+    stage(root.path(), Platform::Ngp, &rom);
+    assert!(!staged_path(root.path(), STEM).exists());
+}
+
+#[test]
+fn a_torn_flash_file_is_not_published_over_a_good_one() {
+    let root = tempfile::tempdir().expect("tempdir");
+    std::fs::create_dir_all(root.path().join("Saves/NGP/.core")).expect("dirs");
+    std::fs::write(flash_path(root.path(), STEM), flash_file(MARK)).expect("write");
+    std::fs::write(staged_path(root.path(), STEM), &flash_file(9)[..200]).expect("write");
+    assert!(!publish(root.path(), STEM).expect("publish"));
+    assert_eq!(
+        std::fs::read(flash_path(root.path(), STEM)).ok(),
+        Some(flash_file(MARK))
+    );
+}
+
+#[test]
+fn nothing_staged_leaves_the_published_flash_alone() {
