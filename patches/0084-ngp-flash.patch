+#[test]
+fn an_eject_publishes_the_flash_atomically() {
+    let _g = core_lock();
+    let Some((root, mut session)) = seated(Some(MARK)) else {
+        return;
+    };
+    let path = flash_path(root.path(), STEM);
+    let stop = Arc::new(AtomicBool::new(false));
+    let watcher = {
+        let (path, stop) = (path.clone(), stop.clone());
+        std::thread::spawn(move || {
+            let mut seen = Vec::new();
+            while !stop.load(Ordering::Relaxed) {
+                if let Ok(bytes) = std::fs::read(&path) {
+                    if !valid(&bytes) {
+                        seen.push(bytes.len());
+                    }
+                }
+            }
+            seen
+        })
+    };
+    eject(&mut session);
+    wait_for(&mut session, "the core never stopped", |s| {
+        s.emu().is_none()
+    });
+    stop.store(true, Ordering::Relaxed);
+    assert_eq!(watcher.join().expect("watcher"), Vec::<usize>::new());
+    assert_holds(&path, MARK);
+}
