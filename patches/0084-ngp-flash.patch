+#[test]
+fn a_flush_by_reload_keeps_the_running_game_and_takes_under_a_frame() {
+    let _g = core_lock();
+    let Some(dylib) = neopop() else {
+        return;
+    };
+    let d = tempfile::tempdir().expect("tempdir");
+    let saves = d.path().join("Saves/NGP/.core");
+    std::fs::create_dir_all(&saves).expect("dirs");
+    let rom = d.path().join(format!("{STEM}.ngc"));
+    std::fs::write(&rom, cart_bytes(Some(MARK), true)).expect("write cart");
+    let mut core = LibretroCore::open_with(&dylib, d.path(), &saves).expect("open");
+    core.load(&rom).expect("load");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    let before = core.serialize().expect("state");
+    let mut fastest = Duration::MAX;
+    for _ in 0..5 {
+        let started = Instant::now();
+        slot::ngp_flash::reload(&mut core, &rom).expect("reload");
+        fastest = fastest.min(started.elapsed());
+    }
+    println!("flush by reload: {:.2} ms", fastest.as_secs_f64() * 1000.0);
+    assert_eq!(core.serialize().expect("state"), before);
+    assert_holds(&saves.join(format!("{STEM}.flash")), MARK);
+    assert!(fastest < Duration::from_micros(16_600), "{fastest:?}");
+}
