@@ -0,0 +1,185 @@
+use std::io::ErrorKind;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+use std::time::Instant;
+
+use slot_retro::RetroCore;
+use slot_store::{atomic_write, Platform};
+
+const FLASH_ID: u16 = 0x0053;
+const MAX_BLOCKS: u16 = 256;
+const FILE_HEADER: usize = 8;
+const BLOCK_HEADER: usize = 8;
+const STAGING: &str = ".core";
+const REFUSED: &str = "flash-refused";
+
+pub struct Seat {
+    root: PathBuf,
+    stem: String,
+    rom: PathBuf,
+}
+
+pub fn core_save_dir(root: &Path, platform: Platform) -> PathBuf {
+    match platform.flashes_on_unload() {
+        true => staging_dir(root),
+        false => crate::root::saves_dir(root),
+    }
+}
+
+pub fn flash_path(root: &Path, stem: &str) -> PathBuf {
+    platform_dir(root).join(format!("{stem}.flash"))
+}
+
+pub fn staged_path(root: &Path, stem: &str) -> PathBuf {
+    staging_dir(root).join(format!("{stem}.flash"))
+}
+
+pub fn refused_path(root: &Path, stem: &str) -> PathBuf {
+    platform_dir(root).join(format!("{stem}.{REFUSED}"))
+}
+
+fn platform_dir(root: &Path) -> PathBuf {
+    crate::root::saves_dir(root).join(Platform::Ngp.dir_name())
+}
+
+fn staging_dir(root: &Path) -> PathBuf {
+    platform_dir(root).join(STAGING)
+}
+
+fn stem_of(rom: &Path) -> Option<&str> {
+    rom.file_stem().and_then(|s| s.to_str())
+}
+
+pub fn valid(bytes: &[u8]) -> bool {
+    let Some(head) = bytes.get(..FILE_HEADER) else {
+        return false;
+    };
+    let id = u16::from_le_bytes([head[0], head[1]]);
+    let blocks = u16::from_le_bytes([head[2], head[3]]);
+    let total = u32::from_le_bytes([head[4], head[5], head[6], head[7]]);
+    if id != FLASH_ID || blocks > MAX_BLOCKS || total as usize != bytes.len() {
+        return false;
+    }
+    let mut at = FILE_HEADER;
+    for _ in 0..blocks {
+        let Some(block) = bytes.get(at..at + BLOCK_HEADER) else {
+            return false;
+        };
+        at += BLOCK_HEADER + u16::from_le_bytes([block[4], block[5]]) as usize;
+    }
+    at == bytes.len()
+}
+
+pub fn stage(root: &Path, platform: Platform, rom: &Path) {
+    let Some(stem) = stem_of(rom).filter(|_| platform.flashes_on_unload()) else {
+        return;
+    };
+    if let Err(e) = std::fs::create_dir_all(staging_dir(root)) {
+        eprintln!("slot: ngp flash: {e}");
+    }
+    let flash = flash_path(root, stem);
+    let old = crate::root::saves_dir(root).join(format!("{stem}.flash"));
+    if !flash.exists() && old.exists() {
+        match std::fs::rename(&old, &flash) {
+            Ok(()) => eprintln!(
+                "slot: ngp flash: moved {} to {}",
+                old.display(),
+                flash.display()
+            ),
+            Err(e) => eprintln!("slot: ngp flash: could not move {}: {e}", old.display()),
+        }
+    }
+    let staged = staged_path(root, stem);
+    match std::fs::remove_file(&staged) {
+        Err(e) if e.kind() != ErrorKind::NotFound => {
+            eprintln!("slot: ngp flash: could not clear {}: {e}", staged.display());
+        }
+        _ => {}
+    }
+    let Ok(bytes) = std::fs::read(&flash) else {
+        return;
+    };
+    if !valid(&bytes) {
+        let aside = refused_path(root, stem);
+        match std::fs::rename(&flash, &aside) {
+            Ok(()) => eprintln!(
+                "slot: ngp flash: {} is torn, moved it to {} and started with blank flash",
+                flash.display(),
+                aside.display()
+            ),
+            Err(e) => eprintln!(
+                "slot: ngp flash: {} is torn and stays: {e}",
+                flash.display()
+            ),
+        }
+        return;
+    }
+    if let Err(e) = std::fs::write(&staged, &bytes) {
+        eprintln!("slot: ngp flash: could not stage {}: {e}", staged.display());
+    }
+}
+
+pub fn publish(root: &Path, stem: &str) -> std::io::Result<bool> {
+    let staged = match std::fs::read(staged_path(root, stem)) {
+        Ok(bytes) => bytes,
+        Err(e) if e.kind() == ErrorKind::NotFound => return Ok(false),
+        Err(e) => return Err(e),
+    };
+    if !valid(&staged) {
+        eprintln!("slot: ngp flash: the core left a torn {stem}.flash, keeping the published one");
+        return Ok(false);
+    }
+    let flash = flash_path(root, stem);
+    if std::fs::read(&flash).is_ok_and(|old| old == staged) {
+        return Ok(false);
+    }
+    atomic_write(&flash, &staged)?;
+    eprintln!("slot: ngp flash: published {}", flash.display());
+    Ok(true)
+}
+
+pub fn seat(root: &Path, platform: Platform, rom: &Path) -> Option<Seat> {
+    let stem = stem_of(rom).filter(|_| platform.flashes_on_unload())?;
+    Some(Seat {
+        root: root.to_path_buf(),
+        stem: stem.to_owned(),
+        rom: rom.to_path_buf(),
+    })
+}
+
+pub fn reload(core: &mut dyn RetroCore, rom: &Path) -> Result<(), slot_retro::CoreError> {
+    let state = core.serialize()?;
+    core.load(rom)?;
+    core.unserialize(&state)
+}
+
+pub fn flush(seat: &Mutex<Option<Seat>>, core: &mut dyn RetroCore) -> bool {
+    let guard = seat.lock().unwrap_or_else(|e| e.into_inner());
+    let Some(seat) = guard.as_ref() else {
+        return true;
+    };
+    let started = Instant::now();
+    let reloaded = reload(core, &seat.rom);
+    if let Err(e) = &reloaded {
+        eprintln!("slot: ngp flash: reload failed, the resume state keeps the flash: {e}");
+    }
+    if crate::session::trace() {
+        eprintln!(
+            "slot: ngp flash: reload took {:.2} ms",
+            started.elapsed().as_secs_f64() * 1000.0
+        );
+    }
+    if let Err(e) = publish(&seat.root, &seat.stem) {
+        eprintln!("slot: ngp flash: {e}");
+    }
+    reloaded.is_ok()
+}
+
+pub fn published_after_unload(seat: &Mutex<Option<Seat>>) {
+    let guard = seat.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some(seat) = guard.as_ref() {
+        if let Err(e) = publish(&seat.root, &seat.stem) {
+            eprintln!("slot: ngp flash: {e}");
+        }
+    }
+}
