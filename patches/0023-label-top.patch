@@ -1,10 +1,17 @@
 use std::path::Path;
 
 pub fn cover(path: &Path, w: u32, h: u32) -> Option<Vec<u8>> {
-    let (src, sw, sh) = decode(path)?;
+    cover_rows(path, w, h, false)
+}
+
+pub fn cover_rows(path: &Path, w: u32, h: u32, top: bool) -> Option<Vec<u8>> {
+    let (src, sw, mut sh) = decode(path)?;
     if sw == 0 || sh == 0 {
         return None;
     }
+    if top {
+        sh = sh.min(((sw as u64 * h as u64 + w as u64 / 2) / w as u64).max(1) as u32);
+    }
 
     let scale = (w as f32 / sw as f32).max(h as f32 / sh as f32);
     let ox = (sw as f32 - w as f32 / scale) / 2.0;
