         std::fs::write(root.path().join("BIOS/lynxboot.img"), [0u8; 512]).expect("write bios");
+        std::fs::write(root.path().join("BIOS/disksys.rom"), [0u8; 8192]).expect("write bios");
         for remembered in [platform, Platform::Nes] {
             remembering(root.path(), remembered);
             let app = App::boot(root.path());
