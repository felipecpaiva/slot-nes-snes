From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paiva <felipe.paiva@gmail.com>
Date: Wed, 21 Oct 2026 00:59:57 +0400
Subject: [PATCH] fds-tests

A GBA game played after a Famicom Disk System game whose disk was
flipped gets the same input, frame and picture as a GBA only run. A
disk resumes as a disk and never as a NES cart with the same name.
---
 crates/slot/tests/fds_then_gba.rs    | 166 +++++++++++++++++++++++++++
 crates/slot/tests/resume_platform.rs |   2 +
 2 files changed, 168 insertions(+)
 create mode 100644 crates/slot/tests/fds_then_gba.rs

diff --git a/crates/slot/tests/fds_then_gba.rs b/crates/slot/tests/fds_then_gba.rs
new file mode 100644
index 0000000..d9b4982
--- /dev/null
+++ b/crates/slot/tests/fds_then_gba.rs
@@ -0,0 +1,166 @@
+// A GBA game played after a Famicom Disk System game whose disk was flipped (slot pressed the core's
+// L and R itself) gets exactly what a GBA only run gets (ADR 0101).
+mod common;
+mod core_common;
+mod fds_common;
+mod real_seat;
+
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use fds_common::{disk, fceumm, placeholder_bios, put_bios};
+use slot::app::Phase;
+use slot::audio::{AudioSink, StubSink};
+use slot::core::dylib_name;
+use slot::session::Session;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{Core, Platform};
+use slot_ui::{FdsToast, Toast};
+use tempfile::TempDir;
+
+struct Rig {
+    root: TempDir,
+    session: Session,
+    now: Millis,
+}
+
+impl Rig {
+    fn feed(&mut self, ev: RawEvent) {
+        self.now += 20;
+        self.session.feed([ev], self.now);
+    }
+
+    fn tap(&mut self, b: Btn) {
+        self.feed(RawEvent::Down(b));
+        self.feed(RawEvent::Up(b));
+    }
+
+    fn until(&mut self, what: &str, cond: impl Fn(&Session) -> bool) {
+        let deadline = Instant::now() + Duration::from_secs(20);
+        while !cond(&self.session) {
+            assert!(Instant::now() < deadline, "timed out waiting for {what}");
+            self.now += 16;
+            self.session.feed([], self.now);
+            self.session.update(1.0 / 60.0);
+            std::thread::sleep(Duration::from_millis(1));
+        }
+    }
+
+    fn pad(&self) -> u16 {
+        self.session.emu().expect("no core in the slot").input().0
+    }
+
+    fn booted(fds: &Path, mgba: &Path) -> Rig {
+        let carts = tempfile::tempdir().expect("tempdir");
+        let rom = disk(carts.path(), "Aaa", 2, true);
+        let root = real_seat::rooted(Platform::Fds, "Aaa", &rom, fds);
+        put_bios(root.path(), &placeholder_bios());
+        std::fs::write(root.path().join("Games/GBA/Bbb.gba"), common::gba_rom()).expect("rom");
+        std::os::unix::fs::symlink(
+            std::fs::canonicalize(mgba).expect("core path"),
+            root.path().join("System").join(dylib_name(Core::Mgba)),
+        )
+        .expect("link core");
+        let mut sink = StubSink::draining();
+        sink.open(32_768).expect("the stub refused to open");
+        Rig {
+            session: Session::boot_with(root.path().to_path_buf(), Box::new(sink)),
+            root,
+            now: 0,
+        }
+    }
+
+    fn playing(&mut self, what: &str) {
+        self.until(what, |s| {
+            matches!(s.app().phase(), Phase::Playing { .. }) && s.frames_published() >= 10
+        });
+    }
+
+    fn gba(after_fds: bool) -> Option<Rig> {
+        let fds = fceumm()?;
+        let mgba = core_common::require_core("mgba")?;
+        let mut r = Rig::booted(&fds, &mgba);
+        if after_fds {
+            r.tap(Btn::R1);
+            r.tap(Btn::A);
+            r.playing("the disk to seat");
+            assert_eq!(r.session.app().playing_platform(), Platform::Fds);
+            assert!(!r.session.app().triggers_to_game());
+            r.feed(RawEvent::Down(Btn::Select));
+            r.tap(Btn::L2);
+            r.feed(RawEvent::Up(Btn::Select));
+            r.until("the side B banner", |s| {
+                s.app().toast() == Some(Toast::Fds(FdsToast::Side(1)))
+            });
+            r.feed(RawEvent::Down(Btn::Menu));
+            r.until("the eject", |s| !s.has_core());
+            r.feed(RawEvent::Up(Btn::Menu));
+            r.until("the shelf", |s| matches!(s.app().phase(), Phase::Shelf));
+            r.tap(Btn::L1);
+        }
+        r.tap(Btn::A);
+        r.playing("the gba cart to seat");
+        assert_eq!(r.session.app().playing_platform(), Platform::Gba);
+        assert!(!r.session.app().triggers_to_game());
+        Some(r)
+    }
+
+    fn input(&mut self) -> Vec<u16> {
+        let mut seen = vec![u16::from(
+            self.session.emu().expect("core").passes_through(),
+        )];
+        for btn in [Btn::A, Btn::B, Btn::L1, Btn::R1, Btn::L2, Btn::R2] {
+            self.feed(RawEvent::Down(btn));
+            seen.push(self.pad());
+            self.feed(RawEvent::Up(btn));
+            seen.push(self.pad());
+        }
+        self.feed(RawEvent::Down(Btn::R2));
+        self.session.update(1.0 / 60.0);
+        seen.push(u16::from(self.session.app().ff_badge().is_some()));
+        self.feed(RawEvent::Up(Btn::R2));
+        self.session.update(1.0 / 60.0);
+        self.feed(RawEvent::Down(Btn::Select));
+        self.feed(RawEvent::Down(Btn::X));
+        seen.push(self.pad() & ButtonMask::X);
+        self.feed(RawEvent::Up(Btn::X));
+        self.feed(RawEvent::Up(Btn::Select));
+        seen.push(u16::from(
+            self.root.path().join("Config/video_mode.txt").exists(),
+        ));
+        seen
+    }
+
+    fn picture(&self) -> ([f32; 4], u32, usize) {
+        let emu = self.session.emu().expect("core");
+        let frame = emu.latest_frame().expect("nothing was published").len();
+        (self.session.app().source_rect(), emu.frame_width(), frame)
+    }
+}
+
+#[test]
+fn a_gba_game_after_a_flipped_disk_gets_the_same_input_as_a_gba_only_run() {
+    let _g = core_lock();
+    let Some(mut alone) = Rig::gba(false) else {
+        return;
+    };
+    let want = alone.input();
+    drop(alone);
+    let mut after = Rig::gba(true).expect("cores");
+    assert_eq!(after.input(), want);
+}
+
+#[test]
+fn a_gba_game_after_a_flipped_disk_gets_the_same_picture_as_a_gba_only_run() {
+    let _g = core_lock();
+    let Some(alone) = Rig::gba(false) else {
+        return;
+    };
+    let want = alone.picture();
+    assert_eq!(want.2, 240 * 160 * 4);
+    drop(alone);
+    let after = Rig::gba(true).expect("cores");
+    assert_eq!(after.picture(), want);
+}
