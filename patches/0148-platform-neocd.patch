@@ -0,0 +1,10 @@
+use slot_store::Platform;
+
+pub const BACKUP_RAM_BYTES: usize = 8192;
+
+pub fn sav_or_blank(platform: Platform, sav: Option<Vec<u8>>) -> Option<Vec<u8>> {
+    match (platform, sav) {
+        (Platform::Neocd, None) => Some(vec![0; BACKUP_RAM_BYTES]),
+        (_, sav) => sav,
+    }
+}
