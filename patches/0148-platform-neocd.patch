@@ -0,0 +1,304 @@
+mod common;
+mod core_common;
+mod neocd_common;
+mod real_seat;
+
+use std::path::{Path, PathBuf};
+
+use common::{boot, core_lock, tmp_root_with_real_carts};
+use neocd_common::{disc, neocd, put_placeholders};
+use slot::app::{App, Phase};
+use slot::core::apply_core_options;
+use slot::input::Pad;
+use slot::persist::Snapshot;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::session::Session;
+use slot::video_mode::VideoMode;
+use slot_input::{Action, Btn, RawEvent};
+use slot_retro::{ButtonMask, LibretroCore};
+use slot_store::{Controls, Core, Platform, Shader, NEOCD_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+const STEM: &str = "Samurai Shodown RPG (Japan) (En)";
+
+#[test]
+fn neocd_is_told_the_cdz_bios_usa_the_speed_hack_and_shared_backup_ram_off() {
+    let _g = core_lock();
+    let Some(dylib) = neocd() else {
+        return;
+    };
+    let d = tmp_root_with_real_carts(&[]);
+    put_placeholders(d.path());
+    let bios = slot::root::bios_dir(d.path());
+    let mut core = LibretroCore::open_with(&dylib, &bios, d.path()).expect("open neocd");
+    apply_core_options(
+        &mut core,
+        Core::Neocd,
+        Platform::Neocd,
+        "",
+        false,
+        false,
+        None,
+    );
+    for (key, value) in slot::core_options_policy::NEOCD {
+        assert_eq!(core.option(key).as_deref(), Some(value), "{key}");
+        let values = core
+            .declared_options()
+            .get(key)
+            .unwrap_or_else(|| panic!("the pin no longer declares {key}"));
+        assert!(values.iter().any(|v| v == value), "{key}={value}");
+    }
+}
+
+fn card_with_a_disc() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(
+        root.path().join("Games/NEOCD").join(format!("{STEM}.chd")),
+        [0u8; 0x200],
+    )
+    .expect("write disc");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_neocd(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenNeocd.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenNeocd));
+    press(app, Btn::A);
+}
+
+#[test]
+fn the_neo_geo_cd_follows_the_sega_cd_in_the_screen_list_with_shader_and_picture() {
+    let last = QuickRow::SCREEN.len() - 1;
+    assert_eq!(QuickRow::SCREEN[last], QuickRow::ScreenNeocd);
+    assert_eq!(QuickRow::SCREEN[last - 1], QuickRow::ScreenSegaCd);
+    assert_eq!(QuickRow::ScreenNeocd.label(), "Neo Geo CD");
+    assert!(QuickRow::ScreenNeocd.opens());
+    assert_eq!(QuickRow::ScreenNeocd.child(), Some(QuickRow::NeocdShader));
+    assert_eq!(
+        QuickRow::SCREEN_NEOCD[..2]
+            .iter()
+            .map(|r| r.label())
+            .collect::<Vec<_>>(),
+        ["Shader", "Picture"]
+    );
+    for row in QuickRow::SCREEN_NEOCD {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenNeocd));
+        assert_eq!(row.page(), &QuickRow::SCREEN_NEOCD);
+    }
+}
+
+#[test]
+fn the_neo_geo_cd_row_shows_only_on_a_card_with_neo_geo_cd_discs() {
+    let (_root, mut app) = card_with_a_disc();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenNeocd));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    assert!(boot(root.path())
+        .hidden_rows()
+        .contains(&QuickRow::ScreenNeocd));
+    open_neocd(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::NeocdShader));
+}
+
+#[test]
+fn the_neo_geo_cd_shader_walks_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_disc();
+    let state = std::fs::read(root.path().join("Config/slot.state")).ok();
+    open_neocd(&mut app);
+    assert_eq!(
+        app.quick_value(QuickRow::NeocdShader),
+        Some(QuickValue::Off)
+    );
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(slot_store::read_sega_shaders(root.path()).neocd);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(NEOCD_SHADER_FILE).exists());
+    assert!(!root.path().join("Config/neogeo_shader.txt").exists());
+    assert_eq!(
+        std::fs::read(root.path().join("Config/slot.state")).ok(),
+        state
+    );
+}
+
+#[test]
+fn the_neo_geo_cd_picture_starts_at_stretch_and_walks_actual_four_three_stretch() {
+    assert_eq!(default_video_mode(Platform::Neocd), VideoMode::Stretch);
+    use VideoMode::{Actual, FourThree, Stretch};
+    assert_eq!(
+        picture_choices(Platform::Neocd),
+        [Stretch, Actual, FourThree]
+    );
+    let (root, mut app) = card_with_a_disc();
+    open_neocd(&mut app);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::NeocdPicture));
+    assert_eq!(
+        app.quick_value(QuickRow::NeocdPicture),
+        Some(QuickValue::Stretch)
+    );
+    for want in [Actual, FourThree, Stretch] {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        assert_eq!(
+            app.quick_value(QuickRow::NeocdPicture),
+            Some(want.quick_value())
+        );
+        assert_eq!(system_picture(root.path(), Platform::Neocd), want);
+    }
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "neocd = stretch\n"
+    );
+    assert_eq!(system_picture(root.path(), Platform::NeoGeo), Stretch);
+}
+
+#[test]
+fn a_booted_card_has_the_neo_geo_cd_folders() {
+    let (root, _app) = card_with_a_disc();
+    for dir in ["Games/NEOCD", "Saves/NEOCD", "States/NEOCD", "Labels/NEOCD"] {
+        assert!(slot::root::DIRS.contains(&dir), "{dir}");
+        assert!(root.path().join(dir).is_dir(), "{dir}");
+    }
+}
+
+fn seated(dylib: &Path) -> TempDir {
+    let discs = tempfile::tempdir().expect("tempdir");
+    let cue = disc(discs.path(), "Disc");
+    let root = real_seat::rooted(Platform::Neocd, STEM, &cue, dylib);
+    std::fs::copy(
+        discs.path().join("Disc.bin"),
+        root.path().join("Games/NEOCD/Disc.bin"),
+    )
+    .expect("copy track");
+    std::fs::write(root.path().join("Games/NEOCD/Zzz.chd"), [0u8; 0x200]).expect("second disc");
+    put_placeholders(root.path());
+    root
+}
+
+fn sav(root: &Path) -> PathBuf {
+    root.join("Saves/NEOCD").join(format!("{STEM}.sav"))
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+#[test]
+fn a_marked_backup_ram_survives_an_eject_and_a_reinsert_through_saves_neocd() {
+    let _g = core_lock();
+    let Some(dylib) = neocd() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut marked = vec![0u8; 8192];
+    marked[0x10..0x14].copy_from_slice(b"SAVE");
+    std::fs::write(sav(root.path()), &marked).expect("write sav");
+    let mut first = real_seat::play(root.path(), true);
+    let in_core = |s: &Session| s.emu().expect("no core").snapshot().save_ram();
+    assert!(in_core(&first) == Some(marked.clone()), "first insert");
+    eject(&mut first);
+    drop(first);
+    assert!(std::fs::read(sav(root.path())).expect("read sav") == marked);
+    let second = real_seat::play(root.path(), true);
+    assert!(in_core(&second) == Some(marked), "after reinsert");
+}
+
+#[test]
+fn a_first_insert_gets_blank_backup_ram_never_the_cores_shared_file() {
+    let _g = core_lock();
+    let Some(dylib) = neocd() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let shared = slot::root::bios_dir(root.path()).join("neocd/neocd.srm");
+    std::fs::write(&shared, vec![0xaa; 8192]).expect("write shared srm");
+    let mut session = real_seat::play(root.path(), true);
+    let in_core = session.emu().expect("no core").snapshot().save_ram();
+    assert!(
+        in_core == Some(vec![0u8; 8192]),
+        "another game's backup RAM"
+    );
+    eject(&mut session);
+    assert!(std::fs::read(sav(root.path())).expect("no sav after eject") == vec![0u8; 8192]);
+}
+
+fn held(btn: Btn) -> u16 {
+    let mut p = Pad::default();
+    p.apply(Action::GbaDown(btn));
+    p.mask_for(&Controls::default(), Platform::Neocd).0
+}
+
+#[test]
+fn the_neo_geo_cd_pad_puts_a_to_d_on_b_a_y_x_with_select_and_start() {
+    assert_eq!(held(Btn::B), ButtonMask::B, "A");
+    assert_eq!(held(Btn::A), ButtonMask::A, "B");
+    assert_eq!(held(Btn::Y), ButtonMask::Y, "C");
+    assert_eq!(held(Btn::X), ButtonMask::X, "D");
+    assert_eq!(held(Btn::Start), ButtonMask::START);
+    assert!(Platform::Neocd.passes_xy_through());
+    assert!(!Platform::Neocd.turbo_on_xy());
+    assert!(Platform::Neocd.select_x_toggles_picture());
+}
+
+#[test]
+fn the_in_game_shader_row_steps_the_neo_geo_cd_shader_into_its_own_file() {
+    let _g = core_lock();
+    let Some(dylib) = neocd() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().screen_shader(), Shader::Off);
+    let mut now = 100;
+    for ev in [
+        RawEvent::Down(Btn::Select),
+        RawEvent::Down(Btn::A),
+        RawEvent::Up(Btn::A),
+        RawEvent::Up(Btn::Select),
+    ] {
+        now += 20;
+        session.feed([ev], now);
+    }
+    session.app().flush_state();
+    assert_eq!(session.app().screen_shader(), Shader::RETRO[1]);
+    assert_eq!(
+        slot_store::read_sega_shaders(root.path()).neocd,
+        Shader::RETRO[1]
+    );
+    assert_eq!(
+        slot_store::read_sega_shaders(root.path()).neogeo,
+        Shader::Off
+    );
+}
+
+#[test]
+fn the_neo_geo_cd_shelf_sits_between_cps2_and_the_32x_by_release_date() {
+    let released = slot::shelf_order::RELEASED;
+    let at = |p: Platform| released.iter().position(|r| r.0 == p).expect("listed");
+    assert_eq!(released[at(Platform::Neocd)], (Platform::Neocd, 1994, 9, 9));
+    assert_eq!(at(Platform::Neocd), at(Platform::Cps2) + 1);
+    assert_eq!(at(Platform::S32x), at(Platform::Neocd) + 1);
+}
