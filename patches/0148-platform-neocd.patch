diff --git a/crates/slot-store/tests/neocd_platform.rs b/crates/slot-store/tests/neocd_platform.rs
new file mode 100644
index 0000000..c1003e4
--- /dev/null
+++ b/crates/slot-store/tests/neocd_platform.rs
@@ -0,0 +1,156 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Cart, Core,
+    GameButton, Platform, RetroShader, SegaShaders, Shader, SlotState, NEOCD_SHADER_FILE,
+};
+
+fn put(root: &Path, dir: &str, name: &str) {
+    let dir = root.join("Games").join(dir);
+    std::fs::create_dir_all(&dir).expect("create dir");
+    std::fs::write(dir.join(name), [0u8; 0x200]).expect("write");
+}
+
+fn on(root: &Path, platform: Platform) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == platform)
+        .collect()
+}
+
+#[test]
+fn the_neo_geo_cd_follows_the_sega_cd_and_upstreams_list_stays_three() {
+    let last = Platform::SHELVES.len() - 1;
+    assert_eq!(Platform::SHELVES[last], Platform::Neocd);
+    assert_eq!(Platform::SHELVES[last - 1], Platform::SegaCd);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::Neocd.dir_name(), "NEOCD");
+    assert_eq!(Platform::Neocd.name(), "SNK Neo Geo CD");
+}
+
+#[test]
+fn a_chd_or_cue_lands_on_the_neo_geo_cd_shelf_and_track_files_stay_off_it() {
+    let d = tmp_root();
+    for name in [
+        "Samurai Shodown RPG (Japan) (En).chd",
+        "Crossed Swords II (Japan) (En,Ja).CUE",
+        "Crossed Swords II (Japan) (En,Ja) (Track 01).bin",
+        "Crossed Swords II (Japan) (En,Ja) (Track 02).bin",
+        "._Samurai Shodown RPG (Japan) (En).chd",
+        "Last Blade.ccd",
+        "Set.m3u",
+        "mslug.zip",
+    ] {
+        put(d.path(), "NEOCD", name);
+    }
+    let mut carts = on(d.path(), Platform::Neocd);
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(
+        stems,
+        [
+            "Crossed Swords II (Japan) (En,Ja)",
+            "Samurai Shodown RPG (Japan) (En)"
+        ]
+    );
+    for c in &mut carts {
+        c.read_header();
+        assert!(c.title.is_empty(), "{} took a header title", c.stem);
+    }
+}
+
+#[test]
+fn a_disc_on_the_neo_geo_shelf_is_skipped_and_the_arcade_shelf_stays_sets_only() {
+    let d = tmp_root();
+    put(d.path(), "NEOGEO", "Samurai Shodown RPG (Japan) (En).chd");
+    assert!(on(d.path(), Platform::NeoGeo).is_empty());
+    assert!(on(d.path(), Platform::Neocd).is_empty());
+}
+
+#[test]
+fn the_neo_geo_cd_runs_on_neocd_alone() {
+    assert_eq!(Core::default_for(Platform::Neocd), Core::Neocd);
+    assert_eq!(Core::Neocd.canvas(Platform::Neocd), (360, 240));
+    assert_eq!(Core::Neocd.as_str(), "neocd");
+    assert_eq!(Core::Neocd.text(), "NeoCD");
+    assert_eq!(Core::parse("neocd"), Some(Core::Neocd));
+    assert_eq!(Core::Neocd.option_prefix(), "neocd");
+    assert_eq!(Core::Neocd.pair(), (Core::Neocd, Core::Neocd));
+    assert!(Core::Neocd.reports_its_frame_rate());
+    assert!(!Core::Neocd.has_colour_correction());
+    assert_eq!(Platform::Neocd.picker_cores(), None);
+    assert_eq!(Core::EVERY.last(), Some(&Core::Neocd));
+    for core in Core::EVERY {
+        assert_eq!(core.runs(Platform::Neocd), core == Core::Neocd, "{core:?}");
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::Neocd.runs(platform),
+            platform == Platform::Neocd,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn the_neo_geo_cd_plays_and_draws_like_the_neo_geo_without_rewind() {
+    let (c, n) = (Platform::Neocd, Platform::NeoGeo);
+    assert_eq!(c.owns_shoulders(), n.owns_shoulders());
+    assert_eq!(c.owns_triggers(), n.owns_triggers());
+    assert_eq!(c.passes_xy_through(), n.passes_xy_through());
+    assert_eq!(c.turbo_on_xy(), n.turbo_on_xy());
+    assert_eq!(c.select_x_toggles_picture(), n.select_x_toggles_picture());
+    assert_eq!(c.stretch_crops_height(), n.stretch_crops_height());
+    assert_eq!(c.overscan(), n.overscan());
+    assert_eq!(c.follows_frame_width(), n.follows_frame_width());
+    assert_eq!(c.picture(), (320, 224));
+    assert_eq!(c.shader_choices(), &Shader::RETRO);
+    assert_eq!(GameButton::of(c), GameButton::of(n));
+    assert!(!c.rewinds());
+    assert!(!c.is_arcade());
+    assert!(!c.has_gb_palettes());
+    assert!(!c.fills_canvas());
+    assert!(!c.swaps_discs());
+    assert!(!c.flashes_on_unload());
+    assert_eq!(c.actual_scale(), None);
+}
+
+#[test]
+fn a_neo_geo_cd_game_resumes_as_a_neo_geo_cd_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Samurai Shodown RPG (Japan) (En)".into()),
+        cart_platform: Some(Platform::Neocd),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=neocd"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn the_neo_geo_cd_shader_lives_in_its_own_file_and_leaves_the_neo_geo_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        neocd: Shader::Retro(RetroShader::CrtPi),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(NEOCD_SHADER_FILE)).expect("read"),
+        "neocd=crt-pi\n"
+    );
+    assert!(!d.path().join("Config/neogeo_shader.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+    std::fs::write(
+        d.path().join("Config").join(NEOCD_SHADER_FILE),
+        "neocd=lcd3x\n",
+    )
+    .unwrap();
+    assert_eq!(read_sega_shaders(d.path()).neocd, Shader::Off);
+}
