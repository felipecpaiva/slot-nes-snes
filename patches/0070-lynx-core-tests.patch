+#![allow(dead_code)]
+
+use std::path::{Path, PathBuf};
+
+pub const W: usize = 160;
+pub const H: usize = 102;
+// The 160x102 picture in the middle of the 240x160 buffer the generic host draws into.
+pub const LEFT: usize = (240 - W) / 2;
+pub const TOP: usize = (160 - H) / 2;
+pub const BIOS_CRC32: u32 = 0x0d97_3c9d;
+
+/// Sets all 16 pens to pure red (GREENx = 0, BLUEREDx = 0x0f), then spins. `at` is where it runs.
+/// With `hz75` it first reprograms the line timer the way a 75 Hz game does (HTIMBKUP $7E, PBKUP $20,
+/// against the $9E and $29 of 60 Hz).
+pub fn paint(at: u16, hz75: bool) -> Vec<u8> {
+    let mut code = vec![0x78]; // sei
+    if hz75 {
+        code.extend([0xa9, 0x7e, 0x8d, 0x00, 0xfd]); // lda #$7e, sta HTIMBKUP
+        code.extend([0xa9, 0x20, 0x8d, 0x93, 0xfd]); // lda #$20, sta PBKUP
+    }
+    code.extend([
+        0xa2, 0x0f, // ldx #15
+        0xa9, 0x00, // loop: lda #0
+        0x9d, 0xa0, 0xfd, // sta GREEN0,x
+        0xa9, 0x0f, // lda #$0f
+        0x9d, 0xb0, 0xfd, // sta BLUERED0,x
+        0xca, // dex
+        0x10, 0xf3, // bpl loop
+    ]);
+    let spin = at + code.len() as u16;
+    code.extend([0x4c, spin as u8, (spin >> 8) as u8]); // jmp spin
+    code
+}
+
+/// Copies the joystick byte (JOYSTICK, $FCB0) into every pen's blue and red nibbles forever, so the
+/// picture's colour shows which buttons the game saw. `at` is where it runs.
+pub fn echo_pad(at: u16) -> Vec<u8> {
+    let lp = at + 11;
+    vec![
+        0x78, // sei
+        0xa9,
+        0x00, // lda #0
+        0xa2,
+        0x0f, // ldx #15
+        0x9d,
+        0xa0,
+        0xfd, // l1: sta GREEN0,x
+        0xca, // dex
+        0x10,
+        0xfa, // bpl l1
+        0xad,
+        0xb0,
+        0xfc, // loop: lda JOYSTICK
+        0xa2,
+        0x0f, // ldx #15
+        0x9d,
+        0xb0,
+        0xfd, // l2: sta BLUERED0,x
+        0xca, // dex
+        0x10,
+        0xfa, // bpl l2
+        0x4c,
+        lp as u8,
+        (lp >> 8) as u8, // jmp loop
+    ]
+}
+
+/// A BS93 homebrew image: the 10-byte header (0x80 0x08 is `bra +8` over it), loaded at `at - 10`.
+pub fn homebrew(dir: &Path, stem: &str, hz75: bool) -> PathBuf {
+    const AT: u16 = 0x0400;
+    let code = paint(AT, hz75);
+    let size = (10 + code.len()) as u16;
+    let mut img = vec![0x80, 0x08];
+    img.extend(AT.to_be_bytes());
+    img.extend(size.to_be_bytes());
+    img.extend(b"BS93");
+    img.extend(code);
+    let path = dir.join(format!("{stem}.o"));
+    std::fs::write(&path, img).unwrap();
+    path
+}
+
+pub const CC65_LOADER: [u8; 52] = [
+    0xff, 0xb6, 0xbb, 0x82, 0xd5, 0x9f, 0x48, 0xcf, 0x23, 0x37, 0x8e, 0x07, 0x38, 0xf5, 0xb6, 0x30,
+    0xd6, 0x2f, 0x12, 0x29, 0x9f, 0x43, 0x5b, 0x2e, 0xf5, 0x66, 0x5c, 0xdb, 0x93, 0x1a, 0x78, 0x55,
+    0x5e, 0xc9, 0x0d, 0x72, 0x1b, 0xe9, 0xd8, 0x4d, 0x2f, 0xe4, 0x95, 0xc0, 0x4f, 0x7f, 0x1b, 0x66,
+    0x8b, 0xa7, 0xfc, 0x21,
+];
+
+/// A 128 KB .lnx cart: the 64-byte LYNX header (bank 0 pages of 512 bytes, version 1, title at 0x0a,
+/// rotation byte at 0x3a), the cc65 encrypted loader, then `code` (built to run at $FB68), which the
+/// loader copies there.
+pub fn lnx_cart(dir: &Path, stem: &str, rotation: u8, code: Vec<u8>) -> PathBuf {
+    let mut hdr = vec![0u8; 64];
+    hdr[..4].copy_from_slice(b"LYNX");
+    hdr[4..6].copy_from_slice(&0x0200u16.to_le_bytes());
+    hdr[8..10].copy_from_slice(&1u16.to_le_bytes());
+    hdr[0x0a..0x0a + 9].copy_from_slice(b"SLOT LYNX");
+    hdr[0x3a] = rotation;
+    let mut rom = vec![0u8; 128 * 1024];
+    rom[..52].copy_from_slice(&CC65_LOADER);
+    rom[52..52 + code.len()].copy_from_slice(&code);
+    hdr.extend(rom);
+    let path = dir.join(format!("{stem}.lnx"));
+    std::fs::write(&path, hdr).unwrap();
+    path
+}
+
+pub fn crc32(data: &[u8]) -> u32 {
+    let mut crc = !0u32;
+    for &b in data {
+        crc ^= b as u32;
+        for _ in 0..8 {
+            crc = if crc & 1 != 0 {
+                (crc >> 1) ^ 0xedb8_8320
+            } else {
+                crc >> 1
+            };
+        }
+    }
+    !crc
+}
+
+/// The maintainer's own boot ROM from `SLOT_LYNX_BIOS`, checked like slot's BIOS check will check it.
+pub fn lynx_bios() -> Option<Vec<u8>> {
+    let Some(path) = std::env::var_os("SLOT_LYNX_BIOS") else {
+        eprintln!("skipping: no Lynx BIOS, set SLOT_LYNX_BIOS to a lynxboot.img (512 bytes, crc32 0d973c9d)");
+        return None;
+    };
+    let bytes = std::fs::read(&path).unwrap_or_default();
+    if bytes.len() != 512 || crc32(&bytes) != BIOS_CRC32 {
+        eprintln!(
+            "skipping: SLOT_LYNX_BIOS {} is not the Lynx BIOS ({} bytes, crc32 {:08x})",
+            Path::new(&path).display(),
+            bytes.len(),
+            crc32(&bytes)
+        );
+        return None;
+    }
+    Some(bytes)
+}
