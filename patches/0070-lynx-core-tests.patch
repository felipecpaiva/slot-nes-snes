new file mode 100644
index 0000000..7323de2
--- /dev/null
+++ b/crates/slot/tests/lynx_core.rs
@@ -0,0 +1,292 @@
+// Beetle Lynx (Atari Lynx) on the generic libretro host, before any Lynx platform code exists (issues
+// 102 and 110, ADR 0093).
+//
+// The core has no high-level boot at the pinned commit: with no `lynxboot.img` in the system dir it
+// fills the boot ROM with 0x88 and returns, so a cart "loads" and shows nothing, with no error. Two
+// kinds of test follow from that:
+//
+// - Tests that need no BIOS always run (CI included). They use a BS93 homebrew image, which the core
+//   copies straight into RAM and starts at its load address with the display timers preset, so the
+//   boot ROM is never used. They also pin the missing-BIOS signature that slot's BIOS check (issue 104)
+//   exists to prevent.
+// - Tests that boot a .lnx cart through the real boot ROM read it from `SLOT_LYNX_BIOS` (a path to a
+//   `lynxboot.img`, 512 bytes, crc32 0x0d973c9d, the `[BIOS] Atari Lynx` entry in the core's own
+//   cart database). No BIOS is in the repo or on CI, so there they print a skip naming the BIOS,
+//   which run-tests.sh lists as a ROM skip and does not count as a missing core, also under
+//   SLOT_REQUIRE_CORES=1. The core itself is still required first.
+//
+// The encrypted one-block boot loader in `lnx_cart` is the public cc65 loader by Karri Kaksonen
+// (cc65 libsrc/lynx/bootldr.s, zlib licence): the boot ROM decrypts it to $0200, it reads the next 151
+// cart bytes to $FB68 and jumps there. Our paint code sits in those 151 bytes.
+mod common;
+mod core_common;
+mod lynx_common;
+
+use std::path::Path;
+
+use common::core_lock;
+use core_common::require_core;
+use lynx_common::{echo_pad, homebrew, lnx_cart, lynx_bios, paint, H, LEFT, TOP, W};
+use slot_retro::{ButtonMask, LibretroCore, RetroCore};
+
+/// The core opened the way slot opens every core today: BIOS/ as the system dir and Saves/ as the save
+/// dir (`slot::core::open_named`). `bios` goes into BIOS/lynxboot.img when given.
+fn beetle(root: &Path, bios: Option<&[u8]>) -> Option<LibretroCore> {
+    let dylib = require_core("mednafen_lynx")?;
+    let bios_dir = slot::root::bios_dir(root);
+    std::fs::create_dir_all(&bios_dir).unwrap();
+    std::fs::create_dir_all(slot::root::saves_dir(root)).unwrap();
+    if let Some(b) = bios {
+        std::fs::write(bios_dir.join("lynxboot.img"), b).unwrap();
+    }
+    Some(
+        LibretroCore::open_with(&dylib, &bios_dir, &slot::root::saves_dir(root))
+            .expect("open Beetle Lynx"),
+    )
+}
+
+/// Runs `frames` frames and returns the stereo sample frames the last one produced.
+fn play(core: &mut LibretroCore, frames: usize) -> usize {
+    let mut last = 0;
+    for _ in 0..frames {
+        core.run_frame(ButtonMask::default());
+        last = core.take_audio().len() / 2;
+    }
+    last
+}
+
+fn assert_red_picture(core: &LibretroCore) {
+    let video = core.video_xrgb8888();
+    assert_eq!(video.len(), 240 * 160 * 4);
+    for y in 0..160 {
+        for x in 0..240 {
+            let at = (y * 240 + x) * 4;
+            let px = &video[at..at + 3];
+            if (LEFT..LEFT + W).contains(&x) && (TOP..TOP + H).contains(&y) {
+                assert!(
+                    px[2] > 200 && px[1] < 60 && px[0] < 60,
+                    "({x}, {y}) is {px:?}"
+                );
+            } else {
+                assert_eq!(px, [0, 0, 0], "({x}, {y})");
+            }
+        }
+    }
+}
+
+/// The core's fill for lines the display never drew: MAKECOLOR(30, 30, 30) in RGB565, every pixel.
+fn assert_undrawn_picture(core: &LibretroCore) {
+    let video = core.video_xrgb8888();
+    let first = &video[(TOP * 240 + LEFT) * 4..(TOP * 240 + LEFT) * 4 + 3];
+    assert!(first.iter().all(|&c| c > 0 && c < 40), "fill is {first:?}");
+    for y in TOP..TOP + H {
+        for x in LEFT..LEFT + W {
+            let at = (y * 240 + x) * 4;
+            assert_eq!(&video[at..at + 3], first, "({x}, {y})");
+        }
+    }
+}
+
+// Sample frames per retro_run at 44.1 kHz: 588 is 75 Hz, 735 is 60 Hz. The core runs one Lynx display
+// frame per retro_run, whatever fps it reports, so this is the real rate. The boot ROM and the core's
+// homebrew preset both leave the timers at 59.9 Hz (159 us a line, 105 lines); a game picks its own.
+const AT_60HZ: std::ops::RangeInclusive<usize> = 725..=745;
+const AT_75HZ: std::ops::RangeInclusive<usize> = 580..=596;
+
+#[test]
+fn a_lynx_homebrew_image_runs_with_no_bios_and_draws_160_by_102_in_the_middle_of_240_by_160_at_60_hz_while_reporting_75(
+) {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = beetle(d.path(), None) else {
+        return;
+    };
+    core.load(&homebrew(d.path(), "Paint", false))
+        .expect("Beetle Lynx refused the image");
+    let per_frame = play(&mut core, 30);
+    let av = core.av_info();
+    assert_eq!(av.fps, 75.0);
+    assert_eq!(av.sample_rate, 44100.0);
+    assert!(AT_60HZ.contains(&per_frame), "{per_frame} samples a frame");
+    assert_red_picture(&core);
+}
+
+#[test]
+fn force_60hz_only_changes_the_reported_fps_not_the_game_speed() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = beetle(d.path(), None) else {
+        return;
+    };
+    core.set_option("lynx_force_60hz", "enabled");
+    core.load(&homebrew(d.path(), "Paint", false)).unwrap();
+    let per_frame = play(&mut core, 30);
+    assert_eq!(core.av_info().fps, 60.0);
+    // The same 59.9 Hz frame of sound per retro_run as with the option off.
+    assert!(AT_60HZ.contains(&per_frame), "{per_frame} samples a frame");
+}
+
+#[test]
+fn a_game_that_sets_75_hz_gets_75_hz_frames_and_the_core_still_reports_75() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = beetle(d.path(), None) else {
+        return;
+    };
+    core.load(&homebrew(d.path(), "Fast", true)).unwrap();
+    let per_frame = play(&mut core, 30);
+    assert_eq!(core.av_info().fps, 75.0);
+    assert!(AT_75HZ.contains(&per_frame), "{per_frame} samples a frame");
+    assert_red_picture(&core);
+}
+
+#[test]
+fn a_lynx_state_round_trips() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = beetle(d.path(), None) else {
+        return;
+    };
+    core.load(&homebrew(d.path(), "Paint", false)).unwrap();
+    play(&mut core, 5);
+    let state = core.serialize().expect("no state");
+    play(&mut core, 10);
+    core.unserialize(&state)
+        .expect("the state would not load back");
+    assert_eq!(core.serialize().unwrap(), state);
+}
+
+#[test]
+fn beetle_lynx_gives_the_frontend_no_save_ram() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = beetle(d.path(), None) else {
+        return;
+    };
+    core.load(&homebrew(d.path(), "Paint", false)).unwrap();
+    play(&mut core, 5);
+    assert_eq!(core.save_ram(), None);
+}
+
+#[test]
+fn with_no_bios_a_lnx_cart_loads_without_error_and_never_draws() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = beetle(d.path(), None) else {
+        return;
+    };
+    core.load(&lnx_cart(d.path(), "Paint", 0, paint(0xfb68, false)))
+        .expect("the core says nothing about the missing BIOS, it loads");
+    let per_frame = play(&mut core, 10);
+    assert_undrawn_picture(&core);
+    // No display frame ever ends, so each retro_run stops at the core's 700000-cycle cap (43.75 ms).
+    assert!(per_frame > 1800, "{per_frame} samples a frame");
+}
+
+#[test]
+fn a_bios_file_shorter_than_512_bytes_is_ignored_the_same_silent_way() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = beetle(d.path(), Some(&[0u8; 256])) else {
+        return;
+    };
+    core.load(&lnx_cart(d.path(), "Paint", 0, paint(0xfb68, false)))
+        .unwrap();
+    play(&mut core, 10);
+    assert_undrawn_picture(&core);
+}
+
+#[test]
+fn with_the_bios_a_lnx_cart_boots_and_draws_160_by_102_at_the_60_hz_the_boot_rom_sets() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(bios) = lynx_bios() else {
+        return;
+    };
+    let Some(mut core) = beetle(d.path(), Some(&bios)) else {
+        return;
+    };
+    core.load(&lnx_cart(d.path(), "Paint", 0, paint(0xfb68, false)))
+        .expect("Beetle Lynx refused the cart");
+    let per_frame = play(&mut core, 120);
+    assert!(AT_60HZ.contains(&per_frame), "{per_frame} samples a frame");
+    assert_eq!(core.av_info().fps, 75.0);
+    assert_red_picture(&core);
+}
+
+#[test]
+fn with_the_bios_a_lnx_state_round_trips() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(bios) = lynx_bios() else {
+        return;
+    };
+    let Some(mut core) = beetle(d.path(), Some(&bios)) else {
+        return;
+    };
+    core.load(&lnx_cart(d.path(), "Paint", 0, paint(0xfb68, false)))
+        .unwrap();
+    play(&mut core, 120);
+    let state = core.serialize().expect("no state");
+    play(&mut core, 10);
+    core.unserialize(&state)
+        .expect("the state would not load back");
+    assert_eq!(core.serialize().unwrap(), state);
+    play(&mut core, 2);
+    assert_red_picture(&core);
+}
+
+/// What the game read from the pad, as the colour it painted, after `frames` frames holding `held`.
+fn pad_seen(bios: &[u8], rotation: u8, rot_option: Option<&str>, held: u16) -> Option<Vec<u8>> {
+    let d = tempfile::tempdir().unwrap();
+    let mut core = beetle(d.path(), Some(bios))?;
+    if let Some(v) = rot_option {
+        core.set_option("lynx_rot_screen", v);
+    }
+    core.load(&lnx_cart(d.path(), "Pad", rotation, echo_pad(0xfb68)))
+        .unwrap();
+    for _ in 0..90 {
+        core.run_frame(ButtonMask(held));
+    }
+    let at = ((TOP + H / 2) * 240 + LEFT + W / 2) * 4;
+    Some(core.video_xrgb8888()[at..at + 3].to_vec())
+}
+
+// Header byte 0x3a: 1 is CART_ROTATE_LEFT, 2 is CART_ROTATE_RIGHT. The core's own 87-entry checksum
+// list overrides it for the carts it knows; this synthetic cart is not on it.
+const RIGHT_CART: u8 = 2;
+
+#[test]
+fn the_core_turns_the_pad_for_a_rotated_cart_only_when_lynx_rot_screen_asks_it_to() {
+    let _g = core_lock();
+    let Some(bios) = lynx_bios() else {
+        return;
+    };
+    let Some(up) = pad_seen(&bios, 0, None, ButtonMask::UP) else {
+        return;
+    };
+    let left = pad_seen(&bios, 0, None, ButtonMask::LEFT).unwrap();
+    let idle = pad_seen(&bios, 0, None, 0).unwrap();
+    assert_ne!(up, left);
+    assert_ne!(up, idle);
+    // Unanswered (slot today: GET_VARIABLE is false for an unset key) or "0": the raw pad.
+    assert_eq!(
+        pad_seen(&bios, RIGHT_CART, None, ButtonMask::UP).unwrap(),
+        up
+    );
+    assert_eq!(
+        pad_seen(&bios, RIGHT_CART, Some("0"), ButtonMask::UP).unwrap(),
+        up
+    );
+    // "auto", the core's declared default: a right cart is turned 270 degrees, so Up reads as Left.
+    assert_eq!(
+        pad_seen(&bios, RIGHT_CART, Some("auto"), ButtonMask::UP).unwrap(),
+        left
+    );
+    // "180": Up reads as Down, the turn slot needs for a right cart drawn flipped.
+    let down = pad_seen(&bios, 0, None, ButtonMask::DOWN).unwrap();
+    assert_eq!(
+        pad_seen(&bios, RIGHT_CART, Some("180"), ButtonMask::UP).unwrap(),
+        down
+    );
+}
