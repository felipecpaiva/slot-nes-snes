+
+#[test]
+fn only_game_gear_adds_lcd3x_to_the_retro_list_right_after_off() {
+    assert_eq!(Shader::GG[..2], [Shader::Off, Shader::Lcd3x]);
+    assert_eq!(Shader::GG[2..], Shader::RETRO[1..]);
+    for platform in [Platform::Nes, Platform::Snes, Platform::Sms, Platform::Md] {
+        assert_eq!(platform.shader_choices(), &Shader::RETRO, "{platform:?}");
+        assert!(
+            !platform.shader_choices().contains(&Shader::Lcd3x),
+            "{platform:?}"
+        );
+    }
 }
 
