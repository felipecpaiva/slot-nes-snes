diff --git a/crates/slot-store/src/retro_shader.rs b/crates/slot-store/src/retro_shader.rs
index 87acdc4..b16e054 100644
--- a/crates/slot-store/src/retro_shader.rs
+++ b/crates/slot-store/src/retro_shader.rs
@@ -74,4 +74,19 @@ impl Shader {
         Shader::Retro(RetroShader::Line),
         Shader::Retro(RetroShader::Pixel),
     ];
+
+    // Game Gear is an LCD handheld at 3x like the Game Boy, so it gets upstream's LCD3x right
+    // after Off, where Shader::GB and Shader::GBA have it, before the shared retro list.
+    pub const GG: [Shader; 10] = [
+        Shader::Off,
+        Shader::Lcd3x,
+        Shader::Grid,
+        Shader::Dot,
+        Shader::Retro(RetroShader::Sharp),
+        Shader::Retro(RetroShader::Scanlines),
+        Shader::Retro(RetroShader::CrtPi),
+        Shader::Retro(RetroShader::Crt1Tap),
+        Shader::Retro(RetroShader::Line),
+        Shader::Retro(RetroShader::Pixel),
+    ];
 }
