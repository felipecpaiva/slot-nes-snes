index 0000000..9639028
--- /dev/null
+++ b/crates/slot-gfx/tests/gg_lcd.rs
@@ -0,0 +1,101 @@
+#![cfg(target_os = "macos")]
+
+use slot_gfx::{Compositor, HeadlessSurface, ScreenEffect};
+use std::sync::{Mutex, PoisonError};
+
+static GL: Mutex<()> = Mutex::new(());
+
+const CANVAS: (u32, u32) = (240, 160);
+const PICTURE: [f32; 4] = [40.0 / 240.0, 8.0 / 160.0, 200.0 / 240.0, 152.0 / 160.0];
+const PANEL_W: usize = 720;
+
+fn game_gear(grey: bool) -> Vec<u8> {
+    let mut buf = Vec::with_capacity(240 * 160 * 4);
+    for y in 0..160 {
+        for x in 0..240 {
+            let inside = (40..200).contains(&x) && (8..152).contains(&y);
+            let px = match (inside, grey) {
+                (false, _) => [0, 0, 0, 0],
+                (true, true) => [160, 160, 160, 0],
+                (true, false) => [(x * 7 + y * 13) as u8, (y * 5) as u8, (x * 3) as u8, 0],
+            };
+            buf.extend_from_slice(&px);
+        }
+    }
+    buf
+}
+
+fn drawn(c: &mut Compositor, effect: ScreenEffect, src: &[u8]) -> Vec<u8> {
+    c.set_game_canvas(CANVAS.0, CANVAS.1);
+    c.set_picture(PICTURE);
+    c.set_screen_effect(effect);
+    c.set_screen_power(1.0);
+    c.begin_frame();
+    c.upload_game(src);
+    c.draw_game();
+    c.read_frame()
+}
+
+fn at(frame: &[u8], x: usize, y: usize) -> &[u8] {
+    let i = (y * PANEL_W + x) * 4;
+    &frame[i..i + 4]
+}
+
+fn in_picture(x: usize, y: usize) -> bool {
+    (120..600).contains(&x) && (24..456).contains(&y)
+}
+
+#[test]
+fn lcd3x_draws_a_3x_game_gear_frame_the_same_twice_and_leaves_the_border_alone() {
+    let _g = GL.lock().unwrap_or_else(PoisonError::into_inner);
+    let Ok(surface) = HeadlessSurface::new() else {
+        return;
+    };
+    let mut c = Compositor::new(&surface).expect("the compositor and its shaders build");
+    let src = game_gear(false);
+    let off = drawn(&mut c, ScreenEffect::None, &src);
+    let once = drawn(&mut c, ScreenEffect::Lcd3x, &src);
+    let twice = drawn(&mut c, ScreenEffect::Lcd3x, &src);
+    assert_eq!(once, twice, "LCD3x is not deterministic on Game Gear");
+    let mut changed = 0;
+    for y in 0..480 {
+        for x in 0..PANEL_W {
+            if in_picture(x, y) {
+                changed += usize::from(at(&once, x, y) != at(&off, x, y));
+            } else {
+                assert_eq!(
+                    at(&once, x, y),
+                    at(&off, x, y),
+                    "({x}, {y}) outside the picture"
+                );
+            }
+        }
+    }
+    assert!(
+        changed > 480 * 432 / 2,
+        "only {changed} picture pixels changed"
+    );
+}
+
+#[test]
+fn lcd3x_on_a_flat_game_gear_frame_repeats_every_3_panel_pixels_with_3_subpixel_columns() {
+    let _g = GL.lock().unwrap_or_else(PoisonError::into_inner);
+    let Ok(surface) = HeadlessSurface::new() else {
+        return;
+    };
+    let mut c = Compositor::new(&surface).expect("the compositor and its shaders build");
+    let frame = drawn(&mut c, ScreenEffect::Lcd3x, &game_gear(true));
+    // Within 2 per channel: a CI runner's GPU rounds the mask one step apart now and then.
+    let near = |a: &[u8], b: &[u8]| a.iter().zip(b).all(|(p, q)| p.abs_diff(*q) <= 2);
+    for y in 24..453 {
+        for x in 120..597 {
+            assert!(near(at(&frame, x, y), at(&frame, x + 3, y)), "({x}, {y})");
+            assert!(near(at(&frame, x, y), at(&frame, x, y + 3)), "({x}, {y})");
+        }
+    }
+    let cells: Vec<&[u8]> = (120..123).map(|x| at(&frame, x, 25)).collect();
+    assert!(
+        cells[0] != cells[1] && cells[1] != cells[2] && cells[0] != cells[2],
+        "{cells:?}"
+    );
+}
