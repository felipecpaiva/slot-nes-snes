+                eprintln!("slot: {SEGA_SHADERS_FILE}: ignoring {other}");
+                continue;
+            }
         };
-        match key.trim() {
-            "gg" => s.gg = shader,
-            "sms" => s.sms = shader,
-            "md" => s.md = shader,
-            other => eprintln!("slot: {SEGA_SHADERS_FILE}: ignoring {other}"),
+        match Shader::parse(value.trim()).filter(|v| platform.shader_choices().contains(v)) {
+            Some(v) => *shader = v,
