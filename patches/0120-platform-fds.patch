diff --git a/crates/slot-store/tests/fds_platform.rs b/crates/slot-store/tests/fds_platform.rs
new file mode 100644
index 0000000..97480da
--- /dev/null
+++ b/crates/slot-store/tests/fds_platform.rs
@@ -0,0 +1,124 @@
+mod common;
+
+use std::path::{Path, PathBuf};
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Cart, Core,
+    Platform, RetroShader, SegaShaders, Shader, SlotState, FDS_SHADER_FILE,
+};
+
+fn put(root: &Path, dir: &str, name: &str) -> PathBuf {
+    let dir = root.join(dir);
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let p = dir.join(name);
+    std::fs::write(&p, [0u8; 16]).expect("write");
+    p
+}
+
+fn on(root: &Path, platform: Platform) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == platform)
+        .collect()
+}
+
+#[test]
+fn the_disk_system_follows_cps2_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES[20], Platform::Fds);
+    assert_eq!(Platform::SHELVES[19], Platform::Cps2);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::Fds.dir_name(), "FDS");
+    assert_eq!(Platform::Fds.name(), "Nintendo Famicom Disk System");
+}
+
+#[test]
+fn an_fds_file_lands_on_the_disk_shelf_and_never_on_the_nes_shelf() {
+    let d = tmp_root();
+    put(d.path(), "Games/FDS", "Nazo no Murasamejou (Japan).fds");
+    put(d.path(), "Games/FDS", "Esper Dream (Japan).FDS");
+    put(d.path(), "Games/FDS", "._Deep Dungeon (Japan).fds");
+    put(d.path(), "Games/FDS", "Metroid (Japan).nes");
+    put(d.path(), "Games/NES", "Zelda no Densetsu (Japan).fds");
+    let mut carts = on(d.path(), Platform::Fds);
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(
+        stems,
+        ["Esper Dream (Japan)", "Nazo no Murasamejou (Japan)"]
+    );
+    for c in &mut carts {
+        c.read_header();
+        assert!(c.title.is_empty(), "{} took a header title", c.stem);
+    }
+    assert!(on(d.path(), Platform::Nes).is_empty());
+}
+
+#[test]
+fn the_disk_system_plays_like_the_nes_and_answers_every_policy() {
+    let p = Platform::Fds;
+    assert!(p.owns_shoulders());
+    assert!(p.owns_triggers());
+    assert!(!p.passes_xy_through());
+    assert!(!p.select_x_toggles_picture());
+    assert!(p.stretch_crops_height());
+    assert_eq!(p.overscan(), (8, 8));
+    assert!(!p.follows_frame_width());
+    assert!(!p.has_gb_palettes());
+    assert!(p.rewinds());
+    assert!(!p.fills_canvas());
+    assert!(!p.swaps_discs());
+    assert_eq!(p.actual_scale(), None);
+    assert!(!p.flashes_on_unload());
+    assert!(!p.is_arcade());
+    assert_eq!(p.picker_cores(), None);
+    assert_eq!(p.picture(), (256, 240));
+    assert_eq!(p.shader_choices(), &Shader::RETRO);
+    assert_eq!(p.extensions(), ["fds"]);
+}
+
+#[test]
+fn the_disk_system_runs_on_fceumm_alone_on_the_nes_canvas() {
+    assert_eq!(Core::default_for(Platform::Fds), Core::Fceumm);
+    assert_eq!(
+        Core::Fceumm.canvas(Platform::Fds),
+        Core::Fceumm.canvas(Platform::Nes)
+    );
+    for core in Core::EVERY {
+        assert_eq!(core.runs(Platform::Fds), core == Core::Fceumm, "{core:?}");
+    }
+    assert!(Core::Fceumm.runs(Platform::Nes));
+    assert!(Core::Nestopia.runs(Platform::Nes));
+}
+
+#[test]
+fn a_disk_system_game_resumes_as_a_disk_system_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Nazo no Murasamejou (Japan)".into()),
+        cart_platform: Some(Platform::Fds),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=fds"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn the_disk_system_shader_lives_in_its_own_file_and_leaves_the_nes_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        fds: Shader::Retro(RetroShader::CrtPi),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(FDS_SHADER_FILE)).expect("read"),
+        "fds=crt-pi\n"
+    );
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+    assert_eq!(read_slot_state(d.path()).shader_nes, Shader::Off);
+}
