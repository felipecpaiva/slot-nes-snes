+            columns_for: 0,
         }
     }
 }
@@ -112,6 +118,72 @@ pub fn bgrx_from_rgb565(p: u16) -> [u8; 4] {
     ]
 }
 
+pub unsafe fn copy_frame(
+    video: &mut [u8],
+    canvas: (u32, u32),
+    src: *const u8,
+    size: (u32, u32),
+    pitch: usize,
+    rgb565: bool,
+) {
+    let p = EXTRA.with(|e| e.get());
+    // SAFETY: the pointer is null or set by a live ExtraGuard on this thread, which clears it on drop.
+    match unsafe { p.as_mut() } {
+        Some(extra) if extra.fills => fill(extra, video, canvas, src, size, pitch, rgb565),
+        _ => copy_centred(video, canvas, src, size, pitch, rgb565),
+    }
+}
+
+pub unsafe fn fill(
+    extra: &mut HostExtra,
+    video: &mut [u8],
+    canvas: (u32, u32),
+    src: *const u8,
+    (width, height): (u32, u32),
+    pitch: usize,
+    rgb565: bool,
+) {
+    extra.frame = (width, height);
+    let (canvas_w, canvas_h) = (canvas.0 as usize, canvas.1 as usize);
+    let (w, h) = (width as usize, height as usize);
+    if video.len() != canvas_w * canvas_h * 4 || w == 0 || h == 0 {
+        eprintln!(
+            "slot: canvas: cannot fill a {canvas_w}x{canvas_h} canvas of {} bytes from {w}x{h}, frame dropped",
+            video.len()
+        );
+        return;
+    }
+    if extra.columns_for != width || extra.columns.len() != canvas_w {
+        extra.columns = (0..canvas_w).map(|x| (x * w / canvas_w) as u16).collect();
+        extra.columns_for = width;
+    }
+    let stride = canvas_w * 4;
+    let mut last = usize::MAX;
+    for y in 0..canvas_h {
+        let row = y * stride;
+        let from_y = y * h / canvas_h;
+        if from_y == last {
+            video.copy_within(row - stride..row, row);
+            continue;
+        }
+        last = from_y;
+        let from = src.add(from_y * pitch);
+        let out = &mut video[row..row + stride];
+        if rgb565 {
+            for (px, &x) in out.chunks_exact_mut(4).zip(&extra.columns) {
+                let p = ptr::read_unaligned((from as *const u16).add(x as usize));
+                px.copy_from_slice(&bgrx_from_rgb565(p));
+            }
+        } else {
+            for (px, &x) in out.chunks_exact_mut(4).zip(&extra.columns) {
+                px.copy_from_slice(&ptr::read_unaligned(
+                    (from as *const [u8; 4]).add(x as usize),
+                ));
+            }
+        }
+    }
+}
+
 pub unsafe fn copy_centred(
     video: &mut [u8],
     canvas: (u32, u32),
@@ -444,4 +516,194 @@ mod tests {
         }
         assert_eq!(bound_canvas(), None);
     }
+
+    fn numbered(w: usize, h: usize) -> Vec<u8> {
+        let mut frame = Vec::with_capacity(w * h * 4);
+        for y in 0..h {
+            for x in 0..w {
+                frame.extend_from_slice(&[x as u8, (x >> 8) as u8, y as u8, (y >> 8) as u8]);
+            }
+        }
+        frame
+    }
+
+    fn filled(extra: &mut HostExtra, frame: &[u8], size: (u32, u32), rgb565: bool) -> Vec<u8> {
+        let pitch = size.0 as usize * if rgb565 { 2 } else { 4 };
+        let mut video = vec![0u8; 640 * 480 * 4];
+        // SAFETY: frame holds size.1 rows of pitch bytes each.
+        unsafe {
+            fill(
+                extra,
+                &mut video,
+                (640, 480),
+                frame.as_ptr(),
+                size,
+                pitch,
+                rgb565,
+            )
+        };
+        video
+    }
+
+    fn source_of(video: &[u8], x: usize, y: usize) -> (usize, usize) {
+        let p = &video[(y * 640 + x) * 4..(y * 640 + x) * 4 + 4];
+        (
+            p[0] as usize | (p[1] as usize) << 8,
+            p[2] as usize | (p[3] as usize) << 8,
+        )
+    }
+
+    fn every_ps1_size() -> [(u32, u32); 8] {
+        [
+            (256, 240),
+            (320, 240),
+            (368, 240),
+            (384, 240),
+            (512, 240),
+            (640, 240),
+            (320, 480),
+            (640, 480),
+        ]
+    }
+
+    #[test]
+    fn every_ps1_frame_size_fills_the_whole_640_by_480_canvas_left_to_right_top_to_bottom() {
+        for (w, h) in every_ps1_size() {
+            let mut extra = HostExtra::default();
+            let video = filled(&mut extra, &numbered(w as usize, h as usize), (w, h), false);
+            assert_eq!(source_of(&video, 0, 0), (0, 0), "{w}x{h}");
+            assert_eq!(
+                source_of(&video, 639, 479),
+                (w as usize - 1, h as usize - 1),
+                "{w}x{h}"
+            );
+            let mut seen = vec![false; w as usize];
+            for x in 0..640 {
+                let (sx, _) = source_of(&video, x, 0);
+                assert_eq!(sx, x * w as usize / 640, "{w}x{h} column {x}");
+                seen[sx] = true;
+            }
+            assert!(seen.iter().all(|s| *s), "{w}x{h} dropped a column");
+            assert_eq!(extra.frame, (w, h));
+        }
+    }
+
+    #[test]
+    fn a_320_by_240_frame_is_an_exact_2x() {
+        let mut extra = HostExtra::default();
+        let video = filled(&mut extra, &numbered(320, 240), (320, 240), false);
+        for y in 0..480 {
+            for x in 0..640 {
+                assert_eq!(source_of(&video, x, y), (x / 2, y / 2), "({x}, {y})");
+            }
+        }
+    }
+
+    #[test]
+    fn a_640_by_480_frame_passes_one_to_one() {
+        let mut extra = HostExtra::default();
+        let frame = numbered(640, 480);
+        assert_eq!(filled(&mut extra, &frame, (640, 480), false), frame);
+    }
+
+    #[test]
+    fn a_frame_larger_than_the_canvas_is_thinned_and_never_written_past_it() {
+        let mut extra = HostExtra::default();
+        let video = filled(&mut extra, &numbered(1024, 960), (1024, 960), false);
+        assert_eq!(video.len(), 640 * 480 * 4);
+        assert_eq!(source_of(&video, 639, 479), (1022, 958));
+    }
+
+    #[test]
+    fn a_size_change_leaves_nothing_of_the_last_frame() {
+        let mut extra = HostExtra::default();
+        filled(&mut extra, &white(640, 480), (640, 480), false);
+        let small = vec![7u8; 256 * 240 * 4];
+        let video = filled(&mut extra, &small, (256, 240), false);
+        assert!(video.iter().all(|b| *b == 7));
+        let video = filled(&mut extra, &white(512, 240), (512, 240), false);
+        assert!(video.iter().all(|b| *b == 0xff));
+    }
+
+    #[test]
+    fn an_rgb565_frame_fills_converted_exactly_as_upstream_converts() {
+        let mut extra = HostExtra::default();
+        let frame: Vec<u8> = (0..320 * 240)
+            .flat_map(|i| ((i * 2654435761u64 as usize) as u16).to_le_bytes())
+            .collect();
+        let video = filled(&mut extra, &frame, (320, 240), true);
+        for (y, x) in [(0, 0), (1, 1), (240, 333), (479, 639)] {
+            let at = (y / 2 * 320 + x / 2) * 2;
+            let p = u16::from_le_bytes([frame[at], frame[at + 1]]);
+            assert_eq!(
+                video[(y * 640 + x) * 4..(y * 640 + x) * 4 + 4],
+                bgrx_from_rgb565(p),
+                "({x}, {y})"
+            );
+        }
+    }
+
+    #[test]
+    fn a_zero_sized_frame_is_dropped() {
+        let mut extra = HostExtra::default();
+        let video = filled(&mut extra, &[], (0, 240), true);
+        assert!(video.iter().all(|b| *b == 0));
+    }
+
+    #[test]
+    fn filling_640_by_480_from_a_full_rgb565_frame_takes_well_under_a_frame_on_the_host() {
+        let mut extra = HostExtra::default();
+        let frame = vec![0x5au8; 640 * 480 * 2];
+        let mut video = vec![0u8; 640 * 480 * 4];
+        let mut best = std::time::Duration::MAX;
+        for _ in 0..10 {
+            let start = std::time::Instant::now();
+            // SAFETY: frame holds 480 rows of 1280 bytes, 640 RGB565 pixels each.
+            unsafe {
+                fill(
+                    &mut extra,
+                    &mut video,
+                    (640, 480),
+                    frame.as_ptr(),
+                    (640, 480),
+                    1280,
+                    true,
+                )
+            };
+            best = best.min(start.elapsed());
+        }
+        assert!(
+            best < std::time::Duration::from_millis(16),
+            "best fill took {best:?}"
+        );
+    }
+
+    #[test]
+    fn copy_frame_fills_only_when_the_extra_asks_for_it() {
+        let frame = white(320, 240);
+        for (fills, lit_corner) in [(true, true), (false, false)] {
+            let mut extra = HostExtra {
+                canvas: (640, 480),
+                fills,
+                ..HostExtra::default()
+            };
+            let mut video = vec![0u8; 640 * 480 * 4];
+            {
+                let _g = ExtraGuard::bind(&mut extra);
+                // SAFETY: frame holds 240 rows of 1280 bytes, 320 XRGB8888 pixels each.
+                unsafe {
+                    copy_frame(
+                        &mut video,
+                        (640, 480),
+                        frame.as_ptr(),
+                        (320, 240),
+                        1280,
+                        false,
+                    )
+                };
+            }
+            assert_eq!(video[..3] == [0xff; 3], lit_corner, "fills {fills}");
+            assert_eq!(extra.frame, (320, 240));
+        }
+    }
 }
