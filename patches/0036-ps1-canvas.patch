diff --git a/crates/slot-gfx/tests/ps1_pipeline.rs b/crates/slot-gfx/tests/ps1_pipeline.rs
new file mode 100644
index 0000000..3a70c17
--- /dev/null
+++ b/crates/slot-gfx/tests/ps1_pipeline.rs
@@ -0,0 +1,75 @@
+#![cfg(target_os = "macos")]
+
+use slot_gfx::{Compositor, HeadlessSurface, ScreenEffect, OUT_H, OUT_W, WHOLE_TEXTURE};
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+static GL: Mutex<()> = Mutex::new(());
+
+const ACTUAL: [f32; 4] = [-40.0 / 640.0, 0.0, 720.0 / 640.0, 1.0];
+
+const EFFECTS: [ScreenEffect; 9] = [
+    ScreenEffect::None,
+    ScreenEffect::Grid,
+    ScreenEffect::Dot,
+    ScreenEffect::Retro(0),
+    ScreenEffect::Retro(1),
+    ScreenEffect::Retro(2),
+    ScreenEffect::Retro(3),
+    ScreenEffect::Retro(4),
+    ScreenEffect::Retro(5),
+];
+
+fn compositor() -> Option<(MutexGuard<'static, ()>, HeadlessSurface, Compositor)> {
+    let guard = GL.lock().unwrap_or_else(PoisonError::into_inner);
+    let surface = HeadlessSurface::new().ok()?;
+    let compositor = Compositor::new(&surface).expect("the compositor and its shaders build");
+    Some((guard, surface, compositor))
+}
+
+fn drawn(c: &mut Compositor, effect: ScreenEffect, src_rect: [f32; 4]) -> Vec<u8> {
+    c.set_game_canvas(640, 480);
+    c.set_game_source_rect(src_rect);
+    c.set_picture(WHOLE_TEXTURE);
+    c.set_screen_effect(effect);
+    c.set_screen_power(1.0);
+    c.begin_frame(slot_gfx::Layout::Framed);
+    c.upload_game(&vec![255; 640 * 480 * 4]);
+    c.draw_game();
+    c.read_frame()
+}
+
+fn lit(frame: &[u8], x: usize, y: usize) -> u8 {
+    let at = (y * OUT_W as usize + x) * 4;
+    frame[at..at + 3].iter().copied().max().unwrap_or(0)
+}
+
+#[test]
+fn actual_draws_black_bars_40_pixels_wide_beside_the_ps1_picture_with_every_shader() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    for effect in EFFECTS {
+        let frame = drawn(&mut c, effect, ACTUAL);
+        for y in [0, OUT_H as usize / 2, OUT_H as usize - 1] {
+            for x in [0, 39, 680, 719] {
+                assert_eq!(lit(&frame, x, y), 0, "{effect:?} ({x}, {y})");
+            }
+            for x in [42, 360, 677] {
+                assert!(lit(&frame, x, y) > 0, "{effect:?} ({x}, {y})");
+            }
+        }
+    }
+}
+
+#[test]
+fn stretch_draws_the_ps1_canvas_across_the_whole_panel() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    let frame = drawn(&mut c, ScreenEffect::None, WHOLE_TEXTURE);
+    for y in 0..OUT_H as usize {
+        for x in 0..OUT_W as usize {
+            assert_eq!(lit(&frame, x, y), 255, "({x}, {y})");
+        }
+    }
+}
