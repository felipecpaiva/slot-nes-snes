diff --git a/crates/slot-ui/src/art_fit.rs b/crates/slot-ui/src/art_fit.rs
new file mode 100644
index 0000000..58cc5be
--- /dev/null
+++ b/crates/slot-ui/src/art_fit.rs
@@ -0,0 +1,69 @@
+use std::path::Path;
+
+use crate::art::{cover_rgba, decode_png_bytes};
+
+pub fn contain(path: &Path, w: u32, h: u32) -> Option<Vec<u8>> {
+    let bytes = std::fs::read(path).ok()?;
+    let (src, sw, sh) = decode_png_bytes(&bytes)?;
+    contain_rgba(&src, sw, sh, w, h)
+}
+
+pub fn contain_rgba(src: &[u8], sw: u32, sh: u32, w: u32, h: u32) -> Option<Vec<u8>> {
+    if sw == 0 || sh == 0 || w == 0 || h == 0 {
+        return None;
+    }
+    let (wide, tall) = (sw as u64 * h as u64, sh as u64 * w as u64);
+    let (fw, fh) = if wide > tall {
+        (w, ((tall / sw as u64) as u32).max(1))
+    } else {
+        (((wide / sh as u64) as u32).max(1), h)
+    };
+    let fitted = cover_rgba(src, sw, sh, fw, fh)?;
+    if (fw, fh) == (w, h) {
+        return Some(fitted);
+    }
+    let mut out = [0, 0, 0, 255].repeat((w * h) as usize);
+    let (ox, oy) = (((w - fw) / 2) as usize, ((h - fh) / 2) as usize);
+    for (y, row) in fitted.chunks_exact(fw as usize * 4).enumerate() {
+        let at = ((oy + y) * w as usize + ox) * 4;
+        out.get_mut(at..at + row.len())?.copy_from_slice(row);
+    }
+    Some(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn white(w: u32, h: u32) -> Vec<u8> {
+        vec![255; (w * h * 4) as usize]
+    }
+
+    #[test]
+    fn a_three_by_two_thumb_fills_the_photo_exactly_as_cover_does() {
+        let src: Vec<u8> = (0..240 * 160 * 4).map(|i| (i * 7 % 251) as u8).collect();
+        assert_eq!(
+            contain_rgba(&src, 240, 160, 240, 160),
+            cover_rgba(&src, 240, 160, 240, 160)
+        );
+        let nes: Vec<u8> = (0..360 * 240 * 4).map(|i| (i * 3 % 241) as u8).collect();
+        assert_eq!(
+            contain_rgba(&nes, 360, 240, 240, 160),
+            cover_rgba(&nes, 360, 240, 240, 160)
+        );
+    }
+
+    #[test]
+    fn a_four_by_three_thumb_keeps_its_whole_picture_between_black_bars() {
+        let out = contain_rgba(&white(640, 480), 640, 480, 240, 160).expect("fit");
+        let px = |x: usize, y: usize| &out[(y * 240 + x) * 4..(y * 240 + x) * 4 + 4];
+        for y in [0, 80, 159] {
+            assert_eq!(px(0, y), [0, 0, 0, 255]);
+            assert_eq!(px(12, y), [0, 0, 0, 255]);
+            assert_eq!(px(13, y), [255; 4]);
+            assert_eq!(px(225, y), [255; 4]);
+            assert_eq!(px(226, y), [0, 0, 0, 255]);
+            assert_eq!(px(239, y), [0, 0, 0, 255]);
+        }
+    }
+}
