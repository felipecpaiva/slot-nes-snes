@@ -0,0 +1,159 @@
+mod common;
+mod core_common;
+mod ps1_common;
+
+use std::path::{Path, PathBuf};
+
+use common::core_lock;
+use ps1_common::{disc_in_mode, pcsx_rearmed, red, MODE_256, MODE_320, MODE_512};
+use slot::core::open_core_for_palette;
+use slot::platform_video::shown;
+use slot::video_mode::{source_rect, VideoMode};
+use slot_gfx::WHOLE_TEXTURE;
+use slot_retro::{ButtonMask, RetroCore};
+use slot_store::{Core, Platform, StateEntry};
+
+fn opened(dylib: PathBuf, root: &Path) -> Box<dyn RetroCore> {
+    let mut core = open_core_for_palette(
+        root,
+        Core::PcsxRearmed,
+        Platform::Ps1,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.set_option("pcsx_rearmed_bios", "HLE");
+    core
+}
+
+fn played_in_mode(mode: u32) -> Option<(u32, Vec<u8>)> {
+    let dylib = pcsx_rearmed()?;
+    let d = common::tmp_root_with_real_carts(&[]);
+    let cue = disc_in_mode(&d.path().join("Games/PS1"), "Mode", mode);
+    let mut core = opened(dylib, d.path());
+    core.load(&cue).expect("pcsx refused the generated disc");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    Some((core.frame_width(), core.video_xrgb8888().to_vec()))
+}
+
+fn red_columns(video: &[u8], y: usize) -> usize {
+    red(&video[y * 640 * 4..(y + 1) * 640 * 4])
+}
+
+fn ps1_rect(mode: VideoMode) -> [f32; 4] {
+    source_rect(
+        Platform::Ps1,
+        shown(Platform::Ps1, 320, mode),
+        Core::PcsxRearmed.canvas(Platform::Ps1),
+        mode,
+    )
+}
+
+#[test]
+fn the_ps1_canvas_is_640_by_480_and_only_ps1_fills_it() {
+    assert_eq!(Core::PcsxRearmed.canvas(Platform::Ps1), (640, 480));
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            platform.fills_canvas(),
+            platform == Platform::Ps1,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn a_320_wide_ps1_frame_is_doubled_both_ways_to_fill_the_canvas() {
+    let _g = core_lock();
+    let Some((width, video)) = played_in_mode(MODE_320) else {
+        return;
+    };
+    assert_eq!(width, 320);
+    assert_eq!(red(&video), 640 * 480);
+}
+
+#[test]
+fn a_256_wide_ps1_frame_is_stretched_across_all_640_columns() {
+    let _g = core_lock();
+    let Some((width, video)) = played_in_mode(MODE_256) else {
+        return;
+    };
+    assert_eq!(width, 256);
+    assert_eq!(red(&video), 640 * 480);
+}
+
+#[test]
+fn a_512_wide_ps1_frame_is_resampled_to_640_columns() {
+    let _g = core_lock();
+    let Some((width, video)) = played_in_mode(MODE_512) else {
+        return;
+    };
+    assert_eq!(width, 512);
+    for y in [0, 240, 479] {
+        assert_eq!(red_columns(&video, y), 320 * 640 / 512, "row {y}");
+    }
+}
+
+#[test]
+fn actual_shows_the_ps1_picture_one_to_one_between_two_40_pixel_bars() {
+    let [x, y, w, h] = ps1_rect(VideoMode::Actual);
+    assert_eq!([y, h], [0.0, 1.0]);
+    assert_eq!((x * 640.0, w * 640.0), (-40.0, 720.0));
+}
+
+#[test]
+fn stretch_draws_the_whole_ps1_canvas_across_the_panel_with_no_bars() {
+    assert_eq!(ps1_rect(VideoMode::Stretch), WHOLE_TEXTURE);
+}
+
+#[test]
+fn actual_on_every_three_by_two_canvas_is_still_the_whole_texture() {
+    for (core, platform) in [
+        (Core::Mgba, Platform::Gba),
+        (Core::Mgba, Platform::Gb),
+        (Core::Fceumm, Platform::Nes),
+        (Core::Snes9x, Platform::Snes),
+        (Core::GenesisPlusGx, Platform::Gg),
+        (Core::GenesisPlusGx, Platform::Md),
+    ] {
+        let canvas = core.canvas(platform);
+        assert_eq!(
+            source_rect(platform, platform.picture(), canvas, VideoMode::Actual),
+            WHOLE_TEXTURE,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn the_ps1_picture_is_the_whole_canvas() {
+    assert_eq!(Platform::Ps1.picture(), (640, 480));
+    assert_eq!(
+        slot::platform_video::picture(Platform::Ps1, 512),
+        (640, 480)
+    );
+}
+
+#[test]
+fn a_ps1_polaroid_keeps_the_whole_four_by_three_picture() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let thumb = d.path().join("2026-10-17_12-00-00.png");
+    let white = vec![0xffu8; 640 * 480 * 4];
+    let png = slot::thumb::png_sized(&white, 640, 480).expect("png");
+    std::fs::write(&thumb, png).expect("write thumb");
+    let face = slot_ui::photo_face(&StateEntry {
+        stamp: "2026-10-17_12-00-00".into(),
+        state: d.path().join("2026-10-17_12-00-00.state"),
+        thumb,
+    });
+    assert_eq!((face.w, face.h), (slot_ui::PHOTO_W, slot_ui::PHOTO_H));
+    let px = |x: usize, y: usize| &face.rgba[(y * 240 + x) * 4..(y * 240 + x) * 4 + 3];
+    for y in [0, 159] {
+        assert_eq!(px(12, y), [0, 0, 0], "row {y}");
+        assert_eq!(px(13, y), [0xff; 3], "row {y}");
+        assert_eq!(px(225, y), [0xff; 3], "row {y}");
+        assert_eq!(px(226, y), [0, 0, 0], "row {y}");
+    }
+}
