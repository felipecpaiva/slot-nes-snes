diff --git a/crates/slot-ui/src/battery_toast.rs b/crates/slot-ui/src/battery_toast.rs
new file mode 100644
index 0000000..312044f
--- /dev/null
+++ b/crates/slot-ui/src/battery_toast.rs
@@ -0,0 +1,35 @@
+use crate::Toast;
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum BatteryToast {
+    Low15,
+    Low10,
+}
+
+impl BatteryToast {
+    pub const ALL: [BatteryToast; 2] = [BatteryToast::Low15, BatteryToast::Low10];
+
+    pub fn level(self) -> u8 {
+        match self {
+            BatteryToast::Low15 => 15,
+            BatteryToast::Low10 => 10,
+        }
+    }
+
+    pub fn index(self) -> usize {
+        Self::ALL.iter().position(|t| *t == self).unwrap_or(0)
+    }
+
+    pub fn text(self) -> &'static str {
+        match self {
+            BatteryToast::Low15 => "Battery Low: 15%",
+            BatteryToast::Low10 => "Battery Low: 10%",
+        }
+    }
+}
+
+impl Toast {
+    pub fn battery_index(b: BatteryToast) -> usize {
+        Toast::all().len() + slot_store::RetroShader::ALL.len() + b.index()
+    }
+}
