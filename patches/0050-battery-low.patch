diff --git a/crates/slot/src/app/battery_warn.rs b/crates/slot/src/app/battery_warn.rs
new file mode 100644
index 0000000..b7a7f94
--- /dev/null
+++ b/crates/slot/src/app/battery_warn.rs
@@ -0,0 +1,31 @@
+use slot_power::{Battery, Charge};
+use slot_ui::{BatteryToast, Toast};
+
+use super::{App, Phase, BATTERY_CRITICAL};
+
+impl App {
+    pub(super) fn warn_battery(&mut self, b: Battery) {
+        if matches!(b.charge, Charge::Charging | Charge::Full) {
+            self.battery_warned = None;
+            return;
+        }
+        if b.percent <= BATTERY_CRITICAL
+            || self.shutting_down()
+            || matches!(self.phase, Phase::Doze { .. })
+        {
+            return;
+        }
+        let Some(due) = BatteryToast::ALL
+            .into_iter()
+            .rfind(|t| b.percent <= t.level())
+        else {
+            return;
+        };
+        if self.battery_warned.is_some_and(|w| w <= due.level()) {
+            return;
+        }
+        self.battery_warned = Some(due.level());
+        eprintln!("slot: battery: low at {}%", b.percent);
+        self.hud.toast(Toast::Battery(due), self.now());
+    }
+}
diff --git a/crates/slot/tests/battery_low.rs b/crates/slot/tests/battery_low.rs
new file mode 100644
index 0000000..b2867e6
--- /dev/null
+++ b/crates/slot/tests/battery_low.rs
@@ -0,0 +1,132 @@
+mod common;
+
+use common::{app_playing_in, tmp_root_with_carts};
+use slot::app::App;
+use slot_input::Action;
+use slot_power::{Battery, Charge};
+use slot_ui::{BatteryToast, Toast};
+
+fn draining(percent: u8) -> Battery {
+    Battery {
+        percent,
+        charge: Charge::Discharging,
+    }
+}
+
+fn charging(percent: u8) -> Battery {
+    Battery {
+        percent,
+        charge: Charge::Charging,
+    }
+}
+
+fn playing() -> (tempfile::TempDir, App) {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    let a = app_playing_in(d.path(), "Emerald");
+    (d, a)
+}
+
+fn later(a: &mut App, now: &mut u64) {
+    *now += 20_000;
+    a.tick_ms(*now);
+}
+
+#[test]
+fn the_battery_banners_upload_in_their_own_place() {
+    let every = Toast::every();
+    for b in BatteryToast::ALL {
+        let t = Toast::Battery(b);
+        assert_eq!(every.get(t.index()), Some(&t), "{b:?}");
+    }
+    assert_eq!(
+        Toast::Battery(BatteryToast::Low15).text(),
+        "Battery Low: 15%"
+    );
+    assert_eq!(
+        Toast::Battery(BatteryToast::Low10).text(),
+        "Battery Low: 10%"
+    );
+}
+
+#[test]
+fn fifteen_percent_warns_once() {
+    let (_d, mut a) = playing();
+    let mut now = 0;
+    a.on_battery(draining(16));
+    assert_eq!(a.toast(), None);
+    a.on_battery(draining(15));
+    assert_eq!(a.toast(), Some(Toast::Battery(BatteryToast::Low15)));
+    later(&mut a, &mut now);
+    a.on_battery(draining(14));
+    a.on_battery(draining(12));
+    assert_eq!(a.toast(), None, "the 15% banner came back");
+}
+
+#[test]
+fn ten_percent_warns_after_fifteen() {
+    let (_d, mut a) = playing();
+    let mut now = 0;
+    a.on_battery(draining(15));
+    later(&mut a, &mut now);
+    a.on_battery(draining(10));
+    assert_eq!(a.toast(), Some(Toast::Battery(BatteryToast::Low10)));
+    later(&mut a, &mut now);
+    a.on_battery(draining(8));
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn a_reading_past_both_levels_shows_only_the_lower_one() {
+    let (_d, mut a) = playing();
+    let mut now = 0;
+    a.on_battery(draining(9));
+    assert_eq!(a.toast(), Some(Toast::Battery(BatteryToast::Low10)));
+    later(&mut a, &mut now);
+    a.on_battery(draining(9));
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn charging_never_warns() {
+    let (_d, mut a) = playing();
+    a.on_battery(charging(12));
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn plugging_in_brings_the_banners_back() {
+    let (_d, mut a) = playing();
+    let mut now = 0;
+    a.on_battery(draining(12));
+    later(&mut a, &mut now);
+    a.on_battery(charging(13));
+    a.on_battery(draining(14));
+    assert_eq!(a.toast(), Some(Toast::Battery(BatteryToast::Low15)));
+}
+
+#[test]
+fn a_shut_lid_holds_the_banner_until_it_opens() {
+    let (_d, mut a) = playing();
+    a.apply(Action::LidClose);
+    a.on_battery(draining(14));
+    assert_eq!(a.toast(), None);
+    a.apply(Action::LidOpen);
+    a.on_battery(draining(14));
+    assert_eq!(a.toast(), Some(Toast::Battery(BatteryToast::Low15)));
+}
+
+#[test]
+fn the_power_off_level_shows_no_banner() {
+    let (_d, mut a) = playing();
+    a.on_battery(draining(4));
+    assert_eq!(a.toast(), None);
+    assert!(a.powering_off());
+}
+
+#[test]
+fn the_shelf_shows_the_banner_too() {
+    let d = tmp_root_with_carts(&["Emerald"]);
+    let mut a = common::boot(d.path());
+    a.on_battery(draining(15));
+    assert_eq!(a.toast(), Some(Toast::Battery(BatteryToast::Low15)));
+}
