+// Color Correction (Game Boy family) and Picture Next (the systems that flip the picture) start on
+// the same chord and never play together, so the shared chord is no clash (ADR 0109).
+fn never_together(a: QuickRow, b: QuickRow) -> bool {
+    matches!(
+        (a, b),
+        (QuickRow::ScColour, QuickRow::ScPictureNext)
+            | (QuickRow::ScPictureNext, QuickRow::ScColour)
+    )
+}
