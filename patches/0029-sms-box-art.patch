+#[test]
+fn game_gear_and_mega_drive_labels_still_fill_their_wells_from_the_top() {
+    let art = box_art("top", 456, 640);
+    for platform in [Platform::Gg, Platform::Md] {
+        let mut c = cart(platform, md("top.md", b"U"), None);
+        c.label = Some(art.clone());
+        let kind = retro_shell_of(&c).expect("a sega shell");
+        let (w, h) = cart_box(platform);
+        let (_, _, lw, lh) = retro_label_rect(kind);
+        let (lw, lh) = (
+            (lw * w as f32).round() as u32,
+            (lh * h as f32).round() as u32,
+        );
+        let label = label_cover(&c, &art, lw, lh).expect("label");
+        assert!(bounds(&label, lw, RED).is_some(), "{platform:?} top kept");
+        assert!(
+            bounds(&label, lw, BLUE).is_none() && bounds(&label, lw, YELLOW).is_none(),
+            "{platform:?} label is no longer cut from the top"
+        );
+    }
