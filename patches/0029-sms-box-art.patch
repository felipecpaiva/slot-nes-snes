+#[test]
+fn the_whole_master_system_box_front_lands_inside_the_well() {
+    let big = rom("box-big.sms", vec![0u8; 0x40000]);
+    let small = rom("box-small.sms", vec![0u8; 0x2000]);
+    for (kind, path) in [(SegaShell::Sms, big), (SegaShell::SegaCard, small)] {
+        for (name, aw, ah) in [("portrait", 456, 640), ("square", 400, 400)] {
+            let mut c = cart(Platform::Sms, path.clone(), None);
+            c.label = Some(box_art(name, aw, ah));
+            assert_eq!(retro_shell_of(&c), sega(kind));
+            let face = retro_cart_face(&c, RetroShell::Sega(kind));
+            let (wx, wy, ww, wh) = well_px(kind);
+            let corner = [(wx, wy), (wx + ww, wy), (wx, wy + wh), (wx + ww, wy + wh)];
+            let (fw, fh) = if aw * wh > ah * ww {
+                (ww, ww * ah / aw)
+            } else {
+                (wh * aw / ah, wh)
+            };
+            for (i, colour) in CORNERS.into_iter().enumerate() {
+                let (x0, y0, x1, y1, n) = bounds(&face.rgba, face.w, colour)
+                    .unwrap_or_else(|| panic!("{kind:?} {name} lost corner {i}"));
+                assert!(
+                    x0 >= wx && y0 >= wy && x1 <= wx + ww && y1 <= wy + wh,
+                    "{kind:?} {name} corner {i} leaves the well"
+                );
+                let (ex, ey) = corner[i];
+                let (gx, gy) = (
+                    if i % 2 == 0 { x0 } else { x1 },
+                    if i < 2 { y0 } else { y1 },
+                );
+                assert!(
+                    gx.abs_diff(ex) <= (ww - fw) / 2 + 2 && gy.abs_diff(ey) <= (wh - fh) / 2 + 2,
+                    "{kind:?} {name} corner {i} at {gx},{gy} is not at the well corner {ex},{ey}"
+                );
+                let want = fw * fh / 25;
+                assert!(
+                    n * 10 >= want * 8,
+                    "{kind:?} {name} corner {i} is cropped: {n} of {want} px"
+                );
+            }
+        }
+    }
+}
