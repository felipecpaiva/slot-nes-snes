     cover_rgba(top, sw, rows, w, h)
 }
+
+/// The whole Master System box front, scaled to fit inside the well and centred on the mean colour
+/// of the box's own outer edge, so no part of the box is cropped (ADR 0057).
+fn box_contain(src: &[u8], sw: u32, sh: u32, w: u32, h: u32) -> Option<Vec<u8>> {
+    if sw == 0 || sh == 0 || w == 0 || h == 0 {
+        return None;
+    }
+    let (fw, fh) = if sw as u64 * h as u64 > sh as u64 * w as u64 {
+        (
+            w,
+            ((sh as u64 * w as u64 + sw as u64 / 2) / sw as u64).clamp(1, h as u64) as u32,
+        )
+    } else {
+        (
+            ((sw as u64 * h as u64 + sh as u64 / 2) / sh as u64).clamp(1, w as u64) as u32,
+            h,
+        )
+    };
+    let fit = cover_rgba(src, sw, sh, fw, fh)?;
+    let edge: Vec<&[u8]> = fit
+        .chunks_exact(4)
+        .enumerate()
+        .filter(|(i, _)| {
+            let (x, y) = (*i as u32 % fw, *i as u32 / fw);
+            x == 0 || y == 0 || x + 1 == fw || y + 1 == fh
+        })
+        .map(|(_, p)| p)
+        .collect();
+    let n = edge.len().max(1) as u32;
+    let ground: [u8; 3] = std::array::from_fn(|c| {
+        ((edge.iter().map(|p| p[c] as u32).sum::<u32>() + n / 2) / n) as u8
+    });
+    let mut out = [ground[0], ground[1], ground[2], 255].repeat((w * h) as usize);
+    let (ox, oy) = ((w - fw) / 2, (h - fh) / 2);
+    for y in 0..fh {
+        let s = (y * fw * 4) as usize;
+        let d = (((y + oy) * w + ox) * 4) as usize;
+        out[d..d + (fw * 4) as usize].copy_from_slice(&fit[s..s + (fw * 4) as usize]);
+    }
+    Some(out)
+}
diff --git a/crates/slot-ui/tests/sega_shell.rs b/crates/slot-ui/tests/sega_shell.rs
index 0d99f8e..515b90e 100644
--- a/crates/slot-ui/tests/sega_shell.rs
+++ b/crates/slot-ui/tests/sega_shell.rs
@@ -2,8 +2,9 @@ use std::path::PathBuf;
 
 use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
 use slot_ui::{
-    cart_box, retro_shell_of, seated_box, shell_for, RetroShell, SegaShell, GENESIS_BLACK,
-    GG_BLACK, MEGA_DRIVE_BLACK, SEGA_CARD_BLACK, SMS_BLACK,
+    cart_box, label_cover, retro_cart_face, retro_label_rect, retro_shell_of, seated_box,
+    shell_for, RetroShell, SegaShell, GENESIS_BLACK, GG_BLACK, MEGA_DRIVE_BLACK, SEGA_CARD_BLACK,
+    SMS_BLACK,
 };
 
 fn cart(platform: Platform, rom: PathBuf, word: Option<Outline>) -> Cart {
@@ -137,3 +138,156 @@ fn the_sega_boxes_are_their_seated_boxes_scaled_to_the_shelf() {
         assert_eq!(ch, (cw * seated.1 + 120) / 240, "{platform:?}");
     }
 }
+
+const BOX_ASPECT: f32 = 0.713;
+const RED: [u8; 3] = [230, 30, 30];
+const GREEN: [u8; 3] = [30, 200, 30];
+const BLUE: [u8; 3] = [30, 60, 230];
+const YELLOW: [u8; 3] = [240, 220, 30];
+const CORNERS: [[u8; 3]; 4] = [RED, GREEN, BLUE, YELLOW];
+
+fn well_px(kind: SegaShell) -> (u32, u32, u32, u32) {
+    let (w, h) = cart_box(Platform::Sms);
+    let (x, y, lw, lh) = retro_label_rect(RetroShell::Sega(kind));
+    let at = |f: f32, of: u32| (f * of as f32).round() as u32;
+    (at(x, w), at(y, h), at(lw, w), at(lh, h))
+}
+
+fn box_art(name: &str, w: u32, h: u32) -> PathBuf {
+    let mut px = Vec::with_capacity((w * h * 4) as usize);
+    for y in 0..h {
+        for x in 0..w {
+            let (left, top) = (x < w / 5, y < h / 5);
+            let (right, bottom) = (x >= w - w / 5, y >= h - h / 5);
+            let c = match (left, top, right, bottom) {
+                (true, true, _, _) => RED,
+                (_, true, true, _) => GREEN,
+                (true, _, _, true) => BLUE,
+                (_, _, true, true) => YELLOW,
+                _ => [245, 245, 245],
+            };
+            px.extend_from_slice(&[c[0], c[1], c[2], 255]);
+        }
+    }
+    let p = std::env::temp_dir().join(format!("slot-sega-box-{}-{name}.png", std::process::id()));
+    let file = std::fs::File::create(&p).expect("create box art");
+    let mut e = png::Encoder::new(file, w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    p
+}
+
+fn near(p: &[u8], c: [u8; 3]) -> bool {
+    (0..3).all(|i| p[i].abs_diff(c[i]) < 12)
+}
+
+fn bounds(rgba: &[u8], w: u32, c: [u8; 3]) -> Option<(u32, u32, u32, u32, u32)> {
+    let hits: Vec<(u32, u32)> = rgba
+        .chunks_exact(4)
+        .enumerate()
+        .filter(|(_, p)| p[3] > 200 && near(p, c))
+        .map(|(i, _)| (i as u32 % w, i as u32 / w))
+        .collect();
+    let x0 = hits.iter().map(|p| p.0).min()?;
+    let y0 = hits.iter().map(|p| p.1).min()?;
+    let x1 = hits.iter().map(|p| p.0).max()? + 1;
+    let y1 = hits.iter().map(|p| p.1).max()? + 1;
+    Some((x0, y0, x1, y1, hits.len() as u32))
+}
+
+#[test]
+fn the_master_system_wells_are_portrait_at_the_box_art_aspect() {
+    for kind in [SegaShell::Sms, SegaShell::SegaCard] {
+        let (_, y, w, h) = well_px(kind);
+        let aspect = w as f32 / h as f32;
+        assert!(
+            (aspect - BOX_ASPECT).abs() < BOX_ASPECT * 0.01,
+            "{kind:?} well {w}x{h} is {aspect}, not {BOX_ASPECT}"
+        );
+        assert!(y >= 3, "{kind:?} well leaves no top lip");
+    }
+    let (_, ch) = cart_box(Platform::Sms);
+    let (_, _, _, sms_h) = well_px(SegaShell::Sms);
+    assert!(
+        sms_h * 100 >= ch * 85,
+        "the cartridge well spans the face height"
+    );
+    let (cx, cy, cw, chh) = well_px(SegaShell::SegaCard);
+    let (bw, _) = cart_box(Platform::Sms);
+    let card = (bw as f32 * 74.15 / 240.0, bw as f32 * 165.85 / 240.0);
+    assert!(cx as f32 > card.0 + 3.0 && ((cx + cw) as f32) < card.1 - 3.0);
+    let contacts = ch as f32 * 120.4 / 145.0;
+    assert!(
+        ((cy + chh + 3) as f32) <= contacts,
+        "the card well and its lip stop above the contacts"
+    );
+}
