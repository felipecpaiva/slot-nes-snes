diff --git a/crates/slot-store/src/ps1.rs b/crates/slot-store/src/ps1.rs
new file mode 100644
index 0000000..b3d675c
--- /dev/null
+++ b/crates/slot-store/src/ps1.rs
@@ -0,0 +1,322 @@
+use std::collections::{BTreeMap, HashSet};
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::{Component, Path, PathBuf};
+
+use crate::atomic::atomic_write;
+use crate::scan::{listing, Cart};
+use crate::Platform;
+
+pub const PLAYLISTS_DIR: &str = "Config/playlists/PS1";
+pub const MAX_DISCS: usize = 8;
+
+const SECTOR: u64 = 2048;
+const RAW_SECTOR: u64 = 2352;
+const PVD_SECTOR: u64 = 16;
+const SYNC: [u8; 12] = [
+    0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0,
+];
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum DiscRegion {
+    Us,
+    Eu,
+    Jp,
+}
+
+pub fn playlist(m3u: &Path) -> Option<Vec<PathBuf>> {
+    let bytes = std::fs::read(m3u)
+        .map_err(|e| eprintln!("slot: ps1: {}: {e}", m3u.display()))
+        .ok()?;
+    let base = m3u.parent().unwrap_or(Path::new(""));
+    Some(
+        String::from_utf8_lossy(&bytes)
+            .split('\n')
+            .map(|line| line.split('\r').next().unwrap_or(""))
+            .filter(|line| !line.is_empty() && !line.starts_with('#'))
+            .map(|line| disc_path(base, line))
+            .collect(),
+    )
+}
+
+fn disc_path(base: &Path, line: &str) -> PathBuf {
+    let b = line.as_bytes();
+    let absolute = matches!(b.first(), Some(b'/' | b'\\'))
+        || (b.get(1) == Some(&b':') && matches!(b.get(2), Some(b'/' | b'\\')));
+    if absolute {
+        PathBuf::from(line)
+    } else {
+        base.join(line)
+    }
+}
+
+pub fn playable_discs(m3u: &Path) -> Result<Vec<PathBuf>, String> {
+    let discs = playlist(m3u).ok_or_else(|| format!("{} is unreadable", m3u.display()))?;
+    if discs.is_empty() {
+        return Err(format!("{} names no disc", m3u.display()));
+    }
+    if discs.len() > MAX_DISCS {
+        return Err(format!(
+            "{} names {} discs, pcsx holds {MAX_DISCS}",
+            m3u.display(),
+            discs.len()
+        ));
+    }
+    match discs.iter().find(|d| !d.is_file()) {
+        Some(missing) => Err(format!(
+            "{} names {}, which is missing",
+            m3u.display(),
+            missing.display()
+        )),
+        None => Ok(discs),
+    }
+}
+
+pub fn disc_tag(stem: &str) -> Option<(String, u32)> {
+    let lower = stem.to_ascii_lowercase();
+    let mut from = 0;
+    while let Some(at) = lower.get(from..)?.find("(disc ") {
+        let open = from + at;
+        let digits = open + "(disc ".len();
+        let rest = lower.get(digits..)?;
+        let n_len = rest.bytes().take_while(u8::is_ascii_digit).count();
+        let after = rest.get(n_len..)?;
+        let close = if after.starts_with(')') {
+            Some(1)
+        } else {
+            after
+                .strip_prefix(" of ")
+                .map(|t| t.bytes().take_while(u8::is_ascii_digit).count())
+                .filter(|m| *m > 0)
+                .and_then(|m| after.get(4 + m..)?.starts_with(')').then_some(4 + m + 1))
+        };
+        if let (true, Some(close)) = (n_len > 0, close) {
+            let n = rest.get(..n_len)?.parse().ok()?;
+            let end = digits + n_len + close;
+            let base = format!("{} {}", stem.get(..open)?, stem.get(end..)?);
+            return Some((base.split_whitespace().collect::<Vec<_>>().join(" "), n));
+        }
+        from = open + 1;
+    }
+    None
+}
+
+pub fn title(stem: &str) -> Option<String> {
+    disc_tag(stem).map(|(base, _)| base)
+}
+
+fn same_file_key(p: &Path) -> String {
+    p.components()
+        .filter(|c| !matches!(c, Component::CurDir))
+        .collect::<PathBuf>()
+        .to_string_lossy()
+        .to_lowercase()
+}
+
+pub fn tidy(root: &Path, carts: &mut Vec<Cart>) {
+    let mut named = HashSet::new();
+    carts.retain(|c| {
+        if c.platform != Platform::Ps1 || !is_m3u(&c.rom) {
+            return true;
+        }
+        match playlist(&c.rom) {
+            Some(discs) => {
+                named.extend(discs.iter().map(|d| same_file_key(d)));
+                true
+            }
+            None => {
+                eprintln!("slot: ps1: skipping {}", c.rom.display());
+                false
+            }
+        }
+    });
+    carts.retain(|c| c.platform != Platform::Ps1 || !named.contains(&same_file_key(&c.rom)));
+
+    let mut groups: BTreeMap<String, Vec<(u32, usize)>> = BTreeMap::new();
+    for (i, c) in carts.iter().enumerate() {
+        if c.platform != Platform::Ps1 || is_m3u(&c.rom) {
+            continue;
+        }
+        if let Some((base, n)) = disc_tag(&c.stem) {
+            groups.entry(base).or_default().push((n, i));
+        }
+    }
+    let labels_dir = root.join("Labels").join(Platform::Ps1.dir_name());
+    let labels = listing(&labels_dir);
+    let mut gone = HashSet::new();
+    let mut grouped = Vec::new();
+    for (base, mut discs) in groups {
+        if discs.len() < 2 {
+            continue;
+        }
+        discs.sort();
+        let roms: Vec<&Path> = discs
+            .iter()
+            .filter_map(|(_, i)| carts.get(*i).map(|c| c.rom.as_path()))
+            .collect();
+        let Some(m3u) = write_playlist(root, &base, &roms) else {
+            continue;
+        };
+        let Some(first) = discs.first().and_then(|(_, i)| carts.get(*i)) else {
+            continue;
+        };
+        grouped.push(Cart {
+            platform: Platform::Ps1,
+            stem: base.clone(),
+            rom: m3u,
+            label: labels
+                .get(&format!("{base}.png").to_lowercase())
+                .map(|name| labels_dir.join(name))
+                .or_else(|| first.label.clone()),
+            title: String::new(),
+            code: String::new(),
+            shell: first.shell,
+        });
+        gone.extend(discs.iter().map(|(_, i)| *i));
+    }
+    *carts = std::mem::take(carts)
+        .into_iter()
+        .enumerate()
+        .filter(|(i, _)| !gone.contains(i))
+        .map(|(_, c)| c)
+        .chain(grouped)
+        .collect();
+}
+
+fn is_m3u(p: &Path) -> bool {
+    p.extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| e.eq_ignore_ascii_case("m3u"))
+}
+
+fn write_playlist(root: &Path, base: &str, discs: &[&Path]) -> Option<PathBuf> {
+    let path = root.join(PLAYLISTS_DIR).join(format!("{base}.m3u"));
+    let mut text = String::new();
+    for disc in discs {
+        let disc = std::path::absolute(disc).unwrap_or_else(|_| disc.to_path_buf());
+        text.push_str(&disc.to_string_lossy());
+        text.push('\n');
+    }
+    if std::fs::read(&path).ok().as_deref() == Some(text.as_bytes()) {
+        return Some(path);
+    }
+    let written = path
+        .parent()
+        .map_or(Ok(()), std::fs::create_dir_all)
+        .and_then(|_| atomic_write(&path, text.as_bytes()));
+    match written {
+        Ok(()) => Some(path),
+        Err(e) => {
+            eprintln!("slot: ps1: could not write {}: {e}", path.display());
+            None
+        }
+    }
+}
+
+pub fn serial(disc: &Path) -> Option<String> {
+    let ext = disc.extension()?.to_str()?.to_ascii_lowercase();
+    match ext.as_str() {
+        "m3u" => serial(playlist(disc)?.first()?),
+        "cue" => serial_of_track(&first_track(disc)?),
+        "bin" | "iso" | "img" => serial_of_track(disc),
+        _ => None,
+    }
+}
+
+pub fn serial_region(serial: &str) -> Option<DiscRegion> {
+    match serial.get(..4)?.to_ascii_uppercase().as_str() {
+        "SLUS" | "SCUS" => Some(DiscRegion::Us),
+        "SLES" | "SCES" => Some(DiscRegion::Eu),
+        "SLPS" | "SCPS" | "SLPM" => Some(DiscRegion::Jp),
+        _ => None,
+    }
+}
+
+fn first_track(cue: &Path) -> Option<PathBuf> {
+    let text = std::fs::read_to_string(cue).ok()?;
+    let line = text
+        .lines()
+        .map(str::trim)
+        .find(|l| l.get(..5).is_some_and(|k| k.eq_ignore_ascii_case("file ")))?;
+    let rest = line.get(5..)?.trim();
+    let name = match rest.strip_prefix('"') {
+        Some(quoted) => quoted.split('"').next()?,
+        None => rest.split_whitespace().next()?,
+    };
+    Some(cue.parent().unwrap_or(Path::new("")).join(name))
+}
+
+struct Track {
+    file: File,
+    raw: bool,
+}
+
+impl Track {
+    fn open(path: &Path) -> Option<Track> {
+        let mut file = File::open(path).ok()?;
+        let mut sync = [0u8; 12];
+        file.seek(SeekFrom::Start(PVD_SECTOR * RAW_SECTOR)).ok()?;
+        let raw = file.read_exact(&mut sync).is_ok() && sync == SYNC;
+        Some(Track { file, raw })
+    }
+
+    fn sector(&mut self, lba: u64) -> Option<[u8; SECTOR as usize]> {
+        let at = if self.raw {
+            let mut mode = [0u8; 1];
+            self.file
+                .seek(SeekFrom::Start(lba * RAW_SECTOR + 15))
+                .ok()?;
+            self.file.read_exact(&mut mode).ok()?;
+            lba * RAW_SECTOR + if mode[0] == 2 { 24 } else { 16 }
+        } else {
+            lba * SECTOR
+        };
+        let mut data = [0u8; SECTOR as usize];
+        self.file.seek(SeekFrom::Start(at)).ok()?;
+        self.file.read_exact(&mut data).ok()?;
+        Some(data)
+    }
+}
+
+fn le32(b: &[u8], at: usize) -> Option<u32> {
+    Some(u32::from_le_bytes(b.get(at..at + 4)?.try_into().ok()?))
+}
+
+fn serial_of_track(path: &Path) -> Option<String> {
+    let mut track = Track::open(path)?;
+    let pvd = track.sector(PVD_SECTOR)?;
+    if pvd.get(1..6)? != b"CD001" {
+        return None;
+    }
+    let root = pvd.get(156..)?;
+    let (lba, size) = (le32(root, 2)?, le32(root, 10)?);
+    let mut cnf = None;
+    for n in 0..u64::from(size.div_ceil(SECTOR as u32).min(4)) {
+        let dir = track.sector(u64::from(lba) + n)?;
+        let mut at = 0;
+        while let Some(&len) = dir.get(at) {
+            if len == 0 {
+                break;
+            }
+            let rec = dir.get(at..at + usize::from(len))?;
+            let name_len = usize::from(*rec.get(32)?);
+            let name = rec.get(33..33 + name_len)?;
+            if name.split(|b| *b == b';').next() == Some(b"SYSTEM.CNF") {
+                cnf = Some(le32(rec, 2)?);
+            }
+            at += usize::from(len);
+        }
+    }
+    let text = track.sector(u64::from(cnf?))?;
+    let text = String::from_utf8_lossy(&text);
+    let boot = text
+        .lines()
+        .find(|l| l.trim_start().to_ascii_uppercase().starts_with("BOOT"))?;
+    let file = boot
+        .rsplit(['\\', ':', '/'])
+        .next()?
+        .split(';')
+        .next()?
+        .trim();
+    (file.len() >= 4 && serial_region(file).is_some()).then(|| file.to_string())
+}
