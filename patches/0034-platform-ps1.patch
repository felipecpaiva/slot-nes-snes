@@ -0,0 +1,221 @@
+use std::path::{Path, PathBuf};
+
+use slot_store::ps1::{disc_tag, playable_discs, playlist, title, PLAYLISTS_DIR};
+use slot_store::{scan, Cart, Platform};
+
+fn card() -> (tempfile::TempDir, PathBuf) {
+    let d = tempfile::tempdir().expect("tempdir");
+    let dir = d.path().join("Games/PS1");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    (d, dir)
+}
+
+fn put(dir: &Path, name: &str, body: &str) -> PathBuf {
+    let p = dir.join(name);
+    std::fs::write(&p, body).expect("write");
+    p
+}
+
+fn cue_and_bin(dir: &Path, stem: &str) -> PathBuf {
+    put(dir, &format!("{stem}.bin"), "");
+    put(
+        dir,
+        &format!("{stem}.cue"),
+        &format!("FILE \"{stem}.bin\" BINARY\n  TRACK 01 MODE2/2352\n    INDEX 01 00:00:00\n"),
+    )
+}
+
+fn ps1(root: &Path) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == Platform::Ps1)
+        .collect()
+}
+
+fn stems(carts: &[Cart]) -> Vec<&str> {
+    carts.iter().map(|c| c.stem.as_str()).collect()
+}
+
+#[test]
+fn a_cue_is_the_game_and_its_bin_is_hidden() {
+    let (d, dir) = card();
+    let cue = cue_and_bin(&dir, "Vagrant Story (USA)");
+    let carts = ps1(d.path());
+    assert_eq!(stems(&carts), ["Vagrant Story (USA)"]);
+    assert_eq!(carts[0].rom, cue);
+}
+
+#[test]
+fn a_bin_alone_is_not_a_game() {
+    let (d, dir) = card();
+    put(&dir, "Lone.bin", "");
+    put(&dir, "Lone.iso", "");
+    assert!(ps1(d.path()).is_empty());
+}
+
+#[test]
+fn chd_pbp_and_m3u_are_games_and_mac_resource_files_are_not() {
+    let (d, dir) = card();
+    put(&dir, "A.chd", "");
+    put(&dir, "B.PBP", "");
+    put(&dir, "C.m3u", "");
+    put(&dir, "._A.chd", "");
+    assert_eq!(stems(&ps1(d.path())), ["A", "B", "C"]);
+}
+
+#[test]
+fn an_m3u_hides_the_discs_it_names() {
+    let (d, dir) = card();
+    cue_and_bin(&dir, "Parasite Eve (USA) (Disc 1)");
+    put(&dir, "Parasite Eve (USA) (Disc 2).chd", "");
+    let m3u = put(
+        &dir,
+        "Parasite Eve (USA).m3u",
+        "#EXTM3U\r\nParasite Eve (USA) (Disc 1).cue\r\n./Parasite Eve (USA) (Disc 2).chd\r\n",
+    );
+    let carts = ps1(d.path());
+    assert_eq!(stems(&carts), ["Parasite Eve (USA)"]);
+    assert_eq!(carts[0].rom, m3u);
+}
+
+#[test]
+fn m3u_lines_keep_their_spaces_like_pcsx_reads_them() {
+    let (_d, dir) = card();
+    let inner = cue_and_bin(&dir, "Final Fantasy VII (Disc 1)");
+    let m3u = put(
+        &dir,
+        "FF7.m3u",
+        "Final Fantasy VII (Disc 1).cue\nFinal Fantasy VII (Disc 1).cue \n",
+    );
+    let discs = playlist(&m3u).expect("readable");
+    assert_eq!(discs[0], inner);
+    assert_eq!(discs[1], dir.join("Final Fantasy VII (Disc 1).cue "));
+    assert!(
+        playable_discs(&m3u).is_err(),
+        "a trailing space names no file"
+    );
+}
+
+#[test]
+fn an_m3u_that_names_a_missing_disc_is_listed_and_refused_at_load() {
+    let (d, dir) = card();
+    cue_and_bin(&dir, "Here");
+    let m3u = put(&dir, "Two.m3u", "Here.cue\nGone.cue\n");
+    assert_eq!(stems(&ps1(d.path())), ["Two"]);
+    let err = playable_discs(&m3u).expect_err("a missing disc");
+    assert!(err.contains("Gone.cue"), "{err}");
+}
+
+#[test]
+fn an_m3u_over_eight_discs_is_refused_at_load() {
+    let (_d, dir) = card();
+    let mut lines = String::new();
+    for n in 1..=9 {
+        cue_and_bin(&dir, &format!("D{n}"));
+        lines.push_str(&format!("D{n}.cue\n"));
+    }
+    let m3u = put(&dir, "Nine.m3u", &lines);
+    let err = playable_discs(&m3u).expect_err("nine discs");
+    assert!(err.contains("9 discs"), "{err}");
+    let eight = put(&dir, "Eight.m3u", &lines[..lines.rfind("D9").expect("D9")]);
+    assert_eq!(playable_discs(&eight).expect("eight discs").len(), 8);
+}
+
+#[test]
+#[cfg(unix)]
+fn an_unreadable_m3u_is_skipped_and_its_discs_stay_listed() {
+    use std::os::unix::fs::PermissionsExt;
+    let (d, dir) = card();
+    cue_and_bin(&dir, "Disc");
+    let m3u = put(&dir, "Locked.m3u", "Disc.cue\n");
+    std::fs::set_permissions(&m3u, std::fs::Permissions::from_mode(0o000)).expect("chmod");
+    if std::fs::read(&m3u).is_ok() {
+        eprintln!("skipping: this user reads mode 000 files");
+        return;
+    }
+    assert_eq!(stems(&ps1(d.path())), ["Disc"]);
+}
+
+#[test]
+fn disc_n_files_without_a_playlist_become_one_game_with_a_generated_m3u() {
+    let (d, dir) = card();
+    let two = cue_and_bin(&dir, "Metal Gear Solid (USA) (Disc 2)");
+    let one = cue_and_bin(&dir, "Metal Gear Solid (USA) (Disc 1)");
+    let carts = ps1(d.path());
+    assert_eq!(stems(&carts), ["Metal Gear Solid (USA)"]);
+    let m3u = d
+        .path()
+        .join(PLAYLISTS_DIR)
+        .join("Metal Gear Solid (USA).m3u");
+    assert_eq!(carts[0].rom, m3u);
+    let abs = |p: &Path| std::path::absolute(p).expect("absolute");
+    assert_eq!(
+        std::fs::read_to_string(&m3u).expect("generated"),
+        format!("{}\n{}\n", abs(&one).display(), abs(&two).display())
+    );
+    assert_eq!(
+        playable_discs(&m3u).expect("playable"),
+        [abs(&one), abs(&two)]
+    );
+}
+
+#[test]
+fn disc_n_of_m_tags_group_too_and_a_lone_disc_stays_itself() {
+    let (d, dir) = card();
+    put(&dir, "Legend of Dragoon (Disc 1 of 2).chd", "");
+    put(&dir, "Legend of Dragoon (Disc 2 of 2).chd", "");
+    put(&dir, "Demo (Disc 1).chd", "");
+    let carts = ps1(d.path());
+    assert_eq!(stems(&carts), ["Demo (Disc 1)", "Legend of Dragoon"]);
+}
+
+#[test]
+fn a_generated_playlist_is_left_alone_when_it_has_not_changed() {
+    let (d, dir) = card();
+    put(&dir, "G (Disc 1).chd", "");
+    put(&dir, "G (Disc 2).chd", "");
+    ps1(d.path());
+    let m3u = d.path().join(PLAYLISTS_DIR).join("G.m3u");
+    let before = std::fs::metadata(&m3u)
+        .and_then(|m| m.modified())
+        .expect("mtime");
+    std::thread::sleep(std::time::Duration::from_millis(20));
+    ps1(d.path());
+    let after = std::fs::metadata(&m3u)
+        .and_then(|m| m.modified())
+        .expect("mtime");
+    assert_eq!(before, after);
+}
+
+#[test]
+fn a_user_playlist_wins_over_disc_n_grouping() {
+    let (d, dir) = card();
+    put(&dir, "Chrono Cross (USA) (Disc 1).chd", "");
+    put(&dir, "Chrono Cross (USA) (Disc 2).chd", "");
+    put(
+        &dir,
+        "Chrono Cross.m3u",
+        "Chrono Cross (USA) (Disc 1).chd\nChrono Cross (USA) (Disc 2).chd\n",
+    );
+    assert_eq!(stems(&ps1(d.path())), ["Chrono Cross"]);
+    assert!(!d.path().join(PLAYLISTS_DIR).exists());
+}
+
+#[test]
+fn the_title_drops_the_disc_tag_and_nothing_else() {
+    assert_eq!(
+        disc_tag("Final Fantasy VIII (Europe) (Disc 3) (En,Fr)"),
+        Some(("Final Fantasy VIII (Europe) (En,Fr)".to_string(), 3))
+    );
+    assert_eq!(disc_tag("X (disc 2 of 4)"), Some(("X".to_string(), 2)));
+    assert_eq!(disc_tag("Discworld (USA)"), None);
+    assert_eq!(disc_tag("X (Disc )"), None);
+    assert_eq!(disc_tag("X (Disc 1 of )"), None);
+    assert_eq!(title("Demo (Disc 1)").as_deref(), Some("Demo"));
+    let (d, dir) = card();
+    put(&dir, "Demo (Disc 1).chd", "");
+    let mut carts = ps1(d.path());
+    carts[0].read_header();
+    assert_eq!(carts[0].title, "Demo");
+}
