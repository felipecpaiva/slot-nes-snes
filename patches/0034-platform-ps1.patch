new file mode 100644
index 0000000..2d92095
--- /dev/null
+++ b/crates/slot/tests/ps1_seat.rs
@@ -0,0 +1,75 @@
+mod common;
+mod core_common;
+mod ps1_common;
+mod real_seat;
+
+use std::path::Path;
+
+use common::core_lock;
+use ps1_common::{disc, pcsx_rearmed, red, RED_H, RED_W};
+use slot::app::Phase;
+use slot::session::Session;
+use slot_input::{Btn, RawEvent};
+use slot_store::{Core, Platform};
+
+const STEM: &str = "Ape Escape";
+const PCSX_STATE_BYTES: u64 = 0x44_0000;
+
+fn seated(dylib: &Path) -> tempfile::TempDir {
+    let discs = tempfile::tempdir().expect("tempdir");
+    let cue = disc(discs.path(), STEM);
+    let root = real_seat::rooted(Platform::Ps1, STEM, &cue, dylib);
+    std::fs::copy(
+        discs.path().join(format!("{STEM}.bin")),
+        root.path().join("Games/PS1").join(format!("{STEM}.bin")),
+    )
+    .expect("copy bin");
+    disc(&root.path().join("Games/PS1"), "Zzz");
+    root
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+fn resume_bytes(root: &Path) -> Option<u64> {
+    let dir = root.join("States/PS1/pcsx_rearmed").join(STEM);
+    std::fs::read_dir(dir)
+        .ok()?
+        .filter_map(|e| e.ok()?.metadata().ok())
+        .map(|m| m.len())
+        .max()
+}
+
+#[test]
+fn a_ps1_disc_plays_a_whole_session_on_its_640_by_480_canvas_and_saves_on_eject() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let mut session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::PcsxRearmed);
+    assert_eq!(session.app().playing_platform(), Platform::Ps1);
+    let emu = session.emu().expect("no core in the slot");
+    let frame = emu.latest_frame().expect("nothing was published");
+    assert_eq!(frame.len(), 640 * 480 * 4);
+    assert_eq!(red(&frame), RED_W * RED_H);
+    drop(frame);
+    eject(&mut session);
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+    while resume_bytes(root.path()).is_none_or(|n| n < PCSX_STATE_BYTES) {
+        assert!(
+            std::time::Instant::now() < deadline,
+            "no resume state on eject"
+        );
+        session.update(1.0 / 60.0);
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+}
