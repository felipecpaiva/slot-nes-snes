diff --git a/crates/slot/tests/ps1_common/mod.rs b/crates/slot/tests/ps1_common/mod.rs
new file mode 100644
index 0000000..cf79739
--- /dev/null
+++ b/crates/slot/tests/ps1_common/mod.rs
@@ -0,0 +1,137 @@
+#![allow(dead_code)]
+
+use std::path::{Path, PathBuf};
+
+pub const SECTORS: usize = 64;
+pub const RED_W: usize = 320;
+pub const RED_H: usize = 240;
+
+pub fn pcsx_rearmed() -> Option<PathBuf> {
+    crate::core_common::require_core("pcsx_rearmed")
+}
+
+pub fn executable() -> Vec<u8> {
+    let mut exe = vec![0; 6144];
+    exe[..8].copy_from_slice(b"PS-X EXE");
+    for (offset, value) in [
+        (0x10, 0x8001_0000u32),
+        (0x18, 0x8001_0000),
+        (0x1c, 4096),
+        (0x30, 0x801f_fff0),
+    ] {
+        exe[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+    }
+    let mut code = vec![0x3c08_1f80u32, 0x3508_1810];
+    for (value, port) in [
+        (0, 4),
+        (0x0300_0000, 4),
+        (0x0800_0001, 4),
+        (0x06c6_0260, 4),
+        (0x0704_2018, 4),
+        (0xe100_0000, 0),
+        (0xe300_0000, 0),
+        (0xe403_bd3f, 0),
+        (0xe500_0000, 0),
+        (0x0200_00ff, 0),
+        (0, 0),
+        (0x00f0_0140, 0),
+    ] {
+        code.extend([
+            0x3c09_0000 | (value >> 16),
+            0x3529_0000 | (value & 0xffff),
+            0xad09_0000 | port,
+        ]);
+    }
+    let pc = 0x8001_0000 + code.len() as u32 * 4;
+    code.extend([0x0800_0000 | ((pc >> 2) & 0x03ff_ffff), 0]);
+    for (i, word) in code.iter().enumerate() {
+        exe[2048 + i * 4..2052 + i * 4].copy_from_slice(&word.to_le_bytes());
+    }
+    exe
+}
+
+fn directory(name: &[u8], sector: u32, size: u32, is_dir: bool) -> Vec<u8> {
+    let len = (33 + name.len() + 1) & !1;
+    let mut rec = vec![0; len];
+    rec[0] = len as u8;
+    rec[2..6].copy_from_slice(&sector.to_le_bytes());
+    rec[6..10].copy_from_slice(&sector.to_be_bytes());
+    rec[10..14].copy_from_slice(&size.to_le_bytes());
+    rec[14..18].copy_from_slice(&size.to_be_bytes());
+    rec[25] = if is_dir { 2 } else { 0 };
+    rec[28] = 1;
+    rec[31] = 1;
+    rec[32] = name.len() as u8;
+    rec[33..33 + name.len()].copy_from_slice(name);
+    rec
+}
+
+pub fn iso(boot: &str) -> Vec<u8> {
+    let exe = executable();
+    let cnf = format!("BOOT = cdrom:\\{boot};1\r\nTCB = 4\r\nEVENT = 10\r\nSTACK = 801ffff0\r\n");
+    let mut iso = vec![0; SECTORS * 2048];
+    let pvd = &mut iso[16 * 2048..17 * 2048];
+    pvd[0] = 1;
+    pvd[1..6].copy_from_slice(b"CD001");
+    pvd[6] = 1;
+    pvd[40..72].fill(b' ');
+    pvd[40..49].copy_from_slice(b"SLOT_TEST");
+    pvd[80..84].copy_from_slice(&(SECTORS as u32).to_le_bytes());
+    pvd[84..88].copy_from_slice(&(SECTORS as u32).to_be_bytes());
+    pvd[128..130].copy_from_slice(&2048u16.to_le_bytes());
+    pvd[130..132].copy_from_slice(&2048u16.to_be_bytes());
+    let root_rec = directory(&[0], 20, 2048, true);
+    pvd[156..156 + root_rec.len()].copy_from_slice(&root_rec);
+    let mut at = 20 * 2048;
+    for rec in [
+        root_rec,
+        directory(&[1], 20, 2048, true),
+        directory(b"SYSTEM.CNF;1", 21, cnf.len() as u32, false),
+        directory(format!("{boot};1").as_bytes(), 22, exe.len() as u32, false),
+    ] {
+        iso[at..at + rec.len()].copy_from_slice(&rec);
+        at += rec.len();
+    }
+    iso[21 * 2048..21 * 2048 + cnf.len()].copy_from_slice(cnf.as_bytes());
+    iso[22 * 2048..22 * 2048 + exe.len()].copy_from_slice(&exe);
+    iso
+}
+
+pub fn raw(iso: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(iso.len() / 2048 * 2352);
+    for (lba, sector) in iso.chunks(2048).enumerate() {
+        let at = lba + 150;
+        let bcd = |v: usize| (((v / 10) << 4) | (v % 10)) as u8;
+        out.extend([
+            0, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0,
+        ]);
+        out.extend([bcd(at / 4500), bcd(at / 75 % 60), bcd(at % 75), 2]);
+        out.extend([0u8; 8]);
+        out.extend(sector);
+        out.extend([0u8; 280]);
+    }
+    out
+}
+
+pub fn disc(dir: &Path, stem: &str) -> PathBuf {
+    disc_booting(dir, stem, "PSX.EXE")
+}
+
+pub fn disc_booting(dir: &Path, stem: &str, boot: &str) -> PathBuf {
+    std::fs::create_dir_all(dir).expect("disc dir");
+    std::fs::write(dir.join(format!("{stem}.bin")), iso(boot)).expect("write bin");
+    let cue = dir.join(format!("{stem}.cue"));
+    std::fs::write(
+        &cue,
+        format!("FILE \"{stem}.bin\" BINARY\n  TRACK 01 MODE1/2048\n    INDEX 01 00:00:00\n"),
+    )
+    .expect("write cue");
+    cue
+}
+
+pub fn red(video: &[u8]) -> usize {
+    video
+        .chunks_exact(4)
+        .filter(|p| p[2] > 200 && p[1] < 10 && p[0] < 10)
+        .count()
+}
diff --git a/crates/slot/tests/ps1_emu.rs b/crates/slot/tests/ps1_emu.rs
