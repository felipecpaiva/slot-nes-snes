+use slot::app::App;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::video_mode::VideoMode;
+use slot_input::{Action, Btn};
+use slot_store::{Platform, Shader, PS1_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_a_disc() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(root.path().join("Games/PS1/Spyro.chd"), [0u8; 16]).expect("write disc");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_playstation(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenPs1.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenPs1));
+    press(app, Btn::A);
+}
+
+#[test]
+fn playstation_closes_the_screen_list_and_opens_its_own_section() {
+    assert_eq!(QuickRow::SCREEN.last(), Some(&QuickRow::ScreenPs1));
+    assert_eq!(QuickRow::ScreenPs1.label(), "PlayStation");
+    assert!(QuickRow::ScreenPs1.opens());
+    assert_eq!(QuickRow::ScreenPs1.child(), Some(QuickRow::Ps1Shader));
+    assert_eq!(
+        QuickRow::SCREEN_PS1,
+        [QuickRow::Ps1Shader, QuickRow::Ps1Picture]
+    );
+    for row in QuickRow::SCREEN_PS1 {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenPs1));
+    }
+    assert!(!QuickRow::PLAY_SCREEN.contains(&QuickRow::Ps1Shader));
+}
+
+#[test]
+fn the_playstation_row_shows_only_on_a_card_with_playstation_games() {
+    let (_root, mut app) = card_with_a_disc();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenPs1));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    let app_without = boot(root.path());
+    assert!(app_without.hidden_rows().contains(&QuickRow::ScreenPs1));
+    open_playstation(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::Ps1Shader));
+}
+
+#[test]
+fn the_playstation_picture_starts_actual_and_offers_stretch_but_no_crop() {
+    assert_eq!(default_video_mode(Platform::Ps1), VideoMode::Actual);
+    assert_eq!(
+        picture_choices(Platform::Ps1),
+        [VideoMode::Stretch, VideoMode::Actual]
+    );
+    let (root, mut app) = card_with_a_disc();
+    open_playstation(&mut app);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::Ps1Picture));
+    assert_eq!(
+        app.quick_value(QuickRow::Ps1Picture),
+        Some(QuickValue::Actual)
+    );
+    for want in [VideoMode::Stretch, VideoMode::Actual, VideoMode::Stretch] {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        assert_eq!(
+            app.quick_value(QuickRow::Ps1Picture),
+            Some(want.quick_value())
+        );
+        assert_eq!(system_picture(root.path(), Platform::Ps1), want);
+    }
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "ps1 = stretch\n"
+    );
+}
+
+#[test]
+fn the_playstation_shader_walks_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_disc();
+    let state = std::fs::read(root.path().join("Config/slot.state")).ok();
+    open_playstation(&mut app);
+    assert_eq!(app.quick_value(QuickRow::Ps1Shader), Some(QuickValue::Off));
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(slot_store::read_sega_shaders(root.path()).ps1);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(PS1_SHADER_FILE).exists());
+    assert!(!root.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(
+        std::fs::read(root.path().join("Config/slot.state")).ok(),
+        state
+    );
+}
