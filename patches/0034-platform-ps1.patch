@@ -0,0 +1,103 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, write_sega_shaders, write_slot_state, Core, Platform,
+    RetroShader, SegaShaders, Shader, SlotState, PS1_SHADER_FILE,
+};
+
+#[test]
+fn playstation_is_the_last_shelf_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES[8], Platform::Ps1);
+    assert_eq!(Platform::SHELVES.len(), 9);
+    assert_eq!(Platform::ALL.len(), 3);
+}
+
+#[test]
+fn playstation_has_its_own_name_folder_extensions_and_picture() {
+    assert_eq!(Platform::Ps1.name(), "Sony PlayStation");
+    assert_eq!(Platform::Ps1.dir_name(), "PS1");
+    for name in ["x.cue", "x.chd", "x.pbp", "x.m3u", "X.CUE"] {
+        assert!(Platform::Ps1.accepts(Path::new(name)), "{name}");
+    }
+    for name in ["x.bin", "x.iso", "x.img", "x.exe"] {
+        assert!(!Platform::Ps1.accepts(Path::new(name)), "{name}");
+    }
+    assert_eq!(Platform::Ps1.picture(), (640, 480));
+}
+
+#[test]
+fn playstation_hands_the_game_every_button_and_offers_no_crop() {
+    assert!(!Platform::Ps1.owns_shoulders());
+    assert!(Platform::Ps1.passes_xy_through());
+    assert!(Platform::Ps1.select_x_toggles_picture());
+    assert!(!Platform::Ps1.stretch_crops_height());
+    assert!(!Platform::Ps1.follows_frame_width());
+    assert!(!Platform::Ps1.has_gb_palettes());
+    assert_eq!(Platform::Ps1.overscan(), (0, 0));
+    assert_eq!(Platform::Ps1.picker_cores(), None);
+    assert_eq!(Platform::Ps1.shader_choices(), &Shader::RETRO);
+}
+
+#[test]
+fn playstation_runs_on_pcsx_rearmed_alone_on_a_640_by_480_canvas() {
+    assert_eq!(Core::default_for(Platform::Ps1), Core::PcsxRearmed);
+    assert_eq!(Core::EVERY[7], Core::PcsxRearmed);
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Ps1),
+            core == Core::PcsxRearmed,
+            "{core:?}"
+        );
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::PcsxRearmed.runs(platform),
+            platform == Platform::Ps1,
+            "{platform:?}"
+        );
+    }
+    assert_eq!(Core::PcsxRearmed.canvas(Platform::Ps1), (640, 480));
+    assert_eq!(
+        Core::PcsxRearmed.pair(),
+        (Core::PcsxRearmed, Core::PcsxRearmed)
+    );
+    assert_eq!(Core::PcsxRearmed.option_prefix(), "pcsx_rearmed");
+    assert_eq!(Core::parse("pcsx_rearmed"), Some(Core::PcsxRearmed));
+    assert!(!Core::PcsxRearmed.has_colour_correction());
+}
+
+#[test]
+fn a_playstation_game_resumes_as_a_playstation_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Spyro the Dragon (USA)".into()),
+        cart_platform: Some(Platform::Ps1),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=ps1"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn the_playstation_shader_lives_in_its_own_file_and_leaves_the_sega_file_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        ps1: Shader::Retro(RetroShader::CrtPi),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(PS1_SHADER_FILE)).expect("read"),
+        "ps1=crt-pi\n"
+    );
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+    std::fs::write(d.path().join("Config").join(PS1_SHADER_FILE), "ps1=lcd3x\n").expect("write");
+    assert_eq!(read_sega_shaders(d.path()).ps1, Shader::Off);
+}
