@@ -0,0 +1,144 @@
+mod common;
+mod core_common;
+mod ps1_common;
+
+use std::path::{Path, PathBuf};
+
+use common::core_lock;
+use ps1_common::{disc, disc_booting, pcsx_rearmed, raw, red, RED_H, RED_W};
+use slot::core::open_core_for_palette;
+use slot_retro::{ButtonMask, RetroCore};
+use slot_store::ps1::{serial, serial_region, DiscRegion};
+use slot_store::{Core, Platform};
+
+const PCSX_STATE_BYTES: usize = 0x44_0000;
+
+fn opened(dylib: PathBuf, root: &Path) -> Box<dyn RetroCore> {
+    let mut core = open_core_for_palette(
+        root,
+        Core::PcsxRearmed,
+        Platform::Ps1,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.set_option("pcsx_rearmed_bios", "HLE");
+    core
+}
+
+fn run(core: &mut dyn RetroCore, frames: usize) {
+    for _ in 0..frames {
+        core.run_frame(ButtonMask::default());
+    }
+}
+
+fn red_box_at_the_centre(video: &[u8]) {
+    let (x0, y0) = ((640 - RED_W) / 2, (480 - RED_H) / 2);
+    for (y, x) in [(y0, x0), (y0 + RED_H - 1, x0 + RED_W - 1)] {
+        let at = (y * 640 + x) * 4;
+        assert!(video[at + 2] > 200 && video[at] < 10, "({x}, {y})");
+    }
+    assert_eq!(red(video), RED_W * RED_H);
+}
+
+#[test]
+fn a_generated_disc_boots_on_pcsx_with_hle_and_draws_on_the_640_by_480_canvas() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let cue = disc(&d.path().join("Games/PS1"), "Red");
+    let mut core = opened(dylib, d.path());
+    core.load(&cue).expect("pcsx refused the generated disc");
+    run(core.as_mut(), 30);
+    assert_eq!(core.canvas(), (640, 480));
+    assert_eq!(core.frame_width(), RED_W as u32);
+    red_box_at_the_centre(core.video_xrgb8888());
+}
+
+#[test]
+fn a_two_disc_playlist_loads_through_the_ps1_guard_and_plays_disc_one() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let dir = d.path().join("Games/PS1");
+    disc(&dir, "Game (Disc 1)");
+    disc(&dir, "Game (Disc 2)");
+    let m3u = dir.join("Game.m3u");
+    std::fs::write(&m3u, "Game (Disc 1).cue\nGame (Disc 2).cue\n").expect("write m3u");
+    let mut core = opened(dylib, d.path());
+    slot::ps1_load::load(core.as_mut(), &m3u).expect("the playlist was refused");
+    run(core.as_mut(), 30);
+    red_box_at_the_centre(core.video_xrgb8888());
+}
+
+#[test]
+fn a_playlist_the_guard_refuses_never_reaches_the_core() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let dir = d.path().join("Games/PS1");
+    disc(&dir, "Only");
+    let missing = dir.join("Missing.m3u");
+    std::fs::write(&missing, "Only.cue\nNot There.cue\n").expect("write m3u");
+    let nine = dir.join("Nine.m3u");
+    std::fs::write(&nine, "Only.cue\n".repeat(9)).expect("write m3u");
+    for m3u in [missing, nine] {
+        let mut core = opened(dylib.clone(), d.path());
+        let err = slot::ps1_load::load(core.as_mut(), &m3u).expect_err("refused");
+        assert!(err.to_string().contains(&*m3u.to_string_lossy()), "{err}");
+        run(core.as_mut(), 2);
+        assert_eq!(red(core.video_xrgb8888()), 0, "{}", m3u.display());
+    }
+}
+
+#[test]
+fn a_ps1_state_is_the_cores_fixed_size_and_comes_back() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let cue = disc(&d.path().join("Games/PS1"), "State");
+    let mut core = opened(dylib, d.path());
+    core.load(&cue).expect("load");
+    run(core.as_mut(), 20);
+    let state = core.serialize().expect("serialize");
+    assert_eq!(state.len(), PCSX_STATE_BYTES);
+    run(core.as_mut(), 5);
+    core.unserialize(&state).expect("unserialize");
+    run(core.as_mut(), 2);
+    red_box_at_the_centre(core.video_xrgb8888());
+}
+
+#[test]
+fn the_disc_serial_and_region_are_read_from_system_cnf() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let cue = disc_booting(d.path(), "Cooked", "SLUS_007.08");
+    assert_eq!(serial(&cue).as_deref(), Some("SLUS_007.08"));
+    assert_eq!(serial_region("SLUS_007.08"), Some(DiscRegion::Us));
+    let bin = d.path().join("Raw.bin");
+    std::fs::write(&bin, raw(&ps1_common::iso("SLES_012.34"))).expect("write raw");
+    assert_eq!(serial(&bin).as_deref(), Some("SLES_012.34"));
+    let m3u = d.path().join("Pal.m3u");
+    std::fs::write(&m3u, "Raw.bin\n").expect("write m3u");
+    assert_eq!(serial(&m3u).as_deref(), Some("SLES_012.34"));
+    for (s, want) in [
+        ("SCUS_944.26", DiscRegion::Us),
+        ("SCES_000.01", DiscRegion::Eu),
+        ("SLPS_000.01", DiscRegion::Jp),
+        ("SCPS_100.01", DiscRegion::Jp),
+        ("SLPM_860.01", DiscRegion::Jp),
+    ] {
+        assert_eq!(serial_region(s), Some(want), "{s}");
+    }
+    assert_eq!(serial_region("PSX.EXE"), None);
+    assert_eq!(serial(&disc(d.path(), "Homebrew")), None);
+    assert_eq!(serial(&d.path().join("Nothing.chd")), None);
+}
