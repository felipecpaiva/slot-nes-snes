@@ -0,0 +1,122 @@
+mod common;
+
+use std::path::Path;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::cpu_governor::{apply, set_governor, CpuMode, CPU_FILE};
+use slot_input::{Action, Btn};
+use slot_ui::{QuickRow, QuickValue};
+
+const OFFERED: &str = "ondemand userspace powersave interactive performance schedutil\n";
+
+fn sysfs(policies: &[(&str, &str)]) -> tempfile::TempDir {
+    let d = tempfile::tempdir().expect("tempdir");
+    for (name, offered) in policies {
+        let p = d.path().join(name);
+        std::fs::create_dir(&p).expect("policy dir");
+        std::fs::write(p.join("scaling_available_governors"), offered).expect("offered");
+        std::fs::write(p.join("scaling_governor"), "performance\n").expect("governor");
+    }
+    d
+}
+
+fn governor(cpufreq: &Path, policy: &str) -> String {
+    std::fs::read_to_string(cpufreq.join(policy).join("scaling_governor"))
+        .expect("read governor")
+        .trim()
+        .to_owned()
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_cpu_row(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::General.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::Cpu.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+}
+
+#[test]
+fn the_cpu_row_sits_on_the_general_page_just_above_lid_power_off() {
+    let at = |r: QuickRow| QuickRow::GENERAL.iter().position(|g| *g == r);
+    assert_eq!(at(QuickRow::Cpu).map(|i| i + 1), at(QuickRow::LidOff));
+    assert_eq!(at(QuickRow::LidOff).map(|i| i + 1), at(QuickRow::DateTime));
+    assert_eq!(QuickRow::Cpu.parent(), Some(QuickRow::General));
+    assert_eq!(QuickRow::Cpu.label(), "CPU");
+}
+
+#[test]
+fn a_fresh_card_shows_cpu_performance() {
+    let root = tmp_root_with_real_carts(&["Emerald", "Ruby"]);
+    assert_eq!(
+        boot(root.path()).quick_value(QuickRow::Cpu),
+        Some(QuickValue::Performance)
+    );
+}
+
+#[test]
+fn right_on_the_cpu_row_saves_balanced_and_a_reboot_keeps_it() {
+    let root = tmp_root_with_real_carts(&["Emerald", "Ruby"]);
+    let mut app = boot(root.path());
+    open_cpu_row(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::Cpu));
+    press(&mut app, Btn::Right);
+    assert_eq!(app.quick_value(QuickRow::Cpu), Some(QuickValue::Balanced));
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(CPU_FILE)).ok(),
+        Some("mode = balanced\n".to_owned())
+    );
+    drop(app);
+    assert_eq!(
+        boot(root.path()).quick_value(QuickRow::Cpu),
+        Some(QuickValue::Balanced)
+    );
+}
+
+#[test]
+fn an_unknown_cpu_line_reads_as_performance() {
+    let root = tmp_root_with_real_carts(&["Emerald", "Ruby"]);
+    std::fs::write(root.path().join(CPU_FILE), "mode = turbo\n").expect("write cpu.txt");
+    assert_eq!(CpuMode::read(root.path()), CpuMode::Performance);
+}
+
+#[test]
+fn balanced_writes_schedutil_to_every_cpufreq_policy() {
+    let d = sysfs(&[("policy0", OFFERED), ("policy4", OFFERED)]);
+    set_governor(d.path(), CpuMode::Balanced).expect("schedutil refused");
+    assert_eq!(governor(d.path(), "policy0"), "schedutil");
+    assert_eq!(governor(d.path(), "policy4"), "schedutil");
+}
+
+#[test]
+fn performance_puts_performance_back() {
+    let d = sysfs(&[("policy0", OFFERED)]);
+    set_governor(d.path(), CpuMode::Balanced).expect("schedutil refused");
+    set_governor(d.path(), CpuMode::Performance).expect("performance refused");
+    assert_eq!(governor(d.path(), "policy0"), "performance");
+}
+
+#[test]
+fn a_kernel_without_schedutil_is_refused_and_no_policy_changes() {
+    let d = sysfs(&[("policy0", OFFERED), ("policy4", "performance powersave\n")]);
+    assert!(set_governor(d.path(), CpuMode::Balanced).is_err());
+    assert_eq!(governor(d.path(), "policy0"), "performance");
+    assert_eq!(governor(d.path(), "policy4"), "performance");
+}
+
+#[test]
+fn the_log_line_names_the_mode_and_what_each_policy_reads_back() {
+    let d = sysfs(&[("policy0", OFFERED)]);
+    assert_eq!(
+        apply(d.path(), CpuMode::Balanced),
+        "slot: cpu: balanced mode, governor schedutil (policy0 schedutil)"
+    );
+}
