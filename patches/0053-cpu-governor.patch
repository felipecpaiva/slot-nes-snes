diff --git a/crates/slot/src/cpu_governor.rs b/crates/slot/src/cpu_governor.rs
new file mode 100644
index 0000000..a6fb632
--- /dev/null
+++ b/crates/slot/src/cpu_governor.rs
@@ -0,0 +1,142 @@
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+
+use slot_store::ini;
+use slot_ui::QuickValue;
+
+use crate::card_log::CardWrites;
+
+pub const CPU_FILE: &str = "Config/cpu.txt";
+
+pub const CPUFREQ: &str = "/sys/devices/system/cpu/cpufreq";
+
+const KEY: &str = "mode";
+
+static CPUFREQ_DIR: OnceLock<PathBuf> = OnceLock::new();
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum CpuMode {
+    #[default]
+    Performance,
+    Balanced,
+}
+
+impl CpuMode {
+    pub const ALL: [CpuMode; 2] = [CpuMode::Performance, CpuMode::Balanced];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            CpuMode::Performance => "performance",
+            CpuMode::Balanced => "balanced",
+        }
+    }
+
+    pub fn governor(self) -> &'static str {
+        match self {
+            CpuMode::Performance => "performance",
+            CpuMode::Balanced => "schedutil",
+        }
+    }
+
+    pub fn quick_value(self) -> QuickValue {
+        match self {
+            CpuMode::Performance => QuickValue::Performance,
+            CpuMode::Balanced => QuickValue::Balanced,
+        }
+    }
+
+    pub fn flipped(self) -> CpuMode {
+        match self {
+            CpuMode::Performance => CpuMode::Balanced,
+            CpuMode::Balanced => CpuMode::Performance,
+        }
+    }
+
+    pub fn read(root: &Path) -> CpuMode {
+        let Some(line) = ini::value(root, CPU_FILE, KEY) else {
+            return CpuMode::Performance;
+        };
+        CpuMode::ALL
+            .into_iter()
+            .find(|m| m.as_str() == line)
+            .unwrap_or_else(|| {
+                eprintln!("slot: cpu.txt: ignoring {KEY}={line}");
+                CpuMode::Performance
+            })
+    }
+
+    pub fn save(self, root: &Path, writes: &CardWrites) {
+        let written = ini::write(root, CPU_FILE, KEY, self.as_str());
+        if let Err(e) = &written {
+            eprintln!("slot: cpu: could not write cpu.txt: {e}");
+        }
+        writes.wrote("cpu.txt", &written);
+    }
+}
+
+pub fn set_governor(cpufreq: &Path, mode: CpuMode) -> Result<Vec<String>, String> {
+    let want = mode.governor();
+    let entries = std::fs::read_dir(cpufreq).map_err(|e| format!("{}: {e}", cpufreq.display()))?;
+    let mut policies: Vec<PathBuf> = entries
+        .filter_map(Result::ok)
+        .map(|e| e.path())
+        .filter(|p| {
+            p.file_name()
+                .and_then(|n| n.to_str())
+                .is_some_and(|n| n.starts_with("policy"))
+        })
+        .collect();
+    policies.sort();
+    if policies.is_empty() {
+        return Err(format!("no cpufreq policy under {}", cpufreq.display()));
+    }
+    for p in &policies {
+        let offered =
+            std::fs::read_to_string(p.join("scaling_available_governors")).unwrap_or_default();
+        if !offered.split_whitespace().any(|g| g == want) {
+            return Err(format!(
+                "{} offers [{}], not {want}",
+                p.display(),
+                offered.trim()
+            ));
+        }
+    }
+    let mut now = Vec::new();
+    for p in &policies {
+        let node = p.join("scaling_governor");
+        std::fs::write(&node, want).map_err(|e| format!("{}: {e}", node.display()))?;
+        let name = p.file_name().and_then(|n| n.to_str()).unwrap_or("policy");
+        let read = std::fs::read_to_string(&node).unwrap_or_default();
+        now.push(format!("{name} {}", read.trim()));
+    }
+    Ok(now)
+}
+
+pub fn apply(cpufreq: &Path, mode: CpuMode) -> String {
+    match set_governor(cpufreq, mode) {
+        Ok(now) => format!(
+            "slot: cpu: {} mode, governor {} ({})",
+            mode.as_str(),
+            mode.governor(),
+            now.join(", ")
+        ),
+        Err(e) => format!(
+            "slot: cpu: {} mode, could not set governor {}: {e}",
+            mode.as_str(),
+            mode.governor()
+        ),
+    }
+}
+
+pub fn start(root: &Path, cpufreq: &Path) {
+    if CPUFREQ_DIR.set(cpufreq.to_path_buf()).is_err() {
+        eprintln!("slot: cpu: governor already started");
+    }
+    eprintln!("{}", apply(cpufreq, CpuMode::read(root)));
+}
+
+pub fn changed(mode: CpuMode) {
+    if let Some(dir) = CPUFREQ_DIR.get() {
+        eprintln!("{}", apply(dir, mode));
+    }
+}
