@@ -0,0 +1,52 @@
+mod common;
+
+use std::path::Path;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::cpu_governor::{start, CPU_FILE};
+use slot_input::{Action, Btn};
+use slot_ui::QuickRow;
+
+fn governor(cpufreq: &Path) -> String {
+    std::fs::read_to_string(cpufreq.join("policy0").join("scaling_governor"))
+        .expect("read governor")
+        .trim()
+        .to_owned()
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+#[test]
+fn the_governor_follows_the_saved_mode_at_start_and_then_each_change() {
+    let root = tmp_root_with_real_carts(&["Emerald", "Ruby"]);
+    std::fs::write(root.path().join(CPU_FILE), "mode = balanced\n").expect("write cpu.txt");
+    let d = tempfile::tempdir().expect("tempdir");
+    let p = d.path().join("policy0");
+    std::fs::create_dir(&p).expect("policy dir");
+    std::fs::write(
+        p.join("scaling_available_governors"),
+        "performance schedutil\n",
+    )
+    .expect("offered");
+    std::fs::write(p.join("scaling_governor"), "performance\n").expect("governor");
+    start(root.path(), d.path());
+    assert_eq!(governor(d.path()), "schedutil");
+    let mut app = boot(root.path());
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::General.position(&app.hidden_rows()) {
+        press(&mut app, Btn::Down);
+    }
+    press(&mut app, Btn::A);
+    for _ in 0..QuickRow::Cpu.position(&app.hidden_rows()) {
+        press(&mut app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::Cpu));
+    press(&mut app, Btn::Right);
+    assert_eq!(governor(d.path()), "performance");
+    press(&mut app, Btn::Left);
+    assert_eq!(governor(d.path()), "schedutil");
+}
