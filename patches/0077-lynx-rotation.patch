+pub fn turned() -> bool {
+    with_extra(|e| e.turned).unwrap_or(false)
+}
+
+pub unsafe fn rotation_set(data: *const c_uint) -> bool {
+    let Some(&quarters) = data.as_ref() else {
+        return false;
+    };
+    let half = match quarters {
+        0 => false,
+        2 => true,
+        other => {
+            eprintln!("slot: canvas: refusing a rotation of {other} quarter turns");
+            return false;
+        }
+    };
+    with_extra(|e| e.answers_rotation.then(|| e.turned = half))
+        .flatten()
+        .is_some()
+}
+
+pub fn turn_half(video: &mut [u8]) {
+    video.reverse();
+    for px in video.chunks_exact_mut(4) {
+        px.reverse();
+    }
+}
