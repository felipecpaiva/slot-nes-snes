+#[test]
+fn the_header_byte_says_which_way_a_cart_is_turned() {
+    let d = tempfile::tempdir().unwrap();
+    for (byte, want) in [(0, Turn::Upright), (1, Turn::Left), (2, Turn::Right)] {
+        let rom = cart(d.path(), &format!("Game {byte}"), b"GAME", byte);
+        assert_eq!(turn_of(d.path(), &format!("Game {byte}"), &rom), want);
+    }
+}
+
+#[test]
+fn the_title_list_turns_a_dump_whose_header_says_nothing() {
+    let d = tempfile::tempdir().unwrap();
+    for (stem, want) in [
+        ("Klax (USA, Europe)", Turn::Right),
+        ("Gauntlet - The Third Encounter (USA, Europe)", Turn::Right),
+        ("Lexis (USA)", Turn::Left),
+        ("NFL Football (USA, Europe)", Turn::Left),
+        ("California Games (USA, Europe)", Turn::Upright),
+    ] {
+        let rom = cart(d.path(), stem, b"", 0);
+        assert_eq!(turn_of(d.path(), stem, &rom), want, "{stem}");
+    }
+    let rom = cart(d.path(), "kx", b"Klax", 0);
+    assert_eq!(turn_of(d.path(), "kx", &rom), Turn::Right);
+    assert_eq!(listed_turn("klaxon"), Some(Turn::Right));
+    assert_eq!(listed_turn("Blue Lightning"), None);
+}
+
+#[test]
+fn the_override_file_wins_and_an_unknown_word_is_ignored() {
+    let d = tempfile::tempdir().unwrap();
+    let klax = cart(d.path(), "Klax", b"", 2);
+    let flat = cart(d.path(), "Flat", b"", 0);
+    let odd = cart(d.path(), "Odd", b"", 2);
+    chosen(d.path(), "Klax = none\nFlat = right\nOdd = sideways\n");
+    assert_eq!(turn_of(d.path(), "Klax", &klax), Turn::Upright);
+    assert_eq!(turn_of(d.path(), "Flat", &flat), Turn::Right);
+    assert_eq!(turn_of(d.path(), "Odd", &odd), Turn::Right);
+}
