+#[test]
+fn flip_right_carts_starts_on_and_writes_its_own_file() {
+    let (root, mut app) = card_with_a_cart();
+    open_lynx(&mut app);
+    for _ in 0..3 {
+        press(&mut app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::LynxFlip));
+    assert_eq!(QuickRow::LynxFlip.label(), "Flip Right Carts");
+    assert_eq!(app.quick_value(QuickRow::LynxFlip), Some(QuickValue::On));
+    assert!(app.lynx_flips_right());
+    let file = root.path().join(slot::lynx_turn::LYNX_FLIP_FILE);
+    assert!(!file.exists());
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_eq!(app.quick_value(QuickRow::LynxFlip), Some(QuickValue::Off));
+    assert_eq!(
+        std::fs::read_to_string(&file).expect("lynx_flip.txt"),
+        "right = off\n"
+    );
+    assert!(!boot(root.path()).lynx_flips_right());
+}
