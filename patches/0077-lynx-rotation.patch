+#[test]
+fn only_a_right_cart_with_flip_on_asks_the_core_for_half_a_turn() {
+    assert_eq!(rot_screen(Turn::Right, true), "180");
+    assert_eq!(rot_screen(Turn::Right, false), "0");
+    for flip in [true, false] {
+        assert_eq!(rot_screen(Turn::Left, flip), "0");
+        assert_eq!(rot_screen(Turn::Upright, flip), "0");
+    }
+}
+
+fn beetle(root: &Path) -> Option<LibretroCore> {
+    let dylib = require_core("mednafen_lynx")?;
+    let bios = slot::root::bios_dir(root);
+    std::fs::create_dir_all(&bios).unwrap();
+    let mut core = LibretroCore::open_with(&dylib, &bios, root).expect("open Beetle Lynx");
+    apply_core_options(
+        &mut core,
+        Core::MednafenLynx,
+        Platform::Lynx,
+        "",
+        false,
+        false,
+        None,
+    );
+    Some(core)
+}
+
+#[test]
+fn slot_hands_the_core_the_turn_for_each_cart() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let right = cart(d.path(), "Klax", b"", 0);
+    let left = cart(d.path(), "Lexis", b"", 0);
+    for (stem, rom, flip, want) in [
+        ("Klax", &right, true, "180"),
+        ("Klax", &right, false, "0"),
+        ("Lexis", &left, true, "0"),
+    ] {
+        let Some(mut core) = beetle(d.path()) else {
+            return;
+        };
+        apply(&mut core, d.path(), Platform::Lynx, stem, rom, flip);
+        assert_eq!(
+            core.option("lynx_rot_screen").as_deref(),
+            Some(want),
+            "{stem} {flip}"
+        );
+    }
+    let Some(mut core) = beetle(d.path()) else {
+        return;
+    };
+    apply(&mut core, d.path(), Platform::Nes, "Klax", &right, true);
+    assert_eq!(core.option("lynx_rot_screen").as_deref(), Some("0"));
+}
+
+fn turned_session(bios: &[u8], flip: bool, held: u16) -> Option<(bool, Vec<u8>)> {
+    let d = tempfile::tempdir().unwrap();
+    put_bios(d.path(), Some(bios));
+    let mut core = beetle(d.path())?;
+    let rom = lnx_cart(d.path(), "Klax", 2, echo_pad(0xfb68));
+    apply(&mut core, d.path(), Platform::Lynx, "Klax", &rom, flip);
+    core.load(&rom).unwrap();
+    for _ in 0..90 {
+        core.run_frame(ButtonMask(held));
+    }
+    let at = ((TOP + H / 2) * 240 + LEFT + W / 2) * 4;
+    Some((core.turned(), core.video_xrgb8888()[at..at + 3].to_vec()))
+}
+
+#[test]
+fn a_right_cart_is_drawn_turned_and_its_pad_turns_with_it() {
+    let _g = core_lock();
+    let Some(bios) = lynx_bios() else {
+        return;
+    };
+    let Some((flat, up)) = turned_session(&bios, false, ButtonMask::UP) else {
+        return;
+    };
+    let (_, down) = turned_session(&bios, false, ButtonMask::DOWN).unwrap();
+    assert!(!flat);
+    assert_ne!(up, down);
+    let (turned, up_turned) = turned_session(&bios, true, ButtonMask::UP).unwrap();
+    assert!(turned, "the core never asked for half a turn");
+    assert_eq!(up_turned, down);
+}
+
+#[test]
+fn l_and_r_reach_the_game_as_option_1_and_2() {
+    let _g = core_lock();
+    let Some(bios) = lynx_bios() else {
+        return;
+    };
+    let Some((_, idle)) = turned_session(&bios, false, 0) else {
+        return;
+    };
+    let (_, l) = turned_session(&bios, false, ButtonMask::L).unwrap();
+    let (_, r) = turned_session(&bios, false, ButtonMask::R).unwrap();
+    assert_ne!(l, idle);
+    assert_ne!(r, idle);
+    assert_ne!(l, r);
+    assert!(!Platform::Lynx.owns_shoulders());
+}
