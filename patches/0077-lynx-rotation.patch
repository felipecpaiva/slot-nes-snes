+
+const TURNED_TITLES: [(&str, Turn); 5] = [
+    ("klax", Turn::Right),
+    ("gauntletthethirdencounter", Turn::Right),
+    ("gauntletiii", Turn::Right),
+    ("lexis", Turn::Left),
+    ("nflfootball", Turn::Left),
+];
+
+pub fn listed_turn(name: &str) -> Option<Turn> {
+    let squashed: String = name
+        .chars()
+        .filter(char::is_ascii_alphanumeric)
+        .map(|c| c.to_ascii_lowercase())
+        .collect();
+    TURNED_TITLES
+        .iter()
+        .find(|(title, _)| squashed.starts_with(title))
+        .map(|(_, turn)| *turn)
+}
+
+pub fn parse_turn(word: &str) -> Option<Turn> {
+    match word.trim().to_ascii_lowercase().as_str() {
+        "left" => Some(Turn::Left),
+        "right" => Some(Turn::Right),
+        "none" => Some(Turn::Upright),
+        _ => None,
+    }
+}
+
+pub fn turn(rom: &Path, stem: &str, chosen: Option<&str>) -> Turn {
+    if let Some(word) = chosen {
+        match parse_turn(word) {
+            Some(turn) => return turn,
+            None => eprintln!("slot: lynx_rotation.txt: ignoring {stem}={word}"),
+        }
+    }
+    let head = header(rom);
+    listed_turn(stem)
+        .or_else(|| {
+            head.and_then(|h| title_of(&h))
+                .and_then(|t| listed_turn(&t))
+        })
+        .unwrap_or_else(|| head.map_or(Turn::Upright, |h| turn_of(&h)))
+}
