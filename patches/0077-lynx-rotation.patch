@@ -0,0 +1,62 @@
+use std::path::Path;
+
+use slot_retro::RetroCore;
+use slot_store::lynx::Turn;
+use slot_store::{ini, Platform};
+
+use crate::card_log::CardWrites;
+
+pub const LYNX_ROTATION_FILE: &str = "Config/lynx_rotation.txt";
+pub const LYNX_FLIP_FILE: &str = "Config/lynx_flip.txt";
+
+const FLIP_KEY: &str = "right";
+const ROT_SCREEN: &str = "lynx_rot_screen";
+
+pub fn turn_of(root: &Path, stem: &str, rom: &Path) -> Turn {
+    let chosen = ini::value(root, LYNX_ROTATION_FILE, stem);
+    slot_store::lynx::turn(rom, stem, chosen.as_deref())
+}
+
+pub fn rot_screen(turn: Turn, flip_right: bool) -> &'static str {
+    match (turn, flip_right) {
+        (Turn::Right, true) => "180",
+        (Turn::Right, false) | (Turn::Left | Turn::Upright, _) => "0",
+    }
+}
+
+pub fn apply(
+    core: &mut dyn RetroCore,
+    root: &Path,
+    platform: Platform,
+    stem: &str,
+    rom: &Path,
+    flip_right: bool,
+) {
+    if platform != Platform::Lynx {
+        return;
+    }
+    let turn = turn_of(root, stem, rom);
+    let value = rot_screen(turn, flip_right);
+    eprintln!("slot: lynx: {stem} is {turn:?}, {ROT_SCREEN}={value}");
+    core.set_option(ROT_SCREEN, value);
+}
+
+pub fn flips_right(root: &Path) -> bool {
+    match ini::value(root, LYNX_FLIP_FILE, FLIP_KEY).as_deref() {
+        None | Some("on") => true,
+        Some("off") => false,
+        Some(other) => {
+            eprintln!("slot: lynx_flip.txt: ignoring {FLIP_KEY}={other}");
+            true
+        }
+    }
+}
+
+pub fn save(root: &Path, flip_right: bool, writes: &CardWrites) {
+    let value = if flip_right { "on" } else { "off" };
+    let written = ini::write(root, LYNX_FLIP_FILE, FLIP_KEY, value);
+    if let Err(e) = &written {
+        eprintln!("slot: lynx: could not write lynx_flip.txt: {e}");
+    }
+    writes.wrote("lynx_flip.txt", &written);
+}
