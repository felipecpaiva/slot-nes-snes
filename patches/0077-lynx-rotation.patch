+fn cart(root: &Path, stem: &str, title: &[u8], byte: u8) -> PathBuf {
+    let mut rom = vec![0u8; 64 + 128 * 1024];
+    rom[..4].copy_from_slice(b"LYNX");
+    rom[8] = 1;
+    rom[10..10 + title.len()].copy_from_slice(title);
+    rom[58] = byte;
+    let path = root.join(format!("{stem}.lnx"));
+    std::fs::write(&path, rom).unwrap();
+    path
+}
+
+fn chosen(root: &Path, text: &str) {
+    std::fs::create_dir_all(root.join("Config")).unwrap();
+    std::fs::write(root.join(LYNX_ROTATION_FILE), text).unwrap();
+}
