--- /dev/null
+++ b/crates/slot/tests/nes_thumb.rs
@@ -0,0 +1,48 @@
+use slot::thumb;
+use slot_retro::{GBA_H, GBA_W};
+
+fn decode(png_bytes: &[u8]) -> (Vec<u8>, u32, u32) {
+    let mut reader = png::Decoder::new(png_bytes).read_info().expect("read info");
+    let mut buf = vec![0u8; reader.output_buffer_size()];
+    let info = reader.next_frame(&mut buf).expect("decode");
+    assert_eq!(info.color_type, png::ColorType::Rgb);
+    buf.truncate(info.buffer_size());
+    (buf, info.width, info.height)
+}
+
+fn gradient(w: u32, h: u32) -> Vec<u8> {
+    let mut frame = Vec::new();
+    for y in 0..h {
+        for x in 0..w {
+            frame.extend_from_slice(&[(x * 3) as u8, y as u8, (x + y) as u8, 0]);
+        }
+    }
+    frame
+}
+
+#[test]
+fn a_360_by_240_thumbnail_decodes_to_the_same_size_and_pixels() {
+    let frame = gradient(360, 240);
+    let (rgb, w, h) = decode(&thumb::png_sized(&frame, 360, 240).expect("encode"));
+    assert_eq!((w, h), (360, 240));
+    for (got, src) in rgb.chunks_exact(3).zip(frame.chunks_exact(4)) {
+        assert_eq!(got, [src[2], src[1], src[0]]);
+    }
+}
+
+#[test]
+fn a_gba_sized_thumbnail_is_byte_identical_through_either_encoder() {
+    let frame = gradient(GBA_W, GBA_H);
+    assert_eq!(
+        thumb::png_sized(&frame, GBA_W, GBA_H),
+        thumb::png(&frame),
+        "the GBA thumbnail moved"
+    );
+}
+
+#[test]
+fn a_frame_shorter_than_the_canvas_is_not_a_thumbnail() {
+    assert!(thumb::png_sized(&[], 360, 240).is_none());
+    assert!(thumb::png_sized(&vec![0u8; 360 * 240 * 4 - 4], 360, 240).is_none());
+    assert!(thumb::png_sized(&gradient(GBA_W, GBA_H), 360, 240).is_none());
+}
diff --git a/crates/slot/tests/nes_window.rs b/crates/slot/tests/nes_window.rs
new file mode 100644
index 0000000..0fa10e3
--- /dev/null
+++ b/crates/slot/tests/nes_window.rs
@@ -0,0 +1,200 @@
+#![cfg(target_os = "macos")]
+
+mod common;
+mod nes_common;
+
+use std::collections::VecDeque;
+use std::ffi::c_void;
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use common::{clocked, core_lock, tmp_root_with_real_carts};
+use nes_common::{fceumm, nes_rom};
+use slot::frontend::Frontend;
+use slot_gfx::{Compositor, HeadlessSurface, Surface};
+use slot_input::{Btn, InputSource, Millis, RawEvent};
+use slot_power::SimPlatform;
+
+const FRAMEBUFFERS: u32 = 512;
+const GL_FRAMEBUFFER: u32 = 0x8D40;
+const GL_PACK_ALIGNMENT: u32 = 0x0D05;
+const GL_RGBA: u32 = 0x1908;
+const GL_UNSIGNED_BYTE: u32 = 0x1401;
+
+type IsFramebuffer = unsafe extern "C" fn(u32) -> u8;
+type BindFramebuffer = unsafe extern "C" fn(u32, u32);
+type PixelStorei = unsafe extern "C" fn(u32, i32);
+type ReadPixels = unsafe extern "C" fn(i32, i32, i32, i32, u32, u32, *mut u8);
+
+struct Script(VecDeque<Vec<RawEvent>>);
+
+impl InputSource for Script {
+    fn poll(&mut self, _now: Millis) -> Vec<RawEvent> {
+        self.0.pop_front().unwrap_or_default()
+    }
+}
+
+fn gl_fn<T: Copy>(surface: &HeadlessSurface, name: &str) -> T {
+    let address = surface.proc_address(name);
+    assert!(!address.is_null(), "the GL loader has no {name}");
+    // SAFETY: the address is the OpenGL framework's own symbol for this name and T is its C signature.
+    unsafe { std::mem::transmute_copy::<*const c_void, T>(&address) }
+}
+
+fn framebuffers(surface: &HeadlessSurface) -> Vec<u32> {
+    let is_framebuffer: IsFramebuffer = gl_fn(surface, "glIsFramebuffer");
+    // SAFETY: glIsFramebuffer takes any integer name and only reads GL state on the current context.
+    (1..FRAMEBUFFERS)
+        .filter(|id| unsafe { is_framebuffer(*id) } != 0)
+        .collect()
+}
+
+fn read_output(surface: &HeadlessSurface, fbo: u32, (w, h): (u32, u32)) -> Vec<u8> {
+    let bind: BindFramebuffer = gl_fn(surface, "glBindFramebuffer");
+    let pack: PixelStorei = gl_fn(surface, "glPixelStorei");
+    let read: ReadPixels = gl_fn(surface, "glReadPixels");
+    let mut pixels = vec![0u8; w as usize * h as usize * 4];
+    // SAFETY: the buffer holds w * h RGBA bytes and the output framebuffer is complete on the current context.
+    unsafe {
+        bind(GL_FRAMEBUFFER, fbo);
+        pack(GL_PACK_ALIGNMENT, 1);
+        read(
+            0,
+            0,
+            w as i32,
+            h as i32,
+            GL_RGBA,
+            GL_UNSIGNED_BYTE,
+            pixels.as_mut_ptr(),
+        );
+    }
+    let stride = w as usize * 4;
+    pixels
+        .chunks_exact(stride)
+        .rev()
+        .flatten()
+        .copied()
+        .collect()
+}
+
+fn write_bezel(root: &Path, (w, h): (u32, u32), screen_h: u32) {
+    let dir = root.join("System/bezels");
+    std::fs::create_dir_all(&dir).expect("bezels dir");
+    let mut rgba = Vec::new();
+    for y in 0..h {
+        let px = if y < screen_h {
+            [0, 0, 0, 0]
+        } else {
+            [40, 90, 200, 255]
+        };
+        for _ in 0..w {
+            rgba.extend_from_slice(&px);
+        }
+    }
+    let file = std::fs::File::create(dir.join(format!("{w}x{h}.png"))).expect("bezel file");
+    let mut e = png::Encoder::new(std::io::BufWriter::new(file), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&rgba)
+        .expect("png data");
+}
+
+fn lit_box(px: &[u8], (w, h): (u32, u32)) -> Option<(u32, u32, u32, u32)> {
+    let mut found: Option<(u32, u32, u32, u32)> = None;
+    for y in 0..h {
+        for x in 0..w {
+            let o = (y * w + x) as usize * 4;
+            if px[o] > 0xc0 && px[o + 1] < 0x50 && px[o + 2] < 0x50 {
+                let (x0, y0, x1, y1) = found.unwrap_or((x, y, x, y));
+                found = Some((x0.min(x), y0.min(y), x1.max(x), y1.max(y)));
+            }
+        }
+    }
+    found
+}
+
+fn nes_picture_in(window: (u32, u32), bezel_screen_h: Option<u32>) -> Option<(u32, u32, u32, u32)> {
+    let _g = core_lock();
+    let dylib = fceumm()?;
+    let surface = HeadlessSurface::new().ok()?;
+    let mut c = Compositor::new(&surface).ok()?;
+    let d = tmp_root_with_real_carts(&[]);
+    std::fs::copy(
+        nes_rom("nes_window.nes", false),
+        d.path().join("Games/NES/Backdrop.nes"),
+    )
+    .expect("plant the cart");
+    let file = dylib.file_name().expect("core file name");
+    std::fs::copy(&dylib, d.path().join("System").join(file)).expect("plant the core");
+    if let Some(h) = bezel_screen_h {
+        write_bezel(d.path(), window, h);
+    }
+    clocked(d.path());
+    c.set_panel_turn((window.1, window.0), false)
+        .expect("panel turn");
+    let mut f = Frontend::boot(Box::new(SimPlatform::at(d.path().to_path_buf())));
+    f.upload_faces(&mut c);
+    f.upload_bezel(&mut c, window);
+    let before = framebuffers(&surface);
+    c.fit(window);
+    c.begin_frame();
+    c.end_frame(window);
+    let made: Vec<u32> = framebuffers(&surface)
+        .into_iter()
+        .filter(|id| !before.contains(id))
+        .collect();
+    let [output] = made[..] else {
+        panic!("expected one output framebuffer, found {made:?}");
+    };
+    let mut input = Script(VecDeque::new());
+    for _ in 0..3 {
+        input.0.push_back(vec![RawEvent::Down(Btn::R1)]);
+        f.advance(&mut input);
+        input.0.push_back(vec![RawEvent::Up(Btn::R1)]);
+        f.advance(&mut input);
+        run_for(&mut f, &mut input, 0.3);
+    }
+    input.0.push_back(vec![RawEvent::Down(Btn::A)]);
+    f.advance(&mut input);
+    input.0.push_back(vec![RawEvent::Up(Btn::A)]);
+    f.advance(&mut input);
+    run_for(&mut f, &mut input, 5.0);
+    f.render(&mut c, window);
+    lit_box(&read_output(&surface, output, window), window)
+}
+
+fn run_for(f: &mut Frontend, input: &mut Script, secs: f32) {
+    let until = Instant::now() + Duration::from_secs_f32(secs);
+    while Instant::now() < until {
+        f.advance(input);
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+fn near(got: u32, want: u32, what: &str) {
+    assert!(got.abs_diff(want) <= 1, "{what}: {got}, wanted {want} +-1");
+}
+
+#[test]
+fn a_nes_picture_fills_a_456_by_427_area_in_the_640_by_480_bezel_window() {
+    let Some((x0, y0, x1, y1)) = nes_picture_in((640, 480), Some(427)) else {
+        return;
+    };
+    near(x1 - x0 + 1, 456, "picture width");
+    near(y1 - y0 + 1, 427, "picture height");
+    near(x0, 92, "picture left");
+    assert_eq!(y0, 0, "the picture does not start at the top row");
+}
+
+#[test]
+fn a_nes_picture_is_512_by_480_and_centred_in_a_720_by_480_window() {
+    let Some((x0, y0, x1, y1)) = nes_picture_in((720, 480), None) else {
+        return;
+    };
+    near(x1 - x0 + 1, 512, "picture width");
+    near(y1 - y0 + 1, 480, "picture height");
+    near(x0, 104, "picture left");
+    assert_eq!(y0, 0, "the picture does not start at the top row");
+}
