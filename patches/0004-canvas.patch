+mod common;
+mod nes_common;
+
+use common::core_lock;
+use nes_common::{fceumm, nes_rom};
+use slot::core::open_core_for;
+use slot_retro::{ButtonMask, MockCore, RetroCore};
+use slot_store::Core;
+
+const PICTURE_X: usize = 52;
+const PICTURE_W: usize = 256;
+const BACKDROP_BGRX: [u8; 4] = [0x20, 0x20, 0xd0, 0];
+
+fn pixel(video: &[u8], x: usize, y: usize) -> [u8; 4] {
+    let at = (y * 360 + x) * 4;
+    [video[at], video[at + 1], video[at + 2], video[at + 3]]
+}
+
+#[test]
+fn fceumm_draws_a_256_wide_picture_in_the_middle_of_a_360_by_240_canvas() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = open_core_for(d.path(), Core::Fceumm, "auto", false, &[dylib]);
+    core.load(&nes_rom("nes_emu.nes", false))
+        .expect("fceumm refused the generated cart");
+    for _ in 0..60 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(core.canvas(), (360, 240));
+    let video = core.video_xrgb8888();
+    assert_eq!(video.len(), 360 * 240 * 4);
+    for y in 0..240 {
+        for x in PICTURE_X..PICTURE_X + PICTURE_W {
+            assert_eq!(pixel(video, x, y), BACKDROP_BGRX, "picture at {x},{y}");
+        }
+        for x in (0..PICTURE_X).chain(PICTURE_X + PICTURE_W..360) {
+            assert_eq!(pixel(video, x, y), [0, 0, 0, 0], "border at {x},{y}");
+        }
+    }
+    assert_ne!(
+        video,
+        MockCore::sized((360, 240)).video_xrgb8888(),
+        "the mock ran with fceumm sitting right there"
+    );
+}
+
+#[test]
+fn the_battery_flag_of_the_generated_cart_reaches_fceumm() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = open_core_for(
+        d.path(),
+        Core::Fceumm,
+        "auto",
+        false,
+        std::slice::from_ref(&dylib),
+    );
+    core.load(&nes_rom("nes_battery.nes", true))
+        .expect("fceumm refused the battery cart");
+    core.run_frame(ButtonMask::default());
+    assert!(core.save_ram().is_some(), "no save ram on a battery cart");
+    drop(core);
+    let mut core = open_core_for(d.path(), Core::Fceumm, "auto", false, &[dylib]);
+    core.load(&nes_rom("nes_no_battery.nes", false))
+        .expect("fceumm refused the plain cart");
+    core.run_frame(ButtonMask::default());
+    assert!(
+        core.save_ram().is_none(),
+        "save ram on a cart with no battery"
+    );
+}
