+mod common;
+
+use slot::core::open_core_for;
+use slot_retro::{ButtonMask, MockCore, RetroCore};
+use slot_store::Core;
+
+fn missing_fceumm() -> Box<dyn RetroCore> {
+    let d = common::tmp_root_with_real_carts(&[]);
+    open_core_for(d.path(), Core::Fceumm, "auto", false, &[])
+}
+
+#[test]
+fn a_nes_cart_without_fceumm_gets_a_mock_sized_to_the_nes_canvas() {
+    let mut core = missing_fceumm();
+    assert_eq!(core.canvas(), (360, 240));
+    assert_eq!(core.video_xrgb8888().len(), 360 * 240 * 4);
+    for _ in 0..3 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(core.video_xrgb8888().len(), 360 * 240 * 4);
+}
+
+#[test]
+fn a_gba_cart_without_a_core_still_gets_the_gba_sized_mock() {
+    let d = common::tmp_root_with_real_carts(&[]);
+    let core = open_core_for(d.path(), Core::Mgba, "auto", false, &[]);
+    assert_eq!(core.canvas(), (240, 160));
+    assert_eq!(
+        core.video_xrgb8888(),
+        MockCore::new().video_xrgb8888(),
+        "the GBA mock frame moved"
+    );
+}
+
+#[cfg(target_os = "macos")]
+mod upload {
+    use super::*;
+    use slot_gfx::{Compositor, HeadlessSurface, ScreenEffect, OUT_W};
+
+    #[test]
+    fn the_sized_mock_frame_is_accepted_by_the_nes_canvas() {
+        let Ok(surface) = HeadlessSurface::new() else {
+            return;
+        };
+        let Ok(mut c) = Compositor::new(&surface) else {
+            return;
+        };
+        let mut core = missing_fceumm();
+        core.run_frame(ButtonMask::default());
+        c.set_game_canvas(360, 240);
+        c.set_screen_effect(ScreenEffect::None);
+        c.begin_frame();
+        c.upload_game(core.video_xrgb8888());
+        c.draw_game();
+        let frame = c.read_frame();
+        let at = (120 * OUT_W as usize + 360) * 4;
+        let src = core.video_xrgb8888();
+        let from = (60 * 360 + 180) * 4;
+        assert_eq!(frame[at..at + 3], [src[from + 2], src[from + 1], src[from]]);
+    }
+}
