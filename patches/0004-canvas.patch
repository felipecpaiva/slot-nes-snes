diff --git a/crates/slot-gfx/tests/nes_pipeline.rs b/crates/slot-gfx/tests/nes_pipeline.rs
new file mode 100644
index 0000000..8db0d29
--- /dev/null
+++ b/crates/slot-gfx/tests/nes_pipeline.rs
@@ -0,0 +1,101 @@
+#![cfg(target_os = "macos")]
+
+use slot_gfx::{Compositor, HeadlessSurface, ScreenEffect, OUT_H, OUT_W, SRC_H, SRC_W};
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+static GL: Mutex<()> = Mutex::new(());
+
+fn compositor() -> Option<(MutexGuard<'static, ()>, HeadlessSurface, Compositor)> {
+    let guard = GL.lock().unwrap_or_else(PoisonError::into_inner);
+    let surface = HeadlessSurface::new().ok()?;
+    let compositor = Compositor::new(&surface).ok()?;
+    Some((guard, surface, compositor))
+}
+
+fn source(w: usize, h: usize) -> Vec<u8> {
+    let mut buf = Vec::with_capacity(w * h * 4);
+    for y in 0..h {
+        for x in 0..w {
+            buf.extend_from_slice(&[(x * 7 + y * 13) as u8, y as u8, x as u8, 0]);
+        }
+    }
+    buf
+}
+
+fn px(frame: &[u8], x: usize, y: usize) -> [u8; 3] {
+    let o = (y * OUT_W as usize + x) * 4;
+    [frame[o], frame[o + 1], frame[o + 2]]
+}
+
+fn drawn(c: &mut Compositor, buf: &[u8]) -> Vec<u8> {
+    c.begin_frame();
+    c.upload_game(buf);
+    c.draw_game();
+    c.read_frame()
+}
+
+#[test]
+fn a_360_by_240_canvas_draws_every_source_pixel_as_a_2x2_block() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    c.set_game_canvas(360, 240);
+    c.set_screen_effect(ScreenEffect::None);
+    let src = source(360, 240);
+    let frame = drawn(&mut c, &src);
+    for y in 0..240 {
+        for x in 0..360 {
+            let at = (y * 360 + x) * 4;
+            let want = [src[at + 2], src[at + 1], src[at]];
+            for (dx, dy) in [(0, 0), (1, 0), (0, 1), (1, 1)] {
+                assert_eq!(px(&frame, 2 * x + dx, 2 * y + dy), want, "source {x},{y}");
+            }
+        }
+    }
+}
+
+#[test]
+fn a_240_by_160_buffer_is_rejected_once_the_canvas_is_360_by_240() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    c.set_game_canvas(360, 240);
+    c.set_screen_effect(ScreenEffect::None);
+    let good = source(360, 240);
+    let before = drawn(&mut c, &good);
+    let short = vec![0xffu8; (SRC_W * SRC_H * 4) as usize];
+    let after = drawn(&mut c, &short);
+    assert_eq!(before, after, "a short buffer was drawn");
+}
+
+#[test]
+fn a_360_by_240_buffer_is_rejected_once_the_canvas_is_back_to_240_by_160() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    c.set_game_canvas(360, 240);
+    c.set_game_canvas(SRC_W, SRC_H);
+    c.set_screen_effect(ScreenEffect::None);
+    let blank = drawn(&mut c, &[]);
+    let long = vec![0xffu8; 360 * 240 * 4];
+    let after = drawn(&mut c, &long);
+    assert_eq!(blank, after, "a long buffer was drawn");
+    assert_eq!(
+        px(&after, OUT_W as usize - 1, OUT_H as usize - 1),
+        [0, 0, 0]
+    );
+}
+
+#[test]
+fn setting_the_canvas_to_240_by_160_after_nes_draws_a_gba_frame_exactly() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    c.set_screen_effect(ScreenEffect::None);
+    let src = source(SRC_W as usize, SRC_H as usize);
+    let fresh = drawn(&mut c, &src);
+    c.set_game_canvas(360, 240);
+    let _ = drawn(&mut c, &source(360, 240));
+    c.set_game_canvas(SRC_W, SRC_H);
+    assert_eq!(drawn(&mut c, &src), fresh);
+}
diff --git a/crates/slot-retro/src/canvas.rs b/crates/slot-retro/src/canvas.rs
new file mode 100644
index 0000000..c084120
--- /dev/null
+++ b/crates/slot-retro/src/canvas.rs
@@ -0,0 +1,205 @@
+use std::cell::Cell;
+use std::marker::PhantomData;
+use std::ptr;
+
+use crate::core::{GBA_H, GBA_W};
+
+pub struct HostExtra {
+    pub canvas: (u32, u32),
+}
+
+impl Default for HostExtra {
+    fn default() -> Self {
+        HostExtra {
+            canvas: (GBA_W, GBA_H),
+        }
+    }
+}
+
+thread_local! {
+    static EXTRA: Cell<*mut HostExtra> = const { Cell::new(ptr::null_mut()) };
+}
+
+pub struct ExtraGuard<'a>(PhantomData<&'a mut HostExtra>);
+
+impl ExtraGuard<'_> {
+    pub fn bind(extra: &mut HostExtra) -> ExtraGuard<'_> {
+        EXTRA.with(|e| e.set(extra as *mut HostExtra));
+        ExtraGuard(PhantomData)
+    }
+}
+
+impl Drop for ExtraGuard<'_> {
+    fn drop(&mut self) {
+        EXTRA.with(|e| e.set(ptr::null_mut()));
+    }
+}
+
+pub fn bound_canvas() -> Option<(u32, u32)> {
+    let p = EXTRA.with(|e| e.get());
+    // SAFETY: the pointer is null or set by a live ExtraGuard on this thread, which clears it on drop.
+    unsafe { p.as_ref() }.map(|extra| extra.canvas)
+}
+
+pub fn bgrx_from_rgb565(p: u16) -> [u8; 4] {
+    let r = ((p >> 11) & 0x1f) as u8;
+    let g = ((p >> 5) & 0x3f) as u8;
+    let b = (p & 0x1f) as u8;
+    [
+        (b << 3) | (b >> 2),
+        (g << 2) | (g >> 4),
+        (r << 3) | (r >> 2),
+        0,
+    ]
+}
+
+pub unsafe fn copy_centred(
+    video: &mut [u8],
+    canvas: (u32, u32),
+    src: *const u8,
+    (width, height): (u32, u32),
+    pitch: usize,
+    rgb565: bool,
+) {
+    let (canvas_w, canvas_h) = (canvas.0 as usize, canvas.1 as usize);
+    if video.len() != canvas_w * canvas_h * 4 {
+        eprintln!(
+            "slot: canvas: video buffer holds {} bytes, not {canvas_w}x{canvas_h}, frame dropped",
+            video.len()
+        );
+        return;
+    }
+    let cols = (width as usize).min(canvas_w);
+    let rows = (height as usize).min(canvas_h);
+    let ox = (canvas_w - cols) / 2;
+    let oy = (canvas_h - rows) / 2;
+    if cols != canvas_w || rows != canvas_h {
+        video.fill(0);
+    }
+    for y in 0..rows {
+        let from = src.add(y * pitch);
+        let row = ((y + oy) * canvas_w + ox) * 4;
+        let Some(out) = video.get_mut(row..row + cols * 4) else {
+            return;
+        };
+        if rgb565 {
+            for (x, px) in out.chunks_exact_mut(4).enumerate() {
+                let p = ptr::read_unaligned((from as *const u16).add(x));
+                px.copy_from_slice(&bgrx_from_rgb565(p));
+            }
+        } else {
+            ptr::copy_nonoverlapping(from, out.as_mut_ptr(), cols * 4);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn white(w: usize, h: usize) -> Vec<u8> {
+        vec![0xff; w * h * 4]
+    }
+
+    fn lit(video: &[u8], x: usize, y: usize) -> bool {
+        video[(y * 360 + x) * 4..(y * 360 + x) * 4 + 3] == [0xff; 3]
+    }
+
+    #[test]
+    fn a_256_wide_frame_sits_in_the_middle_of_the_360_wide_canvas() {
+        let frame = white(256, 240);
+        let mut video = vec![0u8; 360 * 240 * 4];
+        // SAFETY: frame holds 240 rows of 1024 bytes, 256 XRGB8888 pixels each.
+        unsafe {
+            copy_centred(
+                &mut video,
+                (360, 240),
+                frame.as_ptr(),
+                (256, 240),
+                1024,
+                false,
+            )
+        };
+        assert!(lit(&video, 52, 0));
+        assert!(lit(&video, 307, 239));
+        assert!(!lit(&video, 51, 0));
+        assert!(!lit(&video, 308, 0));
+    }
+
+    #[test]
+    fn rgb565_converts_exactly_as_upstream_does_for_every_input() {
+        for p in 0..=u16::MAX {
+            let r = ((p >> 11) & 0x1f) as u8;
+            let g = ((p >> 5) & 0x3f) as u8;
+            let b = (p & 0x1f) as u8;
+            let upstream = [
+                (b << 3) | (b >> 2),
+                (g << 2) | (g >> 4),
+                (r << 3) | (r >> 2),
+                0,
+            ];
+            assert_eq!(bgrx_from_rgb565(p), upstream, "input {p:#06x}");
+        }
+    }
+
+    #[test]
+    fn an_rgb565_frame_lands_converted_and_centred() {
+        let frame: Vec<u8> = [0xf800u16; 4]
+            .iter()
+            .flat_map(|p| p.to_le_bytes())
+            .collect();
+        let mut video = vec![0u8; 360 * 240 * 4];
+        // SAFETY: frame holds 1 row of 8 bytes, 4 RGB565 pixels.
+        unsafe { copy_centred(&mut video, (360, 240), frame.as_ptr(), (4, 1), 8, true) };
+        let at = ((119 * 360) + 178) * 4;
+        assert_eq!(video[at..at + 4], [0, 0, 0xff, 0]);
+        assert_eq!(video[at - 4..at], [0, 0, 0, 0]);
+    }
+
+    #[test]
+    fn a_frame_wider_than_the_canvas_is_cropped_and_never_overruns() {
+        let frame = white(400, 300);
+        let mut video = vec![0u8; 360 * 240 * 4];
+        // SAFETY: frame holds 300 rows of 1600 bytes, 400 XRGB8888 pixels each.
+        unsafe {
+            copy_centred(
+                &mut video,
+                (360, 240),
+                frame.as_ptr(),
+                (400, 300),
+                1600,
+                false,
+            )
+        };
+        assert!(lit(&video, 0, 0) && lit(&video, 359, 239));
+    }
+
+    #[test]
+    fn a_video_buffer_of_the_wrong_length_is_left_alone() {
+        let frame = white(256, 240);
+        let mut video = vec![7u8; 240 * 160 * 4];
+        // SAFETY: frame holds 240 rows of 1024 bytes, 256 XRGB8888 pixels each.
+        unsafe {
+            copy_centred(
+                &mut video,
+                (360, 240),
+                frame.as_ptr(),
+                (256, 240),
+                1024,
+                false,
+            )
+        };
+        assert!(video.iter().all(|b| *b == 7));
+    }
+
+    #[test]
+    fn the_canvas_is_bound_only_while_a_guard_lives() {
+        assert_eq!(bound_canvas(), None);
+        let mut extra = HostExtra { canvas: (360, 240) };
+        {
+            let _g = ExtraGuard::bind(&mut extra);
+            assert_eq!(bound_canvas(), Some((360, 240)));
+        }
+        assert_eq!(bound_canvas(), None);
+    }
+}
