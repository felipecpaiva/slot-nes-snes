@@ -23,7 +23,45 @@ const GENESIS_PLUS_GX: [(&str, &str); 5] = [
     ("genesis_plus_gx_render", "single field"),
 ];
 
+const PCSX_REARMED: [(&str, &str); 7] = [
+    ("pcsx_rearmed_bios", "auto"),
+    ("pcsx_rearmed_memcard1", "libretro"),
+    ("pcsx_rearmed_memcard2", "none"),
+    ("pcsx_rearmed_frameskip_type", "disabled"),
+    ("pcsx_rearmed_neon_enhancement_enable", "disabled"),
+    ("pcsx_rearmed_gpu_thread_rendering", "auto"),
+    ("pcsx_rearmed_drc_thread", "auto"),
+];
+
+pub fn answers_declared_defaults(which: Core) -> bool {
+    match which {
+        Core::PcsxRearmed => true,
+        Core::Mgba
+        | Core::Gpsp
+        | Core::Fceumm
+        | Core::Snes9x
+        | Core::Nestopia
+        | Core::Snes9x2005Plus
+        | Core::GenesisPlusGx => false,
+    }
+}
+
+fn answer_declared_defaults(core: &mut LibretroCore) {
+    let defaults: Vec<(String, String)> = core
+        .declared_options()
+        .iter()
+        .filter(|(key, _)| core.option(key).is_none())
+        .filter_map(|(key, values)| Some((key.clone(), values.first()?.clone())))
+        .collect();
+    for (key, value) in defaults {
+        core.set_option(&key, &value);
+    }
+}
+
 pub fn apply_policy_options(core: &mut LibretroCore, which: Core) {
+    if answers_declared_defaults(which) {
+        answer_declared_defaults(core);
+    }
     let frameskip = format!("{}_frameskip", which.option_prefix());
     if core.declared_options().contains_key(&frameskip) {
         core.set_option(&frameskip, "auto");
@@ -53,8 +91,8 @@ pub fn apply_policy_options(core: &mut LibretroCore, which: Core) {
         | Core::Fceumm
         | Core::Snes9x
         | Core::Nestopia
-        | Core::Snes9x2005Plus
-        | Core::PcsxRearmed => &[],
+        | Core::Snes9x2005Plus => &[],
+        Core::PcsxRearmed => &PCSX_REARMED,
     };
     for (key, value) in fixed {
         core.set_option(key, value);
