@@ -118,4 +118,18 @@ impl Platform {
             | Platform::Ps1 => false,
         }
     }
+
+    pub fn rewinds(self) -> bool {
+        match self {
+            Platform::Ps1 => false,
+            Platform::Gba
+            | Platform::Gb
+            | Platform::Gbc
+            | Platform::Nes
+            | Platform::Snes
+            | Platform::Gg
+            | Platform::Sms
+            | Platform::Md => true,
+        }
+    }
 }
