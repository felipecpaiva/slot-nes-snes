+fn pcsx(dylib: &Path) -> LibretroCore {
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = LibretroCore::open_with(dylib, d.path(), d.path()).expect("open pcsx");
+    apply_core_options(
+        &mut core,
+        Core::PcsxRearmed,
+        Platform::Ps1,
+        "auto",
+        false,
+        false,
+        None,
+    );
+    core
+}
+
+#[test]
+fn every_explicit_ps1_option_is_answered_with_its_own_value() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let core = pcsx(&dylib);
+    for (key, value) in EXPLICIT {
+        assert_eq!(core.option(key).as_deref(), Some(value), "{key}");
+    }
+}
+
+#[test]
+fn every_key_pcsx_declares_is_answered_and_unset_ones_get_the_declared_default() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let core = pcsx(&dylib);
+    let mut declared: Vec<(String, String)> = core
+        .declared_options()
+        .iter()
+        .map(|(k, v)| (k.clone(), v.first().cloned().unwrap_or_default()))
+        .collect();
+    declared.sort();
+    let want: Vec<(String, String)> = DECLARED_ON_THE_HOST_BUILD
+        .iter()
+        .map(|(k, v)| (k.to_string(), v.to_string()))
+        .collect();
+    assert_eq!(declared, want, "the pin declares a different option set");
+    for (key, default) in DECLARED_ON_THE_HOST_BUILD {
+        let explicit = EXPLICIT.iter().find(|(k, _)| *k == key).map(|(_, v)| *v);
+        assert_eq!(
+            core.option(key).as_deref(),
+            Some(explicit.unwrap_or(default)),
+            "{key}"
+        );
+    }
+    assert_eq!(
+        core.option("pcsx_rearmed_psxclock").as_deref(),
+        Some("auto")
+    );
+    assert_eq!(
+        core.option("pcsx_rearmed_memcard2").as_deref(),
+        Some("none")
+    );
+}
+
+#[test]
+fn a_key_pcsx_never_declared_is_still_not_answered() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let core = pcsx(&dylib);
+    assert_eq!(core.option("pcsx_rearmed_no_such_key"), None);
+    assert_eq!(core.option("mgba_skip_bios"), None);
+}
+
+fn dylib_of(core: Core) -> Option<PathBuf> {
+    core_common::require_core(core.as_str())
+}
+
+#[test]
+fn no_other_core_gets_its_declared_defaults_answered() {
+    let _g = core_lock();
+    for which in Core::EVERY {
+        assert_eq!(
+            answers_declared_defaults(which),
+            which == Core::PcsxRearmed,
+            "{which:?}"
+        );
+    }
+    for (which, platform) in [
+        (Core::Mgba, Platform::Gba),
+        (Core::Gpsp, Platform::Gba),
+        (Core::Mgba, Platform::Gb),
+        (Core::Fceumm, Platform::Nes),
+        (Core::Snes9x, Platform::Snes),
+        (Core::GenesisPlusGx, Platform::Md),
+    ] {
+        let Some(dylib) = dylib_of(which) else {
+            continue;
+        };
+        let d = common::tmp_root_with_real_carts(&[]);
+        let mut core = LibretroCore::open_with(&dylib, d.path(), d.path()).expect("open");
+        apply_core_options(&mut core, which, platform, "auto", false, false, None);
+        let unanswered: Vec<&String> = core
+            .declared_options()
+            .keys()
+            .filter(|k| core.option(k).is_none())
+            .collect();
+        if which == Core::Mgba || which == Core::Gpsp || which == Core::GenesisPlusGx {
+            assert!(
+                !unanswered.is_empty(),
+                "{which:?} had every declared key answered: {:?}",
+                core.options()
+            );
+        }
+    }
+}
+
+#[test]
+fn with_no_bios_on_the_card_auto_falls_back_to_hle_and_the_disc_boots() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let cue = disc(&d.path().join("Games/PS1"), "NoBios");
+    assert_eq!(
+        std::fs::read_dir(d.path().join("BIOS"))
+            .map(|r| r.count())
+            .ok(),
+        Some(0)
+    );
+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::PcsxRearmed,
+        Platform::Ps1,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.load(&cue).expect("load");
+    for _ in 0..60 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(red(core.video_xrgb8888()), RED_W * RED_H);
+}
+
+fn seated(dylib: &Path, platform: Platform) -> tempfile::TempDir {
+    let discs = tempfile::tempdir().expect("tempdir");
+    let cue = disc(discs.path(), STEM);
+    let root = real_seat::rooted(platform, STEM, &cue, dylib);
+    std::fs::copy(
+        discs.path().join(format!("{STEM}.bin")),
+        root.path().join("Games/PS1").join(format!("{STEM}.bin")),
+    )
+    .expect("copy bin");
+    disc(&root.path().join("Games/PS1"), "Zzz");
+    root
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+#[test]
+fn the_memory_card_is_save_ram_and_comes_out_on_eject_as_the_games_sav() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let root = seated(&dylib, Platform::Ps1);
+    let mut session = real_seat::play(root.path(), true);
+    let emu = session.emu().expect("no core in the slot");
+    assert_eq!(
+        emu.snapshot().save_ram().map(|card| card.len()),
+        Some(CARD_BYTES)
+    );
+    eject(&mut session);
+    let card = std::fs::read(root.path().join("Saves/PS1").join(format!("{STEM}.sav")))
+        .expect("no memory card after eject");
+    assert_eq!(card.len(), CARD_BYTES);
+}
+
+#[test]
+fn a_ps1_game_never_records_or_plays_rewind_while_gba_still_does() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    assert!(!Platform::Ps1.rewinds());
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            platform.rewinds(),
+            platform != Platform::Ps1,
+            "{platform:?}"
+        );
+    }
+    let root = seated(&dylib, Platform::Ps1);
+    let mut session = real_seat::play(root.path(), true);
+    assert!(
+        slot_store::SlotState::default().rewind,
+        "rewind is on by default"
+    );
+    assert!(!session.app().records_rewind());
+    assert!(!session.app().may_rewind());
+    for _ in 0..30 {
+        session.update(1.0 / 60.0);
+    }
+    assert_eq!(session.emu().expect("core").rewind_fill(), 0);
+    let gba = common::tmp_root_with_real_carts(&["Emerald"]);
+    let app = common::boot(gba.path());
+    assert!(app.records_rewind());
+    assert!(app.may_rewind());
+}
