 crates/slot/src/app.rs                   |   4 +-
 crates/slot/src/core_options_policy.rs   |  42 +++-
 crates/slot/tests/ps1_options.rs         | 306 +++++++++++++++++++++++
 4 files changed, 362 insertions(+), 4 deletions(-)
