+fn write_playlist(root: &Path, platform: Platform, base: &str, discs: &[&Path]) -> Option<PathBuf> {
+    let dir = root.join("Config/playlists").join(platform.dir_name());
+    let path = dir.join(format!("{base}.m3u"));
