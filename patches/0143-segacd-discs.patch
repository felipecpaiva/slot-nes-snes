@@ -0,0 +1,139 @@
+// Sega CD discs on Genesis Plus GX (ADR 0105). The core offers only the legacy disk control interface
+// (no set_initial_image), holds 4 discs and joins every m3u line to the playlist's own directory, so
+// slot writes Sega CD playlists with relative paths and swaps to a remembered disc right after load.
+mod common;
+mod core_common;
+mod segacd_common;
+
+use std::path::{Path, PathBuf};
+
+use common::{core_lock, tmp_root_with_carts};
+use segacd_common::{dummy_bios, genesis_plus_gx, iso_disc, put_bios, US};
+use slot::core::apply_core_options;
+use slot::ps1_load::{disc_file, offer_remembered_disc, remember_disc};
+use slot_retro::{ButtonMask, DiscEvent, LibretroCore, RetroCore};
+use slot_store::{scan, Core, Platform};
+
+const STEM: &str = "Night Trap (USA)";
+
+fn card() -> tempfile::TempDir {
+    let d = tmp_root_with_carts(&[]);
+    put_bios(d.path(), "bios_CD_U.bin", &dummy_bios());
+    let games = d.path().join("Games/SEGACD");
+    iso_disc(&games, &format!("{STEM} (Disc 1)"), US);
+    iso_disc(&games, &format!("{STEM} (Disc 2)"), US);
+    d
+}
+
+fn playlist(root: &Path) -> PathBuf {
+    let carts: Vec<_> = scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == Platform::SegaCd)
+        .collect();
+    assert_eq!(carts.len(), 1, "{carts:?}");
+    assert_eq!(carts[0].stem, STEM);
+    carts[0].rom.clone()
+}
+
+fn opened(root: &Path, dylib: PathBuf) -> LibretroCore {
+    let mut core = LibretroCore::open_with(
+        &dylib,
+        &slot::root::bios_dir(root),
+        &slot::root::saves_dir(root),
+    )
+    .expect("open genesis plus gx");
+    let (w, h) = Core::GenesisPlusGx.canvas(Platform::SegaCd);
+    core.set_canvas(w, h);
+    core.use_disc_drive();
+    apply_core_options(
+        &mut core,
+        Core::GenesisPlusGx,
+        Platform::SegaCd,
+        "auto",
+        false,
+        false,
+        None,
+    );
+    core
+}
+
+fn run(core: &mut LibretroCore, frames: usize) {
+    for _ in 0..frames {
+        core.run_frame(ButtonMask::default());
+    }
+}
+
+#[test]
+fn a_two_disc_set_becomes_one_game_with_a_playlist_relative_to_itself() {
+    let d = card();
+    let m3u = playlist(d.path());
+    assert_eq!(
+        m3u,
+        d.path().join(format!("Config/playlists/SEGACD/{STEM}.m3u"))
+    );
+    assert_eq!(
+        std::fs::read_to_string(&m3u).expect("read the playlist"),
+        format!(
+            "../../../Games/SEGACD/{STEM} (Disc 1).iso\n../../../Games/SEGACD/{STEM} (Disc 2).iso\n"
+        )
+    );
+}
+
+#[test]
+fn the_generated_playlist_loads_and_swaps_between_its_discs() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let d = card();
+    let m3u = playlist(d.path());
+    let mut core = opened(d.path(), dylib);
+    slot::ps1_load::load(&mut core, &m3u).expect("load the playlist");
+    run(&mut core, 5);
+    assert_eq!((core.disc_count(), core.disc_index()), (2, 0));
+    core.next_disc();
+    assert_eq!(core.disc_index(), 1);
+    assert_eq!(core.take_disc_event(), Some(DiscEvent::Swapped(1)));
+}
+
+#[test]
+fn a_remembered_disc_is_swapped_in_right_after_load() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let d = card();
+    let m3u = playlist(d.path());
+    remember_disc(d.path(), Platform::SegaCd, STEM, 1).expect("write the disc file");
+    assert_eq!(
+        disc_file(d.path(), Platform::SegaCd, STEM),
+        d.path().join(format!("Saves/SEGACD/{STEM}.disc"))
+    );
+    let mut core = opened(d.path(), dylib);
+    offer_remembered_disc(&mut core, d.path(), Platform::SegaCd, STEM, &m3u);
+    slot::ps1_load::load(&mut core, &m3u).expect("load the playlist");
+    assert_eq!(core.disc_index(), 1);
+}
+
+#[test]
+fn a_state_taken_on_disc_two_brings_disc_two_back_after_a_fresh_load() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let d = card();
+    let m3u = playlist(d.path());
+    let mut core = opened(d.path(), dylib.clone());
+    slot::ps1_load::load(&mut core, &m3u).expect("load the playlist");
+    core.next_disc();
+    run(&mut core, 5);
+    let state = core.serialize().expect("serialize");
+    drop(core);
+    let mut core = opened(d.path(), dylib);
+    slot::ps1_load::load(&mut core, &m3u).expect("load again");
+    assert_eq!(core.disc_index(), 0);
+    core.unserialize(&state).expect("unserialize");
+    assert_eq!(core.disc_index(), 1);
+    assert_eq!(core.take_disc_event(), Some(DiscEvent::Restored(1)));
+}
