 }
 
+fn relative_to(dir: &Path, file: &Path) -> Option<PathBuf> {
+    let dir = std::path::absolute(dir).ok()?;
+    let mut from = dir.components().peekable();
+    let mut to = file.components().peekable();
+    while let (Some(a), Some(b)) = (from.peek(), to.peek()) {
+        if a != b {
+            break;
+        }
+        from.next();
+        to.next();
+    }
+    let up = from.count();
+    let rest: PathBuf = to.collect();
+    if up == dir.components().count() || rest.as_os_str().is_empty() {
+        return None;
+    }
+    Some(
+        std::iter::repeat_n(Component::ParentDir, up)
+            .collect::<PathBuf>()
+            .join(rest),
+    )
+}
