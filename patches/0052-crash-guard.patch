diff --git a/crates/slot/src/app/start_guard.rs b/crates/slot/src/app/start_guard.rs
new file mode 100644
index 0000000..cd6373b
--- /dev/null
+++ b/crates/slot/src/app/start_guard.rs
@@ -0,0 +1,67 @@
+use std::path::{Path, PathBuf};
+
+use slot_store::Platform;
+use slot_ui::Toast;
+
+use super::App;
+
+const START_SETTLED_FRAMES: u64 = 300;
+
+fn mark_file(root: &Path) -> PathBuf {
+    root.join("Config/starting.txt")
+}
+
+fn mark_line(platform: Platform, stem: &str) -> String {
+    format!("{}/{stem}", platform.dir_name())
+}
+
+impl App {
+    pub fn mark_start(&mut self, platform: Platform, stem: &str) {
+        let Some(root) = &self.root else {
+            return;
+        };
+        let line = mark_line(platform, stem);
+        match std::fs::write(mark_file(root), format!("{line}\n")) {
+            Ok(()) => self.start_marked = true,
+            Err(e) => eprintln!("slot: start guard: {e}"),
+        }
+    }
+
+    pub fn settle_start(&mut self, frames: u64) {
+        if !self.start_marked || frames < START_SETTLED_FRAMES {
+            return;
+        }
+        self.start_marked = false;
+        let Some(root) = &self.root else {
+            return;
+        };
+        if let Err(e) = std::fs::remove_file(mark_file(root)) {
+            if e.kind() != std::io::ErrorKind::NotFound {
+                eprintln!("slot: start guard: {e}");
+            }
+        }
+    }
+
+    pub(super) fn settle_start_now(&mut self) {
+        self.settle_start(START_SETTLED_FRAMES);
+    }
+
+    pub(super) fn start_crashed(&mut self) -> bool {
+        let Some(root) = &self.root else {
+            return false;
+        };
+        let Some(cart) = self.shelf().carts.get(self.shelf().index) else {
+            return false;
+        };
+        let line = mark_line(cart.platform, &cart.stem);
+        let marked = std::fs::read_to_string(mark_file(root))
+            .is_ok_and(|m| m.trim_end_matches('\n') == line);
+        if !marked {
+            return false;
+        }
+        eprintln!("slot: start guard: {line} did not finish its last start, kept on the shelf");
+        self.name_pending = true;
+        self.hud.toast(Toast::StartFailed, self.now());
+        true
+    }
+}
