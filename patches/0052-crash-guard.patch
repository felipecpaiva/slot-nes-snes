 crates/slot/src/app.rs             |   2 +
 crates/slot/src/app/start_guard.rs |  16 +++
 crates/slot/tests/crash_guard.rs   | 173 +++++++++++++++++++++++++++++
 7 files changed, 204 insertions(+), 1 deletion(-)
 create mode 100644 crates/slot-ui/src/start_toast.rs
 create mode 100644 crates/slot/src/app/start_guard.rs
 create mode 100644 crates/slot/tests/crash_guard.rs

