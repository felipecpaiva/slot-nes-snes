diff --git a/crates/slot/tests/crash_guard.rs b/crates/slot/tests/crash_guard.rs
new file mode 100644
index 0000000..cdbdf06
--- /dev/null
+++ b/crates/slot/tests/crash_guard.rs
@@ -0,0 +1,149 @@
+mod common;
+
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use common::{tmp_root_with_carts, StubSnapshot};
+use slot::app::{App, Phase};
+use slot::persist;
+use slot::session::Session;
+use slot_store::{write_slot_state, Core, Platform, SlotState};
+use slot_ui::Toast;
+
+fn left_running(stem: &str) -> tempfile::TempDir {
+    let d = tmp_root_with_carts(&["Emerald", "Fusion"]);
+    seat(d.path(), stem);
+    persist::flush(
+        d.path(),
+        Platform::Gba,
+        Core::Mgba,
+        "Emerald",
+        Some(&500_000u64.to_le_bytes()),
+        None,
+    )
+    .expect("flush");
+    d
+}
+
+fn seat(root: &Path, stem: &str) {
+    write_slot_state(
+        root,
+        &SlotState {
+            cart: Some(stem.into()),
+            cart_platform: Some(Platform::Gba),
+            clock_set: true,
+            utc_offset_min: 0,
+            ..Default::default()
+        },
+    )
+    .expect("write slot.state");
+}
+
+fn crash_while_starting(root: &Path) {
+    let s = Session::boot(root.to_path_buf());
+    assert!(s.has_core(), "the game was not started");
+}
+
+fn inserting(a: &App) -> Option<&str> {
+    match a.phase() {
+        Phase::Inserting { cart, .. } => Some(cart),
+        _ => None,
+    }
+}
+
+#[test]
+fn a_start_that_never_got_through_leaves_the_cart_on_the_shelf() {
+    let d = left_running("Emerald");
+    crash_while_starting(d.path());
+
+    let a = App::boot(d.path());
+
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.selected_stem(), Some("Emerald"));
+    assert_eq!(a.toast(), Some(Toast::StartFailed));
+}
+
+#[test]
+fn a_start_that_never_got_through_keeps_its_resume_state() {
+    let d = left_running("Emerald");
+    crash_while_starting(d.path());
+
+    let _ = App::boot(d.path());
+
+    assert_eq!(
+        persist::read_resume(d.path(), Platform::Gba, Core::Mgba, "Emerald"),
+        Some(500_000u64.to_le_bytes().to_vec())
+    );
+}
+
+#[test]
+fn a_cart_kept_on_the_shelf_stays_there_until_a_start_gets_through() {
+    let d = left_running("Emerald");
+    crash_while_starting(d.path());
+
+    let _ = App::boot(d.path());
+    let a = App::boot(d.path());
+
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+}
+
+#[test]
+fn a_start_that_runs_its_first_frames_resumes_on_the_next_boot() {
+    let d = left_running("Emerald");
+    let mut s = Session::boot(d.path().to_path_buf());
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while s.frames_published() < 300 {
+        assert!(Instant::now() < deadline, "the game never ran 300 frames");
+        s.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    s.update(1.0 / 60.0);
+    drop(s);
+
+    let a = App::boot(d.path());
+
+    assert_eq!(inserting(&a), Some("Emerald"));
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn a_flush_before_the_first_frames_also_clears_the_mark() {
+    let d = left_running("Emerald");
+    let mut a = App::boot(d.path());
+    a.mark_start(Platform::Gba, "Emerald");
+    a.set_snapshot(StubSnapshot::boxed());
+    a.on_core_ready();
+    for _ in 0..600 {
+        if matches!(a.phase(), Phase::Playing { .. }) {
+            break;
+        }
+        a.update(1.0 / 60.0);
+    }
+    a.flush_resume();
+    drop(a);
+
+    let a = App::boot(d.path());
+
+    assert_eq!(inserting(&a), Some("Emerald"));
+}
+
+#[test]
+fn the_mark_holds_back_only_the_cart_it_names() {
+    let d = left_running("Emerald");
+    crash_while_starting(d.path());
+    seat(d.path(), "Fusion");
+
+    let a = App::boot(d.path());
+
+    assert_eq!(inserting(&a), Some("Fusion"));
+}
+
+#[test]
+fn the_start_failed_banner_uploads_in_its_own_place() {
+    let every = Toast::every();
+    assert_eq!(
+        every.get(Toast::StartFailed.index()),
+        Some(&Toast::StartFailed)
+    );
+    assert_eq!(Toast::StartFailed.text(), "Last start failed");
+}
