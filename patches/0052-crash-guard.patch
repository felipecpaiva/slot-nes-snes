index 0000000..203a03c
--- /dev/null
+++ b/crates/slot/src/app/start_guard.rs
@@ -0,0 +1,16 @@
+use slot_store::Platform;
+use slot_ui::Toast;
+
+use super::App;
+
+impl App {
+    // Called from upstream's start_after_a_crash (loading_mark.rs, v1.9.0): the shelf comes up with
+    // the cart that took slot down selected, and the banner says why (ADR 0084, ADR 0109).
+    pub(super) fn show_start_failed(&mut self, stem: &str, platform: Option<Platform>) {
+        if let Some((at, i)) = self.seat_of(stem, platform) {
+            self.shelf_at = at;
+            self.shelf_mut().select(i);
+        }
+        self.hud.toast(Toast::StartFailed, self.now());
+    }
+}
diff --git a/crates/slot/tests/crash_guard.rs b/crates/slot/tests/crash_guard.rs
new file mode 100644
index 0000000..b956292
--- /dev/null
+++ b/crates/slot/tests/crash_guard.rs
@@ -0,0 +1,173 @@
+// ADR 0084 and ADR 0109: the detection is upstream's (loading_mark.rs, v1.9.0), the banner and the
+// selected cart are ours. Every test here boots through upstream's mark, so a future upstream change
+// to the mark breaks one of them instead of silently dropping the guard.
+mod common;
+
+use std::path::Path;
+
+use common::{tmp_root_with_carts, StubSnapshot};
+use slot::app::{App, Phase};
+use slot::loading_mark::LoadingMark;
+use slot::persist;
+use slot_store::{write_slot_state, Core, Platform, SlotState};
+use slot_ui::Toast;
+
+fn left_running(stems: &[&str], seated: &str) -> tempfile::TempDir {
+    let d = tmp_root_with_carts(stems);
+    seat(d.path(), seated);
+    persist::flush(
+        d.path(),
+        Platform::Gba,
+        Core::Mgba,
+        seated,
+        Some(&500_000u64.to_le_bytes()),
+        None,
+    )
+    .expect("flush");
+    d
+}
+
+fn seat(root: &Path, stem: &str) {
+    write_slot_state(
+        root,
+        &SlotState {
+            cart: Some(stem.into()),
+            cart_platform: Some(Platform::Gba),
+            clock_set: true,
+            utc_offset_min: 0,
+            ..Default::default()
+        },
+    )
+    .expect("write slot.state");
+}
+
+fn mark_in(run: &tempfile::TempDir) -> LoadingMark {
+    LoadingMark::in_dir(run.path())
+}
+
+fn inserting(a: &App) -> Option<&str> {
+    match a.phase() {
+        Phase::Inserting { cart, .. } => Some(cart),
+        _ => None,
+    }
+}
+
+fn crashed_on(root: &Path, stem: &str, run: &tempfile::TempDir) {
+    let mark = mark_in(run);
+    let a = App::boot_marked(root, Some(mark.clone()));
+    assert_eq!(inserting(&a), Some(stem), "the cart was not put back");
+    assert_eq!(mark.left().as_deref(), Some(stem), "no mark while it loads");
+}
+
+#[test]
+fn a_start_that_never_got_through_leaves_the_cart_on_the_shelf() {
+    let d = left_running(&["Emerald", "Fusion"], "Emerald");
+    let run = tempfile::tempdir().unwrap();
+    crashed_on(d.path(), "Emerald", &run);
+
+    let a = App::boot_marked(d.path(), Some(mark_in(&run)));
+
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.selected_stem(), Some("Emerald"));
+    assert_eq!(a.toast(), Some(Toast::StartFailed));
+}
+
+#[test]
+fn a_single_cart_that_never_got_through_still_shows_the_shelf() {
+    let d = left_running(&["Emerald"], "Emerald");
+    let run = tempfile::tempdir().unwrap();
+    crashed_on(d.path(), "Emerald", &run);
+
+    let a = App::boot_marked(d.path(), Some(mark_in(&run)));
+
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.selected_stem(), Some("Emerald"));
+    assert_eq!(a.toast(), Some(Toast::StartFailed));
+}
+
+#[test]
+fn a_start_that_never_got_through_moves_its_resume_state_aside() {
+    let d = left_running(&["Emerald", "Fusion"], "Emerald");
+    let run = tempfile::tempdir().unwrap();
+    crashed_on(d.path(), "Emerald", &run);
+
+    let _ = App::boot_marked(d.path(), Some(mark_in(&run)));
+
+    assert_eq!(
+        persist::read_resume(d.path(), Platform::Gba, Core::Mgba, "Emerald")
+            .ok()
+            .flatten(),
+        None,
+        "the state it crashed on would load again"
+    );
+    let kept = std::fs::read_dir(d.path().join("States/GBA/Emerald"))
+        .map(|dir| {
+            dir.flatten()
+                .filter(|e| e.file_name().to_string_lossy().starts_with("resume-refused-"))
+                .count()
+        })
+        .unwrap_or(0);
+    assert_eq!(kept, 1, "the state was deleted, not moved aside");
+}
+
+#[test]
+fn a_cart_kept_on_the_shelf_stays_there_until_a_start_gets_through() {
+    let d = left_running(&["Emerald", "Fusion"], "Emerald");
+    let run = tempfile::tempdir().unwrap();
+    crashed_on(d.path(), "Emerald", &run);
+
+    let _ = App::boot_marked(d.path(), Some(mark_in(&run)));
+    let a = App::boot_marked(d.path(), Some(mark_in(&run)));
+
+    assert!(matches!(a.phase(), Phase::Shelf), "{:?}", a.phase());
+    assert_eq!(a.toast(), None, "the banner outlived the boot it explained");
+}
+
+#[test]
+fn ten_seconds_of_play_lets_the_next_boot_resume_without_a_banner() {
+    let d = left_running(&["Emerald", "Fusion"], "Emerald");
+    let run = tempfile::tempdir().unwrap();
+    let mark = mark_in(&run);
+    let mut a = App::boot_marked(d.path(), Some(mark.clone()));
+    a.set_snapshot(StubSnapshot::boxed());
+    a.on_core_ready();
+    for _ in 0..120 {
+        a.update(1.0 / 60.0);
+    }
+    assert!(matches!(a.phase(), Phase::Playing { .. }));
+    let now = a.now();
+    a.tick_ms(now + 10_000);
+    assert_eq!(mark.left(), None, "a settled game left the mark down");
+    drop(a);
+
+    let a = App::boot_marked(d.path(), Some(mark));
+
+    assert_eq!(inserting(&a), Some("Emerald"));
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn a_clean_stop_lets_the_next_boot_resume() {
+    let d = left_running(&["Emerald", "Fusion"], "Emerald");
+    let run = tempfile::tempdir().unwrap();
+    let mark = mark_in(&run);
+    let mut a = App::boot_marked(d.path(), Some(mark.clone()));
+    assert_eq!(mark.left().as_deref(), Some("Emerald"));
+    a.clear_loading_mark();
+    drop(a);
+
+    let a = App::boot_marked(d.path(), Some(mark));
+
+    assert_eq!(inserting(&a), Some("Emerald"));
+    assert_eq!(a.toast(), None);
+}
+
+#[test]
+fn the_start_failed_banner_uploads_in_its_own_place() {
+    let every = Toast::every();
+    assert_eq!(
+        every.get(Toast::StartFailed.index()),
+        Some(&Toast::StartFailed)
+    );
+    assert_eq!(Toast::StartFailed.text(), "Last start failed");
+}
