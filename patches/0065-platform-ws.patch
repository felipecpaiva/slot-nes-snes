+mod common;
+mod core_common;
+mod real_seat;
+mod wswan_common;
+
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use slot::app::Phase;
+use slot_input::{Btn, RawEvent};
+use slot_store::{Core, Platform};
+use wswan_common::{assert_red_box, cart, cygne, Code, Save};
+
+const STEM: &str = "Klonoa";
+
+#[test]
+fn a_ws_cart_seats_on_cygne_through_a_real_session() {
+    let _g = core_lock();
+    let Some(dylib) = cygne() else {
+        return;
+    };
+    let roms = tempfile::tempdir().expect("tempdir");
+    let rom = cart(roms.path(), STEM, Code::Paint, Save::None, false);
+    let root = real_seat::rooted(Platform::Ws, STEM, &rom, &dylib);
+    let session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::MednafenWswan);
+    assert_eq!(session.app().playing_platform(), Platform::Ws);
+    assert!(!session.app().vertical());
+    let frame = session
+        .emu()
+        .expect("no core in the slot")
+        .latest_frame()
+        .expect("nothing was published");
+    assert_red_box(&frame, (240, 160), (224, 144));
+}
+
+#[test]
+fn a_short_file_lists_but_does_not_seat() {
+    let _g = core_lock();
+    let Some(dylib) = cygne() else {
+        return;
+    };
+    let roms = tempfile::tempdir().expect("tempdir");
+    let rom = roms.path().join("Short.ws");
+    std::fs::write(&rom, vec![0u8; 0x8000]).expect("write short rom");
+    let root = real_seat::rooted(Platform::Ws, "Short", &rom, &dylib);
+    let mut session = slot::session::Session::boot_with(
+        root.path().to_path_buf(),
+        Box::new(slot::audio::StubSink::draining()),
+    );
+    assert!(session
+        .app()
+        .carts()
+        .any(|c| c.platform == Platform::Ws && c.stem == "Short"));
+    session.feed([RawEvent::Down(Btn::A)], 16);
+    session.feed([RawEvent::Up(Btn::A)], 32);
+    let mut refused = false;
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while Instant::now() < deadline {
+        session.update(1.0 / 60.0);
+        assert!(
+            !matches!(session.app().phase(), Phase::Playing { .. }),
+            "a 32 KB cart seated"
+        );
+        if matches!(session.app().phase(), Phase::Ejecting { .. }) {
+            refused = true;
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    assert!(refused, "the short cart was never sent back out");
+    assert!(session.emu().is_none());
+}
