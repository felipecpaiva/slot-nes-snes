@@ -0,0 +1,207 @@
+mod common;
+
+use std::path::{Path, PathBuf};
+
+use common::tmp_root;
+use slot_store::ws::{footer, vertical, Footer, MIN_ROM};
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Cart, Core,
+    GameButton, Platform, RetroShader, SegaShaders, Shader, SlotState, WS_SHADER_FILE,
+};
+
+fn image(dir: &Path, name: &str, len: usize, colour: u8, save: u8, flags: u8) -> PathBuf {
+    let mut rom = vec![0u8; len];
+    rom[len - 9] = colour;
+    rom[len - 5] = save;
+    rom[len - 4] = flags;
+    let path = dir.join(name);
+    std::fs::write(&path, rom).expect("write rom");
+    path
+}
+
+fn ws(root: &Path) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == Platform::Ws)
+        .collect()
+}
+
+#[test]
+fn wonderswan_is_the_eleventh_shelf_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES[10], Platform::Ws);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::Ws.name(), "Bandai WonderSwan");
+    assert_eq!(Platform::Ws.dir_name(), "WS");
+    assert_eq!(Platform::Ws.picture(), (224, 144));
+    for name in ["x.ws", "x.wsc", "X.WSC"] {
+        assert!(Platform::Ws.accepts(Path::new(name)), "{name}");
+    }
+    for name in ["x.pc2", "x.wsr", "x.bin"] {
+        assert!(!Platform::Ws.accepts(Path::new(name)), "{name}");
+    }
+}
+
+#[test]
+fn a_wsc_cart_lands_on_the_ws_shelf() {
+    let d = tmp_root();
+    let dir = d.path().join("Games/WS");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    image(&dir, "Gunpey (Japan).ws", 0x10000, 0, 0, 1);
+    image(&dir, "Final Fantasy (Japan).wsc", 0x10000, 1, 0x02, 0);
+    image(&dir, "._Final Fantasy (Japan).wsc", 0x10000, 1, 0, 0);
+    let carts = ws(d.path());
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(stems, ["Final Fantasy (Japan)", "Gunpey (Japan)"]);
+    assert!(carts
+        .iter()
+        .all(|c| c.title.is_empty() && c.code.is_empty()));
+    assert!(carts.iter().all(|c| c.rom.starts_with(&dir)));
+}
+
+#[test]
+fn the_footer_gives_colour_save_type_and_vertical() {
+    let d = tmp_root();
+    for len in [0x10000, 0x100000] {
+        let tall = image(d.path(), "tall.ws", len, 0, 0x10, 0x05);
+        assert_eq!(
+            footer(&tall),
+            Some(Footer {
+                colour: false,
+                save_type: 0x10,
+                vertical: true
+            }),
+            "{len}"
+        );
+        assert!(vertical(&tall));
+        let wide = image(d.path(), "wide.wsc", len, 1, 0x02, 0x04);
+        assert_eq!(
+            footer(&wide),
+            Some(Footer {
+                colour: true,
+                save_type: 0x02,
+                vertical: false
+            }),
+            "{len}"
+        );
+        assert!(!vertical(&wide));
+    }
+}
+
+#[test]
+fn a_short_file_lists_but_has_no_footer() {
+    let d = tmp_root();
+    let dir = d.path().join("Games/WS");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let short = image(&dir, "Short.ws", MIN_ROM as usize - 1, 1, 0x01, 0x01);
+    assert_eq!(footer(&short), None);
+    assert!(!vertical(&short));
+    assert_eq!(footer(&dir.join("Missing.ws")), None);
+    let carts = ws(d.path());
+    assert_eq!(carts.len(), 1);
+    assert_eq!(carts[0].stem, "Short");
+}
+
+#[test]
+fn wonderswan_hands_the_game_l_r_x_and_y_and_offers_no_crop() {
+    assert!(!Platform::Ws.owns_shoulders());
+    assert!(Platform::Ws.passes_xy_through());
+    assert!(Platform::Ws.select_x_toggles_picture());
+    assert!(Platform::Ws.owns_triggers());
+    assert!(Platform::Ws.rewinds());
+    assert!(!Platform::Ws.stretch_crops_height());
+    assert!(!Platform::Ws.follows_frame_width());
+    assert!(!Platform::Ws.fills_canvas());
+    assert!(!Platform::Ws.swaps_discs());
+    assert!(!Platform::Ws.has_gb_palettes());
+    assert_eq!(Platform::Ws.overscan(), (0, 0));
+    assert_eq!(Platform::Ws.picker_cores(), None);
+    assert_eq!(Platform::Ws.shader_choices(), &Shader::GG);
+    assert_eq!(GameButton::of(Platform::Ws), &GameButton::ALL);
+}
+
+#[test]
+fn wonderswan_runs_on_beetle_cygne_alone_named_after_its_dylib_with_the_wswan_prefix() {
+    assert_eq!(Core::default_for(Platform::Ws), Core::MednafenWswan);
+    assert_eq!(Core::EVERY[9], Core::MednafenWswan);
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Ws),
+            core == Core::MednafenWswan,
+            "{core:?}"
+        );
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::MednafenWswan.runs(platform),
+            platform == Platform::Ws,
+            "{platform:?}"
+        );
+    }
+    assert_eq!(Core::MednafenWswan.as_str(), "mednafen_wswan");
+    assert_eq!(Core::MednafenWswan.option_prefix(), "wswan");
+    assert_eq!(Core::parse("mednafen_wswan"), Some(Core::MednafenWswan));
+    assert_eq!(
+        Core::MednafenWswan.pair(),
+        (Core::MednafenWswan, Core::MednafenWswan)
+    );
+    assert!(!Core::MednafenWswan.has_colour_correction());
+}
+
+#[test]
+fn a_horizontal_cart_draws_on_the_gba_canvas_and_a_vertical_one_on_360_by_240() {
+    let ws = Core::MednafenWswan;
+    assert_eq!(ws.canvas(Platform::Ws), (240, 160));
+    assert_eq!(ws.game_canvas(Platform::Ws, false), (240, 160));
+    assert_eq!(ws.game_canvas(Platform::Ws, true), (360, 240));
+    assert_eq!(ws.canvas_f32(Platform::Ws, true), (360.0, 240.0));
+    for core in Core::EVERY {
+        for platform in Platform::SHELVES.into_iter().filter(|p| *p != Platform::Ws) {
+            assert_eq!(
+                core.game_canvas(platform, true),
+                core.canvas(platform),
+                "{core:?} {platform:?}"
+            );
+        }
+    }
+}
+
+#[test]
+fn a_wonderswan_game_resumes_as_a_wonderswan_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Gunpey (Japan)".into()),
+        cart_platform: Some(Platform::Ws),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=ws"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn the_wonderswan_shader_lives_in_its_own_file_and_takes_lcd3x() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        ws: Shader::Lcd3x,
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(WS_SHADER_FILE)).expect("read"),
+        "ws=lcd3x\n"
+    );
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+    std::fs::write(
+        d.path().join("Config").join(WS_SHADER_FILE),
+        "ws=crt-pi\nws=simpletex\n",
+    )
+    .expect("write");
+    assert_eq!(
+        read_sega_shaders(d.path()).ws,
+        Shader::Retro(RetroShader::CrtPi)
+    );
+}
