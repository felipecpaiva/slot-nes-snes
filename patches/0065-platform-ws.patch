+use std::path::Path;
+
+use slot_retro::RetroCore;
+use slot_store::{Core, Platform};
+
+pub fn vertical(platform: Platform, rom: &Path) -> bool {
+    platform == Platform::Ws && slot_store::ws::vertical(rom)
+}
+
+pub fn prepare(core: &mut dyn RetroCore, platform: Platform, vertical: bool) {
+    if platform != Platform::Ws {
+        return;
+    }
+    let (w, h) = Core::MednafenWswan.game_canvas(platform, vertical);
+    core.set_canvas(w, h);
+}
