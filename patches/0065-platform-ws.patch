+mod common;
+mod core_common;
+mod real_seat;
+mod wswan_common;
+
+use std::path::{Path, PathBuf};
+
+use common::core_lock;
+use slot::app::Phase;
+use slot::persist::Snapshot;
+use slot::session::Session;
+use slot_input::{Btn, RawEvent};
+use slot_store::{read_slot_state, write_slot_state, Platform};
+use wswan_common::{assert_red_box, cart, cygne, Code, Save, MARK};
+
+const STEM: &str = "Final Fantasy";
+
+fn sav(root: &Path) -> PathBuf {
+    root.join("Saves/WS").join(format!("{STEM}.sav"))
+}
+
+fn seated(code: Code, save: Save) -> Option<tempfile::TempDir> {
+    let dylib = cygne()?;
+    let roms = tempfile::tempdir().expect("tempdir");
+    let rom = cart(roms.path(), STEM, code, save, false);
+    let root = real_seat::rooted(Platform::Ws, STEM, &rom, &dylib);
+    cart(
+        &root.path().join("Games/WS"),
+        "Zzz",
+        Code::Paint,
+        Save::None,
+        false,
+    );
+    let mut state = read_slot_state(root.path());
+    state.eject_save = false;
+    write_slot_state(root.path(), &state).expect("write slot.state");
+    Some(root)
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+fn played_until_marked(root: &Path) -> Session {
+    let session = real_seat::play(root, true);
+    let ram = session
+        .emu()
+        .expect("no core")
+        .snapshot()
+        .save_ram()
+        .expect("an SRAM cart has save ram");
+    assert_eq!(ram.len(), 8 * 1024);
+    assert_eq!(ram[0], MARK);
+    session
+}
+
+#[test]
+fn a_lid_close_mid_game_writes_saves_ws_sav() {
+    let _g = core_lock();
+    let Some(root) = seated(Code::WriteSram, Save::Sram8k) else {
+        return;
+    };
+    let mut session = played_until_marked(root.path());
+    assert!(!sav(root.path()).exists());
+    session.app_mut().flush_resume();
+    let written = std::fs::read(sav(root.path())).expect("no Saves/WS .sav after the flush");
+    assert_eq!(written.len(), 8 * 1024);
+    assert_eq!(written[0], MARK);
+}
+
+#[test]
+fn an_eject_then_reseat_reads_the_save_back() {
+    let _g = core_lock();
+    let Some(root) = seated(Code::WriteSram, Save::Sram8k) else {
+        return;
+    };
+    let mut first = played_until_marked(root.path());
+    eject(&mut first);
+    drop(first);
+    assert_eq!(
+        std::fs::read(sav(root.path())).expect("no .sav after eject")[0],
+        MARK
+    );
+    let reader = cart(root.path(), "reader", Code::ReadSram, Save::Sram8k, false);
+    std::fs::copy(
+        reader,
+        root.path().join("Games/WS").join(format!("{STEM}.ws")),
+    )
+    .expect("swap in the reader cart");
+    let second = real_seat::play(root.path(), true);
+    let frame = second
+        .emu()
+        .expect("no core")
+        .latest_frame()
+        .expect("nothing was published");
+    assert_red_box(&frame, (240, 160), (224, 144));
+}
+
+#[test]
+fn a_cart_with_no_save_type_writes_no_sav() {
+    let _g = core_lock();
+    let Some(root) = seated(Code::Paint, Save::None) else {
+        return;
+    };
+    let mut session = real_seat::play(root.path(), true);
+    assert_eq!(session.emu().expect("no core").snapshot().save_ram(), None);
+    session.app_mut().flush_resume();
+    eject(&mut session);
+    assert!(!sav(root.path()).exists());
+}
