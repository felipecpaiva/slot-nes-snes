@@ -0,0 +1,97 @@
+#![allow(dead_code)]
+
+use std::path::{Path, PathBuf};
+
+pub const MARK: u8 = 0x5a;
+pub const RED: u16 = 0x0f00;
+pub const BLUE: u16 = 0x000f;
+pub const NATIVE_FPS: f64 = 3_072_000.0 / (159.0 * 256.0);
+pub const SIXTY_FPS: f64 = NATIVE_FPS * 4.0 / 5.0;
+
+pub fn cygne() -> Option<PathBuf> {
+    crate::core_common::require_core("mednafen_wswan")
+}
+
+#[derive(Clone, Copy)]
+pub enum Save {
+    None = 0x00,
+    Sram8k = 0x01,
+    Eeprom128 = 0x10,
+    Eeprom2k = 0x20,
+}
+
+#[derive(Clone, Copy, PartialEq)]
+pub enum Code {
+    Paint,
+    WriteSram,
+    ReadSram,
+}
+
+pub fn cart(dir: &Path, stem: &str, code: Code, save: Save, vertical: bool) -> PathBuf {
+    cart_named(dir, &format!("{stem}.wsc"), code, save, vertical)
+}
+
+pub fn cart_named(dir: &Path, name: &str, code: Code, save: Save, vertical: bool) -> PathBuf {
+    let mut rom = vec![0u8; 0x10000];
+    let mut c: Vec<u8> = vec![0xb0, 0x80, 0xe6, 0x60];
+    let sram_ds = [0xb8, 0x00, 0x10, 0x8e, 0xd8];
+    let color = match code {
+        Code::WriteSram => {
+            c.extend(sram_ds);
+            c.extend([0xc6, 0x06, 0x00, 0x00, MARK]);
+            RED
+        }
+        Code::ReadSram => {
+            c.extend(sram_ds);
+            c.extend([0xbb]);
+            c.extend(BLUE.to_le_bytes());
+            c.extend([0xa0, 0x00, 0x00, 0x3c, MARK, 0x75, 0x03]);
+            c.extend([0xbb]);
+            c.extend(RED.to_le_bytes());
+            c.extend([0x31, 0xc0, 0x8e, 0xd8]);
+            c.extend([0x89, 0x1e, 0x00, 0xfe]);
+            c.extend([0xeb, 0xfe]);
+            rom[..c.len()].copy_from_slice(&c);
+            0
+        }
+        Code::Paint => RED,
+    };
+    if code != Code::ReadSram {
+        c.extend([0x31, 0xc0, 0x8e, 0xd8, 0xb8]);
+        c.extend(color.to_le_bytes());
+        c.extend([0xa3, 0x00, 0xfe, 0xeb, 0xfe]);
+        rom[..c.len()].copy_from_slice(&c);
+    }
+    rom[0xfff0..0xfff5].copy_from_slice(&[0xea, 0x00, 0x00, 0x00, 0xf0]);
+    rom[0xfff7] = 1;
+    rom[0xfffa] = 0x01;
+    rom[0xfffb] = save as u8;
+    rom[0xfffc] = u8::from(vertical);
+    let sum = rom[..0xfffe]
+        .iter()
+        .fold(0u16, |s, &b| s.wrapping_add(b.into()));
+    rom[0xfffe..].copy_from_slice(&sum.to_le_bytes());
+    let path = dir.join(name);
+    std::fs::write(&path, rom).unwrap();
+    path
+}
+
+pub fn red(px: &[u8]) -> bool {
+    px[2] > 200 && px[1] < 60 && px[0] < 60
+}
+
+pub fn assert_red_box(video: &[u8], canvas: (usize, usize), (w, h): (usize, usize)) {
+    assert_eq!(video.len(), canvas.0 * canvas.1 * 4);
+    let (left, top) = ((canvas.0 - w) / 2, (canvas.1 - h) / 2);
+    for y in 0..canvas.1 {
+        for x in 0..canvas.0 {
+            let at = (y * canvas.0 + x) * 4;
+            let px = &video[at..at + 3];
+            if (left..left + w).contains(&x) && (top..top + h).contains(&y) {
+                assert!(red(px), "({x}, {y}) is {px:?}");
+            } else {
+                assert_eq!(px, [0, 0, 0], "({x}, {y})");
+            }
+        }
+    }
+}
