@@ -0,0 +1,32 @@
+use std::fs::File;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::Path;
+
+pub const MIN_ROM: u64 = 0x10000;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub struct Footer {
+    pub colour: bool,
+    pub save_type: u8,
+    pub vertical: bool,
+}
+
+pub fn footer(rom: &Path) -> Option<Footer> {
+    let mut file = File::open(rom).ok()?;
+    let len = file.metadata().ok()?.len();
+    if len < MIN_ROM {
+        return None;
+    }
+    let mut tail = [0u8; 16];
+    file.seek(SeekFrom::Start(len - 16)).ok()?;
+    file.read_exact(&mut tail).ok()?;
+    Some(Footer {
+        colour: tail[7] != 0,
+        save_type: tail[11],
+        vertical: tail[12] & 1 != 0,
+    })
+}
+
+pub fn vertical(rom: &Path) -> bool {
+    footer(rom).is_some_and(|f| f.vertical)
+}
