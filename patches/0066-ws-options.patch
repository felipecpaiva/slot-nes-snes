From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paiva <felipe.paiva@gmail.com>
Date: Mon, 19 Oct 2026 10:56:55 +0400
Subject: [PATCH] ws-options

Every WonderSwan load sets the options whose unanswered behaviour is a
trap: wswan_60hz_mode (enabled; Beetle Cygne declares enabled but runs
at the native 75.47 fps until it is answered) and wswan_rotate_display
(portrait for a cart whose footer has the vertical bit, landscape for
every other; left on manual, every SELECT press turns the picture). The
keymap is disabled so slot is the only button mapper, and the language,
frameskip, sample rate, colour depth and the owner profile (name from
Mednafen's default, birth date, sex and blood type at the core's own
declared defaults) are pinned so a future pin cannot change them and
the console's internal EEPROM is the same on every boot.

ADR 0064's declared-defaults answer is not extended to Cygne: setting
each key is explicit and testable, and the declared default of
wswan_rotate_display is the trap itself.
---
 crates/slot/src/core_options_policy.rs |  18 +++-
 crates/slot/src/ws_load.rs             |   9 ++
 crates/slot/tests/core_option_keys.rs  |   1 +
 crates/slot/tests/wswan_options.rs     | 114 +++++++++++++++++++++++++
 4 files changed, 140 insertions(+), 2 deletions(-)
 create mode 100644 crates/slot/tests/wswan_options.rs

diff --git a/crates/slot/src/core_options_policy.rs b/crates/slot/src/core_options_policy.rs
index b586da2..bd4b71c 100644
--- a/crates/slot/src/core_options_policy.rs
+++ b/crates/slot/src/core_options_policy.rs
@@ -45,6 +45,20 @@ const PCE_FAST: [(&str, &str); 9] = [
     ("pce_fast_ocmultiplier", "1"),
 ];
 
+const MEDNAFEN_WSWAN: [(&str, &str); 11] = [
+    ("wswan_rotate_keymap", "disabled"),
+    ("wswan_language", "english"),
+    ("wswan_frameskip", "disabled"),
+    ("wswan_sound_sample_rate", "44100"),
+    ("wswan_gfx_colors", "16bit"),
+    ("wswan_name_source", "default"),
+    ("wswan_birth_year", "1989"),
+    ("wswan_birth_month", "6"),
+    ("wswan_birth_day", "23"),
+    ("wswan_sex", "female"),
+    ("wswan_blood", "o"),
+];
+
 pub fn answers_declared_defaults(which: Core) -> bool {
     match which {
         Core::PcsxRearmed => true,
@@ -107,10 +121,10 @@ pub fn apply_policy_options(core: &mut LibretroCore, which: Core) {
         | Core::Fceumm
         | Core::Snes9x
         | Core::Nestopia
-        | Core::Snes9x2005Plus
-        | Core::MednafenWswan => &[],
+        | Core::Snes9x2005Plus => &[],
         Core::PcsxRearmed => &PCSX_REARMED,
         Core::MednafenPceFast => &PCE_FAST,
+        Core::MednafenWswan => &MEDNAFEN_WSWAN,
     };
     for (key, value) in fixed {
         core.set_option(key, value);
diff --git a/crates/slot/src/ws_load.rs b/crates/slot/src/ws_load.rs
index e06473b..c65161a 100644
--- a/crates/slot/src/ws_load.rs
+++ b/crates/slot/src/ws_load.rs
@@ -13,4 +13,13 @@ pub fn prepare(core: &mut dyn RetroCore, platform: Platform, vertical: bool) {
     }
     let (w, h) = Core::MednafenWswan.game_canvas(platform, vertical);
     core.set_canvas(w, h);
+    core.set_option("wswan_60hz_mode", "enabled");
+    core.set_option("wswan_rotate_display", rotation(vertical));
+}
+
+pub fn rotation(vertical: bool) -> &'static str {
+    match vertical {
+        true => "portrait",
+        false => "landscape",
+    }
 }
