diff --git a/crates/slot/tests/wswan_options.rs b/crates/slot/tests/wswan_options.rs
new file mode 100644
index 0000000..501cff3
--- /dev/null
+++ b/crates/slot/tests/wswan_options.rs
@@ -0,0 +1,114 @@
+mod common;
+mod core_common;
+mod real_seat;
+mod wswan_common;
+
+use std::path::Path;
+
+use common::core_lock;
+use slot::core::{apply_core_options, open_core};
+use slot_retro::{ButtonMask, LibretroCore, RetroCore};
+use slot_store::{Core, Platform};
+use wswan_common::{assert_red_box, cart, cygne, Code, Save, SIXTY_FPS};
+
+fn opened(vertical: bool) -> Option<(tempfile::TempDir, Box<dyn RetroCore>)> {
+    let dylib = cygne()?;
+    let roms = tempfile::tempdir().expect("tempdir");
+    let rom = cart(roms.path(), "Game", Code::Paint, Save::None, vertical);
+    let root = real_seat::rooted(Platform::Ws, "Game", &rom, &dylib);
+    let rom = root.path().join("Games/WS/Game.ws");
+    let tall = slot::ws_load::vertical(Platform::Ws, &rom);
+    assert_eq!(tall, vertical);
+    let mut core = open_core(
+        root.path(),
+        Core::MednafenWswan,
+        Platform::Ws,
+        "",
+        false,
+        None,
+        None,
+    )
+    .core;
+    slot::ws_load::prepare(core.as_mut(), Platform::Ws, tall);
+    core.load(&rom).expect("Beetle Cygne refused the cart");
+    Some((root, core))
+}
+
+fn run(core: &mut dyn RetroCore, frames: usize, input: ButtonMask) {
+    for _ in 0..frames {
+        core.run_frame(input);
+        let _ = core.take_audio();
+    }
+}
+
+#[test]
+fn a_horizontal_cart_opens_at_60_38_fps_in_landscape_and_select_does_not_turn_it() {
+    let _g = core_lock();
+    let Some((_root, mut core)) = opened(false) else {
+        return;
+    };
+    let fps = core.av_info().fps;
+    assert!((fps - SIXTY_FPS).abs() < 0.01, "{fps} fps");
+    assert_eq!(core.canvas(), (240, 160));
+    run(core.as_mut(), 5, ButtonMask::default());
+    run(core.as_mut(), 1, ButtonMask(ButtonMask::SELECT));
+    run(core.as_mut(), 5, ButtonMask::default());
+    assert_red_box(core.video_xrgb8888(), (240, 160), (224, 144));
+}
+
+#[test]
+fn a_vertical_cart_opens_in_portrait_on_its_360_by_240_canvas() {
+    let _g = core_lock();
+    let Some((_root, mut core)) = opened(true) else {
+        return;
+    };
+    assert_eq!(core.canvas(), (360, 240));
+    run(core.as_mut(), 10, ButtonMask::default());
+    assert_eq!(core.frame_width(), 144);
+    assert_red_box(core.video_xrgb8888(), (360, 240), (144, 224));
+}
+
+fn declared(dylib: &Path) -> LibretroCore {
+    let mut core = LibretroCore::open(dylib).expect("open Beetle Cygne");
+    apply_core_options(
+        &mut core,
+        Core::MednafenWswan,
+        Platform::Ws,
+        "",
+        false,
+        false,
+        None,
+    );
+    slot::ws_load::prepare(&mut core, Platform::Ws, true);
+    core
+}
+
+#[test]
+fn every_option_slot_sets_on_cygne_is_declared_with_that_value() {
+    let _g = core_lock();
+    let Some(dylib) = cygne() else {
+        return;
+    };
+    let core = declared(&dylib);
+    let set = core.options();
+    assert!(set.len() >= 13, "{set:?}");
+    for (key, value) in &set {
+        let values = core
+            .declared_options()
+            .get(key)
+            .unwrap_or_else(|| panic!("Beetle Cygne declares no {key}"));
+        assert!(
+            values.contains(value),
+            "{key}={value} is not one of {values:?}"
+        );
+    }
+    for (key, value) in [
+        ("wswan_60hz_mode", "enabled"),
+        ("wswan_rotate_display", "portrait"),
+        ("wswan_rotate_keymap", "disabled"),
+        ("wswan_frameskip", "disabled"),
+        ("wswan_name_source", "default"),
+    ] {
+        assert_eq!(core.option(key).as_deref(), Some(value), "{key}");
+    }
+}
