index 0000000..4b725b8
--- /dev/null
+++ b/crates/slot/tests/update_slot_hidden.rs
@@ -0,0 +1,35 @@
+//! This build is updated from slot-nes-snes releases, never from upstream's list (ADR 0110): a newer
+//! upstream slot is not offered, a newer BaseOS still is.
+
+use slot::update::{without_slot_offers, Kind, Release, UpdateEvent};
+
+fn release(kind: Kind) -> Release {
+    Release {
+        kind,
+        running: "1.14.0".to_string(),
+        version: "1.15.0".to_string(),
+        url: "https://example.invalid/zip".to_string(),
+        sha256: [0; 32],
+        size: 1,
+    }
+}
+
+#[test]
+fn a_newer_upstream_slot_is_not_offered() {
+    let event = without_slot_offers(UpdateEvent::Available(vec![release(Kind::Slot)]));
+    assert_eq!(event, UpdateEvent::UpToDate);
+}
+
+#[test]
+fn a_newer_baseos_still_is() {
+    let event = without_slot_offers(UpdateEvent::Available(vec![
+        release(Kind::Slot),
+        release(Kind::BaseOs),
+    ]));
+    assert_eq!(event, UpdateEvent::Available(vec![release(Kind::BaseOs)]));
+}
+
+#[test]
+fn nothing_else_is_touched() {
+    assert_eq!(without_slot_offers(UpdateEvent::UpToDate), UpdateEvent::UpToDate);
+}
