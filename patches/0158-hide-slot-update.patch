+/// This build is slot-nes-snes: upstream's list names upstream's zip, which would replace it with plain
+/// slot. Only the BaseOS offer goes through (ADR 0110).
+pub fn without_slot_offers(event: UpdateEvent) -> UpdateEvent {
+    match event {
+        UpdateEvent::Available(offers) => {
+            let kept: Vec<Release> = offers.into_iter().filter(|r| r.kind != Kind::Slot).collect();
+            match kept.is_empty() {
+                true => UpdateEvent::UpToDate,
+                false => UpdateEvent::Available(kept),
+            }
+        }
+        other => other,
+    }
+}
