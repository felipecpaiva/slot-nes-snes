+
+pub fn red_box(video: &[u8], width: usize) -> Option<(usize, usize, usize, usize)> {
+    let mut found: Option<(usize, usize, usize, usize)> = None;
+    for (i, px) in video.chunks_exact(4).enumerate() {
+        if px[2] > 200 && px[1] < 60 && px[0] < 60 {
+            let (x, y) = (i % width, i / width);
+            found = Some(match found {
+                None => (x, y, x, y),
+                Some((x0, y0, x1, y1)) => (x0.min(x), y0.min(y), x1.max(x), y1.max(y)),
+            });
+        }
+    }
+    found
+}
+
+pub fn put_bios(root: &Path, bios: Option<&[u8]>) {
+    let dir = slot::root::bios_dir(root);
+    std::fs::create_dir_all(&dir).unwrap();
+    if let Some(bios) = bios {
+        std::fs::write(dir.join("lynxboot.img"), bios).unwrap();
+    }
+}
diff --git a/crates/slot/tests/lynx_seat.rs b/crates/slot/tests/lynx_seat.rs
new file mode 100644
index 0000000..c9d853b
--- /dev/null
+++ b/crates/slot/tests/lynx_seat.rs
@@ -0,0 +1,47 @@
+mod common;
+mod core_common;
+mod lynx_common;
+mod real_seat;
+
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use core_common::require_core;
+use lynx_common::{lnx_cart, lynx_bios, paint, put_bios, red_box};
+use slot::session::Session;
+use slot_store::{Core, Platform};
+
+fn picture_box(session: &mut Session) -> Option<(usize, usize, usize, usize)> {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    loop {
+        let frame = session.emu().and_then(|e| e.latest_frame());
+        if let Some(found) = frame.as_ref().and_then(|f| red_box(f, 240)) {
+            assert_eq!(frame.map(|f| f.len()), Some(240 * 160 * 4));
+            return Some(found);
+        }
+        if Instant::now() > deadline {
+            return None;
+        }
+        session.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+#[test]
+fn an_lnx_cart_seats_on_beetle_lynx_through_a_real_session() {
+    let _g = core_lock();
+    let Some(bios) = lynx_bios() else {
+        return;
+    };
+    let Some(dylib) = require_core("mednafen_lynx") else {
+        return;
+    };
+    let carts = tempfile::tempdir().unwrap();
+    let rom = lnx_cart(carts.path(), "Paint", 0, paint(0xfb68, false));
+    let root = real_seat::rooted(Platform::Lynx, "Paint", &rom, &dylib);
+    put_bios(root.path(), Some(&bios));
+    let mut session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::MednafenLynx);
+    assert_eq!(session.app().playing_platform(), Platform::Lynx);
+    assert_eq!(picture_box(&mut session), Some((40, 29, 199, 130)));
+}
