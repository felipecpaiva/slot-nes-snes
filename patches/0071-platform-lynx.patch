diff --git a/crates/slot-store/tests/lynx_platform.rs b/crates/slot-store/tests/lynx_platform.rs
new file mode 100644
index 0000000..fc7d5c5
--- /dev/null
+++ b/crates/slot-store/tests/lynx_platform.rs
@@ -0,0 +1,163 @@
+mod common;
+
+use std::path::{Path, PathBuf};
+
+use common::tmp_root;
+use slot_store::lynx::{header_turn, loads_headerless, title, Turn};
+use slot_store::{scan, Core, Platform, Shader};
+
+fn lnx(title: &[u8], turn: u8, version: u16) -> Vec<u8> {
+    let mut rom = vec![0u8; 64];
+    rom[..4].copy_from_slice(b"LYNX");
+    rom[4..6].copy_from_slice(&0x0200u16.to_le_bytes());
+    rom[8..10].copy_from_slice(&version.to_le_bytes());
+    rom[10..10 + title.len()].copy_from_slice(title);
+    rom[58] = turn;
+    rom.extend(vec![0u8; 128 * 1024]);
+    rom
+}
+
+fn write(root: &Path, name: &str, bytes: &[u8]) -> PathBuf {
+    let dir = root.join("Games/Lynx");
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join(name);
+    std::fs::write(&path, bytes).unwrap();
+    path
+}
+
+#[test]
+fn lynx_is_the_last_shelf_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES.last(), Some(&Platform::Lynx));
+    assert_eq!(Platform::ALL.len(), 3);
+}
+
+#[test]
+fn lynx_has_its_own_name_folder_extensions_and_picture() {
+    assert_eq!(Platform::Lynx.name(), "Atari Lynx");
+    assert_eq!(Platform::Lynx.dir_name(), "Lynx");
+    for name in ["x.lnx", "x.lyx", "X.LNX"] {
+        assert!(Platform::Lynx.accepts(Path::new(name)), "{name}");
+    }
+    for name in ["x.o", "x.bll", "x.lyn", "x.zip"] {
+        assert!(!Platform::Lynx.accepts(Path::new(name)), "{name}");
+    }
+    assert_eq!(Platform::Lynx.picture(), (160, 102));
+}
+
+#[test]
+fn lynx_answers_every_policy_question_explicitly() {
+    assert!(!Platform::Lynx.owns_shoulders());
+    assert!(!Platform::Lynx.passes_xy_through());
+    assert!(Platform::Lynx.select_x_toggles_picture());
+    assert!(Platform::Lynx.stretch_crops_height());
+    assert!(!Platform::Lynx.follows_frame_width());
+    assert!(!Platform::Lynx.has_gb_palettes());
+    assert!(Platform::Lynx.rewinds());
+    assert!(!Platform::Lynx.fills_canvas());
+    assert!(!Platform::Lynx.swaps_discs());
+    assert!(Platform::Lynx.owns_triggers());
+    assert_eq!(Platform::Lynx.overscan(), (0, 0));
+    assert_eq!(Platform::Lynx.picker_cores(), None);
+    assert_eq!(Platform::Lynx.shader_choices(), &Shader::RETRO);
+    assert!(!Platform::Lynx.shader_choices().contains(&Shader::Lcd3x));
+}
+
+#[test]
+fn lynx_runs_on_beetle_lynx_alone_on_a_240_by_160_canvas() {
+    assert_eq!(Core::default_for(Platform::Lynx), Core::MednafenLynx);
+    assert_eq!(Core::EVERY.last(), Some(&Core::MednafenLynx));
+    assert_eq!(Core::MednafenLynx.as_str(), "mednafen_lynx");
+    assert_eq!(Core::MednafenLynx.option_prefix(), "lynx");
+    assert_eq!(Core::parse("mednafen_lynx"), Some(Core::MednafenLynx));
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Lynx),
+            core == Core::MednafenLynx,
+            "{core:?}"
+        );
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::MednafenLynx.runs(platform),
+            platform == Platform::Lynx,
+            "{platform:?}"
+        );
+    }
+    assert_eq!(Core::MednafenLynx.canvas(Platform::Lynx), (240, 160));
+    assert!(!Core::MednafenLynx.has_colour_correction());
+}
+
+#[test]
+fn an_lnx_cart_lands_on_the_lynx_shelf_with_its_header_title() {
+    let root = tmp_root();
+    write(
+        root.path(),
+        "chips.lnx",
+        &lnx(b"Chip's Challenge\0\0", 0, 1),
+    );
+    let mut carts = scan(root.path()).unwrap();
+    assert_eq!(carts.len(), 1);
+    assert_eq!(carts[0].platform, Platform::Lynx);
+    assert_eq!(carts[0].stem, "chips");
+    carts[0].read_header();
+    assert_eq!(carts[0].title, "Chip's Challenge");
+}
+
+#[test]
+fn a_space_padded_or_high_bit_title_is_trimmed_and_read_lossily() {
+    let root = tmp_root();
+    let padded = write(root.path(), "a.lnx", &lnx(b"  Klax      ", 0, 1));
+    assert_eq!(title(&padded).as_deref(), Some("Klax"));
+    let high = write(root.path(), "b.lnx", &lnx(b"Caf\xe9", 0, 1));
+    assert_eq!(title(&high).as_deref(), Some("Caf\u{fffd}"));
+    let blank = write(root.path(), "c.lnx", &lnx(b"   ", 0, 1));
+    assert_eq!(title(&blank), None);
+}
+
+#[test]
+fn the_header_rotation_byte_reads_left_right_or_upright() {
+    let root = tmp_root();
+    for (byte, want) in [
+        (0, Turn::Upright),
+        (1, Turn::Left),
+        (2, Turn::Right),
+        (7, Turn::Upright),
+    ] {
+        let rom = write(root.path(), &format!("t{byte}.lnx"), &lnx(b"T", byte, 1));
+        assert_eq!(header_turn(&rom), want, "{byte}");
+    }
+}
+
+#[test]
+fn a_headerless_lyx_lists_under_its_stem() {
+    let root = tmp_root();
+    write(root.path(), "Lexis.lyx", &vec![0u8; 256 * 1024]);
+    write(root.path(), "Odd.lyx", &vec![0u8; 100 * 1024]);
+    write(root.path(), "Short.lnx", b"LYNX");
+    let mut carts = scan(root.path()).unwrap();
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(stems, ["Lexis", "Odd", "Short"]);
+    for cart in &mut carts {
+        cart.read_header();
+        assert_eq!(cart.title, "", "{}", cart.stem);
+        assert_eq!(header_turn(&cart.rom), Turn::Upright);
+    }
+}
+
+#[test]
+fn a_lnx_with_another_header_version_reads_as_headerless() {
+    let root = tmp_root();
+    let rom = write(root.path(), "v2.lnx", &lnx(b"Two", 2, 2));
+    assert_eq!(title(&rom), None);
+    assert_eq!(header_turn(&rom), Turn::Upright);
+}
+
+#[test]
+fn only_128_256_and_512_kb_load_without_a_header() {
+    for kb in [128u64, 256, 512] {
+        assert!(loads_headerless(kb << 10), "{kb}");
+    }
+    for len in [0u64, 64 + (128 << 10), 100 << 10, 1 << 20] {
+        assert!(!loads_headerless(len), "{len}");
+    }
+}
