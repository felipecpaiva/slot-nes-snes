diff --git a/crates/slot-store/src/lynx.rs b/crates/slot-store/src/lynx.rs
new file mode 100644
index 0000000..e68b87f
--- /dev/null
+++ b/crates/slot-store/src/lynx.rs
@@ -0,0 +1,73 @@
+use std::fs::File;
+use std::io::Read;
+use std::path::Path;
+
+pub const HEADER_LEN: usize = 64;
+const MAGIC: &[u8; 4] = b"LYNX";
+const VERSION_OFF: usize = 8;
+const TITLE: std::ops::Range<usize> = 10..42;
+const TURN_OFF: usize = 58;
+const RAW_SIZES: [u64; 3] = [128 << 10, 256 << 10, 512 << 10];
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug, Default)]
+pub enum Turn {
+    #[default]
+    Upright,
+    Left,
+    Right,
+}
+
+pub fn header(rom: &Path) -> Option<[u8; HEADER_LEN]> {
+    let mut head = [0u8; HEADER_LEN];
+    File::open(rom).ok()?.read_exact(&mut head).ok()?;
+    is_header(&head).then_some(head)
+}
+
+pub fn is_header(head: &[u8]) -> bool {
+    head.len() >= HEADER_LEN
+        && head.starts_with(MAGIC)
+        && u16::from_le_bytes([head[VERSION_OFF], head[VERSION_OFF + 1]]) == 1
+}
+
+pub fn title_of(head: &[u8; HEADER_LEN]) -> Option<String> {
+    let field = &head[TITLE];
+    let end = field.iter().position(|b| *b == 0).unwrap_or(field.len());
+    let title = String::from_utf8_lossy(&field[..end]).trim().to_string();
+    (!title.is_empty()).then_some(title)
+}
+
+pub fn turn_of(head: &[u8; HEADER_LEN]) -> Turn {
+    match head[TURN_OFF] {
+        1 => Turn::Left,
+        2 => Turn::Right,
+        _ => Turn::Upright,
+    }
+}
+
+pub fn title(rom: &Path) -> Option<String> {
+    let head = header(rom);
+    if head.is_none() {
+        warn_odd_size(rom);
+    }
+    title_of(&head?)
+}
+
+pub fn header_turn(rom: &Path) -> Turn {
+    header(rom).map_or(Turn::Upright, |head| turn_of(&head))
+}
+
+pub fn loads_headerless(len: u64) -> bool {
+    RAW_SIZES.contains(&len)
+}
+
+fn warn_odd_size(rom: &Path) {
+    let Ok(len) = std::fs::metadata(rom).map(|m| m.len()) else {
+        return;
+    };
+    if !loads_headerless(len) {
+        eprintln!(
+            "slot: lynx: {} has no LNX header and is {len} bytes, Beetle Lynx loads only 128, 256 or 512 KB",
+            rom.display()
+        );
+    }
+}
