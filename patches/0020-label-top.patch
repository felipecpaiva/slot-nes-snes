+pub fn label_cover(cart: &Cart, path: &Path, w: u32, h: u32) -> Option<Vec<u8>> {
+    let (src, sw, sh) = decode_png_bytes(&std::fs::read(path).ok()?)?;
+    let rows = match cart.platform {
+        Platform::Nes | Platform::Snes => {
+            sh.min(((sw as u64 * h as u64 + w as u64 / 2) / w.max(1) as u64).max(1) as u32)
+        }
+        Platform::Gba | Platform::Gb | Platform::Gbc => sh,
+    };
+    let top = src.get(..(sw as usize * rows as usize * 4))?;
+    cover_rgba(top, sw, rows, w, h)
+}
