+++ b/crates/slot/tests/label_top.rs
@@ -0,0 +1,90 @@
+use std::path::{Path, PathBuf};
+
+use slot::label_cache::label_art;
+use slot_store::{Cart, Platform};
+use slot_ui::{cover, label_size};
+
+const TOP: [u8; 3] = [250, 0, 0];
+
+fn scan(path: &Path, w: u32, h: u32) {
+    std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+    let file = std::fs::File::create(path).unwrap();
+    let mut enc = png::Encoder::new(file, w, h);
+    enc.set_color(png::ColorType::Rgb);
+    let mut writer = enc.write_header().unwrap();
+    let px: Vec<u8> = (0..w * h)
+        .flat_map(|i| {
+            let (x, y) = (i % w, i / w);
+            if y < 10 {
+                TOP
+            } else {
+                [(x * 7 % 256) as u8, (y * 5 % 256) as u8, 90]
+            }
+        })
+        .collect();
+    writer.write_image_data(&px).unwrap();
+}
+
+fn cart(root: &Path, platform: Platform, stem: &str, w: u32, h: u32) -> Cart {
+    let label = root.join(format!("Labels/{}/{stem}.png", platform.dir_name()));
+    scan(&label, w, h);
+    Cart {
+        platform,
+        stem: stem.into(),
+        rom: PathBuf::from(format!("Games/{}/{stem}.rom", platform.dir_name())),
+        label: Some(label),
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn top_row(cart: &Cart, art: &[u8]) -> Vec<[u8; 3]> {
+    let (w, _) = label_size(cart);
+    (0..w as usize)
+        .map(|x| [art[x * 4], art[x * 4 + 1], art[x * 4 + 2]])
+        .collect()
+}
+
+#[test]
+fn a_snes_scan_keeps_its_top_rows_in_the_label_box() {
+    let d = tempfile::tempdir().unwrap();
+    let snes = cart(d.path(), Platform::Snes, "Game (USA)", 600, 257);
+    let art = label_art(d.path(), &snes).expect("art");
+    assert!(top_row(&snes, &art).iter().all(|p| *p == TOP));
+    let (w, h) = label_size(&snes);
+    let centred = cover(snes.label.as_deref().unwrap(), w, h).unwrap();
+    assert!(top_row(&snes, &centred).iter().all(|p| *p != TOP));
+}
+
+#[test]
+fn a_famicom_scan_keeps_its_top_rows_in_the_label_box() {
+    let d = tempfile::tempdir().unwrap();
+    let famicom = cart(d.path(), Platform::Nes, "Game (Japan)", 600, 288);
+    let art = label_art(d.path(), &famicom).expect("art");
+    assert!(top_row(&famicom, &art).iter().all(|p| *p == TOP));
+}
+
+#[test]
+fn a_label_already_cut_to_the_box_draws_unchanged() {
+    let d = tempfile::tempdir().unwrap();
+    let snes = cart(d.path(), Platform::Snes, "Game (USA)", 1024, 341);
+    let (w, h) = label_size(&snes);
+    let art = label_art(d.path(), &snes).expect("art");
+    assert_eq!(art, cover(snes.label.as_deref().unwrap(), w, h).unwrap());
+}
+
+#[test]
+fn game_boy_and_gba_labels_keep_the_centred_crop() {
+    let d = tempfile::tempdir().unwrap();
+    for (platform, stem) in [
+        (Platform::Gba, "Tall"),
+        (Platform::Gb, "Tall"),
+        (Platform::Gbc, "Tall"),
+    ] {
+        let tall = cart(d.path(), platform, stem, 300, 600);
+        let (w, h) = label_size(&tall);
+        let art = label_art(d.path(), &tall).expect("art");
+        assert_eq!(art, cover(tall.label.as_deref().unwrap(), w, h).unwrap());
+    }
+}
