new file mode 100644
index 0000000..615535b
--- /dev/null
+++ b/crates/slot/src/arcade_turn.rs
@@ -0,0 +1,181 @@
+use std::path::Path;
+
+use slot_retro::RetroCore;
+use slot_store::{ini, Cart, Core, Platform};
+use slot_ui::{QuickRow, QuickValue};
+
+use crate::card_log::CardWrites;
+
+pub const ARCADE_FILE: &str = "Config/arcade.txt";
+
+const VERTICAL_MODE: &str = "fbneo-vertical-mode";
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum Turn {
+    #[default]
+    Upright,
+    Turned,
+}
+
+impl Turn {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Turn::Upright => "upright",
+            Turn::Turned => "turned",
+        }
+    }
+
+    pub fn quick_value(self) -> QuickValue {
+        match self {
+            Turn::Upright => QuickValue::Upright,
+            Turn::Turned => QuickValue::Turned,
+        }
+    }
+
+    pub fn vertical_mode(self) -> &'static str {
+        match self {
+            Turn::Upright => "disabled",
+            Turn::Turned => "enabled",
+        }
+    }
+
+    fn flipped(self) -> Turn {
+        match self {
+            Turn::Upright => Turn::Turned,
+            Turn::Turned => Turn::Upright,
+        }
+    }
+
+    fn parse(s: &str) -> Option<Turn> {
+        [Turn::Upright, Turn::Turned]
+            .into_iter()
+            .find(|t| t.as_str() == s)
+    }
+}
+
+fn key(platform: Platform) -> Option<&'static str> {
+    match platform {
+        Platform::Cps1 => Some("cps1"),
+        Platform::Cps2 => Some("cps2"),
+        Platform::Gba
+        | Platform::Gb
+        | Platform::Gbc
+        | Platform::Nes
+        | Platform::Snes
+        | Platform::Gg
+        | Platform::Sms
+        | Platform::Md
+        | Platform::Ps1
+        | Platform::Tg16
+        | Platform::Ws
+        | Platform::Lynx
+        | Platform::Ngp
+        | Platform::S32x
+        | Platform::NeoGeo => None,
+    }
+}
+
+fn row_platform(row: QuickRow) -> Option<Platform> {
+    match row {
+        QuickRow::Cps1Rotation => Some(Platform::Cps1),
+        QuickRow::Cps2Rotation => Some(Platform::Cps2),
+        _ => None,
+    }
+}
+
+pub fn read(root: &Path, platform: Platform) -> Turn {
+    let Some(key) = key(platform) else {
+        return Turn::Upright;
+    };
+    let Some(line) = ini::value(root, ARCADE_FILE, key) else {
+        return Turn::Upright;
+    };
+    Turn::parse(&line).unwrap_or_else(|| {
+        eprintln!("slot: arcade.txt: ignoring {key}={line}");
+        Turn::Upright
+    })
+}
+
+pub fn vertical_game(platform: Platform, stem: &str) -> bool {
+    platform.is_arcade() && slot_store::arcade::vertical(platform, stem)
+}
+
+pub fn upright(root: &Path, platform: Platform, stem: &str) -> bool {
+    vertical_game(platform, stem) && read(root, platform) == Turn::Upright
+}
+
+pub fn turned(root: &Path, platform: Platform, stem: &str) -> bool {
+    vertical_game(platform, stem) && read(root, platform) == Turn::Turned
+}
+
+pub fn prepare(core: &mut dyn RetroCore, root: &Path, platform: Platform, stem: &str) {
+    if !platform.is_arcade() {
+        return;
+    }
+    let upright = upright(root, platform, stem);
+    let (w, h) = Core::Fbneo.game_canvas(platform, upright);
+    core.set_canvas(w, h);
+    let turn = match turned(root, platform, stem) {
+        true => Turn::Turned,
+        false => Turn::Upright,
+    };
+    core.set_option(VERTICAL_MODE, turn.vertical_mode());
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub struct ArcadeTurns {
+    pub cps1: Turn,
+    pub cps2: Turn,
+}
+
+impl ArcadeTurns {
+    pub fn read(root: &Path) -> ArcadeTurns {
+        ArcadeTurns {
+            cps1: read(root, Platform::Cps1),
+            cps2: read(root, Platform::Cps2),
+        }
+    }
+
+    fn get_mut(&mut self, row: QuickRow) -> Option<&mut Turn> {
+        match row {
+            QuickRow::Cps1Rotation => Some(&mut self.cps1),
+            QuickRow::Cps2Rotation => Some(&mut self.cps2),
+            _ => None,
+        }
+    }
+
+    pub fn quick_value(&self, row: QuickRow) -> Option<QuickValue> {
+        match row {
+            QuickRow::Cps1Rotation => Some(self.cps1.quick_value()),
+            QuickRow::Cps2Rotation => Some(self.cps2.quick_value()),
+            _ => None,
+        }
+    }
+
+    pub fn change(&mut self, row: QuickRow, root: Option<&Path>, writes: &CardWrites) -> bool {
+        let (Some(platform), Some(turn)) = (row_platform(row), self.get_mut(row)) else {
+            return false;
+        };
+        *turn = turn.flipped();
+        if let (Some(root), Some(key)) = (root, key(platform)) {
+            let written = ini::write(root, ARCADE_FILE, key, turn.as_str());
+            if let Err(e) = &written {
+                eprintln!("slot: arcade: could not write arcade.txt: {e}");
+            }
+            writes.wrote("arcade.txt", &written);
+        }
+        true
+    }
+}
+
+pub fn pad_code(root: &Path, seated: Option<&Cart>, platform: Platform, vertical: bool) -> u8 {
+    if !platform.is_arcade() {
+        return crate::ws_input::pad_code(platform, vertical);
+    }
+    let turned = seated.is_some_and(|c| c.platform == platform && turned(root, platform, &c.stem));
+    crate::ws_input::pad_code(platform, turned)
+}
+
+pub fn upright_rects(platform: Platform, vertical: bool) -> Option<[[f32; 4]; 2]> {
+    (platform.is_arcade() && vertical).then_some([slot_gfx::WHOLE_TEXTURE, [0.25, 0.0, 0.75, 1.0]])
+}
