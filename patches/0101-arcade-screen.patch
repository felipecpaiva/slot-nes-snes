+    #[test]
+    fn a_quarter_turn_is_answered_only_when_asked_for_and_only_counter_clockwise() {
+        let mut extra = HostExtra {
+            answers_quarter: true,
+            ..HostExtra::default()
+        };
+        let _g = ExtraGuard::bind(&mut extra);
+        for (quarters, answered, quarter) in [(1, true, true), (3, false, true), (0, true, false)] {
+            // SAFETY: the pointer is to a live c_uint on this stack frame.
+            assert_eq!(unsafe { rotation_set(&quarters) }, answered, "{quarters}");
+            assert_eq!(with_extra(|e| e.quarter), Some(quarter), "{quarters}");
+        }
+    }
+
+    #[test]
+    fn a_sideways_frame_turns_upright_at_three_by_four_in_the_middle_of_the_canvas() {
+        let mut extra = HostExtra {
+            answers_quarter: true,
+            ..HostExtra::default()
+        };
+        let _g = ExtraGuard::bind(&mut extra);
+        // SAFETY: the pointer is to a live c_uint on this stack frame.
+        assert!(unsafe { rotation_set(&1) });
+        let (w, h) = (384usize, 224usize);
+        let frame: Vec<u8> = (0..w * h)
+            .flat_map(|i| if i == w - 1 { [0xff; 4] } else { [0x10; 4] })
+            .collect();
+        let mut video = vec![0u8; 576 * 384 * 4];
+        // SAFETY: frame holds 224 rows of 1536 bytes, 384 XRGB8888 pixels each.
+        unsafe {
+            copy_frame(
+                &mut video,
+                (576, 384),
+                frame.as_ptr(),
+                (384, 224),
+                w * 4,
+                false,
+            )
+        };
+        let px = |x: usize, y: usize| video[(y * 576 + x) * 4];
+        assert_eq!(px(144, 0), 0xff, "the source's top right lands top left");
+        assert_eq!(px(143, 0), 0, "left bar");
+        assert_eq!(px(431, 383), 0x10);
+        assert_eq!(px(432, 383), 0, "right bar");
+        assert_eq!(with_extra(|e| e.frame), Some((384, 224)));
+    }
+
     fn white(w: usize, h: usize) -> Vec<u8> {
         vec![0xff; w * h * 4]
     }
