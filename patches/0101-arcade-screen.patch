diff --git a/crates/slot/tests/arcade_screen.rs b/crates/slot/tests/arcade_screen.rs
new file mode 100644
index 0000000..e465d3a
--- /dev/null
+++ b/crates/slot/tests/arcade_screen.rs
@@ -0,0 +1,267 @@
+// The Neo Geo, CPS1 and CPS2 Screen sections and the Vertical Games row (ADR 0097).
+mod arcade_common;
+mod common;
+mod core_common;
+
+use std::path::Path;
+
+use arcade_common::{install, NINETEEN_FORTY_ONE, QAD};
+use common::core_lock;
+use slot::arcade_turn::{pad_code, prepare, turned, upright, upright_rects, ArcadeTurns, Turn};
+use slot::card_log::CardWrites;
+use slot::ws_input::{Layout, SIDEWAYS};
+use slot_retro::{ButtonMask as M, LibretroCore, RetroCore};
+use slot_store::Platform;
+use slot_ui::{QuickRow, QuickValue};
+
+#[test]
+fn each_arcade_board_has_its_own_screen_section_after_the_32x() {
+    let screen = QuickRow::SCREEN;
+    assert_eq!(
+        screen[screen.len() - 4..],
+        [
+            QuickRow::ScreenS32x,
+            QuickRow::ScreenNeoGeo,
+            QuickRow::ScreenCps1,
+            QuickRow::ScreenCps2
+        ]
+    );
+    assert_eq!(QuickRow::ScreenNeoGeo.label(), "Neo Geo");
+    assert_eq!(QuickRow::ScreenCps1.label(), "CPS1");
+    assert_eq!(QuickRow::ScreenCps2.label(), "CPS2");
+    assert_eq!(
+        QuickRow::SCREEN_NEOGEO,
+        [QuickRow::NeoGeoShader, QuickRow::NeoGeoPicture]
+    );
+    assert_eq!(
+        QuickRow::SCREEN_CPS1,
+        [
+            QuickRow::Cps1Shader,
+            QuickRow::Cps1Picture,
+            QuickRow::Cps1Rotation
+        ]
+    );
+    assert_eq!(QuickRow::Cps2Rotation.label(), "Vertical Games");
+    assert_eq!(QuickRow::Cps1Picture.parent(), Some(QuickRow::ScreenCps1));
+}
+
+#[test]
+fn vertical_games_stand_upright_until_the_user_turns_them_and_the_choice_is_kept_per_board() {
+    let d = tempfile::tempdir().unwrap();
+    let writes = CardWrites::default();
+    let mut turns = ArcadeTurns::read(d.path());
+    assert_eq!(turns, ArcadeTurns::default());
+    assert_eq!(
+        turns.quick_value(QuickRow::Cps1Rotation),
+        Some(QuickValue::Upright)
+    );
+    assert!(turns.change(QuickRow::Cps1Rotation, Some(d.path()), &writes));
+    assert!(!turns.change(QuickRow::NeoGeoPicture, Some(d.path()), &writes));
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config/arcade.txt")).unwrap(),
+        "cps1 = turned\n"
+    );
+    let again = ArcadeTurns::read(d.path());
+    assert_eq!(again.cps1, Turn::Turned);
+    assert_eq!(again.cps2, Turn::Upright);
+    assert!(turned(d.path(), Platform::Cps1, "1941"));
+    assert!(!turned(d.path(), Platform::Cps1, "ffight"), "not vertical");
+    assert!(upright(d.path(), Platform::Cps2, "19xx"));
+}
+
+#[test]
+fn an_unknown_line_in_arcade_txt_reads_as_upright() {
+    let d = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(d.path().join("Config")).unwrap();
+    std::fs::write(d.path().join("Config/arcade.txt"), "cps2=sideways\n").unwrap();
+    assert_eq!(ArcadeTurns::read(d.path()).cps2, Turn::Upright);
+}
+
+#[test]
+fn an_upright_game_fills_the_whole_canvas_and_draws_its_picture_in_the_middle_half() {
+    assert_eq!(
+        upright_rects(Platform::Cps1, true),
+        Some([slot_gfx::WHOLE_TEXTURE, [0.25, 0.0, 0.75, 1.0]])
+    );
+    assert_eq!(upright_rects(Platform::Cps1, false), None);
+    assert_eq!(upright_rects(Platform::Ws, true), None);
+}
+
+fn opened(root: &Path) -> Option<LibretroCore> {
+    let dylib = arcade_common::fbneo()?;
+    std::fs::create_dir_all(slot::root::saves_dir(root)).unwrap();
+    let mut core = LibretroCore::open_with(
+        &dylib,
+        &slot::root::bios_dir(root),
+        &slot::root::saves_dir(root),
+    )
+    .expect("open FBNeo");
+    core.answer_quarter_turn();
+    Some(core)
+}
+
+#[test]
+fn an_upright_vertical_set_is_turned_by_slot_onto_a_576_by_384_canvas() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = opened(d.path()) else {
+        return;
+    };
+    prepare(&mut core, d.path(), Platform::Cps1, "1941");
+    core.load(&install(d.path(), &NINETEEN_FORTY_ONE)).unwrap();
+    core.run_frame(M::default());
+    core.run_frame(M::default());
+    assert!(core.quarter_turned());
+    assert_eq!(core.video_xrgb8888().len(), 576 * 384 * 4);
+}
+
+#[test]
+fn a_turned_vertical_set_is_drawn_sideways_as_the_board_draws_it() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(d.path().join("Config")).unwrap();
+    std::fs::write(d.path().join("Config/arcade.txt"), "cps1=turned\n").unwrap();
+    let Some(mut core) = opened(d.path()) else {
+        return;
+    };
+    prepare(&mut core, d.path(), Platform::Cps1, "1941");
+    assert_eq!(
+        core.option("fbneo-vertical-mode").as_deref(),
+        Some("enabled")
+    );
+    core.load(&install(d.path(), &NINETEEN_FORTY_ONE)).unwrap();
+    core.run_frame(M::default());
+    core.run_frame(M::default());
+    assert!(!core.quarter_turned());
+    assert_eq!(core.video_xrgb8888().len(), 432 * 288 * 4);
+    assert_eq!(core.frame_width(), 384);
+}
+
+#[test]
+fn a_horizontal_set_is_never_turned() {
+    let _g = core_lock();
+    let d = tempfile::tempdir().unwrap();
+    let Some(mut core) = opened(d.path()) else {
+        return;
+    };
+    prepare(&mut core, d.path(), Platform::Cps1, "qad");
+    core.load(&install(d.path(), &QAD)).unwrap();
+    core.run_frame(M::default());
+    core.run_frame(M::default());
+    assert!(!core.quarter_turned());
+    assert_eq!(core.video_xrgb8888().len(), 432 * 288 * 4);
+}
+
+#[test]
+fn a_turned_game_turns_the_pad_with_it_and_leaves_every_button_alone() {
+    let d = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(d.path().join("Config")).unwrap();
+    std::fs::write(d.path().join("Config/arcade.txt"), "cps2=turned\n").unwrap();
+    let cart = slot_store::Cart {
+        platform: Platform::Cps2,
+        stem: "19xx".into(),
+        rom: d.path().join("Games/CPS2/19xx.zip"),
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    };
+    assert_eq!(
+        pad_code(d.path(), Some(&cart), Platform::Cps2, false),
+        SIDEWAYS
+    );
+    assert_eq!(
+        pad_code(d.path(), None, Platform::Cps2, false),
+        slot::ws_input::OFF
+    );
+    for (pressed, game) in [
+        (M::RIGHT, M::UP),
+        (M::UP, M::LEFT),
+        (M::LEFT, M::DOWN),
+        (M::DOWN, M::RIGHT),
+    ] {
+        assert_eq!(Layout::Sideways.remap(M(pressed)).0, game);
+    }
+    let buttons = M::A | M::B | M::X | M::Y | M::L | M::R | M::START | M::SELECT;
+    assert_eq!(Layout::Sideways.remap(M(buttons)).0, buttons);
+}
+
+fn card(sets: &[(&str, &str)]) -> (tempfile::TempDir, slot::app::App) {
+    let root = common::tmp_root_with_real_carts(&["Emerald"]);
+    for (shelf, set) in sets {
+        let dir = root.path().join("Games").join(shelf);
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(dir.join(format!("{set}.zip")), b"PK\x05\x06").unwrap();
+    }
+    let app = common::boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut slot::app::App, btn: slot_input::Btn) {
+    app.apply(slot_input::Action::GbaDown(btn));
+    app.apply(slot_input::Action::GbaUp(btn));
+}
+
+fn open_section(app: &mut slot::app::App, section: QuickRow) {
+    use slot_input::{Action, Btn};
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..section.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(section));
+    press(app, Btn::A);
+}
+
+#[test]
+fn each_arcade_section_shows_only_on_a_card_with_sets_for_that_board() {
+    let (_root, app) = card(&[("CPS1", "ffight")]);
+    let hidden = app.hidden_rows();
+    assert!(!hidden.contains(&QuickRow::ScreenCps1));
+    assert!(hidden.contains(&QuickRow::ScreenCps2));
+    assert!(hidden.contains(&QuickRow::ScreenNeoGeo));
+}
+
+#[test]
+fn the_cps1_section_walks_its_shader_picture_and_vertical_games_rows_into_their_own_files() {
+    use slot_input::Btn;
+    let (root, mut app) = card(&[("CPS1", "1941")]);
+    open_section(&mut app, QuickRow::ScreenCps1);
+    assert_eq!(app.quick_menu(), Some(QuickRow::Cps1Shader));
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_ne!(
+        slot_store::read_sega_shaders(root.path()).cps1,
+        slot_store::Shader::Off
+    );
+    assert_eq!(
+        slot_store::read_sega_shaders(root.path()).cps2,
+        slot_store::Shader::Off
+    );
+    press(&mut app, Btn::Down);
+    assert_eq!(
+        app.quick_value(QuickRow::Cps1Picture),
+        Some(QuickValue::Stretch)
+    );
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_eq!(
+        slot::platform_video::system_picture(root.path(), Platform::Cps1),
+        slot::video_mode::VideoMode::Actual
+    );
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::Cps1Rotation));
+    assert_eq!(
+        app.quick_value(QuickRow::Cps1Rotation),
+        Some(QuickValue::Upright)
+    );
+    press(&mut app, Btn::Right);
+    assert_eq!(
+        app.quick_value(QuickRow::Cps1Rotation),
+        Some(QuickValue::Turned)
+    );
+    assert!(turned(root.path(), Platform::Cps1, "1941"));
+}
