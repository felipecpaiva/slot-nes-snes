+    let mut core = open(&dylib, d.path(), &d.path().join("BIOS"));
+    core.load(&a26(d.path(), "Fire", Bg::Fire, 262))
+        .expect("load");
+    let c = code(&AtariSwitches::default(), Platform::A2600);
