diff --git a/crates/slot-store/tests/atari_platform.rs b/crates/slot-store/tests/atari_platform.rs
new file mode 100644
index 0000000..8395381
--- /dev/null
+++ b/crates/slot-store/tests/atari_platform.rs
@@ -0,0 +1,129 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, scan, write_sega_shaders, Cart, Core, Platform, RetroShader, SegaShaders,
+    Shader, A2600_SHADER_FILE, A7800_SHADER_FILE,
+};
+
+fn put(root: &Path, shelf: &str, name: &str) {
+    let dir = root.join("Games").join(shelf);
+    std::fs::create_dir_all(&dir).expect("create dir");
+    std::fs::write(dir.join(name), [0u8; 4096]).expect("write");
+}
+
+fn stems(root: &Path, platform: Platform) -> Vec<String> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c: &Cart| c.platform == platform)
+        .map(|c| c.stem)
+        .collect()
+}
+
+#[test]
+fn the_atari_shelves_follow_the_32x_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES[14], Platform::A2600);
+    assert_eq!(Platform::SHELVES[15], Platform::A7800);
+    assert_eq!(Platform::SHELVES.len(), 16);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::A2600.dir_name(), "A2600");
+    assert_eq!(Platform::A7800.dir_name(), "A7800");
+    assert_eq!(Platform::A2600.name(), "Atari 2600");
+    assert_eq!(Platform::A7800.name(), "Atari 7800");
+}
+
+#[test]
+fn a_2600_shelf_lists_a26_and_bin_and_a_7800_shelf_lists_a78() {
+    let d = tmp_root();
+    put(d.path(), "A2600", "Pitfall! (USA).a26");
+    put(d.path(), "A2600", "River Raid (USA).bin");
+    put(d.path(), "A2600", "Notes.txt");
+    put(d.path(), "A7800", "Asteroids (USA).a78");
+    put(d.path(), "A7800", "Asteroids (USA).bin");
+    put(d.path(), "A7800", "[BIOS] Atari 7800 (USA).a78");
+    assert_eq!(
+        stems(d.path(), Platform::A2600),
+        ["Pitfall! (USA)", "River Raid (USA)"]
+    );
+    assert_eq!(stems(d.path(), Platform::A7800), ["Asteroids (USA)"]);
+}
+
+#[test]
+fn a_2600_bin_never_reaches_the_mega_drive_or_32x_shelf() {
+    let d = tmp_root();
+    put(d.path(), "A2600", "Adventure (USA).bin");
+    assert!(stems(d.path(), Platform::Md).is_empty());
+    assert!(stems(d.path(), Platform::S32x).is_empty());
+}
+
+#[test]
+fn each_atari_shelf_runs_on_its_own_core_alone() {
+    for (platform, core, name, canvas) in [
+        (Platform::A2600, Core::Stella2014, "stella2014", (360, 256)),
+        (Platform::A7800, Core::Prosystem, "prosystem", (360, 272)),
+    ] {
+        assert_eq!(Core::default_for(platform), core);
+        assert_eq!(core.as_str(), name);
+        assert_eq!(core.option_prefix(), name);
+        assert_eq!(Core::parse(name), Some(core));
+        assert_eq!(core.canvas(platform), canvas);
+        assert_eq!(core.pair(), (core, core));
+        assert!(core.reports_its_frame_rate());
+        assert!(!core.has_colour_correction());
+        for other in Core::EVERY {
+            assert_eq!(other.runs(platform), other == core, "{other:?}");
+        }
+        for shelf in Platform::SHELVES {
+            assert_eq!(core.runs(shelf), shelf == platform, "{shelf:?}");
+        }
+    }
+    assert_eq!(Core::EVERY[13], Core::Stella2014);
+    assert_eq!(Core::EVERY[14], Core::Prosystem);
+}
+
+#[test]
+fn the_atari_shelves_keep_slots_shoulders_and_triggers_and_pass_x_and_y_to_the_game() {
+    for platform in [Platform::A2600, Platform::A7800] {
+        assert!(platform.owns_shoulders(), "{platform:?}");
+        assert!(platform.owns_triggers(), "{platform:?}");
+        assert!(!platform.turbo_on_xy(), "{platform:?}");
+        assert!(!platform.select_x_toggles_picture(), "{platform:?}");
+        assert_eq!(platform.picker_cores(), None);
+        assert!(platform.rewinds());
+        assert!(platform.stretch_crops_height());
+        assert!(!platform.follows_frame_width());
+        assert_eq!(platform.overscan(), (0, 0));
+        assert_eq!(platform.shader_choices(), &Shader::RETRO);
+        assert!(!platform.fills_canvas() && !platform.swaps_discs());
+        assert!(!platform.flashes_on_unload() && !platform.has_gb_palettes());
+        assert_eq!(platform.actual_scale(), None);
+    }
+    assert!(Platform::A2600.passes_xy_through());
+    assert!(Platform::A7800.passes_xy_through());
+    assert_eq!(Platform::A2600.picture(), (160, 210));
+    assert_eq!(Platform::A7800.picture(), (320, 223));
+}
+
+#[test]
+fn each_atari_shader_lives_in_its_own_file() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        a2600: Shader::Retro(RetroShader::CrtPi),
+        a7800: Shader::Retro(RetroShader::Line),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    let config = d.path().join("Config");
+    assert_eq!(
+        std::fs::read_to_string(config.join(A2600_SHADER_FILE)).expect("read"),
+        "a2600=crt-pi\n"
+    );
+    assert_eq!(
+        std::fs::read_to_string(config.join(A7800_SHADER_FILE)).expect("read"),
+        "a7800=line\n"
+    );
+    assert_eq!(read_sega_shaders(d.path()), s);
+}
