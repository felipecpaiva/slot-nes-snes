+mod atari_common;
+mod common;
+mod core_common;
+mod real_seat;
+
+use atari_common::{a26, a78, prosystem, stella, Bg};
+use common::core_lock;
+use slot_store::{Core, Platform};
+
+fn lit_rows(frame: &[u8], w: usize) -> usize {
+    frame
+        .chunks_exact(w * 4)
+        .filter(|row| row.chunks_exact(4).any(|px| px[..3] != [0, 0, 0]))
+        .count()
+}
+
+#[test]
+fn a_2600_cart_seats_on_stella_through_a_real_session_on_its_tall_canvas() {
+    let _g = core_lock();
+    let Some(dylib) = stella() else {
+        return;
+    };
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = a26(carts.path(), "Pitfall", Bg::Colour(0x1e), 262);
+    let root = real_seat::rooted(Platform::A2600, "Pitfall", &rom, &dylib);
+    let session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::Stella2014);
+    assert_eq!(session.app().playing_platform(), Platform::A2600);
+    let frame = session
+        .emu()
+        .expect("no core in the slot")
+        .latest_frame()
+        .expect("nothing was published");
+    assert_eq!(frame.len(), 360 * 256 * 4);
+    assert_eq!(lit_rows(&frame, 360), 210);
+}
+
+#[test]
+fn a_7800_cart_seats_on_prosystem_through_a_real_session_on_its_tall_canvas() {
+    let _g = core_lock();
+    let Some(dylib) = prosystem() else {
+        return;
+    };
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = a78(carts.path(), "Asteroids", Some(0x1f), false, true);
+    let root = real_seat::rooted(Platform::A7800, "Asteroids", &rom, &dylib);
+    let session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::Prosystem);
+    let frame = session
+        .emu()
+        .expect("no core in the slot")
+        .latest_frame()
+        .expect("nothing was published");
+    assert_eq!(frame.len(), 360 * 272 * 4);
+    assert_eq!(lit_rows(&frame, 360), 223);
+}
+
+#[test]
+fn a_pal_2600_cart_is_not_halved_on_its_canvas() {
+    let _g = core_lock();
+    let Some(dylib) = stella() else {
+        return;
+    };
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = a26(carts.path(), "Pal", Bg::Colour(0x1e), 312);
+    let root = real_seat::rooted(Platform::A2600, "Pal", &rom, &dylib);
+    let session = real_seat::play(root.path(), true);
+    let frame = session
+        .emu()
+        .expect("no core in the slot")
+        .latest_frame()
+        .expect("nothing was published");
+    assert_eq!(lit_rows(&frame, 360), 250);
+}
