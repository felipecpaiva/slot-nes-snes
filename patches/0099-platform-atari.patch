diff --git a/crates/slot/tests/atari_common/mod.rs b/crates/slot/tests/atari_common/mod.rs
new file mode 100644
index 0000000..dce36d7
--- /dev/null
+++ b/crates/slot/tests/atari_common/mod.rs
@@ -0,0 +1,120 @@
+#![allow(dead_code)]
+// The generated Atari carts the core and platform tests share (ADR 0095). The 2600 cart has the shape
+// of the ROM in stella2014's own test/determinism_harness.c (a VSYNC kernel writing COLUBK); the 7800
+// cart uses the register map in ProSystem's core/Equates.h. The code is ours.
+
+use std::path::{Path, PathBuf};
+
+use crate::core_common::require_core;
+
+pub fn stella() -> Option<PathBuf> {
+    require_core("stella2014")
+}
+
+pub fn prosystem() -> Option<PathBuf> {
+    require_core("prosystem")
+}
+
+/// What a 2600 kernel writes to the background each frame.
+#[derive(Clone, Copy)]
+pub enum Bg {
+    /// One fixed colour.
+    Colour(u8),
+    /// SWCHB (the console switches) shifted left once, so bit 0 (Reset) lands in COLUBK's bit 1.
+    Switches,
+    /// SWCHB shifted right once, so bit 7 (the right difficulty switch) lands in bit 6.
+    SwitchesHigh,
+    /// INPT4 (player 0 fire, bit 7 low while pressed).
+    Fire,
+}
+
+/// A 4 KB cart at $F000: tone on channel 0, then per frame a 3-line VSYNC, the background colour
+/// and `lines - 3` WSYNC lines with VBLANK never set, so every line the core shows is that colour.
+/// 262 lines is an NTSC frame, 312 a PAL one.
+pub fn a26(dir: &Path, stem: &str, bg: Bg, lines: u16) -> PathBuf {
+    let rest = lines - 3;
+    let (a, b) = ((rest / 2) as u8, (rest - rest / 2) as u8);
+    let mut code = vec![
+        0x78, 0xd8, 0xa2, 0xff, 0x9a, // sei, cld, ldx #$ff, txs
+        0xa9, 0x04, 0x85, 0x15, // lda #4, sta AUDC0
+        0xa9, 0x10, 0x85, 0x17, // lda #$10, sta AUDF0
+        0xa9, 0x0f, 0x85, 0x19, // lda #15, sta AUDV0
+    ];
+    let frame = 0xf000 + code.len() as u16;
+    code.extend([
+        0xa9, 0x02, 0x85, 0x00, // lda #2, sta VSYNC
+        0x85, 0x02, 0x85, 0x02, 0x85, 0x02, // sta WSYNC x3
+        0xa9, 0x00, 0x85, 0x00, // lda #0, sta VSYNC
+    ]);
+    code.extend(match bg {
+        Bg::Colour(c) => [0xa9, c, 0xea, 0xea],   // lda #c, nop, nop
+        Bg::Switches => [0xad, 0x82, 0x02, 0x0a], // lda SWCHB, asl a
+        Bg::SwitchesHigh => [0xad, 0x82, 0x02, 0x4a], // lda SWCHB, lsr a
+        Bg::Fire => [0xad, 0x0c, 0x00, 0xea],     // lda INPT4, nop
+    });
+    code.extend([0x85, 0x09]); // sta COLUBK
+    code.extend([0xa2, a, 0x85, 0x02, 0xca, 0xd0, 0xfb]); // ldx #a; l: sta WSYNC; dex; bne l
+    code.extend([0xa2, b, 0x85, 0x02, 0xca, 0xd0, 0xfb]); // ldx #b; l: sta WSYNC; dex; bne l
+    code.extend([0x4c, frame as u8, (frame >> 8) as u8]); // jmp frame
+    let mut rom = vec![0xffu8; 4096];
+    rom[..code.len()].copy_from_slice(&code);
+    rom[0xffc..].copy_from_slice(&[0x00, 0xf0, 0x00, 0xf0]); // RESET and IRQ at $F000
+    let path = dir.join(format!("{stem}.a26"));
+    std::fs::write(&path, rom).unwrap();
+    path
+}
+
+/// A 16 KB headered .a78 at $C000: Maria on (DMA, 160A), a display list list of 20 zones of 16
+/// lines each pointing at one empty display list, so every line Maria draws is the background.
+/// With `echo` the background is SWCHB (the console switches), rewritten in a loop.
+pub fn a78(dir: &Path, stem: &str, colour: Option<u8>, pal: bool, header: bool) -> PathBuf {
+    let mut code = vec![0x78, 0xd8]; // sei, cld
+    let top = 0xc000 + code.len() as u16;
+    code.extend(match colour {
+        Some(c) => [0xa9, c, 0xea], // lda #c, nop
+        None => [0xad, 0x82, 0x02], // lda SWCHB
+    });
+    code.extend([
+        0x85,
+        0x20, // sta BACKGRND
+        0xa9,
+        0xd0,
+        0x85,
+        0x2c, // lda #>DLL, sta DPPH
+        0xa9,
+        0x00,
+        0x85,
+        0x30, // lda #<DLL, sta DPPL
+        0xa9,
+        0x40,
+        0x85,
+        0x3c, // lda #$40, sta CTRL (DMA on, 160A)
+        0x4c,
+        top as u8,
+        (top >> 8) as u8, // jmp top
+    ]);
+    let mut rom = vec![0u8; 16 * 1024];
+    rom[..code.len()].copy_from_slice(&code);
+    for z in 0..20 {
+        rom[0x1000 + z * 3..0x1000 + z * 3 + 3].copy_from_slice(&[0x0f, 0xd1, 0x00]);
+    }
+    // $D100: an empty display list (mode byte 0 ends it).
+    rom[0x3ffa..].copy_from_slice(&[0x00, 0xc0, 0x00, 0xc0, 0x00, 0xc0]);
+    let mut file = Vec::new();
+    if header {
+        let mut h = vec![0u8; 128];
+        h[0] = 1;
+        h[1..10].copy_from_slice(b"ATARI7800");
+        h[17..17 + 10].copy_from_slice(b"SLOT A7800");
+        h[49..53].copy_from_slice(&(rom.len() as u32).to_be_bytes());
+        h[55] = 1; // joystick
+        h[56] = 1;
+        h[57] = u8::from(pal);
+        file.extend(h);
+    }
+    file.extend(rom);
+    let path = dir.join(format!("{stem}.a78"));
+    std::fs::write(&path, file).unwrap();
+    path
+}
+
