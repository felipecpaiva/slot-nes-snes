+#[test]
+fn prosystem_reads_the_7800_difficulty_rows_through_the_remap() {
+    let _g = core_lock();
+    let Some(dylib) = prosystem() else {
+        return;
+    };
+    let d = tempfile::tempdir().expect("tempdir");
+    let mut core = open(&dylib, d.path(), &d.path().join("BIOS"));
+    core.load(&a78(d.path(), "Switches", None, false, true))
+        .expect("load");
+    let mut s = AtariSwitches::default();
+    let factory = background(&mut core, code(&s, Platform::A7800), 0);
+    set(&mut s, QuickRow::A7800LeftDifficulty, QuickValue::DifficultyA);
+    let both_a = background(&mut core, code(&s, Platform::A7800), 0);
+    assert_ne!(factory, both_a);
+    assert_eq!(background(&mut core, code(&s, Platform::A7800), M::L), both_a);
+}
