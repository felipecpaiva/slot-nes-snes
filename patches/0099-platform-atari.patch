diff --git a/crates/slot/tests/atari_screen.rs b/crates/slot/tests/atari_screen.rs
new file mode 100644
index 0000000..d8d33f0
--- /dev/null
+++ b/crates/slot/tests/atari_screen.rs
@@ -0,0 +1,208 @@
+mod common;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::atari_switches::ATARI_FILE;
+use slot::pal_speed::PAL_SPEED_FILE;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture};
+use slot::video_mode::VideoMode;
+use slot_input::{Action, Btn};
+use slot_store::{read_sega_shaders, Platform, Shader, A2600_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_both() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(root.path().join("Games/A2600/Pitfall.a26"), [0u8; 16]).expect("write cart");
+    std::fs::write(root.path().join("Games/A7800/Asteroids.a78"), [0u8; 16]).expect("write cart");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open(app: &mut App, section: QuickRow) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..section.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(section));
+    press(app, Btn::A);
+}
+
+fn down_to(app: &mut App, row: QuickRow) {
+    while app.quick_menu() != Some(row) {
+        press(app, Btn::Down);
+    }
+}
+
+#[test]
+fn the_atari_sections_close_the_screen_list_with_six_rows_each() {
+    assert_eq!(QuickRow::SCREEN[14], QuickRow::ScreenA2600);
+    assert_eq!(QuickRow::SCREEN.last(), Some(&QuickRow::ScreenA7800));
+    assert_eq!(QuickRow::ScreenA2600.label(), "Atari 2600");
+    assert_eq!(QuickRow::ScreenA7800.label(), "Atari 7800");
+    assert_eq!(
+        QuickRow::SCREEN_A2600.map(QuickRow::label),
+        [
+            "Shader",
+            "Picture",
+            "PAL Speed",
+            "Left Difficulty",
+            "Right Difficulty",
+            "TV Type"
+        ]
+    );
+    assert_eq!(
+        QuickRow::SCREEN_A7800.map(QuickRow::label),
+        [
+            "Shader",
+            "Picture",
+            "PAL Speed",
+            "Left Difficulty",
+            "Right Difficulty",
+            "BIOS"
+        ]
+    );
+    for (section, rows) in [
+        (QuickRow::ScreenA2600, QuickRow::SCREEN_A2600),
+        (QuickRow::ScreenA7800, QuickRow::SCREEN_A7800),
+    ] {
+        assert!(section.opens());
+        assert_eq!(section.child(), Some(rows[0]));
+        for row in rows {
+            assert_eq!(row.parent(), Some(section), "{row:?}");
+        }
+    }
+}
+
+#[test]
+fn the_atari_sections_show_only_on_a_card_with_atari_games() {
+    let (_root, app) = card_with_both();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenA2600));
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenA7800));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    let without = boot(root.path());
+    assert!(without.hidden_rows().contains(&QuickRow::ScreenA2600));
+    assert!(without.hidden_rows().contains(&QuickRow::ScreenA7800));
+}
+
+#[test]
+fn both_atari_pictures_start_four_three_and_offer_stretch_and_actual() {
+    for platform in [Platform::A2600, Platform::A7800] {
+        assert_eq!(default_video_mode(platform), VideoMode::FourThree);
+        assert_eq!(
+            picture_choices(platform),
+            [VideoMode::Stretch, VideoMode::Actual, VideoMode::FourThree]
+        );
+    }
+    let (root, mut app) = card_with_both();
+    open(&mut app, QuickRow::ScreenA2600);
+    down_to(&mut app, QuickRow::A2600Picture);
+    assert_eq!(
+        app.quick_value(QuickRow::A2600Picture),
+        Some(QuickValue::FourThree)
+    );
+    press(&mut app, Btn::Right);
+    assert_eq!(
+        system_picture(root.path(), Platform::A2600),
+        VideoMode::Stretch
+    );
+    assert_eq!(
+        system_picture(root.path(), Platform::A7800),
+        VideoMode::FourThree
+    );
+}
+
+#[test]
+fn the_2600_shader_walks_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_both();
+    open(&mut app, QuickRow::ScreenA2600);
+    assert_eq!(app.quick_value(QuickRow::A2600Shader), Some(QuickValue::Off));
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    assert_eq!(read_sega_shaders(root.path()).a2600, Shader::RETRO[1]);
+    assert_eq!(read_sega_shaders(root.path()).a7800, Shader::Off);
+    assert!(root.path().join("Config").join(A2600_SHADER_FILE).exists());
+}
+
+#[test]
+fn each_atari_pal_speed_row_is_its_own_and_starts_native() {
+    let (root, mut app) = card_with_both();
+    open(&mut app, QuickRow::ScreenA7800);
+    down_to(&mut app, QuickRow::A7800PalSpeed);
+    assert_eq!(
+        app.quick_value(QuickRow::A7800PalSpeed),
+        Some(QuickValue::Native)
+    );
+    press(&mut app, Btn::Right);
+    assert_eq!(
+        app.quick_value(QuickRow::A7800PalSpeed),
+        Some(QuickValue::Panel)
+    );
+    assert!(app.native_pal(Platform::A2600));
+    assert!(!app.native_pal(Platform::A7800));
+    let text = std::fs::read_to_string(root.path().join(PAL_SPEED_FILE)).expect("pal_speed.txt");
+    assert!(text.contains("a7800"), "{text}");
+}
+
+#[test]
+fn the_2600_switch_rows_walk_auto_a_b_and_land_in_atari_txt() {
+    let (root, mut app) = card_with_both();
+    open(&mut app, QuickRow::ScreenA2600);
+    down_to(&mut app, QuickRow::A2600LeftDifficulty);
+    let mut seen = Vec::new();
+    for _ in 0..3 {
+        press(&mut app, Btn::Right);
+        seen.push(app.quick_value(QuickRow::A2600LeftDifficulty));
+    }
+    assert_eq!(
+        seen,
+        [
+            Some(QuickValue::DifficultyA),
+            Some(QuickValue::DifficultyB),
+            Some(QuickValue::Auto)
+        ]
+    );
+    down_to(&mut app, QuickRow::A2600TvType);
+    press(&mut app, Btn::Left);
+    assert_eq!(
+        app.quick_value(QuickRow::A2600TvType),
+        Some(QuickValue::BlackWhite)
+    );
+    let text = std::fs::read_to_string(root.path().join(ATARI_FILE)).expect("atari.txt");
+    assert!(text.contains("a2600_tv = bw"), "{text}");
+    assert_eq!(boot(root.path()).quick_value(QuickRow::A2600TvType), Some(QuickValue::BlackWhite));
+}
+
+#[test]
+fn the_7800_bios_row_starts_off_and_turns_on() {
+    let (root, mut app) = card_with_both();
+    open(&mut app, QuickRow::ScreenA7800);
+    down_to(&mut app, QuickRow::A7800Bios);
+    assert_eq!(app.quick_value(QuickRow::A7800Bios), Some(QuickValue::Off));
+    press(&mut app, Btn::Right);
+    assert_eq!(app.quick_value(QuickRow::A7800Bios), Some(QuickValue::On));
+    assert_eq!(
+        slot::atari_switches::system_dir(root.path(), Platform::A7800),
+        slot::root::bios_dir(root.path())
+    );
+}
+
+#[test]
+fn the_pad_code_follows_a_switch_change_while_the_menu_is_open() {
+    let (_root, mut app) = card_with_both();
+    let before = app.pad_code(Platform::A2600);
+    open(&mut app, QuickRow::ScreenA2600);
+    down_to(&mut app, QuickRow::A2600RightDifficulty);
+    press(&mut app, Btn::Right);
+    assert_ne!(app.pad_code(Platform::A2600), before);
+    assert_eq!(app.pad_code(Platform::Ws), 1);
+}
