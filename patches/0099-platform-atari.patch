+        apply_policy_options(&mut c, core);
+        let rom = match core {
+            Core::Stella2014 => a26(d.path(), "Colour", Bg::Colour(0x1e), 262),
+            _ => a78(d.path(), "Colour", Some(0x1f), false, true),
+        };
+        c.load(&rom).expect("load");
+        c.run_frame(M(0));
+        for (key, value) in fixed {
+            assert!(c.declared_options().contains_key(*key), "{key}");
+            assert_eq!(c.option(key).as_deref(), Some(*value), "{key}");
+        }
+    }
+}
