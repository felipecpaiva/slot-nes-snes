+#[test]
+fn with_the_bios_row_off_a_7800_bios_in_bios_never_runs() {
+    let _g = core_lock();
+    let Some(dylib) = prosystem() else {
+        return;
+    };
+    let d = tempfile::tempdir().expect("tempdir");
+    let bios = slot::root::bios_dir(d.path());
+    std::fs::create_dir_all(&bios).expect("dir");
+    std::fs::write(bios.join("7800 BIOS (U).rom"), [0u8; 4096]).expect("bios");
+    let rom = a78(d.path(), "Colour", Some(0x1f), false, true);
+    let off = background(
+        &mut {
+            let mut c = open(&dylib, d.path(), &system_dir(d.path(), Platform::A7800));
+            c.load(&rom).expect("load");
+            c
+        },
+        code(&AtariSwitches::default(), Platform::A7800),
+        0,
+    );
+    assert_ne!(off, [0, 0, 0]);
+    let mut on = open(&dylib, d.path(), &bios);
+    on.load(&rom).expect("load");
+    assert_eq!(
+        background(&mut on, code(&AtariSwitches::default(), Platform::A7800), 0),
+        [0, 0, 0]
+    );
+}
