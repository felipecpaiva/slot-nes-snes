+fn background(core: &mut LibretroCore, code: u8, pad: u16) -> [u8; 3] {
+    for _ in 0..30 {
+        let input = remap(code, M(pad)).expect("an Atari code");
+        core.run_frame(input);
+    }
+    let v = core.video_xrgb8888();
+    let mid = (136 * 360 + 180) * 4;
+    [v[mid], v[mid + 1], v[mid + 2]]
+}
+
+fn open(dylib: &Path, root: &Path, sys: &Path) -> LibretroCore {
+    std::fs::create_dir_all(sys).expect("dir");
+    let mut c = LibretroCore::open_with(dylib, sys, root).expect("open");
+    c.set_canvas(360, 272);
+    c
+}
