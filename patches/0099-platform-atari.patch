+#[test]
+fn stella_reads_the_2600_difficulty_rows_through_the_remap() {
+    let _g = core_lock();
+    let Some(dylib) = stella() else {
+        return;
+    };
+    let d = tempfile::tempdir().expect("tempdir");
+    let mut core = open(&dylib, d.path(), &d.path().join("BIOS"));
+    core.load(&a26(d.path(), "Switches", Bg::SwitchesHigh, 262))
+        .expect("load");
+    let mut s = AtariSwitches::default();
+    set(
+        &mut s,
+        QuickRow::A2600RightDifficulty,
+        QuickValue::DifficultyA,
+    );
+    let a = background(&mut core, code(&s, Platform::A2600), 0);
+    set(
+        &mut s,
+        QuickRow::A2600RightDifficulty,
+        QuickValue::DifficultyB,
+    );
+    let b = background(&mut core, code(&s, Platform::A2600), 0);
+    assert_ne!(a, b);
+    set(
+        &mut s,
+        QuickRow::A2600RightDifficulty,
+        QuickValue::DifficultyA,
+    );
+    assert_eq!(background(&mut core, code(&s, Platform::A2600), 0), a);
+}
