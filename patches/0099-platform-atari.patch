@@ -0,0 +1,311 @@
+mod atari_common;
+mod common;
+mod core_common;
+
+use std::path::Path;
+
+use atari_common::{a26, a78, prosystem, stella, Bg};
+use common::core_lock;
+use slot::atari_switches::{remap, system_dir, AtariSwitches, ATARI_FILE};
+use slot::card_log::CardWrites;
+use slot::core_options_policy::{apply_policy_options, PROSYSTEM, STELLA2014};
+use slot_retro::{ButtonMask as M, LibretroCore, RetroCore};
+use slot_store::{Core, Platform};
+use slot_ui::{QuickRow, QuickValue};
+
+const L3: u16 = 1 << 14;
+const R3: u16 = 1 << 15;
+
+fn set(s: &mut AtariSwitches, row: QuickRow, to: QuickValue) {
+    for _ in 0..3 {
+        if s.quick_value(row) == Some(to) {
+            return;
+        }
+        s.change(row, true, None, &CardWrites::default());
+    }
+    assert_eq!(s.quick_value(row), Some(to), "{row:?}");
+}
+
+fn code(s: &AtariSwitches, platform: Platform) -> u8 {
+    s.pad_code(platform).expect("an Atari pad code")
+}
+
+#[test]
+fn the_factory_switches_are_the_cores_own_auto_on_2600_left_b_right_a_and_no_bios_on_7800() {
+    let s = AtariSwitches::default();
+    for row in [
+        QuickRow::A2600LeftDifficulty,
+        QuickRow::A2600RightDifficulty,
+        QuickRow::A2600TvType,
+    ] {
+        assert_eq!(s.quick_value(row), Some(QuickValue::Auto), "{row:?}");
+    }
+    assert_eq!(
+        s.quick_value(QuickRow::A7800LeftDifficulty),
+        Some(QuickValue::DifficultyB)
+    );
+    assert_eq!(
+        s.quick_value(QuickRow::A7800RightDifficulty),
+        Some(QuickValue::DifficultyA)
+    );
+    assert!(!s.bios_on());
+    assert_eq!(s.pad_code(Platform::Nes), None);
+    assert_eq!(s.pad_code(Platform::Ws), None);
+}
+
+#[test]
+fn on_auto_the_2600_hears_no_switch_and_slots_own_shoulders_never_reach_it() {
+    let s = AtariSwitches::default();
+    let pad = remap(
+        code(&s, Platform::A2600),
+        M(M::L | M::R | M::L2 | M::R2 | M::UP | M::START),
+    )
+    .expect("2600");
+    assert_eq!(pad.0, M::UP | M::START);
+}
+
+#[test]
+fn each_2600_switch_row_holds_its_retropad_button_every_frame() {
+    let mut s = AtariSwitches::default();
+    for (row, value, bit) in [
+        (QuickRow::A2600LeftDifficulty, QuickValue::DifficultyA, M::L),
+        (QuickRow::A2600LeftDifficulty, QuickValue::DifficultyB, M::L2),
+        (QuickRow::A2600RightDifficulty, QuickValue::DifficultyA, M::R),
+        (QuickRow::A2600RightDifficulty, QuickValue::DifficultyB, M::R2),
+        (QuickRow::A2600TvType, QuickValue::Colour, L3),
+        (QuickRow::A2600TvType, QuickValue::BlackWhite, R3),
+    ] {
+        let mut one = AtariSwitches::default();
+        set(&mut one, row, value);
+        let pad = remap(code(&one, Platform::A2600), M(0)).expect("2600");
+        assert_eq!(pad.0, bit, "{row:?} {value:?}");
+        set(&mut s, row, value);
+    }
+    let pad = remap(code(&s, Platform::A2600), M(0)).expect("2600");
+    assert_eq!(pad.0, M::L2 | M::R2 | R3);
+}
+
+#[test]
