diff --git a/crates/slot/src/atari_switches.rs b/crates/slot/src/atari_switches.rs
new file mode 100644
index 0000000..5dc6598
--- /dev/null
+++ b/crates/slot/src/atari_switches.rs
@@ -0,0 +1,210 @@
+use std::path::{Path, PathBuf};
+
+use slot_retro::ButtonMask as M;
+use slot_store::{ini, Platform};
+use slot_ui::{QuickRow, QuickValue};
+
+use crate::card_log::CardWrites;
+
+pub const ATARI_FILE: &str = "Config/atari.txt";
+
+const L3: u16 = 1 << 14;
+const R3: u16 = 1 << 15;
+const SWITCHES: u16 = M::L | M::R | M::L2 | M::R2 | L3 | R3;
+
+const A2600: u8 = 0x80;
+const A7800: u8 = 0xc0;
+
+const AUTO_A_B: &[QuickValue] = &[
+    QuickValue::Auto,
+    QuickValue::DifficultyA,
+    QuickValue::DifficultyB,
+];
+const AUTO_TV: &[QuickValue] = &[QuickValue::Auto, QuickValue::Colour, QuickValue::BlackWhite];
+const B_A: &[QuickValue] = &[QuickValue::DifficultyB, QuickValue::DifficultyA];
+const OFF_ON: &[QuickValue] = &[QuickValue::Off, QuickValue::On];
+
+const ROWS: [(QuickRow, &str, &[QuickValue], QuickValue); 6] = [
+    (
+        QuickRow::A2600LeftDifficulty,
+        "a2600_left",
+        AUTO_A_B,
+        QuickValue::Auto,
+    ),
+    (
+        QuickRow::A2600RightDifficulty,
+        "a2600_right",
+        AUTO_A_B,
+        QuickValue::Auto,
+    ),
+    (QuickRow::A2600TvType, "a2600_tv", AUTO_TV, QuickValue::Auto),
+    (
+        QuickRow::A7800LeftDifficulty,
+        "a7800_left",
+        B_A,
+        QuickValue::DifficultyB,
+    ),
+    (
+        QuickRow::A7800RightDifficulty,
+        "a7800_right",
+        B_A,
+        QuickValue::DifficultyA,
+    ),
+    (QuickRow::A7800Bios, "a7800_bios", OFF_ON, QuickValue::Off),
+];
+
+fn word(v: QuickValue) -> &'static str {
+    match v {
+        QuickValue::DifficultyA => "a",
+        QuickValue::DifficultyB => "b",
+        QuickValue::Colour => "colour",
+        QuickValue::BlackWhite => "bw",
+        QuickValue::On => "on",
+        QuickValue::Off => "off",
+        _ => "auto",
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct AtariSwitches([QuickValue; 6]);
+
+impl Default for AtariSwitches {
+    fn default() -> Self {
+        AtariSwitches(ROWS.map(|(_, _, _, factory)| factory))
+    }
+}
+
+impl AtariSwitches {
+    pub fn read(root: &Path) -> AtariSwitches {
+        AtariSwitches(ROWS.map(|(_, key, choices, factory)| {
+            let Some(line) = ini::value(root, ATARI_FILE, key) else {
+                return factory;
+            };
+            choices
+                .iter()
+                .copied()
+                .find(|v| word(*v) == line)
+                .unwrap_or_else(|| {
+                    eprintln!("slot: atari.txt: ignoring {key}={line}");
+                    factory
+                })
+        }))
+    }
+
+    fn at(row: QuickRow) -> Option<usize> {
+        ROWS.iter().position(|(r, _, _, _)| *r == row)
+    }
+
+    pub fn quick_value(&self, row: QuickRow) -> Option<QuickValue> {
+        self.0.get(Self::at(row)?).copied()
+    }
+
+    pub fn change(
+        &mut self,
+        row: QuickRow,
+        right: bool,
+        root: Option<&Path>,
+        writes: &CardWrites,
+    ) -> bool {
+        let Some(at) = Self::at(row) else {
+            return false;
+        };
+        let (Some((_, key, choices, _)), Some(value)) = (ROWS.get(at), self.0.get_mut(at)) else {
+            return false;
+        };
+        let n = choices.len();
+        let now = choices.iter().position(|v| v == value).unwrap_or(0);
+        let next = if right {
+            (now + 1) % n
+        } else {
+            (now + n - 1) % n
+        };
+        *value = choices.get(next).copied().unwrap_or(*value);
+        if let Some(root) = root {
+            let written = ini::write(root, ATARI_FILE, key, word(*value));
+            if let Err(e) = &written {
+                eprintln!("slot: emu: could not write atari.txt: {e}");
+            }
+            writes.wrote("atari.txt", &written);
+        }
+        true
+    }
+
+    pub fn bios_on(&self) -> bool {
+        self.quick_value(QuickRow::A7800Bios) == Some(QuickValue::On)
+    }
+
+    pub fn pad_code(&self, platform: Platform) -> Option<u8> {
+        let two = |row| match self.quick_value(row) {
+            Some(QuickValue::DifficultyA | QuickValue::Colour) => 1,
+            Some(QuickValue::DifficultyB | QuickValue::BlackWhite) => 2,
+            _ => 0,
+        };
+        let b = |row| u8::from(self.quick_value(row) == Some(QuickValue::DifficultyB));
+        match platform {
+            Platform::A2600 => Some(
+                A2600
+                    | two(QuickRow::A2600LeftDifficulty)
+                    | two(QuickRow::A2600RightDifficulty) << 2
+                    | two(QuickRow::A2600TvType) << 4,
+            ),
+            Platform::A7800 => Some(
+                A7800 | b(QuickRow::A7800LeftDifficulty) | b(QuickRow::A7800RightDifficulty) << 1,
+            ),
+            Platform::Gba
+            | Platform::Gb
+            | Platform::Gbc
+            | Platform::Nes
+            | Platform::Snes
+            | Platform::Gg
+            | Platform::Sms
+            | Platform::Md
+            | Platform::Ps1
+            | Platform::Tg16
+            | Platform::Ws
+            | Platform::Lynx
+            | Platform::Ngp
+            | Platform::S32x => None,
+        }
+    }
+}
+
+fn held(code: u8, shift: u8, a: u16, b: u16) -> u16 {
+    match (code >> shift) & 3 {
+        1 => a,
+        2 => b,
+        _ => 0,
+    }
+}
+
+pub fn remap(code: u8, mask: M) -> Option<M> {
+    let m = mask.0 & !SWITCHES;
+    match code & A7800 {
+        A2600 => {
+            let fire = match m & (M::A | M::B) != 0 {
+                true => M::B | M::Y,
+                false => 0,
+            };
+            Some(M((m & !(M::A | M::B))
+                | fire
+                | held(code, 0, M::L, M::L2)
+                | held(code, 2, M::R, M::R2)
+                | held(code, 4, L3, R3)))
+        }
+        A7800 => Some(M(m
+            | if code & 1 != 0 { M::L } else { 0 }
+            | if code & 2 != 0 { M::R } else { 0 })),
+        _ => None,
+    }
+}
+
+pub fn system_dir(root: &Path, platform: Platform) -> PathBuf {
+    if platform != Platform::A7800 || AtariSwitches::read(root).bios_on() {
+        return crate::root::bios_dir(root);
+    }
+    let dir = crate::root::saves_dir(root).join("A7800").join(".system");
+    if let Err(e) = std::fs::create_dir_all(&dir) {
+        eprintln!("slot: atari: could not make {}: {e}", dir.display());
+    }
+    dir
+}
