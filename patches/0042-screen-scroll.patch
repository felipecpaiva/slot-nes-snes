diff --git a/crates/slot-ui/tests/screen_scroll.rs b/crates/slot-ui/tests/screen_scroll.rs
new file mode 100644
index 0000000..4acf987
--- /dev/null
+++ b/crates/slot-ui/tests/screen_scroll.rs
@@ -0,0 +1,29 @@
+use slot_ui::{quick_row_top_at, quick_window, QuickRow, QUICK_PITCH};
+
+const LEGEND_TOP: f32 = 427.0;
+
+#[test]
+fn every_drawn_row_of_the_nine_system_screen_list_sits_above_the_legend() {
+    for selected in QuickRow::SCREEN {
+        let (start, len) = quick_window(selected, &[]);
+        for row in &QuickRow::SCREEN[start..start + len] {
+            let top = quick_row_top_at(*row, selected, &[]);
+            assert!(
+                top >= 0.0 && top + QUICK_PITCH <= LEGEND_TOP,
+                "on {selected:?}, {row:?} is drawn at y {top}"
+            );
+        }
+    }
+}
+
+#[test]
+fn the_selected_row_of_the_screen_list_is_always_drawn() {
+    for selected in QuickRow::SCREEN {
+        let (start, len) = quick_window(selected, &[]);
+        assert!(
+            (start..start + len).contains(&selected.position(&[])),
+            "{selected:?} is outside the drawn rows {start}..{}",
+            start + len
+        );
+    }
+}
diff --git a/crates/slot/tests/render_screen_scroll.rs b/crates/slot/tests/render_screen_scroll.rs
new file mode 100644
index 0000000..e0eb388
--- /dev/null
+++ b/crates/slot/tests/render_screen_scroll.rs
@@ -0,0 +1,125 @@
+#![cfg(target_os = "macos")]
+
+mod common;
+
+use std::collections::VecDeque;
+
+use common::{clocked, tmp_root_with_real_carts};
+use slot::frontend::Frontend;
+use slot_gfx::{Compositor, HeadlessSurface, OUT_W};
+use slot_input::{Btn, InputSource, Millis, RawEvent};
+use slot_power::SimPlatform;
+use slot_store::Platform;
+use slot_ui::{quick_row_top_at, QuickRow, QUICK_PITCH};
+use tempfile::TempDir;
+
+const LEGEND_TOP: usize = 427;
+
+struct Script(VecDeque<Vec<RawEvent>>);
+
+impl InputSource for Script {
+    fn poll(&mut self, _now: Millis) -> Vec<RawEvent> {
+        self.0.pop_front().unwrap_or_default()
+    }
+}
+
+fn tap(f: &mut Frontend, input: &mut Script, btn: Btn) {
+    input.0.push_back(vec![RawEvent::Down(btn)]);
+    f.advance(input);
+    input.0.push_back(vec![RawEvent::Up(btn)]);
+    f.advance(input);
+}
+
+fn card_with_every_system() -> TempDir {
+    let d = tmp_root_with_real_carts(&["Emerald"]);
+    for (platform, ext) in [
+        (Platform::Gb, "gb"),
+        (Platform::Nes, "nes"),
+        (Platform::Snes, "sfc"),
+        (Platform::Gg, "gg"),
+        (Platform::Sms, "sms"),
+        (Platform::Md, "md"),
+        (Platform::Ps1, "chd"),
+    ] {
+        let dir = d.path().join("Games").join(platform.dir_name());
+        std::fs::create_dir_all(&dir).expect("create dir");
+        std::fs::write(dir.join(format!("Zelda.{ext}")), vec![0u8; 0x8000]).expect("write cart");
+    }
+    clocked(d.path());
+    d
+}
+
+fn rows_where(px: &[u8], ink: impl Fn(&[u8]) -> bool) -> Vec<usize> {
+    (0..LEGEND_TOP)
+        .filter(|y| {
+            (0..OUT_W as usize).any(|x| {
+                let i = (y * OUT_W as usize + x) * 4;
+                ink(&px[i..i + 3])
+            })
+        })
+        .collect()
+}
+
+#[test]
+fn the_nine_system_screen_list_draws_every_row_between_the_top_and_the_legend() {
+    let Ok(surface) = HeadlessSurface::new() else {
+        return;
+    };
+    let Ok(mut c) = Compositor::new(&surface) else {
+        return;
+    };
+    let d = card_with_every_system();
+    let mut f = Frontend::boot(Box::new(SimPlatform::at(d.path().to_path_buf())));
+    f.upload_faces(&mut c);
+    let mut input = Script(VecDeque::new());
+    tap(&mut f, &mut input, Btn::Menu);
+    tap(&mut f, &mut input, Btn::Down);
+    tap(&mut f, &mut input, Btn::A);
+    assert_eq!(QuickRow::ScreenGba.shown(f.app().hidden_rows()).len(), 9);
+    f.compose(&mut c);
+    let px = c.read_frame();
+    let rows = rows_where(&px, |p| p.iter().all(|c| *c > 0x70));
+    assert!(rows[0] > 0, "the first row is cut at the top");
+    let below = (LEGEND_TOP - 8..LEGEND_TOP)
+        .filter(|y| rows.contains(y))
+        .count();
+    assert_eq!(below, 0, "a row runs into the legend");
+}
+
+#[test]
+fn moving_to_playstation_scrolls_its_row_into_view() {
+    let Ok(surface) = HeadlessSurface::new() else {
+        return;
+    };
+    let Ok(mut c) = Compositor::new(&surface) else {
+        return;
+    };
+    let d = card_with_every_system();
+    let mut f = Frontend::boot(Box::new(SimPlatform::at(d.path().to_path_buf())));
+    f.upload_faces(&mut c);
+    let mut input = Script(VecDeque::new());
+    tap(&mut f, &mut input, Btn::Menu);
+    tap(&mut f, &mut input, Btn::Down);
+    tap(&mut f, &mut input, Btn::A);
+    let hidden = f.app().hidden_rows();
+    for _ in 0..QuickRow::ScreenPs1.position(hidden) {
+        tap(&mut f, &mut input, Btn::Down);
+    }
+    assert_eq!(f.app().quick_menu(), Some(QuickRow::ScreenPs1));
+    f.compose(&mut c);
+    let px = c.read_frame();
+    let top = quick_row_top_at(QuickRow::ScreenPs1, QuickRow::ScreenPs1, hidden) as usize;
+    assert!(
+        top + QUICK_PITCH as usize <= LEGEND_TOP,
+        "PlayStation sits at y {top}"
+    );
+    let lit = rows_where(&px, |p| p.iter().all(|c| *c > 0xe0));
+    assert!(!lit.is_empty(), "no lit row above the legend");
+    assert!(
+        lit.iter()
+            .all(|y| (top..top + QUICK_PITCH as usize).contains(y)),
+        "the lit rows {}..{} are not PlayStation's row at {top}",
+        lit[0],
+        lit[lit.len() - 1]
+    );
+}
