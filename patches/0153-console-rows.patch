diff --git a/crates/slot-store/src/console_controls.rs b/crates/slot-store/src/console_controls.rs
new file mode 100644
index 0000000..9e93505
--- /dev/null
+++ b/crates/slot-store/src/console_controls.rs
@@ -0,0 +1,129 @@
+use std::path::Path;
+
+use crate::bindings::read_controls;
+use crate::{ini, Binding, Controls, GameButton, Platform};
+
+impl GameButton {
+    pub const EVERY: [GameButton; 14] = [
+        GameButton::Up,
+        GameButton::Down,
+        GameButton::Left,
+        GameButton::Right,
+        GameButton::A,
+        GameButton::B,
+        GameButton::Select,
+        GameButton::Start,
+        GameButton::L,
+        GameButton::R,
+        GameButton::TurboA,
+        GameButton::TurboB,
+        GameButton::L2,
+        GameButton::R2,
+    ];
+
+    pub fn only_on_consoles(self) -> bool {
+        matches!(self, GameButton::L2 | GameButton::R2)
+    }
+}
+
+impl Platform {
+    pub fn keeps_own_controls(self) -> bool {
+        match self {
+            Platform::Gba | Platform::Gb | Platform::Gbc => false,
+            Platform::Nes
+            | Platform::Fds
+            | Platform::Snes
+            | Platform::Gg
+            | Platform::Sms
+            | Platform::Md
+            | Platform::SegaCd
+            | Platform::Neocd
+            | Platform::Ps1
+            | Platform::Tg16
+            | Platform::Sgx
+            | Platform::Pcecd
+            | Platform::Ws
+            | Platform::Lynx
+            | Platform::Ngp
+            | Platform::S32x
+            | Platform::A2600
+            | Platform::A7800
+            | Platform::Vb
+            | Platform::Pico8
+            | Platform::NeoGeo
+            | Platform::Cps1
+            | Platform::Cps2 => true,
+        }
+    }
+
+    fn triggers_by_default(self) -> bool {
+        !self.owns_triggers() || self == Platform::Vb
+    }
+}
+
+pub(crate) fn factory() -> [Option<Binding>; 14] {
+    GameButton::EVERY.map(|g| match g.only_on_consoles() {
+        true => None,
+        false => Binding::plain(g.default_device()),
+    })
+}
+
+fn factory_on(platform: Platform, g: GameButton) -> Option<Binding> {
+    match g.only_on_consoles() && platform.triggers_by_default() {
+        true => Binding::plain(g.default_device()),
+        false => Controls::default().game(g),
+    }
+}
+
+pub fn console_factory(platform: Platform) -> Controls {
+    let mut c = Controls::default();
+    for g in GameButton::EVERY {
+        c.set_game(g, factory_on(platform, g));
+    }
+    c
+}
+
+fn own_file(platform: Platform) -> String {
+    format!("Config/controls/{}.txt", platform.dir_name())
+}
+
+pub fn read_console_controls(root: &Path, platform: Platform) -> Controls {
+    let mut c = read_controls(root);
+    if !platform.keeps_own_controls() {
+        return c;
+    }
+    let file = own_file(platform);
+    let own = ini::read(root, &file);
+    for g in GameButton::EVERY {
+        let inherited = match g.only_on_consoles() {
+            true => factory_on(platform, g),
+            false => c.game(g),
+        };
+        let binding = match own.get(g.key()).map(|v| (v, Binding::parse(v))) {
+            Some((_, Some(binding))) => binding,
+            Some((v, None)) => {
+                eprintln!("slot: {file}: ignoring {}={v}", g.key());
+                inherited
+            }
+            None => inherited,
+        };
+        c.set_game(g, binding);
+    }
+    c
+}
+
+pub fn write_console_binding(
+    root: &Path,
+    platform: Platform,
+    g: GameButton,
+    binding: Option<Binding>,
+) -> std::io::Result<()> {
+    ini::write(root, &own_file(platform), g.key(), &Binding::key(binding))
+}
+
+pub fn reset_console_controls(root: &Path, platform: Platform) -> std::io::Result<()> {
+    let factory = console_factory(platform);
+    GameButton::EVERY
+        .into_iter()
+        .try_for_each(|g| write_console_binding(root, platform, g, factory.game(g)))
+}
