diff --git a/crates/slot/src/app/console_controls.rs b/crates/slot/src/app/console_controls.rs
new file mode 100644
index 0000000..8da710d
--- /dev/null
+++ b/crates/slot/src/app/console_controls.rs
@@ -0,0 +1,208 @@
+use std::collections::HashMap;
+
+use slot_store::{
+    console_factory, read_console_controls, reset_console_controls, write_console_binding, Binding,
+    Controls, Device, GameButton, Platform, Shortcut,
+};
+use slot_ui::{QuickRow, TexId};
+
+use super::{App, Phase};
+use crate::console_pad::{self, PadMode};
+
+type FacePair = [(TexId, u32, u32); 2];
+
+#[derive(Default)]
+pub struct ConsoleState {
+    platform: Option<Platform>,
+    controls: Controls,
+    names: Vec<(u32, String)>,
+    faces: HashMap<String, FacePair>,
+    upstream: Vec<(QuickRow, FacePair)>,
+}
+
+impl App {
+    pub fn latch_console(&mut self, platform: Platform) {
+        self.console.names.clear();
+        self.console.platform = platform.keeps_own_controls().then_some(platform);
+        self.console.controls = match &self.root {
+            Some(root) => read_console_controls(root, platform),
+            None => console_factory(platform),
+        };
+    }
+
+    pub fn pad_mode(&self) -> Option<PadMode> {
+        if !matches!(self.phase, Phase::Playing { .. }) {
+            return None;
+        }
+        let platform = self
+            .console
+            .platform
+            .filter(|p| *p == self.playing_platform())?;
+        Some(PadMode {
+            platform,
+            code: self.pad_code(platform),
+            pass_through: self.xy_to_game(),
+            six: self.sgx_six_seated,
+        })
+    }
+
+    pub fn wants_pad_names(&self) -> bool {
+        self.console.names.is_empty() && self.pad_mode().is_some_and(|m| m.platform.is_arcade())
+    }
+
+    pub fn set_pad_names(&mut self, names: Vec<(u32, String)>) {
+        self.console.names = names;
+    }
+
+    pub fn pad_names(&self) -> &[(u32, String)] {
+        &self.console.names
+    }
+
+    pub fn active_controls(&self) -> Controls {
+        match self.pad_mode() {
+            Some(_) => self.console.controls,
+            None => self.controls,
+        }
+    }
+
+    pub fn console_triggers(&self) -> bool {
+        self.pad_mode()
+            .is_some_and(|m| console_pad::triggers(m, &self.console.names))
+    }
+
+    pub fn console_labels(&self) -> Vec<(QuickRow, String)> {
+        self.pad_mode()
+            .map(|m| console_pad::labels(m, &self.console.names))
+            .unwrap_or_default()
+    }
+
+    fn console_hidden(&self, mode: PadMode) -> Vec<QuickRow> {
+        let labels = console_pad::labels(mode, &self.console.names);
+        QuickRow::IN_GAME
+            .into_iter()
+            .filter(|r| match labels.iter().find(|(l, _)| l == r) {
+                Some((_, text)) => text.starts_with("Turbo ") && !self.state.turbo,
+                None => true,
+            })
+            .collect()
+    }
+
+    pub(super) fn console_rows(&self, mut hidden: Vec<QuickRow>) -> Vec<QuickRow> {
+        if let Some(mode) = self.pad_mode() {
+            hidden.retain(|r| r.game_button().is_none());
+            hidden.extend(self.console_hidden(mode));
+        }
+        hidden
+    }
+
+    pub(super) fn in_game_rows_hidden(&self) -> Vec<QuickRow> {
+        let mut hidden = self.in_game_hidden();
+        if self.pad_mode().is_none() {
+            hidden.extend([QuickRow::GameL2, QuickRow::GameR2]);
+        }
+        hidden
+    }
+
+    pub(super) fn console_set(&mut self, g: GameButton, binding: Option<Binding>) -> bool {
+        let Some(mode) = self.pad_mode() else {
+            return false;
+        };
+        self.console.controls.set_game(g, binding);
+        if let Some(root) = &self.root {
+            let written = write_console_binding(root, mode.platform, g, binding);
+            if let Err(e) = &written {
+                eprintln!("slot: controls: {e}");
+            }
+            self.card_writes.wrote("controls", &written);
+        }
+        true
+    }
+
+    pub(super) fn console_reset(&mut self) -> bool {
+        let Some(mode) = self.pad_mode() else {
+            return false;
+        };
+        self.console.controls = console_factory(mode.platform);
+        if let Some(root) = &self.root {
+            let written = reset_console_controls(root, mode.platform);
+            if let Err(e) = &written {
+                eprintln!("slot: controls: {e}");
+            }
+            self.card_writes.wrote("controls", &written);
+        }
+        true
+    }
+
+    pub(super) fn console_is_default(&self) -> Option<bool> {
+        let mode = self.pad_mode()?;
+        Some(self.console.controls == console_factory(mode.platform))
+    }
+
+    pub(super) fn console_clash_table(&self) -> Option<crate::input::Table> {
+        let mode = self.pad_mode()?;
+        let mut controls = self.console.controls;
+        for row in self.console_hidden(mode) {
+            if let Some(g) = row.game_button() {
+                controls.set_game(g, None);
+            }
+        }
+        let mut keys = self.shortcuts;
+        if self.triggers_to_game() {
+            for s in Shortcut::ALL {
+                let on_trigger = keys.get(s).is_some_and(|b| {
+                    b.modifier.is_none() && matches!(b.button, Device::L2 | Device::R2)
+                });
+                if on_trigger {
+                    keys.set(s, None);
+                }
+            }
+        }
+        Some(crate::input::Table::new(
+            &controls,
+            &keys,
+            &self.carousel,
+            true,
+        ))
+    }
+
+    pub fn console_label_texts(&self) -> Vec<String> {
+        self.console_labels()
+            .into_iter()
+            .map(|(_, text)| text)
+            .filter(|text| !self.console.faces.contains_key(text))
+            .collect()
+    }
+
+    pub fn add_console_label_face(&mut self, text: String, faces: FacePair) {
+        self.console.faces.insert(text, faces);
+    }
+
+    pub(super) fn forget_upstream_labels(&mut self) {
+        self.console.upstream.clear();
+    }
+
+    pub fn apply_console_labels(&mut self) {
+        let wanted = self.console_labels();
+        let console = &mut self.console;
+        let Some(faces) = self.quick_menu_faces.as_mut() else {
+            return;
+        };
+        if console.upstream.is_empty() {
+            console.upstream = QuickRow::IN_GAME
+                .into_iter()
+                .filter_map(|r| faces.labels.get(r.index()).map(|f| (r, *f)))
+                .collect();
+        }
+        for (row, upstream) in &console.upstream {
+            let face = wanted
+                .iter()
+                .find(|(r, _)| r == row)
+                .and_then(|(_, text)| console.faces.get(text))
+                .copied()
+                .unwrap_or(*upstream);
+            if let Some(slot) = faces.labels.get_mut(row.index()) {
+                *slot = face;
+            }
+        }
+    }
+}
