@@ -0,0 +1,343 @@
+use std::sync::atomic::{AtomicBool, AtomicU16, Ordering};
+use std::sync::Mutex;
+
+use slot_retro::{ButtonMask as M, RetroCore};
+use slot_store::{GameButton, Platform};
+use slot_ui::QuickRow;
+
+use crate::app::App;
+use crate::emu::EmuHandle;
+use crate::ws_input::{self, Layout};
+
+#[derive(Default)]
+pub struct PadSeen {
+    named: AtomicBool,
+    names: Mutex<Option<Vec<(u32, String)>>>,
+    polled: AtomicU16,
+    answered: AtomicU16,
+    last_answer: AtomicU16,
+}
+
+impl PadSeen {
+    pub fn note(&self, core: &dyn RetroCore, sent: M) {
+        let polled = core.polled();
+        let answer = sent.0 & polled;
+        self.answered.fetch_or(answer, Ordering::Relaxed);
+        let trace = crate::session::trace();
+        if self.polled.swap(polled, Ordering::Relaxed) != polled && trace {
+            eprintln!("slot: pad polled {polled:#06x}");
+        }
+        if self.last_answer.swap(answer, Ordering::Relaxed) != answer && trace {
+            eprintln!("slot: pad answered {answer:#06x}");
+        }
+        if self.named.load(Ordering::Relaxed) {
+            return;
+        }
+        let names = core.pad_names();
+        if names.is_empty() {
+            return;
+        }
+        if trace {
+            eprintln!("slot: pad names {names:?}");
+        }
+        if let Ok(mut slot) = self.names.lock() {
+            *slot = Some(names);
+            self.named.store(true, Ordering::Relaxed);
+        }
+    }
+
+    pub fn names(&self) -> Option<Vec<(u32, String)>> {
+        self.names.lock().ok().and_then(|n| n.clone())
+    }
+
+    pub fn polled(&self) -> u16 {
+        self.polled.load(Ordering::Relaxed)
+    }
+
+    pub fn take_answered(&self) -> u16 {
+        self.answered.swap(0, Ordering::Relaxed)
+    }
+}
+
+pub fn sync_names(app: &mut App, emu: &EmuHandle) {
+    if !app.wants_pad_names() {
+        return;
+    }
+    if let Some(names) = emu.pad_seen().names() {
+        app.set_pad_names(names);
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct PadMode {
+    pub platform: Platform,
+    pub code: u8,
+    pub pass_through: bool,
+    pub six: bool,
+}
+
+impl PadMode {
+    pub fn plain(platform: Platform) -> PadMode {
+        PadMode {
+            platform,
+            code: crate::atari_switches::AtariSwitches::default()
+                .pad_code(platform)
+                .unwrap_or_else(|| ws_input::pad_code(platform, false, false)),
+            pass_through: platform.passes_xy_through(),
+            six: false,
+        }
+    }
+
+    pub fn passes(self) -> bool {
+        self.pass_through && !ws_input::turns(self.code)
+    }
+
+    pub fn delivered(self, mask: M) -> M {
+        let layout = ws_input::starting_layout(self.code);
+        let out = ws_input::pass(self.code, layout, mask);
+        match self.passes() {
+            true => out,
+            false => M(out.0 & !(M::X | M::Y)),
+        }
+    }
+
+    fn turbo_of(self, mask: M) -> u16 {
+        let out = ws_input::pass(self.code, ws_input::starting_layout(self.code), mask);
+        match self.passes() {
+            true => 0,
+            false => out.0 & (M::X | M::Y),
+        }
+    }
+
+    fn shifts(self, g: GameButton) -> Option<&'static str> {
+        let horizontal = self.platform == Platform::Ws
+            && ws_input::starting_layout(self.code) == Layout::Horizontal;
+        match (horizontal, g) {
+            (true, GameButton::L) => Some("Y Pad on D-Pad"),
+            (true, GameButton::R) => Some("Y Pad on Buttons"),
+            _ => None,
+        }
+    }
+}
+
+pub fn ids(bits: u16) -> impl Iterator<Item = u32> {
+    (0..16u32).filter(move |id| bits & (1 << id) != 0)
+}
+
+pub fn row_bits(mode: PadMode, g: GameButton) -> u16 {
+    let bit = M(crate::input::bit(g));
+    let turbo = mode.turbo_of(bit);
+    let pulse = |from: u16, to: u16| if turbo & from != 0 { to } else { 0 };
+    mode.delivered(bit).0 | pulse(M::X, M::A) | pulse(M::Y, M::B)
+}
+
+pub fn label(mode: PadMode, names: &[(u32, String)], g: GameButton) -> Option<String> {
+    if let Some(shift) = mode.shifts(g) {
+        return Some(shift.to_string());
+    }
+    let bit = M(crate::input::bit(g));
+    let name = |id: u32| name_of(mode, names, id);
+    let turbo: Vec<String> = ids(mode.turbo_of(bit))
+        .filter_map(|id| match id {
+            1 => name(0),
+            _ => name(8),
+        })
+        .map(|n| format!("Turbo {}", n.strip_suffix(" Button").unwrap_or(&n)))
+        .collect();
+    let plain: Vec<String> = ids(mode.delivered(bit).0).filter_map(name).collect();
+    let all: Vec<String> = plain.into_iter().chain(turbo).collect();
+    (!all.is_empty()).then(|| all.join(" + "))
+}
+
+pub fn triggers(mode: PadMode, names: &[(u32, String)]) -> bool {
+    [GameButton::L2, GameButton::R2]
+        .into_iter()
+        .any(|g| label(mode, names, g).is_some())
+}
+
+pub fn hidden(mode: PadMode, names: &[(u32, String)]) -> Vec<QuickRow> {
+    QuickRow::IN_GAME
+        .into_iter()
+        .filter(|r| {
+            r.game_button()
+                .is_some_and(|g| label(mode, names, g).is_none())
+        })
+        .collect()
+}
+
+pub fn labels(mode: PadMode, names: &[(u32, String)]) -> Vec<(QuickRow, String)> {
+    QuickRow::IN_GAME
+        .into_iter()
+        .filter_map(|r| Some((r, label(mode, names, r.game_button()?)?)))
+        .collect()
+}
+
+fn name_of(mode: PadMode, names: &[(u32, String)], id: u32) -> Option<String> {
+    if mode.platform.is_arcade() && !names.is_empty() {
+        return names.iter().find(|(i, _)| *i == id).map(|(_, n)| n.clone());
+    }
+    core_name(mode.platform, mode.six, id).map(str::to_string)
+}
+
+fn direction(id: u32) -> Option<&'static str> {
+    match id {
+        4 => Some("Up"),
+        5 => Some("Down"),
+        6 => Some("Left"),
+        7 => Some("Right"),
+        _ => None,
+    }
+}
+
+pub fn core_name(platform: Platform, six: bool, id: u32) -> Option<&'static str> {
+    let face = |b: &'static str, y: &'static str, a: &'static str, x: &'static str| match id {
+        0 => Some(b),
+        1 => Some(y),
+        8 => Some(a),
+        9 => Some(x),
+        _ => None,
+    };
+    let start_select = |start: &'static str, select: Option<&'static str>| match id {
+        3 => Some(start),
+        2 => select,
+        _ => None,
+    };
+    let none = || None::<&'static str>;
+    match platform {
+        Platform::Gba | Platform::Gb | Platform::Gbc | Platform::Nes | Platform::Fds => {
+            match id {
+                0 => Some("B Button"),
+                8 => Some("A Button"),
+                10 if platform == Platform::Gba => Some("L Button"),
+                11 if platform == Platform::Gba => Some("R Button"),
+                _ => start_select("Start", Some("Select")),
+            }
+        }
+        .or_else(|| direction(id)),
+        Platform::Snes => face("B Button", "Y Button", "A Button", "X Button")
+            .or_else(|| match id {
+                10 => Some("L Button"),
+                11 => Some("R Button"),
+                _ => start_select("Start", Some("Select")),
+            })
+            .or_else(|| direction(id)),
+        Platform::Md | Platform::SegaCd | Platform::S32x => {
+            face("B Button", "A Button", "C Button", "Y Button")
+                .or_else(|| match id {
+                    10 => Some("X Button"),
+                    11 => Some("Z Button"),
+                    _ => start_select("Start", Some("Mode")),
+                })
+                .or_else(|| direction(id))
+        }
+        Platform::Gg | Platform::Sms => match id {
+            0 => Some("Button 1"),
+            8 => Some("Button 2"),
+            3 if platform == Platform::Sms => Some("Pause"),
+            3 => Some("Start"),
+            _ => none(),
+        }
+        .or_else(|| direction(id)),
+        Platform::Ps1 => face("Cross", "Square", "Circle", "Triangle")
+            .or_else(|| match id {
+                10 => Some("L1"),
+                11 => Some("R1"),
+                12 => Some("L2"),
+                13 => Some("R2"),
+                _ => start_select("Start", Some("Select")),
+            })
+            .or_else(|| direction(id)),
+        Platform::Tg16 | Platform::Pcecd | Platform::Sgx => match (id, six) {
+            (0, _) => Some("Button II"),
+            (8, _) => Some("Button I"),
+            (1, true) => Some("Button III"),
+            (9, true) => Some("Button IV"),
+            (10, true) => Some("Button V"),
+            (11, true) => Some("Button VI"),
+            _ => start_select("Run", Some("Select")),
+        }
+        .or_else(|| direction(id)),
+        Platform::Ws => match id {
+            4 => Some("X1"),
+            7 => Some("X2"),
+            5 => Some("X3"),
+            6 => Some("X4"),
+            13 => Some("Y1"),
+            11 => Some("Y2"),
+            12 => Some("Y3"),
+            10 => Some("Y4"),
+            0 => Some("B Button"),
+            8 => Some("A Button"),
+            _ => start_select("Start", None),
+        },
+        Platform::Lynx => match id {
+            0 => Some("B Button"),
+            8 => Some("A Button"),
+            10 => Some("Option 2"),
+            11 => Some("Option 1"),
+            _ => start_select("Pause", None),
+        }
+        .or_else(|| direction(id)),
+        Platform::Ngp => match id {
+            0 => Some("A Button"),
+            8 => Some("B Button"),
+            _ => start_select("Option", None),
+        }
+        .or_else(|| direction(id)),
+        Platform::A2600 => match id {
+            0 => Some("Fire"),
+            _ => start_select("Game Reset", Some("Game Select")),
+        }
+        .or_else(|| direction(id)),
+        Platform::A7800 => match id {
+            0 => Some("Button 1"),
+            8 => Some("Button 2"),
+            9 => Some("Reset"),
+            _ => start_select("Pause", Some("Select")),
+        }
+        .or_else(|| direction(id)),
+        Platform::Vb => match id {
+            4 => Some("Left Pad Up"),
+            5 => Some("Left Pad Down"),
+            6 => Some("Left Pad Left"),
+            7 => Some("Left Pad Right"),
+            12 => Some("Right Pad Up"),
+            15 => Some("Right Pad Right"),
+            14 => Some("Right Pad Down"),
+            13 => Some("Right Pad Left"),
+            0 => Some("B Button"),
+            8 => Some("A Button"),
+            10 => Some("L Button"),
+            11 => Some("R Button"),
+            _ => start_select("Start", Some("Select")),
+        },
+        Platform::Neocd => face("A Button", "C Button", "B Button", "D Button")
+            .or_else(|| match id {
+                10 => Some("B+C"),
+                12 => Some("A+B"),
+                13 => Some("A+B+C"),
+                _ => start_select("Start", Some("Select")),
+            })
+            .or_else(|| direction(id)),
+        Platform::NeoGeo => face("A Button", "C Button", "B Button", "D Button")
+            .or_else(|| match id {
+                10 => Some("Buttons CD"),
+                11 => Some("Buttons AB"),
+                _ => start_select("Start", Some("Coin")),
+            })
+            .or_else(|| direction(id)),
+        Platform::Cps1 | Platform::Cps2 => face("Button 1", "Button 3", "Button 2", "Button 4")
+            .or_else(|| match id {
+                11 => Some("Button 5"),
+                10 => Some("Button 6"),
+                _ => start_select("Start", Some("Coin")),
+            })
+            .or_else(|| direction(id)),
+        Platform::Pico8 => match id {
+            0 => Some("O Button"),
+            8 => Some("X Button"),
+            _ => start_select("Pause", None),
+        }
+        .or_else(|| direction(id)),
+    }
+}
