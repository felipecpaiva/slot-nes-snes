+++ b/crates/slot/tests/ngp_screen.rs
@@ -0,0 +1,151 @@
+mod common;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::platform_video::{default_video_mode, picture_choices, system_picture, PICTURE_FILE};
+use slot::video_mode::VideoMode;
+use slot_input::{Action, Btn};
+use slot_store::{read_sega_shaders, Platform, Shader, NGP_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_a_cart() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(root.path().join("Games/NGP/Pocket.ngc"), [0u8; 16]).expect("write cart");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_neogeo_pocket(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenNgp.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenNgp));
+    press(app, Btn::A);
+}
+
+#[test]
+fn the_neogeo_pocket_closes_the_screen_list_with_a_shader_and_picture_section_only() {
+    assert_eq!(QuickRow::SCREEN.last(), Some(&QuickRow::ScreenNgp));
+    assert_eq!(QuickRow::ScreenNgp.label(), "Neo Geo Pocket");
+    assert!(QuickRow::ScreenNgp.opens());
+    assert_eq!(QuickRow::ScreenNgp.child(), Some(QuickRow::NgpShader));
+    assert_eq!(
+        QuickRow::SCREEN_NGP,
+        [QuickRow::NgpShader, QuickRow::NgpPicture]
+    );
+    assert_eq!(
+        QuickRow::SCREEN_NGP.map(QuickRow::label),
+        ["Shader", "Picture"]
+    );
+    for row in QuickRow::SCREEN_NGP {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenNgp));
+    }
+}
+
+#[test]
+fn the_neogeo_pocket_row_shows_only_on_a_card_with_neogeo_pocket_games() {
+    let (_root, mut app) = card_with_a_cart();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenNgp));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    let without = boot(root.path());
+    assert!(without.hidden_rows().contains(&QuickRow::ScreenNgp));
+    open_neogeo_pocket(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::NgpShader));
+}
+
+#[test]
+fn the_neogeo_pocket_picture_starts_actual_and_offers_stretch_but_no_crop() {
+    assert_eq!(default_video_mode(Platform::Ngp), VideoMode::Actual);
+    assert_eq!(
+        picture_choices(Platform::Ngp),
+        [VideoMode::Stretch, VideoMode::Actual]
+    );
+    let (root, mut app) = card_with_a_cart();
+    assert_eq!(
+        system_picture(root.path(), Platform::Ngp),
+        VideoMode::Actual
+    );
+    open_neogeo_pocket(&mut app);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::NgpPicture));
+    assert_eq!(
+        app.quick_value(QuickRow::NgpPicture),
+        Some(QuickValue::Actual)
+    );
+    for want in [VideoMode::Stretch, VideoMode::Actual, VideoMode::Stretch] {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        assert_eq!(
+            app.quick_value(QuickRow::NgpPicture),
+            Some(want.quick_value())
+        );
+        assert_eq!(system_picture(root.path(), Platform::Ngp), want);
+    }
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "ngp = stretch\n"
+    );
+    let again = boot(root.path());
+    assert_eq!(
+        again.quick_value(QuickRow::NgpPicture),
+        Some(QuickValue::Stretch)
+    );
+}
+
+#[test]
+fn the_neogeo_pocket_shader_walks_off_lcd3x_and_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_cart();
+    let state = std::fs::read(root.path().join("Config/slot.state")).ok();
+    open_neogeo_pocket(&mut app);
+    assert_eq!(app.quick_value(QuickRow::NgpShader), Some(QuickValue::Off));
+    let mut seen = Vec::new();
+    for _ in 0..Shader::GG.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(read_sega_shaders(root.path()).ngp);
+    }
+    assert_eq!(seen, [&Shader::GG[1..], &Shader::GG[..1]].concat());
+    assert_eq!(seen[0], Shader::Lcd3x);
+    assert!(root.path().join("Config").join(NGP_SHADER_FILE).exists());
+    assert!(!root.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(
+        std::fs::read(root.path().join("Config/slot.state")).ok(),
+        state
+    );
+}
+
+#[test]
+fn a_chosen_neogeo_pocket_shader_is_the_one_the_next_boot_starts_with() {
+    let (root, mut app) = card_with_a_cart();
+    open_neogeo_pocket(&mut app);
+    press(&mut app, Btn::Right);
+    app.flush_state();
+    let again = boot(root.path());
+    assert_eq!(
+        again.quick_value(QuickRow::NgpShader),
+        Some(QuickValue::Lcd3x)
+    );
+}
+
+#[test]
+fn an_unknown_neogeo_pocket_shader_value_reads_as_off() {
+    let (root, _app) = card_with_a_cart();
+    std::fs::write(
+        root.path().join("Config").join(NGP_SHADER_FILE),
+        "ngp=bogus\n",
+    )
+    .expect("write");
+    let app = boot(root.path());
+    assert_eq!(app.quick_value(QuickRow::NgpShader), Some(QuickValue::Off));
+}
