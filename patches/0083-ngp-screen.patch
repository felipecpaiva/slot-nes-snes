@@ -0,0 +1,100 @@
+mod common;
+mod core_common;
+mod ngp_common;
+mod real_seat;
+
+use common::core_lock;
+use ngp_common::{cart, neopop};
+use slot::core::open_core_for_palette;
+use slot::platform_video::shown;
+use slot::video_mode::{source_rect, VideoMode};
+use slot_gfx::WHOLE_TEXTURE;
+use slot_input::Action;
+use slot_retro::ButtonMask;
+use slot_store::{Core, Platform, Shader};
+use slot_ui::{QuickRow, QuickValue};
+
+fn ngp_rect(mode: VideoMode) -> [f32; 4] {
+    source_rect(
+        Platform::Ngp,
+        shown(Platform::Ngp, 160, mode),
+        Core::MednafenNgp.canvas(Platform::Ngp),
+        mode,
+    )
+}
+
+#[test]
+fn every_pixel_of_the_ngp_picture_sits_at_40_4_in_the_240_by_160_canvas_slot_opens() {
+    let _g = core_lock();
+    let Some(dylib) = neopop() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let rom = cart(&d.path().join("Games/NGP"), "Canvas", false);
+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::MednafenNgp,
+        Platform::Ngp,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.load(&rom).expect("Beetle NeoPop refused the cart");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(core.canvas(), (240, 160));
+    let video = core.video_xrgb8888();
+    assert_eq!(video.len(), 240 * 160 * 4);
+    for y in 0..160 {
+        for x in 0..240 {
+            let at = (y * 240 + x) * 4;
+            let px = &video[at..at + 3];
+            if (40..200).contains(&x) && (4..156).contains(&y) {
+                assert!(
+                    px[2] > 200 && px[1] < 60 && px[0] < 60,
+                    "({x}, {y}) is {px:?}"
+                );
+            } else {
+                assert_eq!(px, [0, 0, 0], "({x}, {y}) is not a black bar");
+            }
+        }
+    }
+}
+
+#[test]
+fn actual_draws_the_canvas_at_3x_so_the_picture_is_480_by_456_in_the_middle() {
+    assert_eq!(shown(Platform::Ngp, 160, VideoMode::Actual), (160, 152));
+    assert_eq!(ngp_rect(VideoMode::Actual), WHOLE_TEXTURE);
+}
+
+#[test]
+fn stretch_fills_the_720_by_480_panel_with_the_160_by_152_picture_alone() {
+    assert_eq!(
+        ngp_rect(VideoMode::Stretch),
+        [40.0 / 240.0, 4.0 / 160.0, 160.0 / 240.0, 152.0 / 160.0]
+    );
+}
+
+#[test]
+fn the_in_game_shader_shortcut_and_row_walk_the_ngp_list() {
+    let _g = core_lock();
+    let Some(dylib) = neopop() else {
+        return;
+    };
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = cart(carts.path(), "Pocket", false);
+    let root = real_seat::rooted(Platform::Ngp, "Pocket", &rom, &dylib);
+    let mut session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().screen_shader(), Shader::Off);
+    session.app_mut().apply(Action::ShaderNext);
+    assert_eq!(session.app().screen_shader(), Shader::Lcd3x);
+    assert_eq!(
+        session.app().quick_value(QuickRow::Shader),
+        Some(QuickValue::Lcd3x)
+    );
+    session.app_mut().apply(Action::ShaderPrev);
+    session.app_mut().apply(Action::ShaderPrev);
+    assert_eq!(session.app().screen_shader(), *Shader::GG.last().unwrap());
+}
