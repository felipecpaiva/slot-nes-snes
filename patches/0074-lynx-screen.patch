+    pub fn actual_scale(self) -> Option<u32> {
+        match self {
+            Platform::Lynx => Some(4),
+            Platform::Gba
+            | Platform::Gb
+            | Platform::Gbc
+            | Platform::Nes
+            | Platform::Snes
+            | Platform::Gg
+            | Platform::Sms
+            | Platform::Md
+            | Platform::Ps1
+            | Platform::Tg16
+            | Platform::Ws => None,
+        }
+    }
 }
