     let (canvas_w, canvas_h) = canvas;
     if mode == VideoMode::Actual {
-        return actual_rect(canvas);
+        return match platform.actual_scale() {
+            Some(scale) => window_rect(canvas, (OUT_W / scale, OUT_H / scale)),
+            None => actual_rect(canvas),
+        };
     }
     if mode == VideoMode::FourThree {
         return crate::platform_video::four_three_rect((w, h), canvas);
@@ -80,6 +83,19 @@ pub fn source_rect(
     ]
 }
 
+fn window_rect((canvas_w, canvas_h): (u32, u32), (w, h): (u32, u32)) -> [f32; 4] {
+    if canvas_w == 0 || canvas_h == 0 {
+        return WHOLE_TEXTURE;
+    }
+    let (cw, ch) = (canvas_w as f32, canvas_h as f32);
+    [
+        (cw - w as f32) / 2.0 / cw,
+        (ch - h as f32) / 2.0 / ch,
+        w as f32 / cw,
+        h as f32 / ch,
+    ]
+}
