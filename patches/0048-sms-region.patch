@@ -0,0 +1,95 @@
+use std::path::Path;
+
+use slot_retro::LibretroCore;
+use slot_store::{ini, Platform};
+use slot_ui::QuickValue;
+
+use crate::card_log::CardWrites;
+
+pub const REGION_FILE: &str = "Config/region.txt";
+
+const KEY: &str = "sms";
+
+const OPTION: &str = "genesis_plus_gx_region_detect";
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum Region {
+    #[default]
+    Auto,
+    Japan,
+    Usa,
+    Europe,
+}
+
+impl Region {
+    pub const ALL: [Region; 4] = [Region::Auto, Region::Japan, Region::Usa, Region::Europe];
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Region::Auto => "auto",
+            Region::Japan => "japan",
+            Region::Usa => "usa",
+            Region::Europe => "europe",
+        }
+    }
+
+    pub fn core_value(self) -> &'static str {
+        match self {
+            Region::Auto => "auto",
+            Region::Japan => "ntsc-j",
+            Region::Usa => "ntsc-u",
+            Region::Europe => "pal",
+        }
+    }
+
+    pub fn quick_value(self) -> QuickValue {
+        match self {
+            Region::Auto => QuickValue::Auto,
+            Region::Japan => QuickValue::Japan,
+            Region::Usa => QuickValue::Usa,
+            Region::Europe => QuickValue::Europe,
+        }
+    }
+
+    pub fn stepped(self, right: bool) -> Region {
+        let n = Region::ALL.len();
+        let at = Region::ALL.iter().position(|r| *r == self).unwrap_or(0);
+        let next = if right {
+            (at + 1) % n
+        } else {
+            (at + n - 1) % n
+        };
+        Region::ALL.get(next).copied().unwrap_or(self)
+    }
+
+    pub fn read(root: &Path) -> Region {
+        let Some(line) = ini::value(root, REGION_FILE, KEY) else {
+            return Region::Auto;
+        };
+        Region::ALL
+            .into_iter()
+            .find(|r| r.as_str() == line)
+            .unwrap_or_else(|| {
+                eprintln!("slot: region.txt: ignoring {KEY}={line}");
+                Region::Auto
+            })
+    }
+
+    pub fn save(self, root: &Path, writes: &CardWrites) {
+        let written = ini::write(root, REGION_FILE, KEY, self.as_str());
+        if let Err(e) = &written {
+            eprintln!("slot: core: could not write region.txt: {e}");
+        }
+        writes.wrote("region.txt", &written);
+    }
+}
+
+pub fn apply(core: &mut LibretroCore, root: &Path, platform: Platform) {
+    if platform != Platform::Sms {
+        return;
+    }
+    let region = Region::read(root);
+    if region != Region::Auto {
+        core.set_option(OPTION, region.core_value());
+    }
+}
