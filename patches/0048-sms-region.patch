@@ -0,0 +1,189 @@
+mod common;
+mod core_common;
+mod sega_common;
+
+use std::path::{Path, PathBuf};
+
+use common::{boot, core_lock, tmp_root_with_real_carts};
+use sega_common::{gg_rom, md_rom, sms_rom};
+use slot::app::App;
+use slot::core::open_core_for_palette;
+use slot::sms_region::REGION_FILE;
+use slot_input::{Action, Btn};
+use slot_retro::ButtonMask;
+use slot_store::{Core, Platform};
+use slot_ui::{QuickRow, QuickValue};
+
+fn fps_of(platform: Platform, rom: PathBuf, region: Option<&str>) -> Option<f64> {
+    let dylib = sega_common::genesis_plus_gx()?;
+    let d = tmp_root_with_real_carts(&[]);
+    if let Some(line) = region {
+        std::fs::write(d.path().join(REGION_FILE), line).expect("write region.txt");
+    }
+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::GenesisPlusGx,
+        platform,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.load(&rom).expect("Genesis Plus GX refused the cart");
+    core.run_frame(ButtonMask::default());
+    Some(core.av_info().fps)
+}
+
+fn write_cart(root: &Path, platform: Platform) {
+    let dir = root.join("Games").join(platform.dir_name());
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let cart = dir.join(format!("Sonic.{}", platform.extensions()[0]));
+    std::fs::write(cart, vec![0u8; 0x8000]).expect("write cart");
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+#[test]
+fn an_sms_cart_the_core_does_not_know_runs_at_ntsc_rate_on_auto() {
+    let _g = core_lock();
+    let Some(fps) = fps_of(Platform::Sms, sms_rom("region_auto.sms"), None) else {
+        return;
+    };
+    assert!((fps - 59.92).abs() < 0.05, "{fps}");
+}
+
+#[test]
+fn the_same_sms_cart_runs_at_pal_rate_with_region_europe() {
+    let _g = core_lock();
+    let Some(fps) = fps_of(
+        Platform::Sms,
+        sms_rom("region_europe.sms"),
+        Some("sms = europe\n"),
+    ) else {
+        return;
+    };
+    assert!((fps - 49.70).abs() < 0.05, "{fps}");
+}
+
+#[test]
+fn region_usa_keeps_an_sms_cart_at_ntsc_rate() {
+    let _g = core_lock();
+    let Some(fps) = fps_of(
+        Platform::Sms,
+        sms_rom("region_usa.sms"),
+        Some("sms = usa\n"),
+    ) else {
+        return;
+    };
+    assert!((fps - 59.92).abs() < 0.05, "{fps}");
+}
+
+#[test]
+fn region_europe_leaves_a_mega_drive_cart_at_its_own_rate() {
+    let _g = core_lock();
+    let Some(fps) = fps_of(
+        Platform::Md,
+        md_rom("region_md.md", true, false),
+        Some("sms = europe\n"),
+    ) else {
+        return;
+    };
+    assert!((fps - 59.92).abs() < 0.05, "{fps}");
+}
+
+#[test]
+fn region_europe_leaves_a_game_gear_cart_at_60() {
+    let _g = core_lock();
+    let Some(fps) = fps_of(Platform::Gg, gg_rom("region_gg.gg"), Some("sms = europe\n")) else {
+        return;
+    };
+    assert!((fps - 59.92).abs() < 0.05, "{fps}");
+}
+
+#[test]
+fn only_the_master_system_section_has_a_region_row_and_it_starts_on_auto() {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    write_cart(root.path(), Platform::Sms);
+    let app = boot(root.path());
+    assert_eq!(QuickRow::SmsRegion.label(), "Region");
+    assert_eq!(QuickRow::SCREEN_SMS.last(), Some(&QuickRow::SmsRegion));
+    assert_eq!(QuickRow::SmsRegion.parent(), Some(QuickRow::ScreenSms));
+    for page in [
+        &QuickRow::SCREEN_NES[..],
+        &QuickRow::SCREEN_SNES[..],
+        &QuickRow::SCREEN_GG[..],
+        &QuickRow::SCREEN_MD[..],
+        &QuickRow::SCREEN_PS1[..],
+    ] {
+        assert!(!page.contains(&QuickRow::SmsRegion), "{page:?}");
+    }
+    assert_eq!(app.quick_value(QuickRow::SmsRegion), Some(QuickValue::Auto));
+}
+
+#[test]
+fn stepping_the_region_row_walks_auto_japan_usa_europe_and_saves_it() {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    write_cart(root.path(), Platform::Sms);
+    let mut app = boot(root.path());
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(app.hidden_rows()) {
+        press(&mut app, Btn::Down);
+    }
+    press(&mut app, Btn::A);
+    for _ in 0..QuickRow::ScreenSms.position(app.hidden_rows()) {
+        press(&mut app, Btn::Down);
+    }
+    press(&mut app, Btn::A);
+    for _ in 0..3 {
+        press(&mut app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::SmsRegion));
+    for want in [QuickValue::Japan, QuickValue::Usa, QuickValue::Europe] {
+        press(&mut app, Btn::Right);
+        assert_eq!(app.quick_value(QuickRow::SmsRegion), Some(want));
+    }
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(REGION_FILE)).ok(),
+        Some("sms = europe\n".to_owned())
+    );
+    press(&mut app, Btn::Right);
+    assert_eq!(app.quick_value(QuickRow::SmsRegion), Some(QuickValue::Auto));
+    drop(app);
+    assert_eq!(
+        boot(root.path()).quick_value(QuickRow::SmsRegion),
+        Some(QuickValue::Auto)
+    );
+}
+
+#[test]
+fn an_unknown_region_line_reads_as_auto() {
+    let d = tempfile::tempdir().expect("tempdir");
+    std::fs::create_dir(d.path().join("Config")).expect("config dir");
+    std::fs::write(d.path().join(REGION_FILE), "sms = brazil\n").expect("write region.txt");
+    assert_eq!(
+        boot(d.path()).quick_value(QuickRow::SmsRegion),
+        Some(QuickValue::Auto)
+    );
+}
+
+#[test]
+fn a_mega_drive_cart_after_a_europe_sms_session_is_back_on_auto() {
+    let _g = core_lock();
+    let Some(sms) = fps_of(
+        Platform::Sms,
+        sms_rom("region_first.sms"),
+        Some("sms = europe\n"),
+    ) else {
+        return;
+    };
+    let md = fps_of(
+        Platform::Md,
+        md_rom("region_after.md", true, false),
+        Some("sms = europe\n"),
+    );
+    assert!((sms - 49.70).abs() < 0.05, "{sms}");
+    assert!(md.is_some_and(|fps| (fps - 59.92).abs() < 0.05), "{md:?}");
+}
