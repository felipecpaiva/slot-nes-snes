diff --git a/crates/slot/src/frame_trace.rs b/crates/slot/src/frame_trace.rs
new file mode 100644
index 0000000..caa63e6
--- /dev/null
+++ b/crates/slot/src/frame_trace.rs
@@ -0,0 +1,69 @@
+use std::time::Duration;
+
+const WINDOW: usize = 600;
+
+pub struct FrameTrace {
+    seen: Vec<f64>,
+}
+
+impl FrameTrace {
+    pub fn new() -> Self {
+        FrameTrace {
+            seen: Vec::with_capacity(WINDOW),
+        }
+    }
+
+    pub fn present(&mut self, seen: Duration) -> Option<String> {
+        self.seen.push(seen.as_secs_f64() * 1e3);
+        if self.seen.len() < WINDOW {
+            return None;
+        }
+        self.seen.sort_by(f64::total_cmp);
+        let at = |q: f64| self.seen.get((WINDOW as f64 * q).ceil() as usize - 1);
+        let line = match (at(0.5), at(0.99), self.seen.last()) {
+            (Some(p50), Some(p99), Some(max)) => Some(format!(
+                "slot: frametime: {WINDOW} presents, p50 {p50:.2} p99 {p99:.2} max {max:.2} ms"
+            )),
+            _ => None,
+        };
+        self.seen.clear();
+        line
+    }
+}
+
+impl Default for FrameTrace {
+    fn default() -> Self {
+        FrameTrace::new()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn six_hundred_presents_with_one_stall_report_the_median_and_the_stall() {
+        let mut trace = FrameTrace::new();
+        for _ in 0..599 {
+            assert_eq!(trace.present(Duration::from_secs_f64(0.01678)), None);
+        }
+        assert_eq!(
+            trace.present(Duration::from_millis(40)).as_deref(),
+            Some("slot: frametime: 600 presents, p50 16.78 p99 16.78 max 40.00 ms")
+        );
+    }
+
+    #[test]
+    fn the_next_window_starts_empty() {
+        let mut trace = FrameTrace::new();
+        for _ in 0..600 {
+            trace.present(Duration::from_millis(40));
+        }
+        for _ in 0..599 {
+            assert_eq!(trace.present(Duration::from_millis(17)), None);
+        }
+        assert!(trace
+            .present(Duration::from_millis(17))
+            .is_some_and(|l| l.ends_with("p50 17.00 p99 17.00 max 17.00 ms")));
+    }
+}
