index 0000000..fc67ac4
--- /dev/null
+++ b/crates/slot-ui/tests/shelf_lazy_probe.rs
@@ -0,0 +1,100 @@
+use std::fs;
+use std::path::Path;
+
+use slot_store::{Cart, Platform};
+use slot_ui::{Draw, GbShell, RetroShell, Shelf, SnesShell, TexId};
+
+const NOTCHED: TexId = TexId::from_raw(1);
+const ROUNDED: TexId = TexId::from_raw(2);
+const SNES: TexId = TexId::from_raw(3);
+const SFC: TexId = TexId::from_raw(4);
+const PLAIN: TexId = TexId::from_raw(5);
+
+fn cart(platform: Platform, stem: &str, rom: &Path) -> Cart {
+    Cart {
+        platform,
+        stem: stem.into(),
+        rom: rom.into(),
+        label: None,
+        code: String::new(),
+        shell: None,
+        title: String::new(),
+    }
+}
+
+fn gbc_rom() -> Vec<u8> {
+    let mut rom = vec![0u8; 0x150];
+    rom[0x143] = 0xc0;
+    rom
+}
+
+fn sfc_rom() -> Vec<u8> {
+    let mut rom = vec![0u8; 0x8000];
+    rom[0x7fc0 + 0x15] = 0x20;
+    rom[0x7fc0 + 0x19] = 0x00;
+    rom[0x7fc0 + 0x1c..0x7fc0 + 0x1e].copy_from_slice(&(!0x1234u16).to_le_bytes());
+    rom[0x7fc0 + 0x1e..0x7fc0 + 0x20].copy_from_slice(&0x1234u16.to_le_bytes());
+    rom
+}
+
+fn shelf_over(carts: Vec<Cart>) -> Shelf {
+    let mut shelf = Shelf::new(carts);
+    shelf.set_shadow(PLAIN);
+    shelf.set_gb_shadow(GbShell::Notched, NOTCHED);
+    shelf.set_gb_shadow(GbShell::Rounded, ROUNDED);
+    shelf.set_retro(&[
+        (RetroShell::Snes(SnesShell::Snes), SNES),
+        (RetroShell::Snes(SnesShell::Sfc), SFC),
+    ]);
+    shelf
+}
+
+fn faded_backings(shelf: &Shelf) -> Vec<TexId> {
+    let mut out = Vec::new();
+    shelf.draw(0.0, &mut out);
+    out.iter()
+        .filter_map(|d| match *d {
+            Draw::Tex { tex, .. } => Some(tex),
+            _ => None,
+        })
+        .collect()
+}
+
+fn three_carts(dir: &Path) -> Vec<Cart> {
+    vec![
+        cart(Platform::Gba, "Front", &dir.join("front.gba")),
+        cart(Platform::Gbc, "Colour", &dir.join("colour.gbc")),
+        cart(Platform::Snes, "Super", &dir.join("super.sfc")),
+    ]
+}
+
+#[test]
+fn a_neighbours_backing_follows_the_rom_as_it_is_at_draw_time() {
+    let dir = tempfile::tempdir().unwrap();
+    let shelf = shelf_over(three_carts(dir.path()));
+    fs::write(dir.path().join("colour.gbc"), gbc_rom()).unwrap();
+    fs::write(dir.path().join("super.sfc"), sfc_rom()).unwrap();
+    let backings = faded_backings(&shelf);
+    assert!(backings.contains(&ROUNDED));
+    assert!(backings.contains(&SFC));
+    assert!(!backings.contains(&NOTCHED));
+    assert!(!backings.contains(&SNES));
+}
+
+#[test]
+fn a_neighbours_backing_is_the_same_when_the_roms_exist_before_the_shelf() {
+    let dir = tempfile::tempdir().unwrap();
+    fs::write(dir.path().join("colour.gbc"), gbc_rom()).unwrap();
+    fs::write(dir.path().join("super.sfc"), sfc_rom()).unwrap();
+    let backings = faded_backings(&shelf_over(three_carts(dir.path())));
+    assert!(backings.contains(&ROUNDED));
+    assert!(backings.contains(&SFC));
+}
+
+#[test]
+fn missing_roms_still_draw_the_notched_and_plain_snes_backings() {
+    let dir = tempfile::tempdir().unwrap();
+    let backings = faded_backings(&shelf_over(three_carts(dir.path())));
+    assert!(backings.contains(&NOTCHED));
+    assert!(backings.contains(&SNES));
+}
