diff --git a/crates/slot/tests/server_shelves.rs b/crates/slot/tests/server_shelves.rs
new file mode 100644
index 0000000..f3a0fdd
--- /dev/null
+++ b/crates/slot/tests/server_shelves.rs
@@ -0,0 +1,197 @@
+//! Gamebit's server on the shelves this build adds to upstream's four Game Boy ones.
+use slot::server::Server;
+use slot_store::{Core, Platform, StateRing};
+use std::io::{Cursor, Read, Write};
+use std::net::TcpStream;
+use std::path::Path;
+use std::time::Duration;
+
+const AUTH: &str = "c2xvdDoxMjM0";
+
+fn start() -> (tempfile::TempDir, Server) {
+    let dir = tempfile::tempdir().unwrap();
+    let server = Server::start(dir.path().to_path_buf(), 0, "1234".to_string()).unwrap();
+    (dir, server)
+}
+
+fn call_bytes(port: u16, method: &str, target: &str) -> (u16, Vec<u8>) {
+    let raw = format!(
+        "{method} {target} HTTP/1.1\r\nHost: x\r\nAuthorization: Basic {AUTH}\r\nContent-Length: 0\r\n\r\n"
+    );
+    let mut s = TcpStream::connect(("127.0.0.1", port)).unwrap();
+    s.set_read_timeout(Some(Duration::from_secs(30))).unwrap();
+    s.write_all(raw.as_bytes()).unwrap();
+    let mut out = Vec::new();
+    let _ = s.read_to_end(&mut out);
+    let split = out.windows(4).position(|w| w == b"\r\n\r\n").unwrap();
+    let head = String::from_utf8_lossy(&out[..split]).into_owned();
+    let status = head
+        .split_whitespace()
+        .nth(1)
+        .and_then(|c| c.parse().ok())
+        .unwrap_or(0);
+    (status, out[split + 4..].to_vec())
+}
+
+fn json(port: u16, method: &str, target: &str) -> (u16, serde_json::Value) {
+    let (status, body) = call_bytes(port, method, target);
+    (
+        status,
+        serde_json::from_slice(&body).unwrap_or(serde_json::Value::Null),
+    )
+}
+
+fn put(root: &Path, rel: &str, data: &[u8]) {
+    let path = root.join(rel);
+    std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+    std::fs::write(path, data).unwrap();
+}
+
+fn added() -> Vec<Platform> {
+    Platform::SHELVES
+        .into_iter()
+        .filter(|p| !p.classic())
+        .collect()
+}
+
+/// The stem a shelf accepts: the arcade shelves only list sets from their set table.
+fn stem_of(p: Platform) -> &'static str {
+    match p {
+        Platform::Cps1 => "1941",
+        Platform::Cps2 => "1944",
+        Platform::NeoGeo => "19yy",
+        _ => "Alpha",
+    }
+}
+
+fn rom_name(p: Platform) -> String {
+    format!("{}.{}", stem_of(p), p.extensions()[0])
+}
+
+/// MORE_CART in the web page: `  NES: [312, 328],` lines.
+fn more_cart_table() -> std::collections::HashMap<String, [u32; 2]> {
+    let path = Path::new(env!("CARGO_MANIFEST_DIR")).join("../../web/src/lib/coverMode.ts");
+    let text = std::fs::read_to_string(path).unwrap();
+    let body = text
+        .split("MORE_CART")
+        .nth(1)
+        .unwrap()
+        .split("\n}")
+        .next()
+        .unwrap()
+        .to_string();
+    let mut out = std::collections::HashMap::new();
+    for line in body.lines().filter(|l| l.contains(": [")) {
+        let (tag, dims) = line.trim().trim_end_matches(',').split_once(": [").unwrap();
+        let dims: Vec<u32> = dims
+            .trim_end_matches(']')
+            .split(", ")
+            .map(|n| n.parse().unwrap())
+            .collect();
+        out.insert(tag.trim_matches('\'').to_string(), [dims[0], dims[1]]);
+    }
+    assert_eq!(out.len(), 23);
+    out
+}
+
+#[test]
+fn tags_keep_the_four_game_boy_shelves_first_and_list_the_rest_as_more() {
+    let (_d, server) = start();
+    let (status, v) = json(server.port(), "GET", "/api/tags");
+    assert_eq!(status, 200);
+    let tags: Vec<&str> = v["tags"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|t| t.as_str().unwrap())
+        .collect();
+    assert_eq!(tags, Platform::ALL.map(|p| p.dir_name()));
+    let more: Vec<&str> = v["more"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|t| t.as_str().unwrap())
+        .collect();
+    assert_eq!(
+        more,
+        added().iter().map(|p| p.dir_name()).collect::<Vec<_>>()
+    );
+    assert_eq!(more.len(), 23);
+    server.stop();
+}
+
+#[test]
+fn every_added_shelf_lists_its_game_and_serves_its_cart() {
+    let table = more_cart_table();
+    let (d, server) = start();
+    for p in added() {
+        put(
+            d.path(),
+            &format!("Games/{}/{}", p.dir_name(), rom_name(p)),
+            &[0u8; 0x400],
+        );
+    }
+    for p in added() {
+        let tag = p.dir_name();
+        let (status, v) = json(server.port(), "GET", &format!("/api/games/{tag}"));
+        assert_eq!(status, 200, "{tag}");
+        assert_eq!(v["games"].as_array().unwrap().len(), 1, "{tag}: {v}");
+        assert_eq!(v["games"][0]["rom"], rom_name(p), "{tag}");
+        let url = v["games"][0]["cartUrl"].as_str().unwrap().to_string();
+        let (status, body) = call_bytes(server.port(), "GET", &url);
+        assert_eq!(status, 200, "{tag} cart");
+        let d = image_webp::WebPDecoder::new(Cursor::new(&body))
+            .unwrap_or_else(|e| panic!("{tag}: {e}"));
+        let (w, h) = d.dimensions();
+        assert_eq!(
+            [w, h],
+            table[tag],
+            "{tag}: web/src/lib/coverMode.ts MORE_CART is not the size the server renders"
+        );
+    }
+    server.stop();
+}
+
+#[test]
+fn an_unknown_tag_is_still_not_found() {
+    let (_d, server) = start();
+    let (status, _) = json(server.port(), "GET", "/api/games/ATARI5200");
+    assert_eq!(status, 404);
+    server.stop();
+}
+
+#[test]
+fn a_state_under_an_added_cores_dir_is_counted_listed_renamed_and_purged() {
+    let (d, server) = start();
+    let p = Platform::Nes;
+    put(d.path(), "Games/NES/Alpha.nes", &[0u8; 0x400]);
+    let core = Core::EVERY
+        .into_iter()
+        .find(|c| c.runs(p) && !Platform::ALL.iter().any(|g| c.runs(*g)))
+        .unwrap();
+    let ring = StateRing::new(d.path(), p, core, "Alpha");
+    ring.write_resume(b"resume").unwrap();
+    ring.push(b"state", b"png", "2026-11-08_10-00-00").unwrap();
+    let port = server.port();
+    let (_, v) = json(port, "GET", "/api/games/NES");
+    assert_eq!(v["games"][0]["statesCount"], 1, "{v}");
+    let (status, v) = json(port, "GET", "/api/games/NES/0/states");
+    assert_eq!(status, 200);
+    assert_eq!(v["cores"][0]["id"], core.as_str(), "{v}");
+    assert_eq!(v["cores"][0]["resume"], true);
+    assert_eq!(v["cores"][0]["states"].as_array().unwrap().len(), 1);
+    let (status, _) = json(port, "POST", "/api/games/NES/0/rename?name=Gamma.nes");
+    assert_eq!(status, 200);
+    let moved = StateRing::new(d.path(), p, core, "Gamma");
+    assert_eq!(moved.read_resume().unwrap().unwrap(), b"resume");
+    assert_eq!(moved.list().unwrap().len(), 1);
+    let (status, _) = json(port, "DELETE", "/api/games/NES/0?purge=true&rom=Gamma.nes");
+    assert_eq!(status, 200);
+    assert!(!d
+        .path()
+        .join("States/NES")
+        .join(core.as_str())
+        .join("Gamma")
+        .exists());
+    server.stop();
+}
