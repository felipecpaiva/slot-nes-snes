 const GBA_CART = 360 / 212
 const GB_CART = 312 / 337
 
+// Cart picture size (w, h) of each shelf this build adds; slot's server_shelves test holds it equal to the
+// size the server renders.
+export const MORE_CART: Record<string, [number, number]> = {
+  NES: [312, 328],
+  SNES: [360, 225],
+  GG: [312, 304],
+  SMS: [360, 218],
+  MD: [360, 246],
+  PS1: [360, 360],
+  TG16: [360, 218],
+  WS: [360, 224],
+  Lynx: [360, 222],
+  NGP: [312, 268],
+  '32X': [360, 246],
+  A2600: [312, 373],
+  A7800: [312, 373],
+  VB: [360, 351],
+  NEOGEO: [360, 266],
+  CPS1: [360, 300],
+  CPS2: [222, 329],
+  FDS: [312, 367],
+  PICO8: [312, 400],
+  SGX: [360, 218],
+  PCECD: [360, 360],
+  SEGACD: [360, 360],
+  NEOCD: [360, 360],
+}
+
 export function cartAspect(tag: string): number {
+  const more = MORE_CART[tag]
+  if (more) return more[0] / more[1]
   return tag === 'GB' || tag === 'GBC' ? GB_CART : GBA_CART
 }
 
