@@ -0,0 +1,24 @@
+import { describe, expect, it } from 'vitest'
+import { isMoreShelf, MORE_NAMES, PLATFORM_TAGS, platformName } from '@/api/platforms'
+import { cartAspect, MORE_CART } from '../coverMode'
+
+describe('the shelves this build adds', () => {
+  it('have a name and a cart shape each, and none is one of the four Game Boy shelves', () => {
+    expect(Object.keys(MORE_CART).sort()).toEqual(Object.keys(MORE_NAMES).sort())
+    expect(Object.keys(MORE_NAMES)).toHaveLength(23)
+    for (const tag of PLATFORM_TAGS) expect(isMoreShelf(tag)).toBe(false)
+  })
+
+  it('are named and shaped from their own tables', () => {
+    expect(platformName('NES')).toBe('Nintendo Entertainment System')
+    expect(platformName('NOPE')).toBe('NOPE')
+    expect(cartAspect('PS1')).toBe(1)
+    expect(cartAspect('NES')).toBeCloseTo(312 / 328, 6)
+  })
+
+  it('leave the Game Boy shelves as they were', () => {
+    expect(platformName('GBAV')).toBe('Game Boy Advance Video')
+    expect(cartAspect('GBC')).toBeCloseTo(312 / 337, 6)
+    expect(cartAspect('GBA')).toBeCloseTo(360 / 212, 6)
+  })
+})
