diff --git a/crates/slot-gfx/tests/headless_egl.rs b/crates/slot-gfx/tests/headless_egl.rs
new file mode 100644
index 0000000..04a5b1c
--- /dev/null
+++ b/crates/slot-gfx/tests/headless_egl.rs
@@ -0,0 +1,16 @@
+#![cfg(target_os = "linux")]
+
+use slot_gfx::{Compositor, HeadlessSurface};
+
+#[test]
+fn the_linux_render_host_is_a_real_gles2_context() {
+    let surface = HeadlessSurface::new().expect("surfaceless egl context");
+    let _c = Compositor::new(&surface).expect("compositor on gles2");
+    // SAFETY: Compositor::new loaded the GL functions and the context is current.
+    let version = unsafe { gl::GetString(gl::VERSION) };
+    assert!(!version.is_null(), "no GL_VERSION");
+    // SAFETY: a non-null GL_VERSION is a NUL terminated static string.
+    let version = unsafe { std::ffi::CStr::from_ptr(version as *const std::ffi::c_char) };
+    let version = version.to_string_lossy();
+    assert!(version.starts_with("OpenGL ES"), "{version}");
+}
