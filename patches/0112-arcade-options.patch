From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paiva <felipe.paiva@gmail.com>
Date: Tue, 20 Oct 2026 12:19:15 +0400
Subject: [PATCH] arcade-options

FBNeo gets five explicit options (core_options_policy::FBNEO). Frameskip
is Auto, FBNeo's spelling of what every other core gets, so frames are
skipped only when the frontend's audio buffer runs low (fast-forward);
FBNeo's key is fbneo-frameskip-type, so the generic <prefix>_frameskip
answer does not reach it and is not logged as missing. The diagnostic
input is None: FBNeo's default, Hold Start, opens the cabinet's service
menu. Neo Geo mode stays DIPSWITCH (MVS Asia/Europe ver. 6, the BIOS slot
checks for), the memory card stays off, and patched romsets stay allowed.
Every other key is left to the core's own default, as for PicoDrive.
---
 crates/slot/src/core_options_policy.rs | 12 +++-
 crates/slot/tests/arcade_options.rs    | 82 ++++++++++++++++++++++++++
 2 files changed, 92 insertions(+), 2 deletions(-)
 create mode 100644 crates/slot/tests/arcade_options.rs

diff --git a/crates/slot/src/core_options_policy.rs b/crates/slot/src/core_options_policy.rs
index 45baab8..1c8f028 100644
--- a/crates/slot/src/core_options_policy.rs
+++ b/crates/slot/src/core_options_policy.rs
@@ -67,6 +67,14 @@ pub const BEETLE_LYNX: [(&str, &str); 3] = [
 
 const MEDNAFEN_NGP: [(&str, &str); 1] = [("ngp_language", "english")];
 
+pub const FBNEO: [(&str, &str); 5] = [
+    ("fbneo-frameskip-type", "Auto"),
+    ("fbneo-diagnostic-input", "None"),
+    ("fbneo-neogeo-mode", "DIPSWITCH"),
+    ("fbneo-memcard-mode", "disabled"),
+    ("fbneo-allow-patched-romsets", "enabled"),
+];
+
 pub const PICODRIVE: [(&str, &str); 8] = [
     ("picodrive_input1", "6 button pad"),
     ("picodrive_region", "Auto"),
@@ -142,7 +150,7 @@ pub fn apply_policy_options(core: &mut LibretroCore, which: Core) {
     let frameskip = format!("{}_frameskip", which.option_prefix());
     if core.declared_options().contains_key(&frameskip) {
         core.set_option(&frameskip, "auto");
-    } else if !core.declared_options().is_empty() {
+    } else if !core.declared_options().is_empty() && which != Core::Fbneo {
         eprintln!(
             "slot: core: {} declares no frameskip option",
             which.as_str()
@@ -187,7 +195,7 @@ pub fn apply_policy_options(core: &mut LibretroCore, which: Core) {
         Core::Stella2014 => &STELLA2014,
         Core::Prosystem => &PROSYSTEM,
         Core::MednafenVb => &BEETLE_VB,
-        Core::Fbneo => &[],
+        Core::Fbneo => &FBNEO,
     };
     for (key, value) in fixed {
         core.set_option(key, value);
diff --git a/crates/slot/tests/arcade_options.rs b/crates/slot/tests/arcade_options.rs
new file mode 100644
index 0000000..098e530
--- /dev/null
+++ b/crates/slot/tests/arcade_options.rs
@@ -0,0 +1,82 @@
+mod arcade_common;
+mod common;
+mod core_common;
+
+use std::path::Path;
+
+use arcade_common::fbneo;
+use common::core_lock;
+use slot::core::apply_core_options;
+use slot::core_options_policy::{answers_declared_defaults, FBNEO};
+use slot_retro::{LibretroCore, RetroCore};
+use slot_store::{Core, Platform};
+
+fn answered(dylib: &Path) -> LibretroCore {
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = LibretroCore::open_with(dylib, d.path(), d.path()).expect("open FBNeo");
+    apply_core_options(
+        &mut core,
+        Core::Fbneo,
+        Platform::Cps2,
+        "auto",
+        false,
+        false,
+        None,
+    );
+    core
+}
+
+#[test]
+fn every_explicit_arcade_option_is_answered_with_its_own_value() {
+    let _g = core_lock();
+    let Some(dylib) = fbneo() else {
+        return;
+    };
+    let core = answered(&dylib);
+    for (key, value) in FBNEO {
+        assert_eq!(core.option(key).as_deref(), Some(value), "{key}");
+    }
+}
+
+#[test]
+fn every_explicit_arcade_key_and_value_is_one_the_pinned_core_declares() {
+    // FBNeo declares its options when a set loads, the Neo Geo ones only for a Neo Geo set.
+    let _g = core_lock();
+    let Some(dylib) = fbneo() else {
+        return;
+    };
+    let d = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(slot::root::saves_dir(d.path())).unwrap();
+    let mut core = LibretroCore::open_with(
+        &dylib,
+        &slot::root::bios_dir(d.path()),
+        &slot::root::saves_dir(d.path()),
+    )
+    .expect("open FBNeo");
+    arcade_common::install_neogeo_bios(d.path());
+    core.load(&arcade_common::install(d.path(), &arcade_common::VLINER))
+        .expect("FBNeo refused vliner");
+    for (key, value) in FBNEO {
+        let values = core
+            .declared_options()
+            .get(key)
+            .unwrap_or_else(|| panic!("FBNeo does not declare {key}"));
+        assert!(
+            values.iter().any(|v| v == value),
+            "{key}={value} not in {values:?}"
+        );
+    }
+}
+
+#[test]
+fn the_service_menu_is_never_one_held_start_away() {
+    // FBNeo's own default, "Hold Start", opens the cabinet's service menu when Start is held.
+    assert!(FBNEO.contains(&("fbneo-diagnostic-input", "None")));
+}
+
+#[test]
+fn every_other_fbneo_option_keeps_the_cores_own_default() {
+    // Unanswered keys leave FBNeo on its compiled-in defaults: 48 kHz, 4-point interpolation, the
+    // vertical mode slot sets per game (arcade_turn), the hiscores it reads from BIOS/fbneo/.
+    assert!(!answers_declared_defaults(Core::Fbneo));
+}
