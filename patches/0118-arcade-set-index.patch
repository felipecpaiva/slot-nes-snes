--- /dev/null
+++ b/crates/slot-store/tests/scan_time.rs
@@ -0,0 +1,62 @@
+// A card with tens of thousands of games must still scan in a blink. The arcade set table once
+// cost a linear walk of every FBNeo set per scanned file on every shelf: 0.5 s became 14 s on the
+// device. This guard scans 20,000 files across the shelves and fails long before that comes back.
+use std::time::Instant;
+
+use slot_store::{scan, Platform};
+
+const FILES: usize = 20_000;
+
+fn card() -> tempfile::TempDir {
+    let d = tempfile::tempdir().unwrap();
+    let shelves: [(Platform, &str); 10] = [
+        (Platform::Gba, "gba"),
+        (Platform::Nes, "nes"),
+        (Platform::Snes, "sfc"),
+        (Platform::Md, "md"),
+        (Platform::Gg, "gg"),
+        (Platform::Sms, "sms"),
+        (Platform::Tg16, "pce"),
+        (Platform::A2600, "a26"),
+        (Platform::Vb, "vb"),
+        (Platform::Cps2, "zip"),
+    ];
+    for (platform, _) in shelves {
+        std::fs::create_dir_all(d.path().join("Games").join(platform.dir_name())).unwrap();
+    }
+    for i in 0..FILES {
+        let (platform, ext) = shelves[i % shelves.len()];
+        let stem = if platform == Platform::Cps2 && i == 9 {
+            "ddtod".to_string()
+        } else {
+            format!("Game {i:05} (USA)")
+        };
+        let dir = d.path().join("Games").join(platform.dir_name());
+        let _ = std::fs::write(dir.join(format!("{stem}.{ext}")), b"PK\x05\x06");
+    }
+    d
+}
+
+#[test]
+fn twenty_thousand_games_scan_in_well_under_a_second() {
+    let d = card();
+    scan(d.path()).unwrap();
+    let t = Instant::now();
+    let carts = scan(d.path()).unwrap();
+    let took = t.elapsed();
+    eprintln!("scan of {FILES} files: {took:?}");
+    assert!(carts.len() > FILES * 8 / 10, "scanned {}", carts.len());
+    assert!(
+        carts
+            .iter()
+            .any(|c| c.platform == Platform::Cps2
+                && c.shelf_name().starts_with("Dungeons & Dragons")),
+        "an arcade set still takes its full title"
+    );
+    // ponytail: wall-clock bound, generous for a debug build on a loaded CI runner; the regression it
+    // guards was more than 20x slower than this bound on the host.
+    assert!(
+        took.as_millis() < 1500,
+        "scan of {FILES} files took {took:?}"
+    );
+}
