+/// The set table, parsed once and keyed by board and lowercase set name. A scan asks for every
+/// file on every shelf, so a walk of the table per file is what a card of 20,000 games cannot afford.
+fn index() -> &'static HashMap<(&'static str, String), Set> {
+    static INDEX: OnceLock<HashMap<(&'static str, String), Set>> = OnceLock::new();
+    INDEX.get_or_init(|| {
+        SETS.lines()
+            .filter_map(|line| {
+                let mut cols = line.split('\t');
+                let (board, name, parent, flags, title) = (
+                    cols.next()?,
+                    cols.next()?,
+                    cols.next()?,
+                    cols.next()?,
+                    cols.next()?,
+                );
+                let set = Set {
+                    name,
+                    parent: (parent != "-").then_some(parent),
+                    title,
+                    vertical: flags.contains('v'),
+                };
+                Some(((board, name.to_ascii_lowercase()), set))
+            })
+            .collect()
     })
 }
 
+pub fn set(platform: Platform, stem: &str) -> Option<Set> {
+    if !platform.is_arcade() {
+        return None;
+    }
+    index()
+        .get(&(platform.dir_name(), stem.to_ascii_lowercase()))
+        .copied()
+}
