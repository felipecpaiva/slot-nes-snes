From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paiva <felipe.paiva@gmail.com>
Date: Sun, 18 Oct 2026 10:21:50 +0400
Subject: [PATCH] backlight-floor

The lowest backlight step lights the panel at 8/255 of the kernel's
maximum (at least 1) instead of a raw 1, which left the RG34XX panel
black. Backport of upstream BrandonKowalski/slot 3b6349c (issue #100),
https://github.com/BrandonKowalski/slot/commit/3b6349c, with its own
test change at named site (i). Drop on the 1.8.0 rebase.
---
 crates/slot-power/src/device.rs   | 7 ++++---
 crates/slot-power/tests/device.rs | 8 ++++----
 2 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/crates/slot-power/src/device.rs b/crates/slot-power/src/device.rs
index 5e101e8..2df7c74 100644
--- a/crates/slot-power/src/device.rs
+++ b/crates/slot-power/src/device.rs
@@ -12,7 +12,7 @@ use crate::{Battery, Charge, LedState, Platform};
 
 const TOP_STEP: u32 = 9;
 
-const BACKLIGHT_FLOOR: f64 = 1.0;
+const BACKLIGHT_FLOOR: f64 = 8.0 / 255.0;
 
 const BACKLIGHT_CURVE: f64 = 1.75;
 
@@ -414,8 +414,9 @@ fn backlight_value(step: u8, max: u32) -> u32 {
         return 0;
     }
     let t = f64::from(step - 1) / f64::from(TOP_STEP - 1);
-    let span = f64::from(max) - BACKLIGHT_FLOOR;
-    (BACKLIGHT_FLOOR + span * t.powf(BACKLIGHT_CURVE)).round() as u32
+    let floor = (f64::from(max) * BACKLIGHT_FLOOR).round().max(1.0);
+    let span = f64::from(max) - floor;
+    (floor + span * t.powf(BACKLIGHT_CURVE)).round() as u32
 }
 
 impl Platform for DevicePlatform {
diff --git a/crates/slot-power/tests/device.rs b/crates/slot-power/tests/device.rs
index 803b5d1..13dfc57 100644
--- a/crates/slot-power/tests/device.rs
+++ b/crates/slot-power/tests/device.rs
@@ -56,15 +56,15 @@ fn the_backlight_steps_span_whatever_range_the_kernel_reports() {
     assert_eq!(brightness(&d), 255);
     p.set_backlight(5);
     let mid = brightness(&d);
-    assert!((40..=80).contains(&mid), "step 5 of 9 wrote {mid} of 255");
+    assert!((40..=90).contains(&mid), "step 5 of 9 wrote {mid} of 255");
 }
 
 #[test]
-fn step_one_is_the_dimmest_lit_value() {
+fn step_one_is_the_dimmest_value_the_rg34xx_lights() {
     let d = sysfs("255", "87");
     let mut p = platform(&d);
     p.set_backlight(1);
-    assert_eq!(brightness(&d), 1);
+    assert_eq!(brightness(&d), 8);
 }
 
 #[test]
@@ -77,7 +77,7 @@ fn the_steps_follow_the_curve_from_the_floor_to_full() {
             brightness(&d)
         })
         .collect();
-    assert_eq!(wrote, [0, 1, 8, 23, 47, 77, 113, 155, 202, 255]);
+    assert_eq!(wrote, [0, 8, 14, 30, 52, 81, 117, 157, 204, 255]);
 }
 
 #[test]
