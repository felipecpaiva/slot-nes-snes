             let Some(stem) = rom.file_stem().and_then(|s| s.to_str()) else {
diff --git a/crates/slot-store/tests/bios_dumps.rs b/crates/slot-store/tests/bios_dumps.rs
new file mode 100644
index 0000000..5988ace
--- /dev/null
+++ b/crates/slot-store/tests/bios_dumps.rs
@@ -0,0 +1,39 @@
+mod common;
+
+use common::tmp_root;
+use slot_store::{scan, Platform};
+
+const BIOS: [(Platform, &str); 4] = [
+    (Platform::Tg16, "[BIOS] Super CD-ROM System (Japan) (v3.0)"),
+    (Platform::Lynx, "[BIOS] Atari Lynx (USA, Europe)"),
+    (
+        Platform::Ngp,
+        "[BIOS] SNK Neo Geo Pocket Color (World) (En,Ja)",
+    ),
+    (Platform::Gba, "[BIOS] Game Boy Advance (World)"),
+];
+
+fn put(root: &std::path::Path, platform: Platform, stem: &str) {
+    let dir = root.join("Games").join(platform.dir_name());
+    std::fs::create_dir_all(&dir).expect("create shelf dir");
+    let name = format!("{stem}.{}", platform.extensions()[0]);
+    std::fs::write(dir.join(name), vec![0u8; 0x4000]).expect("write cart");
+}
+
+#[test]
+fn a_file_named_as_a_bios_dump_never_lands_on_a_shelf() {
+    let d = tmp_root();
+    for (platform, bios) in BIOS {
+        put(d.path(), platform, bios);
+        put(d.path(), platform, "Bios Fear (USA)");
+    }
+    let carts = scan(d.path()).expect("scan");
+    for (platform, _) in BIOS {
+        let stems: Vec<&str> = carts
+            .iter()
+            .filter(|c| c.platform == platform)
+            .map(|c| c.stem.as_str())
+            .collect();
+        assert_eq!(stems, ["Bios Fear (USA)"], "{platform:?}");
+    }
+}
