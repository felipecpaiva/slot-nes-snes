index 4903e57..2c55b71 100644
--- a/crates/slot-store/src/scan.rs
+++ b/crates/slot-store/src/scan.rs
@@ -105,7 +105,11 @@ pub fn scan(root: &Path) -> Result<Vec<Cart>, StoreError> {
                 continue;
             };
             let rom = entry.path();
-            if is_hidden(&rom) || !platform.accepts(&rom) || !is_file(&entry) {
+            if is_hidden(&rom)
