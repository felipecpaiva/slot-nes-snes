 crates/slot-store/src/lib.rs          |  1 +
 crates/slot-store/src/scan.rs         |  6 ++++-
 crates/slot-store/tests/bios_dumps.rs | 39 +++++++++++++++++++++++++++
 4 files changed, 52 insertions(+), 1 deletion(-)
 create mode 100644 crates/slot-store/src/bios_dump.rs
 create mode 100644 crates/slot-store/tests/bios_dumps.rs

diff --git a/crates/slot-store/src/bios_dump.rs b/crates/slot-store/src/bios_dump.rs
new file mode 100644
index 0000000..71821dd
--- /dev/null
+++ b/crates/slot-store/src/bios_dump.rs
@@ -0,0 +1,7 @@
+use std::path::Path;
+
+pub fn is_bios_dump(p: &Path) -> bool {
+    p.file_name()
+        .and_then(|n| n.to_str())
+        .is_some_and(|n| n.starts_with("[BIOS]"))
+}
