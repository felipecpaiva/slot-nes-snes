diff --git a/crates/slot-ui/tests/fds_cart.rs b/crates/slot-ui/tests/fds_cart.rs
new file mode 100644
index 0000000..61b2fc2
--- /dev/null
+++ b/crates/slot-ui/tests/fds_cart.rs
@@ -0,0 +1,135 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    cart_box, label_cover, retro_cart_face, retro_label_rect, retro_shell_of, seated_box,
+    shell_for, RetroShell, FDS_YELLOW,
+};
+
+const RED: [u8; 3] = [230, 30, 30];
+
+fn rom(name: &str) -> PathBuf {
+    let p = std::env::temp_dir().join(format!("slot-fds-cart-{}-{name}", std::process::id()));
+    std::fs::write(&p, [0u8; 16]).expect("write disk");
+    p
+}
+
+fn cart(rom: PathBuf, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform: Platform::Fds,
+        stem: "Nazo no Murasamejou (Japan)".into(),
+        rom,
+        label,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn art(name: &str, w: u32, h: u32) -> PathBuf {
+    let px: Vec<u8> = (0..w * h)
+        .flat_map(|_| [RED[0], RED[1], RED[2], 255])
+        .collect();
+    let p = std::env::temp_dir().join(format!("slot-fds-art-{}-{name}.png", std::process::id()));
+    let mut e = png::Encoder::new(std::fs::File::create(&p).expect("create art"), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    p
+}
+
+fn near(p: &[u8], c: [u8; 3]) -> bool {
+    (0..3).all(|i| p[i].abs_diff(c[i]) < 24)
+}
+
+fn luma(p: &[u8]) -> u32 {
+    (p[0] as u32 * 54 + p[1] as u32 * 183 + p[2] as u32 * 19) / 256
+}
+
+#[test]
+fn every_disk_takes_the_one_yellow_disk_card_shell() {
+    for name in [
+        "Nazo no Murasamejou (Japan).fds",
+        "Esper Dream (Japan) (En).fds",
+        "Famicom Tantei Club Part II (Japan).FDS",
+    ] {
+        let c = cart(rom(name), None);
+        assert_eq!(retro_shell_of(&c), Some(RetroShell::Fds), "{name}");
+        assert_eq!(shell_for(&c), FDS_YELLOW, "{name}");
+    }
+    assert_eq!(RetroShell::Fds.name(), "fds");
+    assert_eq!(FDS_YELLOW.colour, [0xff, 0xc4, 0x00]);
+}
+
+#[test]
+fn a_chosen_shell_colour_still_wins_over_the_disk_yellow() {
+    let mut c = cart(rom("chosen.fds"), None);
+    c.shell = Some(ShellChoice {
+        outline: Outline::Auto,
+        colour: [0x20, 0x40, 0xa0],
+        finish: ShellFinish::Solid,
+    });
+    assert_eq!(retro_shell_of(&c), Some(RetroShell::Fds));
+    assert_eq!(shell_for(&c).colour, [0x20, 0x40, 0xa0]);
+}
+
+#[test]
+fn the_disk_card_keeps_the_real_proportions_with_a_wide_label_well_low_down() {
+    assert_eq!(seated_box(Platform::Fds), (240, 282));
+    assert_eq!(cart_box(Platform::Fds), (312, 367));
+    let (x, y, w, h) = retro_label_rect(RetroShell::Fds);
+    let px = |f: f32, of: f32| (f * of).round() as u32;
+    assert_eq!(
+        (px(x, 312.0), px(y, 367.0), px(w, 312.0), px(h, 367.0)),
+        (48, 224, 214, 90)
+    );
+}
+
+#[test]
+fn the_disk_renders_yellow_with_a_dark_head_window_and_the_corners_cut() {
+    let face = retro_cart_face(&cart(rom("bare.fds"), None), RetroShell::Fds);
+    if let Some(out) = std::env::var_os("SLOT_FDS_PREVIEW") {
+        let mut e = png::Encoder::new(std::fs::File::create(out).expect("preview"), 312, 367);
+        e.set_color(png::ColorType::Rgba);
+        e.set_depth(png::BitDepth::Eight);
+        e.write_header()
+            .and_then(|mut w| w.write_image_data(&face.rgba))
+            .expect("write preview");
+    }
+    assert_eq!((face.w, face.h), (312, 367));
+    let at = |x: u32, y: u32| &face.rgba[((y * 312 + x) * 4) as usize..][..4];
+    assert_eq!(
+        at(60, 3)[3],
+        0,
+        "the top edge steps down beside the centre tab"
+    );
+    assert_eq!(at(152, 3)[3], 255, "the centre tab stands up");
+    let body = at(30, 150);
+    assert!(
+        near(body, [0xff, 0xc4, 0x00]),
+        "the plastic is yellow: {body:?}"
+    );
+    let window = at(153, 60);
+    assert!(
+        luma(window) + 40 < luma(body),
+        "the head window is dark: {window:?} against {body:?}"
+    );
+}
+
+#[test]
+fn the_disk_renders_its_label_art_inside_the_well() {
+    let red = art("label", 428, 180);
+    let c = cart(rom("label.fds"), Some(red.clone()));
+    let (_, _, lw, lh) = retro_label_rect(RetroShell::Fds);
+    let (lw, lh) = ((lw * 312.0).round() as u32, (lh * 367.0).round() as u32);
+    assert!(label_cover(&c, &red, lw, lh).is_some());
+    let face = retro_cart_face(&c, RetroShell::Fds);
+    let red_at = |x: u32, y: u32| near(&face.rgba[((y * 312 + x) * 4) as usize..], RED);
+    assert!(red_at(156, 270), "the middle of the well is the label");
+    assert!(!red_at(156, 150), "the hub is above it");
+    assert!(!red_at(20, 270), "the side is plastic");
+    assert!(!red_at(156, 345), "the NINTENDO band is below it");
+}
