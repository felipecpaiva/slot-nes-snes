+#[test]
+fn a_flush_by_reload_keeps_the_game_where_it_was_and_writes_the_backup_ram() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let d = tempfile::tempdir().expect("tempdir");
+    put_bios(d.path(), "bios_CD_U.bin", &dummy_bios());
+    let saves = core_save_dir(d.path(), P);
+    std::fs::create_dir_all(&saves).expect("dirs");
+    let rom = iso_disc(d.path(), STEM, US);
+    let mut core =
+        LibretroCore::open_with(&dylib, &slot::root::bios_dir(d.path()), &saves).expect("open");
+    apply_core_options(
+        &mut core,
+        Core::GenesisPlusGx,
+        P,
+        "auto",
+        false,
+        false,
+        None,
+    );
+    core.load(&rom).expect("load");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    let mut once = core.serialize().expect("state");
+    core.unserialize(&once).expect("round trip");
+    once = core.serialize().expect("state");
+    let mut fastest = Duration::MAX;
+    for _ in 0..5 {
+        let started = Instant::now();
+        slot::ngp_flash::reload(&mut core, &rom).expect("reload");
+        fastest = fastest.min(started.elapsed());
+    }
+    println!("flush by reload: {:.2} ms", fastest.as_secs_f64() * 1000.0);
+    assert_eq!(core.serialize().expect("state"), once);
+    assert_formatted_bram(&saves.join(format!("{STEM}.brm")));
+    assert!(fastest < Duration::from_micros(16_600), "{fastest:?}");
+}
