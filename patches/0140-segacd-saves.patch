+#[test]
+fn a_flush_on_disc_two_of_a_set_stays_on_disc_two_and_names_the_backup_ram_after_the_set() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let d = tempfile::tempdir().expect("tempdir");
+    put_bios(d.path(), "bios_CD_U.bin", &dummy_bios());
+    let saves = core_save_dir(d.path(), P);
+    std::fs::create_dir_all(&saves).expect("dirs");
+    iso_disc(d.path(), "Night Trap (USA) (Disc 1)", US);
+    iso_disc(d.path(), "Night Trap (USA) (Disc 2)", US);
+    let m3u = d.path().join("Night Trap (USA).m3u");
+    std::fs::write(
+        &m3u,
+        "Night Trap (USA) (Disc 1).iso\nNight Trap (USA) (Disc 2).iso\n",
+    )
+    .expect("write the playlist");
+    let mut core =
+        LibretroCore::open_with(&dylib, &slot::root::bios_dir(d.path()), &saves).expect("open");
+    core.use_disc_drive();
+    apply_core_options(
+        &mut core,
+        Core::GenesisPlusGx,
+        P,
+        "auto",
+        false,
+        false,
+        None,
+    );
+    core.load(&m3u).expect("load");
+    core.next_disc();
+    core.run_frame(ButtonMask::default());
+    slot::ngp_flash::reload(&mut core, &m3u).expect("reload");
+    assert_eq!(core.disc_index(), 1);
+    assert_formatted_bram(&saves.join("Night Trap (USA).brm"));
+}
