diff --git a/crates/slot/tests/segacd_saves.rs b/crates/slot/tests/segacd_saves.rs
new file mode 100644
index 0000000..818dc2d
--- /dev/null
+++ b/crates/slot/tests/segacd_saves.rs
@@ -0,0 +1,343 @@
+// Sega CD backup RAM (ADR 0104). Genesis Plus GX keeps the 8 KB internal backup RAM itself: it reads
+// <save dir>/<stem>.brm at load and writes it, truncating, only at unload, and a state does not carry
+// it. slot hands the core Saves/SEGACD/.core as its save dir, stages the published
+// Saves/SEGACD/<stem>.brm there before load, publishes what the core wrote with a temp, fsync and
+// rename, and flushes a running game by serialize, reload and unserialize (the NGP design, ADR 0094).
+// The dummy BIOS never runs a game, but the core formats a fresh backup RAM and writes it on the first
+// unload, which is the write these tests follow.
+mod common;
+mod core_common;
+mod real_seat;
+mod segacd_common;
+
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use segacd_common::{
+    assert_formatted_bram, dummy_bios, genesis_plus_gx, iso_disc, put_bios, BRAM_LEN, US,
+};
+use slot::app::Phase;
+use slot::core::{apply_core_options, dylib_name};
+use slot::ngp_flash::{core_save_dir, publish_for, refused, save_path, stage, staged, valid_for};
+use slot::session::Session;
+use slot_input::Action;
+use slot_retro::{ButtonMask, LibretroCore, RetroCore};
+use slot_store::{Core, Platform};
+use tempfile::TempDir;
+
+const STEM: &str = "Lunar - The Silver Star (USA)";
+const P: Platform = Platform::SegaCd;
+
+fn bram(mark: u8) -> Vec<u8> {
+    let mut b = vec![0u8; BRAM_LEN];
+    b[0] = mark;
+    b[BRAM_LEN - 0x40..BRAM_LEN - 0x35].copy_from_slice(b"___________");
+    b[BRAM_LEN - 0x20..].copy_from_slice(b"SEGA_CD_ROM\x00\x01\x00\x00\x00RAM_CARTRIDGE___");
+    b
+}
+
+fn card() -> Option<TempDir> {
+    let dylib = genesis_plus_gx()?;
+    let root = common::tmp_root_with_real_carts(&[]);
+    iso_disc(&root.path().join("Games/SEGACD"), STEM, US);
+    iso_disc(&root.path().join("Games/SEGACD"), "Zzz", US);
+    put_bios(root.path(), "bios_CD_U.bin", &dummy_bios());
+    std::os::unix::fs::symlink(
+        std::fs::canonicalize(dylib).expect("core path"),
+        root.path()
+            .join("System")
+            .join(dylib_name(Core::GenesisPlusGx)),
+    )
+    .expect("link core");
+    common::clocked(root.path());
+    Some(root)
+}
+
+fn seated() -> Option<(TempDir, Session)> {
+    let root = card()?;
+    let session = real_seat::play(root.path(), true);
+    Some((root, session))
+}
+
+fn wait_for(session: &mut Session, what: &str, done: impl Fn(&Session) -> bool) {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    while !done(session) {
+        assert!(Instant::now() < deadline, "{what}");
+        session.update(1.0 / 60.0);
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+fn still_playing(session: &mut Session) {
+    let before = session.frames_published();
+    wait_for(session, "the game stopped after the flush", |s| {
+        s.frames_published() > before + 5
+    });
+}
+
+#[test]
+fn sega_cd_and_the_neo_geo_pocket_are_the_only_cores_with_a_staging_save_dir() {
+    let root = Path::new("/card");
+    assert_eq!(core_save_dir(root, P), root.join("Saves/SEGACD/.core"));
+    assert_eq!(core_save_dir(root, Platform::Md), root.join("Saves"));
+    assert_eq!(
+        save_path(root, P, STEM),
+        root.join(format!("Saves/SEGACD/{STEM}.brm"))
+    );
+    assert_eq!(
+        refused(root, P, STEM),
+        root.join(format!("Saves/SEGACD/{STEM}.brm-refused"))
+    );
+}
+
+#[test]
+fn a_backup_ram_file_is_good_only_at_8_kb_with_the_format_footer() {
+    assert!(valid_for(P, &bram(7)));
+    assert!(!valid_for(P, &bram(7)[..BRAM_LEN - 1]), "short");
+    assert!(!valid_for(P, &[bram(7), vec![0]].concat()), "long");
+    assert!(!valid_for(P, &[]), "empty");
+    let mut wrong = bram(7);
+    wrong[BRAM_LEN - 1] = b'X';
+    assert!(!valid_for(P, &wrong), "a damaged footer");
+    assert!(
+        !valid_for(Platform::Ngp, &bram(7)),
+        "the NGP check is its own"
+    );
+}
+
+#[test]
+fn a_good_file_is_staged_and_a_torn_one_is_moved_aside() {
+    let root = tempfile::tempdir().expect("tempdir");
+    let rom = root.path().join(format!("Games/SEGACD/{STEM}.chd"));
+    std::fs::create_dir_all(save_path(root.path(), P, STEM).parent().expect("dir")).expect("dir");
+    std::fs::write(save_path(root.path(), P, STEM), bram(3)).expect("write");
+    stage(root.path(), P, &rom);
+    assert_eq!(
+        std::fs::read(staged(root.path(), P, STEM)).ok(),
+        Some(bram(3))
+    );
+    let torn = bram(4)[..100].to_vec();
+    std::fs::write(save_path(root.path(), P, STEM), &torn).expect("write");
+    stage(root.path(), P, &rom);
+    assert!(!save_path(root.path(), P, STEM).exists());
+    assert!(!staged(root.path(), P, STEM).exists());
+    assert_eq!(
+        std::fs::read(refused(root.path(), P, STEM)).ok(),
+        Some(torn)
+    );
+}
+
+#[test]
+fn a_torn_staged_file_is_never_published_over_a_good_one() {
+    let root = tempfile::tempdir().expect("tempdir");
+    std::fs::create_dir_all(staged(root.path(), P, STEM).parent().expect("dir")).expect("dir");
+    std::fs::write(save_path(root.path(), P, STEM), bram(5)).expect("write");
+    std::fs::write(staged(root.path(), P, STEM), &bram(6)[..4000]).expect("write");
+    assert!(!publish_for(root.path(), P, STEM).expect("publish"));
+    assert_eq!(
+        std::fs::read(save_path(root.path(), P, STEM)).ok(),
+        Some(bram(5))
+    );
+    std::fs::write(staged(root.path(), P, STEM), bram(6)).expect("write");
+    assert!(publish_for(root.path(), P, STEM).expect("publish"));
+    assert_eq!(
+        std::fs::read(save_path(root.path(), P, STEM)).ok(),
+        Some(bram(6))
+    );
+}
+
+#[test]
+fn a_lid_close_mid_game_puts_the_backup_ram_in_saves_segacd() {
+    let _g = core_lock();
+    let Some((root, mut session)) = seated() else {
+        return;
+    };
+    let path = save_path(root.path(), P, STEM);
+    assert!(!path.exists());
+    session.app_mut().apply(Action::LidClose);
+    assert_formatted_bram(&path);
+    assert!(!root.path().join("Saves/scd_U.brm").exists());
+    session.app_mut().apply(Action::LidOpen);
+    still_playing(&mut session);
+}
+
+#[test]
+fn the_autosave_puts_the_backup_ram_in_saves_segacd_and_the_game_carries_on() {
+    let _g = core_lock();
+    let Some((root, mut session)) = seated() else {
+        return;
+    };
+    let now = session.app().now();
+    session.app_mut().tick_ms(now + 61_000);
+    session.app_mut().settle_saves();
+    assert_formatted_bram(&save_path(root.path(), P, STEM));
+    still_playing(&mut session);
+}
+
+#[test]
+fn an_eject_publishes_the_backup_ram_atomically() {
+    let _g = core_lock();
+    let Some((root, mut session)) = seated() else {
+        return;
+    };
+    let path = save_path(root.path(), P, STEM);
+    let stop = Arc::new(AtomicBool::new(false));
+    let watcher = {
+        let (path, stop) = (path.clone(), stop.clone());
+        std::thread::spawn(move || {
+            let mut seen = Vec::new();
+            while !stop.load(Ordering::Relaxed) {
+                if let Ok(bytes) = std::fs::read(&path) {
+                    if !valid_for(P, &bytes) {
+                        seen.push(bytes.len());
+                    }
+                }
+            }
+            seen
+        })
+    };
+    session.app_mut().apply(Action::Eject);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "{:?}",
+        session.app().phase()
+    );
+    wait_for(&mut session, "the core never stopped", |s| {
+        s.emu().is_none()
+    });
+    stop.store(true, Ordering::Relaxed);
+    assert_eq!(watcher.join().expect("watcher"), Vec::<usize>::new());
+    assert_formatted_bram(&path);
+}
