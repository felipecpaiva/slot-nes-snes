@@ -0,0 +1,86 @@
+use std::time::{Duration, Instant};
+
+pub struct ReleasedPace {
+    next: Instant,
+    span: Duration,
+}
+
+impl ReleasedPace {
+    pub fn new(span: Duration, now: Instant) -> Self {
+        ReleasedPace { next: now, span }
+    }
+
+    pub fn restart(&mut self, now: Instant) {
+        self.next = now;
+    }
+
+    pub fn wait(&mut self, now: Instant) -> Duration {
+        let due = self.next + self.span;
+        match due > now {
+            true => {
+                self.next = due;
+                due - now
+            }
+            false => {
+                self.next = now;
+                Duration::ZERO
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const RATE: f64 = 32_768.0;
+    const FRAMES: usize = 512;
+    const ITERATIONS: usize = 2_000;
+
+    fn span() -> Duration {
+        Duration::from_secs_f64(FRAMES as f64 / RATE)
+    }
+
+    fn consumed_over(
+        overhead: Duration,
+        wait: impl Fn(&mut ReleasedPace, Instant) -> Duration,
+    ) -> f64 {
+        let start = Instant::now();
+        let mut now = start;
+        let mut pace = ReleasedPace::new(span(), now);
+        for _ in 0..ITERATIONS {
+            now += wait(&mut pace, now);
+            now += overhead;
+        }
+        let consumed = (ITERATIONS * FRAMES) as f64 / RATE;
+        consumed / (now - start).as_secs_f64()
+    }
+
+    #[test]
+    fn a_released_consumer_drains_at_real_time_rate_despite_per_iteration_overhead() {
+        let rate = consumed_over(Duration::from_micros(300), |pace, now| pace.wait(now));
+        assert!((rate - 1.0).abs() < 0.01, "drained at {rate} of real time");
+    }
+
+    #[test]
+    fn a_relative_sleep_falls_behind_real_time_with_the_same_overhead() {
+        let rate = consumed_over(Duration::from_micros(300), |_, _| span());
+        assert!(rate < 0.99, "drained at {rate} of real time");
+    }
+
+    #[test]
+    fn a_late_wake_resyncs_instead_of_bursting() {
+        let start = Instant::now();
+        let mut pace = ReleasedPace::new(span(), start);
+        assert_eq!(pace.wait(start + span() * 10), Duration::ZERO);
+        assert_eq!(pace.wait(start + span() * 10), span());
+    }
+
+    #[test]
+    fn a_restart_drops_the_deadline_of_the_previous_release() {
+        let start = Instant::now();
+        let mut pace = ReleasedPace::new(span(), start);
+        pace.restart(start + Duration::from_secs(5));
+        assert_eq!(pace.wait(start + Duration::from_secs(5)), span());
+    }
+}
