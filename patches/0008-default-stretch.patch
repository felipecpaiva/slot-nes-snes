@@ -522,7 +522,9 @@ impl Session {
         self.app.set_core(core);
         self.app.set_platform(platform);
         self.app
-            .set_video_mode(crate::video_mode::video_mode_for(&self.root, stem));
+            .set_video_mode(crate::platform_video::video_mode_for(
+                &self.root, stem, platform,
+            ));
         self.app.set_link_loaded(serial);
         let root = self.root.clone();
         let stem = stem.to_owned();
diff --git a/crates/slot/tests/nes_video_mode.rs b/crates/slot/tests/nes_video_mode.rs
new file mode 100644
index 0000000..eadf7be
--- /dev/null
+++ b/crates/slot/tests/nes_video_mode.rs
@@ -0,0 +1,56 @@
+mod common;
+mod input_common;
+
+use input_common::playing;
+use slot::platform_video::video_mode_for;
+use slot::video_mode::{VideoMode, VIDEO_MODE_FILE};
+use slot_store::Platform;
+use tempfile::TempDir;
+
+const STEM: &str = "Zzz";
+
+fn root_with_line(line: Option<&str>) -> TempDir {
+    let d = tempfile::tempdir().expect("tempdir");
+    std::fs::create_dir(d.path().join("Config")).expect("config dir");
+    if let Some(line) = line {
+        std::fs::write(d.path().join(VIDEO_MODE_FILE), format!("{STEM}={line}\n"))
+            .expect("write video_mode.txt");
+    }
+    d
+}
+
+fn mode(line: Option<&str>, platform: Platform) -> VideoMode {
+    let d = root_with_line(line);
+    video_mode_for(d.path(), STEM, platform)
+}
+
+#[test]
+fn nes_and_snes_with_no_saved_line_read_stretch() {
+    assert_eq!(mode(None, Platform::Nes), VideoMode::Stretch);
+    assert_eq!(mode(None, Platform::Snes), VideoMode::Stretch);
+}
+
+#[test]
+fn a_saved_actual_line_wins_on_nes_and_snes() {
+    assert_eq!(mode(Some("actual"), Platform::Nes), VideoMode::Actual);
+    assert_eq!(mode(Some("actual"), Platform::Snes), VideoMode::Actual);
+}
+
+#[test]
+fn gba_gb_and_gbc_with_no_saved_line_read_actual() {
+    assert_eq!(mode(None, Platform::Gba), VideoMode::Actual);
+    assert_eq!(mode(None, Platform::Gb), VideoMode::Actual);
+    assert_eq!(mode(None, Platform::Gbc), VideoMode::Actual);
+}
+
+#[test]
+fn an_unparseable_line_on_nes_falls_back_to_stretch() {
+    assert_eq!(mode(Some("wide"), Platform::Nes), VideoMode::Stretch);
+}
+
+#[test]
+fn a_never_played_nes_cart_seats_in_stretch_and_writes_nothing() {
+    let (root, session) = playing(Platform::Nes, STEM);
+    assert_ne!(session.app().source_rect(), slot_gfx::WHOLE_TEXTURE);
+    assert!(!root.path().join(VIDEO_MODE_FILE).exists());
+}
