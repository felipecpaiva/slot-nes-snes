+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 148">
+  <path d="M 6.50 9.00 A 9.00 9.00 0 0 1 15.50 0.00 L 224.50 0.00 A 9.00 9.00 0 0 1 233.50 9.00 L 233.50 145.00 A 3.00 3.00 0 0 1 230.50 148.00 L 9.50 148.00 A 3.00 3.00 0 0 1 6.50 145.00 Z" fill="#fff"/>
+</svg>
