new file mode 100644
index 0000000..33bf7ae
--- /dev/null
+++ b/crates/slot-store/tests/nes_platform.rs
@@ -0,0 +1,38 @@
+use std::path::Path;
+
+use slot_store::Platform;
+
+#[test]
+fn the_shelves_are_the_three_game_boy_platforms_then_nes() {
+    assert_eq!(
+        Platform::SHELVES,
+        [
+            Platform::Gba,
+            Platform::Gbav,
+            Platform::Gb,
+            Platform::Gbc,
+            Platform::Nes
+        ]
+    );
+}
+
+#[test]
+fn the_pinned_platform_list_still_has_three_entries() {
+    assert_eq!(
+        Platform::ALL,
+        [Platform::Gba, Platform::Gbav, Platform::Gbc, Platform::Gb]
+    );
+}
+
+#[test]
+fn nes_accepts_nes_files_and_refuses_gba_files() {
+    assert!(Platform::Nes.accepts(Path::new("x.nes")));
+    assert!(Platform::Nes.accepts(Path::new("X.NES")));
+    assert!(!Platform::Nes.accepts(Path::new("x.gba")));
+}
+
+#[test]
+fn nes_has_its_own_folder_name_and_picture() {
+    assert_eq!(Platform::Nes.dir_name(), "NES");
+    assert_eq!(Platform::Nes.picture(), (256, 240));
+}
diff --git a/crates/slot-store/tests/nes_scan.rs b/crates/slot-store/tests/nes_scan.rs
new file mode 100644
index 0000000..1ee940a
--- /dev/null
+++ b/crates/slot-store/tests/nes_scan.rs
@@ -0,0 +1,20 @@
+use slot_store::{scan, Platform};
+
+#[test]
+fn a_nes_cart_lands_on_the_nes_shelf_with_its_stem_as_the_name() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let dir = d.path().join("Games/NES");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let mut rom = vec![0u8; 0x150];
+    rom[0x134..0x13c].copy_from_slice(b"TETRIS\0\0");
+    std::fs::write(dir.join("Super Mario Bros. 3 (USA).nes"), rom).expect("write rom");
+
+    let mut carts = scan(d.path()).expect("scan");
+    assert_eq!(carts.len(), 1);
+    let cart = &mut carts[0];
+    assert_eq!(cart.platform, Platform::Nes);
+    assert_eq!(cart.stem, "Super Mario Bros. 3 (USA)");
+    cart.read_header();
+    assert!(cart.title.is_empty());
+    assert!(cart.code.is_empty());
+}
diff --git a/crates/slot-store/tests/nes_state.rs b/crates/slot-store/tests/nes_state.rs
new file mode 100644
index 0000000..d120810
--- /dev/null
+++ b/crates/slot-store/tests/nes_state.rs
@@ -0,0 +1,21 @@
+mod common;
+
+use common::tmp_root;
+use slot_store::{read_slot_state, write_slot_state, Platform, SlotState};
+
+#[test]
+fn a_nes_cart_with_a_sentence_name_resumes_as_a_nes_cart() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Super Mario Bros. 3 (USA)".into()),
+        cart_platform: Some(Platform::Nes),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).unwrap();
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).unwrap();
+    assert!(text.lines().any(|l| l == "cart_platform=nes"), "{text:?}");
+    let back = read_slot_state(d.path());
+    assert_eq!(back.cart_platform, Some(Platform::Nes));
+    assert_eq!(back, s);
+}
