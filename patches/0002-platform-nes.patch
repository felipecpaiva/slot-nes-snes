+++ b/crates/slot/tests/nes_dist.rs
@@ -0,0 +1,42 @@
+use std::process::Command;
+
+const UPSTREAM_DIRS: [&str; 20] = [
+    "BIOS",
+    "Config",
+    "Games",
+    "Games/GBA",
+    "Games/GB",
+    "Games/GBC",
+    "Labels",
+    "Labels/GBA",
+    "Labels/GB",
+    "Labels/GBC",
+    "Saves",
+    "Saves/GBA",
+    "Saves/GB",
+    "Saves/GBC",
+    "States",
+    "States/GBA",
+    "States/GB",
+    "States/GBC",
+    "System",
+    "Wallpapers",
+];
+
+#[test]
+fn init_root_creates_the_nes_folders_and_every_upstream_folder() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let root = d.path().join("dist");
+    let status = Command::new(env!("CARGO_BIN_EXE_slot"))
+        .arg("--init-root")
+        .arg(&root)
+        .status()
+        .expect("run slot");
+    assert!(status.success());
+    for name in UPSTREAM_DIRS
+        .iter()
+        .chain(&["Games/NES", "Labels/NES", "Saves/NES", "States/NES"])
+    {
+        assert!(root.join(name).is_dir(), "{name} was not created");
+    }
+}
