+use slot_store::{GbPalette, Platform};
+
+fn rom_with_clear_colour_flag() -> (tempfile::TempDir, std::path::PathBuf) {
+    let d = tempfile::tempdir().expect("tempdir");
+    let rom = d.path().join("x.nes");
+    std::fs::write(&rom, vec![0u8; 0x8000]).expect("write rom");
+    (d, rom)
+}
+
+#[test]
+fn a_nes_game_never_takes_a_game_boy_palette() {
+    let (_d, rom) = rom_with_clear_colour_flag();
+    let p = GbPalette::DEFAULT;
+    assert_eq!(
+        slot::core::palette_for(Some(p), Platform::Nes, &rom, None),
+        None
+    );
+}
+
+#[test]
+fn the_same_bytes_as_a_game_boy_game_do_take_the_palette() {
+    let (_d, rom) = rom_with_clear_colour_flag();
+    let p = GbPalette::DEFAULT;
+    assert_eq!(
+        slot::core::palette_for(Some(p), Platform::Gb, &rom, None),
+        Some(p)
+    );
+}
