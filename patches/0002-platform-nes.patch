+#[test]
+fn a_nes_game_never_takes_a_game_boy_palette() {
+    let (_d, rom) = rom_with_clear_colour_flag();
+    let p = GbColors::Palette(GbPalette::DEFAULT);
+    assert_eq!(slot::core::palette_for(p, Platform::Nes, &rom, None), None);
+}
+
+#[test]
+fn the_same_bytes_as_a_game_boy_game_do_take_the_palette() {
+    let (_d, rom) = rom_with_clear_colour_flag();
+    let p = GbColors::Palette(GbPalette::DEFAULT);
+    assert_eq!(
+        slot::core::palette_for(p, Platform::Gb, &rom, None),
+        Some(p)
+    );
+}
