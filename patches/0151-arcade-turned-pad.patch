 }
 
+pub fn turns(code: u8) -> bool {
+    matches!(code, HORIZONTAL | VERTICAL)
+}
+
+pub fn starting_layout(code: u8) -> Layout {
+    match code {
+        VERTICAL => Layout::Upright,
+        _ => Layout::Horizontal,
