-        }
-        if code == SIDEWAYS {
-            return Layout::Sideways.remap(mask);
+        if !turns(code) {
+            return pass(code, self.layout, mask);
         }
         let select = mask.0 & M::SELECT != 0;
         let others = mask.0 & !M::SELECT != 0;
@@ -174,6 +192,6 @@ impl WsPad {
             (true, false) | (false, false) => {}
         }
         self.select = select;
-        self.layout.remap(mask)
+        pass(code, self.layout, mask)
