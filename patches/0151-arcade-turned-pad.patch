diff --git a/crates/slot/tests/arcade_turned_pad.rs b/crates/slot/tests/arcade_turned_pad.rs
new file mode 100644
index 0000000..7d1e00b
--- /dev/null
+++ b/crates/slot/tests/arcade_turned_pad.rs
@@ -0,0 +1,30 @@
+// A vertical CPS game turned sideways (CPS Vertical Games: Turned) keeps every button and has its
+// D-pad turned. Its pad code used to be the Virtual Boy's stick code, so the Virtual Boy filter took
+// X, Y, L2 and R2 away and left the D-pad as it was (ADR 0108).
+use slot::vb_input;
+use slot::ws_input::{pass, starting_layout, SIDEWAYS};
+use slot_retro::ButtonMask as M;
+
+fn turned(mask: u16) -> u16 {
+    pass(SIDEWAYS, starting_layout(SIDEWAYS), M(mask)).0
+}
+
+#[test]
+fn the_sideways_code_is_not_a_virtual_boy_code() {
+    assert!(!vb_input::owns(SIDEWAYS));
+}
+
+#[test]
+fn a_turned_game_keeps_x_y_l2_and_r2() {
+    for bit in [M::X, M::Y, M::L2, M::R2, M::A, M::B, M::L, M::R] {
+        assert_eq!(turned(bit), bit, "{bit:#06x}");
+    }
+}
+
+#[test]
+fn a_turned_game_has_its_d_pad_turned() {
+    assert_eq!(turned(M::UP), M::LEFT);
+    assert_eq!(turned(M::RIGHT), M::UP);
+    assert_eq!(turned(M::DOWN), M::RIGHT);
+    assert_eq!(turned(M::LEFT), M::DOWN);
+}
