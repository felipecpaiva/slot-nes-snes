diff --git a/crates/slot-store/tests/tg16_platform.rs b/crates/slot-store/tests/tg16_platform.rs
new file mode 100644
index 0000000..a4666fa
--- /dev/null
+++ b/crates/slot-store/tests/tg16_platform.rs
@@ -0,0 +1,180 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Core,
+    GameButton, Platform, RetroShader, SegaShaders, Shader, SlotState, TG16_SHADER_FILE,
+};
+
+#[test]
+fn turbografx_is_the_last_shelf_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES.last(), Some(&Platform::Tg16));
+    assert_eq!(Platform::SHELVES.len(), 10);
+    assert_eq!(Platform::ALL.len(), 3);
+}
+
+#[test]
+fn turbografx_has_its_own_name_folder_and_256_by_240_picture() {
+    assert_eq!(Platform::Tg16.name(), "NEC TurboGrafx-16");
+    assert_eq!(Platform::Tg16.dir_name(), "TG16");
+    assert_eq!(Platform::Tg16.picture(), (256, 240));
+}
+
+#[test]
+fn only_a_hucard_file_is_a_turbografx_game() {
+    for name in ["x.pce", "X.PCE"] {
+        assert!(Platform::Tg16.accepts(Path::new(name)), "{name}");
+    }
+    for name in [
+        "x.sgx", "x.cue", "x.ccd", "x.chd", "x.toc", "x.m3u", "x.bin",
+    ] {
+        assert!(!Platform::Tg16.accepts(Path::new(name)), "{name}");
+    }
+}
+
+#[test]
+fn a_pce_file_lands_on_the_tg16_shelf_titled_by_its_stem_and_cd_images_do_not() {
+    let d = tmp_root();
+    let dir = d.path().join("Games/TG16");
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("Bonk's Adventure (USA).pce"), [0u8; 0x2000]).unwrap();
+    std::fs::write(dir.join("Madou Monogatari (Japan).sgx"), [0u8; 16]).unwrap();
+    std::fs::write(dir.join("Ys Book I & II (USA).cue"), b"FILE x.bin BINARY").unwrap();
+    let carts = scan(d.path()).unwrap();
+    let tg16: Vec<_> = carts
+        .iter()
+        .filter(|c| c.platform == Platform::Tg16)
+        .collect();
+    assert_eq!(tg16.len(), 1, "{carts:?}");
+    assert_eq!(tg16[0].stem, "Bonk's Adventure (USA)");
+    assert_eq!(tg16[0].title, "");
+}
+
+#[test]
+fn a_hucard_with_a_512_byte_copier_header_is_scanned_like_any_other() {
+    let d = tmp_root();
+    let dir = d.path().join("Games/TG16");
+    std::fs::create_dir_all(&dir).unwrap();
+    std::fs::write(dir.join("R-Type (USA).pce"), [0u8; 0x2000 + 512]).unwrap();
+    let carts = scan(d.path()).unwrap();
+    assert!(carts
+        .iter()
+        .any(|c| c.platform == Platform::Tg16 && c.stem == "R-Type (USA)"));
+}
+
+#[test]
+fn turbografx_runs_on_beetle_pce_fast_alone_on_the_360_by_240_canvas() {
+    assert_eq!(Core::default_for(Platform::Tg16), Core::MednafenPceFast);
+    assert_eq!(Core::EVERY.last(), Some(&Core::MednafenPceFast));
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Tg16),
+            core == Core::MednafenPceFast,
+            "{core:?}"
+        );
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::MednafenPceFast.runs(platform),
+            platform == Platform::Tg16,
+            "{platform:?}"
+        );
+    }
+    assert_eq!(Core::MednafenPceFast.canvas(Platform::Tg16), (360, 240));
+    assert_eq!(Platform::Tg16.picker_cores(), None);
+    assert_eq!(
+        Core::MednafenPceFast.pair(),
+        (Core::MednafenPceFast, Core::MednafenPceFast)
+    );
+}
+
+#[test]
+fn beetle_pce_fast_goes_by_its_library_name_and_option_prefix() {
+    assert_eq!(Core::MednafenPceFast.as_str(), "mednafen_pce_fast");
+    assert_eq!(
+        Core::parse("mednafen_pce_fast"),
+        Some(Core::MednafenPceFast)
+    );
+    assert_eq!(Core::MednafenPceFast.option_prefix(), "pce_fast");
+    assert_eq!(Core::MednafenPceFast.text(), "Beetle PCE Fast");
+    assert!(!Core::MednafenPceFast.has_colour_correction());
+}
+
+#[test]
+fn the_turbografx_pad_keeps_x_y_shoulders_and_triggers_for_slot() {
+    assert!(!Platform::Tg16.passes_xy_through());
+    assert!(Platform::Tg16.owns_shoulders());
+    assert!(Platform::Tg16.owns_triggers());
+    assert!(!Platform::Tg16.select_x_toggles_picture());
+    assert!(!Platform::Tg16.has_gb_palettes());
+    assert_eq!(GameButton::of(Platform::Tg16), &GameButton::ALL[..8]);
+}
+
+#[test]
+fn turbografx_crops_eight_lines_top_and_bottom_and_follows_the_frame_width() {
+    assert_eq!(Platform::Tg16.overscan(), (0, 8));
+    assert!(Platform::Tg16.stretch_crops_height());
+    assert!(Platform::Tg16.follows_frame_width());
+    assert!(!Platform::Tg16.fills_canvas());
+    assert!(Platform::Tg16.rewinds());
+    assert!(!Platform::Tg16.swaps_discs());
+    assert_eq!(Platform::Tg16.shader_choices(), &Shader::RETRO);
+}
+
+#[test]
+fn a_turbografx_game_resumes_as_a_turbografx_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Neutopia (USA)".into()),
+        cart_platform: Some(Platform::Tg16),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=tg16"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn pce_still_names_no_platform_so_the_durability_test_keeps_its_meaning() {
+    let d = tmp_root();
+    std::fs::create_dir_all(d.path().join("Config")).unwrap();
+    std::fs::write(
+        d.path().join("Config/slot.state"),
+        "cart=Bonk\ncart_platform=pce\n",
+    )
+    .unwrap();
+    assert_eq!(read_slot_state(d.path()).cart_platform, None);
+}
+
+#[test]
+fn the_turbografx_shader_lives_in_its_own_file_and_leaves_the_others_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        tg16: Shader::Retro(RetroShader::CrtPi),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(TG16_SHADER_FILE)).expect("read"),
+        "tg16=crt-pi\n"
+    );
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    assert!(!d.path().join("Config/ps1_shader.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+}
+
+#[test]
+fn an_unknown_turbografx_shader_reads_as_off() {
+    let d = tmp_root();
+    std::fs::create_dir_all(d.path().join("Config")).unwrap();
+    std::fs::write(
+        d.path().join("Config").join(TG16_SHADER_FILE),
+        "tg16=lcd3x\n",
+    )
+    .unwrap();
+    assert_eq!(read_sega_shaders(d.path()).tg16, Shader::Off);
+}
