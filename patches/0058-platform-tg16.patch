+fn a_booted_card_has_the_turbografx_folders() {
+    let (root, _app) = card_with_a_hucard();
+    for dir in ["Games/TG16", "Saves/TG16", "States/TG16", "Labels/TG16"] {
+        assert!(slot::root::DIRS.contains(&dir), "{dir}");
+        assert!(root.path().join(dir).is_dir(), "{dir}");
