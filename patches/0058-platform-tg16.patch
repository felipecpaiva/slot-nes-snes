+#[test]
+fn the_in_game_shader_row_steps_the_turbografx_shader_into_its_own_file() {
+    let (root, mut session) = input_common::playing(Platform::Tg16, "Bonk");
+    assert_eq!(session.app().screen_shader(), Shader::Off);
+    let mut now = 100;
+    for ev in [
+        RawEvent::Down(Btn::Select),
+        RawEvent::Down(Btn::A),
+        RawEvent::Up(Btn::A),
+        RawEvent::Up(Btn::Select),
+    ] {
+        now += 20;
+        session.feed([ev], now);
+    }
+    session.app().flush_state();
+    assert_eq!(session.app().screen_shader(), Shader::RETRO[1]);
+    assert_eq!(
+        slot_store::read_sega_shaders(root.path()).tg16,
+        Shader::RETRO[1]
+    );
+    assert_eq!(
+        session.app().quick_value(QuickRow::Shader),
+        session.app().quick_value(QuickRow::Tg16Shader)
+    );
+}
