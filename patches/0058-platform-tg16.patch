diff --git a/crates/slot/tests/tg16_screen.rs b/crates/slot/tests/tg16_screen.rs
new file mode 100644
index 0000000..d3fdea1
--- /dev/null
+++ b/crates/slot/tests/tg16_screen.rs
@@ -0,0 +1,188 @@
+mod common;
+mod input_common;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::platform_video::{
+    default_video_mode, picture, picture_choices, shown, system_picture, PICTURE_FILE,
+};
+use slot::video_mode::{source_rect, VideoMode};
+use slot_input::{Action, Btn, RawEvent};
+use slot_store::{Core, Platform, Shader, TG16_SHADER_FILE};
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn card_with_a_hucard() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    std::fs::write(
+        root.path().join("Games/TG16/Bonk's Adventure (USA).pce"),
+        [0u8; 0x2000],
+    )
+    .expect("write hucard");
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_turbografx(app: &mut App) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..QuickRow::ScreenTg16.position(&app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    assert_eq!(app.quick_menu(), Some(QuickRow::ScreenTg16));
+    press(app, Btn::A);
+}
+
+#[test]
+fn turbografx_closes_the_screen_list_and_opens_its_own_section() {
+    assert_eq!(QuickRow::SCREEN.last(), Some(&QuickRow::ScreenTg16));
+    assert_eq!(QuickRow::ScreenTg16.label(), "TurboGrafx-16");
+    assert!(QuickRow::ScreenTg16.opens());
+    assert_eq!(QuickRow::ScreenTg16.child(), Some(QuickRow::Tg16Shader));
+    for row in QuickRow::SCREEN_TG16 {
+        assert_eq!(row.parent(), Some(QuickRow::ScreenTg16));
+        assert_eq!(row.page(), &QuickRow::SCREEN_TG16);
+    }
+}
+
+#[test]
+fn the_turbografx_section_is_shader_and_picture_with_no_pal_speed_row() {
+    assert_eq!(
+        QuickRow::SCREEN_TG16.map(QuickRow::label),
+        ["Shader", "Picture"]
+    );
+}
+
+#[test]
+fn the_turbografx_row_shows_only_on_a_card_with_turbografx_games() {
+    let (_root, mut app) = card_with_a_hucard();
+    assert!(!app.hidden_rows().contains(&QuickRow::ScreenTg16));
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    let app_without = boot(root.path());
+    assert!(app_without.hidden_rows().contains(&QuickRow::ScreenTg16));
+    open_turbografx(&mut app);
+    assert_eq!(app.quick_menu(), Some(QuickRow::Tg16Shader));
+}
+
+#[test]
+fn the_turbografx_shader_walks_the_retro_list_into_its_own_file() {
+    let (root, mut app) = card_with_a_hucard();
+    let state = std::fs::read(root.path().join("Config/slot.state")).ok();
+    open_turbografx(&mut app);
+    assert_eq!(app.quick_value(QuickRow::Tg16Shader), Some(QuickValue::Off));
+    let mut seen = Vec::new();
+    for _ in 0..Shader::RETRO.len() {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        seen.push(slot_store::read_sega_shaders(root.path()).tg16);
+    }
+    assert_eq!(seen, [&Shader::RETRO[1..], &Shader::RETRO[..1]].concat());
+    assert!(root.path().join("Config").join(TG16_SHADER_FILE).exists());
+    assert!(!root.path().join("Config/sega_shaders.txt").exists());
+    assert!(!root.path().join("Config/ps1_shader.txt").exists());
+    assert_eq!(
+        std::fs::read(root.path().join("Config/slot.state")).ok(),
+        state
+    );
+}
+
+#[test]
+fn the_turbografx_picture_starts_at_crop_and_walks_stretch_actual_crop_into_picture_txt() {
+    assert_eq!(default_video_mode(Platform::Tg16), VideoMode::Crop);
+    assert_eq!(
+        picture_choices(Platform::Tg16),
+        [VideoMode::Crop, VideoMode::Stretch, VideoMode::Actual]
+    );
+    let (root, mut app) = card_with_a_hucard();
+    open_turbografx(&mut app);
+    press(&mut app, Btn::Down);
+    assert_eq!(app.quick_menu(), Some(QuickRow::Tg16Picture));
+    assert_eq!(
+        app.quick_value(QuickRow::Tg16Picture),
+        Some(QuickValue::Crop)
+    );
+    for want in [VideoMode::Stretch, VideoMode::Actual, VideoMode::Crop] {
+        press(&mut app, Btn::Right);
+        app.flush_state();
+        assert_eq!(
+            app.quick_value(QuickRow::Tg16Picture),
+            Some(want.quick_value())
+        );
+        assert_eq!(system_picture(root.path(), Platform::Tg16), want);
+    }
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PICTURE_FILE)).expect("picture.txt"),
+        "tg16 = crop\n"
+    );
+}
+
+#[test]
+fn a_picture_txt_with_no_turbografx_line_gives_crop() {
+    let (root, _app) = card_with_a_hucard();
+    std::fs::write(root.path().join(PICTURE_FILE), "nes = actual\n").unwrap();
+    assert_eq!(system_picture(root.path(), Platform::Tg16), VideoMode::Crop);
+}
+
+#[test]
+fn crop_takes_eight_lines_off_the_top_and_bottom_of_a_256_by_240_hucard() {
+    assert_eq!(shown(Platform::Tg16, 256, VideoMode::Crop), (256, 224));
+    let canvas = Core::MednafenPceFast.canvas(Platform::Tg16);
+    assert_eq!(
+        source_rect(Platform::Tg16, (256, 224), canvas, VideoMode::Crop),
+        [52.0 / 360.0, 8.0 / 240.0, 256.0 / 360.0, 224.0 / 240.0]
+    );
+}
+
+#[test]
+fn stretch_follows_a_hucard_that_switches_to_a_wider_dot_clock() {
+    assert_eq!(picture(Platform::Tg16, 352), (352, 240));
+    assert_eq!(picture(Platform::Tg16, 0), (256, 240));
+    let canvas = Core::MednafenPceFast.canvas(Platform::Tg16);
+    assert_eq!(
+        source_rect(Platform::Tg16, (352, 240), canvas, VideoMode::Stretch),
+        [4.0 / 360.0, 0.0, 352.0 / 360.0, 1.0]
+    );
+}
