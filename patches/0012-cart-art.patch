diff --git a/crates/slot-ui/src/lid_fit.rs b/crates/slot-ui/src/lid_fit.rs
new file mode 100644
index 0000000..78a1060
--- /dev/null
+++ b/crates/slot-ui/src/lid_fit.rs
@@ -0,0 +1,36 @@
+use slot_gfx::Canvas;
+
+use crate::board::{lid_rest, Placed};
+use crate::cart::{cart_box, CART_H, CART_W};
+use crate::shelf::{foot_y, Shelf};
+
+const SAME_SHAPE: f32 = 0.001;
+
+pub fn shelf_cart_of(shelf: &Shelf, x: f32, scale: f32) -> Placed {
+    let (cw, ch) = shelf
+        .carts
+        .get(shelf.index)
+        .map_or((CART_W, CART_H), |c| cart_box(c.platform));
+    let (w, h) = (cw as f32 * scale, ch as f32 * scale);
+    Placed {
+        x,
+        y: foot_y(ch as f32) - h,
+        w,
+        h,
+    }
+}
+
+pub fn lid_rest_for(canvas: Canvas, shelf: Placed) -> Placed {
+    let rest = lid_rest(canvas);
+    let (own, want) = (shelf.w / shelf.h, CART_W as f32 / CART_H as f32);
+    if (own - want).abs() < SAME_SHAPE {
+        return rest;
+    }
+    let (w, h) = (rest.w.min(rest.h * own), rest.h.min(rest.w / own));
+    Placed {
+        x: rest.x + (rest.w - w) / 2.0,
+        y: rest.y + (rest.h - h) / 2.0,
+        w,
+        h,
+    }
+}
diff --git a/crates/slot-ui/src/retro_cart.rs b/crates/slot-ui/src/retro_cart.rs
new file mode 100644
index 0000000..fc243ec
--- /dev/null
+++ b/crates/slot-ui/src/retro_cart.rs
@@ -0,0 +1,182 @@
+use std::sync::OnceLock;
+
+use slot_store::{Cart, Platform};
+
+use crate::retro_mould::{depth_map, emboss, rasterise_detail, rasterise_svg, Detail};
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum NesShell {
+    Nes,
+    Famicom,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum SnesShell {
+    Snes,
+    Sfc,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub enum RetroShell {
+    Nes(NesShell),
+    Snes(SnesShell),
+}
+
+impl RetroShell {
+    pub const ALL: [RetroShell; 4] = [
+        RetroShell::Nes(NesShell::Nes),
+        RetroShell::Nes(NesShell::Famicom),
+        RetroShell::Snes(SnesShell::Snes),
+        RetroShell::Snes(SnesShell::Sfc),
+    ];
+
+    pub fn slot(self) -> usize {
+        match self {
+            RetroShell::Nes(NesShell::Nes) => 0,
+            RetroShell::Nes(NesShell::Famicom) => 1,
+            RetroShell::Snes(SnesShell::Snes) => 2,
+            RetroShell::Snes(SnesShell::Sfc) => 3,
+        }
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            RetroShell::Nes(NesShell::Nes) => "nes",
+            RetroShell::Nes(NesShell::Famicom) => "famicom",
+            RetroShell::Snes(SnesShell::Snes) => "snes",
+            RetroShell::Snes(SnesShell::Sfc) => "sfc",
+        }
+    }
+}
+
+pub fn retro_shell_of(cart: &Cart) -> Option<RetroShell> {
+    match cart.platform {
+        Platform::Nes => Some(RetroShell::Nes(NesShell::Nes)),
+        Platform::Snes => Some(RetroShell::Snes(SnesShell::Snes)),
+        Platform::Gba | Platform::Gb | Platform::Gbc => None,
+    }
+}
+
+pub const NES_SEATED_H: u32 = 252;
+pub const SNES_SEATED_H: u32 = 150;
+const NES_CART_W: u32 = 312;
+const SNES_CART_W: u32 = 360;
+
+pub(crate) struct Look {
+    pub w: u32,
+    pub h: u32,
+    pub label: (u32, u32, u32, u32),
+    pub portrait: bool,
+    pub rim: u32,
+    pub bevel: u32,
+    pub board: ((f32, f32), f32, (f32, f32), f32, f32),
+}
+
+fn panel(w: u32, h: u32, permille: [u32; 4]) -> (u32, u32, u32, u32) {
+    let at = |v: u32, of: u32| (of * v + 500) / 1000;
+    let (x0, y0) = (at(permille[0], w), at(permille[1], h));
+    (x0, y0, at(permille[2], w) - x0, at(permille[3], h) - y0)
+}
+
+const fn cart_h(w: u32, seated_h: u32) -> u32 {
+    (w * seated_h + crate::cart::SEATED_W / 2) / crate::cart::SEATED_W
+}
+
+pub(crate) fn retro_box(kind: RetroShell) -> (u32, u32) {
+    let l = look(kind);
+    (l.w, l.h)
+}
+
+pub(crate) fn look(kind: RetroShell) -> Look {
+    let (w, h) = match kind {
+        RetroShell::Nes(_) => (NES_CART_W, cart_h(NES_CART_W, NES_SEATED_H)),
+        RetroShell::Snes(_) => (SNES_CART_W, cart_h(SNES_CART_W, SNES_SEATED_H)),
+    };
+    let label = match kind {
+        RetroShell::Nes(NesShell::Nes) => [410, 20, 850, 668],
+        RetroShell::Nes(NesShell::Famicom) => [84, 521, 916, 839],
+        RetroShell::Snes(_) => [138, 30, 872, 420],
+    };
+    let board = match kind {
+        RetroShell::Nes(NesShell::Nes) => ((0.11, 0.89), 0.02, (0.13, 0.87), 0.93, 0.86),
+        RetroShell::Nes(NesShell::Famicom) => ((0.09, 0.91), 0.52, (0.12, 0.88), 0.93, 0.86),
+        RetroShell::Snes(SnesShell::Snes) => ((0.1, 0.9), 0.03, (0.14, 0.86), 0.9, 0.82),
+        RetroShell::Snes(SnesShell::Sfc) => ((0.1, 0.9), 0.03, (0.14, 0.86), 0.9, 0.82),
+    };
+    Look {
+        w,
+        h,
+        label: panel(w, h, label),
+        portrait: matches!(kind, RetroShell::Nes(_)),
+        rim: match kind {
+            RetroShell::Nes(_) => (6 * w + crate::cart::SEATED_W / 2) / crate::cart::SEATED_W,
+            RetroShell::Snes(_) => (4 * w + crate::cart::SEATED_W / 2) / crate::cart::SEATED_W,
+        },
+        bevel: match kind {
+            RetroShell::Nes(_) => 2,
+            RetroShell::Snes(_) => 3,
+        },
+        board,
+    }
+}
+
+fn svg_of(kind: RetroShell) -> &'static str {
+    match kind {
+        RetroShell::Nes(NesShell::Nes) => include_str!("../assets/nes_cart.svg"),
+        RetroShell::Nes(NesShell::Famicom) => include_str!("../assets/famicom_cart.svg"),
+        RetroShell::Snes(SnesShell::Snes) => include_str!("../assets/snes_cart.svg"),
+        RetroShell::Snes(SnesShell::Sfc) => include_str!("../assets/sfc_cart.svg"),
+    }
+}
+
+fn detail_svg_of(kind: RetroShell) -> &'static str {
+    match kind {
+        RetroShell::Nes(NesShell::Nes) => include_str!("../assets/nes_cart_detail.svg"),
+        RetroShell::Nes(NesShell::Famicom) => include_str!("../assets/famicom_cart_detail.svg"),
+        RetroShell::Snes(SnesShell::Snes) => include_str!("../assets/snes_cart_detail.svg"),
+        RetroShell::Snes(SnesShell::Sfc) => include_str!("../assets/sfc_cart_detail.svg"),
+    }
+}
+
+fn lettering_of(kind: RetroShell) -> &'static [u8] {
+    match kind {
+        RetroShell::Nes(_) => include_bytes!("../assets/lettering_nes.png"),
+        RetroShell::Snes(_) => include_bytes!("../assets/lettering_snes.png"),
+    }
+}
+
+pub fn retro_silhouette(kind: RetroShell, w: u32, h: u32) -> Vec<u8> {
+    rasterise_svg(svg_of(kind), w, h).unwrap_or_else(|| {
+        eprintln!("slot: cart art: {} outline did not rasterise", kind.name());
+        vec![255; (w * h) as usize]
+    })
+}
+
+pub(crate) fn retro_mask(kind: RetroShell) -> &'static [u8] {
+    static MASKS: [OnceLock<Vec<u8>>; 4] = [const { OnceLock::new() }; 4];
+    MASKS[kind.slot()].get_or_init(|| {
+        let l = look(kind);
+        retro_silhouette(kind, l.w, l.h)
+    })
+}
+
+pub(crate) fn retro_depth(kind: RetroShell) -> &'static [u8] {
+    static DEPTHS: [OnceLock<Vec<u8>>; 4] = [const { OnceLock::new() }; 4];
+    DEPTHS[kind.slot()].get_or_init(|| {
+        let l = look(kind);
+        depth_map(retro_mask(kind), l.w as usize, l.h as usize)
+    })
+}
+
+pub(crate) fn retro_detail(kind: RetroShell) -> &'static Detail {
+    static DETAILS: [OnceLock<Detail>; 4] = [const { OnceLock::new() }; 4];
+    DETAILS[kind.slot()].get_or_init(|| {
+        let l = look(kind);
+        let mut detail = rasterise_detail(detail_svg_of(kind), l.w, l.h).unwrap_or_else(|| {
+            eprintln!("slot: cart art: {} detail did not rasterise", kind.name());
+            Detail::blank(l.w, l.h)
+        });
+        emboss(&mut detail, lettering_of(kind), l.w, l.h);
+        detail
+    })
+}
diff --git a/crates/slot-ui/src/retro_face.rs b/crates/slot-ui/src/retro_face.rs
new file mode 100644
index 0000000..4d93924
--- /dev/null
+++ b/crates/slot-ui/src/retro_face.rs
@@ -0,0 +1,304 @@
+use slot_store::Cart;
+
+use crate::art;
+use crate::cart::{label_colour, label_text, CartFace, SEATED_W};
+use crate::retro_cart::{look, retro_depth, retro_detail, retro_mask, RetroShell};
+use crate::retro_mould::Detail;
+use crate::retro_shell::plastic_in;
+use crate::shell::{shell_for, Finish, Shell};
+use crate::text;
+
+const PAD: u32 = 10;
+const MAX_LINES: usize = 3;
+const MIN_PX: f32 = 10.0;
+const SURFACE: u32 = 150;
+const BOARD: [u8; 3] = [0x2c, 0x96, 0x52];
+const TRACE: [u8; 3] = [0x5a, 0xb4, 0x74];
+const GOLD: [u8; 3] = [0xe6, 0xb4, 0x46];
+
+struct Spec {
+    w: u32,
+    h: u32,
+    label: (u32, u32, u32, u32),
+    mask: &'static [u8],
+    depth: &'static [u8],
+    detail: &'static Detail,
+    max_px: f32,
+    max_h: f32,
+    rim: u32,
+    bevel: u32,
+    board: ((f32, f32), f32, (f32, f32), f32, f32),
+}
+
+fn spec(kind: RetroShell) -> Spec {
+    let l = look(kind);
+    let lh = l.label.3;
+    Spec {
+        w: l.w,
+        h: l.h,
+        label: l.label,
+        mask: retro_mask(kind),
+        depth: retro_depth(kind),
+        detail: retro_detail(kind),
+        max_px: if l.portrait {
+            (lh - 2 * PAD) as f32 / MAX_LINES as f32
+        } else {
+            lh as f32 / (MAX_LINES as f32 * 1.36)
+        },
+        max_h: if l.portrait {
+            (lh - 2 * PAD) as f32
+        } else {
+            f32::INFINITY
+        },
+        rim: l.rim,
+        bevel: l.bevel,
+        board: l.board,
+    }
+}
+
+pub fn retro_cart_face(cart: &Cart, kind: RetroShell) -> CartFace {
+    let shell = match cart.shell {
+        Some(_) => shell_for(cart),
+        None => plastic_in(cart, kind),
+    };
+    let (_, _, lw, lh) = look(kind).label;
+    let art = cart.label.as_deref().and_then(|p| art::cover(p, lw, lh));
+    retro_face(kind, &shell, cart, art)
+}
+
+pub(crate) fn retro_face(
+    kind: RetroShell,
+    shell: &Shell,
+    cart: &Cart,
+    art: Option<Vec<u8>>,
+) -> CartFace {
+    let s = spec(kind);
+    let mut face = shell_face(&s, shell);
+    let label = match art {
+        Some(rgba) => rgba,
+        None => generated_label(&s, &label_text(cart)),
+    };
+    mould_detail(&s, &mut face);
+    recess_label(&s, &mut face, shell);
+    paste_label(&s, &mut face, &label);
+    for (px, cover) in face.rgba.chunks_exact_mut(4).zip(s.mask) {
+        px[3] = ((px[3] as u32 * *cover as u32 + 127) / 255) as u8;
+    }
+    face
+}
+
+pub fn retro_label_rect(kind: RetroShell) -> (f32, f32, f32, f32) {
+    let l = look(kind);
+    let (x, y, w, h) = l.label;
+    (
+        x as f32 / l.w as f32,
+        y as f32 / l.h as f32,
+        w as f32 / l.w as f32,
+        h as f32 / l.h as f32,
+    )
+}
+
+fn shell_face(s: &Spec, shell: &Shell) -> CartFace {
+    let mut rgba = Vec::with_capacity((s.w * s.h * 4) as usize);
+    let edge = rim_colour(through(shell.colour, shell.colour));
+    for (i, depth) in s.depth.iter().enumerate() {
+        let (x, y) = (i as u32 % s.w, i as u32 / s.w);
+        let c = match shell.finish {
+            Finish::Solid => shell.colour,
+            Finish::Translucent | Finish::Glitter => {
+                let body = through(shell.colour, inside(s, x, y).unwrap_or(shell.colour));
+                let c = lerp(edge, body, (*depth as u32).min(s.rim), s.rim);
+                if shell.finish == Finish::Glitter && fleck(x, y) {
+                    lerp(c, [0xff; 3], 100, 255)
+                } else {
+                    c
+                }
+            }
+        };
+        rgba.extend_from_slice(&[c[0], c[1], c[2], 255]);
+    }
+    CartFace {
+        rgba,
+        w: s.w,
+        h: s.h,
+    }
+}
+
+fn through(plastic: [u8; 3], behind: [u8; 3]) -> [u8; 3] {
+    let filter =
+        |a: [u8; 3], b: [u8; 3]| [0, 1, 2].map(|c| (a[c] as u32 * b[c] as u32 / 255) as u8);
+    lerp(
+        filter(plastic, behind),
+        filter(plastic, plastic),
+        SURFACE,
+        255,
+    )
+}
+
+fn inside(s: &Spec, x: u32, y: u32) -> Option<[u8; 3]> {
+    let (bx, top, pins, contacts_from, traces_from) = s.board;
+    let (fx, fy) = (x as f32 / s.w as f32, y as f32 / s.h as f32);
+    if !(bx.0..bx.1).contains(&fx) || fy < top {
+        return None;
+    }
+    let (c0, c1) = pins;
+    let pitch = (c1 - c0) / 32.0;
+    let on_contact = (c0..c1).contains(&fx) && ((fx - c0) % pitch) < pitch * 0.6;
+    if on_contact && fy >= contacts_from {
+        return Some(GOLD);
+    }
+    if on_contact && ((fx - c0) % pitch) < pitch * 0.2 && fy >= traces_from {
+        Some(TRACE)
+    } else {
+        Some(BOARD)
+    }
+}
+
+fn fleck(x: u32, y: u32) -> bool {
+    let mut h = x.wrapping_mul(0x9e37_79b9) ^ y.wrapping_mul(0x85eb_ca6b);
+    h ^= h >> 15;
+    h = h.wrapping_mul(0x2c1b_3c6d);
+    h ^= h >> 12;
+    h.is_multiple_of(100)
+}
+
+fn rim_colour(base: [u8; 3]) -> [u8; 3] {
+    let mean = (base[0] as u16 + base[1] as u16 + base[2] as u16) / 3;
+    base.map(|c| {
+        let grey = (3 * c as u16 + mean) / 4;
+        (grey + (255 - grey) * 2 / 5) as u8
+    })
+}
+
+fn lerp(a: [u8; 3], b: [u8; 3], num: u32, den: u32) -> [u8; 3] {
+    let mut out = [0u8; 3];
+    for c in 0..3 {
+        out[c] = ((a[c] as u32 * (den - num) + b[c] as u32 * num) / den) as u8;
+    }
+    out
+}
+
+fn mould_detail(s: &Spec, face: &mut CartFace) {
+    let mix = |px: &mut [u8], to: [u8; 3], a: u32| {
+        for c in 0..3 {
+            px[c] = ((to[c] as u32 * a + px[c] as u32 * (255 - a) + 127) / 255) as u8;
+        }
+    };
+    let sides = s.detail.shadow.iter().zip(&s.detail.highlight);
+    for (px, (shade, light)) in face.rgba.chunks_exact_mut(4).zip(sides) {
+        let under = [px[0], px[1], px[2]];
+        if *shade > 0 {
+            mix(px, under.map(|c| (c as f32 * 0.62) as u8), *shade as u32);
+        }
+        if *light > 0 {
+            mix(
+                px,
+                under.map(|c| c + ((255 - c) as f32 * 0.24) as u8),
+                *light as u32,
+            );
+        }
+    }
+}
+
+fn recess_label(s: &Spec, face: &mut CartFace, shell: &Shell) {
+    let shade = |c: [u8; 3], f: f32| -> [u8; 3] {
+        [
+            (c[0] as f32 * f).clamp(0.0, 255.0) as u8,
+            (c[1] as f32 * f).clamp(0.0, 255.0) as u8,
+            (c[2] as f32 * f).clamp(0.0, 255.0) as u8,
+        ]
+    };
+    let dark = shade(shell.colour, 0.55);
+    let lit = shade(shell.colour, 1.45);
+
+    let (lx, ly, lw, lh) = s.label;
+    let (w, h) = (s.w, s.h);
+    let bevel = (s.bevel * w + SEATED_W / 2) / SEATED_W;
+    let (x0, y0) = (lx - bevel, ly - bevel);
+    let (x1, y1) = (lx + lw + bevel, ly + lh + bevel);
+    let clear = shell.finish != Finish::Solid;
+    let mut put = |x: u32, y: u32, upper: bool| {
+        if x >= w || y >= h {
+            return;
+        }
+        let d = ((y * w + x) * 4) as usize;
+        let c = if clear {
+            let under = [face.rgba[d], face.rgba[d + 1], face.rgba[d + 2]];
+            shade(under, if upper { 0.7 } else { 1.18 })
+        } else if upper {
+            dark
+        } else {
+            lit
+        };
+        face.rgba[d] = c[0];
+        face.rgba[d + 1] = c[1];
+        face.rgba[d + 2] = c[2];
+    };
+    for y in y0..y1 {
+        for x in x0..x1 {
+            let inside = (lx..lx + lw).contains(&x) && (ly..ly + lh).contains(&y);
+            if inside {
+                continue;
+            }
+            let from_top = y.saturating_sub(y0);
+            let from_left = x.saturating_sub(x0);
+            let from_bottom = y1.saturating_sub(y + 1);
+            let from_right = x1.saturating_sub(x + 1);
+            let upper = from_top.min(from_left);
+            let lower = from_bottom.min(from_right);
+            put(x, y, upper <= lower);
+        }
+    }
+}
+
+fn paste_label(s: &Spec, face: &mut CartFace, label: &[u8]) {
+    let (lx, ly, lw, lh) = s.label;
+    for y in 0..lh {
+        for x in 0..lw {
+            let src = ((y * lw + x) * 4) as usize;
+            let Some(a) = label.get(src + 3).map(|a| *a as u32) else {
+                return;
+            };
+            if a == 0 {
+                continue;
+            }
+            let d = (((y + ly) * s.w + x + lx) * 4) as usize;
+            for c in 0..3 {
+                face.rgba[d + c] =
+                    ((label[src + c] as u32 * a + face.rgba[d + c] as u32 * (255 - a) + 127) / 255)
+                        as u8;
+            }
+        }
+    }
+}
+
+fn generated_label(s: &Spec, title: &str) -> Vec<u8> {
+    let (_, _, lw, lh) = s.label;
+    let bg = label_colour(title);
+    let mut rgba = Vec::with_capacity((lw * lh * 4) as usize);
+    for _ in 0..lw * lh {
+        rgba.extend_from_slice(&[bg[0], bg[1], bg[2], 255]);
+    }
+    if let Some(font) = text::label_font() {
+        let layout = text::fit_box(
+            font,
+            title,
+            (lw - 2 * PAD) as f32,
+            s.max_h,
+            MAX_LINES,
+            s.max_px,
+            MIN_PX,
+        );
+        text::draw_centred(&mut rgba, lw, lh, &layout, ink(bg));
+    }
+    rgba
+}
+
+fn ink(bg: [u8; 3]) -> [u8; 3] {
+    let luma = 0.2126 * bg[0] as f32 + 0.7152 * bg[1] as f32 + 0.0722 * bg[2] as f32;
+    if luma > 140.0 {
+        [0x1a, 0x18, 0x16]
+    } else {
+        [0xf4, 0xf1, 0xea]
+    }
+}
diff --git a/crates/slot-ui/src/retro_mould.rs b/crates/slot-ui/src/retro_mould.rs
new file mode 100644
index 0000000..4618a42
--- /dev/null
+++ b/crates/slot-ui/src/retro_mould.rs
@@ -0,0 +1,125 @@
+pub(crate) struct Detail {
+    pub shadow: Vec<u8>,
+    pub highlight: Vec<u8>,
+}
+
+impl Detail {
+    pub(crate) fn blank(w: u32, h: u32) -> Detail {
+        Detail {
+            shadow: vec![0; (w * h) as usize],
+            highlight: vec![0; (w * h) as usize],
+        }
+    }
+}
+
+pub(crate) fn depth_map(mask: &[u8], w: usize, h: usize) -> Vec<u8> {
+    let mut d: Vec<u8> = mask
+        .iter()
+        .map(|c| if *c > 127 { 255 } else { 0 })
+        .collect();
+    for y in 0..h {
+        for x in 0..w {
+            let i = y * w + x;
+            if d[i] == 0 {
+                continue;
+            }
+            let up = if y == 0 { 0 } else { d[i - w] };
+            let left = if x == 0 { 0 } else { d[i - 1] };
+            d[i] = d[i].min(up.saturating_add(1)).min(left.saturating_add(1));
+        }
+    }
+    for y in (0..h).rev() {
+        for x in (0..w).rev() {
+            let i = y * w + x;
+            if d[i] == 0 {
+                continue;
+            }
+            let down = if y + 1 == h { 0 } else { d[i + w] };
+            let right = if x + 1 == w { 0 } else { d[i + 1] };
+            d[i] = d[i]
+                .min(down.saturating_add(1))
+                .min(right.saturating_add(1));
+        }
+    }
+    d
+}
+
+pub(crate) fn emboss(detail: &mut Detail, png: &[u8], w: u32, h: u32) {
+    let Some(mask) = decode_mask(png, w, h) else {
+        return;
+    };
+    let at = |x: i32, y: i32| -> u8 {
+        if x < 0 || y < 0 || x >= w as i32 || y >= h as i32 {
+            0
+        } else {
+            mask[(y as u32 * w + x as u32) as usize]
+        }
+    };
+    for y in 0..h as i32 {
+        for x in 0..w as i32 {
+            let (here, before) = (at(x, y), at(x - 1, y - 1));
+            let i = (y as u32 * w + x as u32) as usize;
+            detail.highlight[i] = detail.highlight[i].saturating_add(here.saturating_sub(before));
+            detail.shadow[i] = detail.shadow[i].saturating_add(before.saturating_sub(here));
+        }
+    }
+}
+
+fn decode_mask(png: &[u8], w: u32, h: u32) -> Option<Vec<u8>> {
+    let mut reader = png::Decoder::new(std::io::Cursor::new(png))
+        .read_info()
+        .ok()?;
+    let mut buf = vec![0; reader.output_buffer_size()];
+    let info = reader.next_frame(&mut buf).ok()?;
+    let grey =
+        info.color_type == png::ColorType::Grayscale && info.bit_depth == png::BitDepth::Eight;
+    if !grey {
+        return None;
+    }
+    let (sw, sh) = (info.width, info.height);
+    if (sw, sh) == (w, h) {
+        return Some(buf[..(w * h) as usize].to_vec());
+    }
+    let src = |x: u32, y: u32| buf[(y.min(sh - 1) * sw + x.min(sw - 1)) as usize] as f32;
+    let mut out = Vec::with_capacity((w * h) as usize);
+    for y in 0..h {
+        let fy = ((y as f32 + 0.5) * sh as f32 / h as f32 - 0.5).max(0.0);
+        let (y0, ty) = (fy as u32, fy.fract());
+        for x in 0..w {
+            let fx = ((x as f32 + 0.5) * sw as f32 / w as f32 - 0.5).max(0.0);
+            let (x0, tx) = (fx as u32, fx.fract());
+            let top = src(x0, y0) * (1.0 - tx) + src(x0 + 1, y0) * tx;
+            let bottom = src(x0, y0 + 1) * (1.0 - tx) + src(x0 + 1, y0 + 1) * tx;
+            out.push((top * (1.0 - ty) + bottom * ty).round() as u8);
+        }
+    }
+    Some(out)
+}
+
+pub(crate) fn rasterise_detail(svg: &str, w: u32, h: u32) -> Option<Detail> {
+    let px = render(svg, w, h)?;
+    let mut shadow = Vec::with_capacity((w * h) as usize);
+    let mut highlight = Vec::with_capacity((w * h) as usize);
+    for p in px.data().chunks_exact(4) {
+        let lit = ((p[0] as u32 * 54 + p[1] as u32 * 183 + p[2] as u32 * 19) / 256) as u8;
+        let lit = lit.min(p[3]);
+        highlight.push(lit);
+        shadow.push(p[3] - lit);
+    }
+    Some(Detail { shadow, highlight })
+}
+
+pub(crate) fn rasterise_svg(svg: &str, w: u32, h: u32) -> Option<Vec<u8>> {
+    let px = render(svg, w, h)?;
+    Some(px.data().iter().skip(3).step_by(4).copied().collect())
+}
+
+fn render(svg: &str, w: u32, h: u32) -> Option<resvg::tiny_skia::Pixmap> {
+    let tree = usvg::Tree::from_str(svg, &usvg::Options::default()).ok()?;
+    let mut pixmap = resvg::tiny_skia::Pixmap::new(w, h)?;
+    let size = tree.size();
+    let scale =
+        resvg::tiny_skia::Transform::from_scale(w as f32 / size.width(), h as f32 / size.height());
+    resvg::render(&tree, scale, &mut pixmap.as_mut());
+    Some(pixmap)
+}
diff --git a/crates/slot-ui/src/retro_shadows.rs b/crates/slot-ui/src/retro_shadows.rs
new file mode 100644
index 0000000..f65d3d4
--- /dev/null
+++ b/crates/slot-ui/src/retro_shadows.rs
@@ -0,0 +1,18 @@
+use std::sync::Mutex;
+
+use slot_gfx::TexId;
+
+use crate::retro_cart::RetroShell;
+
+static SHADOWS: Mutex<[Option<TexId>; 4]> = Mutex::new([None; 4]);
+
+pub fn publish_retro_shadows(faces: &[(RetroShell, TexId)]) {
+    let mut all = SHADOWS.lock().unwrap_or_else(|e| e.into_inner());
+    for (kind, face) in faces {
+        all[kind.slot()] = Some(*face);
+    }
+}
+
+pub(crate) fn published(kind: RetroShell) -> Option<TexId> {
+    SHADOWS.lock().unwrap_or_else(|e| e.into_inner())[kind.slot()]
+}
diff --git a/crates/slot-ui/src/retro_shell.rs b/crates/slot-ui/src/retro_shell.rs
new file mode 100644
index 0000000..3449a75
--- /dev/null
+++ b/crates/slot-ui/src/retro_shell.rs
@@ -0,0 +1,122 @@
+use slot_store::Cart;
+
+use crate::cart::clean_label;
+use crate::retro_cart::{retro_shell_of, NesShell, RetroShell, SnesShell};
+use crate::shell::{Finish, Shell, DEFAULT_SHELL, DUAL_MODE_SHELL};
+
+const fn solid(colour: [u8; 3]) -> Shell {
+    Shell {
+        colour,
+        finish: Finish::Solid,
+    }
+}
+
+pub const NES_GREY: Shell = solid([0x7a, 0x7a, 0x7a]);
+pub const SNES_GREY: Shell = solid([0x9f, 0x9c, 0xa2]);
+pub const SFC_GREY: Shell = solid([0x94, 0x96, 0x96]);
+pub const NES_GOLD: Shell = solid([0xaa, 0x94, 0x51]);
+pub const FAMICOM_YELLOW: Shell = solid([0xac, 0x86, 0x42]);
+pub const RETRO_BLACK: Shell = DUAL_MODE_SHELL;
+
+pub struct NesRow {
+    pub title: &'static str,
+    pub shell: NesShell,
+    pub plastic: Shell,
+    pub usa_only: bool,
+    pub source: &'static str,
+}
+
+pub struct SnesRow {
+    pub title: &'static str,
+    pub plastic: Shell,
+    pub source: &'static str,
+}
+
+pub const NES_TITLES: &[NesRow] = &[
+    NesRow {
+        title: "The Legend of Zelda",
+        shell: NesShell::Nes,
+        plastic: NES_GOLD,
+        usa_only: true,
+        source: "The Legend of Zelda (NA)",
+    },
+    NesRow {
+        title: "Zelda II - The Adventure of Link",
+        shell: NesShell::Nes,
+        plastic: NES_GOLD,
+        usa_only: true,
+        source: "Zelda II: The Adventure of Link (NA)",
+    },
+    NesRow {
+        title: "Super Mario Bros.",
+        shell: NesShell::Famicom,
+        plastic: FAMICOM_YELLOW,
+        usa_only: false,
+        source: "Super Mario Bros. (HVC-SM, Famicom)",
+    },
+    NesRow {
+        title: "Bomberman",
+        shell: NesShell::Famicom,
+        plastic: RETRO_BLACK,
+        usa_only: false,
+        source: "Bomberman (Hudson, Famicom)",
+    },
+];
+
+pub const SNES_TITLES: &[SnesRow] = &[SnesRow {
+    title: "Killer Instinct",
+    plastic: RETRO_BLACK,
+    source: "Killer Instinct (SNES; EU, AU, CA and US)",
+}];
+
+fn title_key(name: &str) -> String {
+    let label = clean_label(name).to_lowercase();
+    match label.strip_suffix(", the") {
+        Some(rest) => format!("the {rest}"),
+        None => label,
+    }
+}
+
+fn same_title(row: &str, stem: &str) -> bool {
+    title_key(row) == title_key(stem)
+}
+
+pub fn plastic_in(cart: &Cart, kind: RetroShell) -> Shell {
+    match kind {
+        RetroShell::Nes(shell) => NES_TITLES
+            .iter()
+            .find(|r| {
+                r.shell == shell
+                    && same_title(r.title, &cart.stem)
+                    && (!r.usa_only || cart.stem.to_ascii_uppercase().contains("(USA"))
+            })
+            .map(|r| r.plastic)
+            .unwrap_or(NES_GREY),
+        RetroShell::Snes(shell) => SNES_TITLES
+            .iter()
+            .find(|r| same_title(r.title, &cart.stem))
+            .map(|r| r.plastic)
+            .unwrap_or(match shell {
+                SnesShell::Snes => SNES_GREY,
+                SnesShell::Sfc => SFC_GREY,
+            }),
+    }
+}
+
+pub fn plastic_for(cart: &Cart) -> Shell {
+    match retro_shell_of(cart) {
+        Some(kind) => plastic_in(cart, kind),
+        None => DEFAULT_SHELL,
+    }
+}
+
+pub fn retro_presets() -> Vec<(&'static str, Shell)> {
+    vec![
+        ("NES grey", NES_GREY),
+        ("SNES grey", SNES_GREY),
+        ("Super Famicom grey", SFC_GREY),
+        ("Zelda gold", NES_GOLD),
+        ("Super Mario Bros. Famicom", FAMICOM_YELLOW),
+        ("Black cart", RETRO_BLACK),
+    ]
+}
