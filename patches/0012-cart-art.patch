diff --git a/crates/slot-ui/tests/nes_presets.rs b/crates/slot-ui/tests/nes_presets.rs
new file mode 100644
index 0000000..8a814bf
--- /dev/null
+++ b/crates/slot-ui/tests/nes_presets.rs
@@ -0,0 +1,48 @@
+use slot_gfx::BACKDROP;
+use slot_ui::{
+    retro_presets, shell_presets, FAMICOM_YELLOW, NES_GOLD, NES_GREY, RETRO_BLACK, SFC_GREY,
+    SNES_GREY,
+};
+
+#[test]
+fn the_upstream_presets_are_a_prefix_in_the_same_order() {
+    let upstream = shell_presets();
+    let all: Vec<_> = upstream.iter().cloned().chain(retro_presets()).collect();
+    assert_eq!(&all[..upstream.len()], &upstream[..]);
+    assert_eq!(upstream.len(), 25, "upstream's own presets changed");
+    assert_eq!(upstream[0].0, "Game Boy grey");
+    assert_eq!(upstream[24].0, "Pokémon Yellow");
+    assert_eq!(all.len(), 25 + retro_presets().len());
+}
+
+#[test]
+fn the_retro_presets_are_the_tables_plastics_each_once() {
+    let all: Vec<_> = shell_presets().into_iter().chain(retro_presets()).collect();
+    let mut names: Vec<_> = all.iter().map(|(n, _)| *n).collect();
+    names.sort();
+    names.dedup();
+    assert_eq!(names.len(), all.len(), "two presets share a name");
+    let find = |n: &str| {
+        retro_presets()
+            .iter()
+            .find(|(name, _)| *name == n)
+            .unwrap()
+            .1
+    };
+    assert_eq!(find("NES grey"), NES_GREY);
+    assert_eq!(find("SNES grey"), SNES_GREY);
+    assert_eq!(find("Super Famicom grey"), SFC_GREY);
+    assert_eq!(find("Zelda gold"), NES_GOLD);
+    assert_eq!(find("Super Mario Bros. Famicom"), FAMICOM_YELLOW);
+    assert_eq!(find("Black cart"), RETRO_BLACK);
+}
+
+#[test]
+fn every_retro_preset_is_visible_against_the_backdrop() {
+    for (name, shell) in retro_presets() {
+        let d: u32 = (0..3)
+            .map(|i| (shell.colour[i] as i32 - (BACKDROP[i] * 255.0).round() as i32).unsigned_abs())
+            .sum();
+        assert!(d > 60, "the {name} preset will not be seen");
+    }
+}
diff --git a/crates/slot-ui/tests/nes_shell.rs b/crates/slot-ui/tests/nes_shell.rs
new file mode 100644
index 0000000..9a36eb9
--- /dev/null
+++ b/crates/slot-ui/tests/nes_shell.rs
@@ -0,0 +1,173 @@
+use std::collections::HashSet;
+use std::path::PathBuf;
+
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    plastic_in, shell_for, Finish, NesShell, RetroShell, SnesShell, NES_GOLD, NES_GREY, NES_TITLES,
+    RETRO_BLACK, SFC_GREY, SNES_GREY, SNES_TITLES,
+};
+
+fn cart(platform: Platform, stem: &str) -> Cart {
+    Cart {
+        platform,
+        stem: stem.into(),
+        rom: PathBuf::from(format!("{stem}.rom")),
+        label: None,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+const NES_STEMS: &[(&str, &str)] = &[
+    ("The Legend of Zelda", "Legend of Zelda, The (USA)"),
+    (
+        "Zelda II - The Adventure of Link",
+        "Zelda II - The Adventure of Link (USA)",
+    ),
+    ("Super Mario Bros.", "Super Mario Bros. (Japan)"),
+    ("Bomberman", "Bomberman (Japan)"),
+];
+
+const SNES_STEMS: &[(&str, &str)] = &[("Killer Instinct", "Killer Instinct (USA)")];
+
+fn real_stem(table: &[(&'static str, &'static str)], title: &str) -> &'static str {
+    table
+        .iter()
+        .find(|(t, _)| *t == title)
+        .unwrap_or_else(|| panic!("{title} has no real No-Intro stem in this test"))
+        .1
+}
+
+#[test]
+fn every_nes_row_maps_its_real_no_intro_name_to_its_plastic() {
+    for row in NES_TITLES {
+        let c = cart(Platform::Nes, real_stem(NES_STEMS, row.title));
+        let got = plastic_in(&c, RetroShell::Nes(row.shell));
+        assert_eq!(got, row.plastic, "{} did not map", c.stem);
+        assert_eq!(got.finish, Finish::Solid, "{} is not solid", c.stem);
+    }
+}
+
+#[test]
+fn every_snes_row_maps_on_both_snes_shells() {
+    for row in SNES_TITLES {
+        let c = cart(Platform::Snes, real_stem(SNES_STEMS, row.title));
+        for shell in [SnesShell::Snes, SnesShell::Sfc] {
+            let got = plastic_in(&c, RetroShell::Snes(shell));
+            assert_eq!(got, row.plastic, "{} did not map on {shell:?}", c.stem);
+        }
+        assert_eq!(shell_for(&c), row.plastic, "{} did not map", c.stem);
+    }
+}
+
+#[test]
+fn gold_zelda_is_gold_and_black_killer_instinct_is_black() {
+    let zelda = cart(Platform::Nes, "Legend of Zelda, The (USA)");
+    assert_eq!(shell_for(&zelda), NES_GOLD);
+    let two = cart(Platform::Nes, "Zelda II - The Adventure of Link (USA)");
+    assert_eq!(shell_for(&two), NES_GOLD);
+    let ki = cart(Platform::Snes, "Killer Instinct (USA)");
+    assert_eq!(shell_for(&ki), RETRO_BLACK);
+    assert!(
+        NES_GOLD.colour[0] > NES_GOLD.colour[2] + 40,
+        "gold is not yellow"
+    );
+}
+
+#[test]
+fn gold_zelda_is_only_for_usa_stems() {
+    for stem in [
+        "Legend of Zelda, The (Europe)",
+        "Legend of Zelda, The (Japan)",
+        "Legend of Zelda, The (Europe) (Rev 1)",
+        "Legend of Zelda, The",
+        "Zelda II - The Adventure of Link (Europe)",
+        "Zelda II - The Adventure of Link (Japan)",
+    ] {
+        assert_eq!(shell_for(&cart(Platform::Nes, stem)), NES_GREY, "{stem}");
+    }
+    for stem in [
+        "Legend of Zelda, The (USA) (Rev 1)",
+        "Legend of Zelda, The (USA, Europe)",
+    ] {
+        assert_eq!(shell_for(&cart(Platform::Nes, stem)), NES_GOLD, "{stem}");
+    }
+}
+
+#[test]
+fn black_killer_instinct_has_no_region_condition() {
+    for stem in [
+        "Killer Instinct (USA)",
+        "Killer Instinct (Europe)",
+        "Killer Instinct (Australia)",
+        "Killer Instinct (Canada)",
+        "Killer Instinct",
+    ] {
+        assert_eq!(
+            shell_for(&cart(Platform::Snes, stem)),
+            RETRO_BLACK,
+            "{stem}"
+        );
+    }
+}
+
+#[test]
+fn the_article_form_and_tags_and_case_do_not_change_the_lookup() {
+    for stem in [
+        "Legend of Zelda, The (USA)",
+        "The Legend of Zelda (USA)",
+        "Legend of Zelda, The (USA) (Rev 1)",
+        "Legend of Zelda, The (USA) (Rev A)",
+        "legend of zelda, the (usa) [!]",
+    ] {
+        assert_eq!(shell_for(&cart(Platform::Nes, stem)), NES_GOLD, "{stem}");
+    }
+}
+
+#[test]
+fn an_uncatalogued_cart_gets_its_platforms_sampled_grey() {
+    assert_eq!(shell_for(&cart(Platform::Nes, "Mega Man (USA)")), NES_GREY);
+    assert_eq!(shell_for(&cart(Platform::Snes, "F-Zero (USA)")), SNES_GREY);
+    let sfc = plastic_in(
+        &cart(Platform::Snes, "F-Zero (Japan)"),
+        RetroShell::Snes(SnesShell::Sfc),
+    );
+    assert_eq!(sfc, SFC_GREY);
+}
+
+#[test]
+fn a_famicom_row_does_not_colour_the_nes_cart() {
+    let smb = cart(Platform::Nes, "Super Mario Bros. (USA)");
+    assert_eq!(shell_for(&smb), NES_GREY);
+    let famicom = plastic_in(&smb, RetroShell::Nes(NesShell::Famicom));
+    assert_ne!(famicom, NES_GREY);
+}
+
+#[test]
+fn no_two_rows_share_a_key() {
+    let mut seen = HashSet::new();
+    for row in NES_TITLES {
+        let key = (
+            slot_ui::clean_label(row.title).to_lowercase(),
+            row.shell == NesShell::Famicom,
+        );
+        assert!(seen.insert(key), "{} is listed twice", row.title);
+    }
+    let mut seen = HashSet::new();
+    for row in SNES_TITLES {
+        let key = slot_ui::clean_label(row.title).to_lowercase();
+        assert!(seen.insert(key), "{} is listed twice", row.title);
+    }
+}
+
+#[test]
+fn every_row_names_its_source() {
+    for source in NES_TITLES
+        .iter()
+        .map(|r| r.source)
+        .chain(SNES_TITLES.iter().map(|r| r.source))
+    {
+        assert!(!source.trim().is_empty(), "a row has no source");
+    }
+}
diff --git a/crates/slot-ui/tests/render_nes_shelves.rs b/crates/slot-ui/tests/render_nes_shelves.rs
new file mode 100644
index 0000000..f11f312
--- /dev/null
+++ b/crates/slot-ui/tests/render_nes_shelves.rs
@@ -0,0 +1,346 @@
+#![cfg(target_os = "macos")]
+
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+use slot_gfx::{Compositor, HeadlessSurface};
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    cart_box, rest_y, retro_cart_face, retro_cart_shadow, retro_silhouette, seated_box, Draw,
+    NesShell, RetroShell, Shelf, SnesShell, OUT_H, OUT_W,
+};
+
+static GL: Mutex<()> = Mutex::new(());
+
+fn compositor() -> Option<(MutexGuard<'static, ()>, HeadlessSurface, Compositor)> {
+    let guard = GL.lock().unwrap_or_else(PoisonError::into_inner);
+    let surface = HeadlessSurface::new().ok()?;
+    let compositor = Compositor::new(&surface).ok()?;
+    Some((guard, surface, compositor))
+}
+
+const GROUND: [f32; 4] = [0.22, 0.24, 0.28, 1.0];
+
+fn platform_of(kind: RetroShell) -> Platform {
+    match kind {
+        RetroShell::Nes(_) => Platform::Nes,
+        RetroShell::Snes(_) => Platform::Snes,
+    }
+}
+
+fn stem_of(kind: RetroShell) -> &'static str {
+    match kind {
+        RetroShell::Nes(NesShell::Nes) => "Blank Cart (USA)",
+        RetroShell::Nes(NesShell::Famicom) => "Super Mario Bros. (Japan)",
+        RetroShell::Snes(SnesShell::Snes) => "Blank Cart (USA)",
+        RetroShell::Snes(SnesShell::Sfc) => "Super Mario World (Japan)",
+    }
+}
+
+fn cart_of(kind: RetroShell, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform: platform_of(kind),
+        stem: stem_of(kind).into(),
+        rom: format!("Games/{}.rom", stem_of(kind)).into(),
+        label,
+        code: String::new(),
+        shell: None,
+        title: String::new(),
+    }
+}
+
+fn opaque_box(mask: &[u8], w: u32) -> (u32, u32, u32, u32) {
+    let (mut x0, mut y0, mut x1, mut y1) = (u32::MAX, u32::MAX, 0, 0);
+    for (i, a) in mask.iter().enumerate() {
+        if *a > 127 {
+            let (x, y) = (i as u32 % w, i as u32 / w);
+            (x0, y0, x1, y1) = (x0.min(x), y0.min(y), x1.max(x + 1), y1.max(y + 1));
+        }
+    }
+    (x0, y0, x1, y1)
+}
+
+#[test]
+fn every_outline_sits_inside_its_platforms_box() {
+    for kind in RetroShell::ALL {
+        let p = platform_of(kind);
+        let (cw, ch) = cart_box(p);
+        let (sw, sh) = seated_box(p);
+        let mask = retro_silhouette(kind, cw, ch);
+        let (x0, y0, x1, y1) = opaque_box(&mask, cw);
+        let name = kind.name();
+        assert!(x0 >= 1 && x1 < cw, "{name} touches the box sides");
+        assert!(y1 <= ch, "{name} runs past the box bottom");
+        assert!(
+            (x1 - x0) * 100 >= cw * 90,
+            "{name} is only {} of {cw} px wide",
+            x1 - x0
+        );
+        assert!(
+            ch.abs_diff(sh * cw / sw) <= 1,
+            "{name} cart box {cw}x{ch} is not the seated box {sw}x{sh} scaled"
+        );
+        assert!(y0 < y1, "{name} has an empty outline");
+        let face = retro_cart_face(&cart_of(kind, None), kind);
+        assert_eq!((face.w, face.h), (cw, ch), "{name} face is not the box");
+    }
+}
+
+fn label_art(dir: &Path) -> PathBuf {
+    let path = dir.join("label.png");
+    let file = std::fs::File::create(&path).expect("create label");
+    let mut e = png::Encoder::new(file, 8, 8);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    let px: Vec<u8> = (0..64).flat_map(|_| [255, 0, 255, 255]).collect();
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    path
+}
+
+#[test]
+fn the_label_lands_inside_its_box() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let art = label_art(d.path());
+    for kind in RetroShell::ALL {
+        let name = kind.name();
+        let cart = cart_of(kind, Some(art.clone()));
+        let face = retro_cart_face(&cart, kind);
+        let mask = retro_silhouette(kind, face.w, face.h);
+        let magenta: Vec<(u32, u32)> = face
+            .rgba
+            .chunks_exact(4)
+            .enumerate()
+            .filter(|(_, p)| p[0] > 200 && p[1] < 60 && p[2] > 200 && p[3] > 200)
+            .map(|(i, _)| (i as u32 % face.w, i as u32 / face.w))
+            .collect();
+        assert!(magenta.len() > 2000, "{name} shows no label art");
+        let (x0, y0, x1, y1) = (
+            magenta.iter().map(|p| p.0).min().unwrap_or(0),
+            magenta.iter().map(|p| p.1).min().unwrap_or(0),
+            magenta.iter().map(|p| p.0).max().unwrap_or(0) + 1,
+            magenta.iter().map(|p| p.1).max().unwrap_or(0) + 1,
+        );
+        assert!(x1 <= face.w && y1 <= face.h, "{name} label leaves the box");
+        for (x, y) in [(x0, y0), (x1 - 1, y0), (x0, y1 - 1), (x1 - 1, y1 - 1)] {
+            assert!(
+                mask[(y * face.w + x) as usize] > 127,
+                "{name} label corner {x},{y} is outside the shell"
+            );
+        }
+        let area = (x1 - x0) * (y1 - y0);
+        assert!(
+            magenta.len() as u32 * 100 >= area * 95,
+            "{name} label is not a solid rectangle: {} of {area} px",
+            magenta.len()
+        );
+        let (lw, lh) = slot_ui::label_size(&cart_of(kind, None));
+        if matches!(
+            kind,
+            RetroShell::Nes(NesShell::Nes) | RetroShell::Snes(SnesShell::Snes)
+        ) {
+            assert_eq!((x1 - x0, y1 - y0), (lw, lh), "{name} label is not its box");
+        }
+    }
+}
+
+fn frame(c: &mut Compositor, items: &[Draw]) -> Vec<u8> {
+    c.begin_frame();
+    c.draw_list(items);
+    c.read_frame()
+}
+
+fn at(px: &[u8], x: u32, y: u32) -> [u8; 3] {
+    let o = ((y * OUT_W + x) * 4) as usize;
+    [px[o], px[o + 1], px[o + 2]]
+}
+
+fn write_png(path: &Path, w: u32, h: u32, rgba: &[u8]) {
+    let file = std::fs::File::create(path).expect("create png");
+    let mut e = png::Encoder::new(std::io::BufWriter::new(file), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(rgba)
+        .expect("png data");
+    println!("wrote {}", path.display());
+}
+
+fn crop(px: &[u8], x: u32, y: u32, w: u32, h: u32) -> Vec<u8> {
+    let mut out = Vec::with_capacity((w * h * 4) as usize);
+    for row in y..y + h {
+        let o = ((row * OUT_W + x) * 4) as usize;
+        out.extend_from_slice(&px[o..o + (w * 4) as usize]);
+    }
+    out
+}
+
+#[test]
+fn a_shadow_falls_under_every_variant() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    let dump = std::env::var("CART_ART_DIR").ok().map(PathBuf::from);
+    let mut shots: Vec<(RetroShell, u32, u32, Vec<u8>)> = Vec::new();
+    for kind in RetroShell::ALL {
+        let name = kind.name();
+        let (cw, ch) = cart_box(platform_of(kind));
+        let face = retro_cart_face(&cart_of(kind, None), kind);
+        let shadow = retro_cart_shadow(kind);
+        assert_eq!(
+            (shadow.w, shadow.h),
+            (cw, ch),
+            "{name} shadow is not the box"
+        );
+        let mask = retro_silhouette(kind, cw, ch);
+        let alpha: Vec<u8> = shadow.rgba.chunks_exact(4).map(|p| p[3]).collect();
+        assert_eq!(alpha, mask, "{name} shadow is not its outline");
+        assert!(
+            shadow.rgba.chunks_exact(4).all(|p| p[..3] == [0, 0, 0]),
+            "{name} shadow is not black"
+        );
+        let (face_tex, shadow_tex) = (
+            c.create_texture(face.w, face.h, &face.rgba),
+            c.create_texture(shadow.w, shadow.h, &shadow.rgba),
+        );
+        let (x, y) = ((OUT_W - cw) / 2, rest_y(ch as f32) as u32);
+        let list = [
+            Draw::Rect {
+                x: 0.0,
+                y: 0.0,
+                w: OUT_W as f32,
+                h: OUT_H as f32,
+                colour: GROUND,
+            },
+            Draw::Tex {
+                x: x as f32 + 6.0,
+                y: y as f32 + 6.0,
+                w: cw as f32,
+                h: ch as f32,
+                tex: shadow_tex,
+                alpha: 0.6,
+            },
+            Draw::Tex {
+                x: x as f32,
+                y: y as f32,
+                w: cw as f32,
+                h: ch as f32,
+                tex: face_tex,
+                alpha: 1.0,
+            },
+        ];
+        let px = frame(&mut c, &list);
+        let ground = at(&px, 4, 4);
+        let (x0, y0, x1, y1) = opaque_box(&mask, cw);
+        let mid = (y0 + y1) / 2;
+        let below = at(&px, x + x0 + (x1 - x0) / 5, y + y1 + 3);
+        let beside = at(&px, x + x1 + 3, y + mid);
+        for (what, p) in [("below", below), ("beside", beside)] {
+            assert!(
+                p.iter().zip(ground).all(|(a, b)| *a + 20 < b),
+                "{name} casts no shadow {what} the cart: {p:?} against {ground:?}"
+            );
+        }
+        assert_eq!(
+            at(&px, x + x1 + 14, y + mid),
+            ground,
+            "{name} shadow runs on"
+        );
+        shots.push((kind, x, y, px));
+    }
+    let Some(dir) = dump else {
+        return;
+    };
+    std::fs::create_dir_all(&dir).expect("create dump dir");
+    let (pad, cell_w, cell_h) = (12u32, 360u32 + 24, 340u32 + 24);
+    let sheet_w = cell_w * 4;
+    let mut sheet = vec![0u8; (sheet_w * cell_h * 4) as usize];
+    for (i, (kind, x, y, px)) in shots.iter().enumerate() {
+        let (cw, ch) = cart_box(platform_of(*kind));
+        let (cx0, cy0) = (x.saturating_sub(pad), y.saturating_sub(pad));
+        let (w, h) = (cw + 2 * pad + 6, ch + 2 * pad + 6);
+        let one = crop(px, cx0, cy0, w, h);
+        write_png(&dir.join(format!("{}.png", kind.name())), w, h, &one);
+        for row in 0..h.min(cell_h) {
+            let src = (row * w * 4) as usize;
+            let dst = ((row * sheet_w + i as u32 * cell_w) * 4) as usize;
+            let n = (w.min(cell_w) * 4) as usize;
+            sheet[dst..dst + n].copy_from_slice(&one[src..src + n]);
+        }
+    }
+    write_png(&dir.join("sheet.png"), sheet_w, cell_h, &sheet);
+}
+
+fn shelf_of(kind: RetroShell, n: usize) -> Shelf {
+    Shelf::new(
+        (0..n)
+            .map(|i| {
+                let mut cart = cart_of(kind, None);
+                cart.stem = format!("Game {i} (USA)");
+                cart
+            })
+            .collect(),
+    )
+}
+
+#[test]
+fn a_faded_neighbour_is_backed_by_its_own_platforms_shadow() {
+    let Some((_g, _s, mut c)) = compositor() else {
+        return;
+    };
+    let gba = slot_ui::cart_shadow();
+    let gba_tex = c.create_texture(gba.w, gba.h, &gba.rgba);
+    for kind in [
+        RetroShell::Nes(NesShell::Nes),
+        RetroShell::Snes(SnesShell::Snes),
+    ] {
+        let name = kind.name();
+        let mut shelf = shelf_of(kind, 3);
+        shelf.set_shadow(gba_tex);
+        let faces: Vec<_> = (0..3)
+            .map(|i| {
+                let f = retro_cart_face(&shelf.carts[i], kind);
+                c.create_texture(f.w, f.h, &f.rgba)
+            })
+            .collect();
+        shelf.set_faces(faces);
+        let shadows: Vec<_> = RetroShell::ALL
+            .iter()
+            .map(|k| {
+                let s = retro_cart_shadow(*k);
+                (*k, c.create_texture(s.w, s.h, &s.rgba))
+            })
+            .collect();
+        shelf.set_retro(&shadows);
+        let own = shadows.iter().find(|(k, _)| *k == kind).map(|(_, t)| *t);
+        let mut list = Vec::new();
+        shelf.draw_row(None, 0.0, 0.0, 1.0, &mut list);
+        let backed: Vec<_> = list
+            .iter()
+            .filter_map(|d| match d {
+                Draw::Tex { tex, w, h, .. } => Some((*tex, *w, *h)),
+                _ => None,
+            })
+            .filter(|(tex, _, _)| Some(*tex) == own)
+            .collect();
+        let (cw, ch) = cart_box(platform_of(kind));
+        assert!(
+            !backed.is_empty(),
+            "{name} neighbours have no shadow behind them"
+        );
+        assert!(
+            backed
+                .iter()
+                .all(|(_, w, h)| *w <= cw as f32 && *h <= ch as f32),
+            "{name} shadow is drawn bigger than its cart"
+        );
+        assert!(
+            list.iter()
+                .all(|d| !matches!(d, Draw::Tex { tex, .. } if *tex == gba_tex)),
+            "{name} neighbours are backed by the GBA shadow"
+        );
+    }
+}
