diff --git a/crates/slot/tests/lid_fit.rs b/crates/slot/tests/lid_fit.rs
new file mode 100644
index 0000000..09f65bc
--- /dev/null
+++ b/crates/slot/tests/lid_fit.rs
@@ -0,0 +1,127 @@
+#![cfg(target_os = "macos")]
+
+mod common;
+
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+use slot::app::App;
+use slot_gfx::{Compositor, Draw, HeadlessSurface, TexId};
+use slot_input::{Action, Btn};
+use slot_store::{Core, Platform};
+use slot_ui::{
+    arrows_hint_face, board_face, cart_face, cart_shadow, chip_face, chip_shadow_face, hint_face,
+    padded, socket_face, CartFace, TURN_PAD,
+};
+use tempfile::TempDir;
+
+static GL: Mutex<()> = Mutex::new(());
+
+fn compositor() -> Option<(MutexGuard<'static, ()>, HeadlessSurface, Compositor)> {
+    let guard = GL.lock().unwrap_or_else(PoisonError::into_inner);
+    let surface = HeadlessSurface::new().ok()?;
+    let compositor = Compositor::new(&surface).ok()?;
+    Some((guard, surface, compositor))
+}
+
+fn tex(c: &mut Compositor, f: &CartFace) -> TexId {
+    c.create_texture(f.w, f.h, &f.rgba)
+}
+
+fn root_with(platform: Platform) -> TempDir {
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut rom = vec![0u8; 16 + 0x4000 + 0x2000];
+    if platform == Platform::Nes {
+        rom[..4].copy_from_slice(b"NES\x1a");
+        rom[4] = 1;
+        rom[5] = 1;
+    }
+    if platform == Platform::Gba {
+        rom = common::gba_rom();
+    }
+    for stem in ["Aaa", "Bbb"] {
+        let name = format!("{stem}.{}", platform.extensions()[0]);
+        let path = d.path().join("Games").join(platform.dir_name()).join(name);
+        std::fs::write(path, &rom).expect("write cart");
+    }
+    common::clocked(d.path());
+    d
+}
+
+type Lid = (f32, f32, f32, f32, f32, f32);
+
+fn lid_drawn(platform: Platform, dt: f32) -> Option<Lid> {
+    let (_g, _s, mut c) = compositor()?;
+    let d = root_with(platform);
+    let mut app = App::boot(d.path());
+    let cart = app.carts().next().cloned().expect("a cart on the shelf");
+    let row: Vec<TexId> = app.carts().map(|k| tex(&mut c, &cart_face(k))).collect();
+    app.set_faces(row);
+    app.set_cart_shadow(tex(&mut c, &cart_shadow()));
+    let blank = tex(&mut c, &chip_face(None));
+    let shadow = tex(&mut c, &chip_shadow_face());
+    let sockets = Core::ALL
+        .iter()
+        .map(|k| tex(&mut c, &socket_face(*k)))
+        .collect();
+    let chips = Core::ALL
+        .iter()
+        .map(|k| tex(&mut c, &chip_face(Some(*k))))
+        .collect();
+    app.set_core_part_faces(sockets, chips, blank, shadow);
+    let legend = [
+        hint_face("B", "Cancel"),
+        arrows_hint_face("Swap"),
+        hint_face("A", "Choose"),
+    ]
+    .iter()
+    .map(|f| (c.create_texture(f.w, f.h, &f.rgba), f.w))
+    .collect();
+    app.set_core_legend_faces(legend);
+    let face = padded(&cart_face(&cart), TURN_PAD);
+    let lid = tex(&mut c, &face);
+    app.set_core_board_faces(tex(&mut c, &board_face(&cart)), lid);
+    app.apply(Action::GbaDown(Btn::Start));
+    app.update(0.01);
+    app.update(dt);
+    let mut out = Vec::new();
+    app.draw(&mut out);
+    let found = out.iter().find_map(|d| match d {
+        Draw::Turned {
+            x, y, w, h, tex, ..
+        } if *tex == lid => Some((*x, *y, *w, *h, face.w as f32, face.h as f32)),
+        _ => None,
+    });
+    assert!(found.is_some(), "{platform:?} drew no lid at {dt}s");
+    found
+}
+
+#[test]
+fn the_picker_lid_keeps_the_face_shape_on_every_platform() {
+    for platform in [Platform::Gba, Platform::Nes, Platform::Snes] {
+        for dt in [0.05, 0.12, 0.2, 0.5] {
+            let Some((_, _, w, h, fw, fh)) = lid_drawn(platform, dt) else {
+                eprintln!("no GL on this host, skipping");
+                return;
+            };
+            let (drawn, face) = (w / h, fw / fh);
+            assert!(
+                (drawn / face - 1.0).abs() < 0.06,
+                "{platform:?} lid at {dt}s is {drawn:.3} but its face is {face:.3}"
+            );
+        }
+    }
+}
+
+#[test]
+fn the_seated_lid_sits_inside_the_lid_rest_for_every_platform() {
+    for platform in [Platform::Gba, Platform::Nes, Platform::Snes] {
+        let Some((x, y, w, h, _, _)) = lid_drawn(platform, 0.5) else {
+            eprintln!("no GL on this host, skipping");
+            return;
+        };
+        let (cx, cy) = (x + w / 2.0, y + h / 2.0);
+        assert!((cx - 360.0).abs() < 2.0, "{platform:?} lid centre x {cx}");
+        assert!((cy - 70.5).abs() < 2.0, "{platform:?} lid centre y {cy}");
+        assert!(w <= 150.0 && h <= 87.0, "{platform:?} lid is {w}x{h}");
+    }
+}
