diff --git a/crates/slot-ui/tests/vb_cart.rs b/crates/slot-ui/tests/vb_cart.rs
new file mode 100644
index 0000000..fd3b31f
--- /dev/null
+++ b/crates/slot-ui/tests/vb_cart.rs
@@ -0,0 +1,119 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Outline, Platform, ShellChoice, ShellFinish};
+use slot_ui::{
+    cart_box, label_cover, retro_cart_face, retro_label_rect, retro_shell_of, seated_box,
+    shell_for, RetroShell, VB_GREY,
+};
+
+const RED: [u8; 3] = [230, 30, 30];
+
+fn rom(name: &str) -> PathBuf {
+    let p = std::env::temp_dir().join(format!("slot-vb-cart-{}-{name}", std::process::id()));
+    let bytes = vec![0u8; 0x400];
+    std::fs::write(&p, bytes).expect("write rom");
+    p
+}
+
+fn cart(rom: PathBuf, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform: Platform::Vb,
+        stem: "Virtual Boy Wario Land (Japan, USA)".into(),
+        rom,
+        label,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+fn art(name: &str, w: u32, h: u32) -> PathBuf {
+    let px: Vec<u8> = (0..w * h)
+        .flat_map(|_| [RED[0], RED[1], RED[2], 255])
+        .collect();
+    let p = std::env::temp_dir().join(format!("slot-vb-art-{}-{name}.png", std::process::id()));
+    let mut e = png::Encoder::new(std::fs::File::create(&p).expect("create art"), w, h);
+    e.set_color(png::ColorType::Rgba);
+    e.set_depth(png::BitDepth::Eight);
+    e.write_header()
+        .expect("png header")
+        .write_image_data(&px)
+        .expect("png data");
+    p
+}
+
+fn near(p: &[u8], c: [u8; 3]) -> bool {
+    (0..3).all(|i| p[i].abs_diff(c[i]) < 16)
+}
+
+#[test]
+fn every_virtual_boy_cart_takes_the_one_virtual_boy_shell_in_grey_whatever_its_region() {
+    for name in [
+        "Virtual Boy Wario Land (Japan, USA).vb",
+        "Innsmouth no Yakata (Japan).vb",
+        "Jack Bros. (USA).vboy",
+    ] {
+        let c = cart(rom(name), None);
+        assert_eq!(retro_shell_of(&c), Some(RetroShell::Vb), "{name}");
+        assert_eq!(shell_for(&c), VB_GREY, "{name}");
+    }
+    assert_eq!(RetroShell::Vb.name(), "vb");
+}
+
+#[test]
+fn a_chosen_shell_colour_still_wins_over_the_virtual_boy_grey() {
+    let mut c = cart(rom("chosen.vb"), None);
+    c.shell = Some(ShellChoice {
+        outline: Outline::Auto,
+        colour: [0x10, 0x20, 0x30],
+        finish: ShellFinish::Solid,
+    });
+    assert_eq!(retro_shell_of(&c), Some(RetroShell::Vb));
+    assert_eq!(shell_for(&c).colour, [0x10, 0x20, 0x30]);
+}
+
+#[test]
+fn the_virtual_boy_cart_keeps_the_real_cart_proportions_with_its_dust_cap() {
+    assert_eq!(seated_box(Platform::Vb), (240, 234));
+    assert_eq!(cart_box(Platform::Vb), (360, 351));
+    let (x, y, w, h) = retro_label_rect(RetroShell::Vb);
+    let px = |f: f32, of: f32| (f * of).round() as u32;
+    assert_eq!(
+        (px(x, 360.0), px(y, 351.0), px(w, 360.0), px(h, 351.0)),
+        (57, 28, 246, 211)
+    );
+}
+
+#[test]
+fn the_virtual_boy_cart_renders_grey_with_a_darker_dust_cap_and_no_label() {
+    let face = retro_cart_face(&cart(rom("bare.vb"), None), RetroShell::Vb);
+    assert_eq!((face.w, face.h), (360, 351));
+    let at = |x: u32, y: u32| &face.rgba[((y * 360 + x) * 4) as usize..][..4];
+    assert_eq!(at(0, 0)[3], 0, "the top corner is rounded off");
+    let body = at(30, 290);
+    let cap = at(30, 340);
+    assert_eq!((body[3], cap[3]), (255, 255));
+    assert!(
+        near(body, [0x9f, 0x9c, 0xa2]),
+        "the plastic is grey: {body:?}"
+    );
+    assert!(
+        (0..3).all(|i| cap[i] + 40 < body[i]),
+        "the dust cap is darker: {cap:?} against {body:?}"
+    );
+}
+
+#[test]
+fn the_virtual_boy_cart_renders_its_label_art_inside_the_well() {
+    let red = art("label", 492, 422);
+    let c = cart(rom("label.vb"), Some(red.clone()));
+    let (_, _, lw, lh) = retro_label_rect(RetroShell::Vb);
+    let (lw, lh) = ((lw * 360.0).round() as u32, (lh * 351.0).round() as u32);
+    assert!(label_cover(&c, &red, lw, lh).is_some());
+    let face = retro_cart_face(&c, RetroShell::Vb);
+    let red_at = |x: u32, y: u32| near(&face.rgba[((y * 360 + x) * 4) as usize..], RED);
+    assert!(red_at(180, 130), "the middle of the well is the label");
+    assert!(!red_at(180, 12), "the top is plastic");
+    assert!(!red_at(20, 130), "the side is plastic");
+    assert!(!red_at(180, 300), "below the well is plastic");
+}
