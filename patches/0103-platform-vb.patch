diff --git a/crates/slot/tests/vb_seat.rs b/crates/slot/tests/vb_seat.rs
new file mode 100644
index 0000000..ebdb1af
--- /dev/null
+++ b/crates/slot/tests/vb_seat.rs
@@ -0,0 +1,26 @@
+mod common;
+mod core_common;
+mod real_seat;
+mod vb_common;
+
+use common::core_lock;
+use slot_store::{Core, Platform};
+use vb_common::{beetle_vb, cart, lit_columns, LEFT_BAND};
+
+#[test]
+fn a_virtual_boy_cart_seats_on_beetle_vb_through_a_real_session_and_shows_one_eye() {
+    let _g = core_lock();
+    let Some(dylib) = beetle_vb() else {
+        return;
+    };
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = cart(carts.path(), "Eyes");
+    let root = real_seat::rooted(Platform::Vb, "Eyes", &rom, &dylib);
+    let session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::MednafenVb);
+    assert_eq!(session.app().playing_platform(), Platform::Vb);
+    let emu = session.emu().expect("no core in the slot");
+    let frame = emu.latest_frame().expect("nothing was published");
+    assert_eq!(frame.len(), 384 * 256 * 4);
+    assert_eq!(lit_columns(&frame), LEFT_BAND.collect::<Vec<_>>());
+}
