new file mode 100644
index 0000000..41cd257
--- /dev/null
+++ b/crates/slot-store/tests/vb_platform.rs
@@ -0,0 +1,143 @@
+mod common;
+
+use std::path::{Path, PathBuf};
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Cart, Core,
+    Platform, RetroShader, SegaShaders, Shader, SlotState, VB_SHADER_FILE,
+};
+
+fn put(root: &Path, name: &str, bytes: &[u8]) -> PathBuf {
+    let dir = root.join("Games/VB");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let p = dir.join(name);
+    std::fs::write(&p, bytes).expect("write");
+    p
+}
+
+fn vb(root: &Path) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == Platform::Vb)
+        .collect()
+}
+
+#[test]
+fn the_virtual_boy_is_the_last_shelf_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES.last(), Some(&Platform::Vb));
+    assert_eq!(Platform::SHELVES.len(), 17);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::Vb.dir_name(), "VB");
+    assert_eq!(Platform::Vb.name(), "Nintendo Virtual Boy");
+}
+
+#[test]
+fn a_vb_or_vboy_file_lands_on_the_virtual_boy_shelf_with_its_stem_as_title() {
+    let d = tmp_root();
+    put(
+        d.path(),
+        "Virtual Boy Wario Land (Japan, USA).vb",
+        &[0; 0x400],
+    );
+    put(d.path(), "Jack Bros. (USA).VBOY", &[0; 0x400]);
+    put(d.path(), "._Red Alarm (USA).vb", &[0; 0x400]);
+    put(d.path(), "Notes.txt", b"");
+    let mut carts = vb(d.path());
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(
+        stems,
+        ["Jack Bros. (USA)", "Virtual Boy Wario Land (Japan, USA)"]
+    );
+    for c in &mut carts {
+        c.read_header();
+        assert!(c.title.is_empty(), "{} took a header title", c.stem);
+    }
+}
+
+#[test]
+fn the_virtual_boy_plays_like_the_snes_with_the_picture_toggle_and_answers_every_policy() {
+    let p = Platform::Vb;
+    assert!(!p.owns_shoulders());
+    assert!(p.owns_triggers());
+    assert!(p.passes_xy_through());
+    assert!(p.select_x_toggles_picture());
+    assert!(p.stretch_crops_height());
+    assert_eq!(p.overscan(), (0, 0));
+    assert!(!p.follows_frame_width());
+    assert!(!p.has_gb_palettes());
+    assert!(p.rewinds());
+    assert!(!p.fills_canvas());
+    assert!(!p.swaps_discs());
+    assert_eq!(p.actual_scale(), None);
+    assert!(!p.flashes_on_unload());
+    assert_eq!(p.picker_cores(), None);
+    assert_eq!(p.picture(), (384, 224));
+    assert_eq!(p.shader_choices(), &Shader::RETRO);
+    assert_eq!(p.extensions(), ["vb", "vboy"]);
+}
+
+#[test]
+fn the_virtual_boy_runs_on_beetle_vb_alone_on_a_three_by_two_canvas_one_frame_wide() {
+    assert_eq!(Core::default_for(Platform::Vb), Core::MednafenVb);
+    assert_eq!(Core::EVERY.last(), Some(&Core::MednafenVb));
+    assert_eq!(Core::MednafenVb.as_str(), "mednafen_vb");
+    assert_eq!(Core::MednafenVb.option_prefix(), "vb");
+    assert_eq!(Core::parse("mednafen_vb"), Some(Core::MednafenVb));
+    assert_eq!(Core::MednafenVb.text(), "Beetle VB");
+    assert_eq!(Core::MednafenVb.canvas(Platform::Vb), (384, 256));
+    assert_eq!(384 * 2, 256 * 3);
+    assert_eq!(
+        Core::MednafenVb.pair(),
+        (Core::MednafenVb, Core::MednafenVb)
+    );
+    assert!(Core::MednafenVb.reports_its_frame_rate());
+    assert!(!Core::MednafenVb.has_colour_correction());
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Vb),
+            core == Core::MednafenVb,
+            "{core:?}"
+        );
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::MednafenVb.runs(platform),
+            platform == Platform::Vb,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn a_virtual_boy_game_resumes_as_a_virtual_boy_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Virtual Boy Wario Land (Japan, USA)".into()),
+        cart_platform: Some(Platform::Vb),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=vb"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn the_virtual_boy_shader_lives_in_its_own_file_and_leaves_the_others_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        vb: Shader::Retro(RetroShader::Sharp),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(VB_SHADER_FILE)).expect("read"),
+        "vb=sharp\n"
+    );
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    assert!(!d.path().join("Config/s32x_shader.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+}
