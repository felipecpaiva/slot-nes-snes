@@ -0,0 +1,89 @@
+use std::path::PathBuf;
+
+use slot_store::{Cart, Platform};
+use slot_ui::{
+    cart_box, cart_interior, cd_case, disc_art_path, retro_shell_of, seated_box, shows_interior,
+    Ps1Case, RetroShell, DISC_PX,
+};
+
+fn disc(stem: &str, label: Option<PathBuf>) -> Cart {
+    Cart {
+        platform: Platform::Pcecd,
+        stem: stem.into(),
+        rom: format!("/card/Games/PCECD/{stem}.chd").into(),
+        label,
+        title: String::new(),
+        code: String::new(),
+        shell: None,
+    }
+}
+
+#[test]
+fn a_pc_engine_cd_sits_in_the_playstations_jewel_case_box() {
+    assert_eq!(cart_box(Platform::Pcecd), cart_box(Platform::Ps1));
+    assert_eq!(seated_box(Platform::Pcecd), seated_box(Platform::Ps1));
+}
+
+#[test]
+fn a_japanese_disc_wears_the_spine_strip_and_a_us_disc_the_plain_case() {
+    for (stem, want) in [
+        ("Akumajou Dracula X - Chi no Rondo (Japan)", Ps1Case::Jp),
+        ("Ys IV - The Dawn of Ys (Japan) (En)", Ps1Case::Jp),
+        ("Ys Book I & II (USA)", Ps1Case::Us),
+        ("Homebrew Demo", Ps1Case::Us),
+    ] {
+        assert_eq!(cd_case(stem), want, "{stem}");
+        assert_eq!(
+            retro_shell_of(&disc(stem, None)),
+            Some(RetroShell::Ps1(want)),
+            "{stem}"
+        );
+    }
+}
+
+#[test]
+fn a_cd_never_reads_a_playstation_serial_or_turns_into_a_double_case() {
+    let d = tempfile::tempdir().unwrap();
+    let m3u = d.path().join("Two (USA).m3u");
+    std::fs::write(&m3u, "a.cue\nb.cue\n").unwrap();
+    let cart = Cart {
+        rom: m3u,
+        ..disc("Two (USA)", None)
+    };
+    assert_eq!(retro_shell_of(&cart), Some(RetroShell::Ps1(Ps1Case::Us)));
+}
+
+#[test]
+fn the_disc_comes_out_of_the_case_with_its_scan_in_the_cd_disc_folder() {
+    let cart = disc("Gate of Thunder (Japan)", None);
+    assert!(shows_interior(&cart));
+    let face = cart_interior(&cart);
+    assert_eq!((face.w, face.h), (DISC_PX, DISC_PX));
+    assert_eq!(
+        disc_art_path(&cart),
+        Some(PathBuf::from(
+            "/card/Labels/PCECD/disc/Gate of Thunder (Japan).png"
+        ))
+    );
+    let labelled = disc(
+        "Lords of Thunder (USA)",
+        Some("/card/Labels/PCECD/Lords of Thunder (USA).png".into()),
+    );
+    assert_eq!(
+        disc_art_path(&labelled),
+        Some(PathBuf::from(
+            "/card/Labels/PCECD/disc/Lords of Thunder (USA).png"
+        ))
+    );
+}
+
+#[test]
+fn a_turbografx_hucard_still_carries_no_disc() {
+    let card = Cart {
+        platform: Platform::Tg16,
+        rom: "/card/Games/TG16/Bonk.pce".into(),
+        ..disc("Bonk", None)
+    };
+    assert!(!shows_interior(&card));
+    assert_eq!(retro_shell_of(&card), Some(RetroShell::Hucard));
+}
