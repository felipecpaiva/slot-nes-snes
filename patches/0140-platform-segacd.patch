diff --git a/crates/slot-store/tests/segacd_platform.rs b/crates/slot-store/tests/segacd_platform.rs
new file mode 100644
index 0000000..df1dd03
--- /dev/null
+++ b/crates/slot-store/tests/segacd_platform.rs
@@ -0,0 +1,146 @@
+mod common;
+
+use std::path::{Path, PathBuf};
+
+use common::tmp_root;
+use slot_store::{
+    read_sega_shaders, read_slot_state, scan, write_sega_shaders, write_slot_state, Cart, Core,
+    Platform, RetroShader, SegaShaders, Shader, SlotState, SEGACD_SHADER_FILE,
+};
+
+fn put(root: &Path, dir: &str, name: &str) -> PathBuf {
+    let dir = root.join(dir);
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let p = dir.join(name);
+    std::fs::write(&p, [0u8; 16]).expect("write");
+    p
+}
+
+fn on(root: &Path, platform: Platform) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == platform)
+        .collect()
+}
+
+#[test]
+fn sega_cd_follows_the_pc_engine_cd_and_upstreams_list_stays_three() {
+    let last = Platform::SHELVES.len() - 1;
+    assert_eq!(Platform::SHELVES[last], Platform::SegaCd);
+    assert_eq!(Platform::SHELVES[last - 1], Platform::Pcecd);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::SegaCd.dir_name(), "SEGACD");
+    assert_eq!(Platform::SegaCd.name(), "Sega CD");
+}
+
+#[test]
+fn chd_cue_iso_and_m3u_land_on_the_sega_cd_shelf_and_a_bin_track_never_does() {
+    let d = tmp_root();
+    put(d.path(), "Games/SEGACD", "Sonic CD (USA).chd");
+    put(d.path(), "Games/SEGACD", "Snatcher (USA).cue");
+    put(d.path(), "Games/SEGACD", "Snatcher (USA) (Track 01).bin");
+    put(d.path(), "Games/SEGACD", "Popful Mail (USA).ISO");
+    put(d.path(), "Games/SEGACD", "._Vay (USA).chd");
+    put(d.path(), "Games/SEGACD", "Sonic the Hedgehog (USA).md");
+    put(d.path(), "Games/MD", "Lunar - The Silver Star (USA).cue");
+    let mut carts = on(d.path(), Platform::SegaCd);
+    let stems: Vec<&str> = carts.iter().map(|c| c.stem.as_str()).collect();
+    assert_eq!(
+        stems,
+        ["Popful Mail (USA)", "Snatcher (USA)", "Sonic CD (USA)"]
+    );
+    for c in &mut carts {
+        c.read_header();
+        assert!(c.title.is_empty(), "{} took a header title", c.stem);
+    }
+    assert!(on(d.path(), Platform::Md).is_empty());
+}
+
+#[test]
+fn a_disc_of_a_set_takes_the_title_without_its_disc_tag() {
+    let d = tmp_root();
+    put(d.path(), "Games/SEGACD", "Night Trap (USA) (Disc 1).chd");
+    let mut carts = on(d.path(), Platform::SegaCd);
+    let cart = carts.first_mut().expect("one disc");
+    cart.read_header();
+    assert_eq!(cart.title, "Night Trap (USA)");
+}
+
+#[test]
+fn sega_cd_plays_like_the_mega_drive_and_answers_every_policy() {
+    let p = Platform::SegaCd;
+    assert!(!p.owns_shoulders());
+    assert!(p.owns_triggers());
+    assert!(p.passes_xy_through());
+    assert!(!p.turbo_on_xy());
+    assert!(p.select_x_toggles_picture());
+    assert_eq!(
+        p.stretch_crops_height(),
+        Platform::Md.stretch_crops_height()
+    );
+    assert_eq!(p.overscan(), Platform::Md.overscan());
+    assert!(p.follows_frame_width());
+    assert!(!p.has_gb_palettes());
+    assert!(p.rewinds());
+    assert!(!p.fills_canvas());
+    assert!(!p.swaps_discs());
+    assert_eq!(p.actual_scale(), None);
+    assert!(!p.flashes_on_unload());
+    assert!(!p.is_arcade());
+    assert_eq!(p.picker_cores(), None);
+    assert_eq!(p.picture(), (320, 224));
+    assert_eq!(p.shader_choices(), Platform::Md.shader_choices());
+    assert_eq!(p.extensions(), ["chd", "cue", "m3u", "iso"]);
+}
+
+#[test]
+fn sega_cd_runs_on_genesis_plus_gx_alone_on_the_mega_drive_canvas() {
+    assert_eq!(Core::default_for(Platform::SegaCd), Core::GenesisPlusGx);
+    assert_eq!(
+        Core::GenesisPlusGx.canvas(Platform::SegaCd),
+        Core::GenesisPlusGx.canvas(Platform::Md)
+    );
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::SegaCd),
+            core == Core::GenesisPlusGx,
+            "{core:?}"
+        );
+    }
+}
+
+#[test]
+fn a_sega_cd_game_resumes_as_a_sega_cd_game() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Lunar - The Silver Star (USA)".into()),
+        cart_platform: Some(Platform::SegaCd),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(
+        text.lines().any(|l| l == "cart_platform=segacd"),
+        "{text:?}"
+    );
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn the_sega_cd_shader_lives_in_its_own_file_and_leaves_the_mega_drive_alone() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        segacd: Shader::Retro(RetroShader::CrtPi),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(SEGACD_SHADER_FILE)).expect("read"),
+        "segacd=crt-pi\n"
+    );
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+    assert_eq!(read_sega_shaders(d.path()).md, Shader::Off);
+}
