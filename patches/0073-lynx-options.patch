From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paiva <felipe.paiva@gmail.com>
Date: Mon, 19 Oct 2026 10:56:48 +0400
Subject: [PATCH] lynx-options

slot answers Beetle Lynx's three options itself and never leaves one to
the core's declared default: lynx_rot_screen 0 (the declared auto turns
the pad 90 or 270 for a turned cart and asks the frontend to rotate;
manual would give SELECT to the core), lynx_force_60hz disabled (it
changes only the reported fps, the game's rate is its own) and
lynx_pix_format 16 (RGB565, which the canvas copy converts).
---
 crates/slot/src/core_options_policy.rs | 10 +++-
 crates/slot/tests/lynx_options.rs      | 73 ++++++++++++++++++++++++++
 2 files changed, 81 insertions(+), 2 deletions(-)
 create mode 100644 crates/slot/tests/lynx_options.rs

diff --git a/crates/slot/src/core_options_policy.rs b/crates/slot/src/core_options_policy.rs
index 6f00a70..5640294 100644
--- a/crates/slot/src/core_options_policy.rs
+++ b/crates/slot/src/core_options_policy.rs
@@ -59,6 +59,12 @@ const MEDNAFEN_WSWAN: [(&str, &str); 11] = [
     ("wswan_blood", "o"),
 ];
 
+pub const BEETLE_LYNX: [(&str, &str); 3] = [
+    ("lynx_rot_screen", "0"),
+    ("lynx_force_60hz", "disabled"),
+    ("lynx_pix_format", "16"),
+];
+
 pub fn answers_declared_defaults(which: Core) -> bool {
     match which {
         Core::PcsxRearmed => true,
@@ -123,11 +129,11 @@ pub fn apply_policy_options(core: &mut LibretroCore, which: Core) {
         | Core::Fceumm
         | Core::Snes9x
         | Core::Nestopia
-        | Core::Snes9x2005Plus
-        | Core::MednafenLynx => &[],
+        | Core::Snes9x2005Plus => &[],
         Core::PcsxRearmed => &PCSX_REARMED,
         Core::MednafenPceFast => &PCE_FAST,
         Core::MednafenWswan => &MEDNAFEN_WSWAN,
+        Core::MednafenLynx => &BEETLE_LYNX,
     };
     for (key, value) in fixed {
         core.set_option(key, value);
diff --git a/crates/slot/tests/lynx_options.rs b/crates/slot/tests/lynx_options.rs
new file mode 100644
index 0000000..89d5a55
--- /dev/null
+++ b/crates/slot/tests/lynx_options.rs
@@ -0,0 +1,73 @@
+mod common;
+mod core_common;
+
+use std::path::Path;
+
+use common::core_lock;
+use core_common::require_core;
+use slot::core::apply_core_options;
+use slot::core_options_policy::{answers_declared_defaults, BEETLE_LYNX};
+use slot_retro::LibretroCore;
+use slot_store::{Core, Platform};
+
+const DECLARED: [(&str, &[&str]); 3] = [
+    ("lynx_force_60hz", &["disabled", "enabled"]),
+    ("lynx_pix_format", &["16", "32"]),
+    (
+        "lynx_rot_screen",
+        &["auto", "manual", "0", "90", "180", "270"],
+    ),
+];
+
+fn beetle(dylib: &Path) -> LibretroCore {
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = LibretroCore::open_with(dylib, d.path(), d.path()).expect("open Beetle Lynx");
+    apply_core_options(
+        &mut core,
+        Core::MednafenLynx,
+        Platform::Lynx,
+        "",
+        false,
+        false,
+        None,
+    );
+    core
+}
+
+#[test]
+fn the_pinned_core_declares_exactly_the_three_lynx_options() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("mednafen_lynx") else {
+        return;
+    };
+    let core = beetle(&dylib);
+    let mut declared: Vec<(String, Vec<String>)> = core
+        .declared_options()
+        .iter()
+        .map(|(k, v)| (k.clone(), v.clone()))
+        .collect();
+    declared.sort();
+    let want: Vec<(String, Vec<String>)> = DECLARED
+        .iter()
+        .map(|(k, v)| (k.to_string(), v.iter().map(|s| s.to_string()).collect()))
+        .collect();
+    assert_eq!(declared, want);
+}
+
+#[test]
+fn slot_answers_every_lynx_option_itself_with_a_declared_value() {
+    let _g = core_lock();
+    let Some(dylib) = require_core("mednafen_lynx") else {
+        return;
+    };
+    let core = beetle(&dylib);
+    assert!(!answers_declared_defaults(Core::MednafenLynx));
+    for (key, value) in BEETLE_LYNX {
+        assert_eq!(core.option(key).as_deref(), Some(value), "{key}");
+        let values = &core.declared_options()[key];
+        assert!(values.iter().any(|v| v == value), "{key}={value}");
+    }
+    assert_eq!(core.option("lynx_rot_screen").as_deref(), Some("0"));
+    assert_eq!(core.option("lynx_force_60hz").as_deref(), Some("disabled"));
+    assert_eq!(core.option("lynx_pix_format").as_deref(), Some("16"));
+}
