diff --git a/crates/slot/src/input/sticks.rs b/crates/slot/src/input/sticks.rs
new file mode 100644
index 0000000..bf4efd4
--- /dev/null
+++ b/crates/slot/src/input/sticks.rs
@@ -0,0 +1,261 @@
+use std::path::{Path, PathBuf};
+
+use super::evdev::{Ev, EV_ABS};
+
+pub const STICKS_FILE: &str = "sticks.txt";
+
+const KEYS: [&str; 4] = ["left_x", "left_y", "right_x", "right_y"];
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub struct Axis {
+    pub code: u16,
+    pub inverted: bool,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+pub struct StickMap {
+    pub axes: [Axis; 4],
+    pub deadzone: i32,
+    pub range: i32,
+}
+
+impl Default for StickMap {
+    fn default() -> Self {
+        let axis = |code| Axis {
+            code,
+            inverted: false,
+        };
+        StickMap {
+            axes: [axis(0x02), axis(0x03), axis(0x04), axis(0x05)],
+            deadzone: 32,
+            range: 4096,
+        }
+    }
+}
+
+pub fn sticks_file(root: &Path) -> PathBuf {
+    root.join("Config").join(STICKS_FILE)
+}
+
+pub fn read_stick_map(root: &Path) -> StickMap {
+    let path = sticks_file(root);
+    match std::fs::read_to_string(&path) {
+        Ok(text) => {
+            let map = parse_stick_map(&text);
+            eprintln!("slot: sticks: {}: {map:?}", path.display());
+            map
+        }
+        Err(_) => StickMap::default(),
+    }
+}
+
+pub fn parse_stick_map(text: &str) -> StickMap {
+    let mut map = StickMap::default();
+    for line in text.lines().map(str::trim).filter(|l| !l.is_empty()) {
+        let Some((key, value)) = line.split_once('=') else {
+            eprintln!("slot: sticks: ignoring {line:?}");
+            continue;
+        };
+        let (key, value) = (key.trim(), value.trim());
+        let known = match KEYS.iter().position(|k| *k == key) {
+            Some(i) => parse_axis(value).map(|axis| map.axes[i] = axis),
+            None if key == "deadzone" => parse_number(value)
+                .filter(|v| (0..4096).contains(v))
+                .map(|v| map.deadzone = v),
+            None if key == "range" => parse_number(value)
+                .filter(|v| (1..=65535).contains(v))
+                .map(|v| map.range = v),
+            None => None,
+        };
+        if known.is_none() {
+            eprintln!("slot: sticks: ignoring {line:?}");
+        }
+    }
+    if map.deadzone >= map.range {
+        eprintln!(
+            "slot: sticks: deadzone {} is not below range {}, using the defaults",
+            map.deadzone, map.range
+        );
+        let d = StickMap::default();
+        map.deadzone = d.deadzone;
+        map.range = d.range;
+    }
+    map
+}
+
+fn parse_axis(value: &str) -> Option<Axis> {
+    let (inverted, code) = match value.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, value),
+    };
+    let code = u16::try_from(parse_number(code)?).ok()?;
+    Some(Axis { code, inverted })
+}
+
+fn parse_number(value: &str) -> Option<i32> {
+    match value.strip_prefix("0x") {
+        Some(hex) => i32::from_str_radix(hex, 16).ok(),
+        None => value.parse().ok(),
+    }
+}
+
+pub fn scale(value: i32, deadzone: i32, range: i32) -> i16 {
+    let magnitude = value.unsigned_abs().min(range as u32) as i64;
+    let deadzone = i64::from(deadzone);
+    if magnitude <= deadzone {
+        return 0;
+    }
+    let out = (magnitude - deadzone) * 32767 / (i64::from(range) - deadzone);
+    (out * i64::from(value.signum())) as i16
+}
+
+pub struct Sticks {
+    map: StickMap,
+    axes: [i16; 4],
+}
+
+impl Sticks {
+    pub fn new(map: StickMap) -> Self {
+        Sticks { map, axes: [0; 4] }
+    }
+
+    pub fn feed(&mut self, ev: Ev) -> Option<[i16; 4]> {
+        if ev.kind != EV_ABS {
+            return None;
+        }
+        let i = self.map.axes.iter().position(|a| a.code == ev.code)?;
+        let axis = self.map.axes.get(i)?;
+        let value = if axis.inverted { -ev.value } else { ev.value };
+        let now = scale(value, self.map.deadzone, self.map.range);
+        let slot = self.axes.get_mut(i)?;
+        if *slot == now {
+            return None;
+        }
+        *slot = now;
+        Some(self.axes)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn abs(code: u16, value: i32) -> Ev {
+        Ev {
+            kind: EV_ABS,
+            code,
+            value,
+        }
+    }
+
+    #[test]
+    fn a_value_inside_the_deadzone_reads_as_centre() {
+        for v in [-32, -1, 0, 1, 32] {
+            assert_eq!(scale(v, 32, 4096), 0, "{v}");
+        }
+    }
+
+    #[test]
+    fn full_travel_reaches_the_libretro_limits_and_never_passes_them() {
+        assert_eq!(scale(4096, 32, 4096), 32767);
+        assert_eq!(scale(-4096, 32, 4096), -32767);
+        assert_eq!(scale(9000, 32, 4096), 32767);
+        assert_eq!(scale(i32::MIN, 32, 4096), -32767);
+        assert_eq!(scale(i32::MAX, 32, 4096), 32767);
+    }
+
+    #[test]
+    fn travel_past_the_deadzone_starts_from_zero_and_grows_evenly() {
+        assert_eq!(scale(33, 32, 4096), 8);
+        assert_eq!(scale(2064, 32, 4096), 16383);
+        assert_eq!(scale(-2064, 32, 4096), -16383);
+        let mut last = 0;
+        for v in 33..=4096 {
+            let now = scale(v, 32, 4096);
+            assert!(now >= last, "{v}");
+            last = now;
+        }
+    }
+
+    #[test]
+    fn no_file_gives_z_and_rx_for_the_left_stick_and_ry_and_rz_for_the_right() {
+        let root = tempfile::tempdir().expect("tempdir");
+        let map = read_stick_map(root.path());
+        assert_eq!(map, StickMap::default());
+        let codes: Vec<u16> = map.axes.iter().map(|a| a.code).collect();
+        assert_eq!(codes, [0x02, 0x03, 0x04, 0x05]);
+        assert!(map.axes.iter().all(|a| !a.inverted));
+        assert_eq!((map.deadzone, map.range), (32, 4096));
+    }
+
+    #[test]
+    fn the_file_names_each_axis_and_a_leading_minus_inverts_it() {
+        let map = parse_stick_map(
+            "left_x=0x03\nleft_y=-0x04\n right_x = 2 \nright_y=-5\ndeadzone=100\nrange=4000\n",
+        );
+        let axes: Vec<(u16, bool)> = map.axes.iter().map(|a| (a.code, a.inverted)).collect();
+        assert_eq!(axes, [(3, false), (4, true), (2, false), (5, true)]);
+        assert_eq!((map.deadzone, map.range), (100, 4000));
+    }
+
+    #[test]
+    fn a_bad_line_keeps_the_default_for_that_line_only() {
+        let map = parse_stick_map("left_x=banana\nnonsense\nup=3\nrange=0\nright_y=0x10\n");
+        let d = StickMap::default();
+        assert_eq!(map.axes[0], d.axes[0]);
+        assert_eq!(map.range, d.range);
+        assert_eq!(map.axes[3].code, 0x10);
+    }
+
+    #[test]
+    fn a_deadzone_at_or_past_the_range_falls_back_to_both_defaults() {
+        let map = parse_stick_map("deadzone=500\nrange=400\n");
+        assert_eq!((map.deadzone, map.range), (32, 4096));
+    }
+
+    #[test]
+    fn each_mapped_axis_lands_in_its_own_slot() {
+        let mut sticks = Sticks::new(StickMap::default());
+        assert_eq!(sticks.feed(abs(0x02, 4096)), Some([32767, 0, 0, 0]));
+        assert_eq!(sticks.feed(abs(0x03, -4096)), Some([32767, -32767, 0, 0]));
+        assert_eq!(
+            sticks.feed(abs(0x04, 4096)),
+            Some([32767, -32767, 32767, 0])
+        );
+        assert_eq!(
+            sticks.feed(abs(0x05, -4096)),
+            Some([32767, -32767, 32767, -32767])
+        );
+    }
+
+    #[test]
+    fn an_inverted_axis_flips_its_sign() {
+        let mut sticks = Sticks::new(parse_stick_map("left_y=-0x03"));
+        assert_eq!(sticks.feed(abs(0x03, 4096)), Some([0, -32767, 0, 0]));
+    }
+
+    #[test]
+    fn the_hat_keys_and_unmapped_axes_never_move_a_stick() {
+        let mut sticks = Sticks::new(StickMap::default());
+        for ev in [
+            abs(0x10, 1),
+            abs(0x11, -1),
+            abs(0x00, 4096),
+            Ev {
+                kind: 0x01,
+                code: 0x02,
+                value: 1,
+            },
+        ] {
+            assert_eq!(sticks.feed(ev), None, "{ev:?}");
+        }
+    }
+
+    #[test]
+    fn jitter_inside_the_deadzone_publishes_nothing() {
+        let mut sticks = Sticks::new(StickMap::default());
+        for v in [5, -12, 32, 0, -32] {
+            assert_eq!(sticks.feed(abs(0x02, v)), None, "{v}");
+        }
+    }
+}
diff --git a/crates/slot/tests/ps1_analog.rs b/crates/slot/tests/ps1_analog.rs
new file mode 100644
index 0000000..735948c
--- /dev/null
+++ b/crates/slot/tests/ps1_analog.rs
@@ -0,0 +1,118 @@
+mod common;
+mod core_common;
+mod ps1_common;
+
+use std::path::Path;
+
+use common::core_lock;
+use ps1_common::{disc, pcsx_rearmed, red};
+use slot::core::{apply_core_options, open_core_for_palette};
+use slot::core_options_policy::analog_pad;
+use slot_retro::{ButtonMask, LibretroCore, RetroCore, DUALSHOCK};
+use slot_store::{Core, Platform};
+
+fn run_after_load(core: &mut dyn RetroCore, cue: &Path) {
+    core.load(cue).expect("load");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+}
+
+fn pcsx_on_a_disc(dylib: &Path, slot_options: bool) -> LibretroCore {
+    let d = common::tmp_root_with_real_carts(&[]);
+    let cue = disc(&d.path().join("Games/PS1"), "Ape");
+    let mut core = LibretroCore::open_with(dylib, d.path(), d.path()).expect("open pcsx");
+    if slot_options {
+        apply_core_options(
+            &mut core,
+            Core::PcsxRearmed,
+            Platform::Ps1,
+            "auto",
+            false,
+            false,
+            None,
+        );
+    }
+    run_after_load(&mut core, &cue);
+    core
+}
+
+#[test]
+fn only_pcsx_gets_an_analog_pad_and_it_is_the_dualshock() {
+    for which in Core::EVERY {
+        let want = (which == Core::PcsxRearmed).then_some(DUALSHOCK);
+        assert_eq!(analog_pad(which), want, "{which:?}");
+    }
+}
+
+#[test]
+fn pcsx_asks_for_the_sticks_once_slot_plugs_the_dualshock() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    assert!(pcsx_on_a_disc(&dylib, true).asked_for_analog());
+}
+
+#[test]
+fn pcsx_on_its_standard_pad_never_asks_for_the_sticks() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    assert!(!pcsx_on_a_disc(&dylib, false).asked_for_analog());
+}
+
+#[test]
+fn a_ps1_game_still_boots_and_draws_with_the_dualshock_plugged() {
+    let _g = core_lock();
+    let Some(dylib) = pcsx_rearmed() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let cue = disc(&d.path().join("Games/PS1"), "Ape");
+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::PcsxRearmed,
+        Platform::Ps1,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    run_after_load(core.as_mut(), &cue);
+    assert_eq!(red(core.video_xrgb8888()), 640 * 480);
+}
+
+fn gba_frames_with_sticks(which: Core, dylib: &Path, sticks: [i16; 4]) -> (Vec<u8>, Vec<u8>) {
+    let d = common::tmp_root_with_real_carts(&[]);
+    let rom = d.path().join("Games/GBA/Sticks.gba");
+    std::fs::write(&rom, common::gba_rom()).expect("write rom");
+    let mut core = LibretroCore::open_with(dylib, d.path(), d.path()).expect("open");
+    apply_core_options(&mut core, which, Platform::Gba, "auto", false, false, None);
+    slot_retro::publish_sticks(sticks);
+    core.load(&rom).expect("load");
+    for _ in 0..60 {
+        core.run_frame(ButtonMask::default());
+    }
+    slot_retro::publish_sticks([0; 4]);
+    let state = core.serialize().expect("serialize");
+    (core.video_xrgb8888().to_vec(), state)
+}
+
+#[test]
+fn gba_cores_run_the_same_frames_whatever_the_sticks_say() {
+    let _g = core_lock();
+    for which in [Core::Mgba, Core::Gpsp] {
+        let Some(dylib) = core_common::require_core(which.as_str()) else {
+            continue;
+        };
+        let centred = gba_frames_with_sticks(which, &dylib, [0; 4]);
+        let pushed = gba_frames_with_sticks(which, &dylib, [32767, -32767, 32767, -32767]);
+        assert!(centred.0 == pushed.0, "{which:?} frame");
+        // gpsp saves its cart clock (wall time) in the state, so two runs a second apart differ there.
+        if which == Core::Mgba {
+            assert!(centred.1 == pushed.1, "{which:?} state");
+        }
+    }
+}
