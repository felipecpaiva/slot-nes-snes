+pub fn analog_pad(which: Core) -> Option<u32> {
+    match which {
+        Core::PcsxRearmed => Some(slot_retro::DUALSHOCK),
+        Core::Mgba
+        | Core::Gpsp
+        | Core::Fceumm
+        | Core::Snes9x
+        | Core::Nestopia
