index 0000000..17cb8d5
--- /dev/null
+++ b/crates/slot-retro/src/analog.rs
@@ -0,0 +1,65 @@
+use std::ffi::c_uint;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use crate::canvas::with_extra;
+
+pub const DEVICE_ANALOG: c_uint = 5;
+pub const DUALSHOCK: c_uint = (2 << 8) | DEVICE_ANALOG;
+
+static STICKS: AtomicU64 = AtomicU64::new(0);
+
+pub fn publish_sticks(axes: [i16; 4]) {
+    STICKS.store(pack(axes), Ordering::Relaxed);
+}
+
+pub fn published_sticks() -> [i16; 4] {
+    unpack(STICKS.load(Ordering::Relaxed))
+}
+
+fn pack(axes: [i16; 4]) -> u64 {
+    axes.iter()
+        .rev()
+        .fold(0, |acc, &v| (acc << 16) | u64::from(v as u16))
+}
+
+fn unpack(packed: u64) -> [i16; 4] {
+    std::array::from_fn(|i| (packed >> (16 * i)) as u16 as i16)
+}
+
+pub fn answer(port: c_uint, index: c_uint, id: c_uint) -> i16 {
+    with_extra(|e| {
+        e.asked_for_analog = true;
+        let axes = e.sticks.filter(|_| port == 0)?;
+        let axis = match (index, id) {
+            (0, 0) => 0,
+            (0, 1) => 1,
+            (1, 0) => 2,
+            (1, 1) => 3,
+            _ => return None,
+        };
+        axes.get(axis).copied()
+    })
+    .flatten()
+    .unwrap_or(0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_four_axes_unpack_as_they_were_packed() {
+        for axes in [
+            [0, 0, 0, 0],
+            [32767, -32767, 1, -1],
+            [-32768, 32767, -12345, 23456],
+        ] {
+            assert_eq!(unpack(pack(axes)), axes);
+        }
+    }
+
+    #[test]
+    fn the_dualshock_is_libretro_analog_subclass_one() {
+        assert_eq!(DUALSHOCK, 0x205);
+    }
+}
