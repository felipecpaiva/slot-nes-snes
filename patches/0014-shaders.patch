diff --git a/crates/slot/tests/nes_snes_shader.rs b/crates/slot/tests/nes_snes_shader.rs
new file mode 100644
index 0000000..af31e57
--- /dev/null
+++ b/crates/slot/tests/nes_snes_shader.rs
@@ -0,0 +1,57 @@
+mod common;
+mod input_common;
+
+use input_common::playing;
+use slot_input::{Btn, Millis, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{read_slot_state, Platform, Shader, SlotState};
+
+fn chord(session: &mut slot::session::Session, now: &mut Millis, b: Btn) -> u16 {
+    let mut ever = 0;
+    for ev in [
+        RawEvent::Down(Btn::Select),
+        RawEvent::Down(b),
+        RawEvent::Up(b),
+        RawEvent::Up(Btn::Select),
+    ] {
+        *now += 20;
+        session.feed([ev], *now);
+        ever |= session.emu().expect("core").input().0;
+    }
+    ever
+}
+
+fn cycle(platform: Platform, pick: fn(&SlotState) -> Shader) {
+    let (root, mut session) = playing(platform, "Zzz");
+    let mut now = 100;
+    assert_eq!(session.app().screen_shader(), Shader::Off);
+    let (mut seen, mut ever) = (vec![], 0);
+    for _ in 0..3 {
+        ever |= chord(&mut session, &mut now, Btn::A);
+        session.app().flush_state();
+        let st = read_slot_state(root.path());
+        assert_eq!(st.shader_gb, SlotState::default().shader_gb);
+        assert_eq!(st.shader_gba, SlotState::default().shader_gba);
+        assert_eq!(session.app().screen_shader(), pick(&st));
+        seen.push(pick(&st));
+    }
+    assert_eq!(seen, [Shader::Grid, Shader::Dot, Shader::Off]);
+    ever |= chord(&mut session, &mut now, Btn::B);
+    session.app().flush_state();
+    assert_eq!(pick(&read_slot_state(root.path())), Shader::Dot);
+    assert_eq!(
+        ever & (ButtonMask::A | ButtonMask::B),
+        0,
+        "A or B reached the game"
+    );
+}
+
+#[test]
+fn select_a_and_b_cycle_the_nes_shader_through_retro_and_leave_shader_gb_alone() {
+    cycle(Platform::Nes, |s| s.shader_nes);
+}
+
+#[test]
+fn select_a_and_b_cycle_the_snes_shader_through_retro_and_leave_shader_gb_alone() {
+    cycle(Platform::Snes, |s| s.shader_snes);
+}
