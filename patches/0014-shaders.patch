diff --git a/crates/slot-store/tests/nes_shader_state.rs b/crates/slot-store/tests/nes_shader_state.rs
new file mode 100644
index 0000000..96ab9c9
--- /dev/null
+++ b/crates/slot-store/tests/nes_shader_state.rs
@@ -0,0 +1,112 @@
+mod common;
+
+use common::tmp_root;
+use slot_store::{read_slot_state, write_slot_state, Platform, Shader, SlotState};
+
+fn state_file(root: &std::path::Path) -> std::path::PathBuf {
+    root.join("Config/slot.state")
+}
+
+#[test]
+fn nes_and_snes_shaders_round_trip_and_are_appended_after_the_upstream_lines() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Zzz".into()),
+        clock_set: true,
+        shader_nes: Shader::Dot,
+        shader_snes: Shader::Grid,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).unwrap();
+    let text = std::fs::read_to_string(state_file(d.path())).unwrap();
+    assert!(
+        text.ends_with("shader_nes=dot\nshader_snes=grid\n"),
+        "{text:?}"
+    );
+    assert_eq!(read_slot_state(d.path()), s);
+}
+
+#[test]
+fn a_file_from_unpatched_slot_gives_off_and_keeps_the_other_fields() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Zzz".into()),
+        clock_set: true,
+        volume: 33,
+        shader_gba: Shader::Dot,
+        shader_gb: Shader::Grid,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).unwrap();
+    let text = std::fs::read_to_string(state_file(d.path())).unwrap();
+    let old: String = text
+        .lines()
+        .filter(|l| !l.starts_with("shader_nes=") && !l.starts_with("shader_snes="))
+        .map(|l| format!("{l}\n"))
+        .collect();
+    std::fs::write(state_file(d.path()), old).unwrap();
+    let back = read_slot_state(d.path());
+    assert_eq!(back.shader_nes, Shader::Off);
+    assert_eq!(back.shader_snes, Shader::Off);
+    assert_eq!(back, s);
+}
+
+#[test]
+fn a_shader_outside_the_retro_list_falls_back_to_off_without_losing_the_file() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Zzz".into()),
+        clock_set: true,
+        volume: 33,
+        shader_nes: Shader::Dot,
+        shader_snes: Shader::Dot,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).unwrap();
+    let text = std::fs::read_to_string(state_file(d.path()))
+        .unwrap()
+        .replace("shader_nes=dot", "shader_nes=lcd3x")
+        .replace("shader_snes=dot", "shader_snes=simpletex");
+    std::fs::write(state_file(d.path()), text).unwrap();
+    let back = read_slot_state(d.path());
+    assert_eq!(back.shader_nes, Shader::Off);
+    assert_eq!(back.shader_snes, Shader::Off);
+    assert_eq!(back.volume, 33);
+    assert_eq!(back.cart.as_deref(), Some("Zzz"));
+}
+
+#[test]
+fn every_platform_names_its_own_shader_list() {
+    assert_eq!(Platform::Gba.shader_choices(), &Shader::GBA[..]);
+    assert_eq!(Platform::Gb.shader_choices(), &Shader::GB[..]);
+    assert_eq!(Platform::Gbc.shader_choices(), &Shader::GB[..]);
+    assert_eq!(Platform::Nes.shader_choices(), &Shader::RETRO[..]);
+    assert_eq!(Platform::Snes.shader_choices(), &Shader::RETRO[..]);
+}
+
+#[test]
+fn a_gba_only_slot_state_matches_upstream_up_to_the_appended_lines() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Emerald".into()),
+        cart_platform: Some(Platform::Gba),
+        brightness: 3,
+        volume: 40,
+        volume_hp: 41,
+        muted: true,
+        clock_set: true,
+        utc_offset_min: -300,
+        shader_gba: Shader::Grid,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).unwrap();
+    let text = std::fs::read_to_string(state_file(d.path())).unwrap();
+    let upstream = text
+        .strip_suffix("shader_nes=off\nshader_snes=off\n")
+        .expect("the NES and SNES shader lines are not the last two");
+    assert!(upstream.starts_with("cart=Emerald\ncart_platform=gba\nbrightness=3\n"));
+    assert!(upstream.lines().any(|l| l == "shader_gba=grid"));
+    assert!(upstream
+        .lines()
+        .all(|l| !l.starts_with("shader_nes=") && !l.starts_with("shader_snes=")));
+}
