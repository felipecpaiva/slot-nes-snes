@@ -0,0 +1,105 @@
+mod common;
+
+use std::path::Path;
+
+use common::{boot, tmp_root_with_real_carts};
+use slot::app::App;
+use slot::pal_speed::{PAL_SPEED_FILE, PAL_SPEED_ROWS};
+use slot_input::{Action, Btn};
+use slot_store::Platform;
+use slot_ui::{QuickRow, QuickValue};
+use tempfile::TempDir;
+
+fn write_cart(root: &Path, platform: Platform) {
+    let dir = root.join("Games").join(platform.dir_name());
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let cart = dir.join(format!("Sonic.{}", platform.extensions()[0]));
+    std::fs::write(cart, vec![0u8; 0x8000]).expect("write cart");
+}
+
+fn every_system() -> (TempDir, App) {
+    let root = tmp_root_with_real_carts(&["Emerald"]);
+    for platform in [Platform::Nes, Platform::Snes, Platform::Sms, Platform::Md] {
+        write_cart(root.path(), platform);
+    }
+    let app = boot(root.path());
+    (root, app)
+}
+
+fn press(app: &mut App, btn: Btn) {
+    app.apply(Action::GbaDown(btn));
+    app.apply(Action::GbaUp(btn));
+}
+
+fn open_pal_speed(app: &mut App, console: QuickRow) {
+    app.apply(Action::QuickMenu);
+    for _ in 0..QuickRow::Screen.position(app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    for _ in 0..console.position(app.hidden_rows()) {
+        press(app, Btn::Down);
+    }
+    press(app, Btn::A);
+    press(app, Btn::Down);
+    press(app, Btn::Down);
+}
+
+#[test]
+fn every_paced_system_shows_a_pal_speed_row_set_to_native() {
+    let (_root, app) = every_system();
+    for (row, platform) in PAL_SPEED_ROWS {
+        assert_eq!(row.label(), "PAL Speed");
+        assert_eq!(row.page().last(), Some(&row), "{platform:?}");
+        assert_eq!(app.quick_value(row), Some(QuickValue::Native), "{row:?}");
+        assert!(app.native_pal(platform), "{platform:?}");
+    }
+}
+
+#[test]
+fn game_gear_and_the_game_boys_have_no_pal_speed_row() {
+    for page in [
+        &QuickRow::SCREEN_GG[..],
+        &QuickRow::SCREEN_GBA[..],
+        &QuickRow::SCREEN_GBC[..],
+        &QuickRow::SCREEN_GB[..],
+    ] {
+        assert!(page.iter().all(|r| r.label() != "PAL Speed"), "{page:?}");
+    }
+    let (_root, app) = every_system();
+    for platform in [Platform::Gg, Platform::Gba, Platform::Gb, Platform::Gbc] {
+        assert!(!app.native_pal(platform), "{platform:?}");
+    }
+}
+
+#[test]
+fn flipping_the_mega_drive_row_saves_panel_rate_for_the_mega_drive_only() {
+    let (root, mut app) = every_system();
+    open_pal_speed(&mut app, QuickRow::ScreenMd);
+    assert_eq!(app.quick_menu(), Some(QuickRow::MdPalSpeed));
+    press(&mut app, Btn::Right);
+    assert_eq!(
+        app.quick_value(QuickRow::MdPalSpeed),
+        Some(QuickValue::Panel)
+    );
+    assert_eq!(
+        std::fs::read_to_string(root.path().join(PAL_SPEED_FILE)).ok(),
+        Some("md = panel\n".to_owned())
+    );
+    for (_, platform) in PAL_SPEED_ROWS {
+        assert_eq!(app.native_pal(platform), platform != Platform::Md);
+    }
+    drop(app);
+    assert!(!boot(root.path()).native_pal(Platform::Md));
+}
+
+#[test]
+fn an_unknown_pal_speed_line_reads_as_native() {
+    let d = tempfile::tempdir().expect("tempdir");
+    std::fs::create_dir(d.path().join("Config")).expect("config dir");
+    std::fs::write(d.path().join(PAL_SPEED_FILE), "nes = fast\nsnes = panel\n")
+        .expect("write pal_speed.txt");
+    let app = boot(d.path());
+    assert!(app.native_pal(Platform::Nes));
+    assert!(!app.native_pal(Platform::Snes));
+}
