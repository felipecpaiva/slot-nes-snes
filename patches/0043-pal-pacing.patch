+use std::path::Path;
+
+use slot_store::{ini, Platform};
+use slot_ui::{QuickRow, QuickValue};
+
+use crate::card_log::CardWrites;
+
+pub const PAL_SPEED_FILE: &str = "Config/pal_speed.txt";
+
+pub const PAL_SPEED_ROWS: [(QuickRow, Platform); 5] = [
+    (QuickRow::NesPalSpeed, Platform::Nes),
+    (QuickRow::SnesPalSpeed, Platform::Snes),
+    (QuickRow::SmsPalSpeed, Platform::Sms),
+    (QuickRow::MdPalSpeed, Platform::Md),
+    (QuickRow::Ps1PalSpeed, Platform::Ps1),
+];
+
+fn key(platform: Platform) -> String {
+    platform.dir_name().to_ascii_lowercase()
+}
+
+fn native_for(root: &Path, platform: Platform) -> bool {
+    match ini::value(root, PAL_SPEED_FILE, &key(platform)).as_deref() {
+        None | Some("native") => true,
+        Some("panel") => false,
+        Some(other) => {
+            eprintln!("slot: pal_speed.txt: ignoring {}={other}", key(platform));
+            true
+        }
+    }
+}
+
+pub fn quick_value(native: bool) -> QuickValue {
+    match native {
+        true => QuickValue::Native,
+        false => QuickValue::Panel,
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct PalSpeeds([bool; 5]);
+
+impl Default for PalSpeeds {
+    fn default() -> Self {
+        PalSpeeds([true; 5])
+    }
+}
+
+impl PalSpeeds {
+    pub fn read(root: &Path) -> Self {
+        PalSpeeds(PAL_SPEED_ROWS.map(|(_, p)| native_for(root, p)))
+    }
+
+    pub fn native(&self, platform: Platform) -> bool {
+        PAL_SPEED_ROWS
+            .iter()
+            .position(|(_, p)| *p == platform)
+            .and_then(|at| self.0.get(at).copied())
+            .unwrap_or(false)
+    }
+
+    pub fn get(&self, row: QuickRow) -> Option<bool> {
+        let at = PAL_SPEED_ROWS.iter().position(|(r, _)| *r == row)?;
+        self.0.get(at).copied()
+    }
+
+    pub fn flip(&mut self, row: QuickRow) -> Option<(Platform, bool)> {
+        let at = PAL_SPEED_ROWS.iter().position(|(r, _)| *r == row)?;
+        let (_, platform) = PAL_SPEED_ROWS.get(at)?;
+        let native = self.0.get_mut(at)?;
+        *native = !*native;
+        Some((*platform, *native))
+    }
+}
+
+pub fn save(root: &Path, platform: Platform, native: bool, writes: &CardWrites) {
+    let value = if native { "native" } else { "panel" };
+    let written = ini::write(root, PAL_SPEED_FILE, &key(platform), value);
+    if let Err(e) = &written {
+        eprintln!("slot: emu: could not write pal_speed.txt: {e}");
+    }
+    writes.wrote("pal_speed.txt", &written);
+}
