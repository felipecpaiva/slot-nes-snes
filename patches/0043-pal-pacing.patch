@@ -0,0 +1,339 @@
+mod common;
+mod core_common;
+mod nes_common;
+mod real_seat;
+mod sega_common;
+
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use common::core_lock;
+use nes_common::{fceumm, nes_rom};
+use sega_common::{genesis_plus_gx, md_rom};
+use slot::audio::{AudioSink, StubSink};
+use slot::core::{open_core_for, open_core_for_palette};
+use slot::emu::{CoreState, EmuHandle, Speed};
+use slot::session::Session;
+use slot_retro::{AvInfo, ButtonMask, CoreError, MockCore, RetroCore};
+use slot_store::{read_slot_state, write_slot_state, Core, Platform};
+
+const PANEL: Duration = Duration::from_nanos(16_666_667);
+const DEVICE_HZ: u32 = 32_768;
+
+struct Rated {
+    inner: MockCore,
+    fps: f64,
+    change_at: Option<usize>,
+    calls: usize,
+    ran: Arc<AtomicU64>,
+}
+
+impl RetroCore for Rated {
+    fn load(&mut self, rom: &Path) -> Result<(), CoreError> {
+        self.inner.load(rom)
+    }
+    fn run_frame(&mut self, input: ButtonMask) {
+        self.ran.fetch_add(1, Ordering::Relaxed);
+        self.inner.run_frame(input);
+    }
+    fn video_xrgb8888(&self) -> &[u8] {
+        self.inner.video_xrgb8888()
+    }
+    fn take_audio(&mut self) -> Vec<i16> {
+        self.inner.take_audio()
+    }
+    fn serialize(&mut self) -> Result<Vec<u8>, CoreError> {
+        self.inner.serialize()
+    }
+    fn unserialize(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.unserialize(data)
+    }
+    fn save_ram(&self) -> Option<Vec<u8>> {
+        self.inner.save_ram()
+    }
+    fn load_save_ram(&mut self, data: &[u8]) -> Result<(), CoreError> {
+        self.inner.load_save_ram(data)
+    }
+    fn av_info(&self) -> AvInfo {
+        AvInfo {
+            fps: self.fps,
+            sample_rate: 32_768.0,
+        }
+    }
+    fn take_av_change(&mut self) -> Option<AvInfo> {
+        self.calls += 1;
+        (Some(self.calls) == self.change_at).then(|| {
+            self.fps = 50.0;
+            self.av_info()
+        })
+    }
+}
+
+fn rated(fps: f64) -> Box<dyn RetroCore> {
+    Box::new(Rated {
+        inner: MockCore::new(),
+        fps,
+        change_at: None,
+        calls: 0,
+        ran: Arc::new(AtomicU64::new(0)),
+    })
+}
+
+fn wait_for(cond: impl Fn() -> bool) -> bool {
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !cond() {
+        if Instant::now() >= deadline {
+            return false;
+        }
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    true
+}
+
+fn spawn(core: Box<dyn RetroCore>, rom: PathBuf, native: bool) -> (EmuHandle, Arc<AtomicU64>) {
+    let mut sink = StubSink::new();
+    sink.open(DEVICE_HZ).expect("the stub refused to open");
+    let ring = sink.ring();
+    let heard = Arc::new(AtomicU64::new(0));
+    let counted = heard.clone();
+    let drained = ring.clone();
+    std::thread::spawn(move || loop {
+        let frames = drained.queued_frames();
+        drained.fill(&mut vec![0i16; frames * 2]);
+        counted.fetch_add(frames as u64, Ordering::Relaxed);
+        std::thread::sleep(Duration::from_millis(2));
+    });
+    let emu = EmuHandle::spawn(core, rom, ring, None, None);
+    emu.set_native_pal(native);
+    emu.set_speed(Speed::Normal);
+    assert!(
+        wait_for(|| emu.state() != CoreState::Loading),
+        "the core never finished loading"
+    );
+    assert_eq!(emu.state(), CoreState::Ready);
+    (emu, heard)
+}
+
+fn locked(emu: &EmuHandle) {
+    emu.set_driven(true);
+    assert!(wait_for(|| emu.locked()), "the worker never locked");
+    for _ in 0..12 {
+        tick(emu);
+    }
+}
+
+fn tick(emu: &EmuHandle) {
+    emu.tick(PANEL);
+    assert!(
+        emu.wait_frame(Duration::from_millis(500)),
+        "a tick was never served"
+    );
+}
+
+fn frames_in_60_ticks(emu: &EmuHandle) -> u64 {
+    let before = emu.published_count();
+    for _ in 0..60 {
+        tick(emu);
+    }
+    emu.published_count() - before
+}
+
+fn europe_md_rom(name: &str) -> PathBuf {
+    let path = md_rom(name, true, false);
+    let mut rom = std::fs::read(&path).expect("read the generated cart");
+    rom[0x1f0..0x1f4].copy_from_slice(b"E   ");
+    std::fs::write(&path, rom).expect("write the Europe cart");
+    path
+}
+
+#[test]
+fn a_50_fps_core_runs_50_frames_in_60_display_ticks() {
+    let (emu, _) = spawn(rated(50.0), PathBuf::from("mock"), true);
+    locked(&emu);
+    assert_eq!(frames_in_60_ticks(&emu), 50);
+}
+
+#[test]
+fn a_60_fps_core_still_runs_a_frame_on_every_display_tick() {
+    let (emu, _) = spawn(rated(59.7275), PathBuf::from("mock"), true);
+    locked(&emu);
+    assert_eq!(frames_in_60_ticks(&emu), 60);
+}
+
+#[test]
+fn a_50_fps_core_on_panel_rate_runs_a_frame_on_every_display_tick() {
+    let (emu, _) = spawn(rated(50.0), PathBuf::from("mock"), false);
+    locked(&emu);
+    assert_eq!(frames_in_60_ticks(&emu), 60);
+}
+
+#[test]
+fn a_75_fps_core_runs_75_frames_in_60_display_ticks() {
+    let ran = Arc::new(AtomicU64::new(0));
+    let core = Box::new(Rated {
+        inner: MockCore::new(),
+        fps: 75.0,
+        change_at: None,
+        calls: 0,
+        ran: ran.clone(),
+    });
+    let (emu, _) = spawn(core, PathBuf::from("mock"), true);
+    locked(&emu);
+    let before = ran.load(Ordering::Relaxed);
+    for _ in 0..60 {
+        tick(&emu);
+    }
+    assert_eq!(ran.load(Ordering::Relaxed) - before, 75);
+}
+
+#[test]
+fn a_75_fps_core_running_two_frames_on_a_tick_keeps_all_their_sound() {
+    let ran = Arc::new(AtomicU64::new(0));
+    let core = Box::new(Rated {
+        inner: MockCore::new(),
+        fps: 75.0,
+        change_at: None,
+        calls: 0,
+        ran: ran.clone(),
+    });
+    let (emu, heard) = spawn(core, PathBuf::from("mock"), true);
+    locked(&emu);
+    std::thread::sleep(Duration::from_millis(50));
+    let (frames, sound) = (ran.load(Ordering::Relaxed), heard.load(Ordering::Relaxed));
+    for _ in 0..240 {
+        tick(&emu);
+    }
+    std::thread::sleep(Duration::from_millis(50));
+    let frames = ran.load(Ordering::Relaxed) - frames;
+    let sound = heard.load(Ordering::Relaxed) - sound;
+    let per_frame = sound as f64 / frames as f64;
+    let want = 32_768.0 / 59.7275;
+    assert!(
+        (per_frame / want - 1.0).abs() < 0.02,
+        "{per_frame:.1} device frames of sound per game frame, want {want:.1}"
+    );
+}
+
+#[test]
+fn a_core_that_turns_pal_mid_game_is_paced_at_50_fps_from_then_on() {
+    let core = Box::new(Rated {
+        inner: MockCore::new(),
+        fps: 59.7275,
+        change_at: Some(3),
+        calls: 0,
+        ran: Arc::new(AtomicU64::new(0)),
+    });
+    let (emu, _) = spawn(core, PathBuf::from("mock"), true);
+    locked(&emu);
+    assert_eq!(frames_in_60_ticks(&emu), 50);
+}
+
+#[test]
+fn a_europe_nes_cart_on_fceumm_runs_50_frames_in_60_display_ticks() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let core = open_core_for(d.path(), Core::Fceumm, "auto", false, &[dylib]);
+    let (emu, _) = spawn(core, nes_rom("Pal Test (Europe).nes", false), true);
+    locked(&emu);
+    assert_eq!(frames_in_60_ticks(&emu), 50);
+}
+
+#[test]
+fn a_europe_mega_drive_cart_on_genesis_plus_gx_runs_50_frames_in_60_display_ticks() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let core = open_core_for_palette(
+        d.path(),
+        Core::GenesisPlusGx,
+        Platform::Md,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    let (emu, _) = spawn(core, europe_md_rom("pal_test_e.md"), true);
+    locked(&emu);
+    assert_eq!(frames_in_60_ticks(&emu), 50);
+}
+
+#[test]
+fn a_europe_nes_cart_feeds_one_second_of_sound_a_second_of_game() {
+    let _g = core_lock();
+    let Some(dylib) = fceumm() else {
+        return;
+    };
+    let d = common::tmp_root_with_real_carts(&[]);
+    let core = open_core_for(d.path(), Core::Fceumm, "auto", false, &[dylib]);
+    let (emu, heard) = spawn(core, nes_rom("Pal Sound (Europe).nes", false), true);
+    locked(&emu);
+    std::thread::sleep(Duration::from_millis(50));
+    let (frames, sound) = (emu.published_count(), heard.load(Ordering::Relaxed));
+    for _ in 0..300 {
+        tick(&emu);
+    }
+    std::thread::sleep(Duration::from_millis(50));
+    let frames = emu.published_count() - frames;
+    let sound = heard.load(Ordering::Relaxed) - sound;
+    let per_frame = sound as f64 / frames as f64;
+    let want = f64::from(DEVICE_HZ) / 50.007;
+    assert!(
+        (per_frame / want - 1.0).abs() < 0.02,
+        "{per_frame:.1} device frames of sound per game frame, want {want:.1}"
+    );
+}
+
+fn seated_europe_nes(pal_speed: Option<&str>) -> Option<(tempfile::TempDir, Session)> {
+    let dylib = fceumm()?;
+    let stem = "Pal Seat (Europe)";
+    let root = real_seat::rooted(Platform::Nes, stem, &nes_rom("pal_seat.nes", false), &dylib);
+    if let Some(line) = pal_speed {
+        std::fs::write(root.path().join(slot::pal_speed::PAL_SPEED_FILE), line)
+            .expect("write pal_speed.txt");
+    }
+    let mut state = read_slot_state(root.path());
+    state.cart = Some(stem.into());
+    state.cart_platform = Some(Platform::Nes);
+    write_slot_state(root.path(), &state).expect("write slot.state");
+    let mut session = real_seat::play(root.path(), false);
+    session.set_driven(true);
+    let emu = session.emu().expect("no emu");
+    assert!(wait_for(|| emu.locked()), "the worker never locked");
+    Some((root, session))
+}
+
+fn session_frames_in_60_ticks(session: &Session) -> u64 {
+    for _ in 0..12 {
+        assert!(session.step_emulator(PANEL, Duration::from_millis(500)));
+    }
+    let before = session.frames_published();
+    for _ in 0..60 {
+        assert!(session.step_emulator(PANEL, Duration::from_millis(500)));
+    }
+    session.frames_published() - before
+}
+
+#[test]
+fn a_session_seats_a_europe_nes_cart_at_its_own_50_fps() {
+    let _g = core_lock();
+    let Some((_root, session)) = seated_europe_nes(None) else {
+        return;
+    };
+    assert_eq!(session_frames_in_60_ticks(&session), 50);
+}
+
+#[test]
+fn a_session_with_nes_set_to_panel_runs_the_europe_cart_on_every_tick() {
+    let _g = core_lock();
+    let Some((_root, session)) = seated_europe_nes(Some("nes = panel\n")) else {
+        return;
+    };
+    assert_eq!(session_frames_in_60_ticks(&session), 60);
+}
