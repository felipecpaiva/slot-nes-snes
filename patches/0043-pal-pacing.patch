+++ b/crates/slot/src/av_rate.rs
@@ -15,6 +15,27 @@ pub fn rebuilt_resampler(av: AvInfo, present: Duration, device_hz: f64) -> Resam
     Resampler::new(core_hz(av, present), device_hz)
 }
 
+const NEAR_PRESENT_FPS: f64 = 2.0;
+
+pub fn period(av: AvInfo, native: bool, present: Duration) -> Duration {
+    match av.fps {
+        fps if native && fps > 0.0 && (fps - 60.0).abs() > NEAR_PRESENT_FPS => {
+            Duration::from_secs_f64(1.0 / fps)
+        }
+        _ => present,
+    }
+}
+
+pub fn owed_frames(owed: &mut f64, tick: Duration, period: Duration, present: Duration) -> u32 {
+    if period == present {
+        return 1;
+    }
+    *owed += tick.as_secs_f64() / period.as_secs_f64();
+    let whole = owed.floor();
+    *owed -= whole;
+    whole as u32
+}
