+        AvInfo {
+            fps: 50.0,
+            sample_rate: 32_768.0,
+        }
+    }
+}
+
+#[test]
+fn an_undriven_50_fps_core_runs_50_frames_a_second() {
+    let mut sink = StubSink::draining();
+    sink.open(32_768).expect("the stub refused to open");
+    let emu = EmuHandle::spawn(
+        Box::new(Pal(MockCore::new())),
+        PathBuf::from("mock"),
+        sink.ring(),
+        None,
+        None,
+    );
+    emu.set_native_pal(true);
+    emu.set_speed(Speed::Normal);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while emu.state() == CoreState::Loading {
+        assert!(Instant::now() < deadline, "the core never finished loading");
+        std::thread::sleep(Duration::from_millis(2));
+    }
+    std::thread::sleep(Duration::from_millis(200));
+    let (before, began) = (emu.published_count(), Instant::now());
+    std::thread::sleep(Duration::from_secs(2));
+    let fps = (emu.published_count() - before) as f64 / began.elapsed().as_secs_f64();
+    assert!((fps - 50.0).abs() < 2.0, "{fps:.1} fps");
+}
