diff --git a/crates/slot-store/src/s32x.rs b/crates/slot-store/src/s32x.rs
new file mode 100644
index 0000000..0e7bb1f
--- /dev/null
+++ b/crates/slot-store/src/s32x.rs
@@ -0,0 +1,37 @@
+use std::fs::File;
+use std::io::Read;
+use std::path::Path;
+
+pub const HEADER_LEN: usize = 0x3d0;
+const SYSTEM_AT: usize = 0x100;
+const SYSTEM: &[u8] = b"SEGA 32X";
+const MODULE_AT: usize = 0x3c0;
+const MODULE: &[u8] = b"MARS CHECK MODE";
+
+pub fn is_32x_header(bytes: &[u8]) -> bool {
+    bytes.get(SYSTEM_AT..SYSTEM_AT + SYSTEM.len()) == Some(SYSTEM)
+        || bytes.get(MODULE_AT..MODULE_AT + MODULE.len()) == Some(MODULE)
+}
+
+pub fn is_32x(rom: &Path) -> bool {
+    let mut bytes = Vec::with_capacity(HEADER_LEN);
+    File::open(rom)
+        .and_then(|f| f.take(HEADER_LEN as u64).read_to_end(&mut bytes))
+        .is_ok()
+        && is_32x_header(&bytes)
+}
+
+pub fn admits(rom: &Path) -> bool {
+    let named_32x = rom
+        .extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| e.eq_ignore_ascii_case("32x"));
+    if named_32x || is_32x(rom) {
+        return true;
+    }
+    eprintln!(
+        "slot: scan: {}: no SEGA 32X or MARS CHECK MODE header, not a 32X cart",
+        rom.display()
+    );
+    false
+}
