diff --git a/crates/slot/tests/s32x_seat.rs b/crates/slot/tests/s32x_seat.rs
new file mode 100644
index 0000000..5e11d99
--- /dev/null
+++ b/crates/slot/tests/s32x_seat.rs
@@ -0,0 +1,26 @@
+mod common;
+mod core_common;
+mod real_seat;
+mod s32x_common;
+
+use common::core_lock;
+use s32x_common::{cart, picodrive, red, PICTURE};
+use slot_store::{Core, Platform};
+
+#[test]
+fn a_32x_cart_seats_on_picodrive_through_a_real_session() {
+    let _g = core_lock();
+    let Some(dylib) = picodrive() else {
+        return;
+    };
+    let carts = tempfile::tempdir().expect("tempdir");
+    let rom = cart(carts.path(), "Chaotix");
+    let root = real_seat::rooted(Platform::S32x, "Chaotix", &rom, &dylib);
+    let session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::Picodrive);
+    assert_eq!(session.app().playing_platform(), Platform::S32x);
+    let emu = session.emu().expect("no core in the slot");
+    let frame = emu.latest_frame().expect("nothing was published");
+    assert_eq!(frame.len(), 360 * 240 * 4);
+    assert_eq!(red(&frame), PICTURE.0 * PICTURE.1);
+}
