diff --git a/crates/slot-store/tests/s32x_platform.rs b/crates/slot-store/tests/s32x_platform.rs
new file mode 100644
index 0000000..8a7df58
--- /dev/null
+++ b/crates/slot-store/tests/s32x_platform.rs
@@ -0,0 +1,207 @@
+mod common;
+
+use std::path::{Path, PathBuf};
+
+use common::tmp_root;
+use slot_store::s32x::{is_32x, is_32x_header};
+use slot_store::{
+    read_sega_shaders, scan, write_sega_shaders, Cart, Core, Platform, RetroShader, SegaShaders,
+    Shader, S32X_SHADER_FILE,
+};
+
+fn rom(system: &[u8; 16], module: &[u8; 16]) -> Vec<u8> {
+    let mut rom = vec![0u8; 0x400];
+    rom[0x100..0x110].copy_from_slice(system);
+    rom[0x120..0x150].fill(b' ');
+    rom[0x150..0x163].copy_from_slice(b"KNUCKLES' CHAOTIX  ");
+    rom[0x3c0..0x3d0].copy_from_slice(module);
+    rom
+}
+
+fn game() -> Vec<u8> {
+    rom(b"SEGA 32X        ", b"MARS CHECK MODE ")
+}
+
+fn mega_drive() -> Vec<u8> {
+    rom(b"SEGA MEGA DRIVE ", &[0; 16])
+}
+
+fn put(root: &Path, shelf: &str, name: &str, bytes: &[u8]) -> PathBuf {
+    let dir = root.join("Games").join(shelf);
+    std::fs::create_dir_all(&dir).expect("create dir");
+    let p = dir.join(name);
+    std::fs::write(&p, bytes).expect("write");
+    p
+}
+
+fn shelf(root: &Path, platform: Platform) -> Vec<Cart> {
+    scan(root)
+        .expect("scan")
+        .into_iter()
+        .filter(|c| c.platform == platform)
+        .collect()
+}
+
+fn stems(carts: &[Cart]) -> Vec<&str> {
+    carts.iter().map(|c| c.stem.as_str()).collect()
+}
+
+#[test]
+fn the_32x_is_the_last_shelf_and_upstreams_list_stays_three() {
+    assert_eq!(Platform::SHELVES.last(), Some(&Platform::S32x));
+    assert_eq!(Platform::SHELVES.len(), 14);
+    assert_eq!(Platform::ALL.len(), 3);
+    assert_eq!(Platform::S32x.dir_name(), "32X");
+    assert_eq!(Platform::S32x.name(), "Sega 32X");
+}
+
+#[test]
+fn a_32x_file_lands_on_the_32x_shelf_whatever_its_header() {
+    let d = tmp_root();
+    put(d.path(), "32X", "Doom (Japan, USA).32x", &game());
+    put(d.path(), "32X", "Short.32X", b"\x01");
+    put(d.path(), "32X", "._Doom (Japan, USA).32x", &game());
+    put(d.path(), "32X", "Notes.txt", b"");
+    assert_eq!(
+        stems(&shelf(d.path(), Platform::S32x)),
+        ["Doom (Japan, USA)", "Short"]
+    );
+}
+
+#[test]
+fn a_bin_lands_on_the_32x_shelf_only_with_a_32x_header() {
+    let d = tmp_root();
+    put(d.path(), "32X", "Knuckles Chaotix 32X (5) [!].bin", &game());
+    put(
+        d.path(),
+        "32X",
+        "Sonic the Hedgehog (USA, Europe).bin",
+        &mega_drive(),
+    );
+    put(d.path(), "32X", "Tiny.bin", b"\x01\x02");
+    let mut carts = shelf(d.path(), Platform::S32x);
+    assert_eq!(stems(&carts), ["Knuckles Chaotix 32X (5) [!]"]);
+    carts[0].read_header();
+    assert_eq!(carts[0].title, "KNUCKLES' CHAOTIX");
+    assert_eq!(
+        carts[0].rom.parent(),
+        Some(d.path().join("Games/32X").as_path())
+    );
+}
+
+#[test]
+fn either_header_word_alone_marks_a_32x_cart() {
+    // Star Wars Arcade has "SEGA 32X" at 0x100 and its own name at 0x3c0; FIFA Soccer 96 has "SEGA
+    // MEGA DRIVE" at 0x100 and "MARS CHECK MODE" at 0x3c0 (ADR 0096, the maintainer's own dumps).
+    assert!(is_32x_header(&rom(
+        b"SEGA 32X       U",
+        b"STAR WARS ARCADE"
+    )));
+    assert!(is_32x_header(&rom(
+        b"SEGA MEGA DRIVE ",
+        b"MARS CHECK MODE "
+    )));
+    assert!(!is_32x_header(&mega_drive()));
+    assert!(!is_32x_header(&game()[..0x100]));
+    let d = tmp_root();
+    assert!(is_32x(&put(d.path(), "32X", "Game.bin", &game())));
+    assert!(!is_32x(&put(
+        d.path(),
+        "32X",
+        "Short.bin",
+        &game()[..0x107]
+    )));
+    assert!(!is_32x(&d.path().join("Games/32X/Missing.bin")));
+}
+
+#[test]
+fn the_mega_drive_shelf_is_unchanged_and_still_lists_a_32x_bin() {
+    // Mega Drive must behave byte for byte as before: no header filter there, a 32X game left on it
+    // still lists and still starts on Genesis Plus GX.
+    let d = tmp_root();
+    put(d.path(), "MD", "Doom 32X (JU) [!].bin", &game());
+    put(
+        d.path(),
+        "MD",
+        "Sonic the Hedgehog (USA, Europe).bin",
+        &mega_drive(),
+    );
+    put(d.path(), "MD", "Ecco.md", &mega_drive());
+    let carts = shelf(d.path(), Platform::Md);
+    assert_eq!(
+        stems(&carts),
+        [
+            "Doom 32X (JU) [!]",
+            "Ecco",
+            "Sonic the Hedgehog (USA, Europe)"
+        ]
+    );
+    assert!(shelf(d.path(), Platform::S32x).is_empty());
+    assert_eq!(Platform::Md.extensions(), ["md", "gen", "bin"]);
+    assert_eq!(Core::default_for(Platform::Md), Core::GenesisPlusGx);
+}
+
+#[test]
+fn the_32x_plays_like_the_mega_drive_and_answers_every_policy() {
+    let p = Platform::S32x;
+    let md = Platform::Md;
+    assert_eq!(p.owns_shoulders(), md.owns_shoulders());
+    assert_eq!(p.passes_xy_through(), md.passes_xy_through());
+    assert_eq!(p.select_x_toggles_picture(), md.select_x_toggles_picture());
+    assert_eq!(p.stretch_crops_height(), md.stretch_crops_height());
+    assert_eq!(p.overscan(), md.overscan());
+    assert_eq!(p.follows_frame_width(), md.follows_frame_width());
+    assert_eq!(p.has_gb_palettes(), md.has_gb_palettes());
+    assert_eq!(p.rewinds(), md.rewinds());
+    assert_eq!(p.fills_canvas(), md.fills_canvas());
+    assert_eq!(p.swaps_discs(), md.swaps_discs());
+    assert_eq!(p.owns_triggers(), md.owns_triggers());
+    assert_eq!(p.actual_scale(), md.actual_scale());
+    assert_eq!(p.flashes_on_unload(), md.flashes_on_unload());
+    assert_eq!(p.picker_cores(), None);
+    assert_eq!(p.picture(), (320, 224));
+    assert_eq!(p.shader_choices(), &Shader::RETRO);
+    assert_eq!(p.extensions(), ["32x", "bin"]);
+}
+
+#[test]
+fn the_32x_runs_on_picodrive_alone_on_the_mega_drive_canvas() {
+    assert_eq!(Core::default_for(Platform::S32x), Core::Picodrive);
+    assert_eq!(Core::EVERY.last(), Some(&Core::Picodrive));
+    assert_eq!(Core::Picodrive.as_str(), "picodrive");
+    assert_eq!(Core::Picodrive.option_prefix(), "picodrive");
+    assert_eq!(Core::parse("picodrive"), Some(Core::Picodrive));
+    assert_eq!(Core::Picodrive.text(), "PicoDrive");
+    assert_eq!(Core::Picodrive.canvas(Platform::S32x), (360, 240));
+    assert_eq!(Core::Picodrive.pair(), (Core::Picodrive, Core::Picodrive));
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::S32x),
+            core == Core::Picodrive,
+            "{core:?}"
+        );
+    }
+    for platform in Platform::SHELVES {
+        assert_eq!(
+            Core::Picodrive.runs(platform),
+            platform == Platform::S32x,
+            "{platform:?}"
+        );
+    }
+}
+
+#[test]
+fn the_32x_shader_lives_in_its_own_file() {
+    let d = tmp_root();
+    let s = SegaShaders {
+        s32x: Shader::Retro(RetroShader::CrtPi),
+        ..SegaShaders::default()
+    };
+    write_sega_shaders(d.path(), &s).expect("write");
+    assert_eq!(
+        std::fs::read_to_string(d.path().join("Config").join(S32X_SHADER_FILE)).expect("read"),
+        "s32x=crt-pi\n"
+    );
+    assert!(!d.path().join("Config/sega_shaders.txt").exists());
+    assert_eq!(read_sega_shaders(d.path()), s);
+}
