diff --git a/crates/slot-store/tests/sms_platform.rs b/crates/slot-store/tests/sms_platform.rs
new file mode 100644
index 0000000..866d55d
--- /dev/null
+++ b/crates/slot-store/tests/sms_platform.rs
@@ -0,0 +1,82 @@
+mod common;
+
+use std::path::Path;
+
+use common::tmp_root;
+use slot_store::{read_slot_state, scan, write_slot_state, Core, Platform, Shader, SlotState};
+
+#[test]
+fn master_system_is_the_shelf_after_game_gear() {
+    assert_eq!(Platform::SHELVES[6], Platform::Sms);
+    assert_eq!(Platform::ALL.len(), 3);
+}
+
+#[test]
+fn master_system_has_its_own_name_folder_extension_and_picture() {
+    assert_eq!(Platform::Sms.name(), "Sega Master System");
+    assert_eq!(Platform::Sms.dir_name(), "SMS");
+    assert!(Platform::Sms.accepts(Path::new("x.sms")));
+    assert!(Platform::Sms.accepts(Path::new("X.SMS")));
+    assert!(!Platform::Sms.accepts(Path::new("x.gg")));
+    assert!(!Platform::Sms.accepts(Path::new("x.sg")));
+    assert_eq!(Platform::Sms.picture(), (256, 192));
+}
+
+#[test]
+fn master_system_plays_like_nes_with_the_retro_shaders() {
+    assert!(Platform::Sms.owns_shoulders());
+    assert!(!Platform::Sms.passes_xy_through());
+    assert!(!Platform::Sms.select_x_toggles_picture());
+    assert!(!Platform::Sms.has_gb_palettes());
+    assert!(Platform::Sms.stretch_crops_height());
+    assert_eq!(Platform::Sms.picker_cores(), None);
+    assert_eq!(Platform::Sms.shader_choices(), &Shader::RETRO);
+}
+
+#[test]
+fn master_system_runs_on_genesis_plus_gx_alone_at_2x() {
+    assert_eq!(Core::default_for(Platform::Sms), Core::GenesisPlusGx);
+    for core in Core::EVERY {
+        assert_eq!(
+            core.runs(Platform::Sms),
+            core == Core::GenesisPlusGx,
+            "{core:?}"
+        );
+    }
+    assert_eq!(Core::GenesisPlusGx.canvas(Platform::Sms), (360, 240));
+    assert_eq!(Core::GenesisPlusGx.canvas(Platform::Gg), (240, 160));
+}
+
+#[test]
+fn a_master_system_cart_lands_on_its_shelf_with_its_stem_as_the_name() {
+    let d = tempfile::tempdir().expect("tempdir");
+    let dir = d.path().join("Games/SMS");
+    std::fs::create_dir_all(&dir).expect("create dir");
+    std::fs::write(
+        dir.join("Phantasy Star (USA, Europe).sms"),
+        vec![0u8; 0x8000],
+    )
+    .expect("write rom");
+    let mut carts = scan(d.path()).expect("scan");
+    assert_eq!(carts.len(), 1);
+    let cart = &mut carts[0];
+    assert_eq!(cart.platform, Platform::Sms);
+    cart.read_header();
+    assert_eq!(cart.title, "");
+    assert_eq!(cart.stem, "Phantasy Star (USA, Europe)");
+}
+
+#[test]
+fn a_master_system_cart_resumes_as_a_master_system_cart() {
+    let d = tmp_root();
+    let s = SlotState {
+        cart: Some("Phantasy Star (USA, Europe)".into()),
+        cart_platform: Some(Platform::Sms),
+        clock_set: true,
+        ..SlotState::default()
+    };
+    write_slot_state(d.path(), &s).expect("write slot.state");
+    let text = std::fs::read_to_string(d.path().join("Config/slot.state")).expect("read");
+    assert!(text.lines().any(|l| l == "cart_platform=sms"), "{text:?}");
+    assert_eq!(read_slot_state(d.path()), s);
+}
