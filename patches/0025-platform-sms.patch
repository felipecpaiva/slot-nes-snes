 }
 
+const SMS_RED: &[u8] = &[0x3e, 0x03, 0xd3, 0xbe];
+const MODE_4_LEFT_BLANK: &[u8] = &[0xf3, 0x3e, 0x24, 0xd3, 0xbf, 0x3e, 0x80, 0xd3, 0xbf];
+
+pub fn sms_rom(name: &str) -> PathBuf {
+    sms_with(name, MODE_4_ON)
+}
+
+pub fn sms_rom_left_blank(name: &str) -> PathBuf {
+    sms_with(name, MODE_4_LEFT_BLANK)
+}
+
+fn sms_with(name: &str, mode: &[u8]) -> PathBuf {
+    let program = [mode, COLOUR_0, SMS_RED, DISPLAY_ON_THEN_SPIN].concat();
+    let mut rom = vec![0u8; 0x8000];
+    rom[..program.len()].copy_from_slice(&program);
+    rom[0x7ff0..0x7ff8].copy_from_slice(b"TMR SEGA");
+    rom[0x7fff] = 0x4c;
+    write(name, &rom)
+}
+
 fn write(name: &str, rom: &[u8]) -> PathBuf {
     let p = Path::new(env!("CARGO_TARGET_TMPDIR")).join(name);
     std::fs::write(&p, rom).expect("write rom");
diff --git a/crates/slot/tests/sms_emu.rs b/crates/slot/tests/sms_emu.rs
new file mode 100644
index 0000000..f768ea8
--- /dev/null
+++ b/crates/slot/tests/sms_emu.rs
@@ -0,0 +1,68 @@
+mod common;
+mod core_common;
+mod sega_common;
+
+use common::core_lock;
+use sega_common::{genesis_plus_gx, sms_rom, sms_rom_left_blank};
+use slot::core::open_core_for_palette;
+use slot_retro::ButtonMask;
+use slot_store::{Core, Platform};
+
+const CANVAS_W: usize = 360;
+
+fn pixel(video: &[u8], x: usize, y: usize) -> [u8; 4] {
+    let at = (y * CANVAS_W + x) * 4;
+    [video[at], video[at + 1], video[at + 2], video[at + 3]]
+}
+
+fn drawn(rom: std::path::PathBuf) -> Option<Vec<u8>> {
+    let dylib = genesis_plus_gx()?;
+    let d = common::tmp_root_with_real_carts(&[]);
+    let mut core = open_core_for_palette(
+        d.path(),
+        Core::GenesisPlusGx,
+        Platform::Sms,
+        "auto",
+        false,
+        None,
+        &[dylib],
+    );
+    core.load(&rom)
+        .expect("Genesis Plus GX refused the Master System cart");
+    for _ in 0..30 {
+        core.run_frame(ButtonMask::default());
+    }
+    assert_eq!(core.canvas(), (360, 240));
+    Some(core.video_xrgb8888().to_vec())
+}
+
+fn assert_picture(video: &[u8], x0: usize, w: usize) {
+    let (y0, h) = (24, 192);
+    let red = pixel(video, x0, y0);
+    assert!(red[2] > 200 && red[1] < 60 && red[0] < 60, "{red:?}");
+    for y in 0..240 {
+        for x in 0..CANVAS_W {
+            let inside = (x0..x0 + w).contains(&x) && (y0..y0 + h).contains(&y);
+            let want = if inside { red } else { [0; 4] };
+            assert_eq!(pixel(video, x, y), want, "({x}, {y})");
+        }
+    }
+}
+
+#[test]
+fn a_master_system_cart_draws_256_by_192_at_the_centre_of_the_360_by_240_canvas() {
+    let _g = core_lock();
+    let Some(video) = drawn(sms_rom("sms_emu.sms")) else {
+        return;
+    };
+    assert_picture(&video, 52, 256);
+}
+
+#[test]
+fn the_blank_left_column_of_a_master_system_game_is_cut_and_the_rest_stays_centred() {
+    let _g = core_lock();
+    let Some(video) = drawn(sms_rom_left_blank("sms_left.sms")) else {
+        return;
+    };
+    assert_picture(&video, 56, 248);
+}
diff --git a/crates/slot/tests/sms_seat.rs b/crates/slot/tests/sms_seat.rs
new file mode 100644
index 0000000..d7043f6
--- /dev/null
+++ b/crates/slot/tests/sms_seat.rs
@@ -0,0 +1,87 @@
+mod common;
+mod core_common;
+mod input_common;
+mod real_seat;
+mod sega_common;
+
+use std::path::{Path, PathBuf};
+
+use common::core_lock;
+use sega_common::{genesis_plus_gx, sms_rom};
+use slot::app::Phase;
+use slot::persist::Snapshot;
+use slot::session::Session;
+use slot_input::{Btn, RawEvent};
+use slot_retro::ButtonMask;
+use slot_store::{Core, Platform};
+
+const STEM: &str = "Phantasy Star";
+
+fn sav(root: &Path) -> PathBuf {
+    root.join("Saves/SMS").join(format!("{STEM}.sav"))
+}
+
+fn eject(session: &mut Session) {
+    session.feed([RawEvent::Down(Btn::Menu)], 100);
+    session.feed([], 1200);
+    assert!(
+        matches!(session.app().phase(), Phase::Ejecting { .. }),
+        "holding Menu did not eject: {:?}",
+        session.app().phase()
+    );
+}
+
+fn seated(dylib: &Path) -> tempfile::TempDir {
+    let root = real_seat::rooted(Platform::Sms, STEM, &sms_rom("sms_seat.sms"), dylib);
+    std::fs::copy(
+        sms_rom("sms_seat_spare.sms"),
+        root.path().join("Games/SMS/Zzz.sms"),
+    )
+    .expect("copy spare cart");
+    root
+}
+
+#[test]
+fn a_master_system_cart_seats_on_genesis_plus_gx_at_2x() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let session = real_seat::play(root.path(), true);
+    assert_eq!(session.app().core(), Core::GenesisPlusGx);
+    assert_eq!(session.app().playing_platform(), Platform::Sms);
+    assert_eq!(Core::GenesisPlusGx.canvas(Platform::Sms), (360, 240));
+}
+
+#[test]
+fn a_master_system_sav_goes_into_the_core_and_comes_back_out_on_eject() {
+    let _g = core_lock();
+    let Some(dylib) = genesis_plus_gx() else {
+        return;
+    };
+    let root = seated(&dylib);
+    let marked: Vec<u8> = (0..0x2000u32).map(|i| (i % 241) as u8).collect();
+    std::fs::write(sav(root.path()), &marked).expect("write .sav");
+    let mut session = real_seat::play(root.path(), true);
+    assert_eq!(
+        session.emu().expect("no core").snapshot().save_ram(),
+        Some(marked.clone())
+    );
+    std::fs::remove_file(sav(root.path())).expect("remove .sav");
+    eject(&mut session);
+    assert_eq!(
+        std::fs::read(sav(root.path())).expect("no .sav after eject"),
+        marked
+    );
+}
+
+#[test]
+fn start_reaches_a_master_system_game_as_pause_and_the_shoulders_stay_with_slot() {
+    let (_root, mut session) = input_common::playing(Platform::Sms, "Zzz");
+    assert_eq!(session.app().taken_buttons(), [Btn::L1, Btn::R1]);
+    session.feed([RawEvent::Down(Btn::Start)], 100);
+    let pad = session.emu().expect("no core").input().0;
+    assert_ne!(pad & ButtonMask::START, 0, "{pad:#x}");
+    session.feed([RawEvent::Up(Btn::Start)], 140);
+}
