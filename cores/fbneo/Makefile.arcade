# Neo Geo, CPS1 and CPS2 in one core: FBNeo's own neogeo and cps12 subsets together (ADR 0099).
# cores/lib.sh copies this file next to FBNeo's Makefile, which includes it as INCLUDED_MAKEFILE.
include Makefile.neogeo
include Makefile.cps12
SOURCES_C := $(sort $(SOURCES_C))
SOURCES_CXX := $(sort $(SOURCES_CXX))
