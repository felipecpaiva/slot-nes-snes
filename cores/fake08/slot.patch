+void Vm::ResetCart(){
+    if (CurrentCartFilename().length() == 0 && _lastCartData != nullptr) {
+        QueueCartChange(_lastCartData, _lastCartSize);
+        return;
+    }
+    QueueCartChange(CurrentCartFilename());
+}
