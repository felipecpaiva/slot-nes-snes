+// slot-nes-snes: write the cartdata when it changed since the last write, so progress reaches the card
+// while the game runs and not only when the cart closes.
+void Vm::FlushCartData() {
+    if (_currentCartdataKey.length() == 0) {
+        return;
+    }
+    std::string now = getSerializedCartData();
+    if (_currentCartdataKey == _flushedCartdataKey && now == _flushedCartData) {
+        return;
+    }
+    _host->saveCartData(_currentCartdataKey, now);
+    _flushedCartdataKey = _currentCartdataKey;
+    _flushedCartData = now;
+}
